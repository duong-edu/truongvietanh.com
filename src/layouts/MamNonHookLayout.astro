---
/**
 * MamNonHookLayout — Single-screen landing for hook campaigns (generalised)
 * Brand: #26275D #26275D + Yellow #f9dd0e
 * Two-step form (email → name+phone) → POST /api/lead → redirect cam-on
 *
 * Despite the name, layout supports any cấp via levelLabel + bullets props.
 */
interface BulletItem { icon: string; html: string }
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  location: string;
  locationSlug?: string;
  address: string;
  mapsUrl?: string;                 // link Google Maps — một số trang truyền vào, layout chưa render
  fomoText?: string;
  hookHeadline: string;
  hookSubline: string;
  source: string;
  funnelCode: string;
  schoolLevel?: string;             // 'mam-non' | 'tieu-hoc' | 'thcs' | 'thpt' | 'mix'
  levelLabel?: string;              // "Mầm Non" | "Tiểu Học" | "THCS" | "THPT" | "Trại Hè" ...
  cardTitle?: string;               // "Đặt lịch tham quan ..."
  cardSub?: string;                 // "45-60 phút · ..."
  ctaStep2?: string;                // text on submit btn
  bullets?: BulletItem[];
  trustMarks?: string[];
  redirectUrl: string;
  schemaType?: string;              // 'EducationalOrganization' default
  heroImage?: string;               // background image URL for hero
  // Các prop dưới đây được vài trang truyền vào nhưng layout HIỆN CHƯA render —
  // khai báo để type-safe; muốn hiển thị cần bổ sung markup trong layout này.
  extended?: boolean;
  testimonial1?: { quote: string; author: string };
  testimonial2?: { quote: string; author: string };
  testimonial3?: { quote: string; author: string };
}

const DEFAULT_BULLETS: BulletItem[] = [
  { icon: '📹', html: '<strong>Camera online 24/7</strong> — mẹ xem con mọi lúc qua app, đi làm vẫn yên tâm' },
  { icon: '👶', html: '<strong>Lớp siêu nhỏ &lt; 15 bé</strong> · 2 cô/lớp — từng bé được quan tâm riêng' },
  { icon: '💛', html: '<strong>Cô tận tâm như mẹ thứ hai</strong> — gắn bó nhiều năm, hiểu tính cách từng bé' },
  { icon: '🍱', html: '<strong>Bếp ăn tại trường</strong> — thực đơn dinh dưỡng xoay vòng theo lứa tuổi' },
];

const {
  title, description, canonicalUrl,
  location, address,
  hookHeadline, hookSubline,
  source, funnelCode, redirectUrl,
  schoolLevel = 'mam-non',
  levelLabel = 'Mầm Non',
  bullets = DEFAULT_BULLETS,
  fomoText = '🔥 Đang nhận hồ sơ ' + levelLabel + ' 2026 · Đặt lịch tham quan miễn phí',
  cardTitle = 'Đặt lịch tham quan ' + levelLabel + ' ' + location,
  cardSub = '45–60 phút · Gặp giáo viên · Xem lớp · Tư vấn lộ trình',
  ctaStep2 = '🏫 Đặt lịch tham quan',
  trustMarks = ['Bộ GD&ĐT cấp phép', '15 năm kinh nghiệm', '3 cơ sở TPHCM + Tây Ninh'],
  schemaType = 'EducationalOrganization',
  heroImage,
} = Astro.props;

const HOTLINE = '0916 961 409';
const HOTLINE_TEL = '+84916961409';
const ZALO = 'https://zalo.me/1678310120468101523';

const schemaName = `Trường Việt Anh — ${levelLabel}${location ? ' ' + location : ''}`;
const schema = [
  { '@context': 'https://schema.org', '@type': schemaType, name: schemaName, url: canonicalUrl, description, address: address ? { '@type': 'PostalAddress', streetAddress: address } : undefined, telephone: HOTLINE_TEL },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonicalUrl, inLanguage: 'vi' },
];
---
<!doctype html>
<html lang="vi">
