---
import '../styles/global.css';
import FooterBase from '../components/FooterBase.astro';
import { getSiteSettings } from '../lib/directus';
import { stripUrlPiiScript } from '../lib/strip-url-pii';
const settings = await getSiteSettings();
const hotline = settings?.hotline || '0916 961 409';

type Props = { title?: string; description?: string; keywords?: string; schoolLevel?: 'mau-non' | 'tieu-hoc' | 'thcs' | 'thpt'; funnelCode?: string; ogImage?: string; canonicalUrl?: string; hideUrgency?: boolean; noindex?: boolean; /* gỡ tên/email/SĐT khỏi URL trước GTM; mảng = khoá cần giữ trong window.__vaQS */ stripUrlPii?: string[]; };
const { title = 'Trường Việt Anh', description = 'Website Trường Việt Anh với cấu trúc tối ưu cho SEO, AI Overviews và tốc độ tải.', keywords = 'trường, tiếng Anh, song ngữ, Việt Anh', schoolLevel = 'tieu-hoc', funnelCode = 'squeeze-landing', ogImage = 'https://truongvietanh.com/og-image.png', canonicalUrl = 'https://truongvietanh.com', hideUrgency = false, noindex = false, stripUrlPii } = Astro.props;
const stripUrlPiiJs = stripUrlPii ? stripUrlPiiScript(stripUrlPii) : null;
const phoneIntl = `+84${hotline.replace(/\s/g,'').replace(/^0/,'')}`;
const levelNames: Record<string, string> = { 'mam-non': 'Mầm Non', 'tieu-hoc': 'Tiểu Học', 'thcs': 'THCS', 'thpt': 'THPT' };
const schemaData = [
  { '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: 'Trường Việt Anh', url: canonicalUrl, image: ogImage, description, sameAs: ['https://www.facebook.com/truongvietanhhcm','https://www.youtube.com/@truongvietanh','https://www.instagram.com/truongvietanh'], contactPoint: { '@type': 'ContactPoint', contactType: 'Customer Service', telephone: phoneIntl } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonicalUrl, inLanguage: 'vi', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.squeeze-hero h1', '.squeeze-hero p'] } },
  { '@context': 'https://schema.org', '@type': 'Offer', itemOffered: { '@type': 'EducationalOccupationalProgram', name: levelNames[schoolLevel] || 'Chương trình giáo dục', provider: { '@type': 'Organization', name: 'Trường Việt Anh' } }, price: '0', priceCurrency: 'VND', description: 'Đăng ký tư vấn cá nhân hóa lộ trình học tập', availability: 'https://schema.org/InStock' },
];
const structuredData = JSON.stringify(Array.isArray(schemaData) ? schemaData : [schemaData]);
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
{stripUrlPiiJs && <script is:inline set:html={stripUrlPiiJs} />}
<!-- Google Tag Manager -->
