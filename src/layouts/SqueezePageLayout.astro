<title>{title}</title>
<style is:inline>
:root{--nav-primary:#26275D;--nav-primary-light:#363876;--nav-primary-dark:#18193a;--nav-accent:#f9dd0e;--nav-accent-hover:#f9dd0e;--nav-accent-light:rgba(249, 221, 14,.15);--text-dark:#1a1a1a;--text-light:#666;--bg-light:#f9f9f9;--bg-white:#fff;--border-color:#e0e0e0;--success-color:#27ae60}
*{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;scroll-behavior:smooth}body{font-family:"Open Sans",-apple-system,BlinkMacSystemFont,"Segoe UI","Roboto","Helvetica","Arial",sans-serif;line-height:1.6;color:var(--text-dark);background-color:var(--bg-white)}main{width:100%}

/* ===== HEADER — slimmer ===== */
.squeeze-header{position:sticky;top:0;z-index:1000;background:#fff;border-bottom:1px solid #e5e7eb;padding:.4rem 1.25rem;box-shadow:0 2px 8px rgba(38,39,93,.07)}
.squeeze-header__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.75rem}
.squeeze-brand{grid-column:2;justify-self:center;display:flex;align-items:center;text-decoration:none}
.squeeze-brand__img{height:64px;width:auto;object-fit:contain;display:block}
.squeeze-brand__text{display:none}
.squeeze-header__contacts{grid-column:3;justify-self:end;display:flex;align-items:center;gap:0;white-space:nowrap}
.squeeze-hdr-link{display:inline-flex;align-items:center;gap:.3rem;font-size:.82rem;font-weight:600;text-decoration:none;color:var(--nav-primary);transition:color .15s;padding:.2rem .1rem}
.squeeze-hdr-link:hover{color:var(--nav-accent)}
.squeeze-hdr-sep{color:#cbd5e1;font-size:.85rem;margin:0 .5rem;font-weight:300;user-select:none}
@media(max-width:768px){.squeeze-header{padding:.3rem 1rem}.squeeze-brand__img{height:52px}.squeeze-hdr-link--zalo-text{display:none}}
@media(max-width:480px){.squeeze-brand__img{height:44px}.squeeze-hdr-sep{margin:0 .3rem}.squeeze-hdr-link{font-size:.75rem}}

/* ===== HERO — WHITE BG, #26275D TEXT ===== */
.squeeze-hero{background:linear-gradient(180deg,#f0f4ff 0%,#fff 100%);color:var(--nav-primary);padding:2.25rem 1.5rem 2.5rem;text-align:center;position:relative;overflow:hidden;border-bottom:1px solid var(--border-color)}
.squeeze-hero__content{max-width:860px;margin:0 auto;position:relative;z-index:1}
.squeeze-hero__crest{display:none}
.squeeze-hero h1,.squeeze-hero h2{color:var(--nav-primary) !important;text-align:center;font-weight:800;font-size:1.75rem;line-height:1.3;margin-bottom:.75rem}
.squeeze-hero p,.squeeze-hero__sub{color:var(--text-dark);text-align:center;font-size:1.05rem;line-height:1.65;max-width:720px;margin:0 auto 1rem;font-weight:500}
@media(min-width:769px){.squeeze-hero h1,.squeeze-hero h2{font-size:2.15rem}}
.squeeze-hero__badge{display:inline-block;background:var(--nav-primary);color:#fff;font-size:.82rem;font-weight:700;padding:.45rem 1.25rem;border-radius:50px;margin-bottom:1rem;letter-spacing:.3px}

/* ===== USP SECTION — tighter spacing ===== */
.squeeze-usp{background-color:#fff;padding:2rem 1rem}.squeeze-usp__inner{max-width:1100px;margin:0 auto}

/* ===== TRUST METRICS SECTION — navy on white ===== */
.squeeze-trust{background:var(--nav-primary);color:#fff;padding:2rem 1rem;position:relative;overflow:hidden}
.squeeze-trust__inner{max-width:1100px;margin:0 auto;position:relative;z-index:1}

/* ===== CONTENT — tighter spacing ===== */
.squeeze-content{padding:2rem 1.5rem;max-width:1100px;margin:0 auto}

/* ===== FORM SECTION — light bg + navy card (fix: form text trắng cần nền navy) ===== */
.squeeze-form-section{background:linear-gradient(180deg,#f5f7fb 0%,#eef2f9 100%);padding:2.5rem 1rem;text-align:center;position:relative}
.squeeze-form-section__inner{max-width:460px;margin:0 auto;background:#26275D;background:linear-gradient(160deg,#26275D 0%,#0a0a8c 100%);color:#fff;border-radius:16px;padding:1.5rem 1.35rem;box-shadow:0 16px 40px rgba(38,39,93,.22),0 6px 16px rgba(0,0,0,.06);text-align:left}
.squeeze-form-section__inner > h2,
.squeeze-form-section__heading{color:#fff !important;font-family:"Montserrat",sans-serif;font-size:1.2rem;font-weight:800;line-height:1.3;margin:0 0 .5rem}
.squeeze-form-section__inner > p,
.squeeze-form-section__description{color:rgba(255,255,255,.78);font-size:.88rem;line-height:1.5;margin:0 0 1rem}
.squeeze-form-section__badges{display:flex;align-items:center;justify-content:center;gap:.6rem;margin-top:1.25rem;flex-wrap:wrap}
.squeeze-form-badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);padding:.35rem .8rem;border-radius:50px;font-size:.75rem;font-weight:500;color:rgba(255,255,255,.9)}
@media(max-width:480px){.squeeze-form-section__inner{padding:1.25rem 1rem;border-radius:14px}.squeeze-form-section__heading{font-size:1.1rem}}
/* Override: page-specific checklists/direct-dl khi nằm trong navy card → text trắng */
.squeeze-form-section__inner .chon-checklist li{color:#fff !important;background:rgba(255,255,255,.08) !important;border-left-color:var(--nav-accent) !important}
.squeeze-form-section__inner .chon-direct-dl{border-top-color:rgba(255,255,255,.2) !important}
.squeeze-form-section__inner .chon-direct-dl p{color:rgba(255,255,255,.85) !important}
.squeeze-form-section__inner .chon-direct-dl__btn{background:#fff !important;color:var(--nav-primary) !important;border-color:#fff !important}
.squeeze-form-section__inner .chon-direct-dl__btn:hover{background:var(--nav-accent) !important;color:var(--nav-primary) !important;border-color:var(--nav-accent) !important}
.squeeze-form-section__inner .chon-form-intro{text-align:center}

/* ===== URGENCY BAR ===== */
.squeeze-urgency{background:linear-gradient(90deg,#fff3dc 0%,#fff9ed 100%);border-top:2px solid var(--nav-accent);border-bottom:2px solid var(--nav-accent);padding:.85rem 1rem;text-align:center}
.squeeze-urgency__inner{max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:.75rem;flex-wrap:wrap}
.squeeze-urgency__text{font-size:.95rem;font-weight:600;color:var(--nav-primary)}
.squeeze-urgency__timer{font-family:"Montserrat",sans-serif;font-weight:800;background:var(--nav-primary);color:var(--nav-accent);padding:2px 10px;border-radius:6px;letter-spacing:.5px;font-size:.95rem}
.squeeze-urgency__cta{display:inline-flex;align-items:center;gap:.4rem;padding:.45rem 1.1rem;border-radius:8px;background:var(--nav-primary);color:#fff;text-decoration:none;font-size:.85rem;font-weight:700;transition:all .2s;white-space:nowrap}
.squeeze-urgency__cta:hover{background:var(--nav-primary-light);transform:translateY(-1px)}
.squeeze-urgency__pulse{display:inline-block;width:10px;height:10px;background:var(--nav-accent);border-radius:50%;animation:urgencyPulse 1.5s ease-in-out infinite;flex-shrink:0}
@keyframes urgencyPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}

/* ===== FAQ — wider ===== */
.squeeze-faq{padding:2rem 1.5rem;max-width:1100px;margin:0 auto}

/* ===== MOBILE CTA ===== */
.squeeze-mobile-cta{display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;background:linear-gradient(135deg,var(--nav-primary) 0%,var(--nav-primary-dark) 100%);color:#fff;padding:.85rem 1rem;text-align:center;box-shadow:0 -4px 20px rgba(38,39,93,.3)}
.squeeze-mobile-cta__inner{display:flex;align-items:center;justify-content:center;gap:.75rem}
.squeeze-mobile-cta__btn{display:inline-block;padding:.75rem 2rem;background:linear-gradient(135deg,var(--nav-accent),#fbe874);color:var(--nav-primary-dark);text-decoration:none;border-radius:8px;font-weight:700;border:none;cursor:pointer;transition:all .3s ease;font-size:1rem;animation:ctaPulse 2s ease-in-out infinite;box-shadow:0 4px 15px rgba(249, 221, 14,.4)}
@keyframes ctaPulse{0%,100%{box-shadow:0 4px 15px rgba(249, 221, 14,.4)}50%{box-shadow:0 4px 25px rgba(249, 221, 14,.7),0 0 40px rgba(249, 221, 14,.2)}}
.squeeze-mobile-cta__btn:hover{transform:translateY(-1px)}
.squeeze-mobile-cta__zalo{display:inline-flex;align-items:center;gap:.3rem;padding:.6rem 1rem;background:#0068FF;color:#fff;text-decoration:none;border-radius:8px;font-weight:700;font-size:.85rem;white-space:nowrap;transition:background .2s}.squeeze-mobile-cta__zalo:hover{background:#0056D6}

/* ===== FOOTER ===== */
.squeeze-footer{background-color:#111;color:#fff;padding:2.5rem 1.5rem;font-size:.875rem}.squeeze-footer__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem}
.squeeze-footer__contact{margin-bottom:1.5rem}.squeeze-footer__contact-title{font-weight:600;margin-bottom:.5rem;color:var(--nav-accent)}
.squeeze-footer__contact-item{margin-bottom:.35rem;opacity:.9}.squeeze-footer__contact-item a{color:var(--nav-accent);text-decoration:none}
.squeeze-footer__copyright{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.1);padding-top:1.25rem;text-align:center;opacity:.6;font-size:.8rem}

/* ===== RESPONSIVE ===== */
@media(max-width:768px){.squeeze-hero{padding:2rem 1rem 2rem}.squeeze-content{padding:2rem 1rem}.squeeze-form-section{padding:2.5rem 1rem}.squeeze-faq{padding:2rem 1rem}.squeeze-mobile-cta{display:block}main{padding-bottom:80px}.squeeze-footer__inner{grid-template-columns:1fr}}
@media(max-width:480px){.squeeze-hero{padding:1.75rem 1rem 1.5rem}.squeeze-urgency__text{font-size:.85rem}}
</style>
</head>
<body>
