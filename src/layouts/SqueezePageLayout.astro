height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<header class="squeeze-header"><div class="squeeze-header__inner">
  <a href="/" class="squeeze-brand"><img src="/logo-vietanh.webp" alt="Trường Việt Anh" class="squeeze-brand__img" width="180" height="52" loading="eager" /></a>
  <div class="squeeze-header__contacts">
    <a href="tel:+84916961409" class="squeeze-hdr-link">📞 Hotline: {hotline}</a>
    <span class="squeeze-hdr-sep">|</span>
    <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener noreferrer" class="squeeze-hdr-link">💬 <span class="squeeze-hdr-link--zalo-text">Zalo OA</span></a>
  </div>
</div></header>

<main>
<section class="squeeze-hero"><div class="squeeze-hero__content"><slot name="hero" /></div></section>
<section class="squeeze-usp"><div class="squeeze-usp__inner"><slot name="usp" /></div></section>
<section class="squeeze-trust"><div class="squeeze-trust__inner"><slot name="trust" /></div></section>
<section class="squeeze-content"><slot name="content" /></section>

{!hideUrgency && (
<div class="squeeze-urgency"><div class="squeeze-urgency__inner">
<span class="squeeze-urgency__pulse"></span>
<span class="squeeze-urgency__text">Nhà trường phản hồi trong 24 giờ làm việc<span id="urgencyLayoutTimer" hidden></span></span>
<a href="#form-section" class="squeeze-urgency__cta">Đăng ký ngay →</a>
</div></div>
)}

<section class="squeeze-form-section" id="form-section"><div class="squeeze-form-section__inner">
<slot name="form" />
<div class="squeeze-form-section__badges">
<span class="squeeze-form-badge">Bảo mật thông tin</span>
<span class="squeeze-form-badge">Tư vấn cá nhân hóa Lộ trình học tập</span>
<span class="squeeze-form-badge">Phản hồi trong 24h</span>
</div>
</div></section>
<section class="squeeze-faq"><slot name="faq" /></section>
<div class="squeeze-mobile-cta"><div class="squeeze-mobile-cta__inner">
<a href="#form-section" class="squeeze-mobile-cta__btn">🎯 Đánh giá miễn phí ngay</a>
<a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener noreferrer" class="squeeze-mobile-cta__zalo">💬 Zalo</a>
</div></div>
</main>
<slot name="footer"><FooterBase /></slot>
<script is:inline>
document.querySelector('.squeeze-mobile-cta__btn')?.addEventListener('click',function(){if(window.dataLayer){window.dataLayer.push({'event':'click_mobile_cta','section':'mobile_sticky'})}});
let maxScroll=0;window.addEventListener('scroll',function(){const p=(window.scrollY/(document.documentElement.scrollHeight-window.innerHeight))*100;if(p>maxScroll){maxScroll=p;if(maxScroll>25&&maxScroll<=50&&window.dataLayer){window.dataLayer.push({'event':'scroll_depth','depth':'25'})}else if(maxScroll>50&&maxScroll<=75&&window.dataLayer){window.dataLayer.push({'event':'scroll_depth','depth':'50'})}else if(maxScroll>75&&window.dataLayer){window.dataLayer.push({'event':'scroll_depth','depth':'75'})}}});
</script>
