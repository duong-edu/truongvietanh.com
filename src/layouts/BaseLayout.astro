        padding: 0.55rem 1rem; font-size: 1rem;
        position: relative; z-index: 101;
      }.announcement-bar__inner{
        max-width: 1200px; margin: 0 auto;
        display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      }.announcement-bar__text{ line-height: 1.4; }.announcement-bar__link{
        color: #fde047; font-weight: 700; text-decoration: underline;
        text-underline-offset: 2px; white-space: nowrap;
      }.announcement-bar__close{
        background: none; border: none; color: rgba(255,255,255,0.6);
        font-size: 1.3rem; cursor: pointer; padding: 0 0.25rem; line-height: 1;
        transition: color 0.2s; position: absolute; right: 1rem;
      }.announcement-bar__close:hover{ color: #fff; }
      @media(max-width:600px){.announcement-bar{ font-size: 1rem; padding: 0.5rem 2.5rem 0.5rem 0.75rem; } }/* === Zalo floating widget === */
      .zalo-float{
        position: fixed;
        bottom: 5.5rem;
        left: 1.25rem;
        z-index: 998;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #0068ff;
        color: #fff;
        padding: 0.7rem 1rem 0.7rem 0.8rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(0,104,255,0.35);
        transition: transform 0.25s, box-shadow 0.25s;
        animation: zaloFloat 3s ease-in-out infinite;
      }.zalo-float:hover{
        transform: scale(1.05);
        box-shadow: 0 6px 24px rgba(0,104,255,0.45);
        animation: none;
      }.zalo-float__label{
        font-size: 1rem;
        font-weight: 700;
        white-space: nowrap;
      }
      @keyframes zaloFloat {0%, 100%{ transform: translateY(0); }50%{ transform: translateY(-4px); }
      }
      @media(max-width:768px){.zalo-float{ bottom: 5.5rem; left: 0.75rem; padding: 0.6rem; border-radius: 50%; }.zalo-float__label{ display: none; }
      }
      @media(min-width:769px){.zalo-float{ bottom: 2rem; left: 2rem; } }/* === Back to top button === */
      .back-to-top{
        position: fixed;
        bottom: 5.5rem;
        right: 1.25rem;
        z-index: 998;
        width: 44px; height: 44px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
