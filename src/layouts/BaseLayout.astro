      .exit-popup__form{ text-align:left; }
      .exit-popup__form .lead-form{ max-width:none; }
      .exit-popup__input{
        width:100%; box-sizing:border-box; padding:0.85rem 1rem; border:1.5px solid #e2e8f0; border-radius:10px;
        font-size:1rem; font-family:'Inter',sans-serif;
      }.exit-popup__input:focus{ border-color:#f9dd0e; outline:none; }.exit-popup__submit{
        width:100%; padding:0.9rem 1.25rem; background:#f9dd0e;
        color:#26275D; border:none; border-radius:10px; font-weight:700; font-size:1rem;
        cursor:pointer;
      }.exit-popup__note{ font-size:1rem; color:#64748b; margin:0.75rem 0 0; }.exit-popup__note a{ color:#26275D; }
      @media(max-width:480px){.exit-popup__modal{ padding:1.75rem 1.25rem; }.exit-popup__form{ flex-direction:column; }.exit-popup__title{ font-size:1.5rem; }.exit-popup__desc{ font-size:1rem; }
      }/* === Skip to content === */
      .skip-to-content{
        position: absolute; top: -100px; left: 50%; transform: translateX(-50%);
        background: #26275D; color: #fff; padding: 0.75rem 1.5rem; border-radius: 0 0 8px 8px;
        font-weight: 700; font-size: 1rem; z-index: 99999; text-decoration: none;
        transition: top 0.2s;
      }.skip-to-content:focus{ top: 0; }/* === Announcement bar === */
      .announcement-bar{
        background: linear-gradient(90deg, #26275D, #2563eb);
