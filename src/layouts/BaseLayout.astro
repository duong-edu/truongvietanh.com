---
import '../styles/global.css';
import { getSiteSettings } from '../lib/directus';
import { GOOGLE_SITE_VERIFICATION } from '../data/school-facts';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { stripUrlPiiScript } from '../lib/strip-url-pii';

// Fetch site settings from Directus CMS (cached at build time)
const siteSettings = await getSiteSettings();
const announcementText = siteSettings?.announcement_text || 'Đặt lịch tham quan trường để được tư vấn lộ trình học và học phí.';
const announcementLink = siteSettings?.announcement_link || '/tuyen-sinh';
const announcementActive = siteSettings?.announcement_active ?? true;
const hotline = siteSettings?.hotline || '0916 961 409';
const zaloUrl = siteSettings?.zalo_url || 'https://zalo.me/0916961409';
const popupSeconds = (siteSettings as any)?.popup_seconds ?? 15;
const zaloOaId = (siteSettings as any)?.zalo_oa_id || '1678310120468101523';
const zaloOaUrl = `https://zalo.me/${zaloOaId}`;

type Props = {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
  noPopup?: boolean;
  ogImage?: string;
  /* Kích thước thật của ogImage (px). Khai để Facebook hiện ảnh NGAY từ lần dán đầu —
     thiếu thì lần chia sẻ đầu tiên thường ra thẻ không ảnh (FB tải ảnh bất đồng bộ). */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /* Mặc định 'website'. Trang văn bản/bài viết đặt 'article' — đừng đổi mặc định,
     hầu hết trang trên site là trang giới thiệu/landing. */
  ogType?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  /* Trang nhận tên/email/SĐT phụ huynh trên URL (vd. /cam-on?name=…&email=…): true = gỡ khỏi URL
     TRƯỚC khi GTM chạy, chỉ giữ `name` trong window.__vaQS; hoặc truyền danh sách khoá cần giữ.
     Mặc định tắt — các trang khác dùng layout này không đổi hành vi. */
  stripUrlPii?: boolean | string[];
};

const {
  title = 'Trường Việt Anh',
  description = 'Website Trường Việt Anh với cấu trúc tối ưu cho SEO, AI Overviews và tốc độ tải.',
  keywords,
  canonical,
  noindex = canonical?.includes('staging.') || canonical?.includes('workers.dev') || canonical?.includes('hoc.'),
  noPopup = true, /* TẠM THỜI tắt toàn bộ popup trên site — bật lại bằng cách đổi về false */
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  robots = noindex ? 'noindex, nofollow' : 'index, follow',
  structuredData,
  stripUrlPii = false,
} = Astro.props;
const stripUrlPiiJs = stripUrlPii ? stripUrlPiiScript(Array.isArray(stripUrlPii) ? stripUrlPii : ['name']) : null;

const schemaPayload = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData])
  : null;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    {stripUrlPiiJs && <script is:inline set:html={stripUrlPiiJs} />}
<!-- Google Tag Manager -->
<script src="/js/va-utm.js" is:inline></script>
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-TMPPWX29');</script>
<!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#26275D" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Blog Trường Việt Anh" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://media.truongvietanh.com" />
    <link rel="preconnect" href="https://media.truongvietanh.com" crossorigin />
    <link rel="preload" as="image" href="/logo-crest-80.webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/logo-vietanh.webp" fetchpriority="high" />
    <meta name="view-transition" content="same-origin" />
    <style is:inline>body,h1,h2,h3,h4,h5,h6,button,input,select,textarea{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}/* Page load animation */
      body{animation:pageIn 0.4s ease-out}
      @keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    </style>
    <script is:inline>
      (function(){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@600;700;800;900&display=swap&subset=vietnamese';document.head.appendChild(l)})();
    </script>
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@600;700;800;900&display=swap&subset=vietnamese" />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Trường Việt Anh" />
    <meta http-equiv="content-language" content="vi" />
    <meta property="og:locale" content="vi_VN" />
    {canonical && <link rel="alternate" hreflang="vi" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Trường Việt Anh" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImage && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImage && /\.jpe?g$/i.test(ogImage) && <meta property="og:image:type" content="image/jpeg" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {schemaPayload && <script is:inline type="application/ld+json" set:html={schemaPayload} />}
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
    <!-- End Google Tag Manager -->
    {GOOGLE_SITE_VERIFICATION !== 'google-site-verification-placeholder' && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}
  </head>
  <body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="skip-to-content">Bỏ qua đến nội dung chính</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Announcement Bar (from Directus CMS) -->
    {announcementActive && (
    <div class="announcement-bar" id="announcementBar">
      <div class="announcement-bar__inner">
        <span class="announcement-bar__text">
          {announcementText}
          <a href={announcementLink} class="announcement-bar__link">Đăng ký ngay</a>
        </span>
        <button class="announcement-bar__close" id="closeAnnouncement" aria-label="Đóng thông báo">&times;</button>
      </div>
    </div>
    )}

    <main id="main-content">
      <slot />
    </main>

    <!-- Exit Intent Popup -->
    {!noPopup && <div class="exit-popup" id="exitPopup" aria-hidden="true" data-auto-close={String(popupSeconds)}>
      <div class="exit-popup__overlay"></div>
      <div class="exit-popup__modal">
        <button class="exit-popup__close" id="exitPopupClose" aria-label="Đóng">&times;</button>
        <h3 class="exit-popup__title">⚠️ Chờ Ba/Mẹ! Con có thể đang bị bỏ lỡ mùa hè quan trọng nhất</h3>
        <p class="exit-popup__desc">Hơn <strong>200 bé đã đăng ký</strong> Trại hè Lion Camp 2026 — chỉ còn <strong>vài chỗ cuối</strong>.<br/>Để lại thông tin để tư vấn viên gọi trong <strong>5 phút</strong> + nhận ngay <strong>học bổng 15%</strong>.</p>
        <div class="exit-popup__form" data-form-bg="light">
          <LeadFormTwoStepEmailFirst
            formId="exit-popup-form"
            funnelCode="exit-intent"
            schoolLevel="lien-cap"
            title=""
            description=""
            socialProof=""
            nextText="Nhận tư vấn ngay"
            submitText="Gửi thông tin"
            successMessage="Cảm ơn Ba/Mẹ! Tư vấn viên sẽ liên hệ trong 24 giờ làm việc."
          />
        </div>
        <p class="exit-popup__note">
          Hoặc gọi ngay <a href={`tel:${hotline.replace(/\s/g, '')}`}><strong>{hotline}</strong></a>
          &nbsp;|&nbsp;
          <a href={zaloOaUrl} target="_blank" rel="noopener" style="color:#0068ff;font-weight:700">Chat Zalo OA</a>
        </p>
      </div>
    </div>}

    <!-- Zalo OA chat floating widget -->
    <a href={zaloOaUrl} target="_blank" rel="noopener" class="zalo-float" aria-label="Chat qua Zalo OA">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="zalo-float__label">Chat Zalo OA</span>
    </a>

    <!-- Back to top button -->
    <button class="back-to-top" aria-label="Cuộn lên đầu trang">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <!-- Sticky CTA mobile (from CMS) -->
    <div class="mobile-sticky-cta">
      <a href={`tel:${hotline.replace(/\s/g, '')}`} class="mobile-sticky-cta__call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Gọi ngay
      </a>
      <a href="/tuyen-sinh" class="mobile-sticky-cta__register">Đăng ký tư vấn</a>
    </div>

    <!-- Scroll animations + FAQ smooth + Animated counter -->
    <script is:inline>
    (function(){
      /* === Scroll fade-in === */
      var targets = document.querySelectorAll('section, .gi-faq-item, .news-card, .topic-card, .link-card, .facility-card, .why-card, .content-card');
      if(targets.length && 'IntersectionObserver' in window){
        targets.forEach(function(el){ el.classList.add('reveal'); });
        var obs = new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){ e.target.classList.add('revealed'); obs.unobserve(e.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        targets.forEach(function(el){ obs.observe(el); });
      }

      /* === FAQ smooth toggle === */
      document.querySelectorAll('details.gi-faq-item, details.faq-item').forEach(function(d){
        var summary = d.querySelector('summary');
        var content = d.querySelector('.gi-faq-answer, .faq-answer');
        if(!summary || !content) return;
        summary.addEventListener('click', function(e){
          e.preventDefault();
          if(d.open){
            content.style.maxHeight = content.scrollHeight + 'px';
            requestAnimationFrame(function(){ content.style.maxHeight = '0'; });
            content.addEventListener('transitionend', function handler(){ d.open = false; content.removeEventListener('transitionend', handler); }, {once:true});
          } else {
            d.open = true;
            content.style.maxHeight = '0';
            requestAnimationFrame(function(){ content.style.maxHeight = content.scrollHeight + 'px'; });
            content.addEventListener('transitionend', function handler(){ content.style.maxHeight = 'none'; content.removeEventListener('transitionend', handler); }, {once:true});
          }
        });
      });

      /* === Web Vitals tracking → GTM === */
      if('PerformanceObserver' in window){
        try{
          new PerformanceObserver(function(l){l.getEntries().forEach(function(e){
            if(window.dataLayer) window.dataLayer.push({event:'web_vital',metric_name:e.name,metric_value:Math.round(e.name==='CLS'?e.value*1000:e.value),metric_rating:e.rating||'unknown'});
          })}).observe({type:'largest-contentful-paint',buffered:true});
          new PerformanceObserver(function(l){l.getEntries().forEach(function(e){
            if(window.dataLayer) window.dataLayer.push({event:'web_vital',metric_name:'FID',metric_value:Math.round(e.processingStart-e.startTime)});
          })}).observe({type:'first-input',buffered:true});
          new PerformanceObserver(function(l){l.getEntries().forEach(function(e){
            if(!e.hadRecentInput&&window.dataLayer) window.dataLayer.push({event:'web_vital',metric_name:'CLS',metric_value:Math.round(e.value*1000)});
          })}).observe({type:'layout-shift',buffered:true});
        }catch(e){}
      }

      /* === Exit intent popup — chỉ kích hoạt khi khách định rời trang, không ưu tiên hiển thị === */
      var ep = document.getElementById('exitPopup');
      if(ep){
        var popupAutoClose = parseInt(ep.getAttribute('data-auto-close')) || 15;
        // Suppress if already submitted form OR dismissed in this session
        var alreadySubmitted = localStorage.getItem('lead_submitted');
        if(!alreadySubmitted && !sessionStorage.getItem('exit_shown')){
          var shown=false;
          var closeTimer=null;
          // Yêu cầu khách đã ở trên trang tối thiểu 120s (2 phút) trước khi popup có thể hiện
          var pageLoadTime = Date.now();
          var MIN_TIME_ON_PAGE = 120000;
          function showPopup(){
            if(shown) return;
            if(Date.now() - pageLoadTime < MIN_TIME_ON_PAGE) return;
            shown=true; ep.classList.add('is-open'); ep.setAttribute('aria-hidden','false');
            sessionStorage.setItem('exit_shown','1');
            if(popupAutoClose > 0){
              closeTimer = setTimeout(function(){ ep.classList.remove('is-open'); }, popupAutoClose * 1000);
            }
          }
          function closePopup(){ ep.classList.remove('is-open'); if(closeTimer) clearTimeout(closeTimer); }
          // Desktop exit intent: chuột rời viewport qua cạnh trên
          document.addEventListener('mouseout',function(e){
            if(!shown && e.clientY < 5 && !e.relatedTarget) showPopup();
          });
          // Mobile exit intent: khách chuyển tab/ứng dụng khác hoặc bấm nút back
          document.addEventListener('visibilitychange', function(){
            if(!shown && document.visibilityState === 'hidden') showPopup();
          });
          document.getElementById('exitPopupClose').addEventListener('click', closePopup);
          ep.querySelector('.exit-popup__overlay').addEventListener('click', closePopup);

          /* Form trong popup nay là LeadFormTwoStepEmailFirst (bước 1 email → bước 2 tên +
             SĐT), tự lo validate / gọi /api/lead / gắn UTM / chuyển sang /cam-on. Ở đây chỉ
             còn 2 việc phối hợp với popup:
             1. HUỶ auto-close ngay khi khách chạm vào form — trước đây popup tự đóng sau
                popup_seconds giây; với form 2 bước thì khách đang gõ dở bước 2 sẽ bị đóng
                mất form giữa chừng.
             2. Đánh dấu lead_submitted để lần sau không hiện lại popup nữa. */
          var epForm = ep.querySelector('form.lead-form');
          if(epForm){
            ['input','click'].forEach(function(evt){
              epForm.addEventListener(evt, function(){ if(closeTimer){ clearTimeout(closeTimer); closeTimer=null; } });
            });
            epForm.addEventListener('submit', function(){
              try{ localStorage.setItem('lead_submitted','1'); }catch(e){}
            });
          }
        }
      }

      /* === Announcement bar dismiss === */
      var annBar = document.getElementById('announcementBar');
      var closeAnn = document.getElementById('closeAnnouncement');
      if(annBar && closeAnn){
        if(sessionStorage.getItem('ann_closed')){annBar.style.display='none';}
        closeAnn.addEventListener('click',function(){annBar.style.display='none';sessionStorage.setItem('ann_closed','1');});
      }

      /* === Back to top === */
      var btt = document.querySelector('.back-to-top');
      if(btt){
        window.addEventListener('scroll', function(){
          btt.classList.toggle('is-visible', window.scrollY > 400);
        }, {passive:true});
        btt.addEventListener('click', function(){ window.scrollTo({top:0,behavior:'smooth'}); });
      }

      /* === Image skeleton loading === */
      document.querySelectorAll('img[loading="lazy"]').forEach(function(img){
        if(img.complete) return;
        img.style.background = 'linear-gradient(110deg, #f1f5f9 30%, #e8edf3 50%, #f1f5f9 70%)';
        img.style.backgroundSize = '200% 100%';
        img.style.animation = 'shimmer 1.5s ease-in-out infinite';
        img.addEventListener('load', function(){ img.style.background = ''; img.style.animation = ''; }, {once:true});
      });

      /* === gi-section collapsible === */
      document.querySelectorAll('.gi-section').forEach(function(section){
        if(section.id === 'faq') return;
        /* Trang văn bản (chính sách, quy định) phải đọc được trọn vẹn, không cắt cụt:
           đặt data-no-collapse trên section hoặc trên thẻ cha bao nó để bỏ qua. */
        if(section.closest('[data-no-collapse]')) return;
        var h2 = section.querySelector('h2');
        if(!h2) return;
        var siblings = [];
        var node = h2.nextElementSibling;
        while(node){ siblings.push(node); node = node.nextElementSibling; }
        if(siblings.length === 0) return;
        var wrap = document.createElement('div');
        wrap.className = 'gi-section__collapsible';
        siblings.forEach(function(s){ wrap.appendChild(s); });
        var btn = document.createElement('button');
        btn.className = 'gi-read-more-btn';
        btn.innerHTML = '… Đọc thêm ▾';
        btn.setAttribute('aria-expanded','false');
        btn.addEventListener('click', function(){
          var open = wrap.classList.toggle('is-open');
          btn.innerHTML = open ? '▴ Thu gọn' : '… Đọc thêm ▾';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        h2.after(wrap);
        wrap.after(btn);
      });

      /* === Animated counter === */
      document.querySelectorAll('.stat-num, .gi-stat-value, [data-counter]').forEach(function(el){
        var text = el.textContent.trim();
        var match = text.match(/^([\d,.]+)(\+?)(.*)$/);
        if(!match) return;
        var target = parseFloat(match[1].replace(/,/g, ''));
        var suffix = (match[2] || '') + (match[3] || '');
        var isFloat = match[1].indexOf('.') > -1;
        el.textContent = '0' + suffix;
        var counted = false;
        var cobs = new IntersectionObserver(function(entries){
          if(entries[0].isIntersecting && !counted){
            counted = true; cobs.disconnect();
            var start = performance.now();
            var duration = 1200;
            function step(now){
              var p = Math.min((now - start) / duration, 1);
              var ease = 1 - Math.pow(1 - p, 3);
              var val = ease * target;
              el.textContent = (isFloat ? val.toFixed(1) : Math.round(val)) + suffix;
              if(p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          }
        }, { threshold: 0.3 });
        cobs.observe(el);
      });
    })();
    </script>

    <style is:inline>/* === Scroll reveal animation === */
      .reveal{ opacity: 0; transform: translateY(28px); transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1); }.revealed{ opacity: 1 !important; transform: translateY(0) !important; }/* === FAQ smooth animation === */
      details.gi-faq-item .gi-faq-answer,
      details.faq-item .faq-answer{
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.22,1,0.36,1);
      }details.gi-faq-item summary,
      details.faq-item summary{
        position: relative;
        padding-right: 2rem;
        list-style: none;
      }details.gi-faq-item summary::-webkit-details-marker,
      details.faq-item summary::-webkit-details-marker{ display: none; }details.gi-faq-item summary::marker,
      details.faq-item summary::marker{ display: none; content: ''; }details.gi-faq-item summary::after,
      details.faq-item summary::after{
        content: '+';
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.4rem;
        font-weight: 300;
        color:#64748b;
        transition: transform 0.3s ease, color 0.3s ease;
        line-height: 1;
      }details[open].gi-faq-item summary::after,
      details[open].faq-item summary::after{
        content: '−';
        color: #2563eb;
        transform: translateY(-50%) rotate(0deg);
      }details[open].gi-faq-item summary,
      details[open].faq-item summary{
        color: #2563eb;
      }/* === Exit intent popup === */
      .exit-popup{ display:none; position:fixed; inset:0; z-index:99999; align-items:center; justify-content:center; }.exit-popup.is-open{ display:flex; }.exit-popup__overlay{ position:absolute; inset:0; background:rgba(0,0,0,0.6); backdrop-filter:blur(4px); }.exit-popup__modal{
        position:relative; background:#fff; border-radius:20px; padding:2rem 1.5rem;
        max-width:420px; width:92%; box-shadow:0 20px 60px rgba(0,0,0,0.25);
        text-align:center; animation:exitSlide 0.3s ease-out; box-sizing:border-box;
      }
      @keyframes exitSlide {from{transform:translateY(-30px);opacity:0}to{transform:translateY(0);opacity:1} }.exit-popup__close{
        position:absolute; top:0.75rem; right:1rem; background:none; border:none;
        font-size:1.5rem; color:#64748b; cursor:pointer;
