        transform: translateY(12px);
        transition: opacity 0.3s, visibility 0.3s, transform 0.3s, background 0.2s;
      }.back-to-top.is-visible{ opacity: 1; visibility: visible; transform: translateY(0); }.back-to-top:hover{ background: #f1f5f9; }.back-to-top svg{ color: #26275D; }
      @media(min-width:769px){.back-to-top{ bottom: 2rem; right: 2rem; } }

      /* === Image shimmer skeleton === */
      @keyframes shimmer {0%{ background-position: -200% 0; }100%{ background-position: 200% 0; }
      }/* === Sticky CTA mobile === */
      .mobile-sticky-cta{
