---
/**
 * TraiHeLandingLayout — Reusable Landing Page Layout for Trại Hè campaigns
 * ─────────────────────────────────────────────────────────────────────────
 * Features:
 *  - 2-step lead form (name + email → phone + grade)
 *  - Responsive: full-width content + sidebar form on desktop; stacked on mobile
 *  - GTM-TMPPWX29 + GTM-KPL2NSR9 both included
 *  - Sticky mobile bottom bar (Zalo + Call)
 *  - Quality Score optimized: title/desc/h1/h2 match ad copy
 *  - Inline critical CSS (no render-blocking)
 *
 * Usage: create a page, import this layout, pass props.
 * All content sections are driven by props — no manual HTML needed.
 *
 * To create a new landing page:
 *   1. Copy src/pages/tuyen-sinh/trai-he-tieu-hoc-go-vap/index.astro
 *   2. Change props to match the new campaign
 *   3. Done.
 */

export interface PainItem  { icon: string; title: string; desc?: string }
export interface Outcome   { num: string; icon: string; title: string; body: string }
export interface AgeGroup  { range: string; label: string; desc: string; highlight?: boolean }
export interface WhyItem   { icon: string; title: string; desc: string }
export interface GradeOpt  { value: string; label: string }
export interface ConcernOpt{ value: string; label: string }

interface Props {
  /* ── SEO & Quality Score ── */
  title: string;            // <title> — match ad headline for Quality Score
  description: string;      // meta description — include main keywords + CTA
  keywords?: string;        // meta keywords (optional, helps match ad copy)
  canonicalUrl: string;     // full URL
  extended?: boolean;       // một số trang truyền vào, layout hiện chưa dùng

  /* ── Location & Campaign ── */
  location: string;         // "Gò Vấp" | "Bình Tân" | "Cần Giuộc" | ...
  address?: string;         // full address
  khaigiang?: string;       // "15/06/2026"
  duration?: string;        // "6 tuần"
  ageRange?: string;        // "6–10 tuổi"
  schoolLevel?: string;     // 'tieu-hoc' | 'thcs' | 'thpt' | 'mam-non'
  levelLabel?: string;      // "Tiểu Học" | "THCS" | "THPT"

  /* ── Hero section ── */
  heroBadge?: string;       // "🔔 Đang nhận đăng ký · Khai giảng 15/06"
  heroTitle: string;        // Main H1 — MUST match ad headline closely
  heroTitleHighlight?: string; // Part of H1 to highlight in gold
  heroSubtitle: string;     // H1 tagline / sub
  heroIntroDesktop: string; // Hero intro paragraph (desktop)
  heroIntroMobile?: string; // Hero intro paragraph (mobile, shorter)
  heroBullets?: PainItem[]; // Desktop bullet list under hero text

  /* ── Content Sections ── */
  painTitle?: string;
  painSubtitle?: string;
  painItems: PainItem[];

  outcomesTitle?: string;
  outcomes: Outcome[];

  ageTitle?: string;
  ageSubtitle?: string;
  ageGroups?: AgeGroup[];

  whyTitle?: string;
  whyItems?: WhyItem[];

  /* ── Form ── */
  formBadge?: string;
  formTitle?: string;
  formSub?: string;
  nameLabel?: string;        // "Họ tên Ba/Mẹ"
  emailLabel?: string;       // "Email của Ba/Mẹ"
  phoneLabel?: string;       // "Số điện thoại Ba/Mẹ"
  gradeLabel?: string;       // "Con đang học lớp / tuổi"
  gradeOptions?: GradeOpt[];
  ctaStep1?: string;         // "Nhận thông tin ngay →"
  ctaSubmit?: string;        // "NHẬN THÔNG TIN CHI TIẾT CHƯƠNG TRÌNH"
  ctaAlt?: string;           // CTA for the section below (mobile)

  /* ── What they get (receive section) ── */
  receiveItems?: string[];  // Simple string list shown below hero on mobile

  /* ── Redirect & Tracking ── */
  redirectUrl: string;
  source: string;
  funnelCode: string;

  /* ── Trust ── */
  trustMarks?: string[];

  /* ── Footer CTA ── */
  bottomCtaTitle?: string;
  bottomCtaBody?: string;
}

const {
  title, description, keywords, canonicalUrl,
  location, address = '160/72 Phan Huy Ích, P.15, Q.Gò Vấp, TPHCM',
  khaigiang = '15/06/2026', duration = '6 tuần', ageRange = '6–10 tuổi',
  schoolLevel = 'tieu-hoc', levelLabel = 'Tiểu Học',
  heroBadge, heroTitle, heroTitleHighlight, heroSubtitle,
  heroIntroDesktop, heroIntroMobile, heroBullets = [],
  painTitle = 'Ba mẹ đang lo điều gì?', painSubtitle, painItems = [],
  outcomesTitle = 'Sau 6 tuần, con được gì?', outcomes = [],
  ageTitle = 'Lớp theo độ tuổi', ageSubtitle, ageGroups = [],
  whyTitle = 'Vì sao chọn Việt Anh ' + location + '?', whyItems = [],
  formBadge, formTitle, formSub,
  nameLabel  = 'Tên Ba/Mẹ',
  emailLabel = 'Email của Ba/Mẹ',
  phoneLabel = 'Số điện thoại Ba/Mẹ',
  gradeLabel = 'Con đang học lớp / tuổi',
  gradeOptions,
  ctaStep1 = 'Nhận thông tin ngay →',
  ctaSubmit = 'NHẬN THÔNG TIN CHI TIẾT CHƯƠNG TRÌNH',
  ctaAlt,
  receiveItems = [],
  redirectUrl, source, funnelCode,
  trustMarks = ['Có quyết định cho phép hoạt động', '15 năm K12 từ 2011', '2 cơ sở chính thức tại TP.HCM'],
  bottomCtaTitle, bottomCtaBody,
} = Astro.props;

const HOTLINE     = '0916 961 409';
const HOTLINE_TEL = '+84916961409';
const ZALO_URL    = 'https://zalo.me/1678310120468101523';

const badge     = heroBadge     ?? `🔔 Đang nhận đăng ký · Khai giảng ${khaigiang}`;
const fBadge    = formBadge     ?? `⏰ Khai giảng ${khaigiang} · Số chỗ có giới hạn`;
const fTitle    = formTitle     ?? `Nhận thông tin chương trình + học bổng Trại hè ${levelLabel}`;
const fSub      = formSub       ?? 'Điền thông tin để nhận lịch 6 tuần, học phí và học bổng';
const bCtaTitle = bottomCtaTitle?? `Đăng ký sớm — nhận học bổng tốt nhất`;
const bCtaBody  = bottomCtaBody ?? `Trại hè ${levelLabel} Việt Anh ${location} — ${duration} giúp con bớt màn hình, học tiếng Anh vui hơn, vận động nhiều hơn và sẵn sàng cho năm học mới.`;

const defaultGrades: GradeOpt[] = [
  { value: '6-tuoi',  label: '6 tuổi / Chuẩn bị lớp 1' },
  { value: 'lop-1',   label: 'Lớp 1 (7 tuổi)' },
  { value: 'lop-2',   label: 'Lớp 2 (8 tuổi)' },
  { value: 'lop-3',   label: 'Lớp 3 (9 tuổi)' },
  { value: 'lop-4',   label: 'Lớp 4 (10 tuổi)' },
  { value: 'lop-5',   label: 'Lớp 5 (11 tuổi)' },
];
const grades = gradeOptions ?? defaultGrades;
---
<!doctype html>
<html lang="vi">
<head>
<!-- Google Tag Manager -->
