<style is:inline>
/* ══════════════════════════════════════
   TraiHeLandingLayout — Critical CSS
   ══════════════════════════════════════ */
:root{
  --navy:#26275D;--navy-dk:#18193a;--navy-2:#0a0a99;--navy-soft:#f0f0ff;
  --gold:#f9dd0e;--gold-dk:#e6e600;--gold-soft:#fffde6;
  --green:#16a34a;--red:#dc2626;
  --text:#1a1a2e;--text-muted:#5a5a70;--border:#e5e7eb;
  --r:14px;--sh:0 8px 32px rgba(38,39,93,.16);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Open Sans',system-ui,sans-serif;color:var(--text);background:#fff;
  line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  padding-bottom:72px}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;font-weight:800;line-height:1.2;text-wrap:balance}
img{max-width:100%;height:auto;display:block}
a{color:inherit;text-decoration:none}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px;width:100%}

/* HEADER — single sticky bar: logo left | center info | right phone */
.hdr{background:#fff;border-bottom:2px solid var(--gold);padding:3px 0;
  position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.hdr .inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
  max-width:1160px;margin:0 auto;padding:0 20px;gap:16px;width:100%}
.hdr-logo{display:flex;justify-content:center}
.hdr img{height:72px;width:auto;display:block}
.hdr-left{text-align:left;font-size:12.5px;color:var(--text-muted);font-weight:600;line-height:1.4}
.hdr-left strong{display:block;font-size:13px;color:var(--navy);font-weight:800}
.hdr-right{text-align:right;font-size:13px;font-weight:700;color:var(--navy);white-space:nowrap;display:flex;flex-direction:column;align-items:flex-end;gap:3px}
.hdr-right a{color:var(--navy)}
.hdr-right .zalo-tag{display:inline-block;background:var(--navy);color:var(--gold);
  padding:3px 10px;border-radius:6px;font-size:11.5px;font-weight:900}
.hdr-cta{display:none}

/* HERO */
.hero{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dk) 100%);
  color:#fff;padding:40px 0 48px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:360px;height:360px;
  background:radial-gradient(circle,rgba(249,221,14,.12) 0%,transparent 70%);pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-160px;left:-120px;width:480px;height:480px;
  background:radial-gradient(circle,rgba(249,221,14,.07) 0%,transparent 70%);pointer-events:none}
.hero-inner{max-width:1160px;margin:0 auto;padding:0 20px;position:relative;z-index:1}
.hero-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start}
.badge{display:inline-flex;align-items:center;gap:8px;background:rgba(249,221,14,.15);
  border:1px solid rgba(249,221,14,.4);color:var(--gold);padding:7px 14px;border-radius:30px;
  font-size:12.5px;font-weight:700;margin-bottom:16px}
.badge .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);
  animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.h1{font-size:clamp(1.8rem,3.2vw,2.7rem);font-weight:900;color:#fff;
  margin-bottom:10px;letter-spacing:-.5px;line-height:1.15}
.h1 .hl{color:var(--gold)}
.h1 .sub{display:block;font-size:.68em;color:rgba(255,255,255,.82);font-weight:700;
  margin-top:7px;font-style:normal;letter-spacing:0}
.intro{font-size:16px;color:rgba(255,255,255,.9);line-height:1.7;margin-bottom:18px;
  border-left:4px solid var(--gold);padding-left:14px}
.meta-row{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px}
.meta-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);color:#fff;padding:6px 12px;border-radius:20px;
  font-size:13px;font-weight:600}
.bullets{list-style:none;display:flex;flex-direction:column;gap:9px;margin-bottom:20px}
.bullets li{display:flex;gap:10px;font-size:15px;color:rgba(255,255,255,.92);line-height:1.5}
.bullets .ic{flex-shrink:0;width:26px;height:26px;border-radius:50%;background:var(--gold);
  color:var(--navy-dk);display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:900;margin-top:1px}
.bullets strong{color:var(--gold)}
.trust{display:flex;flex-wrap:wrap;gap:14px;font-size:12.5px;color:rgba(255,255,255,.7);font-weight:600}
.trust span::before{content:'✓';color:var(--gold);font-weight:900;margin-right:5px}

/* ── 2-STEP FORM CARD ── */
.fcard{background:#fff;color:var(--text);border-radius:var(--r);
  box-shadow:0 20px 60px rgba(0,0,0,.3),0 0 0 3px var(--gold);overflow:hidden}
.fcard-tag{background:var(--gold);color:var(--navy-dk);text-align:center;
  padding:9px 14px;font-size:11.5px;font-weight:900;text-transform:uppercase;
  letter-spacing:.6px;border-bottom:2px solid rgba(38,39,93,.15)}
.fcard-body{padding:16px}
.fcard-title{font-size:1rem;font-weight:900;color:var(--navy);text-align:center;
  line-height:1.3;margin-bottom:3px}
.fcard-sub{font-size:11.5px;color:var(--text-muted);text-align:center;margin-bottom:12px;
  line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* Step indicator */
.step-ind{display:flex;align-items:center;justify-content:center;gap:8px;
  margin-bottom:14px;padding-bottom:12px;border-bottom:1px dashed var(--border)}
.sdot{width:24px;height:24px;border-radius:50%;background:#e5e7eb;color:#999;
  font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;
  transition:.3s;flex-shrink:0}
.sdot.active{background:var(--navy);color:var(--gold)}
.sdot.done{background:var(--green);color:#fff}
.sline{width:32px;height:2px;background:#e5e7eb}
.slabel{font-size:12px;color:var(--navy);font-weight:700;margin-left:8px}
/* Inputs */
.flabel{display:block;font-size:11.5px;font-weight:700;color:var(--navy);
  margin-bottom:3px;margin-top:9px}
.flabel:first-of-type{margin-top:0}
.finput{width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;
  font-size:14px;font-family:inherit;background:#fafbff;transition:.2s;color:var(--text)}
.finput:focus{outline:none;border-color:var(--navy);background:#fff;
  box-shadow:0 0 0 3px rgba(38,39,93,.09)}
.finput.error{border-color:var(--red);background:#fff5f5}
/* Buttons */
.btn-submit{width:100%;background:var(--navy);color:var(--gold);border:none;
  padding:13px;border-radius:9px;font-size:13.5px;font-weight:900;
  font-family:'Montserrat',sans-serif;cursor:pointer;transition:.15s;
  text-transform:uppercase;letter-spacing:.4px;
  box-shadow:0 4px 16px rgba(38,39,93,.3);margin-top:12px}
.btn-submit:hover{background:var(--navy-dk);transform:translateY(-1px);
  box-shadow:0 6px 22px rgba(38,39,93,.45)}
.btn-back{background:none;border:none;color:var(--text-muted);font-size:12px;
  font-weight:600;cursor:pointer;text-decoration:underline;padding:7px 0 0;
  width:100%;text-align:center}
.fcard-foot{display:flex;justify-content:space-around;gap:4px;flex-wrap:wrap;
  font-size:11px;color:var(--text-muted);margin-top:10px;padding-top:8px;
  border-top:1px solid var(--border);font-weight:600}
.fcard-foot span{display:flex;align-items:center;gap:3px}
.fcard-note{font-size:11px;color:var(--text-muted);text-align:center;
  margin-top:6px;line-height:1.45}

/* SECTIONS */
.sec{padding:52px 0;background:#fff}
.sec.light{background:#f5f6fa}
.sec.dark{background:var(--navy);color:#fff}
.sec.gold{background:var(--gold-soft)}
.sec-tag{display:inline-block;background:var(--gold);color:var(--navy-dk);
  font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.8px;
  padding:5px 14px;border-radius:20px;margin-bottom:12px}
.sec-tag.w{background:rgba(255,255,255,.15);color:var(--gold)}
.sec-h{font-size:clamp(1.4rem,2.5vw,2rem);color:inherit;margin-bottom:8px}
.sec-sub{font-size:15.5px;color:var(--text-muted);max-width:640px}
.sec.dark .sec-sub{color:rgba(255,255,255,.75)}
.sec-head{margin-bottom:32px}

/* PAIN GRID — 3 cols, no border */
.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.pain-card{background:#f8f9fc;border-radius:var(--r);
  padding:20px;display:flex;gap:12px;align-items:flex-start;transition:.15s}
.pain-card:hover{background:#f0f2f8}
.pain-icon{font-size:1.8rem;flex-shrink:0;margin-top:2px}
.pain-t strong{display:block;font-size:15px;color:var(--navy);margin-bottom:4px;font-weight:700}
.pain-t span{font-size:14px;color:var(--text-muted);line-height:1.55}

/* OUTCOMES GRID — no yellow top bar, no border */
.out-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.out-card{background:#f8f9fc;border-radius:var(--r);
  padding:24px 20px;position:relative;transition:.15s}
.out-card:hover{background:#f0f2f8;transform:translateY(-2px)}
.out-num{font-size:2rem;font-weight:900;color:rgba(38,39,93,.15);
  font-family:'Montserrat',sans-serif;margin-bottom:6px}
.out-title{font-size:1rem;font-weight:800;color:var(--navy);margin-bottom:8px}
.out-body{font-size:14px;color:var(--text-muted);line-height:1.65}

/* AGE GROUPS — no border */
.age-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.age-card{background:#f8f9fc;border-radius:var(--r);
  padding:24px;text-align:center;transition:.15s;position:relative}
.age-card:hover{background:#f0f2f8}
.age-card.hl{background:#eef0fa}
.age-badge-pill{display:inline-block;background:var(--navy);color:var(--gold);
  font-size:13px;font-weight:900;padding:6px 16px;border-radius:20px;
  margin-bottom:14px;font-family:'Montserrat',sans-serif}
.age-title{font-size:1.15rem;font-weight:800;color:var(--navy);margin-bottom:10px}
.age-desc{font-size:15px;color:var(--text-muted);line-height:1.65}
.age-pop{position:absolute;top:-1px;right:16px;background:var(--red);color:#fff;
  font-size:11px;font-weight:800;padding:4px 10px;border-radius:0 0 8px 8px;letter-spacing:.3px}

/* WHY GRID — 2 cols, no border on dark bg */
.why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.why-item{display:flex;gap:14px;align-items:flex-start;padding:18px;
  background:rgba(255,255,255,.07);border-radius:10px}
.why-ic{font-size:1.6rem;flex-shrink:0;margin-top:2px}
.why-t strong{display:block;font-size:15px;color:var(--gold);margin-bottom:4px}
.why-t span{font-size:14px;color:rgba(255,255,255,.82);line-height:1.6}

/* MOBILE CHECKLIST */
.mlist{list-style:none;display:flex;flex-direction:column;gap:9px}
.mlist li{display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:1.5}
.mlist li::before{content:'✅';flex-shrink:0;font-size:14px;margin-top:2px}

/* FORM SECTION */
.form-sec{background:#fff;padding:40px 0;border-top:1px solid var(--border)}
.form-sec .fcard{max-width:560px;margin:0 auto}

/* BOTTOM CTA */
.bcta{background:var(--navy);color:#fff;padding:48px 0;text-align:center}
.bcta h2{font-size:clamp(1.4rem,2.5vw,2rem);color:var(--gold);margin-bottom:8px}
.bcta p{font-size:15.5px;opacity:.85;margin-bottom:24px;max-width:560px;
  margin-left:auto;margin-right:auto}
.cta-row{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.cta-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:15px 28px;border-radius:10px;font-weight:900;font-size:15px;
  font-family:'Montserrat',sans-serif;transition:.15s;min-width:200px}
.cta-gold{background:var(--gold);color:var(--navy-dk);box-shadow:0 4px 18px rgba(249,221,14,.35)}
.cta-gold:hover{background:var(--gold-dk);transform:translateY(-2px)}
.cta-out{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5)}
.cta-out:hover{background:rgba(255,255,255,.1)}

/* FOOTER */
.footer{background:var(--navy-dk);color:rgba(255,255,255,.55);text-align:center;
  padding:20px;font-size:12.5px}
.footer a{color:var(--gold)}

/* STICKY MOBILE BAR */
.sticky{display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;
  border-top:2px solid var(--gold);z-index:300;padding:10px 16px;gap:10px}
.sticky .sb{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;
  padding:12px 10px;border-radius:9px;font-weight:900;font-size:13.5px;
  font-family:'Montserrat',sans-serif;text-decoration:none;border:none;cursor:pointer}
.sb-z{background:var(--navy);color:var(--gold)}
.sb-c{background:var(--gold);color:var(--navy-dk)}

/* VISIBILITY HELPERS — do NOT set display:block (it breaks display:grid) */
.m-only{display:none}

/* ── RESPONSIVE ── */
@media(max-width:960px){
  .hero-grid{grid-template-columns:1fr;gap:28px}
  .hero-form-col{display:none}
  .pain-grid{grid-template-columns:repeat(3,1fr)} /* keep 3 cols until mobile */
  .out-grid{grid-template-columns:repeat(2,1fr)}
  .age-grid{grid-template-columns:repeat(2,1fr) !important}
  .why-grid{grid-template-columns:1fr}
  .hdr-left,.hdr-right{font-size:12px}
  .hdr img{height:72px}
}
@media(max-width:640px){
  .sec{padding:36px 0}
  .hdr img{height:56px}
  .hdr .inner{grid-template-columns:auto 1fr;gap:10px}
  .hdr-left{display:none}
  .hdr-logo{justify-content:flex-start}
  .pain-grid{grid-template-columns:repeat(2,1fr)}
  .out-grid{grid-template-columns:1fr}
  .age-grid{grid-template-columns:1fr !important}
  .cta-row{flex-direction:column;align-items:center}
  .sticky{display:flex}
  .d-only{display:none !important}
  .m-only{display:block}
}
</style>
</head>
<body>
<!-- GTM noscript -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- HEADER — logo | center info | right Zalo+phone -->
<header class="hdr">
  <div class="inner">
    <div class="hdr-left">
      <strong>📍 Cơ sở {location} · Khai giảng {khaigiang}</strong>
      {address}
    </div>
    <a href="https://truongvietanh.com" class="hdr-logo" aria-label="Trường Việt Anh">
      <img src="/logo-vietanh.webp" alt="Trường Việt Anh" width="264" height="88" loading="eager" />
    </a>
    <div class="hdr-right">
      <span class="zalo-tag">💬 Zalo</span>
      <a href={`tel:${HOTLINE_TEL}`}>{HOTLINE}</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-grid">

      <!-- Content -->
      <div>
        <div class="badge"><span class="dot"></span> {badge}</div>
        <h1 class="h1">
          {heroTitle}
          {heroTitleHighlight && <span class="hl"> {heroTitleHighlight}</span>}
          <span class="sub">{heroSubtitle}</span>
        </h1>
        <p class="intro d-only">{heroIntroDesktop}</p>
        {heroIntroMobile && <p class="intro m-only" style="font-size:15px">{heroIntroMobile}</p>}
        {!heroIntroMobile && <p class="intro m-only" style="font-size:15px">{heroIntroDesktop}</p>}

        <div class="meta-row">
          <span class="meta-chip">📅 {khaigiang}</span>
          <span class="meta-chip">⏱️ {duration}</span>
          <span class="meta-chip">🏫 {location}</span>
          <span class="meta-chip">👦 {ageRange}</span>
        </div>

        {heroBullets.length > 0 && (
          <ul class="bullets d-only">
            {heroBullets.map(b => (
              <li><span class="ic">{b.icon}</span><span set:html={b.title} /></li>
            ))}
          </ul>
        )}

        <div class="trust d-only">
          {trustMarks.map(t => <span>{t}</span>)}
        </div>

        <a href="#form" class="m-only" style="display:inline-block;margin-top:16px;background:var(--gold);color:var(--navy-dk);font-weight:900;padding:13px 24px;border-radius:10px;font-family:'Montserrat',sans-serif;font-size:14px;letter-spacing:.3px">
          {ctaSubmit} ↓
        </a>
      </div>

      <!-- FORM CARD (desktop sidebar) -->
      <div class="hero-form-col" id="formAreaDesktop">
        <div class="fcard">
          <div class="fcard-tag">{fBadge}</div>
          <div class="fcard-body">
            <h3 class="fcard-title">{fTitle}</h3>
            <p class="fcard-sub">{fSub}</p>
            <div class="step-ind">
              <div class="sdot active" id="dot1d">1</div>
              <div class="sline"></div>
              <div class="sdot" id="dot2d">2</div>
              <span class="slabel" id="slabeld">Tên & Email</span>
            </div>

            <!-- Step 1: Name + Email -->
            <div id="step1d">
              <label class="flabel" for="dp-name">{nameLabel} <span style="color:var(--red)">*</span></label>
              <input class="finput" type="text" id="dp-name" placeholder="Nguyễn Thị A" autocomplete="name" />
              <label class="flabel" for="dp-email">{emailLabel} <span style="color:var(--red)">*</span></label>
              <input class="finput" type="email" id="dp-email" placeholder="tên@email.com" autocomplete="email" inputmode="email" />
              <button type="button" class="btn-submit" onclick="dsNext()">{ctaStep1}</button>
            </div>

            <!-- Step 2: Phone + Grade -->
            <div id="step2d" style="display:none">
              <label class="flabel" for="dp-phone">{phoneLabel} <span style="color:var(--red)">*</span></label>
              <input class="finput" type="tel" id="dp-phone" placeholder="0912 345 678" autocomplete="tel" inputmode="numeric" />
              <label class="flabel" for="dp-grade">{gradeLabel}</label>
              <select class="finput" id="dp-grade" style="cursor:pointer">
                <option value="">-- Chọn --</option>
                {grades.map(g => <option value={g.value}>{g.label}</option>)}
              </select>
              <button type="button" class="btn-submit" onclick="dsSubmit()">{ctaSubmit}</button>
              <button type="button" class="btn-back" onclick="dsBack()">← Quay lại</button>
            </div>

            <div class="fcard-foot">
              <span>🔒 Bảo mật</span>
              <span>📞 Phản hồi 24h</span>
              <span>💯 Miễn phí</span>
            </div>
            <p class="fcard-note">Tư vấn viên phản hồi trong 24h. Đăng ký sớm trước {khaigiang}.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- PAIN SECTION -->
{painItems.length > 0 && (
  <section class="sec light">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag">{painTitle}</span>
        <h2 class="sec-h">{painTitle}</h2>
        {painSubtitle && <p class="sec-sub d-only">{painSubtitle}</p>}
      </div>
      <div class="pain-grid d-only">
        {painItems.map(p => (
          <div class="pain-card">
            <div class="pain-icon">{p.icon}</div>
            <div class="pain-t">
              <strong>{p.title}</strong>
              {p.desc && <span>{p.desc}</span>}
            </div>
          </div>
        ))}
      </div>
      <ul class="mlist m-only">
        {painItems.map(p => <li><span><strong>{p.title}</strong>{p.desc ? ` — ${p.desc}` : ''}</span></li>)}
      </ul>
    </div>
  </section>
)}

<!-- OUTCOMES SECTION -->
{outcomes.length > 0 && (
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag">{outcomesTitle}</span>
        <h2 class="sec-h">{outcomesTitle}</h2>
      </div>
      <div class="out-grid d-only">
        {outcomes.map(o => (
          <div class="out-card">
            <div class="out-num">{o.num}</div>
            <div class="out-title">{o.icon} {o.title}</div>
            <div class="out-body">{o.body}</div>
          </div>
        ))}
      </div>
      <ul class="mlist m-only">
        {outcomes.map(o => <li><span><strong>{o.title}</strong> — {o.body}</span></li>)}
      </ul>
    </div>
  </section>
)}

<!-- AGE GROUPS SECTION -->
{ageGroups.length > 0 && (
  <section class="sec light">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag">{ageTitle}</span>
        <h2 class="sec-h">{ageTitle}</h2>
        {ageSubtitle && <p class="sec-sub">{ageSubtitle}</p>}
      </div>
      <div class="age-grid" style={`grid-template-columns:repeat(${Math.min(ageGroups.length,3)},1fr)`}>
        {ageGroups.map(a => (
          <div class={`age-card${a.highlight ? ' hl' : ''}`}>
            {a.highlight && <div class="age-pop">Phổ biến nhất</div>}
            <div class="age-badge-pill">{a.range}</div>
            <div class="age-title">{a.label}</div>
            <div class="age-desc">{a.desc}</div>
          </div>
        ))}
      </div>
      <p style="text-align:center;margin-top:20px;font-size:13.5px;color:var(--text-muted)">
        💡 Không chắc con phù hợp nhóm nào? Đăng ký và đội ngũ sẽ gợi ý nhóm phù hợp nhất.
      </p>
    </div>
  </section>
)}

<!-- WHY US SECTION -->
{whyItems.length > 0 && (
  <section class="sec dark">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag w">{whyTitle}</span>
        <h2 class="sec-h" style="color:#fff">{whyTitle}</h2>
      </div>
      <div class="why-grid d-only">
        {whyItems.map(w => (
          <div class="why-item">
            <div class="why-ic">{w.icon}</div>
            <div class="why-t">
              <strong>{w.title}</strong>
              <span>{w.desc}</span>
            </div>
          </div>
        ))}
      </div>
      <ul class="mlist m-only">
        {whyItems.map(w => <li><span><strong>{w.title}</strong> — {w.desc}</span></li>)}
      </ul>
    </div>
  </section>
)}

<!-- FORM SECTION (visible on all screens, prominent on mobile) -->
<section class="form-sec" id="form">
  <div class="wrap">
    <div style="text-align:center;margin-bottom:24px">
      <span class="sec-tag">Đăng ký nhận tư vấn</span>
      <h2 class="sec-h" style="margin-top:8px;font-size:1.5rem">Ba mẹ để lại thông tin để nhận:</h2>
      {receiveItems.length > 0 && (
        <ul class="mlist" style="max-width:500px;margin:16px auto 0;text-align:left">
          {receiveItems.map(r => <li><span set:html={r} /></li>)}
        </ul>
      )}
    </div>

    <div class="fcard" id="formAreaMobile">
      <div class="fcard-tag">{fBadge}</div>
      <div class="fcard-body">
        <h3 class="fcard-title">{fTitle}</h3>
        <p class="fcard-sub">{fSub}</p>

        <div class="step-ind">
          <div class="sdot active" id="dot1m">1</div>
          <div class="sline"></div>
          <div class="sdot" id="dot2m">2</div>
          <span class="slabel" id="slabelm">Tên & Email</span>
        </div>

        <!-- Step 1: Name + Email -->
        <div id="step1m">
          <label class="flabel" for="mp-name">{nameLabel} <span style="color:var(--red)">*</span></label>
          <input class="finput" type="text" id="mp-name" placeholder="Nguyễn Thị A" autocomplete="name" />
          <label class="flabel" for="mp-email">{emailLabel} <span style="color:var(--red)">*</span></label>
          <input class="finput" type="email" id="mp-email" placeholder="tên@email.com" autocomplete="email" inputmode="email" />
          <button type="button" class="btn-submit" onclick="msNext()">{ctaStep1}</button>
        </div>

        <!-- Step 2: Phone + Grade -->
        <div id="step2m" style="display:none">
          <label class="flabel" for="mp-phone">{phoneLabel} <span style="color:var(--red)">*</span></label>
          <input class="finput" type="tel" id="mp-phone" placeholder="0912 345 678" autocomplete="tel" inputmode="numeric" />
          <label class="flabel" for="mp-grade">{gradeLabel}</label>
          <select class="finput" id="mp-grade" style="cursor:pointer">
            <option value="">-- Chọn --</option>
            {grades.map(g => <option value={g.value}>{g.label}</option>)}
          </select>
          <button type="button" class="btn-submit" onclick="msSubmit()">{ctaSubmit}</button>
          <button type="button" class="btn-back" onclick="msBack()">← Quay lại</button>
        </div>

        <div class="fcard-foot">
          <span>🔒 Bảo mật</span><span>📞 Phản hồi 24h</span><span>💯 Miễn phí</span>
        </div>
        <p class="fcard-note">Tư vấn viên phản hồi trong 24h. Ba mẹ đăng ký sớm trước {khaigiang}.</p>
      </div>
    </div>

    <div style="text-align:center;margin-top:24px">
      <p style="font-size:14px;color:var(--text-muted);margin-bottom:12px">Hoặc liên hệ trực tiếp:</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href={ZALO_URL} target="_blank" rel="noopener"
          style="display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:var(--gold);padding:12px 22px;border-radius:9px;font-weight:800;font-size:14px;font-family:'Montserrat',sans-serif">
          💬 Nhắn Zalo
        </a>
        <a href={`tel:${HOTLINE_TEL}`}
          style="display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--navy-dk);padding:12px 22px;border-radius:9px;font-weight:800;font-size:14px;font-family:'Montserrat',sans-serif">
          📞 {HOTLINE}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- BOTTOM CTA -->
<section class="bcta">
  <div class="wrap">
    <h2>{bCtaTitle}</h2>
    <p>{bCtaBody}</p>
    <div class="cta-row">
      <a href="#form" class="cta-btn cta-gold">📋 {ctaSubmit}</a>
      <a href={`tel:${HOTLINE_TEL}`} class="cta-btn cta-out">📞 {HOTLINE}</a>
    </div>
    <p style="margin-top:16px;font-size:13px;opacity:.6">
      📅 Khai giảng: {khaigiang} · 🏫 {address} · 👦 {ageRange}
    </p>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <p>© {new Date().getFullYear()} Trường TH–THCS–THPT Việt Anh · {address} · <a href={`tel:${HOTLINE_TEL}`}>{HOTLINE}</a></p>
  <p style="margin-top:6px">
    <a href="https://truongvietanh.com">truongvietanh.com</a> ·
    <a href="https://truongvietanh.com/chinh-sach-bao-mat">Chính sách bảo mật</a>
  </p>
</footer>

<!-- STICKY BAR -->
<div class="sticky">
  <a href={ZALO_URL} target="_blank" rel="noopener" class="sb sb-z">💬 Nhắn Zalo</a>
  <a href={`tel:${HOTLINE_TEL}`} class="sb sb-c">📞 Gọi ngay</a>
</div>

<script define:vars={{ source, funnelCode, schoolLevel }}>
(function(){
  var SRC = source, FC = funnelCode, LVL = schoolLevel;

  function isValidEmail(v){
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
  }

  function doSubmit(name, email, phone, grade, formId){
    var el = document.getElementById(formId);
    if(el){ el.style.opacity='.5'; el.style.pointerEvents='none'; }
    var payload = JSON.stringify(Object.assign({
      fullName:name, email:email, phone:phone, childGrade:grade,
      source:SRC, funnel_code:FC, school_level:LVL,
      page_url:location.href, submitted_at:new Date().toISOString()
    },(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))()));
    localStorage.setItem('lp_'+SRC, '1');
    var done=false;
    var go=function(){ if(!done){ done=true; window.location.href='/cam-on?name=' + encodeURIComponent(name); } };
    fetch('https://truongvietanh.com/api/lead',{
      method:'POST', headers:{'Content-Type':'application/json'},
      body:payload, mode:'cors', keepalive:true
    }).then(function(r){ if(!r.ok) console.error('[lead] '+r.status); })
    .catch(function(){
      if(navigator.sendBeacon)
        try{ navigator.sendBeacon('https://truongvietanh.com/api/lead',
          new Blob([payload],{type:'application/json'})); }catch(ex){}
    }).finally(go);
    setTimeout(go, 3000);
  }

  /* Step 1 → Step 2: validate Name + Email */
  function stepNext(nameId, emailId, dot1Id, dot2Id, labelId, step1Id, step2Id, phoneId){
    var nameEl  = document.getElementById(nameId);
    var emailEl = document.getElementById(emailId);
    var name  = nameEl  ? nameEl.value.trim()  : '';
    var email = emailEl ? emailEl.value.trim() : '';
    var ok = true;
    if(!name){  if(nameEl){  nameEl.classList.add('error');  nameEl.focus(); }  ok=false; }
    else nameEl.classList.remove('error');
    if(!isValidEmail(email)){ if(emailEl){ emailEl.classList.add('error'); if(ok) emailEl.focus(); } ok=false; }
    else emailEl.classList.remove('error');
    if(!ok) return;
    document.getElementById(step1Id).style.display='none';
    document.getElementById(step2Id).style.display='block';
    var d1=document.getElementById(dot1Id), d2=document.getElementById(dot2Id), sl=document.getElementById(labelId);
    if(d1){d1.classList.remove('active');d1.classList.add('done');}
    if(d2) d2.classList.add('active');
    if(sl) sl.textContent='Số điện thoại';
    var p=document.getElementById(phoneId); if(p) p.focus();
  }

  /* Step 2 → back to Step 1 */
  function stepBack(dot1Id, dot2Id, labelId, step1Id, step2Id){
    document.getElementById(step2Id).style.display='none';
    document.getElementById(step1Id).style.display='block';
    var d1=document.getElementById(dot1Id), d2=document.getElementById(dot2Id), sl=document.getElementById(labelId);
    if(d2) d2.classList.remove('active');
    if(d1){d1.classList.remove('done');d1.classList.add('active');}
    if(sl) sl.textContent='Tên & Email';
  }

  /* Step 2 submit: validate Phone */
  function stepSubmit(nameId, emailId, phoneId, gradeId, formId){
    var phoneEl = document.getElementById(phoneId);
    var phone = phoneEl ? phoneEl.value.replace(/[^0-9]/g,'') : '';
    if(phone.length < 9){ if(phoneEl){phoneEl.classList.add('error');phoneEl.focus();} return; }
    phoneEl.classList.remove('error');
    var nameEl  = document.getElementById(nameId);
    var emailEl = document.getElementById(emailId);
    var gradeEl = document.getElementById(gradeId);
    var name  = nameEl  ? nameEl.value.trim()  : '';
    var email = emailEl ? emailEl.value.trim() : '';
    var grade = gradeEl ? gradeEl.value        : '';
    doSubmit(name, email, phoneEl.value.trim(), grade, formId);
  }

  // Desktop form
  window.dsNext   = function(){ stepNext('dp-name','dp-email','dot1d','dot2d','slabeld','step1d','step2d','dp-phone'); };
  window.dsBack   = function(){ stepBack('dot1d','dot2d','slabeld','step1d','step2d'); };
  window.dsSubmit = function(){ stepSubmit('dp-name','dp-email','dp-phone','dp-grade','formAreaDesktop'); };

  // Mobile form
  window.msNext   = function(){ stepNext('mp-name','mp-email','dot1m','dot2m','slabelm','step1m','step2m','mp-phone'); };
  window.msBack   = function(){ stepBack('dot1m','dot2m','slabelm','step1m','step2m'); };
  window.msSubmit = function(){ stepSubmit('mp-name','mp-email','mp-phone','mp-grade','formAreaMobile'); };

  // Enter key on step-1 email field triggers next
  ['dp-email','mp-email'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsNext() : msNext(); }
    });
  });
  // Enter key on step-2 phone field triggers submit
  ['dp-phone','mp-phone'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('keydown',function(e){
      if(e.key==='Enter'){ e.preventDefault();
        id.startsWith('dp') ? dsSubmit() : msSubmit(); }
    });
  });
})();
</script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
