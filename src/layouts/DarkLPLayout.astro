---
/**
 * DarkLPLayout — Ebook-style full-page dark landing page layout
 * Same visual design as /squeeze/ebook-9-linh-vuc-mam-non/
 * 2-step email-first form, dark navy background, 2-column desktop
 */
import { getSiteSettings } from '../lib/directus';
const settings = await getSiteSettings();
const hotline = settings?.hotline || '0916 961 409';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  fomoText?: string;
  headline: string;
  headlineEm?: string;
  subheadline: string;
  bullets: string[];
  testimonial?: string;
  testimonialAuthor?: string;
  cardUrgency?: string;
  cardTitle: string;
  ctaStep2?: string;
  source: string;
  funnelCode: string;
  schoolLevel?: string;
  mockupImage?: string;
  redirectUrl?: string;
  logoSrc?: string;
  extended?: boolean;
  formMode?: 'email' | 'tuoi';
}

const {
  title,
  description,
  canonicalUrl,
  fomoText = '🔥 3,000+ học sinh đang theo học — Đăng ký nhận tư vấn',
  headline,
  headlineEm,
  subheadline,
  bullets = [],
  testimonial = 'Trường tư vấn rất nhiệt tình, lộ trình rõ ràng. Con tôi tiến bộ rõ rệt sau một học kỳ!',
  testimonialAuthor = '— Phụ huynh học sinh Trường Việt Anh',
  cardUrgency = '⏰ Phản hồi trong 24h · Tư vấn miễn phí',
  cardTitle,
  ctaStep2 = '📋 GỬI THÔNG TIN ĐĂNG KÝ →',
  source,
  funnelCode,
  schoolLevel = 'tieu-hoc',
  mockupImage,
  redirectUrl = '/cam-on/',
  logoSrc = '/logo-vietanh.webp',
  extended = false,
  formMode = 'email',
} = Astro.props;
const isTuoi = formMode === 'tuoi';

const phoneDisplay = hotline;
const phoneHref = `tel:${hotline.replace(/\s/g, '')}`;
const phoneIntl = `+84${hotline.replace(/\s/g,'').replace(/^0/,'')}`;

const schemaData = [
  { '@context': 'https://schema.org', '@type': 'EducationalOrganization', name: 'Trường Việt Anh', url: canonicalUrl, description, contactPoint: { '@type': 'ContactPoint', contactType: 'Customer Service', telephone: phoneIntl } },
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonicalUrl, inLanguage: 'vi' },
];
---
<!doctype html>
<html lang="vi">
<head>
