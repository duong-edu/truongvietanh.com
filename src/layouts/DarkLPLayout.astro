<style is:inline>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:'Open Sans',sans-serif;background:#26275D;color:#fff;display:flex;flex-direction:column}
h1,h2,h3,h4{text-wrap:balance}
body.extended,html:has(body.extended){height:auto;overflow:auto;overflow-x:hidden}
body.extended .hero{flex:none;min-height:calc(100vh - 90px)}
.extra-sections{background:#fff;color:#222}
.extra-sections > *{max-width:1280px;margin:0 auto;padding:48px 24px}

/* ── HEADER ── */
.hdr{background:#fff;border-bottom:1px solid rgba(0,0,0,.09);padding:0 28px;height:90px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;position:relative}
.hdr-logo{height:80px;display:block;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);object-fit:contain}
.hdr-right{display:flex;align-items:center;gap:8px}
.btn-ph{display:flex;align-items:center;gap:5px;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.12);color:#26275D;padding:5px 12px;border-radius:7px;font-size:12px;font-weight:600;text-decoration:none}
.btn-zl{background:#0068FF;color:#fff;padding:5px 13px;border-radius:7px;font-size:12px;font-weight:700;text-decoration:none}

/* ── HERO: 2-COL GRID ── */
.hero{flex:1;min-height:0;display:grid;grid-template-columns:1.15fr 0.85fr;max-width:1280px;width:100%;margin:0 auto;padding:20px 44px 16px;gap:44px}

/* ── COLUMNS ── */
.col-left{display:flex;flex-direction:column;justify-content:space-between;gap:12px}
.col-right{display:flex;flex-direction:column;gap:10px}

/* ── HEADLINE ── */
.fomo{display:inline-flex;align-items:center;gap:6px;background:rgba(239,68,68,.13);border:1px solid rgba(239,68,68,.38);color:#ff8080;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.4px;margin-bottom:10px}
.h1{font-family:'Montserrat',sans-serif;font-size:clamp(1.9rem,3vw,2.95rem);font-weight:900;line-height:1.1;color:#fff;margin-bottom:11px}
.h1 em{color:#f9dd0e;font-style:normal;display:block}
.sub{font-size:15px;color:rgba(255,255,255,.82);line-height:1.5;font-weight:500;border-left:3px solid #f9dd0e;padding-left:12px}

/* ── BULLETS ── */
.bullets{list-style:none;display:flex;flex-direction:column;gap:9px}
.bullets li{display:flex;align-items:flex-start;gap:9px;font-size:13.5px;color:rgba(255,255,255,.86);line-height:1.4}
.bico{width:20px;height:20px;min-width:20px;border-radius:50%;background:rgba(249,221,14,.15);border:1.5px solid rgba(249,221,14,.5);display:flex;align-items:center;justify-content:center;margin-top:1px;flex-shrink:0}
.bico svg{width:10px;height:10px;stroke:#f9dd0e;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

/* ── TESTIMONIAL ── */
.testimonial{background:rgba(255,255,255,.05);border-left:3px solid #f9dd0e;border-radius:0 8px 8px 0;padding:8px 12px;font-size:12.5px;color:rgba(255,255,255,.7);line-height:1.5;font-style:italic}
.testimonial strong{color:#f9dd0e;font-style:normal;font-size:11px;display:block;margin-top:3px}

/* ── FORM CARD ── */
.card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.55);flex-shrink:0}
.card-top{background:linear-gradient(135deg,#26275D,#18193a);padding:10px 16px;text-align:center;border-bottom:2.5px solid #f9dd0e}
.card-urgency{color:#f9dd0e;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:2px}
.card-title{color:#fff;font-family:'Montserrat',sans-serif;font-weight:800;font-size:.83rem;line-height:1.3}
.card-body{padding:14px 16px 12px}
.form-label{display:block;font-size:10px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
.form-input{width:100%;padding:13px 14px;border:2.5px solid #e5e7eb;border-radius:10px;font-size:15px;outline:none;transition:.2s;font-family:inherit;color:#111;margin-bottom:10px}
.form-input:focus{border-color:#f9dd0e;box-shadow:0 0 0 3px rgba(249,221,14,.15)}
.form-input.error{border-color:#ef4444;animation:shake .3s ease}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

/* ★ MEGA CTA ★ */
.tuoi-q{font-weight:700;font-size:14px;color:#26275D;margin:0 0 10px}
.tuoi-q span{color:#b91c1c}
.tuoi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-bottom:6px}
.tuoi-btn{padding:13px 8px;border:2px solid #cbd5e1;border-radius:10px;background:#fff;color:#26275D;font:inherit;font-weight:800;font-size:15px;cursor:pointer;transition:.15s}
.tuoi-btn:hover,.tuoi-btn:focus-visible{border-color:#26275D;background:#fffbe0;outline:none}
.tuoi-btn:last-child:nth-child(odd){grid-column:1/-1}
.btn-cta{width:100%;padding:16px 12px;background:linear-gradient(135deg,#f9dd0e 0%,#f9dd0e 60%,#f9dd0e 100%);color:#26275D;font-family:'Montserrat',sans-serif;font-weight:900;font-size:15px;border:none;border-radius:11px;cursor:pointer;text-transform:uppercase;letter-spacing:.3px;box-shadow:0 6px 26px rgba(249,221,14,.65);transition:transform .15s,box-shadow .15s;position:relative;overflow:hidden;line-height:1.25}
.btn-cta::after{content:'';position:absolute;inset:0;background:linear-gradient(rgba(255,255,255,.18),transparent);border-radius:11px}
.btn-cta:hover{transform:translateY(-2px);box-shadow:0 10px 32px rgba(249,221,14,.75)}
.btn-cta:active{transform:translateY(0)}
.urgency-row{display:flex;align-items:center;justify-content:space-between;margin-top:7px;gap:4px}
.micro{font-size:10px;color:#aaa}

/* STEP BAR */
.step-bar{display:flex;align-items:center;gap:8px;margin-bottom:10px;justify-content:center}
.step-dot{width:22px;height:22px;border-radius:50%;background:#e5e7eb;color:#999;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;transition:.3s;flex-shrink:0}
.step-dot.active{background:#f9dd0e;color:#26275D}
.step-dot.done{background:#22c55e;color:#fff}
.step-line{flex:1;height:2px;background:#e5e7eb;max-width:50px}
.step-label{font-size:10px;color:#aaa;font-weight:600}

/* SUCCESS */
.success-box{display:none;padding:20px;text-align:center}
.success-box .s-ico{font-size:2rem;margin-bottom:6px}
.success-box h3{font-family:'Montserrat',sans-serif;color:#26275D;font-size:.9rem;margin-bottom:4px}
.success-box p{font-size:12px;color:#666;line-height:1.5}

/* MOCKUP */
.mockup-wrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center}
.mockup-wrap img{max-height:100%;max-width:100%;object-fit:contain;filter:drop-shadow(0 10px 32px rgba(0,0,0,.55));display:block}

/* ── MOBILE ── */
@media(max-width:900px){
  html,body{overflow-x:hidden;overflow-y:auto;height:auto}
  .hero{display:flex;flex-direction:column;padding:14px 16px 28px;gap:14px;flex:unset}
  .col-left,.col-right{display:contents}
  .item-headline{order:1}
  .item-form{order:2}
  .mockup-wrap{order:3;flex:unset;min-height:0}
  .mockup-wrap img{max-height:180px}
  .item-bullets{order:4}
  .item-social{order:5}
  .h1{font-size:1.55rem}
  .sub{font-size:13.5px}
  .hdr{height:90px;padding:0 16px}
  .hdr-logo{height:80px}
  .btn-cta{font-size:14.5px;padding:15px 10px}
}
@media(max-width:480px){
  .h1{font-size:1.35rem}
  .btn-ph span{display:none}
  .btn-cta{font-size:13.5px}
}
</style>
</head>
<body class:list={[extended && 'extended']}>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TMPPWX29"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header class="hdr">
  <a href="https://truongvietanh.com">
    <img src={logoSrc} alt="Trường Việt Anh" class="hdr-logo" width="200" height="60" loading="eager" fetchpriority="high" />
  </a>
  <div class="hdr-right">
    <a href={phoneHref} class="btn-ph">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.69 3.41 2 2 0 0 1 3.65 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.64a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16z"/></svg>
      <span>{phoneDisplay}</span>
    </a>
    <a href="https://zalo.me/0916961409" class="btn-zl">💬 Zalo</a>
  </div>
</header>

<section class="hero">
  <!-- LEFT COLUMN -->
  <div class="col-left">
    <div class="item-headline">
      <div class="fomo">{fomoText}</div>
      <h1 class="h1">
        {headline}
        {headlineEm && <em>{headlineEm}</em>}
      </h1>
      <p class="sub" set:html={subheadline} />
    </div>

    <div class="item-bullets">
      <ul class="bullets">
        {bullets.map(b => (
          <li>
            <span class="bico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span set:html={b} />
          </li>
        ))}
      </ul>
    </div>

    <div class="item-social">
      <div class="testimonial">
        {testimonial}
        <strong>{testimonialAuthor}</strong>
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN -->
  <div class="col-right">
    <div class="item-form">
      <div class="card" id="mainCard">
        <div class="card-top">
          <div class="card-urgency">{cardUrgency}</div>
          <div class="card-title">{cardTitle}</div>
        </div>
        <div class="card-body" id="formArea">
          <div class="step-bar">
            <div class="step-dot active" id="dot1">1</div>
            <div class="step-line"></div>
            <div class="step-dot" id="dot2">2</div>
            <span class="step-label" id="stepLabel">{isTuoi ? 'Tuổi của con' : 'Email'}</span>
          </div>
{isTuoi ? (
<Fragment>
          <!-- STEP 1: TUỔI CỦA CON -->
          <div id="step1">
            <p class="tuoi-q">Con bạn đang bao nhiêu tuổi? <span aria-hidden="true">*</span></p>
            <div class="tuoi-grid">
              <button type="button" class="tuoi-btn" onclick="sqPick('12 – 23 tháng')">12 – 23 tháng</button>
              <button type="button" class="tuoi-btn" onclick="sqPick('2 tuổi')">2 tuổi</button>
              <button type="button" class="tuoi-btn" onclick="sqPick('3 tuổi')">3 tuổi</button>
              <button type="button" class="tuoi-btn" onclick="sqPick('4 tuổi')">4 tuổi</button>
              <button type="button" class="tuoi-btn" onclick="sqPick('5 tuổi')">5 tuổi</button>
            </div>
          </div>
          <!-- STEP 2: HỌ TÊN + SĐT -->
          <div id="step2" style="display:none">
            <label class="form-label" for="sq-name">Họ và tên</label>
            <input class="form-input" type="text" id="sq-name" placeholder="Nguyễn Văn A" autocomplete="name" />
            <label class="form-label" for="sq-phone">Số điện thoại</label>
            <input class="form-input" type="tel" id="sq-phone" placeholder="0916 961 409" autocomplete="tel" />
            <label class="form-label" for="sq-email">Email</label>
            <input class="form-input" type="email" id="sq-email" placeholder="ten@gmail.com" autocomplete="email" />
            <button class="btn-cta" onclick="sqSubmit()">{ctaStep2}</button>
            <div class="urgency-row">
              <span class="micro"><span onclick="sqBack()" style="cursor:pointer;color:#bbb">← Quay lại</span> · 🔒 Bảo mật</span>
            </div>
          </div>
</Fragment>
) : (
<Fragment>
          <!-- STEP 1: EMAIL -->
          <div id="step1">
            <label class="form-label" for="sq-email">Email của bạn</label>
            <input class="form-input" type="email" id="sq-email" placeholder="ten@gmail.com" autocomplete="email" />
            <button class="btn-cta" onclick="sqNext()">TIẾP THEO →</button>
            <div class="urgency-row">
              <span class="micro">🔒 Không spam · Miễn phí hoàn toàn</span>
            </div>
          </div>
          <!-- STEP 2: HỌ TÊN + SĐT -->
          <div id="step2" style="display:none">
            <label class="form-label" for="sq-name">Họ và tên</label>
            <input class="form-input" type="text" id="sq-name" placeholder="Nguyễn Văn A" autocomplete="name" />
            <label class="form-label" for="sq-phone">Số điện thoại</label>
            <input class="form-input" type="tel" id="sq-phone" placeholder="0916 961 409" autocomplete="tel" />
            <button class="btn-cta" onclick="sqSubmit()">{ctaStep2}</button>
            <div class="urgency-row">
              <span class="micro"><span onclick="sqBack()" style="cursor:pointer;color:#bbb">← Quay lại</span> · 🔒 Bảo mật</span>
            </div>
          </div>
</Fragment>
)}
        </div>
        <div class="success-box" id="sqSuccess">
          <div class="s-ico">🎉</div>
          <h3>Đăng ký thành công!</h3>
          <p>Đội tư vấn sẽ liên hệ bạn trong vòng 24h.<br><strong>Kiểm tra Spam / Promotions nếu không thấy email.</strong></p>
        </div>
      </div>
    </div>

    {mockupImage && (
      <div class="mockup-wrap">
        <img src={mockupImage} alt={headline} width="480" height="640" loading="lazy" onerror="this.parentElement.style.display='none'" />
      </div>
    )}
  </div>
</section>

{extended && (
  <div class="extra-sections">
    <slot />
  </div>
)}

<script define:vars={{ source, funnelCode, schoolLevel, isTuoi }}>
(function(){
  var SRC = source;
  var FC  = funnelCode;
  var SL  = schoolLevel;

  if (localStorage.getItem('sq_' + SRC)) {
    var fa = document.getElementById('formArea');
    var su = document.getElementById('sqSuccess');
    if (fa) fa.style.display = 'none';
    if (su) su.style.display = 'block';
  }

  window.sqNext = function() {
    var el = document.getElementById('sq-email');
    var email = el ? el.value.trim() : '';
    if (!email || email.indexOf('@') < 1) {
      if (el) { el.classList.add('error'); el.focus(); }
      return;
    }
    el.classList.remove('error');
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    var d1 = document.getElementById('dot1');
    var d2 = document.getElementById('dot2');
    var sl = document.getElementById('stepLabel');
    if (d1) { d1.classList.remove('active'); d1.classList.add('done'); }
    if (d2) d2.classList.add('active');
    if (sl) sl.textContent = 'Họ tên & SĐT';
    var nameEl = document.getElementById('sq-name');
    if (nameEl) nameEl.focus();
  };

  var TUOI = '';
  window.sqPick = function(t){
    TUOI = t;
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    var d1 = document.getElementById('dot1'), d2 = document.getElementById('dot2'), sl = document.getElementById('stepLabel');
    if (d1){ d1.classList.remove('active'); d1.classList.add('done'); }
    if (d2) d2.classList.add('active');
    if (sl) sl.textContent = 'Họ tên, SĐT & email';
    if (window.dataLayer) window.dataLayer.push({ event: 'form_step_complete', step: 1, tuoi: t });
    var n = document.getElementById('sq-name'); if (n) n.focus();
  };

  window.sqBack = function() {
    document.getElementById('step2').style.display = 'none';
    document.getElementById('step1').style.display = 'block';
    var d1 = document.getElementById('dot1');
    var d2 = document.getElementById('dot2');
    var sl = document.getElementById('stepLabel');
    if (d2) d2.classList.remove('active');
    if (d1) { d1.classList.remove('done'); d1.classList.add('active'); }
    if (sl) sl.textContent = isTuoi ? 'Tuổi của con' : 'Email';
  };

  window.sqSubmit = function() {
    var nameEl  = document.getElementById('sq-name');
    var phoneEl = document.getElementById('sq-phone');
    var name  = nameEl ? nameEl.value.trim() : '';
    var phone = phoneEl ? phoneEl.value.trim() : '';
    if (!name) {
      if (nameEl) { nameEl.classList.add('error'); nameEl.focus(); }
      return;
    }
    if (nameEl) nameEl.classList.remove('error');
    if (!phone || phone.replace(/[^0-9]/g,'').length < 9) {
      if (phoneEl) { phoneEl.classList.add('error'); phoneEl.focus(); }
      return;
    }
    if (phoneEl) phoneEl.classList.remove('error');
    var emailEl = document.getElementById('sq-email');
    var email = emailEl ? emailEl.value.trim() : '';
    if (isTuoi && (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email))) { if (emailEl){ emailEl.classList.add('error'); emailEl.focus(); } return; }
    if (emailEl) emailEl.classList.remove('error');
    localStorage.setItem('sq_' + SRC, '1');
    var fa = document.getElementById('formArea');
    var su = document.getElementById('sqSuccess');
    if (fa) fa.style.display = 'none';
    if (su) su.style.display = 'block';

    fetch('https://truongvietanh.com/api/lead', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(Object.assign({
        fullName: name, phone: phone, email: email,
        source: SRC, funnel_code: FC, school_level: SL,
        tuoi_con: TUOI, note: TUOI ? 'Tuổi của con: ' + TUOI : '',
        page_url: location.href,
        submitted_at: new Date().toISOString()
      },(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))())),
      mode: 'cors'
    }).catch(function(){});

    setTimeout(function(){ window.location.href = '/cam-on?name=' + encodeURIComponent(name); }, 2000);
  };

  var emailInput = document.getElementById('sq-email');
  if (emailInput) {
    emailInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') { if (isTuoi) sqSubmit(); else sqNext(); } });
  }
})();
</script>
