---
import SalesPageLayout from '../../layouts/SalesPageLayoutGiaiMa.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirstGiaiMa.astro';
---

<SalesPageLayout
  title="Giải Mã Tiềm Năng – Giúp Con Hiểu Chính Mình Từ Gốc"
  description="Con không thiếu tiềm năng — chỉ thiếu người giúp con nhìn thấy. Đánh giá khoa học giúp học sinh hiểu cách mình suy nghĩ, học tập và ra quyết định."
  canonical="https://truongvietanh.com/giai-ma-tiem-nang/"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/banner-chinh.jpg"
  programCode="giai-ma-tiem-nang"
  schoolLevel="thpt"
  heroVariant="white-form"
>

  <!-- BLOCK 1: HERO — nền trắng + two-step form -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🧬 Giải Mã Tiềm Năng · Định hướng từ gốc</span>
      <h1>
        Bạn Có Chắc Mình <span class="mn-hl">Hiểu Con?</span>
        <span class="mn-sub">Con học không tệ… nhưng không có động lực. Con học nhiều… nhưng không biết mình thích gì.</span>
      </h1>
      <p class="mn-hero__lead">
        Vấn đề có thể không nằm ở việc con học chưa đủ — mà là <strong>con chưa hiểu chính mình</strong>. Tại Việt Anh, chúng tôi dùng khoa học để giúp con nhìn rõ bản thân trước những quyết định lớn của tuổi&nbsp;17–18.
      </p>
      <ul class="mn-hero__proof">
        <li><span class="mn-proof-check">✓</span> Đánh giá tiềm năng khoa học — không cảm tính</li>
        <li><span class="mn-proof-check">✓</span> Hiểu cách con suy nghĩ, học tập &amp; ra quyết định</li>
        <li><span class="mn-proof-check">✓</span> Tư vấn 1-1 định hướng từ gốc, cá nhân hoá</li>
      </ul>
      <div class="mn-hero__badges">
        <span>🏫 2 cơ sở chính thức · TP.HCM</span>
        <span>👨‍👩‍👧 3.000+ gia đình tin tưởng</span>
        <span>🎓 15 năm K12 từ 2011</span>
      </div>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">🎁 Khảo sát miễn phí</span>
      <h2>Đăng Ký Đánh Giá Tiềm Năng Cho Con</h2>
      <p class="mn-hero__form-sub">Để lại email — chuyên viên Việt Anh sẽ liên hệ trong 24h. Đánh giá sơ bộ tiềm năng · Gợi ý định hướng · Tư vấn&nbsp;1-1.</p>
      <LeadFormTwoStepEmailFirst
        formId="giai-ma-tiem-nang-hero"
        funnelCode="giai-ma-tiem-nang-hero"
        schoolLevel="thpt"
        submitText="Nhận khảo sát miễn phí"
      />
    </div>
  </Fragment>

  <!-- BLOCK 2: PAIN -->
  <div slot="pain">
    <p class="sp-pain__eyebrow">THỰC TẾ ÍT ĐƯỢC NÓI</p>
    <h2>Học sinh nào cũng có năng lực đặc biệt — nhưng hầu hết không hiểu đúng về bản thân</h2>
    <p>Rất nhiều học sinh hiện nay đang đi theo lối mòn của người khác mà không biết vì sao. Các em học theo định hướng gia đình, chọn theo số đông, làm tốt nhưng không có cảm giác thuộc về, thành công nhưng cảm thấy mệt mỏi và trống rỗng.</p>
    <ul class="sp-pain__list">
      <li>Học theo định hướng gia đình — không biết mình muốn gì</li>
      <li>Chọn ngành theo số đông — không biết mình mạnh ở đâu</li>
      <li>Làm tốt nhưng không có cảm giác thuộc về</li>
      <li>Mất động lực · mất phương hướng · hoặc chọn sai con đường</li>
    </ul>
    <p>Điều đáng tiếc nhất không phải là con không giỏi. Mà là con có tiềm năng — nhưng không biết cách sử dụng nó.</p>
  </div>

  <!-- BLOCK 3: FEATURES -->
  <div slot="features">
    <p class="sp-features__eyebrow">PHƯƠNG PHÁP GIẢI MÃ TIỀM NĂNG</p>
    <h2>Không Phải "Tư Vấn Nghề" — Mà Là Giúp Con Hiểu Mình Từ Gốc</h2>
    <p class="sp-features__sub">5 trụ cột giúp học sinh nhìn rõ bản thân và xây nền tảng định hướng vững chắc</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Đánh giá tiềm năng cá nhân</h3>
        <p>Hiểu cách con suy nghĩ, học tập và ra quyết định</p>
        <span class="sp-feat-card__tag">Đánh giá khoa học</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Nhận diện điểm mạnh – điểm yếu</h3>
        <p>Không dựa trên điểm số, mà dựa trên bản chất của con</p>
        <span class="sp-feat-card__tag">Bản chất</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>Làm rõ xu hướng phát triển</h3>
        <p>Con phù hợp với môi trường và con đường nào</p>
        <span class="sp-feat-card__tag">Định hướng</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🔍</div>
        <h3>Hiểu cách con vận hành</h3>
        <p>Vì sao con dễ chán, dễ bỏ cuộc hoặc mất động lực</p>
        <span class="sp-feat-card__tag">Cách vận hành</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🚀</div>
        <h3>Xây nền tảng định hướng</h3>
        <p>Không đưa ra quyết định thay con — mà giúp con biết cách quyết định đúng</p>
        <span class="sp-feat-card__tag">Tự chủ</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 4: TEXT WITH IMAGE -->
  <div slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">CON KHÔNG THIẾU TIỀM NĂNG</p>
      <h2>Con Chỉ Thiếu Người Giúp Con Nhìn Thấy</h2>
      <p>Phần lớn trẻ không biết mình mạnh ở đâu, không hiểu vì sao mình thích hoặc không thích điều gì. Phụ huynh muốn giúp con — nhưng không có công cụ để hiểu con sâu hơn. Kết quả: cả hai cùng "đoán" và hy vọng chọn đúng.</p>
      <p>Tại Việt Anh, tôi không đoán. Chúng tôi dùng khoa học để giúp học sinh nhìn rõ bản thân, hiểu cách mình vận hành, và nhận ra con đường phù hợp — trước khi ra những quyết định lớn của tuổi&nbsp;17–18.</p>
    </div>
    <div class="sp-textimg__img">
      <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh Việt Anh hiểu bản thân qua đánh giá khoa học" width="600" height="340" loading="lazy" />
    </div>
  </div>

  <!-- BLOCK 5: STATS -->
  <div slot="stats">
    <h2>Hậu Quả Của Việc Không Hiểu Bản Thân</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">50%</span>
        <span class="sp-stat__label">Sinh viên đổi ngành sau năm 1–2 vì chọn sai</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3–5 năm</span>
        <span class="sp-stat__label">Thời gian trung bình để "thử và sai" mới hiểu mình</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">15 năm</span>
        <span class="sp-stat__label">Kinh nghiệm K12 từ 2011 — Việt Anh đồng hành cùng học sinh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">1-1</span>
        <span class="sp-stat__label">Tư vấn cá nhân hoá với chuyên viên cho từng học sinh</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 6: QUOTE -->
  <div slot="quote">
    <p class="sp-quote__eyebrow">QUAN ĐIỂM CỦA NGUYỄN MẠNH DƯƠNG</p>
    <div class="sp-quote__card">
      <p class="sp-quote__text">
        "Tôi đã làm K12 từ 2011 — và điều khiến tôi day dứt nhất không phải là điểm số của các em. Mà là việc các em không biết mình là ai khi đứng trước những lựa chọn lớn. Giải Mã Tiềm Năng ra đời để con có một thứ mà thế hệ tôi không có: được hiểu chính mình trước khi quyết định tương lai của mình."
      </p>
      <div class="sp-quote__author">
        <div>
          <div class="sp-quote__name">Nguyễn Mạnh Dương</div>
          <div class="sp-quote__meta">Sáng lập & Chủ tịch Trường Việt Anh — 15 năm K12 từ 2011</div>
        </div>
      </div>
    </div>
  </div>

  <!-- BLOCK 7: PRICING -->
  <div slot="pricing">
    <p class="sp-pricing__eyebrow">SO SÁNH GIÁ TRỊ</p>
    <h2>Đây Không Phải Một Khoá Học — Mà Là Một Quyết Định Quan Trọng</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <p class="sp-pricing-col__label">Lựa chọn 1</p>
        <div class="sp-pricing-col__price">3–5 năm</div>
        <div class="sp-pricing-col__unit">tự thử và sai</div>
        <ul class="sp-pricing-col__features">
          <li>Để con tự tìm hiểu bản thân</li>
          <li>Chọn theo số đông hoặc cảm tính</li>
          <li>Mất nhiều năm đi sai đường</li>
          <li>Đổi ngành / mất động lực giữa chừng</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <p class="sp-pricing-col__label">Lựa chọn 2 — Giải Mã Tiềm Năng</p>
        <div class="sp-pricing-col__price">Hiểu mình</div>
        <div class="sp-pricing-col__unit">trước khi quyết định</div>
        <ul class="sp-pricing-col__features">
          <li>Đánh giá tiềm năng khoa học</li>
          <li>Tư vấn 1-1 với chuyên viên</li>
          <li>Hiểu rõ điểm mạnh và cách vận hành</li>
          <li>Chọn đúng hơn — đi nhanh hơn</li>
          <li>Nền tảng cho mọi quyết định lớn sau này</li>
        </ul>
      </div>
    </div>
    <p class="sp-pricing__note">* Giá trị không nằm ở chi phí. Mà nằm ở việc con có phải trả giá bằng 3–5 năm sai đường hay không.</p>
  </div>

  <!-- BLOCK 8: CTA -->
  <div slot="cta">
    <h2>Đừng Đợi Đến Khi Con Chọn Sai Mới Bắt Đầu Hiểu Con</h2>
    <p>Bạn không cần quyết định ngay. Nhưng bạn nên bắt đầu bằng việc hiểu con đúng cách.</p>
    <a href="#mn-hero-form" class="sp-cta-btn">Nhận khảo sát MIỄN PHÍ →</a>
  </div>

  <!-- BLOCK 9: FORM 1 -->
  <Fragment slot="form1">
    <div class="mn-hero__form" id="sp-form1-card" style="max-width:560px;margin:0 auto;text-align:left">
      <span class="mn-hero__form-eyebrow">🎁 Khảo sát miễn phí</span>
      <h2>Đăng Ký Đánh Giá Tiềm Năng Cho Con</h2>
      <p class="mn-hero__form-sub">Để lại email — chuyên viên Việt Anh sẽ liên hệ trong 24h. Đánh giá sơ bộ tiềm năng · Gợi ý định hướng · Tư vấn&nbsp;1-1.</p>
      <LeadFormTwoStepEmailFirst
        formId="giai-ma-tiem-nang-form"
        funnelCode="giai-ma-tiem-nang"
        schoolLevel="thpt"
        submitText="Nhận khảo sát miễn phí"
      />
    </div>
  </Fragment>

  <!-- BLOCK 10: FAQ -->
  <div slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Câu Hỏi Phụ Huynh Hỏi Nhiều Nhất</h2>
    <p class="sp-faq__sub">Những điều bạn cần biết trước khi đăng ký đánh giá Giải Mã Tiềm Năng</p>

    <details class="sp-faq-item">
      <summary>Con tôi chưa biết mình thích gì — có phù hợp không?</summary>
      <div class="sp-faq-answer">Đây chính là nhóm cần nhất. Khi con chưa rõ mình thích gì, đó không phải là "con có vấn đề" — mà là con chưa có công cụ để nhìn vào bên trong. Chương trình sẽ giúp con bắt đầu từ đó.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Chương trình có giúp con chọn ngành không?</summary>
      <div class="sp-faq-answer">Giúp con hiểu bản thân trước — từ đó chọn đúng ngành phù hợp với cách con vận hành, thay vì chọn theo số đông hay cảm tính.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Bao lâu thấy kết quả?</summary>
      <div class="sp-faq-answer">Sự rõ ràng trong suy nghĩ thường xuất hiện rất sớm — ngay sau quá trình đánh giá và làm việc cùng chuyên viên, con đã có góc nhìn mới về chính mình.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Có thay thế tư vấn hướng nghiệp không?</summary>
      <div class="sp-faq-answer">Không thay thế. Đây là <strong>nền tảng</strong> để mọi tư vấn hướng nghiệp sau đó chính xác hơn — vì bất kỳ lời khuyên nào cũng cần bắt đầu từ việc hiểu con là ai.</div>
    </details>
  </div>

</SalesPageLayout>
