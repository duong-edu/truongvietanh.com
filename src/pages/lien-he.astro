---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';
import { openingHoursSpecification, schoolFacts } from '../data/school-facts';

const cmsPage = await getPillarPage('lien-he');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Liên Hệ Trường Việt Anh",
    "url": "https://truongvietanh.com/lien-he",
    "description": "Liên hệ Trường Việt Anh qua Hotline, Zalo, Email. Địa chỉ 6 cơ sở tại TP.HCM, Tây Ninh, An Giang. Tư vấn cá nhân hóa Lộ trình học tập, phản hồi trong 24 giờ.",
    "mainEntity": {
      "@type": "EducationalOrganization",
      "name": "Hệ Thống Trường Liên Cấp Việt Anh",
      "telephone": "+84916961409",
      "email": "info@truongvietanh.com",
      "url": "https://truongvietanh.com",
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh",
          "addressLocality": "Thành phố Hồ Chí Minh",
          "addressCountry": "VN"
        }
      ],
      "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Liên hệ Trường Việt Anh qua kênh nào nhanh nhất?",
        "acceptedAnswer": { "@type": "Answer", "text": "Kênh nhanh nhất là Zalo OA Trường Việt Anh (zalo.me/1678310120468101523). Đội ngũ tư vấn phản hồi qua Zalo trong vòng 15-30 phút trong giờ làm việc. Ngoài giờ, phụ huynh có thể gọi Hotline 0916 961 409." }
      },
      {
        "@type": "Question",
        "name": "Tham quan trường Việt Anh có cần đặt lịch trước không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Phụ huynh nên đặt lịch trước qua Hotline, Zalo hoặc điền form trên website để được sắp xếp lịch tham quan phù hợp. Buổi tham quan kéo dài khoảng 45-60 phút, bao gồm giới thiệu cơ sở vật chất, chương trình học và gặp gỡ giáo viên." }
      },
      {
        "@type": "Question",
        "name": "Tư vấn tuyển sinh tại Trường Việt Anh có miễn phí không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hoàn toàn miễn phí. Đội ngũ tư vấn sẽ hỗ trợ phụ huynh tìm hiểu chương trình, lộ trình học phù hợp với con và giải đáp mọi thắc mắc về học phí, cơ sở vật chất, xe đưa rước mà không phát sinh bất kỳ chi phí nào." }
      },
      {
        "@type": "Question",
        "name": "Ngoài giờ làm việc, liên hệ Trường Việt Anh bằng cách nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường đón khách Thứ 2 – Thứ 7, 07:00 – 19:00. Ngoài khung giờ đó và vào Chủ Nhật, phụ huynh có thể nhắn tin qua Zalo OA hoặc điền form trên website; đội ngũ tư vấn sẽ phản hồi vào đầu ngày làm việc tiếp theo. Riêng tham quan trường vào Chủ Nhật vẫn sắp xếp được nếu phụ huynh hẹn trước qua Hotline hoặc Zalo OA." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh có tư vấn online không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Phụ huynh ở xa hoặc không tiện đến trường có thể đặt lịch tư vấn online qua Zalo Video Call hoặc Google Meet. Đội ngũ tư vấn sẽ giới thiệu chi tiết chương trình, chia sẻ hình ảnh cơ sở và giải đáp trực tiếp mọi câu hỏi." }
      },
      { "@type": "Question", "name": "Phụ huynh ở tỉnh có thể cho con học tại Trường Việt Anh không?", "acceptedAnswer": { "@type": "Answer", "text": "Hoàn toàn được. Trường có hệ thống bán trú và cơ sở tại Tây Ninh, An Giang. Liên hệ tư vấn viên để được hướng dẫn về lưu trú và đưa đón." } },
      { "@type": "Question", "name": "Trường có hỗ trợ hồ sơ chuyển trường không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Phòng Tuyển sinh hỗ trợ toàn bộ: tư vấn hồ sơ, kiểm tra đầu vào, liên hệ trường cũ lấy học bạ. Quy trình 5-7 ngày." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Liên hệ", "item": "https://truongvietanh.com/lien-he" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Trường Việt Anh",
    "image": "https://truongvietanh.com/logo-crest-80.webp",
    "telephone": "+84916961409",
    "email": "tuyensinh@truongvietanh.com",
    "url": "https://truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "168/2 Phan Huy Ích",
      "addressLocality": "Gò Vấp",
      "addressRegion": "TP. Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 10.8431,
      "longitude": 106.6422
    },
    "openingHoursSpecification": openingHoursSpecification,
    "priceRange": "$$"
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Liên Hệ Trường Việt Anh — Hotline, Zalo, Địa Chỉ Các Cơ Sở"}
  description={cmsPage?.description || "Liên hệ Trường Việt Anh qua Hotline 0916 961 409, Zalo OA, Email. Địa chỉ 6 cơ sở tại TP.HCM, Tây Ninh, An Giang. Tư vấn cá nhân hóa Lộ trình học tập — Phản hồi trong 24 giờ."}
  keywords="liên hệ trường việt anh, hotline 0916 961 409, zalo oa vsc, địa chỉ 6 cơ sở, đặt hẹn tham quan trường"
  canonical="https://truongvietanh.com/lien-he"
  ogImage="https://media.truongvietanh.com/images/extra-big-img3-scaled.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Liên hệ</span>
          </nav>

          <h1 class="gi-h1">Liên Hệ Trường Việt Anh</h1>
          <p class="gi-subtitle">Tư vấn cá nhân hóa Lộ trình học tập — Phản hồi trong 24 giờ</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>{schoolFacts.campuses}</strong> Cơ sở</div>
            <div class="gi-badge"><strong>24h</strong> Phản hồi</div>
            <div class="gi-badge"><strong>Cá nhân hóa</strong> Lộ trình</div>
            <div class="gi-badge"><strong>Zalo</strong> Nhanh nhất</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký nhận tư vấn cá nhân hóa lộ trình học tập ngay</p>
            <LeadFormTwoStepEmailFirst
              formId="lien-he-form"
              funnelCode="lien-he-page"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#lien-he-nhanh">Liên hệ nhanh</a></li>
          <li><a href="#dia-chi">Địa chỉ các cơ sở</a></li>
          <li><a href="#gio-lam-viec">Giờ làm việc</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#lien-he-form-lien-he-page" class="gi-toc-cta">Đăng ký tư vấn</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Thông tin liên hệ nhanh -->
        <section id="lien-he-nhanh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>Thông tin liên hệ nhanh</h2>
          <p>Phụ huynh có thể liên hệ Trường Việt Anh qua nhiều kênh khác nhau. Chúng tôi cam kết phản hồi mọi yêu cầu trong vòng 24 giờ làm việc. Kênh nhanh nhất để nhận tư vấn là Zalo OA — đội ngũ tư vấn trả lời trong 15-30 phút trong giờ làm việc.</p>

          <div class="lh-contact-grid">
            <div class="lh-contact-card lh-primary">
              <span class="lh-icon">&#9742;</span>
              <h3>Hotline Tổng đài</h3>
              <a href="tel:0916961409" class="lh-phone">0916 961 409</a>
              <p>Gọi trực tiếp, phản hồi ngay trong giờ làm việc. Đường dây dành cho tư vấn tuyển sinh các cấp từ Tiểu học đến THPT.</p>
            </div>
            <div class="lh-contact-card lh-primary">
              <span class="lh-icon">&#128172;</span>
              <h3>Zalo OA (Nhanh nhất)</h3>
              <a href="https://zalo.me/1678310120468101523" class="lh-phone" target="_blank" rel="noopener">Nhắn Zalo: 0916 961 409</a>
              <p>Kênh tư vấn nhanh nhất — phản hồi trong 15-30 phút. Phụ huynh có thể gửi câu hỏi, nhận brochure, đặt lịch tham quan trực tiếp qua Zalo.</p>
            </div>
            <div class="lh-contact-card">
              <span class="lh-icon">&#9742;</span>
              <h3>Hotline Mầm Non</h3>
              <a href="tel:0774588988" class="lh-phone">0774 588 988</a>
              <p>Đường dây riêng dành cho phụ huynh quan tâm bậc Mầm non (12 tháng - 6 tuổi). Tư vấn chương trình, lịch tham quan và học phí mầm non.</p>
            </div>
            <div class="lh-contact-card">
              <span class="lh-icon">&#9993;</span>
              <h3>Email</h3>
              <a href="mailto:info@truongvietanh.com" class="lh-phone lh-email-link">info@truongvietanh.com</a>
              <p>Gửi email cho các yêu cầu chi tiết, hồ sơ nhập học hoặc câu hỏi về chương trình. Phản hồi trong vòng 24 giờ làm việc.</p>
            </div>
            <div class="lh-contact-card">
              <span class="lh-icon">&#127760;</span>
              <h3>Facebook Page</h3>
              <a href="https://www.facebook.com/truongvietanh" class="lh-phone lh-social-link" target="_blank" rel="noopener">fb.com/truongvietanh</a>
              <p>Theo dõi Facebook để cập nhật tin tức, hình ảnh hoạt động hàng tuần, và nhắn tin Messenger để nhận tư vấn nhanh.</p>
            </div>
            <div class="lh-contact-card">
              <span class="lh-icon">&#128241;</span>
              <h3>Messenger</h3>
              <a href="https://m.me/truongvietanh" class="lh-phone lh-social-link" target="_blank" rel="noopener">m.me/truongvietanh</a>
              <p>Nhắn tin trực tiếp qua Facebook Messenger. Phù hợp cho phụ huynh thường dùng Facebook, phản hồi trong giờ làm việc.</p>
            </div>
          </div>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>15-30 phút</strong>
              <span>Phản hồi qua Zalo</span>
            </div>
            <div class="gi-evidence-item">
              <strong>24 giờ</strong>
              <span>Phản hồi qua Email</span>
            </div>
            <div class="gi-evidence-item">
              <strong>100%</strong>
              <span>Tư vấn cá nhân hóa Lộ trình học tập</span>
            </div>
            <div class="gi-evidence-item">
              <strong>6 kênh</strong>
              <span>Liên hệ đa dạng</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Địa chỉ các cơ sở -->
        <section id="dia-chi" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>Địa chỉ các cơ sở Trường Việt Anh</h2>
          <p>Hệ thống Trường Việt Anh hiện có <strong>6 cơ sở</strong> trải rộng tại 3 tỉnh thành: TP. Hồ Chí Minh (3 cơ sở), Tây Ninh (2 cơ sở) và An Giang (1 cơ sở) — tổng cộng 8 trường, trong đó Mầm Non và Tiểu Học Thái Sơn dùng chung một khuôn viên, Mầm Non và Tiểu Học Mekong Xanh cũng vậy. Mỗi cơ sở đều có hotline riêng và sẵn sàng đón phụ huynh tham quan. Bấm vào địa chỉ để mở Google Maps chỉ đường.</p>

          <img src="https://media.truongvietanh.com/images/the-thao-08.webp" alt="Khuôn viên Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-campus-groups">
            <div class="gi-campus-group">
              <h3>TP. Hồ Chí Minh (3 cơ sở)</h3>
              <ul>
                <li>
                  <strong>Cơ sở Gò Vấp (Liên cấp TH-THCS-THPT):</strong>
                  <a href="https://maps.google.com/?q=160/72+Phan+Huy+Ích,+Gò+Vấp,+TP.HCM" target="_blank" rel="noopener">160/72 Phan Huy Ích, P.12, Q. Gò Vấp, TP.HCM</a>
                  — Cơ sở liên cấp chính, phù hợp gia đình có nhiều con ở các cấp khác nhau. Hotline: <a href="tel:0916961409">0916 961 409</a>
                </li>
                <li>
                  <strong>Mầm non Việt Anh Gò Vấp:</strong>
                  <a href="https://maps.google.com/?q=573+Lê+Đức+Thọ,+Gò+Vấp,+TP.HCM" target="_blank" rel="noopener">573 Lê Đức Thọ, P.16, Q. Gò Vấp, TP.HCM</a>
                  — Chuyên mầm non, sân chơi rộng, bể bơi và phòng nghệ thuật riêng. Hotline: <a href="tel:0774588988">0774 588 988</a>
                </li>
                <li>
                  <strong>Cơ sở Bình Tân (Liên cấp TH-THCS-THPT):</strong>
                  <a href="https://maps.google.com/?q=Số+7+đường+38A,+Bình+Tân,+TP.HCM" target="_blank" rel="noopener">Số 7, Đường 38A, Q. Bình Tân, TP.HCM</a>
                  — Khuôn viên rộng rãi, phù hợp cho phụ huynh khu vực phía Tây TP.HCM. Hotline: <a href="tel:0916961409">0916 961 409</a>
                </li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>Tây Ninh (2 cơ sở · 3 trường)</h3>
              <ul>
                <li>
                  <strong>Mầm Non Nhân Lễ:</strong> 22 Đường D2, KDC Long Hậu, Ấp Long Hậu 3, Xã Cần Giuộc, Tây Ninh
                  — Cơ sở chuyên mầm non. Hotline: <a href="tel:0774588988">0774 588 988</a>
                </li>
                <li>
                  <strong>Mầm Non Thái Sơn:</strong> Khu dân cư T&amp;T Cần Giuộc, Tây Ninh
                  — Mầm non với khuôn viên xanh mát, không gian thoáng đãng cho trẻ vận động. Hotline: <a href="tel:0774588988">0774 588 988</a>
                </li>
                <li>
                  <strong>Tiểu Học Thái Sơn:</strong> Khu dân cư T&amp;T Cần Giuộc, Tây Ninh
                  — Cơ sở tiểu học song ngữ, tiếp nối chương trình mầm non tại Tây Ninh. Hotline: <a href="tel:0916961409">0916 961 409</a>
                </li>
              </ul>
            </div>
            <div class="gi-campus-group">
              <h3>An Giang (1 cơ sở · 2 trường)</h3>
              <ul>
                <li>
                  <strong>Mầm Non Mekong Xanh:</strong> TP. Rạch Giá, Tỉnh An Giang
                  — Cơ sở mầm non, môi trường xanh, thoáng mát. Hotline: <a href="tel:0774588988">0774 588 988</a>
                </li>
                <li>
                  <strong>Tiểu Học Mekong Xanh:</strong> TP. Rạch Giá, Tỉnh An Giang
                  — Cơ sở tiểu học song ngữ, chương trình UK Curriculum. Hotline: <a href="tel:0916961409">0916 961 409</a>
                </li>
              </ul>
            </div>
          </div>

          <p>Tất cả cơ sở đều hỗ trợ <strong>xe đưa rước</strong> cho học sinh. Tại TP.HCM, hệ thống xe phủ khắp các quận: Gò Vấp, Phú Nhuận, Bình Thạnh, Tân Bình, Tân Phú, Quận 12, Bình Tân. Phụ huynh có thể liên hệ hotline để hỏi tuyến xe qua khu vực mình sinh sống. <a href="/co-so">Xem chi tiết từng cơ sở &rarr;</a></p>

          <img src="https://media.truongvietanh.com/images/phu-huynh-04.webp" alt="Phụ huynh trao đổi với tư vấn viên Trường Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />

          <!-- MAP — Google Maps embed, cơ sở Gò Vấp -->
          <div class="lh-map-wrap">
            <h3 class="lh-map-title">📍 Bản đồ cơ sở Gò Vấp (trụ sở chính)</h3>
            <p class="lh-map-desc">160/72 Phan Huy Ích, P.12, Q. Gò Vấp, TP. Hồ Chí Minh · Hotline <a href="tel:0916961409">0916 961 409</a></p>
            <div class="lh-map-iframe">
              <iframe
                src="https://maps.google.com/maps?q=160%2F72+Phan+Huy+%C3%8Dch%2C+P.12%2C+Q.+G%C3%B2+V%E1%BA%A5p%2C+TP.HCM&t=m&z=16&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="420"
                style="border:0;border-radius:12px;display:block;width:100%;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                title="Bản đồ Trường Việt Anh — Cơ sở Gò Vấp"
              ></iframe>
            </div>
            <p class="lh-map-cta">
              <a href="https://maps.google.com/?q=160/72+Phan+Huy+%C3%8Dch%2C+P.12%2C+Q.+G%C3%B2+V%E1%BA%A5p%2C+TP.HCM" target="_blank" rel="noopener" class="lh-map-link">🧭 Mở Google Maps &rarr;</a>
              <a href="/co-so" class="lh-map-link lh-map-link--ghost">Xem bản đồ 6 cơ sở &rarr;</a>
            </p>
          </div>
        </section>

        <!-- Section 3: Giờ làm việc -->
        <section id="gio-lam-viec" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>Giờ làm việc của Trường Việt Anh</h2>
          <p>Đội ngũ tư vấn tuyển sinh làm việc từ thứ Hai đến thứ Bảy. Phụ huynh có thể gọi điện, nhắn Zalo hoặc đến trực tiếp cơ sở để được hỗ trợ trong các khung giờ sau:</p>

          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Ngày</th>
                  <th>Giờ làm việc</th>
                  <th>Ghi chú</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Thứ 2 - Thứ 7</strong></td>
                  <td>7:00 - 19:00</td>
                  <td>Toàn bộ kênh liên hệ hoạt động. Zalo phản hồi 15-30 phút. Nhận tham quan trường trong khung giờ này.</td>
                </tr>
                <tr>
                  <td><strong>Chủ Nhật</strong></td>
                  <td>Ngoài giờ làm việc</td>
                  <td><strong>Vẫn tham quan được nếu hẹn trước</strong> qua Hotline hoặc Zalo OA. Không hẹn trước thì nhắn Zalo / điền form, trường phản hồi sáng thứ 2.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>Phụ huynh muốn <strong>tham quan trường</strong> nên đặt lịch trước qua Zalo hoặc Hotline. Trường đón khách <strong>Thứ 2 – Thứ 7, 07:00 – 19:00</strong>; Chủ Nhật ngoài giờ làm việc nhưng vẫn sắp xếp được nếu hẹn trước. Nên chọn khung giờ học (8:00-16:00 ngày thường) để quan sát trực tiếp môi trường học tập và hoạt động của học sinh. Mỗi buổi tham quan kéo dài khoảng 45-60 phút, hoàn toàn miễn phí và không ràng buộc.</p>

          <p>Đối với phụ huynh ở xa không tiện đến trường, Trường Việt Anh hỗ trợ <strong>tư vấn online</strong> qua Zalo Video Call hoặc Google Meet. Đội ngũ tư vấn sẽ giới thiệu chi tiết chương trình, chia sẻ hình ảnh và video cơ sở, đồng thời giải đáp mọi thắc mắc trực tiếp.</p>
        </section>

        <!-- Section 4: FAQ -->
        <section id="faq" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>Câu hỏi thường gặp khi liên hệ Trường Việt Anh</h2>
          <p>Những câu hỏi phụ huynh thường đặt ra khi muốn tìm hiểu và liên hệ với Trường Việt Anh.</p>

          <img src="https://media.truongvietanh.com/images/giao-vien-30.webp" alt="Đội ngũ tư vấn tuyển sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />

          <div class="gi-faq-list">
            {cmsFaqs ? (
              cmsFaqs.map((faq, i) => (
                <details class="gi-faq-item" open={i === 0}>
                  <summary>{faq.question}</summary>
                  <div class="gi-faq-answer">
                    <p set:html={faq.answer} />
                  </div>
                </details>
              ))
            ) : (
              <>
            
            <details class="gi-faq-item" open>
              <summary>Liên hệ Trường Việt Anh qua kênh nào nhanh nhất?</summary>
              <div class="gi-faq-answer">
                <p>Kênh nhanh nhất là <strong>Zalo OA</strong> (nhắn tin đến số 0916 961 409 trên Zalo). Đội ngũ tư vấn phản hồi qua Zalo trong vòng <strong>15-30 phút</strong> trong giờ làm việc. Ngoài Zalo, phụ huynh có thể gọi trực tiếp Hotline 0916 961 409 để được tư vấn ngay lập tức.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Tham quan trường có cần đặt lịch trước không?</summary>
              <div class="gi-faq-answer">
                <p><strong>Có.</strong> Phụ huynh nên đặt lịch trước qua Hotline, Zalo hoặc điền form trên website để được sắp xếp lịch tham quan phù hợp. Buổi tham quan diễn ra trong giờ học (8:00-16:00) để phụ huynh quan sát trực tiếp hoạt động dạy và học. Mỗi buổi kéo dài 45-60 phút, bao gồm tham quan cơ sở vật chất, giới thiệu chương trình và gặp gỡ giáo viên.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Tư vấn tuyển sinh có miễn phí không?</summary>
              <div class="gi-faq-answer">
                <p><strong>Hoàn toàn miễn phí.</strong> Đội ngũ tư vấn sẽ hỗ trợ phụ huynh tìm hiểu chương trình học, lộ trình phù hợp với độ tuổi của con, học phí chi tiết, chính sách học bổng và xe đưa rước. Tất cả quá trình tư vấn đều không phát sinh chi phí, không ràng buộc cam kết nhập học.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Ngoài giờ làm việc, liên hệ bằng cách nào?</summary>
              <div class="gi-faq-answer">
                <p>Trường đón khách <strong>Thứ 2 – Thứ 7, 07:00 – 19:00</strong>. Ngoài khung giờ đó và vào <strong>Chủ Nhật</strong>, phụ huynh có thể <strong>nhắn tin qua Zalo OA</strong> hoặc <strong>điền form trên website</strong>; đội ngũ tư vấn sẽ phản hồi vào đầu ngày làm việc tiếp theo. Riêng <strong>tham quan trường vào Chủ Nhật vẫn sắp xếp được nếu hẹn trước</strong> qua Hotline hoặc Zalo OA. Đối với trường hợp khẩn cấp liên quan đến học sinh đang học tại trường, phụ huynh liên hệ trực tiếp giáo viên chủ nhiệm qua số điện thoại đã cung cấp.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Trường Việt Anh có tư vấn online không?</summary>
              <div class="gi-faq-answer">
                <p><strong>Có.</strong> Phụ huynh ở xa (các tỉnh khác TP.HCM, Tây Ninh, An Giang) hoặc không tiện đến trường có thể đặt lịch tư vấn online qua <strong>Zalo Video Call</strong> hoặc <strong>Google Meet</strong>. Đội ngũ tư vấn sẽ giới thiệu chi tiết chương trình, chia sẻ hình ảnh thực tế cơ sở, và giải đáp trực tiếp mọi câu hỏi — giống hệt như buổi tư vấn trực tiếp tại trường.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Phụ huynh ở tỉnh có thể cho con học tại Trường Việt Anh không?</summary>
              <div class="gi-faq-answer">
                <p><strong>Hoàn toàn được.</strong> Trường Việt Anh có hệ thống nội trú/bán trú phục vụ học sinh từ các tỉnh. Ngoài ra, trường có cơ sở tại Tây Ninh và An Giang, phụ huynh có thể chọn cơ sở gần nhất. Liên hệ tư vấn viên để được hướng dẫn cụ thể về phương thức lưu trú và đưa đón.</p>
              </div>
            </details>
            <details class="gi-faq-item">
              <summary>Trường Việt Anh có hỗ trợ hồ sơ chuyển trường không?</summary>
              <div class="gi-faq-answer">
                <p><strong>Có.</strong> Phòng Tuyển sinh hỗ trợ phụ huynh toàn bộ thủ tục chuyển trường: (1) Tư vấn hồ sơ cần chuẩn bị, (2) Kiểm tra đầu vào để xếp lớp phù hợp, (3) Hỗ trợ liên hệ trường cũ để lấy học bạ. Toàn bộ quy trình mất 5-7 ngày làm việc. Phụ huynh gọi <a href="tel:0916961409"><strong>0916 961 409</strong></a> để bắt đầu.</p>
              </div>
            </details>
              </>
            )}
          </div>
        </section>
      </article>
    </div>

    <!-- ====== BOTTOM CTA ====== -->
    <section class="gi-bottom-cta">
      <div class="gi-container gi-bottom-cta-inner">
        <div class="gi-bottom-cta-text">
          <h2>Nhận tư vấn cá nhân hóa lộ trình học tập từ Trường Việt Anh</h2>
          <p>Điền form bên cạnh — đội ngũ tư vấn sẽ liên hệ phụ huynh trong 24 giờ qua Zalo hoặc điện thoại. Không ràng buộc, không áp lực.</p>
