---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Tiểu Học Việt Anh",
    "url": "https://truongvietanh.com/tieu-hoc",
    "description": "Tiểu học Việt Anh – nơi trẻ bắt đầu làm chủ việc học và bản thân.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Có cần cho con học nhiều ở tiểu học không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Quan trọng là học đúng cách và hình thành thói quen tự học." } },
      { "@type": "Question", "name": "Nếu không học thêm nhiều, con có bị tụt lại không?", "acceptedAnswer": { "@type": "Answer", "text": "Không. Trẻ biết cách học sẽ tiến nhanh hơn mà không cần học thêm." } },
      { "@type": "Question", "name": "Làm sao để con tự giác hơn?", "acceptedAnswer": { "@type": "Answer", "text": "Cần môi trường rèn thói quen liên tục, không chỉ nhắc nhở từng ngày." } },
      { "@type": "Question", "name": "Trường khác gì so với các trường khác?", "acceptedAnswer": { "@type": "Answer", "text": "Tập trung vào cách học, không chỉ nội dung học — giúp trẻ tự học bền vững." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Tiểu học", "item": "https://truongvietanh.com/tieu-hoc" }
    ]
  }
];
---

<BaseLayout
  title="Tiểu Học Việt Anh – Làm Chủ Việc Học, Tiếng Anh & Bản Thân"
  description="Tiểu học Việt Anh: giúp trẻ biết cách học, tự giác và làm chủ bản thân từ lớp 1. Chương trình Oxford, tiếng Anh như ngôn ngữ, Leader in Me."
  canonical="https://truongvietanh.com/tieu-hoc"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  noPopup={true}
  structuredData={structuredData}
>
  <div class="pp-page">
    <HeaderBase />

    <!-- BLOCK 1: HERO -->
    <section class="pp-hero">
      <div class="pp-hero-inner">
        <h1 class="pp-h1">
          Tiểu học không phải là nơi để học nhiều hơn
          <span class="pp-h1-accent">mà là nơi trẻ bắt đầu biết cách học và làm chủ bản thân</span>
        </h1>
        <p class="pp-subtitle">
          Điểm số có thể giúp trẻ đi nhanh trong ngắn hạn. Nhưng khả năng tự học, tư duy và kỷ luật bản thân mới là thứ quyết định con đi được bao xa.
        </p>
        <div class="pp-cta-row">
          <a href="#pp-form" class="pp-btn pp-btn-gold">Nhận brochure →</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="pp-btn pp-btn-outline">Chat ngay →</a>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: RICH TEXT -->
    <section class="pp-richtext">
      <div class="pp-richtext-inner">
        <h2>Vấn đề không phải là trẻ học kém<br/>mà là không biết cách học</h2>
        <p>Rất nhiều học sinh tiểu học: làm bài tốt khi có người kèm, nhưng không thể tự học — học xong nhưng không hiểu sâu.</p>
        <div class="pp-callout">Điều này không phải do trẻ "kém" — mà do chưa được dạy cách học, chưa hình thành thói quen, chưa có môi trường đúng</div>
        <p>Trong khi đó, giai đoạn Tiểu học chính là lúc: <strong>hình thành tư duy, xây dựng thói quen, tạo nền tảng học tập</strong>.</p>
        <div class="pp-callout">Giáo dục tiểu học đúng phải giúp trẻ: biết cách học, biết tự học, và muốn học</div>
      </div>
    </section>

    <!-- BLOCK 3: STATS -->
    <section class="pp-stats">
      <div class="pp-stats-inner">
        <h2>Những gì trẻ hình thành ở tiểu học sẽ theo suốt cả hành trình</h2>
        <div class="pp-stats-cols">
          <div class="pp-stats-col">
            <h3>Nếu chỉ tập trung vào điểm số…</h3>
            <ul>
              <li>Học nhanh nhưng không bền</li>
              <li>Dễ chán học theo thời gian</li>
              <li>Càng lớn càng phụ thuộc</li>
            </ul>
          </div>
          <div class="pp-stats-col">
            <h3>Nếu tập trung đúng vào cách học…</h3>
            <ul>
              <li>Tự học tốt hơn</li>
              <li>Hiểu sâu và nhớ lâu hơn</li>
              <li>Tiến bộ nhanh hơn theo thời gian</li>
            </ul>
          </div>
        </div>
        <p style="text-align:center;margin-top:1.5rem;color:#64748b;font-size:1rem;">Thói quen học tập hình thành từ tiểu học · Giai đoạn vàng phát triển ngôn ngữ & tư duy logic · Nền tảng theo suốt hành trình học tập</p>
      </div>
    </section>

    <!-- BLOCK 4: FEATURES -->
    <section class="pp-features">
      <div class="pp-features-inner">
        <h2>Môi trường giúp trẻ biết cách học</h2>
        <div class="pp-feat-grid">
          <div class="pp-feat-card">
            <span class="pp-icon">📘</span>
            <strong>Chương trình Bộ Giáo dục, bổ trợ học liệu Oxford</strong>
            <p>Giúp trẻ hiểu sâu, không học vẹt</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🌍</span>
            <strong>Tiếng Anh như ngôn ngữ</strong>
            <p>Không học để thi, mà để sử dụng thực tế</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧠</span>
            <strong>Tư duy & giải quyết vấn đề</strong>
            <p>Phát triển logic, không chỉ làm bài theo mẫu</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🎯</span>
            <strong>PDR – tự học & tự quản lý</strong>
            <p>Trẻ học cách đặt mục tiêu và theo dõi tiến bộ</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🧭</span>
            <strong>Lãnh đạo bản thân</strong>
            <p>Hình thành kỷ luật và trách nhiệm từ sớm</p>
          </div>
          <div class="pp-feat-card">
            <span class="pp-icon">🤝</span>
            <strong>Học qua trải nghiệm</strong>
            <p>Không chỉ học kiến thức, mà học cách áp dụng</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 5: TEXT WITH IMAGE -->
    <section class="pp-textimg">
      <div class="pp-textimg-inner">
        <div class="pp-textimg-text">
          <h2>Trẻ không cần bị ép học<br/>Trẻ cần biết cách học</h2>
          <p>Tại Việt Anh: Trẻ không chỉ làm bài, không chỉ nghe giảng.</p>
          <p>Mà được: <strong>đặt câu hỏi, được thử nghiệm, được sai và sửa</strong>.</p>
          <div class="pp-callout">Giáo viên không chỉ dạy — mà giúp trẻ hiểu cách học, tự tìm ra câu trả lời và phát triển tư duy</div>
          <p>Đây là cách trẻ học chủ động, học lâu dài, và không sợ học.</p>
        </div>
        <div class="pp-textimg-img">
          <img src="https://media.truongvietanh.com/images/du-an-03.webp" alt="Học sinh tiểu học Việt Anh" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </section>

    <!-- BLOCK 6: VALUE CARDS -->
    <section class="pp-valuecards">
      <div class="pp-valuecards-inner">
        <h2>Những giá trị trẻ nhận được</h2>
        <div class="pp-value-grid">
          <div class="pp-value-card">
            <span class="pp-icon">🧠</span>
            <strong>Biết cách học</strong>
            <p>Không cần phụ thuộc vào người lớn để hoàn thành bài</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🎯</span>
            <strong>Tự giác hơn</strong>
            <p>Biết làm việc của mình đúng lúc, đúng cách</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">💬</span>
            <strong>Giao tiếp tốt hơn</strong>
            <p>Biết trình bày ý kiến và lắng nghe người khác</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🌍</span>
            <strong>Dùng được tiếng Anh</strong>
            <p>Không chỉ học, mà thực sự sử dụng tiếng Anh</p>
          </div>
          <div class="pp-value-card">
            <span class="pp-icon">🚀</span>
            <strong>Nền tảng lâu dài</strong>
            <p>Sẵn sàng và tự tin cho các cấp học tiếp theo</p>
          </div>
        </div>
      </div>
    </section>

    <!-- BLOCK 7: FAQ -->
    <section class="pp-faq">
      <div class="pp-faq-inner">
        <h2>Câu hỏi phụ huynh thường gặp</h2>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Có cần cho con học nhiều ở tiểu học không?</p>
          <p class="pp-faq-a">Không. Học nhiều không bằng học đúng cách. Quan trọng là hình thành thói quen tự học và tư duy — những thứ giúp con tiến bộ bền vững.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Nếu không học thêm nhiều, con có bị tụt lại không?</p>
          <p class="pp-faq-a">Không. Trẻ biết cách học, biết tự học sẽ tiến nhanh hơn — và không cần học thêm liên tục mới theo kịp.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Làm sao để con tự giác hơn?</p>
          <p class="pp-faq-a">Cần môi trường rèn thói quen liên tục — hệ thống PDR, kỷ luật bản thân và trách nhiệm cá nhân — không phải chỉ nhắc nhở mỗi ngày.</p>
        </div>
        <div class="pp-faq-item">
          <p class="pp-faq-q">Trường khác gì so với các trường khác?</p>
          <p class="pp-faq-a">Chúng tôi tập trung vào cách học, không chỉ nội dung học. Học sinh được rèn tư duy, tự học và lãnh đạo bản thân — để học tốt ở mọi cấp, không chỉ tiểu học.</p>
        </div>
      </div>
    </section>

    <!-- BLOCK 8: FORM -->
    <section class="pp-form-block" id="pp-form">
      <div class="pp-form-block-inner">
        <h2>Nhận "Bản đồ phát triển" riêng cho con</h2>
        <p>Làm bài trắc nghiệm 2 phút — Việt Anh dựng bản đồ 4 trục (Kiến thức · Kỹ năng · Tiếng Anh · Thể chất) và gợi ý lộ trình học tập phù hợp cho con.</p>
        <ul>
          <li>8 câu hỏi ngắn theo đúng lớp của con</li>
          <li>Kết quả 4 trục + 3 việc làm ngay tuần này</li>
          <li>Tư vấn cá nhân hoá 1:1 theo kết quả của con</li>
        </ul>
        <a href="/quiz?src=tieu-hoc-pillar" class="pp-btn pp-btn-gold pp-quiz-cta" style="font-size:1.1rem;padding:1.1rem 2.4rem;margin-top:.25rem">🎯 Làm trắc nghiệm miễn phí — 2 phút →</a>
      </div>
    </section>

    <!-- BLOCK 9: LINKS -->
    <section class="pp-links">
      <div class="pp-links-inner">
        <h2>Khám phá các chương trình liên quan</h2>
        <div class="pp-link-grid">
          <a href="/tuyen-sinh/tieu-hoc" class="pp-link-card">
            <strong>Chương trình Tiểu học Việt Anh</strong>
            <span>Nền tảng học tập & tự học</span>
          </a>
          <a href="/tuyen-sinh/trai-he-tieu-hoc-2026" class="pp-link-card">
            <strong>Lion Camp – Trại hè Tiểu học</strong>
            <span>Rèn kỹ năng sống & tự lập trong 6 tuần</span>
          </a>
          <a href="https://truongvietanh.com/toan-tu-duy" class="pp-link-card">
            <strong>Toán Tư Duy</strong>
            <span>Phát triển tư duy logic & giải quyết vấn đề</span>
          </a>
          <a href="https://truongvietanh.com/sieu-an-gioi" class="pp-link-card">
            <strong>Siêu Ăn Giỏi</strong>
            <span>Hình thành thói quen sống & tự lập</span>
          </a>
          <a href="https://truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/" class="pp-link-card" style="grid-column:1/-1">
            <strong>Thời khoá biểu mẫu các lớp</strong>
            <span>truongvietanh.com/thoi-khoa-bieu-mau-cac-khoi-lop/</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Blog nội bộ: Kiến thức Tiểu Học -->
    <section style="background:#f8f9fc;padding:3rem 0;border-top:1px solid #e5e7eb">
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem">
        <h2 style="font-size:1.4rem;font-weight:800;color:#26275D;margin:0 0 0.5rem">📚 Kiến thức cho học sinh Tiểu Học</h2>
        <p style="color:#5a5a7a;font-size:1rem;margin:0 0 1.5rem">Hướng dẫn chuyển cấp, phương pháp học Toán — Tiếng Anh và kỹ năng phát triển toàn diện cho học sinh lớp 1–5.</p>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem">
          <a href="/blog/danh-muc/chuyen-cap" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.2rem;background:#fff;border:1px solid #e5e7eb;border-radius:50px;text-decoration:none;color:#26275D;font-weight:600;font-size:0.9rem">🎒 Chuyển Cấp</a>
          <a href="/blog/danh-muc/hoc-thuat" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.2rem;background:#fff;border:1px solid #e5e7eb;border-radius:50px;text-decoration:none;color:#26275D;font-weight:600;font-size:0.9rem">📚 Học Thuật</a>
          <a href="/blog/danh-muc/phu-huynh" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.2rem;background:#fff;border:1px solid #e5e7eb;border-radius:50px;text-decoration:none;color:#26275D;font-weight:600;font-size:0.9rem">👨‍👩‍👧 Phụ Huynh &amp; Con</a>
          <a href="/blog/danh-muc/ky-nang-song" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.2rem;background:#fff;border:1px solid #e5e7eb;border-radius:50px;text-decoration:none;color:#26275D;font-weight:600;font-size:0.9rem">⭐ Kỹ Năng Sống</a>
          <a href="/blog" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.6rem 1.2rem;background:#26275D;border:1px solid #26275D;border-radius:50px;text-decoration:none;color:#fff;font-weight:700;font-size:0.9rem">📰 Tất Cả Bài Viết →</a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <style>*, *::before, *::after{ box-sizing: border-box; }.pp-page{ font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; color: #1a1a2e; line-height: 1.6; }.pp-hero{ background: linear-gradient(160deg, rgba(24,25,58,0.65) 0%, rgba(38,39,93,0.55) 50%, rgba(16,16,36,0.70) 100%), url('https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/tieu-hoc-banner-chinh-1.jpg') center/cover no-repeat; color: white; padding: 4rem 1.5rem 3.5rem; text-align: center; }.pp-hero-inner{ max-width: 820px; margin: 0 auto; }.pp-h1{ font-size: 2.4rem; font-weight: 800; line-height: 1.3; margin-bottom: 1.25rem; color: #f9dd0e; }.pp-h1-accent{ color: #ffffff; display: block; margin-top: .5rem; font-size: 1rem; }.pp-subtitle{ font-size: 1.1rem; color: #ffffff; opacity: 1; margin-bottom: 2.5rem; line-height: 1.75; }.pp-hero .pp-hero-inner > p{ color: #ffffff; }.pp-cta-row{ display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }.pp-btn{ display: inline-block; padding: .9rem 2rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 1rem; transition: opacity .2s; }.pp-btn:hover{ opacity: .88; }.pp-btn-gold{ background: #f9dd0e; color: #26275D; }.pp-btn-outline{ background: transparent; color: white; border: 2px solid rgba(255,255,255,.7); }.pp-richtext{ background: #fff; padding: 4.5rem 1.5rem; }.pp-richtext-inner{ max-width: 820px; margin: 0 auto; }.pp-richtext h2{ font-size: 1.5rem; font-weight: 800; color: #26275D; text-transform: uppercase; margin-bottom: 1.5rem; line-height: 1.4; }.pp-richtext p{ font-size: 1.05rem; color: #334155; line-height: 1.8; margin-bottom: 1rem; }.pp-callout{ color: #26275D; font-weight: 700; font-size: 1.05rem; padding: .6rem 1rem; border-left: 3px solid #f9dd0e; margin: 1.25rem 0; background: #fffbeb; border-radius: 0 6px 6px 0; }.pp-stats{ background: #f8fafc; padding: 4rem 1.5rem; border-top: 3px solid #e2e8f0; }.pp-stats-inner{ max-width: 900px; margin: 0 auto; }.pp-stats-inner > h2{ font-size: 1.5r