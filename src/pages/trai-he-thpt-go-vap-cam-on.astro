<script is:inline>
(function(){
  var COUNTDOWN_KEY='camp_countdown_end';
  var stored=sessionStorage.getItem(COUNTDOWN_KEY);
  var endTime=stored?parseInt(stored,10):0;
  if(!endTime||endTime<Date.now()){endTime=Date.now()+4*3600*1000;sessionStorage.setItem(COUNTDOWN_KEY,endTime.toString());}
  var el=document.getElementById('countdown');
  var t=setInterval(function(){var diff=Math.max(0,Math.floor((endTime-Date.now())/1000));var h=Math.floor(diff/3600),m=Math.floor((diff%3600)/60),sc=diff%60;el.textContent=(h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(sc<10?'0':'')+sc;if(diff<=0){clearInterval(t);el.textContent='Đã kết thúc';}},1e3);
  var canvas=document.getElementById('confetti');
  if(canvas){var ctx=canvas.getContext('2d');canvas.width=window.innerWidth;canvas.height=window.innerHeight;var pieces=[];var colors=['#F0D048','#F59E0B','#1a1a5e','#16A34A','#0068FF','#EF4444'];for(var i=0;i<80;i++){pieces.push({x:Math.random()*canvas.width,y:Math.random()*-canvas.height,w:Math.random()*8+4,h:Math.random()*6+2,r:Math.random()*360,c:colors[Math.floor(Math.random()*colors.length)],vx:(Math.random()-.5)*3,vy:Math.random()*3+2,vr:(Math.random()-.5)*8});}var frame=0;function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);pieces.forEach(function(p){ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r*Math.PI/180);ctx.fillStyle=p.c;ctx.globalAlpha=Math.max(0,1-frame/120);ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;p.vy+=0.05;});frame++;if(frame<150)requestAnimationFrame(draw);else{ctx.clearRect(0,0,canvas.width,canvas.height);canvas.style.display='none';}}draw();}
  document.querySelectorAll('.cta-btn').forEach(function(btn){btn.addEventListener('click',function(){if(window.dataLayer)window.dataLayer.push({event:'cta_click',cta_text:btn.textContent.trim().substring(0,50),page:'thank_you',funnel_code:'trai-he-thpt-go-vap-cam-on'});});});
})();
</script>
