---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderBase from '../../components/HeaderBase.astro';
import FooterBase from '../../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import '../../styles/blog-rebrand.css';
import { readItems } from '@directus/sdk';
import { createCmsClient, getDirectusUrl } from '../../lib/directus';
import { CATEGORIES, detectCategory, getCategoryBySlug } from '../../lib/blog-categories';
import noindexSlugs from '../../data/blog-noindex-slugs.json';
import blogRedirects from '../../data/blog-redirects.json';

// Bài văn mẫu (ruột placeholder từ đợt migrate cũ) — noindex chờ viết lại.
// Danh sách sinh bởi audit chữ ký nội dung; xoá slug khỏi file JSON để mở index lại.
const NOINDEX_SLUGS = new Set(noindexSlugs as string[]);

type Post = {
  id: number | string;
  title: string;
  slug: string;
  status: string;
  excerpt?: string | null;
  content?: string | null;
  published_at?: string | null;
  // TODO: Directus chưa mở quyền đọc field `date_updated` cho posts.
  // Kiểm 10/09/2026: KHÔNG chỉ public policy — token trong .env (chính token mà
  // GitHub Actions dùng khi build) cũng bị 403 trên field này. Nên mở mỗi public
  // policy là chưa đủ, phải mở quyền read cho role của token trong Directus admin,
  // rồi thêm 'date_updated' vào fields[] ở getStaticPaths.
  // Hệ quả khi chưa mở: MỌI bài đều hiện "Cập nhật lần cuối" đúng bằng ngày đăng,
  // và dateModified trong JSON-LD cũng sai — bài vừa viết lại vẫn báo là chưa sửa.
  date_updated?: string | null;
  category?: string | null;
  featured_image?: string | null;
};

type DirectusSchema = {
  posts: Post[];
};

export async function getStaticPaths() {
  const client = createCmsClient<DirectusSchema>();
  if (!client) return [];

  // Fetch all published posts — paginate to get all 552+
  let allPosts: Post[] = [];
  let page = 1;
  const perPage = 100;
  let hasMore = true;

  while (hasMore) {
    const batch = await client.request(
      readItems('posts', {
        fields: ['id', 'title', 'slug', 'status', 'excerpt', 'content', 'published_at', 'category', 'featured_image'],
        filter: { status: { _eq: 'published' } },
        sort: ['-published_at', '-id'],
        limit: perPage,
        offset: (page - 1) * perPage,
      }),
    );
    allPosts = [...allPosts, ...batch];
    hasMore = batch.length === perPage;
    page++;
  }

  // Filter out posts with slugs that contain characters invalid for file paths
  // (e.g. a URL accidentally saved as slug: "https:--truongvietanh.com")
  // + slug đã 301 sang bài chính (khai báo trong astro.config) — không render nữa
  const validPosts = allPosts.filter(
    (post) => post.slug && !/[:\*\?"<>|]/.test(post.slug) && !(post.slug in blogRedirects),
  );

  return validPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: validPosts },
  }));
}

const { post, allPosts } = Astro.props as { post: Post; allPosts: Post[] };

// Smart related posts — match by title keywords instead of random
const otherPosts = allPosts.filter((p: Post) => p.slug !== post.slug);
const titleWords = post.title.toLowerCase().split(/[\s,–—:]+/).filter(w => w.length > 3);
const scored = otherPosts.map(p => {
  const pTitle = p.title.toLowerCase();
  const score = titleWords.reduce((s, w) => s + (pTitle.includes(w) ? 1 : 0), 0);
  return { post: p, score };
}).sort((a, b) => b.score - a.score);
const relatedPosts = scored.slice(0, 3).map(s => s.post);

function formatDate(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

function formatISO(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toISOString();
  } catch {
    return '';
  }
}

// Clean CMS content: remove duplicate H1, fix placeholder phone/zalo
function cleanContent(html: string | null | undefined): string {
  if (!html) return '';
  let cleaned = html
    // Remove first H1 (template already has H1)
    .replace(/<h1[^>]*>[\s\S]*?<\/h1>\s*/i, '')
    // Remove CMS "Bước Tiếp Theo" section (template already has this)
    .replace(/<h2[^>]*>\s*Bước Tiếp Theo\s*<\/h2>[\s\S]*?(?=<h2|$)/i, '')
    // Fix placeholder phone numbers
    .replace(/0909\.xxx\.xxx/g, '0916 961 409')
    .replace(/0909\.?xxx\.?xxx/g, '0916 961 409')
    .replace(/href="tel:0909[^"]*"/g, 'href="tel:0916961409"')
    // Fix wrong Zalo links
    .replace(/zalo\.me\/truongvietanh/g, 'zalo.me/1678310120468101523')
    .replace(/zalo\.me\/0916961409/g, 'zalo.me/1678310120468101523')
    // Fix typo years
    .replace(/\b20011\b/g, '2011')
    // Fix old address
    .replace(/269A\s*Nguyễn\s*Trọng\s*Tuyển[^<,\n"]{0,120}(Hồ\s*Chí\s*Minh|HCM|TPHCM)/gi, '160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh')
    .replace(/269A\s*Nguyễn\s*Trọng\s*Tuyển[^<"\n]{0,80}/gi, '160/72 Phan Huy Ích, phường An Hội Tây, Thành phố Hồ Chí Minh')
    // Convert markdown-style tables to HTML tables
    .replace(/(<p>)?\|([^\n]+)\|\s*\n\s*\|[-\s|]+\|\s*\n((?:\s*\|[^\n]+\|\s*\n?)+)(<\/p>)?/g, (_match, _p1, headerRow, bodyRows) => {
      const headers = headerRow.split('|').map((h: string) => h.trim()).filter(Boolean);
      const rows = bodyRows.trim().split('\n').map((row: string) =>
        row.split('|').map((c: string) => c.trim()).filter(Boolean)
      );
      let html = '<div class="blog-table-wrap"><table><thead><tr>';
      headers.forEach((h: string) => { html += `<th>${h}</th>`; });
      html += '</tr></thead><tbody>';
      rows.forEach((cols: string[]) => {
        html += '<tr>';
        cols.forEach((c: string) => { html += `<td>${c}</td>`; });
        html += '</tr>';
      });
      html += '</tbody></table></div>';
      return html;
    });
  return cleaned;
}


// Gắn id cho H2/H3 ngay trong HTML tĩnh + rút mục lục.
// Trước đây mục lục do JS sinh ở client → crawler AI (GPTBot/ClaudeBot/PerplexityBot)
// không chạy JS nên không thấy anchor, không trích được đúng đoạn. Nay làm ở build.
function slugifyVi(text: string): string {
  return text
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd')
    .replace(/Đ/g, 'D')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .slice(0, 80);
}

function withHeadingAnchors(html: string): { html: string; headings: { level: number; id: string; text: string }[] } {
  const headings: { level: number; id: string; text: string }[] = [];
  const used = new Set<string>();
  const out = html.replace(
    /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/gi,
    (match, lvl: string, attrs: string, inner: string) => {
      const text = inner.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
      if (!text) return match;
      const existing = /\sid\s*=\s*["']([^"']+)["']/i.exec(attrs);
      let id = existing ? existing[1] : slugifyVi(text) || `muc-${headings.length + 1}`;
      let n = 2;
      while (used.has(id)) id = `${slugifyVi(text) || 'muc'}-${n++}`;
      used.add(id);
      headings.push({ level: Number(lvl), id, text });
      const cleanAttrs = attrs.replace(/\sid\s*=\s*["'][^"']*["']/i, '');
      return `<h${lvl} id="${id}"${cleanAttrs}>${inner}</h${lvl}>`;
    },
  );
  return { html: out, headings };
}

const { html: cleanedContent, headings: tocHeadings } = withHeadingAnchors(cleanContent(post.content));
const showToc = tocHeadings.filter((h) => h.level === 2).length >= 3;
const pageTitle = post.title.length > 55 ? post.title : `${post.title} | Trường Việt Anh`;
const pageDesc = post.excerpt || `${post.title} — Tìm hiểu chi tiết tại blog Trường Việt Anh.`;
const canonicalUrl = `https://truongvietanh.com/blog/${post.slug}`;

// Category: prefer CMS field, fallback to keyword detection
const categorySlug = post.category || detectCategory(post.title, post.excerpt ?? undefined);
const categoryInfo = getCategoryBySlug(categorySlug);
// Featured image: prefer CMS file, fallback to default
const DIRECTUS_URL = getDirectusUrl() || '';
const featuredIsExternal = !!post.featured_image && /^https?:\/\//i.test(post.featured_image);
function featuredSrc(transform: string): string | null {
  if (!post.featured_image) return null;
  if (featuredIsExternal) return post.featured_image;
  if (!DIRECTUS_URL) return null;
  return `${DIRECTUS_URL}/assets/${post.featured_image}?${transform}`;
}
const ogImage = featuredSrc('width=1200&height=630&fit=cover&format=webp')
  || 'https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp';

// Skip the template hero if the article body already shows an image near the top
// (avoids duplicate banner when CMS post embeds its own hero in content).
// Strategy: if any <img> appears within the first ~1500 chars of the body, OR if
// the featured image URL itself is referenced in the body, the body owns the hero.
const contentHead = cleanedContent.slice(0, 1500);
const hasEarlyImage = /<img\b/i.test(contentHead);
const featuredInBody = !!post.featured_image && featuredIsExternal && cleanedContent.includes(post.featured_image);
const showHero = !!post.featured_image && !hasEarlyImage && !featuredInBody;

// FAQ schema theo đúng nội dung bài.
// Bài nào có mục "Câu hỏi thường gặp" (h2) với các cặp h3 hỏi + đáp thì phát FAQPage
// bằng chính các câu đó; bài không có thì giữ nguyên khối FAQ chung như trước.
// Chỉ lấy phần nằm giữa h2 FAQ và h2 kế tiếp — không quét lẫn h3 của mục khác.
// Google chỉ dùng 1 FAQPage mỗi trang, nên hai nguồn này loại trừ nhau, không phát cả hai.
function stripTags(html: string): string {
  return html
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractPostFaq(html: string): { q: string; a: string }[] {
  if (!html) return [];
  const heading = /<h2[^>]*>[^<]*câu hỏi thường gặp[^<]*<\/h2>/i.exec(html);
  if (!heading) return [];
  const after = html.slice(heading.index + heading[0].length);
  const nextH2 = after.search(/<h2[\s>]/i);
  const scope = nextH2 === -1 ? after : after.slice(0, nextH2);
  const pairs: { q: string; a: string }[] = [];
  const re = /<h3[^>]*>([\s\S]*?)<\/h3>([\s\S]*?)(?=<h3[\s>]|$)/gi;
  let m: RegExpExecArray | null;
  while ((m = re.exec(scope)) !== null) {
    // bỏ số thứ tự "1." / "2)" nếu tác giả đánh số câu hỏi trong bài
    const q = stripTags(m[1]).replace(/^\d+\s*[.)]\s*/, '');
    const a = stripTags(m[2]);
    // bỏ cặp rỗng hoặc câu trả lời cụt — schema thiếu nội dung còn hại hơn không có
    if (q.length > 5 && a.length > 20) pairs.push({ q, a: a.slice(0, 1200) });
  }
  return pairs.length >= 2 ? pairs : [];
}

const postFaq = extractPostFaq(cleanedContent);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: pageDesc,
    datePublished: formatISO(post.published_at),
    dateModified: formatISO(post.date_updated || post.published_at),
    url: canonicalUrl,
    inLanguage: 'vi',
    wordCount: cleanedContent ? cleanedContent.replace(/<[^>]*>/g, '').split(/\s+/).length : 0,
    author: {
      '@type': 'Person',
      '@id': 'https://nguyenmanhduong.com/#person',
      name: 'Nguyễn Mạnh Dương',
      url: 'https://nguyenmanhduong.com',
      jobTitle: 'Nhà sáng lập & Chủ tịch Hệ thống Giáo dục K-12 Việt Anh',
      worksFor: { '@type': 'EducationalOrganization', name: 'Trường Việt Anh', url: 'https://truongvietanh.com' },
      sameAs: [
        'https://nguyenmanhduong.com',
        'https://www.facebook.com/nguyenmanhduong1101/',
        'https://www.youtube.com/@nguyenmanhduong1101',
        'https://www.linkedin.com/in/nguyenmanhduong',
      ],
    },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://truongvietanh.com/#organization',
      name: 'Trường Việt Anh',
      url: 'https://truongvietanh.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://truongvietanh.com/logo-crest-80.webp',
      },
    },
    ...(ogImage ? { image: { '@type': 'ImageObject', url: ogImage } } : {}),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.blog-article h1', '.blog-article > p:first-of-type'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://truongvietanh.com/blog' },
      { '@type': 'ListItem', position: 3, name: categoryInfo.label, item: `https://truongvietanh.com/blog/danh-muc/${categorySlug}` },
      { '@type': 'ListItem', position: 4, name: post.title, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: postFaq.length ? postFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })) : [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh dạy chương trình gì?',
        acceptedAnswer: {
          '@type': 'Answer',
          // Giữa "và" và "Computing." bên dưới là ký tự U+00A0 (dấu cách KHÔNG ngắt),
          // không phải dấu cách thường — đừng gõ đè lên. Nó buộc hai từ đi cùng nhau, không
          // thì "Computing." rớt lẻ xuống dòng cuối trên điện thoại. Chuỗi này phải trùng y
          // hệt câu trả lời hiển thị bên dưới (bên đó viết &nbsp;).
          text: 'Trường Việt Anh dạy 100% chương trình Bộ GD&ĐT Việt Nam, bổ trợ bằng học liệu Oxford International cho các môn Toán, Khoa học, ICT và Computing.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học sinh tốt nghiệp đạt IELTS bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Bảo hành đầu ra IELTS 6.0+ ghi trong hợp đồng — không đạt trường kèm miễn phí cho đến khi đạt (theo điều kiện trong hợp đồng). Điều kiện gồm đi học đủ, dự đủ các buổi kèm bổ sung và làm hết bài tập giáo viên giao.',
        },
      },
      {
        '@type': 'Question',
        name: 'Học phí Trường Việt Anh bao nhiêu?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Học phí đã gồm giáo viên bản ngữ, chương trình Oxford và 16 kỹ năng thế kỷ 21 theo WEF.',
        },
      },
      {
        '@type': 'Question',
        name: 'Trường có bao nhiêu cơ sở?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Năm học 2026–2027, Trường Việt Anh có 2 cơ sở chính thức tại TP.HCM, cùng các trường cùng chủ đầu tư và trường do Việt Anh phụ trách vận hành. Cơ sở chính thức (TP.HCM): Cơ sở Gò Vấp (160/72 Phan Huy Ích), Cơ sở Bình Tân. Cùng chủ đầu tư: Mầm non Việt Anh (Gò Vấp); Mầm non Nhân Lễ, Mầm non và Tiểu học Thái Sơn (Cần Giuộc, Tây Ninh). Do Việt Anh phụ trách vận hành: Mầm non và Tiểu học Mekong Xanh (Rạch Giá, An Giang).',
        },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để đăng ký tuyển sinh?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Phụ huynh có thể đăng ký tư vấn trên trang tuyển sinh, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  structuredData={structuredData}
  ogImage={ogImage}
  noindex={NOINDEX_SLUGS.has(post.slug)}
>
  <div class="cf-layout page-wrapper">
    <HeaderBase currentPath={`/blog/${post.slug}`} />

    <!-- Reading Progress Bar -->
    <div class="reading-progress" id="readingProgress" aria-hidden="true">
      <div class="reading-progress__bar" id="readingBar"></div>
    </div>

    <!-- Breadcrumb -->
    <nav class="blog-breadcrumb" aria-label="Breadcrumb">
      <div class="blog-container">
        <ol class="blog-breadcrumb__list">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href={`/blog/danh-muc/${categorySlug}`}>{categoryInfo.icon} {categoryInfo.label}</a></li>
          <li aria-current="page">{post.title}</li>
        </ol>
      </div>
    </nav>

    <!-- Featured Image Hero (HubSpot-style) -->
    {showHero && (
      <div class="blog-hero-img">
        <img
          src={featuredSrc('width=1600&height=720&fit=cover&format=webp&quality=85')!}
          alt={post.title}
          width="1600" height="720" fetchpriority="high" decoding="async"
          srcset={featuredIsExternal ? undefined : `${DIRECTUS_URL}/assets/${post.featured_image}?width=800&height=360&fit=cover&format=webp&quality=80 800w, ${DIRECTUS_URL}/assets/${post.featured_image}?width=1600&height=720&fit=cover&format=webp&quality=85 1600w`}
          sizes="(max-width: 960px) 100vw, 1600px"
        />
      </div>
    )}

    <!-- Article in 2-column layout: main + sticky sidebar -->
    <article class="blog-article blog-article--hubspot">
      <div class="blog-container blog-container--wide">
        <div class="blog-grid">
          <div class="blog-main">
            <header class="blog-article__header">
              <h1 class="blog-article__title">{post.title}</h1>
              <div class="blog-article__meta">
                {post.published_at && (
                  <time class="blog-article__date" datetime={post.published_at}>
                    📅 Đăng: {formatDate(post.published_at)}
                  </time>
                )}
                <span class="blog-article__updated">🔄 Cập nhật lần cuối: {formatDate(post.date_updated || post.published_at)}</span>
                <a href={`/blog/danh-muc/${categorySlug}`} class="blog-article__badge">{categoryInfo.icon} {categoryInfo.label}</a>
                <span class="blog-article__readtime" id="readTime"></span>
              </div>
              <!-- Share buttons -->
              <div class="blog-share">
                <span class="blog-share__label">Chia sẻ:</span>
                <a class="blog-share__btn blog-share__btn--fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                </a>
                <a class="blog-share__btn blog-share__btn--zalo" href={`https://zalo.me/share?url=${encodeURIComponent(canonicalUrl)}`} target="_blank" rel="noopener" aria-label="Chia sẻ qua Zalo">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </a>
                <button class="blog-share__btn blog-share__btn--copy" id="copyLink" aria-label="Sao chép link">
