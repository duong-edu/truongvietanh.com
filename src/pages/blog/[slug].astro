<script>
// @ts-nocheck
  // Reading progress bar
  const bar = document.getElementById('readingBar');
  const article = document.querySelector('.blog-article');
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }, { passive: true });
  }

  // Estimated reading time
  const body = document.querySelector('.blog-article__body');
  const rtEl = document.getElementById('readTime');
  if (body && rtEl) {
    const words = (body.textContent || '').trim().split(/\s+/).length;
    const mins = Math.max(1, Math.ceil(words / 200));
    rtEl.textContent = mins + ' phút đọc';
  }

  // Copy link button
  const copyBtn = document.getElementById('copyLink');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(window.location.href);
      copyBtn.classList.add('blog-share__btn--copied');
      setTimeout(() => copyBtn.classList.remove('blog-share__btn--copied'), 2000);
    });
  }

  // Mục lục + id của heading nay được sinh ở BUILD (xem withHeadingAnchors) nên có sẵn
  // trong HTML tĩnh cho crawler AI. JS chỉ còn lo phần bài cũ chưa có id.
  const tocNav = document.getElementById('blogToc');
  const tocList = document.getElementById('blogTocList');
  const tocSticky = document.getElementById('blogTocSticky');
  const tocStickyList = document.getElementById('blogTocStickyList');
  const articleBody = document.querySelector('.blog-article__body');
  if (articleBody && tocList && tocList.children.length === 0) {
    const headings = articleBody.querySelectorAll('h2, h3');
    if (headings.length >= 3) {
      headings.forEach((h, i) => {
        // Giữ id tác giả đặt trong nội dung CMS — ghi đè sẽ làm hỏng link neo trong bài
        const id = h.id || 'section-' + i;
        h.id = id;
        [tocList, tocStickyList].forEach(list => {
          if (!list) return;
          const li = document.createElement('li');
          li.className = h.tagName === 'H3' ? 'blog-toc__sub' : '';
          const a = document.createElement('a');
          a.href = '#' + id;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
      });
      if (tocNav) tocNav.style.display = '';
      if (tocSticky) tocSticky.style.display = '';
    }
  }

  // ===== Gập mục "Câu hỏi thường gặp" nằm trong nội dung bài =====
  // Nội dung từ CMS có 4 kiểu FAQ khác nhau (h3 phẳng / bọc .faq-block /
  // .faq-list đã dùng <details open> / .faq-section dùng .q + .a). Chuẩn hoá
  // hết về <details class="blog-faq__item"> cho giống accordion cuối bài.
  // CHẠY TRƯỚC đoạn chèn CTA bên dưới: nếu chạy sau, CTA có thể nằm giữa một
  // cặp hỏi–đáp rồi bị nuốt vào phần trả lời.
  if (articleBody) {
    const FAQ_RE = /câu hỏi thường gặp|(^|\s)faq(\s|:|$)|hỏi\s*[-–&]?\s*đáp/i;
    const isCta = (el) => el.classList && (el.classList.contains('blog-lead-magnet') || el.classList.contains('blog-inline-subscribe'));

    const makeDetails = (questionNode, answerNodes) => {
      const det = document.createElement('details');
      det.className = 'blog-faq__item';
      const sum = document.createElement('summary');
      sum.className = 'blog-faq__question';
      const ans = document.createElement('div');
      ans.className = 'blog-faq__answer';
      answerNodes.forEach((n) => ans.appendChild(n));
      sum.appendChild(questionNode);
      det.appendChild(sum);
      det.appendChild(ans);
      return det;
    };

    Array.from(articleBody.querySelectorAll('h2, h3')).filter((h) => FAQ_RE.test(h.textContent)).forEach((head) => {
      const lvl = +head.tagName[1];
      const blocks = [];
      let n = head.nextElementSibling;
      while (n && !(/^H[1-6]$/.test(n.tagName) && +n.tagName[1] <= lvl)) { blocks.push(n); n = n.nextElementSibling; }
      if (!blocks.length) return;

      // Các cặp hỏi–đáp có thể nằm trong 1 <div> bọc (.faq-block/.faq-list/
      // .faq-section) — và div đó KHÔNG phải sibling duy nhất (còn .cta-block,
      // .related... đứng sau), nên phải dò theo nội dung chứ không đếm số lượng.
      const isFaqHost = (el) => {
        if (!el || el.tagName !== 'DIV') return false;
        return Array.from(el.children).some((k) =>
          k.tagName === 'DETAILS'
          || /^H[3-6]$/.test(k.tagName)
          || (k.querySelector && k.querySelector(':scope > .q') && k.querySelector(':scope > .a')));
      };
      const host = blocks.find(isFaqHost) || null;
      const scope = host ? Array.from(host.children) : blocks;
      const parent = host || head.parentNode;

      // Kiểu đã là <details>: chỉ cần bỏ 'open' để mặc định gập lại
      const opened = scope.filter((el) => el.tagName === 'DETAILS');
      if (opened.length) { opened.forEach((el) => el.removeAttribute('open')); return; }

      // Kiểu .faq-item > .q + .a
      const qaItems = scope.filter((el) => el.querySelector && el.querySelector(':scope > .q') && el.querySelector(':scope > .a'));
      if (qaItems.length) {
        qaItems.forEach((el) => {
          const q = el.querySelector(':scope > .q');
          const a = el.querySelector(':scope > .a');
          q.classList.add('blog-faq__q-text');
          el.replaceWith(makeDetails(q, [a]));
        });
        return;
      }

      // Kiểu heading câu hỏi + các khối trả lời đứng sau
      scope.filter((el) => /^H[3-6]$/.test(el.tagName)).forEach((qh) => {
        const answer = [];
        let m = qh.nextElementSibling;
        while (m && !/^H[1-6]$/.test(m.tagName) && !isCta(m)) { const next = m.nextElementSibling; answer.push(m); m = next; }
        if (!answer.length) return;
        // Chốt vị trí trước khi makeDetails() nhấc qh ra khỏi DOM
        const mark = document.createComment('faq');
        parent.insertBefore(mark, qh);
        parent.replaceChild(makeDetails(qh, answer), mark);
      });
    });
  }

  // Inject inline CTAs at strategic positions (HubSpot-style mid-article)
  if (articleBody) {
    // Bài long-form bọc nội dung trong <article>/.content/.tldr... — khi đó thân bài
    // không có <p>/<h2> con TRỰC TIẾP nào nên CTA không chèn được. Không thể chỉ đi
    // xuống qua "lớp bọc đơn": có bài bọc bằng 2 div (.tldr + .content). Nên khi thân
    // bài quá ít neo thì tìm hậu duệ có nhiều đoạn con trực tiếp nhất.
    // ':scope > section' để bắt cả bài chia khối bằng <section> thay vì <p> phẳng.
    const ANCHOR_SEL = ':scope > p, :scope > h2, :scope > section';
    let contentRoot = articleBody;
    let paragraphs = Array.from(contentRoot.querySelectorAll(ANCHOR_SEL));
    if (paragraphs.length < 3) {
      let bestN = paragraphs.length;
      articleBody.querySelectorAll('article, main, div, section').forEach((el) => {
        const n = el.querySelectorAll(ANCHOR_SEL).length;
        if (n > bestN) { bestN = n; contentRoot = el; }
      });
      paragraphs = Array.from(contentRoot.querySelectorAll(ANCHOR_SEL));
    }
    const midCtaTpl = document.getElementById('midCtaTpl');
    const subCtaHost = document.getElementById('subCtaHost');
    // Insert lead-magnet at ~33%, email subscribe at ~66%
    const midIdx = Math.floor(paragraphs.length * 0.33);
    const subIdx = Math.floor(paragraphs.length * 0.66);
    if (midCtaTpl && paragraphs[midIdx]) {
      const node = midCtaTpl.content.cloneNode(true);
      paragraphs[midIdx].parentNode.insertBefore(node, paragraphs[midIdx]);
    }
    // DI CHUYỂN (không clone) box 2 bước: clone sẽ mất listener của form 2 bước.
    const subCta = subCtaHost && subCtaHost.firstElementChild;
    if (subCta && paragraphs[subIdx]) {
      paragraphs[subIdx].parentNode.insertBefore(subCta, paragraphs[subIdx]);
      subCtaHost.remove();
    }
  }

  // Add lazy loading to all images within blog content
  document.querySelectorAll('.blog-article__body img').forEach((img) => {
    if (!img.hasAttribute('loading')) {
      img.setAttribute('loading', 'lazy');
    }
  });

  // Wrap tables in responsive container
  document.querySelectorAll('.blog-article__body table').forEach((table) => {
    if (!table.parentElement?.classList.contains('blog-table-wrap')) {
      const wrapper = document.createElement('div');
      wrapper.className = 'blog-table-wrap';
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    }
  });

  // Auto-contrast: fix dark-background CMS blocks where text would be invisible.
  // Must use setProperty('color','#fff','important') because .blog-article__body p { color: #1f2937 }
  // has higher specificity than inherited color — so inherited white does NOT win without !important.
  (function applyAutoContrast() {
    const body = document.querySelector('.blog-article__body');
    if (!body) return;
    body.querySelectorAll('*').forEach(function(el) {
      // Only process elements with an inline background style
      const inlineStyle = el.getAttribute('style') || '';
      if (!inlineStyle.toLowerCase().includes('background')) return;
      // Read computed background color
      const bg = window.getComputedStyle(el).backgroundColor;
      if (!bg || bg === 'rgba(0, 0, 0, 0)' || bg === 'transparent') return;
      const m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!m) return;
      const lum = (0.299 * +m[1] + 0.587 * +m[2] + 0.114 * +m[3]) / 255;
      if (lum < 0.45) {
        // Dark background detected — force white text with !important to beat CSS specificity
        el.style.setProperty('color', '#ffffff', 'important');
        el.querySelectorAll('p, span, li, h1, h2, h3, h4, strong, em, b, a').forEach(function(child) {
          child.style.setProperty('color', '#ffffff', 'important');
        });
      }
    });
  })();

  // Fix placeholder phone numbers in CMS content.
  //
  // KHÔNG dùng `body.innerHTML = body.innerHTML.replace(...)`: gán lại innerHTML làm
  // trình duyệt PARSE LẠI toàn bộ nội dung bài → mọi node con bị thay bằng node mới và
  // MẤT SẠCH event listener. Form 2 bước chèn vào giữa bài (#subCtaHost) nằm trong
  // .blog-article__body nên bị xoá listener → bấm "Đăng ký nhận bài" không sang bước 2,
  // nhìn y như form 1 bước. Nay chỉ sửa text node + href, không đụng cấu trúc DOM.
  document.querySelectorAll('.blog-article__body').forEach((body) => {
    const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
    const texts = [];
    while (walker.nextNode()) texts.push(walker.currentNode);
    texts.forEach((node) => {
      if (node.nodeValue.indexOf('0909') === -1) return;
      node.nodeValue = node.nodeValue.replace(/0909\.?xxx\.?xxx/g, '0916 961 409');
    });
    body.querySelectorAll('a[href^="tel:0909"]').forEach((a) => {
      a.setAttribute('href', 'tel:0916961409');
    });
  });
</script>
