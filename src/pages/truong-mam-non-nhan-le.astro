---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const pageTitle = "Trường Mầm Non Nhân Lễ — Học Tiếng Anh Như Trẻ Em Bản Xứ | Cần Giuộc, Tây Ninh";
const pageDescription = "Trường Mầm Non Nhân Lễ tại Khu Dân Cư Long Hậu, Cần Giuộc, Tây Ninh. 100% chương trình tiếng Anh, kỹ năng sống Leader In Me (Franklin Covey), triết lý 'Vui Vẻ và Thực Dụng'. Hotline 0899 093 988 / 0774 588 988.";
const pageCanonical = "https://truongvietanh.com/truong-mam-non-nhan-le";
const ogImage = "https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/mam-non-banner-chinh-1.jpg";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Mầm Non Nhân Lễ",
    "url": pageCanonical,
    "description": pageDescription,
    "telephone": "+84899093988",
    "email": "hoc@truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Khu Dân Cư Long Hậu, Huyện Cần Giuộc",
      "addressLocality": "Tỉnh Tây Ninh",
      "addressCountry": "VN"
    },
    "parentOrganization": {
      "@type": "EducationalOrganization",
      "name": "Hệ thống Trường Việt Anh — Major Education",
      "url": "https://truongvietanh.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageCanonical,
    "inLanguage": "vi"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
  structuredData={structuredData}
>
  <main class="nl-page">

    <!-- ============== HERO ============== -->
    <section class="nl-hero">
      <div class="nl-hero__inner">
        <span class="nl-eyebrow">Hệ thống Trường Việt Anh — Cơ sở Cần Giuộc, Tây Ninh</span>
        <h1 class="nl-h1">Trường Mầm Non Nhân Lễ<br/><span class="nl-h1-accent">Học Tiếng Anh Như Trẻ Em Bản Xứ</span></h1>
        <p class="nl-hero__sub">100% chương trình tiếng Anh · Triết lý "Vui Vẻ &amp; Thực Dụng" · Kỹ năng sống Leader In Me (Franklin Covey).</p>
        <div class="nl-hero__cta">
          <a href="#nl-form" class="nl-btn nl-btn--primary">📝 Đăng ký tham quan trường</a>
          <a href="https://www.youtube.com/watch?v=WdlMX5P_hCo" target="_blank" rel="noopener" class="nl-btn nl-btn--ghost">▶ Xem video về trường</a>
        </div>
      </div>
    </section>

    <!-- ============== CHÀO MỪNG / FOUNDER QUOTE ============== -->
    <section class="nl-welcome">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Chào mừng bạn đến Trường Mầm Non Nhân Lễ</h2>
        <blockquote class="nl-welcome__quote">
          "Phần lớn quãng thời gian Mầm non của trẻ đang trôi qua mà không học tập được gì. Trường Mầm Non Nhân Lễ tận dụng thời gian này để giúp trẻ em học tiếng Anh theo cách mà trẻ em đã học tiếng Việt. Nhờ đó, học sinh mầm non Nhân Lễ tận dụng được thời điểm học ngôn ngữ hiệu quả nhất, để có được phát âm như người bản xứ."
          <cite>
            <strong>Ông Nguyễn Mạnh Dương</strong>
            <span>Chủ Tịch Trường Mầm Non Nhân Lễ</span>
          </cite>
        </blockquote>
      </div>
    </section>

    <!-- ============== HỆ THỐNG 3 CƠ SỞ ============== -->
    <section class="nl-network">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Hệ thống trường mầm non Việt Anh &amp; mầm non Nhân Lễ</h2>
        <div class="nl-network__grid">
          <div class="nl-network__card">
            <div class="nl-network__icon">🏙️</div>
            <h3>Thành Phố Hồ Chí Minh</h3>
            <p>Hệ thống cơ sở Việt Anh tại TP.HCM</p>
          </div>
          <div class="nl-network__card nl-network__card--feature">
            <div class="nl-network__icon">🌳</div>
            <h3>Cần Giuộc (Tây Ninh)</h3>
            <p>Trường Mầm Non Nhân Lễ — Khu Dân Cư Long Hậu</p>
          </div>
          <div class="nl-network__card">
            <div class="nl-network__icon">🌊</div>
            <h3>Thành Phố Rạch Giá (An Giang)</h3>
            <p>Cơ sở mầm non hệ thống Việt Anh</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== SỨ MỆNH · TẦM NHÌN · GTCT ============== -->
    <section class="nl-mission">
      <div class="nl-section__inner">
        <div class="nl-mission__grid">
          <div class="nl-mission__col">
            <div class="nl-mission__icon">🎯</div>
            <h3>Sứ Mệnh</h3>
            <p>Trường Mầm Non Nhân Lễ được xây dựng với sứ mệnh tạo nên môi trường giáo dục "<strong>Vui Vẻ và Thực Dụng</strong>" cho học sinh.</p>
          </div>
          <div class="nl-mission__col">
            <div class="nl-mission__icon">🌟</div>
            <h3>Tầm Nhìn</h3>
            <p>Môi trường Mầm Non Nhân Lễ giúp trẻ em phát triển khả năng tiếng Anh tự nhiên, hiểu được năng khiếu, cảm xúc của bản thân, có thể tham gia, hòa nhập một cách tích cực vào cộng đồng và hình thành sớm những thói quen hữu ích cho bậc học tiếp theo là Tiểu Học.</p>
          </div>
          <div class="nl-mission__col">
            <div class="nl-mission__icon">💎</div>
            <h3>5 Giá Trị Cốt Lõi</h3>
            <ol class="nl-core-values">
              <li>Tôn trọng &amp; Tự trọng</li>
              <li>Trách nhiệm</li>
              <li>Tài giỏi</li>
              <li>Chính trực</li>
              <li>Yêu thương</li>
            </ol>
          </div>
        </div>
        <div class="nl-mission__cta">
          <a href="#nl-form" class="nl-btn nl-btn--primary">Tìm hiểu sứ mệnh của trường mầm non Nhân Lễ</a>
        </div>
      </div>
    </section>

    <!-- ============== TRIẾT LÝ "VUI VẺ & THỰC DỤNG" ============== -->
    <section class="nl-philosophy">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Triết lý "Vui Vẻ &amp; Thực Dụng"</h2>
        <div class="nl-philosophy__grid">
          <div class="nl-philosophy__card">
            <h3>😊 "Vui Vẻ"</h3>
            <p>Tạo niềm vui và hiệu quả học tập — học sinh đến trường trong trạng thái được tôn trọng, được lắng nghe, và được phép mắc sai lầm để học hỏi.</p>
          </div>
          <div class="nl-philosophy__card">
            <h3>🛠️ "Thực Dụng"</h3>
            <p>Đảm bảo kiến thức, kỹ năng có ích cho hiện tại và tương lai của học sinh — mọi điều học được đều có giá trị ứng dụng trong cuộc đời các em.</p>
          </div>
        </div>

        <h3 class="nl-h3 nl-h3--center">3 sự khác biệt</h3>
        <div class="nl-diff">
          <div class="nl-diff__item">🏫 Cơ sở vật chất tốt</div>
          <div class="nl-diff__item">😄 Học sinh thích đến trường</div>
          <div class="nl-diff__item">🌍 Học tiếng Anh như trẻ em bản xứ</div>
        </div>
      </div>
    </section>

    <!-- ============== CHƯƠNG TRÌNH ĐÀO TẠO ============== -->
    <section class="nl-program">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Chương trình đào tạo</h2>
        <p class="nl-lead">Học sinh được tự chủ động tương tác với con người, vật liệu và các ý tưởng. Học sinh được tự lên kế hoạch, thực hiện các hoạt động do mình lựa chọn và chiêm nghiệm chúng với sự hỗ trợ của người lớn trong một môi trường dân chủ.</p>

        <div class="nl-program__grid">
          <div class="nl-program__card">
            <div class="nl-program__icon">📚</div>
            <h3>Chương trình tổng quát</h3>
            <p>Khung chương trình mầm non chuẩn Bộ GD&amp;ĐT — đảm bảo nền tảng kiến thức và kỹ năng cho bé.</p>
            <a href="#nl-form" class="nl-link">Tìm hiểu chương trình →</a>
          </div>
          <div class="nl-program__card nl-program__card--feature">
            <div class="nl-program__icon">🌍</div>
            <h3>Chương trình Tiếng Anh</h3>
            <p>Chương trình học <strong>100% bằng tiếng Anh</strong> (ngoại trừ môn tiếng Việt) được giảng dạy bởi đội ngũ giáo viên bản xứ và Việt Nam vững chuyên môn, kinh nghiệm trong giáo dục trẻ em.</p>
            <a href="#nl-form" class="nl-link">Tìm hiểu chương trình →</a>
          </div>
          <div class="nl-program__card">
            <div class="nl-program__icon">🧭</div>
            <h3>Chương trình Kỹ Năng Sống</h3>
            <p>Học sinh được học tập rèn luyện <strong>7 thói quen hiệu quả của Stephen R. Covey</strong> thông qua chương trình <em>The Leader In Me</em> — phát triển bởi Franklin Covey (Hoa Kỳ).</p>
            <a href="#nl-form" class="nl-link">Tìm hiểu chương trình →</a>
          </div>
        </div>

        <div class="nl-benefits">
          <h3 class="nl-h3">Lợi ích của phương pháp học tập chủ động</h3>
          <ol class="nl-benefits__list">
            <li><strong>Trẻ cảm thấy hạnh phúc khi đến trường</strong> — môi trường yêu thương vô điều kiện, không áp lực thành tích.</li>
            <li><strong>Phát triển toàn diện kiến thức và kỹ năng</strong> — học qua trải nghiệm và tương tác thật.</li>
            <li><strong>Học được kỹ năng lập kế hoạch</strong> — biết tự xác định mục tiêu và bước thực hiện.</li>
            <li><strong>Tự lập, trách nhiệm và tự tin</strong> — nền tảng vững vàng cho bậc Tiểu Học.</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ============== TUYỂN SINH · HỌC BỔNG · HỌC PHÍ ============== -->
    <section class="nl-admissions">
      <div class="nl-section__inner">
        <div class="nl-admissions__grid">
          <div class="nl-admissions__col">
            <div class="nl-admissions__icon">📝</div>
            <h3>Tuyển sinh</h3>
            <p>Quý phụ huynh và các em học sinh có mong muốn ghi danh nhập học tại trường mầm non Nhân Lễ sẽ trải qua 4 giai đoạn căn bản:</p>
            <ol class="nl-steps">
              <li><strong>Tư vấn</strong> — chi tiết về chương trình học, hình thức tuyển sinh, học phí, cơ sở vật chất.</li>
              <li><strong>Tham quan trường</strong> — phòng thí nghiệm, thư viện, phòng học, phòng giáo viên, nhà ăn, sân chơi.</li>
              <li><strong>Quyết định nhận học</strong> — Ban giám hiệu / Giám đốc gửi Thư thông báo nhập học.</li>
              <li><strong>Hướng dẫn thủ tục</strong> — hoàn tất học phí và ký Nội quy đào tạo.</li>
            </ol>
            <a href="#nl-form" class="nl-link">Tìm hiểu ngay →</a>
          </div>

          <div class="nl-admissions__col">
            <div class="nl-admissions__icon">🎁</div>
            <h3>Học bổng</h3>
            <p>Trường mầm non Nhân Lễ đang mở nhiều suất học bổng rất giá trị. Các suất học bổng được cấp theo quy tắc lần lượt, và kết thúc khi đã đủ số lượng.</p>
            <ul class="nl-bullets">
              <li>Học bổng hỗ trợ học phí (2%–10%)</li>
              <li>Học bổng tặng xe đạp khi ghi danh nhập học</li>
              <li>Đóng học phí cả năm trước nhập học: <strong>giảm 6%</strong></li>
              <li>Đóng 2 đợt (trước nhập học + trước HK2): <strong>giảm 2%</strong></li>
            </ul>
            <a href="#nl-form" class="nl-link">Tìm hiểu ngay →</a>
          </div>

          <div class="nl-admissions__col">
            <div class="nl-admissions__icon">💰</div>
            <h3>Học phí</h3>
            <p>Áp dụng chính sách học phí <strong>minh bạch</strong>, phù hợp với từng cấp học và <strong>cam kết không phát sinh chi phí ẩn</strong>.</p>
            <ul class="nl-bullets">
              <li>Học phí cạnh tranh và linh hoạt cho phụ huynh lựa chọn</li>
              <li>3 gói: High Quality · Bilingual · Premium</li>
              <li>Cam kết minh bạch, không có chi phí ẩn</li>
            </ul>
            <a href="#nl-form" class="nl-link">Tìm hiểu ngay →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== BẢNG HỌC PHÍ CHI TIẾT ============== -->
    <section class="nl-fees">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Bảng học phí chi tiết</h2>

        <h3 class="nl-h3">Tổng chi phí / tháng</h3>
        <div class="nl-fees__table">
          <table>
            <thead>
              <tr>
                <th>Khoản</th>
                <th>High Quality</th>
                <th>Bilingual</th>
                <th>Premium</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Học phí</strong></td>
                <td>3.390.000 đ</td>
                <td>6.000.000 đ</td>
                <td>6.820.000 đ</td>
              </tr>
              <tr>
                <td>Tiền ăn</td>
                <td>1.606.000 đ</td>
                <td>2.178.000 đ</td>
                <td>2.178.000 đ</td>
              </tr>
              <tr>
                <td>Bơi lội</td>
                <td>350.000 đ/tháng</td>
                <td>–</td>
                <td>–</td>
              </tr>
              <tr>
                <td>Sữa (mỗi hộp)</td>
                <td>12.000 đ</td>
                <td>12.000 đ</td>
                <td>12.000 đ</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="nl-h3">Phí hàng năm</h3>
        <div class="nl-fees__table">
          <table>
            <thead>
              <tr>
                <th>Khoản</th>
                <th>High Quality</th>
                <th>Bilingual</th>
                <th>Premium</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Cơ sở vật chất</td>
                <td>5.000.000 đ</td>
                <td>5.000.000 đ</td>
                <td>5.000.000 đ</td>
              </tr>
              <tr>
                <td>Phí sinh trắc</td>
                <td>2.200.000 đ</td>
                <td>2.200.000 đ</td>
                <td>2.200.000 đ</td>
              </tr>
              <tr>
                <td>Đồng phục (1 balo + 3 bộ)</td>
                <td>800.000 đ</td>
                <td>800.000 đ</td>
                <td>800.000 đ</td>
              </tr>
              <tr>
                <td>Bộ chăn gối + nệm</td>
                <td>500.000 đ</td>
                <td>500.000 đ</td>
                <td>500.000 đ</td>
              </tr>
              <tr>
                <td>Học cụ</td>
                <td>1.200.000 đ</td>
                <td>1.200.000 đ</td>
                <td>1.200.000 đ</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="nl-fees__note"><em>Có chính sách học bổng hấp dẫn theo thời gian ghi danh và lịch đóng học phí. Vui lòng để lại thông tin để nhận bảng giá đầy đủ và tư vấn ưu đãi phù hợp.</em></p>
      </div>
    </section>

    <!-- ============== 5 NGUYÊN TẮC SINH HOẠT ============== -->
    <section class="nl-principles">
      <div class="nl-section__inner">
        <h2 class="nl-h2">5 nguyên tắc sinh hoạt vì sức khỏe</h2>
        <div class="nl-principles__grid">
          <div class="nl-principle">🍎 Ăn tốt</div>
          <div class="nl-principle">💧 Uống tốt</div>
          <div class="nl-principle">😴 Nghỉ ngơi tốt</div>
          <div class="nl-principle">⚽ Thể dục thể thao</div>
          <div class="nl-principle">💛 Niềm vui mỗi ngày</div>
        </div>
      </div>
    </section>

    <!-- ============== TESTIMONIALS ============== -->
    <section class="nl-testi">
      <div class="nl-section__inner">
        <h2 class="nl-h2">Cảm Nhận Của Phụ Huynh<br/>Về Hệ Thống Trường Mầm Non Việt Anh — Nhân Lễ</h2>
        <p class="nl-lead nl-lead--center">Đa số phụ huynh thừa nhận rằng con mình thích nghi nhanh, tiến bộ vượt bậc về kiến thức và kĩ năng, đặc biệt là Tiếng Anh sau thời gian ngắn học tại trường.</p>

        <div class="nl-testi__grid">
          <article class="nl-testi__card">
            <blockquote>"Bé trưởng thành &amp; thích đi học hơn khi đến với trường Mầm Non Việt Anh."</blockquote>
            <cite>
              <strong>Chị Phương</strong>
              <span>Phụ Huynh Bé Phúc Tâm</span>
            </cite>
          </article>
          <article class="nl-testi__card">
            <blockquote>"Trường Mầm Non Việt Anh rèn luyện kỹ năng sống tự lập cho trẻ hiệu quả."</blockquote>
            <cite>
              <strong>Chị Diệu</strong>
              <span>Phụ Huynh Bé Candy</span>
            </cite>
          </article>
          <article class="nl-testi__card">
            <blockquote>"Cơ sở vật chất Mầm Non Việt Anh đáp ứng sự phát triển toàn diện của bé."</blockquote>
            <cite>
              <strong>Chị Nhi</strong>
              <span>Phụ Huynh Bé Eric</span>
            </cite>
          </article>
          {/* Thẻ lời chứng "Bé Moon" đã ẩn 10/11/2026 — chờ giấy đồng ý bằng văn bản của phụ huynh (anh Dương). */}
        </div>
      </div>
    </section>

    <!-- ============== SLOGAN BANNER ============== -->
    <section class="nl-slogan">
      <div class="nl-section__inner">
        <p class="nl-slogan__text">"Thước đo sự thành công của nhà trường là<br/><strong>Sự tiến bộ của từng học sinh</strong>"</p>
        <a href="#nl-form" class="nl-btn nl-btn--yellow">Đăng ký tư vấn ngay</a>
      </div>
    </section>

    <!-- ============== CTA FORM ============== -->
    <section class="nl-cta" id="nl-form">
      <div class="nl-cta__inner">
        <h2 class="nl-h2 nl-h2--light">Thông Tin Liên Hệ</h2>
        <p class="nl-cta__desc">Để lại email và số điện thoại để nhà trường liên hệ tư vấn, sắp xếp lịch tham quan và gửi bảng giá đầy đủ.</p>

        <div class="nl-cta__form">
          <LeadFormTwoStepEmailFirst
