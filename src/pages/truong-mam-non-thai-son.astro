---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const pageTitle = "Trường Mầm Non Thái Sơn — Long Hậu, Cần Giuộc | Hệ thống Việt Anh từ 2011";
const pageDescription = "Trường Mầm Non Thái Sơn — môi trường mầm non an toàn, lành mạnh và đầy yêu thương. Hệ thống giáo dục Việt Anh từ 2011. Học phí 3.999.000 đ/tháng — 100 suất học bổng 50% còn 1.999.500 đ/tháng.";
const pageCanonical = "https://truongvietanh.com/truong-mam-non-thai-son";
const ogImage = "https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/mam-non-banner-chinh-1.jpg";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Mầm Non Thái Sơn",
    "url": pageCanonical,
    "description": pageDescription,
    "telephone": "+84916961409",
    "email": "hoc@truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Xã Long Hậu, huyện Cần Giuộc",
      "addressLocality": "Tỉnh Tây Ninh",
      "addressCountry": "VN"
    },
    "parentOrganization": {
      "@type": "EducationalOrganization",
      "name": "Hệ thống Trường Việt Anh — Major Education",
      "url": "https://truongvietanh.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageCanonical,
    "inLanguage": "vi"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
  structuredData={structuredData}
>
  <main class="mn-ts">

    <!-- ============== SECTION 1: HERO ============== -->
    <section class="mn-hero">
      <div class="mn-hero__inner">
        <span class="mn-eyebrow">Hệ thống giáo dục Việt Anh từ 2011</span>
        <h1 class="mn-h1">CON MỚI 1 TUỔI – BẠN ĐÃ PHẢI ĐI LÀM. NÊN CHÚNG TÔI Ở ĐÂY ĐỂ YÊU THƯƠNG CON NHƯ NGƯỜI THÂN</h1>
        <p class="mn-hero__sub">Môi trường mầm non an toàn, lành mạnh và đầy yêu thương — nơi con vừa được chăm sóc, vừa được học.</p>
        <p class="mn-hero__sub">Chương trình mầm non tiên tiến của trường mầm non chuyên Anh hàng đầu TP.HCM.</p>
        <p class="mn-hero__sub mn-hero__sub--bold">An toàn tuyệt đối · Phát triển toàn diện · Tiếng Anh thực dụng · Dinh dưỡng lành mạnh.</p>
        <div class="mn-hero__cta">
          <a href="#mn-form" class="mn-btn mn-btn--primary">👉 Cho tôi đến thăm trường trước khi quyết định</a>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 2: HỌC PHÍ BANNER ============== -->
    <section class="mn-fee-banner">
      <div class="mn-fee-banner__inner">
        <span class="mn-eyebrow mn-eyebrow--center">HỌC PHÍ CHÍNH THỨC</span>
        <h2 class="mn-fee__title">Học phí: 3.999.000 VND/tháng</h2>
        <div class="mn-fee__highlight">
          <span class="mn-fee__badge">100 học bổng đầu tiên trong suốt 2 năm</span>
          <p class="mn-fee__promo">–50% còn <strong>1.999.500 VND/tháng</strong></p>
          <p class="mn-fee__save">tiết kiệm <strong>23.994.000 VND</strong> mỗi năm học</p>
        </div>
        <a href="#mn-form" class="mn-btn mn-btn--primary">👉 Cho tôi đến thăm trường trước khi quyết định</a>
      </div>
    </section>

    <!-- ============== SECTION 3: PAIN POINTS ============== -->
    <section class="mn-pain">
      <div class="mn-section__inner">
        <h2 class="mn-h2">BẠN CÓ ĐANG LO NHỮNG ĐIỀU NÀY?</h2>
        <div class="mn-pain__list">
          <div class="mn-pain__card">
            <span class="mn-pain__icon">😨</span>
            <p>"Con mới 18 tháng mà phải gửi đi — mình đau lòng lắm. Nhưng không đi làm thì lấy tiền đâu lo cho con..."</p>
          </div>
          <div class="mn-pain__card">
            <span class="mn-pain__icon">😭</span>
            <p>"Sợ con bị cô giáo la mắng, bị bạn bắt nạt. Không biết cô có thực sự yêu thương con mình không..."</p>
          </div>
          <div class="mn-pain__card">
            <span class="mn-pain__icon">🍚</span>
            <p>"Bé ăn gì ở trường mình không biết. Sợ con ăn đồ không lành mạnh, lâu ngày ảnh hưởng sức khỏe..."</p>
          </div>
        </div>
        <p class="mn-pain__close">🤝 Chúng tôi hiểu. Trường Mầm non Thái Sơn để giải quyết những nỗi lo này — bằng môi trường an toàn, triết lý giáo dục sớm hiệu quả, và những bữa ăn vì sức khỏe.</p>
      </div>
    </section>

    <!-- ============== SECTION 4: POSITIONING ============== -->
    <section class="mn-positioning">
      <div class="mn-section__inner">
        <h2 class="mn-h2">NỀN TẢNG TỪ HỆ THỐNG GIÁO UY TÍN – HỌC PHÍ PHÙ HỢP VỚI MỌI GIA ĐÌNH</h2>
        <p class="mn-lead">Trường Mầm non Thái Sơn kế thừa toàn bộ triết lý và chương trình từ hệ thống mầm non Việt Anh – hoạt động từ năm 2011.</p>
        <p class="mn-lead"><strong>Chúng tôi không giảm chất lượng.</strong></p>
        <p class="mn-lead">Chúng tôi tối ưu mô hình để nhiều gia đình có thể tiếp cận giáo dục tốt.</p>

        <h3 class="mn-h3">❗ 5 ĐIỂM KHÁC BIỆT</h3>
        <ol class="mn-diff__list">
          <li><strong>Không chỉ chăm nuôi</strong>, mà là giáo dục sớm để tận dụng thời gian vàng của não bộ</li>
          <li><strong>Cô giáo được đào tạo theo chuẩn hệ thống Việt Anh</strong></li>
          <li><strong>Tiếng Anh với giáo viên bản ngữ</strong> để phát triển khả năng phát âm như trẻ em bản ngữ</li>
          <li><strong>Bữa ăn 100% thủy hải sản, rau củ tươi</strong></li>
          <li><strong>Hệ thống theo dõi phát triển cá nhân từng bé</strong> cả 9 lĩnh vực</li>
        </ol>
      </div>
    </section>

    <!-- ============== SECTION 5: PEDAGOGY 9 LĨNH VỰC ============== -->
    <section class="mn-pedagogy">
      <div class="mn-section__inner">
        <h2 class="mn-h2">KHÔNG PHẢI "GIỮ TRẺ" – MÀ LÀ "PHÁT TRIỂN TRẺ"</h2>
        <p class="mn-sub-h2">TOÀN BỘ 9 LĨNH VỰC PHÁT TRIỂN CỦA TRẺ MẦM NON ĐƯỢC ÁP DỤNG ĐẦY ĐỦ TẠI THÁI SƠN</p>
        <p class="mn-lead mn-lead--center"><strong>Bé sẽ được học:</strong></p>

        <div class="mn-cards">
          <div class="mn-card">
            <h4>👫 Đa độ tuổi (Multi-age)</h4>
            <p>Bé 12 tháng học cùng anh chị 4–5 tuổi, tự nhiên học giao tiếp, hợp tác và đồng cảm như môi trường xã hội thật.</p>
          </div>
          <div class="mn-card">
            <h4>🎨 Con tự chọn cách học (Student Choice)</h4>
            <p>Lớp học nhiều góc: mỹ thuật, khoa học, vận động, âm nhạc, gia đình… Con tự chọn hoạt động và bạn chơi, không bị ép buộc.</p>
          </div>
          <div class="mn-card">
            <h4>🎯 Lên kế hoạch – Thực hiện – Chiêm nghiệm (Plan-Do-Review)</h4>
            <p>Mỗi ngày con tự nói điều mình muốn làm, cuối ngày cùng lớp nhìn lại đã làm được gì và vì sao.</p>
            <ul class="mn-outcomes">
              <li>Hình thành tư duy mục tiêu và thói quen tự đánh giá từ rất sớm.</li>
              <li>Con phát triển kỹ năng xã hội sớm hơn nhiều so với mầm non thông thường.</li>
              <li>Con học cách ra quyết định, chia sẻ và giải quyết mâu thuẫn từ nhỏ.</li>
            </ul>
          </div>
          <div class="mn-card">
            <h4>🗣️ Tiếng Anh tích hợp</h4>
            <p>Tiếng Anh xuất hiện trong giờ học, giờ chơi, giờ ăn; giáo viên bản ngữ dạy trực tiếp mỗi tuần.</p>
            <p>Hết mầm non, con tự tin nghe và nói những câu Tiếng Anh đơn giản — nền tảng vững cho Tiểu học.</p>
          </div>
          <div class="mn-card">
            <h4>💛 Kỷ luật tích cực</h4>
            <p>Không dùng thưởng – phạt; giáo viên giúp con hiểu hệ quả hành vi và tự điều chỉnh cảm xúc.</p>
            <p>Con hình thành kỷ luật từ bên trong — không phụ thuộc vào người giám sát.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 5B: MỘT NGÀY CỦA CON (TKB) ============== -->
    <section class="mn-schedule">
      <div class="mn-section__inner">
        <h2 class="mn-h2">MỘT NGÀY CỦA CON TẠI THÁI SƠN</h2>
        <p class="mn-sub-h2">Lịch sinh hoạt rõ ràng từ 7:25 đến 17:35 — con vừa được chăm, vừa được học, vừa được chơi</p>
        <div class="mn-timeline">
          <div class="mn-timeline__row"><span class="mn-timeline__time">7:25 – 7:55</span><span class="mn-timeline__act">Đón trẻ, đo nhiệt độ &amp; thể dục buổi sáng</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">8:05 – 8:35</span><span class="mn-timeline__act">Ăn sáng tại lớp</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">8:45 – 9:10</span><span class="mn-timeline__act">Thể dục · Chơi ngoài trời · Họp lớp</span></div>
          <div class="mn-timeline__row mn-timeline__row--en"><span class="mn-timeline__time">9:25 – 9:50</span><span class="mn-timeline__act">English · Nhận biết tập nói · Làm quen với chữ</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">10:00 – 10:30</span><span class="mn-timeline__act">Ăn điểm tâm (vitamin break)</span></div>
          <div class="mn-timeline__row mn-timeline__row--en"><span class="mn-timeline__time">10:40 – 11:05</span><span class="mn-timeline__act">English · Sensory · Toán · TLIM</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">11:20 – 12:00</span><span class="mn-timeline__act">Ăn trưa</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">12:15 – 14:15</span><span class="mn-timeline__act">Ngủ trưa</span></div>
          <div class="mn-timeline__row mn-timeline__row--pdr"><span class="mn-timeline__time">14:45 – 15:35</span><span class="mn-timeline__act">Plan · Do · Review · Âm nhạc · Văn học · Môi trường quanh em</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">15:45 – 16:15</span><span class="mn-timeline__act">Ăn xế (afternoon tea)</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">16:25 – 16:50</span><span class="mn-timeline__act">Kể chuyện · Tạo hình · Toán</span></div>
          <div class="mn-timeline__row"><span class="mn-timeline__time">16:50 – 17:35</span><span class="mn-timeline__act">Dọn dẹp, chơi tự do &amp; trả trẻ</span></div>
        </div>
        <p class="mn-schedule__note">Áp dụng cho 3 nhóm lớp <strong>1–3, 3–4 và 5–6 tuổi</strong> (giờ giấc xê dịch nhẹ theo độ tuổi). <strong>English xuất hiện mỗi ngày</strong>; phương pháp <strong>Plan – Do – Review</strong> xuyên suốt cả tuần. <em>(Thời khóa biểu năm học 2026 – 2027)</em></p>
      </div>
    </section>

    <!-- ============== SECTION 6: AN TOÀN & DINH DƯỠNG ============== -->
    <section class="mn-safety">
      <div class="mn-section__inner">
        <h2 class="mn-h2">AN TOÀN LÀ ƯU TIÊN SỐ 1 — DINH DƯỠNG LÀ NỀN TẢNG PHÁT TRIỂN</h2>

        <h3 class="mn-h3">🥇 An toàn thể chất</h3>
        <ul class="mn-safety__list">
          <li>Cơ sở vật chất thiết kế riêng cho trẻ nhỏ</li>
          <li>Bé luôn có cô giáo bên cạnh</li>
          <li>Camera toàn trường</li>
          <li>Quy trình đón trả nghiêm ngặt</li>
        </ul>

        <h3 class="mn-h3">5 nguyên tắc sống khỏe</h3>
        <ol class="mn-safety__principles">
          <li>Ăn tốt</li>
          <li>Uống tốt</li>
          <li>Nghỉ ngơi tốt</li>
          <li>Thể dục thể thao</li>
          <li>Niềm vui mỗi ngày</li>
        </ol>

        <div class="mn-nutrition">
          <p class="mn-nutrition__good">✅ <strong>Bé được ăn:</strong> cá tươi, rau củ, trái cây theo mùa.</p>
          <p class="mn-nutrition__bad">❌ <strong>Không có:</strong> đồ ăn nhanh, nước ngọt, thực phẩm chế biến sẵn.</p>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 7: GIAO TIẾP PHỤ HUYNH ============== -->
    <section class="mn-comm">
      <div class="mn-section__inner">
        <h2 class="mn-h2">BẠN ĐI LÀM CẢ NGÀY — VẪN BIẾT CON ĐANG ĐƯỢC YÊU THƯƠNG</h2>
        <ul class="mn-comm__list">
          <li><strong>Mỗi ngày:</strong> nhận ảnh &amp; video hoạt động của bé</li>
          <li><strong>Mỗi tuần:</strong> cập nhật sự phát triển</li>
          <li><strong>Mỗi kỳ:</strong> gặp riêng cô giáo trao đổi</li>
        </ul>
        <p class="mn-comm__tagline">Chúng tôi không chỉ trông trẻ. Chúng tôi đồng hành cùng bạn trong hành trình nuôi dạy con.</p>
      </div>
    </section>

    <!-- ============== SECTION 8: FOUNDER MESSAGE ============== -->
    <section class="mn-founder">
      <div class="mn-section__inner">
        <div class="mn-founder__profile">
          <div class="mn-founder__avatar">👤</div>
          <div>
            <div class="mn-founder__name">Nguyễn Mạnh Dương</div>
            <div class="mn-founder__role">Nhà sáng lập hệ thống giáo dục Việt Anh – Thái Sơn</div>
          </div>
        </div>
        <blockquote class="mn-founder__quote">
          <p>"Tôi xây trường không chỉ cho con mình, mà để thu hẹp khoảng cách giữa giáo dục Việt Nam và thế giới."</p>
          <p>"Tôi muốn một đứa trẻ lớn lên ở bất kỳ đâu cũng có quyền lựa chọn tương lai của mình, không bị giới hạn bởi xuất phát điểm."</p>
          <p>"Còn 3 đứa con tôi — tất cả đều học trong hệ thống này — là phần thưởng trên con đường đó. Và là lý do tôi cùng các cộng sự không bao giờ cho phép mình làm dưới mức tốt nhất. Vì đây cũng là trường của con mình."</p>
          <p><strong>"Tôi tin rằng: quyền được học tốt không phải đặc quyền của nhà giàu. Và một đứa trẻ bình thường, trong môi trường được thiết kế đúng, hoàn toàn có thể trở nên phi thường."</strong></p>
        </blockquote>
      </div>
    </section>

    <!-- ============== SECTION 9: TESTIMONIALS ============== -->
    <section class="mn-testi">
      <div class="mn-section__inner">
        <h2 class="mn-h2">CẢM NHẬN CỦA PHỤ HUYNH</h2>
        <div class="mn-testi__grid">
          <article class="mn-testi__card">
            <blockquote>"Con tôi mới 20 tháng khi gửi vào. Tôi lo lắng lắm, khóc cả tuần đầu. Nhưng cô giáo gửi ảnh con mỗi ngày — con đang ăn, đang ngủ, đang chơi. Chỉ sau 2 tuần tôi đã hoàn toàn yên tâm. Thấy con vui hơn cả ở nhà nữa."</blockquote>
            <cite>
              <strong>Chị Ngọc</strong>
              <span>Phụ huynh bé 20 tháng · Hệ thống trường Việt Anh</span>
            </cite>
          </article>
          <article class="mn-testi__card">
            <blockquote>"Con tôi trước toàn đòi ăn đồ chiên, không chịu ăn rau. Học ở đây được 6 tháng, về nhà tự nhiên đòi ăn cá, ăn rau. Cô nói trường có dạy về thức ăn tốt cho sức khỏe từ rất sớm. Tôi không ngờ con 4 tuổi mà đã biết chọn thức ăn."</blockquote>
            <cite>
              <strong>Anh Bình</strong>
              <span>Phụ huynh bé 3 tuổi · Hệ thống trường Việt Anh</span>
            </cite>
          </article>
          <article class="mn-testi__card">
            <blockquote>"Bé nhà tôi trước đi mầm non khác, 3 tuổi vẫn nói ít lắm. Chuyển sang đây được 4 tháng, tự nhiên con nói nhiều hẳn, còn bắt đầu nói vài từ tiếng Anh. Cô giáo giải thích vì con được học trong môi trường nghe nhiều hơn, không bị áp lực phải nói đúng ngay."</blockquote>
            <cite>
              <strong>Chị Hà</strong>
              <span>Phụ huynh bé 4 tuổi · Hệ thống Việt Anh</span>
            </cite>
          </article>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 10: HÀNH TRÌNH TRƯỞNG THÀNH ============== -->
    <section class="mn-journey">
      <div class="mn-section__inner">
        <h2 class="mn-h2">HÀNH TRÌNH TRƯỞNG THÀNH HỌC SINH MẦM NON</h2>
        <p class="mn-journey__sub">💖 Tận hưởng niềm vui với sự thay đổi của con</p>
        <p class="mn-journey__sub">Rõ ràng ngay từ đầu — không phát sinh bất ngờ</p>

        <div class="mn-journey__timeline">
          <div class="mn-journey__step">
            <div class="mn-journey__age">18 – 24 tháng</div>
            <p>Bé thích nghi môi trường lớp, học giao tiếp, tự xúc ăn, biết gọi cô khi cần.</p>
          </div>
          <div class="mn-journey__step">
            <div class="mn-journey__age">2 – 3 tuổi</div>
            <p>Bé bắt đầu Multi-age, học từ anh chị, nghe được câu Tiếng Anh đơn giản, tự chọn góc chơi.</p>
          </div>
          <div class="mn-journey__step">
            <div class="mn-journey__age">3 – 4 tuổi</div>
            <p>Bé thực hành Plan-Do-Review, tự lên kế hoạch hoạt động, nói tự tin Tiếng Anh và Tiếng Việt.</p>
          </div>
          <div class="mn-journey__step">
            <div class="mn-journey__age">4 – 5 tuổi</div>
            <p>Bé sẵn sàng vào Tiểu học: biết tự quản lý cảm xúc, chia sẻ, hợp tác và đặt mục tiêu cá nhân.</p>
          </div>
        </div>
      </div>
    </section>

