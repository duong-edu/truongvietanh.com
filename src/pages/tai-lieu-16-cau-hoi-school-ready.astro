---
// /tai-lieu-16-cau-hoi-school-ready — trang tặng tài liệu "16 câu hỏi: Con đã sẵn sàng vào lớp 1 chưa?".
// Lead magnet của School Ready: điểm đến cho quảng cáo muốn nhận tài liệu ngay.
// Nội dung theo bản "06 – Nội dung landing tặng tài liệu 16 câu hỏi (School Ready)".
// Giao diện dùng chung ngôn ngữ với /school-ready (navy #26275D, vàng #F9DD0E, ảnh thật lớp Lá).
// Form 2 bước: (1) email → partial_capture, (2) họ tên cha mẹ + SĐT → full submit.
// POST /api/lead → Pancake + GetResponse. Pancake không nhận tag qua /api/lead nên tag
// được ghép vào `note`.
// Gửi xong: mở nút tải PDF ngay trên trang (file ở public/downloads/).
// noindex: trang gate tài liệu, giống các squeeze khác của site.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const ZALO_OA = 'https://zalo.me/1678310120468101523';
const PDF_URL = '/downloads/16-cau-hoi-school-ready.pdf';

const fitList = [
  'Con bạn 5–6 tuổi và sắp vào lớp 1, bạn muốn biết nên chuẩn bị gì cho con.',
  'Bạn lo con chưa tự lập, chưa dám nói với cô, hoặc nhanh mệt trong buổi học dài.',
  'Bạn không muốn ép con học chữ sớm, chỉ muốn con vào lớp 1 nhẹ nhàng và tự tin.',
  'Bạn cần một danh sách rõ ràng để biết bắt đầu từ đâu, thay vì tự đoán.',
];

// Chỉ hiện câu hỏi và lựa chọn, không hiện việc làm tuần này để giữ giá trị tài liệu
const samples = [
  {
    meta: 'Câu 6 · Kỹ năng', star: true,
    q: 'Bạn nói một lần duy nhất: “Con cất giày, rửa tay, rồi lấy cho mẹ cái khăn.” Con làm được bao nhiêu việc?',
    tryNow: 'Thử tối nay, không nhắc lại.',
    opts: ['Một việc hoặc chưa làm việc nào', 'Hai việc, hoặc đủ nhưng sai thứ tự', 'Đủ ba việc, đúng thứ tự'],
  },
  {
    meta: 'Câu 11 · Phẩm chất', star: false,
    q: 'Khi không làm được một việc (tháp xếp hình đổ, thua trò chơi), con thường làm gì?',
    opts: ['Khóc to, ném đồ hoặc giận dỗi lâu', 'Buồn, cần người lớn dỗ mới nguôi', 'Nói được “Con đang bực” hoặc “Con buồn”, rồi tự bình tĩnh lại'],
  },
  {
    meta: 'Câu 16 · Sức khoẻ', star: false,
    q: 'Ở một nơi lạ, khi cần đi vệ sinh, con làm gì?',
    opts: ['Không dám nói, cố nhịn hoặc khóc', 'Nói với bố mẹ nhưng cần người lớn đi cùng và giúp', 'Tự hỏi người lớn, tự đi và tự rửa tay'],
  },
];

const faqs = [
  {
    id: 'faq-mien-phi',
    q: 'Tài liệu này có miễn phí thật không?',
    a: 'Có. Bạn chỉ cần để lại email, họ tên và số điện thoại để trường gửi tài liệu. Bạn không phải đăng ký học hay trả bất kỳ khoản nào.',
  },
  {
    id: 'faq-do-tuoi',
    q: 'Con tôi bao nhiêu tuổi thì phù hợp?',
    a: 'Tài liệu viết cho trẻ 5–6 tuổi, trước hoặc trong năm con vào lớp 1.',
  },
  {
    id: 'faq-con-lam-bai',
    q: 'Tôi có cần đưa con làm bài không?',
    a: 'Không. Bạn tự quan sát con ở nhà. Có 5 câu bạn thử cùng con trong khoảng 1 phút bằng đồ vật sẵn có, con không phải ngồi làm bài.',
  },
  {
    id: 'faq-truong-khac',
    q: 'Con đang học trường khác thì dùng được không?',
    a: 'Được. Tài liệu dành cho mọi phụ huynh có con sắp vào lớp 1, không cần con học ở Trường Việt Anh.',
  },
  {
    id: 'faq-chuyen-mon',
    q: 'Kết quả có phải đánh giá chuyên môn không?',
    a: 'Không. Đây là công cụ giúp bạn nhìn lại con qua những gì bạn thấy hằng ngày. Mỗi đứa trẻ có nhịp phát triển riêng.',
  },
  {
    id: 'faq-thong-tin',
    q: 'Thông tin của tôi được dùng vào việc gì?',
    a: 'Trường dùng để gửi tài liệu và liên hệ tư vấn khi bạn đồng ý, theo Chính sách bảo mật và Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15. Chúng tôi không hỏi tên con.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Tặng bạn tài liệu 16 câu hỏi: Con đã sẵn sàng vào lớp 1 chưa? | School Ready – Trường Việt Anh"
  description="Nhận miễn phí tài liệu 16 câu hỏi giúp bạn tự quan sát con 5–6 tuổi qua 4 lĩnh vực Kiến thức, Kỹ năng, Phẩm chất, Sức khoẻ, kèm việc làm ngay tại nhà cho từng năng lực."
  canonical="https://truongvietanh.com/tai-lieu-16-cau-hoi-school-ready"
  noindex={true}
  ogImage="https://truongvietanh.com/images/school-ready/tai-lieu-16-cau-hoi-og.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  structuredData={structuredData}
>
  <div class="t16-page">
    <HeaderBase />

    <!-- 1. HERO -->
    <section class="t16-hero">
      <div class="t16-wide t16-hero-grid">
        <div class="t16-hero-text">
          <p class="t16-eyebrow">Tài liệu tặng phụ huynh · School Ready</p>
          <h1 class="t16-h1">Con sắp vào lớp 1? Nhận <span class="t16-hl">16 câu hỏi</span> giúp bạn nhìn lại con trong 5 phút</h1>
          <p class="t16-sub">Lớp 1 cần một đứa trẻ tự lo việc của mình, nghe hiểu lời cô, dám nói khi cần giúp và đủ sức cho một buổi học dài. Tài liệu này giúp bạn nhìn lại con qua 4 lĩnh vực, bằng chính những gì bạn thấy ở nhà mỗi ngày.</p>
          <ul class="t16-stats">
            <li><strong>16 câu</strong><span>quan sát</span></li>
            <li><strong>4 lĩnh vực</strong><span>Kiến thức · Kỹ năng · Phẩm chất · Sức khoẻ</span></li>
            <li><strong>5 bài thử nhỏ</strong><span>làm cùng con ngay tối nay</span></li>
          </ul>
          <a href="#nhan-tai-lieu" class="t16-btn t16-btn-gold t16-btn-lg">Nhận tài liệu miễn phí →</a>
          <p class="t16-hero-note">Miễn phí. Đây không phải bài kiểm tra con. Bạn trả lời theo những gì bạn thấy ở nhà.</p>
        </div>

        <div class="t16-hero-visual">
          <img class="t16-hero-photo" src="/images/school-ready/morning-meeting-lop-la-vong-tron.webp" width="1400" height="1050" loading="eager" fetchpriority="high" decoding="async" alt="Cô giáo ngồi cùng trẻ lớp Lá thành vòng tròn trên thảm xanh, mọi người nắm tay nhau trong Morning Meeting" />
          <!-- Bìa tài liệu dựng bằng CSS, giống trang 1 của file PDF -->
          <div class="t16-cover" aria-hidden="true">
            <span class="t16-cover-badge">Miễn phí</span>
            <span class="t16-cover-kicker">SCHOOL READY · TRƯỜNG VIỆT ANH</span>
            <span class="t16-cover-gift">Tài liệu tặng phụ huynh</span>
            <span class="t16-cover-title">16 câu hỏi</span>
            <span class="t16-cover-sub">Con đã sẵn sàng vào lớp 1 chưa?</span>
            <span class="t16-cover-rule"></span>
            <span class="t16-cover-foot">5 phút · 16 câu · 5 bài thử nhỏ</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. DÀNH CHO BẠN NẾU -->
    <section class="t16-sec t16-sec-light">
      <div class="t16-wide t16-split">
        <figure class="t16-fig">
          <img src="/images/school-ready/hoat-dong-thu-cong-nhom.webp" width="1400" height="1050" loading="lazy" decoding="async" alt="Các bé cười tươi cùng cô giáo bên bàn làm thủ công với bút màu và khăn giấy" />
        </figure>
        <div>
          <h2>Tài liệu này dành cho bạn nếu…</h2>
          <ul class="t16-checks">
            {fitList.map((t) => (
              <li><span class="t16-tick" aria-hidden="true">✓</span><span>{t}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. SAU 5 PHÚT -->
    <section class="t16-sec t16-sec-navy">
      <div class="t16-wide">
        <h2 class="t16-h2-gold t16-center">Sau 5 phút, bạn sẽ biết</h2>
        <ol class="t16-know">
          <li>Con đã vững bao nhiêu trong 16 năng lực.</li>
          <li>Năng lực nào con đang cần thêm thời gian.</li>
          <li>Một việc bạn làm được ngay trong tuần này cho từng năng lực đó.</li>
        </ol>
      </div>
    </section>

    <!-- 5. XEM THỬ VÀI CÂU -->
    <section class="t16-sec t16-sec-light">
      <div class="t16-wide">
        <h2 class="t16-center">Xem thử vài câu hỏi trong tài liệu</h2>
        <div class="t16-qgrid">
          {samples.map((s) => (
            <article class="t16-q">
              <p class="t16-q-meta">{s.meta}{s.star && <span class="t16-q-star"> ★</span>}</p>
              <p class="t16-q-text">{s.q}</p>
              {s.tryNow && <p class="t16-try"><strong>★ Thử ngay với con trong 1 phút:</strong> {s.tryNow}</p>}
              <ul class="t16-opts">
                {s.opts.map((o) => (<li><span class="t16-box" aria-hidden="true"></span>{o}</li>))}
              </ul>
            </article>
          ))}
        </div>
        <div class="t16-more">
          <p>Tài liệu đầy đủ có cả 16 câu, kèm dòng “Ở lớp 1” và một việc làm ngay tuần này cho từng câu.</p>
          <a href="#nhan-tai-lieu" class="t16-btn t16-btn-navy">Nhận tài liệu miễn phí →</a>
        </div>
      </div>
    </section>

    <!-- 6. VÌ SAO TRƯỜNG LÀM TÀI LIỆU NÀY -->
    <section class="t16-sec t16-sec-white">
      <div class="t16-wide t16-split">
        <div>
          <h2>Vì sao Trường Việt Anh làm tài liệu này</h2>
          <p>Chúng tôi không dạy trước chương trình lớp 1. Chúng tôi giúp con chuẩn bị 16 năng lực để vào lớp 1 nhẹ nhàng, tự tin: tự lo việc của mình, nghe hiểu chỉ dẫn, dám nói khi cần giúp, đủ sức khoẻ cho một buổi học dài. Khung 16 năng lực dựa trên Bộ chuẩn phát triển trẻ em 5 tuổi của Bộ GD&amp;ĐT.</p>
          <p>Tài liệu này là cách chúng tôi chia sẻ với phụ huynh những gì giáo viên Việt Anh vẫn quan sát ở trẻ mỗi ngày.</p>
          <a href="/school-ready" class="t16-arrow" data-keep-utm>Tìm hiểu chương trình School Ready →</a>
        </div>
        <figure class="t16-fig">
          <img src="/images/school-ready/morning-meeting-lop-la-co-giao-huong-dan.webp" width="1400" height="1050" loading="lazy" decoding="async" alt="Cô giáo hướng dẫn trẻ lớp Lá ngồi thành vòng tròn, các bạn nhìn nhau và mỉm cười" />
          <div class="t16-fig-pair">
            <img src="/images/school-ready/hoat-dong-in-dau-ban-tay.webp" width="1400" height="1050" loading="lazy" decoding="async" alt="Cô giáo cùng các bé trong lớp in dấu bàn tay lên tờ giấy lớn" />
            <img src="/images/school-ready/morning-meeting-lop-la-nam-tay-vong-tron.webp" width="1400" height="1050" loading="lazy" decoding="async" alt="Trẻ lớp Lá nắm tay nhau thành vòng tròn cùng cô giáo trong giờ Morning Meeting" />
          </div>
          <figcaption>Lớp Lá School Ready: Morning Meeting mỗi sáng và giờ học bằng tay cùng cô.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 7. FORM NHẬN TÀI LIỆU -->
    <section class="t16-sec t16-sec-navy" id="nhan-tai-lieu">
      <div class="t16-wide t16-formgrid">
        <div class="t16-formtext">
          <h2 class="t16-h2-gold">Nhận tài liệu 16 câu hỏi miễn phí</h2>
          <p>Điền email, trường gửi tài liệu 16 câu hỏi cho bạn. Gửi xong, bạn tải được bản PDF ngay trên trang này.</p>
          <ul>
            <li>16 câu hỏi quan sát, chia theo 4 lĩnh vực</li>
            <li>Dòng “Ở lớp 1” và việc làm ngay tuần này cho từng năng lực</li>
            <li>Bảng đếm và gợi ý theo từng mức của con</li>
          </ul>
          <p>Hoặc nhắn ngay <a href={ZALO_OA} target="_blank" rel="noopener">Zalo OA Trường Việt Anh</a> · Hotline <a href="tel:0916961409">0916 961 409</a></p>
        </div>

        <div class="t16-formcard" id="t16-formcard">
          <h3>Nhận tài liệu qua email</h3>
          <form id="t16-form" novalidate>
            <ol class="t16-fsteps" aria-label="Các bước">
              <li class="t16-fsteps-on" id="t16-dot-1"><span>1</span> Email</li>
              <li id="t16-dot-2"><span>2</span> Họ tên, SĐT</li>
            </ol>
            <div class="t16-step" id="t16-step-1">
              <div class="t16-field">
                <label for="t16-email">Email nhận tài liệu <span aria-hidden="true">*</span></label>
                <input id="t16-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="ten@email.com" required />
              </div>
              <button class="t16-btn t16-btn-gold t16-submit" id="t16-next" type="button">Tiếp tục →</button>
            </div>
            <div class="t16-step" id="t16-step-2" hidden>
              <p class="t16-picked">Gửi tài liệu tới: <strong id="t16-email-show"></strong> · <button type="button" class="t16-link" id="t16-back">đổi email</button></p>
              <div class="t16-field">
                <label for="t16-name">Họ tên cha mẹ <span aria-hidden="true">*</span></label>
                <input id="t16-name" name="parent_name" type="text" autocomplete="name" required />
              </div>
              <div class="t16-field">
                <label for="t16-phone">Số điện thoại <span aria-hidden="true">*</span></label>
                <input id="t16-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0912 345 678" required />
              </div>
              <div class="t16-hp" aria-hidden="true">
                <label for="t16-website">Website</label>
                <input id="t16-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <button class="t16-btn t16-btn-gold t16-submit" id="t16-submit" type="submit">Gửi tài liệu cho tôi →</button>
            </div>
            <p class="t16-err" id="t16-err" role="alert" hidden></p>
            <p class="t16-under">Bằng việc gửi, bạn đồng ý để Trường Việt Anh dùng thông tin này để gửi tài liệu và liên hệ tư vấn, theo <a href="/chinh-sach-bao-mat" target="_blank" rel="noopener">Chính sách bảo mật</a> và Luật Bảo vệ dữ liệu cá nhân số 91/2025/QH15. Trường không hỏi tên con.</p>
          </form>

          <div class="t16-success" id="t16-success" hidden>
            <p class="t16-success-tick" aria-hidden="true">✓</p>
            <h3 tabindex="-1" id="t16-success-title">Cảm ơn bạn.</h3>
            <p>Tài liệu 16 câu hỏi sẽ được gửi tới email của bạn. Bạn có thể tải ngay bên dưới.</p>
            <a href={PDF_URL} download class="t16-btn t16-btn-gold t16-submit" id="t16-pdf">Tải PDF 16 câu hỏi</a>
            <a href="/school-ready" class="t16-btn t16-btn-outline-navy t16-submit" data-keep-utm>Tìm hiểu chương trình School Ready →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="t16-sec t16-sec-light">
      <div class="t16-narrow">
        <h2 class="t16-center">Câu hỏi thường gặp</h2>
        <FaqAccordion faqs={faqs} />
      </div>
    </section>

    <!-- 9. CTA CUỐI -->
    <section class="t16-final">
      <div class="t16-wide t16-center">
        <h2>Bắt đầu từ 16 câu hỏi, 5 phút thôi</h2>
        <div class="t16-final-row">
          <a href="#nhan-tai-lieu" class="t16-btn t16-btn-navy t16-btn-lg">Nhận tài liệu miễn phí →</a>
          <a href="/school-ready" class="t16-arrow" data-keep-utm>Tìm hiểu chương trình School Ready →</a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>

  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    (function () {
      var FUNNEL = 'squeeze-16-cau-hoi-school-ready';
      var API = '/api/lead';

      // Giữ UTM khi bấm sang /school-ready
      var utmNow = (window.__vaUTM ? window.__vaUTM() : {});
      document.querySelectorAll('a[data-keep-utm]').forEach(function (a) {
        try {
          var u = new URL(a.getAttribute('href'), location.origin);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
            if (utmNow[k] && !u.searchParams.has(k)) u.searchParams.set(k, utmNow[k]);
          });
          u.searchParams.set('src', 'tai-lieu-16-cau');
          a.setAttribute('href', u.pathname + u.search + u.hash);
        } catch (e) {}
      });

      var form = document.getElementById('t16-form');
      if (!form) return;
      var errEl = document.getElementById('t16-err');
      var btn = document.getElementById('t16-submit');
      var step1 = document.getElementById('t16-step-1');
      var step2 = document.getElementById('t16-step-2');
      var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
      var partialSent = '';

      function goStep(n) {
        errEl.hidden = true;
        step1.hidden = n !== 1;
        step2.hidden = n !== 2;
        document.getElementById('t16-dot-1').className = n === 1 ? 't16-fsteps-on' : 't16-fsteps-done';
        document.getElementById('t16-dot-2').className = n === 2 ? 't16-fsteps-on' : '';
        (n === 1 ? form.email : form.parent_name).focus();
      }

      // Bước 1: email. Hợp lệ thì sang bước 2 và gửi partial_capture (giữ được email
      // nếu phụ huynh bỏ dở ở bước 2) — cùng cách LeadFormTwoStepEmailFirst đang làm.
      function nextStep() {
        var email = form.email.value.trim();
        if (!EMAIL_RE.test(email)) return showError('Email chưa đúng. Bạn kiểm tra lại giúp trường nhé.', form.email);
        document.getElementById('t16-email-show').textContent = email;
        goStep(2);
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_step_complete', form_name: 'tai_lieu_16_cau', funnel_code: FUNNEL, step: 1 });
        if (partialSent === email) return;
        partialSent = email;
        try {
          fetch(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.assign({
              step: 'partial_capture',
              email: email,
              source: FUNNEL,
              funnel_code: FUNNEL,
              page: location.href,
              timestamp: new Date().toISOString()
            }, (window.__vaUTM ? window.__vaUTM() : {}))),
            keepalive: true
          }).catch(function () {});
        } catch (err) {}
      }
      document.getElementById('t16-next').addEventListener('click', nextStep);
      document.getElementById('t16-back').addEventListener('click', function () { goStep(1); });

      function showError(msg, el) {
        errEl.textContent = msg;
        errEl.hidden = false;
        if (el && el.focus) el.focus();
      }
      function showSuccess() {
        form.hidden = true;
        var ok = document.getElementById('t16-success');
        ok.hidden = false;
        document.getElementById('t16-formcard').scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('t16-success-title').focus({ preventScroll: true });
      }

      document.getElementById('t16-pdf').addEventListener('click', function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'pdf_download', form_name: 'tai_lieu_16_cau', funnel_code: FUNNEL });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errEl.hidden = true;

        // Enter ở bước 1 = bấm "Tiếp tục"
        if (!step1.hidden) { nextStep(); return; }

        // Bẫy bot: ô ẩn có chữ thì giả vờ thành công, không gửi
        if (form.website.value) { showSuccess(); return; }

        var email = form.email.value.trim();
        if (!EMAIL_RE.test(email)) { goStep(1); return showError('Email chưa đúng. Bạn kiểm tra lại giúp trường nhé.', form.email); }
        var name = form.parent_name.value.trim();
        if (!name) return showError('Bạn cho trường biết họ tên cha mẹ nhé.', form.parent_name);
        var phone = (form.phone.value || '').replace(/[\s\-\.\(\)]/g, '').replace(/^\+?84/, '0');
        if (!/^0[35789][0-9]{8}$/.test(phone)) return showError('Số điện thoại chưa đúng. Bạn nhập số di động Việt Nam 10 số (ví dụ 0912 345 678).', form.phone);

        // Tag đề xuất cho Pancake → ghi vào ghi chú (Pancake không nhận tag qua /api/lead)
        var note = 'Tài liệu 16 câu hỏi School Ready · Tag: School Ready, Tai lieu 16 cau';

        var utm = (window.__vaUTM ? window.__vaUTM() : {});
        var payload = Object.assign({
          fullName: name,
          phone: phone,
          email: email,
          school_level: 'mam-non',
          grade: '5-tuoi',
          source: FUNNEL,
          funnel_code: FUNNEL,
          note: note,
          consent: true,
          page_url: location.href,
          submitted_at: new Date().toISOString()
        }, utm);

        btn.disabled = true;
        var oldText = btn.textContent;
        btn.textContent = 'Đang gửi…';

        fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(Object.assign({
              event: 'form_submit',
              form_name: 'tai_lieu_16_cau',
              funnel_code: FUNNEL
            }, utm));
            showSuccess();
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = oldText;
            errEl.innerHTML = 'Chưa gửi được thông tin. Thông tin bạn nhập vẫn còn nguyên, bạn bấm gửi lại, hoặc nhắn <a href="' + 'https://zalo.me/1678310120468101523' + '" target="_blank" rel="noopener">Zalo OA Trường Việt Anh</a> / gọi <a href="tel:0916961409">0916 961 409</a> để nhận tài liệu ngay.';
            errEl.hidden = false;
          });
      });
    })();
