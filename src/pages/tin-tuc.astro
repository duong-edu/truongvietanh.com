<script is:inline>
(function(){
  var search = document.getElementById('blogSearch');
  var tags = document.querySelectorAll('.blog-filter-tag');
  var cards = document.querySelectorAll('.news-card');
  var activeFilter = 'all';

  function filterCards(){
    var q = (search ? search.value : '').toLowerCase().trim();
    cards.forEach(function(card){
      var title = (card.querySelector('.news-card__title') || {}).textContent || '';
      var excerpt = (card.querySelector('.news-card__excerpt') || {}).textContent || '';
      var text = (title + ' ' + excerpt).toLowerCase();
      var matchSearch = !q || text.includes(q);
      var matchFilter = activeFilter === 'all' || text.includes(activeFilter);
      card.style.display = (matchSearch && matchFilter) ? '' : 'none';
    });
  }

  if(search) search.addEventListener('input', filterCards);

  tags.forEach(function(tag){
    tag.addEventListener('click', function(){
      tags.forEach(function(t){ t.classList.remove('is-active'); });
      tag.classList.add('is-active');
      activeFilter = tag.dataset.filter;
      filterCards();
    });
  });
})();
</script>
