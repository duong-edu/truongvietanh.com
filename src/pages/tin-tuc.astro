---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { readItems } from '@directus/sdk';
import { createCmsClient } from '../lib/directus';

type Post = {
  id: number | string;
  title: string;
  slug: string;
  status?: string | null;
  excerpt?: string | null;
  published_at?: string | null;
};

type DirectusSchema = {
  posts: Post[];
};

let posts: Post[] = [];
let error: string | null = null;

try {
  const client = createCmsClient<DirectusSchema>();
  if (!client) throw new Error('CMS chưa cấu hình');

  posts = await client.request(
    readItems('posts', {
      fields: ['id', 'title', 'slug', 'excerpt', 'published_at'],
      filter: {
        status: { _neq: 'archived' },
      },
      sort: ['-published_at', '-id'],
      limit: 100,
    }),
  );
} catch (e) {
  error = e instanceof Error ? e.message : 'Không thể tải danh sách bài viết.';
}

function formatDate(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    return new Date(dateStr).toLocaleDateString('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return '';
  }
}

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Blog Trường Việt Anh — Tin Tức, Sự Kiện & Kiến Thức Giáo Dục',
    description: 'Cập nhật tin tức, sự kiện và bài viết kiến thức giáo dục từ Trường Việt Anh.',
    url: 'https://truongvietanh.com/tin-tuc',
    image: 'https://media.truongvietanh.com/images/giao-vien-35.webp',
    isPartOf: { '@type': 'WebSite', name: 'Trường Việt Anh', url: 'https://truongvietanh.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang Chủ', item: 'https://truongvietanh.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tin Tức & Sự Kiện', item: 'https://truongvietanh.com/tin-tuc' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Trường Việt Anh có blog hoặc kênh chia sẻ kiến thức giáo dục không?',
        acceptedAnswer: { '@type': 'Answer', text: 'Có. Trường Việt Anh duy trì blog với hơn 500 bài viết về kiến thức giáo dục, kinh nghiệm nuôi dạy con, thông tin tuyển sinh và các sự kiện trường. Nội dung được cập nhật thường xuyên tại truongvietanh.com/tin-tuc.' },
      },
      {
        '@type': 'Question',
        name: 'Làm sao để nhận thông tin mới nhất từ Trường Việt Anh?',
        acceptedAnswer: { '@type': 'Answer', text: 'Phụ huynh có thể theo dõi fanpage Facebook Trường Việt Anh, kênh YouTube, hoặc đăng ký nhận bản tin qua email trên website. Ngoài ra, đội ngũ tuyển sinh sẽ liên hệ trực tiếp khi có sự kiện Open Day, workshop hoặc chương trình ưu đãi.' },
      },
      {
        '@type': 'Question',
        name: 'Trường Việt Anh tổ chức những sự kiện gì trong năm học?',
        acceptedAnswer: { '@type': 'Answer', text: 'Trong năm học, trường tổ chức: Open Day cho phụ huynh tham quan, Hội thao liên cấp, English Day, STEM Fair, Music Show, Lễ tri ân thầy cô, Dã ngoại theo cấp học, và các workshop kỹ năng sống dành cho phụ huynh và học sinh.' },
      },
      { '@type': 'Question', name: 'Blog Trường Việt Anh có chia sẻ kinh nghiệm luyện thi IELTS không?', acceptedAnswer: { '@type': 'Answer', text: 'Có. Blog thường xuyên đăng bài về lộ trình luyện IELTS từ lớp 6 đến lớp 12, mẹo làm bài thi, chia sẻ từ học sinh đạt IELTS 6.0-8.0, và hướng dẫn chuẩn bị hồ sơ du học.' } },
      { '@type': 'Question', name: 'Phụ huynh có thể đóng góp bài viết cho blog Trường Việt Anh không?', acceptedAnswer: { '@type': 'Answer', text: 'Trường khuyến khích phụ huynh chia sẻ câu chuyện, kinh nghiệm và cảm nhận. Gửi bài qua email hoặc liên hệ đội ngũ truyền thông để được hỗ trợ đăng bài.' } },
    ],
  },
];

const faqItems = [
  { question: 'Trường Việt Anh có blog hoặc kênh chia sẻ kiến thức giáo dục không?', answer: 'Có. Trường Việt Anh duy trì blog với hơn 500 bài viết về kiến thức giáo dục, kinh nghiệm nuôi dạy con, thông tin tuyển sinh và các sự kiện trường. Nội dung được cập nhật thường xuyên tại truongvietanh.com/tin-tuc.' },
  { question: 'Làm sao để nhận thông tin mới nhất từ Trường Việt Anh?', answer: 'Phụ huynh có thể theo dõi fanpage Facebook Trường Việt Anh, kênh YouTube, hoặc đăng ký nhận bản tin qua email trên website. Ngoài ra, đội ngũ tuyển sinh sẽ liên hệ trực tiếp khi có sự kiện Open Day, workshop hoặc chương trình ưu đãi.' },
  { question: 'Trường Việt Anh tổ chức những sự kiện gì trong năm học?', answer: 'Trong năm học, trường tổ chức: Open Day cho phụ huynh tham quan, Hội thao liên cấp, English Day, STEM Fair, Music Show, Lễ tri ân thầy cô, Dã ngoại theo cấp học, và các workshop kỹ năng sống dành cho phụ huynh và học sinh.' },
  { question: 'Blog Trường Việt Anh có chia sẻ kinh nghiệm luyện thi IELTS không?', answer: 'Có. Blog thường xuyên đăng bài về lộ trình luyện IELTS từ lớp 6 đến lớp 12, mẹo làm bài thi, chia sẻ từ học sinh đạt IELTS 6.0–8.0, và hướng dẫn chuẩn bị hồ sơ du học cho phụ huynh quan tâm.' },
  { question: 'Phụ huynh có thể đóng góp bài viết cho blog Trường Việt Anh không?', answer: 'Trường Việt Anh khuyến khích phụ huynh chia sẻ câu chuyện, kinh nghiệm và cảm nhận. Phụ huynh có thể gửi bài viết qua email hoặc liên hệ đội ngũ truyền thông trường để được hỗ trợ đăng bài.' },
];
---

<BaseLayout
  title="Blog Trường Việt Anh — Tin Tức, Sự Kiện & Kiến Thức Giáo Dục"
  description="Cập nhật tin tức, sự kiện và bài viết kiến thức giáo dục từ Trường Việt Anh. 552+ bài viết về tuyển sinh, học tập, kỹ năng sống và du học."
  canonical="https://truongvietanh.com/tin-tuc"
  ogImage="https://media.truongvietanh.com/images/giao-vien-35.webp"
  structuredData={structuredData}
>
  <div class="cf-layout page-wrapper">
    <HeaderBase />

    <section class="page-hero">
      <div class="cf-container text-center">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a> <span>/</span> <span>Tin Tức</span>
        </nav>
        <h1 class="page-title">Tin Tức & Sự Kiện Trường Việt Anh</h1>
        <p class="page-desc">Cập nhật thông tin mới nhất về tuyển sinh, sự kiện trường, kiến thức giáo dục và kinh nghiệm nuôi dạy con từ Trường Liên Cấp Việt Anh.</p>
      </div>
    </section>

    <!-- Featured image -->
    <section class="featured-image-section">
      <div class="cf-container">
        <img
          src="https://media.truongvietanh.com/images/giao-vien-35.webp"
          alt="Tin tức và sự kiện Trường Việt Anh — giáo viên và học sinh trong hoạt động giảng dạy"
          loading="eager"
          width="1200"
          height="480"
          style="width:100%;max-height:480px;object-fit:cover;border-radius:12px;"
        />
      </div>
    </section>

    <!-- AIO-friendly intro -->
    <section class="blog-intro">
      <div class="cf-container">
        <p>Blog Trường Việt Anh chia sẻ bài viết về giáo dục, tuyển sinh, sự kiện trường, kỹ năng sống và định hướng du học. Phụ huynh và học sinh có thể tìm thấy thông tin hữu ích về chương trình đào tạo liên cấp, phương pháp giảng dạy hiện đại, cùng kinh nghiệm thực tế từ giáo viên và cựu học sinh Trường Việt Anh.</p>
        <p style="margin-top:0.75rem;">Trường Việt Anh là trường liên cấp từ Mầm Non đến THPT tại TP.HCM, áp dụng chương trình song ngữ Việt – Anh, tích hợp STEM và phát triển kỹ năng toàn diện. Xem thêm: <a href="/gioi-thieu">Giới thiệu</a> | <a href="/cap-hoc">Các cấp học</a> | <a href="/tuyen-sinh">Tuyển sinh</a>.</p>
      </div>
    </section>

    <!-- AIO content: Chủ đề nổi bật -->
    <section class="topic-highlights">
      <div class="cf-container">
        <h2 class="topic-title">Chủ Đề Nổi Bật</h2>
        <div class="topic-grid">
          <a href="/tuyen-sinh" class="topic-card">
            <span class="topic-icon">🎓</span>
            <strong>Tuyển Sinh 2026–2027</strong>
            <span>Thông tin nhập học, lịch thi, ưu đãi Early Bird cho Mầm Non – THPT</span>
          </a>
          <a href="/cap-hoc" class="topic-card">
            <span class="topic-icon">📚</span>
            <strong>Chương Trình Học</strong>
            <span>Song ngữ, SteamE, IELTS tích hợp từ Tiểu Học đến THPT</span>
          </a>
          <a href="/thanh-tich-hoc-tap" class="topic-card">
            <span class="topic-icon">🏆</span>
            <strong>Thành Tích Học Sinh</strong>
            <span>Olympic, IELTS 6.0–8.0, 99% đỗ ĐH nguyện vọng 1, du học thành công</span>
          </a>
          <a href="/ngoai-khoa" class="topic-card">
            <span class="topic-icon">⚽</span>
            <strong>Hoạt Động & Ngoại Khóa</strong>
            <span>20+ CLB thể thao, nghệ thuật, STEM, kỹ năng lãnh đạo và phát triển bản thân</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Blog Search & Filter -->
    <section class="blog-filter-bar">
      <div class="cf-container">
        <div class="blog-filter-inner">
          <div class="blog-search-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="blogSearch" class="blog-search-input" placeholder="Tìm kiếm bài viết..." />
          </div>
          <div class="blog-filter-tags" id="blogFilterTags">
            <button class="blog-filter-tag is-active" data-filter="all">Tất cả</button>
            <button class="blog-filter-tag" data-filter="tuyển sinh">Tuyển sinh</button>
            <button class="blog-filter-tag" data-filter="tiếng anh">Tiếng Anh</button>
            <button class="blog-filter-tag" data-filter="kỹ năng">Kỹ năng</button>
            <button class="blog-filter-tag" data-filter="phụ huynh">Phụ huynh</button>
            <button class="blog-filter-tag" data-filter="sự kiện">Sự kiện</button>
          </div>
        </div>
      </div>
    </section>

    <section class="page-content">
      <div class="cf-container">
        {error && (
          <div class="news-error">
            <p>Không thể tải bài viết: {error}</p>
          </div>
        )}

        {posts.length === 0 && !error && (
          <div class="news-empty">
            <p>Chưa có bài viết nào. Vui lòng quay lại sau.</p>
          </div>
        )}

        {/* Fallback nội dung tĩnh khi API không khả dụng */}
        {(error || posts.length === 0) && (
          <div class="fallback-content">
            <h2 class="fallback-title">Bài Viết Nổi Bật</h2>
            <div class="news-grid">
              <a href="/tuyen-sinh" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">Tuyển sinh năm học 2026–2027: Lịch trình và ưu đãi Early Bird</h3>
                  <p class="news-card__excerpt">Trường Việt Anh mở đợt tuyển sinh sớm với ưu đãi giảm 10–15% học phí cho phụ huynh đăng ký trước 31/03/2026. Tìm hiểu quy trình nhập học từ Mầm Non đến THPT.</p>
                </div>
              </a>
              <a href="/triet-ly-giao-duc" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">Phương pháp PDR: Phẩm chất – Đạo đức – Rèn luyện tại Trường Việt Anh</h3>
                  <p class="news-card__excerpt">Hệ thống giáo dục PDR giúp học sinh phát triển toàn diện cả trí tuệ lẫn nhân cách. Tìm hiểu cách Trường Việt Anh tích hợp 16 kỹ năng thế kỷ 21 vào chương trình học.</p>
                </div>
              </a>
              <a href="/ngoai-khoa" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">20+ câu lạc bộ ngoại khóa: Thể thao, nghệ thuật, STEM và kỹ năng sống</h3>
                  <p class="news-card__excerpt">Từ bóng đá, bơi lội đến robotics, coding — Trường Việt Anh tổ chức đa dạng hoạt động ngoại khóa giúp học sinh khám phá đam mê và phát triển năng khiếu.</p>
                </div>
              </a>
              <a href="/thanh-tich-hoc-tap" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">Thành tích nổi bật: 99% đỗ ĐH nguyện vọng 1, IELTS 6.0–8.0</h3>
                  <p class="news-card__excerpt">Học sinh Trường Việt Anh liên tục đạt thành tích xuất sắc trong các kỳ thi Olympic, IELTS và kỳ thi tốt nghiệp THPT quốc gia. Nhiều em nhận học bổng du học.</p>
                </div>
              </a>
              <a href="/co-so" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">Hệ thống 6 cơ sở: TP.HCM, Tây Ninh, An Giang</h3>
                  <p class="news-card__excerpt">Trường Việt Anh mở rộng hệ thống trường liên cấp với 6 cơ sở tại 3 tỉnh thành. Mỗi cơ sở đều đạt chuẩn về cơ sở vật chất, phòng lab STEM và sân thể thao.</p>
                </div>
              </a>
              <a href="/mam-non" class="news-card">
                <div class="news-card__body">
                  <h3 class="news-card__title">Mầm Non song ngữ: Montessori kết hợp chương trình Việt – Anh</h3>
                  <p class="news-card__excerpt">Chương trình Mầm Non Việt Anh áp dụng phương pháp Montessori, giúp trẻ từ 12 tháng đến 6 tuổi phát triển ngôn ngữ, tư duy và kỹ năng xã hội trong môi trường an toàn.</p>
                </div>
              </a>
            </div>
          </div>
        )}

        {posts.length > 0 && (
          <div class="news-grid">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="news-card">
                <div class="news-card__body">
                  <h2 class="news-card__title">{post.title}</h2>
                  {post.excerpt && <p class="news-card__excerpt">{post.excerpt}</p>}
                  {post.published_at && (
                    <time class="news-card__date" datetime={post.published_at}>
                      {formatDate(post.published_at)}
                    </time>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Nội dung bổ sung: Tại sao theo dõi Trường Việt Anh -->
    <section class="why-follow">
      <div class="cf-container">
        <h2 class="section-title">Tại Sao Phụ Huynh Nên Theo Dõi Blog Trường Việt Anh?</h2>
        <div class="why-grid">
          <div class="why-card">
            <h3>Cập nhật tuyển sinh kịp thời</h3>
            <p>Nhận thông tin sớm nhất về lịch tuyển sinh, ưu đãi Early Bird, và các chương trình học bổng cho năm học 2026–2027. Phụ huynh đăng ký sớm được ưu tiên chọn lớp và giảm học phí.</p>
          </div>
          <div class="why-card">
            <h3>Kiến thức nuôi dạy con khoa học</h3>
            <p>Bài viết chuyên sâu về tâm lý trẻ, phương pháp giáo dục tích cực, kỹ năng giao tiếp cha mẹ – con cái, và cách hỗ trợ con học tập hiệu quả tại nhà từ đội ngũ chuyên gia giáo dục.</p>
          </div>
          <div class="why-card">
            <h3>Sự kiện trường phong phú</h3>
            <p>Lịch các sự kiện Open Day, Hội thao, English Day, STEM Fair, Music Show và workshop kỹ năng sống — để phụ huynh cùng con tham gia trải nghiệm môi trường học tập thực tế.</p>
          </div>
          <div class="why-card">
            <h3>Định hướng học tập & du học</h3>
            <p>Chia sẻ kinh nghiệm luyện thi IELTS, chuẩn bị hồ sơ du học, chọn trường quốc tế và lộ trình học tập từ lớp 6 đến lớp 12 để con đạt mục tiêu đại học trong và ngoài nước.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Internal links -->
    <section class="internal-links">
      <div class="cf-container">
        <h2 class="internal-links__title">Xem thêm về Trường Việt Anh</h2>
        <div class="internal-links__grid">
          <a href="/gioi-thieu" class="internal-links__item">Giới thiệu Trường Việt Anh</a>
          <a href="/tuyen-sinh" class="internal-links__item">Thông tin tuyển sinh</a>
          <a href="/hoc-phi" class="internal-links__item">Học phí các cấp</a>
          <a href="/cap-hoc" class="internal-links__item">Chương trình các cấp học</a>
          <a href="/hinh-anh" class="internal-links__item">Thư viện hình ảnh</a>
          <a href="/thanh-tich-hoc-tap" class="internal-links__item">Thành tích học sinh</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="cf-container">
        <h2 class="section-title">Câu Hỏi Thường Gặp</h2>
        <div class="faq-list">
          {faqItems.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="max-width: 600px; margin: 0 auto 3rem; padding: 0 1.5rem; text-align: center;" data-form-bg="light">
      <h2 style="font-size: 1.4rem; font-weight: 700; color: #26275D; margin-bottom: 0.5rem;">Đăng ký nhận tư vấn cá nhân hóa lộ trình học tập</h2>
      <p style="color: #64748b; margin-bottom: 1.5rem; font-size: 1rem;">Tìm hiểu chương trình phù hợp cho con — phản hồi trong 24 giờ</p>
      <LeadFormTwoStepEmailFirst
        formId="tin-tuc-form"
        funnelCode="blog-listing"
        schoolLevel="lien-cap"
        submitText="Nhận tư vấn"
      />
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style>.cf-container{ max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }.text-center{ text-align: center; }.breadcrumb{
    font-size: 1rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.6);
