---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('trung-hoc-co-so');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường THCS Việt Anh",
    "alternateName": "Trường Trung Học Cơ Sở Song Ngữ Việt Anh",
    "url": "https://truongvietanh.com/trung-hoc-co-so",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Trường THCS Việt Anh tại TP.HCM: chương trình song ngữ, lộ trình IELTS, 16 kỹ năng thế kỷ 21, Leader in Me. Lựa chọn hàng đầu khi chuyển cấp lớp 6.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"],
    "educationalLevel": "Middle School",
    "teaches": ["Bilingual Education", "IELTS Preparation", "STEM", "Coding", "Leadership", "Debate"],
    "offers": { "@type": "Offer", "category": "THCS Song Ngữ", "price": "9000000", "priceCurrency": "VND", "priceValidUntil": "2027-08-31", "description": "Học phí THCS từ 9-11 triệu VND/tháng" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gi-h1", ".gi-subtitle"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Chương trình chuyển cấp lớp 6 tại Trường Việt Anh như thế nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh có chương trình chuyển cấp toàn diện cho học sinh vào lớp 6: test đầu vào đánh giá năng lực tiếng Anh và toán, hỗ trợ tâm lý thích nghi môi trường mới, chương trình orientation 2 tuần đầu, và mentor 1-1 giúp học sinh hoà nhập nhanh chóng." }
      },
      {
        "@type": "Question",
        "name": "Lớp THCS Việt Anh bao nhiêu học sinh?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sĩ số lớp THCS tại Trường Việt Anh 24 học sinh/lớp. Mỗi lớp có 1 giáo viên chủ nhiệm và các giáo viên bộ môn chuyên trách. Tỷ lệ giáo viên bản ngữ đảm bảo mỗi tuần học sinh có ít nhất 15 tiết học bằng tiếng Anh." }
      },
      {
        "@type": "Question",
        "name": "Học sinh THCS Việt Anh đạt IELTS mấy điểm?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mục tiêu IELTS cho học sinh THCS Việt Anh: lớp 6-7 đạt trình độ B1 (tương đương IELTS 4.0-4.5), lớp 8-9 đạt trình độ B2 (tương đương IELTS 5.0-5.5). Nhiều học sinh xuất sắc đạt IELTS 6.0+ cuối lớp 9, sẵn sàng cho chương trình IELTS nâng cao ở THPT." }
      },
      {
        "@type": "Question",
        "name": "Trường THCS Việt Anh có xe đưa rước không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Hệ thống xe đưa rước phủ khắp Gò Vấp, Phú Nhuận, Bình Thạnh, Tân Bình và nhiều quận khác tại TP.HCM. Xe trang bị camera giám sát, GPS thời gian thực và phụ xe chuyên trách." }
      },
      {
        "@type": "Question",
        "name": "THCS Việt Anh có những hoạt động ngoại khoá nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hoạt động ngoại khoá THCS bao gồm: CLB tiếng Anh (debate, public speaking, drama), CLB STEM (coding, robotics, science fair), CLB thể thao (bóng rổ, bóng đá, bơi lội, cầu lông), CLB nghệ thuật (âm nhạc, mỹ thuật, nhảy hiện đại), và các dự án cộng đồng hàng quý." }
      },
      {
        "@type": "Question",
        "name": "Nếu con rớt lớp 10 công lập thì sao?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học sinh THCS Việt Anh có lợi thế lớn khi thi tuyển sinh lớp 10: nền tảng tiếng Anh tốt hơn (IELTS 5.0-6.0), tư duy logic từ chương trình STEM, và kỹ năng làm bài thi bài bản. Ngoài ra, Trường Việt Anh có hệ thống THPT liên cấp — học sinh THCS được ưu tiên xét tuyển thẳng lên THPT Việt Anh mà không cần thi tuyển." }
      },
      {
        "@type": "Question",
        "name": "Trường THCS Việt Anh có chính sách học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Từ năm học 2026–2027, học sinh THCS Việt Anh giành học bổng trong quá trình học chứ không xét theo điểm test đầu vào: GRIT thưởng chuỗi tự học đều đặn mỗi ngày, CHAMPIONS 2–20 triệu đồng cho học sinh đạt giải thi đấu, LEADERS 10 triệu đồng mỗi suất cho học sinh cho đi và dẫn dắt. TALENTS dành cho học sinh ngoài trường từ lớp 6, mỗi tỉnh đúng một suất, 25–100 triệu đồng. Gia đình còn được ưu đãi học phí: đóng trọn năm giảm 6%, anh chị em ruột giảm 50% cho con thứ hai. Chi tiết tại truongvietanh.com/hoc-bong." }
      },
      { "@type": "Question", "name": "THCS Việt Anh có dạy lập trình và thi Olympic không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Từ lớp 6 học Python, Robotics, STEM thực tế. Đội tuyển Olympic Toán, Khoa học, Tiếng Anh thi cấp quận, thành phố, quốc gia. 30+ giải thưởng mỗi năm." } },
      { "@type": "Question", "name": "Học sinh THCS Việt Anh tốt nghiệp đi đâu?", "acceptedAnswer": { "@type": "Answer", "text": "85% lên THPT Việt Anh (liên cấp). Số còn lại vào trường chuyên hoặc trường quốc tế. Nền tảng tiếng Anh B1-B2 giúp học sinh luôn có lợi thế cạnh tranh." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Chương trình", "item": "https://truongvietanh.com/gioi-thieu" },
      { "@type": "ListItem", "position": 3, "name": "THCS", "item": "https://truongvietanh.com/trung-hoc-co-so" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Trường THCS Việt Anh – Song Ngữ, IELTS &amp; Lãnh Đạo"}
  description={cmsPage?.description || "Trường THCS Việt Anh TP.HCM: song ngữ, IELTS, 16 kỹ năng thế kỷ 21, Leader in Me. Lựa chọn hàng đầu chuyển cấp lớp 6. Đăng ký tham quan."}
  canonical="https://truongvietanh.com/trung-hoc-co-so"
  ogImage="https://media.truongvietanh.com/images/extra-20230311-DSC08612-scaled.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="/gioi-thieu">Chương trình</a>
            <span aria-hidden="true">/</span>
            <span>THCS</span>
          </nav>

          <h1 class="gi-h1">Trường THCS Việt Anh: Phát Triển Toàn Diện, Sẵn Sàng Tương Lai</h1>
          <p class="gi-subtitle">Chương trình song ngữ — Lộ trình IELTS — Kỹ năng lãnh đạo Franklin Covey</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>


          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>Song ngữ</strong> Bộ GD + UK</div>
            <div class="gi-badge"><strong>IELTS</strong> B1-B2</div>
            <div class="gi-badge"><strong>16</strong> Kỹ năng TK21</div>
            <div class="gi-badge"><strong>7-10tr</strong> /tháng</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tham quan trường THCS miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="thcs-form"
              funnelCode="thcs-pillar"
              schoolLevel="thcs"
            />
          </div>
        </div>
      </div>
    </section>

    <img src="https://media.truongvietanh.com/images/giao-vien-16.webp" alt="Học sinh THCS Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#khac-biet">Chương trình khác biệt</a></li>
          <li><a href="#tieng-anh-ielts">Lộ trình IELTS</a></li>
          <li><a href="#chuyen-cap">Chuyển cấp lớp 6</a></li>
          <li><a href="#lanh-dao">Kỹ năng lãnh đạo</a></li>
          <li><a href="#hoc-phi">Học phí THCS</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#thcs-form-thcs-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Chương trình THCS khác biệt -->
        <section id="khac-biet" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Chương trình THCS tại Trường Việt Anh có gì khác biệt?</h2>
          <p>Chương trình THCS tại Trường Việt Anh được xây dựng trên nền tảng <strong>song ngữ kết hợp chương trình Bộ Giáo dục Việt Nam và UK Curriculum</strong>. Học sinh không chỉ hoàn thành đầy đủ chương trình chuẩn quốc gia mà còn được tiếp cận phương pháp giảng dạy quốc tế, phát triển tư duy phản biện và kỹ năng giải quyết vấn đề từ giai đoạn trung học cơ sở.</p>
          <p>Khác với nhiều trường THCS chỉ dạy tiếng Anh như một môn học, tại Việt Anh <strong>tiếng Anh là ngôn ngữ giảng dạy</strong> cho hàng loạt môn học quan trọng: Khoa học, Toán nâng cao, STEM, Coding và các môn kỹ năng. Điều này giúp học sinh không chỉ giỏi tiếng Anh mà còn thành thạo tiếng Anh học thuật — nền tảng thiết yếu cho kỳ thi IELTS và du học tương lai.</p>
          <p>Chương trình THCS Việt Anh tích hợp 4 trụ cột chính: <strong>Học thuật song ngữ</strong> (chương trình Bộ GD + UK Curriculum), <strong>Tiếng Anh hướng IELTS</strong> (lộ trình rõ ràng từ lớp 6 đến lớp 9), <strong>STEM và Coding</strong> (tư duy logic, lập trình, dự án thực hành), và <strong>Kỹ năng lãnh đạo</strong> (Leader in Me nâng cao, Student Council, dự án cộng đồng). Bốn trụ cột này tạo thành một hệ sinh thái giáo dục hoàn chỉnh, giúp học sinh THCS phát triển toàn diện và sẵn sàng cho bất kỳ lựa chọn nào ở bậc THPT.</p>
          <p>Đặc biệt, chương trình THCS Việt Anh đưa <strong>Debate (tranh biện)</strong> và <strong>Public Speaking (thuyết trình)</strong> vào chương trình chính khoá. Đây không phải là hoạt động ngoại khoá tuỳ chọn mà là môn học bắt buộc — giúp mọi học sinh đều được rèn kỹ năng lập luận, phản biện và trình bày ý tưởng một cách mạch lạc bằng cả tiếng Anh và tiếng Việt.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>15+</strong>
              <span>Tiết tiếng Anh mỗi tuần</span>
            </div>
            <div class="gi-evidence-item">
              <strong>B1-B2</strong>
              <span>Trình độ IELTS mục tiêu</span>
            </div>
            <div class="gi-evidence-item">
              <strong>24</strong>
              <span>Học sinh mỗi lớp</span>
            </div>
            <div class="gi-evidence-item">
              <strong>16</strong>
              <span>Kỹ năng thế kỷ 21</span>
            </div>
          </div>

          <p>Chương trình STEM tại THCS Việt Anh bao gồm 3 mảng chính: <strong>Coding</strong> (Scratch cho lớp 6, Python cho lớp 7-8, dự án ứng dụng cho lớp 9), <strong>Robotics</strong> (lắp ráp và lập trình robot, tham gia các cuộc thi robotics cấp thành phố), và <strong>Science Fair</strong> (dự án khoa học hàng năm với đề tài do chính học sinh đề xuất và thực hiện). Tất cả các hoạt động STEM đều được giảng dạy bằng tiếng Anh, giúp học sinh vừa phát triển tư duy logic vừa nâng cao vốn tiếng Anh chuyên ngành.</p>
          <p>Mỗi học kỳ, học sinh THCS tham gia ít nhất 1 dự án liên môn (Project-Based Learning) kéo dài 4-6 tuần. Ví dụ: dự án "Smart City" yêu cầu học sinh kết hợp kiến thức Toán, Khoa học, Coding và tiếng Anh để thiết kế mô hình thành phố thông minh. Kết quả được trình bày trước hội đồng giáo viên và phụ huynh bằng tiếng Anh — rèn kỹ năng thuyết trình, làm việc nhóm và tư duy tổng hợp.</p>
        </section>

        <!-- Section 2: Lộ trình tiếng Anh IELTS -->
        <section id="tieng-anh-ielts" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Lộ trình tiếng Anh THCS hướng tới IELTS như thế nào?</h2>
          <p>Tại Trường THCS Việt Anh, tiếng Anh không chỉ là một môn học mà là <strong>công cụ học tập và giao tiếp hàng ngày</strong>. Chương trình tiếng Anh THCS được thiết kế với lộ trình rõ ràng từ lớp 6 đến lớp 9, kết hợp phát triển cả 4 kỹ năng: Nghe - Nói - Đọc - Viết, hướng tới mục tiêu B1-B2 theo khung CEFR (tương đương <a href="https://www.ielts.org" target="_blank" rel="noopener">IELTS</a> 4.5-5.5) cuối lớp 9. Lộ trình này kết hợp chuẩn đánh giá của Oxford International để đảm bảo chất lượng đầu ra quốc tế.</p>

          <p>Lộ trình tiếng Anh THCS Việt Anh chia thành 2 giai đoạn chính: <strong>Giai đoạn 1 (lớp 6-7)</strong> tập trung xây dựng nền tảng giao tiếp tự tin và tiếng Anh học thuật cơ bản; <strong>Giai đoạn 2 (lớp 8-9)</strong> nâng cao kỹ năng viết luận, đọc hiểu học thuật và chuẩn bị trực tiếp cho kỳ thi IELTS tại THPT.</p>

          <div class="gi-roadmap">
            <h3>Lộ trình tiếng Anh 4 năm THCS hướng IELTS</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L6</div>
                <strong>Lớp 6 — Nền tảng giao tiếp</strong>
                <p>Củng cố 4 kỹ năng cơ bản, mở rộng vốn từ vựng học thuật. Học sinh làm quen với đọc hiểu văn bản dài và viết đoạn văn 100-150 từ. Mục tiêu: A2+ theo CEFR. Các môn Khoa học và STEM được dạy bằng tiếng Anh, giúp học sinh tiếp xúc tiếng Anh chuyên ngành ngay từ đầu cấp.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L7</div>
                <strong>Lớp 7 — Giao tiếp và học thuật</strong>
                <p>Phát triển kỹ năng thuyết trình bằng tiếng Anh, viết bài luận ngắn (200-250 từ), đọc hiểu bài báo và văn bản khoa học. Mục tiêu: B1 theo CEFR (tương đương IELTS 4.0-4.5). Bắt đầu tham gia debate bằng tiếng Anh với chủ đề phù hợp lứa tuổi.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L8</div>
                <strong>Lớp 8 — Nâng cao và phản biện</strong>
                <p>Viết luận phân tích 300+ từ, đọc hiểu văn bản học thuật, thảo luận và debate chủ đề phức tạp. Mục tiêu: B1+ theo CEFR (tương đương IELTS 4.5-5.0). Học sinh bắt đầu làm quen với dạng bài IELTS Reading và Listening thông qua các bài kiểm tra mock test hàng tháng.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L9</div>
                <strong>Lớp 9 — Chuẩn bị IELTS</strong>
                <p>Hoàn thiện 4 kỹ năng ở trình độ B2, viết luận 400+ từ, đọc hiểu tài liệu học thuật phức tạp. Mục tiêu: B2 theo CEFR (tương đương IELTS 5.0-5.5). Học sinh xuất sắc có thể đạt IELTS 6.0+, sẵn sàng cho chương trình IELTS nâng cao ở THPT hướng tới 6.5-7.5.</p>
              </div>
            </div>
          </div>

          <p>Điểm khác biệt quan trọng trong chương trình tiếng Anh THCS Việt Anh là <strong>học tiếng Anh qua nội dung thực tế</strong> (Content-Based Instruction). Thay vì chỉ học ngữ pháp và từ vựng rời rạc, học sinh sử dụng tiếng Anh để học Khoa học, thảo luận về các vấn đề xã hội, nghiên cứu dự án STEM và trình bày ý tưởng trước lớp. Phương pháp này giúp tiếng Anh trở thành kỹ năng sống thực sự, không chỉ là môn thi trên giấy.</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Tiếng Anh THCS Việt Anh vs Trường công lập vs Trung tâm IELTS</h3>
            <div class="gi-table-responsive">
