---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import TestimonialVideoGrid from '../components/TestimonialVideoGrid.astro';
import { videoTestimonials } from '../data/testimonials-video';
import { getTestimonials } from '../lib/directus';

// Fetch testimonials from Directus CMS
const cmsTestimonials = await getTestimonials();

// Thư tay phụ huynh đóng khung gửi nhà trường (5/2026)
const letterTestimonials = [
  {
    image: '/thu-cam-on-12c1-ntt-1.jpg',
    alt: 'Thư cảm ơn viết tay đóng khung gửi cô chủ nhiệm và giáo viên bộ môn lớp 12C1 — Trường Việt Anh',
    title: 'Một chặng đường — Vạn lời tri ân',
    quote:
      'Với riêng cô chủ nhiệm Nguyễn Thị Kim Tiền, tôi luôn cảm nhận được sự quan tâm rất cụ thể và tinh tế từ cô — từ việc theo dõi quá trình học tập, nhắc nhở kịp thời, đến những lời động viên đúng lúc khi con gặp áp lực hay chưa ổn định về tinh thần. Chính sự đồng hành ấy đã giúp con tôi trưởng thành hơn rất nhiều trong năm học quan trọng này.',
    sender: 'Phụ huynh Lê Ngọc Quỳnh Đào',
    role: 'Phụ huynh học sinh lớp 12C1 · THPT Việt Anh',
    recipient: 'Gửi cô chủ nhiệm Nguyễn Thị Kim Tiền, cô Nguyễn Thị Diệu và quý thầy/cô dạy bộ môn lớp 12C1',
  },
  {
    image: '/thu-cam-on-12c1-ntt-2.jpg',
    alt: 'Thư cảm ơn viết tay đóng khung gửi Ban Giám hiệu, cô Hiệu phó Nguyễn Thu Thảo và giáo viên Trường Việt Anh',
    title: 'Dưới mái trường này — Con lớn lên trong những yêu thương thầm lặng',
    quote:
      'Xin cảm ơn nhà trường đã luôn xây dựng một môi trường học tập nghiêm túc nhưng giàu yêu thương, nơi các con không chỉ tiếp thu tri thức mà còn được nuôi dưỡng nhân cách và ước mơ. Đặc biệt, chúng tôi xin tri ân sâu sắc đến cô Hiệu phó Nguyễn Thu Thảo — người luôn lặng lẽ quan tâm, theo dõi và hỗ trợ học sinh bằng tất cả sự tận tâm và trách nhiệm.',
    sender: 'Phụ huynh Lê Ngọc Quỳnh Dao',
    role: 'Phụ huynh học sinh lớp 12C1 · THPT Việt Anh',
    recipient: 'Gửi Ban Giám hiệu, cô Hiệu phó Nguyễn Thu Thảo, cô chủ nhiệm và thầy Giám thị',
  },
  {
    image: '/thu-cam-on-11a1-phu-nhuan.jpg',
    alt: 'Thư cảm ơn gửi cô Thảo — Phó Hiệu trưởng kiêm giáo viên Ngữ văn Trường Việt Anh, từ phụ huynh học sinh lớp 11A1',
    title: '"Tất cả vì học sinh thân yêu"',
    quote:
      'Dù bận rộn với công tác quản lý trên cương vị Phó Hiệu trưởng, cô Thảo vẫn dành trọn tâm huyết của một người giáo viên Ngữ văn để kèm cặp, ôn tập và bổ sung kịp thời những phần kiến thức còn thiếu cho con. Nhờ phương pháp giảng dạy khoa học, sự kiên nhẫn và tấm lòng yêu thương học trò của cô, con tôi đã có sự tiến bộ vượt bậc và đạt được kết quả rất tốt trong kỳ thi vừa qua.',
    sender: 'Phụ huynh Nguyễn Thị Ngọc Hân',
    role: 'Phụ huynh em Nguyễn Ngọc Minh Anh · Lớp 11A1 · Trường Việt Anh',
    recipient: 'Gửi Ban Giám hiệu, cô Thảo — Phó Hiệu trưởng & GV Ngữ văn, cô chủ nhiệm lớp 11A1',
  },
];

// Fallback testimonials nếu CMS trống
const fallbackTestimonials = [
  {
    name: 'Chị Phạm Thuỳ Dung',
    role: 'Phụ huynh bé lớp 3 · Cơ sở Gò Vấp',
    quote: 'Tôi chọn Trường Việt Anh vì con được học tiếng Anh chuẩn mà học phí chỉ bằng 1/3 trường quốc tế. Sau 2 năm, bé đã tự tin nói chuyện với giáo viên nước ngoài. Gia đình rất hài lòng.',
    initials: 'PD',
    stars: 5,
  },
  {
    name: 'Anh Nguyễn Hoàng Minh',
    role: 'Phụ huynh bé lớp 7 · Cơ sở Bình Tân',
    quote: 'Điều tôi ấn tượng nhất là chương trình Leader in Me. Con trai tôi từ một đứa nhút nhát, giờ dám đứng lên thuyết trình trước cả trường. Sự thay đổi rõ rệt chỉ sau 1 học kỳ.',
    initials: 'HM',
    stars: 5,
  },
  {
    name: 'Chị Mai',
    role: 'Mẹ học sinh lớp 3 · Tiểu học',
    quote: 'Những gì mà lúc đầu thầy cô tư vấn cho chị thì sau 2 năm, chị thấy là đều có trong chương trình học của con hết. Sự cam kết của trường rất rõ ràng.',
    initials: 'M',
    stars: 5,
  },
  {
    name: 'Anh Quốc Long',
    role: 'Phụ huynh có nhiều con theo học',
    quote: 'Bé có những sở thích như coi điện thoại hay chơi game nhưng bé tự mình điều tiết nó, không có quá sa đà vào nó. Con đã tự kỷ luật rõ rệt.',
    initials: 'QL',
    stars: 5,
  },
  {
    name: 'Chị Kim Trinh',
    role: 'Phụ huynh Tiểu học',
    quote: 'Cô giáo cũng đồng cảm, cũng chia sẻ và giúp cho mình làm sao để mình có thể gần con hơn. Tôi cảm nhận được sự quan tâm thật sự.',
    initials: 'KT',
    stars: 5,
  },
  {
    name: 'Chị Hoàng Diễm',
    role: 'Phụ huynh có 2 con theo học',
    quote: 'Trường Việt Anh luôn luôn cải tiến chương trình học và cập nhật kiến thức. Các con tôi được học những gì mới nhất và phù hợp với thời đại.',
    initials: 'HD',
    stars: 5,
  },
  {
    name: 'Em Gia Bảo',
    role: 'Học sinh lớp 11 · IELTS 7.0',
    quote: 'Nhờ có chương trình luyện IELTS tại trường, em không cần học thêm ở trung tâm nào mà vẫn đạt 7.0. Thầy cô tận tâm, bạn bè cùng quyết tâm luyện đề mỗi ngày.',
    initials: 'GB',
    stars: 5,
  },
];

const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({
      name: t.name,
      role: t.role,
      quote: t.quote,
      initials: t.initials || t.name?.split(' ').slice(-2).map((w: string) => w[0]).join('').toUpperCase() || 'VA',
      stars: 5,
    }))
  : fallbackTestimonials;

const totalReviews = testimonials.length + videoTestimonials.length;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
  },
  ...videoTestimonials.map(t => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: t.shortQuote,
    description: t.longQuote,
    thumbnailUrl: `https://i.ytimg.com/vi/${t.videoId}/hqdefault.jpg`,
    uploadDate: '2025-01-01',
    contentUrl: `https://www.youtube.com/watch?v=${t.videoId}`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${t.videoId}`,
    publisher: {
      '@type': 'Organization',
      name: 'Trường Liên Cấp Việt Anh',
      logo: { '@type': 'ImageObject', url: 'https://truongvietanh.com/logo-crest-80.webp' },
    },
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Đánh giá phụ huynh', item: 'https://truongvietanh.com/danh-gia-cua-phu-huynh' },
    ],
  },
];
---

<BaseLayout
  title="Đánh giá từ phụ huynh & học sinh | Trường Việt Anh"
  description="Tổng hợp 30+ video chia sẻ thực tế từ phụ huynh và học sinh Trường Việt Anh — quay tại trường, không dàn dựng. Hơn 3.000 gia đình đang đồng hành, đánh giá 4.9/5."
  canonical="https://truongvietanh.com/danh-gia-cua-phu-huynh"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="dg-page">
    <HeaderBase />

    <!-- HERO -->
    <section class="dg-hero">
      <div class="dg-hero__deco" aria-hidden="true"></div>
      <div class="dg-container dg-hero__inner">
        <nav class="dg-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <span>Đánh giá phụ huynh</span>
        </nav>
        <span class="dg-eyebrow">★ Đánh giá thực tế từ cộng đồng phụ huynh</span>
        <h1 class="dg-h1">Phụ huynh & học sinh nói gì<br/>về <span class="dg-h1__hl">Trường Việt Anh</span>?</h1>
        <p class="dg-sub">Hơn <strong>3.000 gia đình</strong> đang đồng hành cùng Trường Việt Anh. Dưới đây là những chia sẻ thực tế — quay tại trường, không dàn dựng.</p>

        <div class="dg-stats">
          <div class="dg-stat">
            <div class="dg-stat__num">1.000<span>+</span></div>
            <div class="dg-stat__label">Gia đình đang đồng hành</div>
          </div>
          <div class="dg-stat">
            <div class="dg-stat__num"><span class="dg-stat__stars">★</span> 4.9<span>/5</span></div>
            <div class="dg-stat__label">Trên {totalReviews}+ đánh giá</div>
          </div>
          <div class="dg-stat">
            <div class="dg-stat__num">{videoTestimonials.length}<span>+</span></div>
            <div class="dg-stat__label">Video chia sẻ thực tế</div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIDEO TESTIMONIALS -->
    <TestimonialVideoGrid />

    <!-- THƯ CẢM ƠN VIẾT TAY -->
    <section class="dg-letters" aria-labelledby="dg-letters-h">
      <div class="dg-container">
        <header class="dg-letters__head">
          <span class="dg-letters__eyebrow">✉ Thư cảm ơn từ phụ huynh</span>
          <h2 id="dg-letters-h" class="dg-letters__h2">Khi phụ huynh gửi thư <span class="dg-letters__hl">cảm ơn thầy cô</span></h2>
          <p class="dg-letters__sub">
            Những lá thư phụ huynh đích thân viết gửi đến Ban Giám hiệu, thầy cô chủ nhiệm và giáo viên bộ môn Trường Việt Anh — minh chứng chân thật nhất, không thể dàn dựng, không thể đặt hàng.
          </p>
        </header>

        <div class="dg-letters__grid">

          <!-- THƯ 1 -->
          <article class="dg-letter">
            <div class="dg-letter__header">
              <div class="dg-letter__date">THPT Việt Anh · 05/2026</div>
              <h3 class="dg-letter__title">Một Chặng Đường — Vạn Lời Tri Ân</h3>
            </div>
            <div class="dg-letter__recipient">
              <strong>Kính gửi:</strong>
              Cô chủ nhiệm lớp 12C1 — Nguyễn Thị Kim Tiền &amp; Nguyễn Thị Diệu<br/>
              Quý Thầy/Cô dạy bộ môn Lớp 12C1
            </div>
            <div class="dg-letter__body">
              <p class="dg-letter__para">Là phụ huynh học sinh lớp 12C1, tôi viết những dòng này với tất cả sự trân trọng và lòng biết ơn sâu sắc dành cho quý thầy cô — những người đã đồng hành, dìu dắt và nâng đỡ các con trong suốt năm học đầy ý nghĩa vừa qua.</p>
              <p class="dg-letter__para--hl">Với riêng cô chủ nhiệm Nguyễn Thị Kim Tiền, tôi luôn cảm nhận được sự quan tâm rất cụ thể và tinh tế — từ việc theo dõi quá trình học tập, nhắc nhở kịp thời, đến những lời động viên đúng lúc khi con gặp áp lực hay chưa ổn định về tinh thần. Chính sự đồng hành ấy đã giúp con tôi trưởng thành hơn rất nhiều trong năm học quan trọng này.</p>
              <p class="dg-letter__para">Bên cạnh đó, chúng tôi cũng xin gửi lời tri ân sâu sắc đến Quý Thầy Cô bộ môn dạy lớp 12C1. Mỗi thầy cô đều đã dành rất nhiều tâm huyết trong từng tiết dạy, không chỉ giúp các con nắm vững kiến thức mà còn khơi gợi sự hứng thú và ý thức tự học.</p>
              <p class="dg-letter__para">Thời gian học dưới mái trường Việt Anh sẽ trở thành một phần ký ức đẹp của các con và với gia đình chúng tôi, đó cũng là một hành trình đầy yên tâm và biết ơn.</p>
            </div>
            <div class="dg-letter__footer">
              <div class="dg-letter__closing">Xin chân thành tri ân và cảm ơn.</div>
              <div class="dg-letter__sender">Lê Ngọc Quỳnh Đào</div>
              <div class="dg-letter__role">Phụ huynh học sinh lớp 12C1 · THPT Việt Anh</div>
            </div>
            <a href="/thu-cam-on-12c1-ntt-1.jpg" target="_blank" rel="noopener" class="dg-letter__thumb">
              <img src="/thu-cam-on-12c1-ntt-1.jpg" alt="Thư đóng khung gốc phụ huynh gửi cô chủ nhiệm 12C1" loading="lazy" decoding="async" />
              <span class="dg-letter__thumb-text"><strong>📄 Xem thư gốc</strong>Bức thư đóng khung phụ huynh gửi tặng nhà trường</span>
            </a>
          </article>

          <!-- THƯ 2 -->
          <article class="dg-letter">
            <div class="dg-letter__header">
              <div class="dg-letter__date">THPT Việt Anh · 05/2026</div>
              <h3 class="dg-letter__title">Dưới Mái Trường Này — Con Lớn Lên Trong Những Yêu Thương Thầm Lặng</h3>
            </div>
            <div class="dg-letter__recipient">
              <strong>Kính gửi:</strong>
              Ban Giám hiệu · Cô Hiệu phó Nguyễn Thu Thảo<br/>
              Cô chủ nhiệm lớp 12C1 — Nguyễn Thị Kim Tiền &amp; Nguyễn Thị Diệu · Thầy Giám thị
            </div>
            <div class="dg-letter__body">
              <p class="dg-letter__para">Khi những ngày cuối của năm học lớp 12 khép lại, trong lòng mỗi phụ huynh chúng tôi là một khoảng lặng đầy xúc động. Nhìn các con trưởng thành hơn từng ngày, chúng tôi không chỉ cảm nhận niềm vui mà còn là lòng biết ơn sâu sắc gửi đến những người đã âm thầm đồng hành trong suốt hành trình ấy.</p>
              <p class="dg-letter__para--hl">Đặc biệt, chúng tôi xin tri ân sâu sắc đến cô Hiệu phó Nguyễn Thu Thảo — người luôn lặng lẽ quan tâm, theo dõi và hỗ trợ học sinh bằng tất cả sự tận tâm và trách nhiệm. Những lời động viên kịp thời và sự sẻ chia chân thành của cô đã trở thành điểm tựa tinh thần quý giá đối với cả học sinh và phụ huynh trong suốt chặng đường vừa qua.</p>
              <p class="dg-letter__para">Xin gửi lời biết ơn chân thành đến cô chủ nhiệm lớp 12C1 — người đã dành trọn tâm huyết, sự kiên nhẫn và tình yêu thương để đồng hành cùng các con trong năm học cuối cấp nhiều áp lực. Nhờ sự dẫn dắt của các cô, các con không chỉ tiến bộ trong học tập mà còn trưởng thành hơn, sống trách nhiệm hơn và vững vàng hơn trước tương lai.</p>
              <p class="dg-letter__para">Chúng tôi cũng xin trân trọng cảm ơn thầy Giám thị — người luôn âm thầm giữ gìn nề nếp, kỷ luật và sự an toàn cho học sinh mỗi ngày.</p>
            </div>
            <div class="dg-letter__footer">
              <div class="dg-letter__closing">Gia đình chúng tôi xin gửi trọn lòng biết ơn và sự tri ân sâu sắc nhất.</div>
              <div class="dg-letter__sender">Lê Ngọc Quỳnh Dao</div>
              <div class="dg-letter__role">Phụ huynh học sinh lớp 12C1 · THPT Việt Anh</div>
            </div>
            <a href="/thu-cam-on-12c1-ntt-2.jpg" target="_blank" rel="noopener" class="dg-letter__thumb">
              <img src="/thu-cam-on-12c1-ntt-2.jpg" alt="Thư đóng khung gốc phụ huynh gửi Ban Giám hiệu" loading="lazy" decoding="async" />
              <span class="dg-letter__thumb-text"><strong>📄 Xem thư gốc</strong>Bức thư đóng khung phụ huynh gửi tặng nhà trường</span>
            </a>
          </article>

          <!-- THƯ 3 -->
          <article class="dg-letter">
            <div class="dg-letter__header">
              <div class="dg-letter__date">TP. Hồ Chí Minh, ngày 19 tháng 05 năm 2026</div>
              <h3 class="dg-letter__title">Thư Cảm Ơn</h3>
            </div>
            <div class="dg-letter__recipient">
              <strong>Kính gửi:</strong>
              Ban Giám Hiệu Trường Việt Anh<br/>
              Cô Thảo — Phó Hiệu Trưởng, đồng thời là Giáo Viên Ngữ Văn<br/>
              Cô giáo Chủ nhiệm lớp 11A1
            </div>
            <div class="dg-letter__body">
              <p class="dg-letter__para">Tôi tên là Nguyễn Thị Ngọc Hân — phụ huynh của em Nguyễn Ngọc Minh Anh, lớp 11A1 tại Trường Việt Anh. Tôi viết thư này với mong muốn được bày tỏ lòng biết ơn sâu sắc từ gia đình đối với sự đồng hành của Ban Giám hiệu, Cô giáo Chủ nhiệm và đặc biệt là của Cô Thảo.</p>
