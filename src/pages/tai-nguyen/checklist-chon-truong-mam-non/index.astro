---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Checklist Chọn Trường Mầm Non Song Ngữ — 15 Tiêu Chí + Framework 5C | Trường Việt Anh"
  description="Tải miễn phí checklist 15 tiêu chí + Framework 5C giúp ba mẹ đánh giá bất kỳ trường mầm non song ngữ nào một cách khách quan, không lo chọn sai. Mang đi tham quan, tick ngay trên điện thoại."
  canonical="https://truongvietanh.com/tai-nguyen/checklist-chon-truong-mam-non"
  ogImage="https://media.truongvietanh.com/images/phu-huynh-05.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/mam-non-banner-chinh-1.jpg"
  programCode="checklist-mn"
  schoolLevel="mau-non"
  logoSrc="/logo-mam-non-trans.png"
  logoAlt="Trường Mầm Non Việt Anh"
  heroVariant="white-form"
>

  <!-- HERO — 2 cột: nội dung trái · form nhận checklist phải (điền ngay, không phải cuộn) -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">📋 MIỄN PHÍ · CHO BA MẸ CÓ CON 2–5 TUỔI</span>
      <h1>
        Giúp ba mẹ chọn đúng trường mầm non song ngữ cho con
        <span class="mn-sub" style="color:#f9dd0e;font-weight:800">chỉ sau 1 buổi tham quan</span>
      </h1>

      <div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:12px;padding:1rem 1.2rem;margin:.9rem 0 1rem;text-align:left">
        <p style="font-size:.95rem;color:rgba(255,255,255,.92);line-height:1.7;margin:0">
          Checklist <strong style="color:#f9dd0e">15 tiêu chí</strong> + <strong style="color:#f9dd0e">Framework 5C</strong> giúp bạn đánh giá <strong>bất kỳ trường nào</strong> một cách khách quan, không lo chọn sai.
        </p>
      </div>

      <!-- Keyword badges -->
      <div class="mn-hero__badges">
        <span>✅ 15 Tiêu Chí</span>
        <span>🧭 Framework 5C</span>
        <span>🚩 5 Red Flags</span>
      </div>

      <div class="mn-hero__trust">
        <div>📱 Tick trực tiếp trên điện thoại · In ra mang theo khi tham quan · <b>Không spam</b></div>
      </div>
      <p style="margin-top:.9rem">
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" style="display:inline-block;background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.5);color:#fff;font-weight:700;padding:.65rem 1.4rem;border-radius:8px;text-decoration:none;font-size:.95rem">
          💬 Hỏi qua Zalo
        </a>
      </p>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">📥 Tải checklist miễn phí</span>
      <h2>Nhập Email Để Nhận Checklist Ngay</h2>
      <p class="mn-hero__form-sub">Checklist 15 tiêu chí + Framework 5C + 5 red flags sẽ được gửi qua email trong 5 phút.</p>
      <LeadFormTwoStepEmailFirst
        formId="checklist-mn-hero"
        funnelCode="squeeze-checklist-mn-hero"
        schoolLevel="mau-non"
        submitText="Nhận checklist miễn phí"
        successMessage="Cảm ơn! Checklist đã được gửi qua email. Kiểm tra cả hộp thư Spam / Promotions nhé."
      />
    </div>
  </Fragment>

  <!-- PAIN – INSIGHT BLOCK -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">😟 NỖI LO KHI CHỌN TRƯỜNG</p>
    <h2>Đi tham quan nhiều trường nhưng vẫn…<br>không biết đâu là tốt thật</h2>
    <p>Mỗi trường một "kiểu hay" riêng. Ai cũng nói mình dạy song ngữ, môi trường quốc tế, phát triển toàn diện. Ba mẹ nghe xong càng rối, không biết phân biệt thật — giả ở đâu.</p>
    <ul class="sp-pain__list">
      <li><strong>Sợ chọn sai trường</strong> khiến con bị ảnh hưởng lâu dài — 6 năm đầu đời không thể làm lại.</li>
      <li>Nghe <em>"song ngữ"</em> nhưng <strong>không biết có thật hay chỉ là quảng cáo</strong> — bao nhiêu % giáo viên bản ngữ? Trẻ thực sự tiếp xúc tiếng Anh bao nhiêu giờ mỗi ngày?</li>
      <li>Không có tiêu chí khách quan để <strong>so sánh 3–5 trường</strong> đã tham quan — cuối cùng chọn theo cảm tính hoặc lời tư vấn của nhân viên tuyển sinh.</li>
      <li>Bỏ sót những điểm quan trọng: <strong>tỷ lệ giáo viên/học sinh, cách xử lý khủng hoảng cảm xúc ở trẻ, chính sách an toàn</strong> — những thứ trường hiếm khi chủ động chia sẻ.</li>
    </ul>
  </Fragment>

  <!-- SOLUTION BLOCK → 3 feature cards -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">🧭 GIẢI PHÁP</p>
    <h2>Bộ checklist giúp ba mẹ đánh giá trường mầm non một cách khoa học, rõ ràng</h2>
    <p class="sp-features__sub">Không còn chọn theo cảm tính — ba mẹ có công cụ kiểm tra trực tiếp tại trường, cho bất kỳ trường nào đang tham quan.</p>
    <div class="sp-features__grid">

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">✅</div>
        <h3>15 tiêu chí cụ thể, dễ kiểm tra ngay tại trường</h3>
        <p>Từ chương trình học, đội ngũ giáo viên, môi trường an toàn, đến chính sách phụ huynh — mỗi tiêu chí đều có câu hỏi cụ thể ba mẹ có thể hỏi hoặc quan sát trực tiếp khi tham quan. Không còn "đi về rồi mới nhớ ra mình quên hỏi".</p>
        <span class="sp-feat-card__tag">Checklist đầy đủ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>Framework 5C giúp nhìn đúng bản chất chất lượng</h3>
        <p>Curriculum — Care — Community — Communication — Consistency. 5 trụ cột giúp ba mẹ nhìn xuyên qua vẻ ngoài hào nhoáng để đánh giá đâu là trường thực sự tốt cho con, đâu là trường chỉ đẹp ở brochure và tour tham quan.</p>
        <span class="sp-feat-card__tag">Tư duy đánh giá</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🚩</div>
        <h3>5 "red flags" để tránh sai lầm phổ biến</h3>
        <p>Những dấu hiệu cảnh báo ba mẹ thường bỏ qua: giáo viên thay đổi liên tục, cam kết "con đọc được chữ trước 5 tuổi", không cho quan sát lớp học, phụ thu mập mờ, camera bị che… Biết trước để không phải hối hận sau.</p>
        <span class="sp-feat-card__tag">Cảnh báo sớm</span>
      </div>

    </div>
  </Fragment>

  <!-- MOCKUP → text with image block -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">🎁 SẢN PHẨM TẶNG MIỄN PHÍ</p>
      <h2>15 Tiêu Chí Chọn Trường Mầm Non — Mang Theo Điện Thoại, Tick Ngay Tại Chỗ</h2>
      <p>Checklist được thiết kế để ba mẹ mở trên điện thoại khi đang tham quan — hỏi 1 câu, quan sát 1 thứ, tick 1 ô. Không cần ghi nhớ, không cần ghi chép rời.</p>
      <p>Hoặc in ra A4, mang theo kẹp file. Sau khi tham quan 3–5 trường, ba mẹ có bảng điểm rõ ràng để so sánh.</p>
      <div style="display:flex;flex-direction:column;gap:.6rem;margin:1rem 0">
        <div style="display:flex;align-items:center;gap:.6rem;color:#26275D;font-weight:600"><span style="color:#f9dd0e">▸</span> Phù hợp ba mẹ có con <strong>2–5 tuổi</strong></div>
        <div style="display:flex;align-items:center;gap:.6rem;color:#26275D;font-weight:600"><span style="color:#f9dd0e">▸</span> Áp dụng được cho <strong>bất kỳ trường nào</strong></div>
        <div style="display:flex;align-items:center;gap:.6rem;color:#26275D;font-weight:600"><span style="color:#f9dd0e">▸</span> Tick trên điện thoại hoặc in ra</div>
      </div>
      <a href="#sp-form1" style="display:inline-block;margin-top:.75rem;background:#26275D;color:#fff;font-weight:800;padding:.8rem 1.6rem;border-radius:8px;text-decoration:none;font-size:.95rem">
        📥 Tải checklist miễn phí →
      </a>
    </div>
    <div class="sp-textimg__img" style="position:relative;background:linear-gradient(135deg,#fffbf0 0%,#f0f4fa 100%);display:flex;align-items:center;justify-content:center;padding:2rem 1.5rem;min-height:380px">
      <div style="position:absolute;top:16px;right:16px;background:#e53935;color:#fff;font-size:1rem;font-weight:800;padding:.35rem .85rem;border-radius:50px;letter-spacing:.05em;box-shadow:0 4px 12px rgba(229,57,53,.35);z-index:2">FREE DOWNLOAD</div>
      <div style="background:#1a1a2e;border-radius:32px;padding:10px;box-shadow:0 20px 50px rgba(38,39,93,.25);max-width:240px;width:100%">
        <div style="background:#fff;border-radius:24px;overflow:hidden;aspect-ratio:9/19;padding:1.25rem 1rem;display:flex;flex-direction:column;gap:.75rem">
          <div style="text-align:center;padding:.5rem 0 .35rem;border-bottom:1.5px solid #f0f4fa">
            <div style="font-family:Montserrat,sans-serif;font-size:1rem;font-weight:800;color:#26275D;letter-spacing:.06em">TRƯỜNG VIỆT ANH</div>
            <div style="font-family:Montserrat,sans-serif;font-size:1rem;font-weight:800;color:#26275D;line-height:1.2;margin-top:.2rem">15 Tiêu Chí Chọn<br>Trường Mầm Non</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:.5rem;font-size:1rem;color:#1a1a2e">
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;background:#27ae60;color:#fff;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;flex-shrink:0">✓</span><span>Tỷ lệ GV/HS &lt; 1:8</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;background:#27ae60;color:#fff;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;flex-shrink:0">✓</span><span>Giáo viên bản ngữ ≥ 50%</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;background:#27ae60;color:#fff;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;flex-shrink:0">✓</span><span>Camera công khai 24/7</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;background:#27ae60;color:#fff;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;font-weight:800;flex-shrink:0">✓</span><span>Báo cáo tiến độ định kỳ</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;border:1.5px solid #f9dd0e;border-radius:4px;flex-shrink:0"></span><span>Chính sách hoàn học phí</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;border:1.5px solid #f9dd0e;border-radius:4px;flex-shrink:0"></span><span>Khảo sát phát triển 9 mảng</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;border:1.5px solid #f9dd0e;border-radius:4px;flex-shrink:0"></span><span>Khẩu phần ăn minh bạch</span></div>
            <div style="display:flex;align-items:center;gap:.4rem"><span style="width:14px;height:14px;border:1.5px solid #f9dd0e;border-radius:4px;flex-shrink:0"></span><span>Quy trình khủng hoảng</span></div>
          </div>
          <div style="margin-top:auto;padding-top:.5rem;border-top:1.5px solid #f0f4fa;text-align:center">
            <div style="font-size:1rem;color:#64748b">4 / 15 tiêu chí đã check</div>
            <div style="height:4px;background:#f0f4fa;border-radius:2px;margin-top:.3rem;overflow:hidden"><div style="width:26%;height:100%;background:linear-gradient(90deg,#f9dd0e,#F5DC85)"></div></div>
          </div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PROOF BLOCK -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">🏫 XÂY DỰNG TỪ KINH NGHIỆM THỰC TẾ</p>
    <h2>Được Biên Soạn Bởi Hệ Thống Giáo Dục Với Hàng Nghìn Học Sinh</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">3,000+</span>
        <span class="sp-stat__label">Gia đình đã tin tưởng gửi gắm con tại Trường Việt Anh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">15+</span>
        <span class="sp-stat__label">Năm kinh nghiệm đồng hành cùng trẻ giai đoạn 0–6 tuổi</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">9</span>
        <span class="sp-stat__label">Cơ sở tại TP.HCM, Tây Ninh, An Giang</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">100%</span>
        <span class="sp-stat__label">Miễn phí — không yêu cầu cam kết tư vấn</span>
      </div>
    </div>
    <p style="margin-top:2rem;font-size:1rem;color:rgba(226,232,240,.82);line-height:1.8;max-width:680px;margin-left:auto;margin-right:auto">
      👉 Tài liệu được thiết kế để ba mẹ <strong style="color:#f9dd0e">tự đánh giá độc lập</strong> — không phụ thuộc vào lời tư vấn của bất kỳ trường nào, <em>kể cả Việt Anh</em>.
    </p>
  </Fragment>

  <!-- QUOTE -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Trước khi có checklist mình đi 4 trường, về cái đầu rối bời. Có checklist thì mỗi trường chấm xong là biết ngay điểm mạnh yếu. Đến khi chọn trường cho bé, mình tự tin hẳn — không còn sợ chọn sai."
      </p>
      <div class="sp-quote__author">
        <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#f9dd0e,#F5DC85);border:3px solid #f9dd0e;display:flex;align-items:center;justify-content:center;font-weight:800;color:#26275D;font-size:1.1rem">TH</div>
        <div>
          <div class="sp-quote__name">Chị Thu Hà</div>
          <div class="sp-quote__meta">Phụ huynh đang tìm trường mầm non — bé 3 tuổi</div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- OFFER BLOCK (pricing slot repurposed) -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">🎁 BẠN NHẬN ĐƯỢC NGAY</p>
    <h2>Checklist 15 Tiêu Chí Chọn Trường Mầm Non Song Ngữ</h2>
    <p class="sp-pricing__sub">Mang đi tham quan và áp dụng ngay lập tức</p>

    <div style="background:#fff;border:1.5px solid #f9dd0e;border-radius:16px;padding:2rem 1.75rem;margin:1.5rem 0;text-align:left;box-shadow:0 8px 30px rgba(38,39,93,.08)">
      <div style="display:grid;grid-template-columns:auto 1fr;gap:1rem 1.25rem;align-items:start">
        <div style="width:40px;height:40px;background:rgba(249, 221, 14,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.35rem">📋</div>
        <div>
          <h3 style="font-size:1.05rem;color:#26275D;margin:0 0 .35rem;font-weight:800">Checklist 15 tiêu chí đánh giá trường</h3>
          <p style="font-size:1rem;color:#64748b;margin:0;line-height:1.65">Bao quát đầy đủ: chương trình, giáo viên, cơ sở vật chất, chính sách phụ huynh, an toàn, dinh dưỡng.</p>
        </div>

        <div style="width:40px;height:40px;background:rgba(249, 221, 14,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.35rem">🧭</div>
        <div>
          <h3 style="font-size:1.05rem;color:#26275D;margin:0 0 .35rem;font-weight:800">Framework 5C đánh giá chất lượng</h3>
          <p style="font-size:1rem;color:#64748b;margin:0;line-height:1.65">Curriculum · Care · Community · Communication · Consistency — 5 trụ cột nhìn ra trường tốt thật.</p>
        </div>

        <div style="width:40px;height:40px;background:rgba(249, 221, 14,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.35rem">🚩</div>
        <div>
          <h3 style="font-size:1.05rem;color:#26275D;margin:0 0 .35rem;font-weight:800">5 "red flags" cần tránh</h3>
          <p style="font-size:1rem;color:#64748b;margin:0;line-height:1.65">Những dấu hiệu cảnh báo phổ biến mà ba mẹ thường bỏ sót khi tham quan trường.</p>
        </div>

        <div style="width:40px;height:40px;background:rgba(249, 221, 14,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.35rem">📱</div>
        <div>
          <h3 style="font-size:1.05rem;color:#26275D;margin:0 0 .35rem;font-weight:800">Tick trực tiếp trên điện thoại hoặc in ra</h3>
          <p style="font-size:1rem;color:#64748b;margin:0;line-height:1.65">Thiết kế responsive — dùng ngay trên điện thoại khi đang tham quan, hoặc in A4 mang theo.</p>
        </div>

        <div style="width:40px;height:40px;background:rgba(249, 221, 14,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.35rem">👶</div>
        <div>
          <h3 style="font-size:1.05rem;color:#26275D;margin:0 0 .35rem;font-weight:800">Phù hợp cho ba mẹ có con từ 2–5 tuổi</h3>
          <p style="font-size:1rem;color:#64748b;margin:0;line-height:1.65">Áp dụng được cho <strong>bất kỳ trường mầm non song ngữ nào</strong> bạn đang cân nhắc.</p>
        </div>
      </div>
    </div>

    <p class="sp-pricing__note">* Miễn phí 100% — không yêu cầu cam kết tư vấn hay đặt lịch tham quan.</p>
  </Fragment>

  <!-- FINAL CTA -->
  <Fragment slot="cta">
    <h2>Đừng Chọn Trường Bằng Cảm Tính —<br>Hãy Chọn Bằng Tiêu Chí Rõ Ràng</h2>
    <p>6 năm đầu đời không thể làm lại. Một bộ checklist trong tay sẽ giúp ba mẹ <strong>tự tin ra quyết định</strong> thay vì phân vân sau mỗi buổi tham quan.</p>
    <a href="#sp-form1" class="sp-cta-btn">📥 Nhận ngay miễn phí →</a>
    <p class="sp-cta-block__note">Gửi qua email trong 5 phút · Không spam · Có thể hủy nhận tin bất cứ lúc nào</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <p class="sp-form-block__eyebrow">TẢI CHECKLIST MIỄN PHÍ</p>
    <h2>Nhập Email Để Nhận Checklist Ngay</h2>
    <p>Checklist 15 tiêu chí + Framework 5C + 5 red flags sẽ được gửi qua email trong 5 phút.</p>
    <LeadFormTwoStepEmailFirst
      formId="checklist-mn-form1"
      funnelCode="squeeze-checklist-mn"
      schoolLevel="mau-non"
      submitText="Nhận checklist miễn phí"
      successMessage="Cảm ơn! Checklist đã được gửi qua email. Kiểm tra cả hộp thư Spam / Promotions nhé."
    />
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Những Điều Ba Mẹ Hay Thắc Mắc</h2>
    <p class="sp-faq__sub">Về checklist và cách sử dụng</p>

    <details class="sp-faq-item">
      <summary>Checklist này có áp dụng được cho trường nào không phải Việt Anh không?</summary>
      <div class="sp-faq-answer">
        Có. Checklist được thiết kế <strong>khách quan</strong> để ba mẹ đánh giá bất kỳ trường mầm non song ngữ nào — kể cả so sánh giữa Việt Anh và các trường khác. Tài liệu giúp bạn ra quyết định dựa trên tiêu chí, không phải lời tư vấn của trường.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Tôi nhận checklist bằng cách nào và trong bao lâu?</summary>
      <div class="sp-faq-answer">
        Sau khi điền email và thông tin, checklist sẽ được gửi qua email trong vòng <strong>5 phút</strong> dưới dạng PDF và link trên điện thoại. Ba mẹ có thể mở trực tiếp trên điện thoại khi tham quan, hoặc in ra A4 mang theo. Nếu không thấy email, vui lòng kiểm tra thư mục Spam / Promotions.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Có phải trả phí gì không? Có bị gọi điện làm phiền không?</summary>
      <div class="sp-faq-answer">
        Hoàn toàn miễn phí và <strong>không yêu cầu cam kết nào</strong>. Tư vấn viên có thể gọi 1 lần để hỏi xem ba mẹ có cần hỗ trợ gì thêm — nhưng nếu bạn chỉ muốn nhận tài liệu, chúng tôi sẽ tôn trọng và không làm phiền.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Con tôi 12 tháng, checklist này có dùng được không?</summary>
      <div class="sp-faq-answer">
        Checklist được tối ưu cho <strong>ba mẹ có con 2–5 tuổi</strong> — giai đoạn chọn trường mầm non. Với bé dưới 2 tuổi, phần lớn tiêu chí vẫn áp dụng được, nhưng một số tiêu chí về chương trình học có thể chưa phù hợp hoàn toàn. Ba mẹ có thể dùng như tài liệu tham khảo để chuẩn bị trước.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Tôi có thể chia sẻ checklist cho bạn bè đang tìm trường không?</summary>
      <div class="sp-faq-answer">
        Được. Checklist được biên soạn để hỗ trợ phụ huynh — ba mẹ có thể chia sẻ file PDF cho bạn bè, người thân cũng đang tìm trường cho con. Chỉ cần giữ nguyên phần credit của Trường Việt Anh trong tài liệu.
      </div>
    </details>
  </Fragment>

