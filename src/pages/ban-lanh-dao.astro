---

<BaseLayout
  title="Ban Lãnh Đạo – Trường Việt Anh"
  description="Ban Lãnh Đạo & đội ngũ giáo viên của trường Việt Anh có bằng cấp chính quy, chuyên môn giỏi và nhiều năm kinh nghiệm trong việc giảng dạy và quản lý học sinh."
  canonical="https://truongvietanh.com/ban-lanh-dao"
  ogImage="https://media.truongvietanh.com/images/giao-vien-35.webp"
  structuredData={structuredData}
  noPopup={true}
>
  <div class="bl-page">
    <HeaderBase />

    <!-- ===== HERO ===== -->
    <section class="bl-hero">
      <div class="bl-container">
        <nav class="bl-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <span>Ban Lãnh Đạo</span>
        </nav>
        <h1 class="bl-hero__title">
          Ban Lãnh Đạo<br/>
          <span class="bl-hero__title-accent">Của Trường Việt Anh</span>
        </h1>
        <p class="bl-hero__subtitle">
          Ban Lãnh Đạo & đội ngũ giáo viên của trường Việt Anh có bằng cấp chính quy, chuyên môn giỏi và nhiều năm kinh nghiệm trong việc giảng dạy và quản lý học sinh.
        </p>
        <div class="bl-hero__stats">
          <div class="bl-stat"><strong>{schoolFacts.yearsRunning}</strong><span>Năm kinh nghiệm</span></div>
          <div class="bl-stat"><strong>{schoolFacts.campuses}</strong><span>Cơ sở chính thức</span></div>
        </div>
      </div>
    </section>

    <!-- ===== BAN LÃNH ĐẠO ===== -->
    <div class="bl-container bl-panels">
      <div class="bl-panel bl-panel--active">
        <div class="bl-panel__intro">
          <h2 class="bl-panel__heading">Ban Lãnh Đạo</h2>
          <p class="bl-panel__desc">Đội ngũ lãnh đạo giàu kinh nghiệm, tâm huyết với sứ mệnh xây dựng nền giáo dục vừa nhân văn vừa hiệu quả cho thế hệ trẻ Việt Nam.</p>
        </div>
        <div class="bl-grid">
          {bghMembers.map(m => (
            <article class={`bl-card bl-card--${m.role}`}>
              <div class="bl-card__avatar-wrap">
                {m.photo ? (
                  <img src={m.photo} alt={`Ảnh ${m.name}`} class="bl-card__photo" loading="lazy" width="400" height="400" />
                ) : (
                  <div class={`bl-card__avatar bl-avatar--${m.role}`} aria-hidden="true">
                    <span>{m.initials}</span>
                  </div>
                )}
                <div class="bl-card__role-dot"></div>
              </div>
              <div class="bl-card__body">
                <div class="bl-card__title-badge">{m.title}</div>
                <h3 class="bl-card__name">{m.name}</h3>
                <p class="bl-card__org">{m.org}</p>
                <div class="bl-card__text">
                  <p class={`bl-card__desc${m.quote ? ' bl-card__desc--quote' : ''}`}>{m.description}</p>
                  {m.mission && (
                    <p class="bl-card__desc bl-card__desc--quote">“{m.mission}”</p>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div><!-- /bl-panels -->

    <!-- ===== CTA SECTION ===== -->
    <section class="bl-cta">
      <div class="bl-container bl-cta__inner">
        <div class="bl-cta__text">
          <h2>Muốn tìm hiểu thêm về Trường Việt Anh?</h2>
          <p>Đặt lịch tham quan miễn phí — đội ngũ tư vấn sẽ dẫn Ba/Mẹ tham quan cơ sở và giải đáp mọi thắc mắc.</p>
        </div>
        <div class="bl-cta__actions">
          <a href="tel:+84916961409" class="bl-btn bl-btn--primary">📞 0916 961 409</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener noreferrer" class="bl-btn bl-btn--zalo">💬 Chat Zalo</a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<script is:inline>
(function () {
  var tabs = document.querySelectorAll('.bl-tab');
  var panels = document.querySelectorAll('.bl-panel');

  function activate(tabEl) {
    var id = tabEl.getAttribute('data-tab');

    // update tabs
    tabs.forEach(function (t) {
      var isActive = t.getAttribute('data-tab') === id;
      t.classList.toggle('bl-tab--active', isActive);
      t.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    // update panels
    panels.forEach(function (p) {
      var isActive = p.id === 'panel-' + id;
      p.classList.toggle('bl-panel--active', isActive);
      if (isActive) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
    });

    // scroll tab into view on mobile
    tabEl.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { activate(tab); });
    tab.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(tab); }
    });
  });

  // sticky tab bar on scroll
  var tabsWrap = document.getElementById('blTabsWrap');
  if (tabsWrap && 'IntersectionObserver' in window) {
    var sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none';
    tabsWrap.parentElement.insertBefore(sentinel, tabsWrap);
    new IntersectionObserver(function (entries) {
      tabsWrap.classList.toggle('bl-tabs-wrap--sticky', !entries[0].isIntersecting);
    }, { threshold: 0 }).observe(sentinel);
  }
})();
</script>

<script is:inline>
  (function () {
    var khoi = document.querySelectorAll('.bl-card__text');
    if (!khoi.length) return;

    function danhGia(el) {
      // Nguoi dung da tu bam mo thi de yen, dung tu cat lai
      if (el.dataset.daMo === '1') return;
      var nut = el.parentNode.querySelector('.bl-card__more');
      el.classList.add('is-clamped');
      // Chi cat khi tiet kiem duoc tren ~1,5 dong; it hon thi hien du, khoi gan nut vo nghia
      if (el.scrollHeight - el.clientHeight < 40) {
        el.classList.remove('is-clamped');
        if (nut) nut.parentNode.removeChild(nut);
        return;
      }
      if (!nut) {
        nut = document.createElement('button');
        nut.type = 'button';
        nut.className = 'bl-card__more';
        nut.addEventListener('click', function () {
          var dangCat = el.classList.toggle('is-clamped');
          el.dataset.daMo = dangCat ? '0' : '1';
          nut.textContent = dangCat ? 'Xem thêm' : 'Thu gọn';
          nut.setAttribute('aria-expanded', dangCat ? 'false' : 'true');
        });
        el.parentNode.appendChild(nut);
      }
      nut.textContent = 'Xem thêm';
      nut.setAttribute('aria-expanded', 'false');
    }

    function chay() { khoi.forEach(danhGia); }

    // PHAI do SAU khi font web tai xong: do bang font du phong se ra sai so dong,
    // dan toi tuong la khong tran va khong gan nut.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(chay);
    chay();
    window.addEventListener('load', chay);
    // Doi be ngang thi so dong doi theo -> do lai
    var hen;
    window.addEventListener('resize', function () { clearTimeout(hen); hen = setTimeout(chay, 200); });
  })();
</script>

<style is:inline>/* ===== RESET / BASE ===== */
  .bl-page{ --navy: #26275D; --navy-dk: #18193a; --navy-lt: #363876; --gold: #f9dd0e; --gold-lt: rgba(249, 221, 14,.12); --text: #1a1a2e; --sub: #5a5a7a; --border: #E5E7EB; --bg: #F8F9FC; --white: #fff; --radius: 16px; }.bl-container{ max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }/* ===== HERO ===== */
  .bl-hero{
    background:
      linear-gradient(115deg, rgba(18,18,62,.92) 0%, rgba(38,39,93,.78) 55%, rgba(42,32,96,.55) 100%),
      url('https://media.truongvietanh.com/images/olympic/thay-co-tham-gia-olympic-1.webp') right 60% / cover no-repeat;
    color: #fff; padding: 3.5rem 0 4rem; position: relative; overflow: hidden;
  }.bl-hero::before{
    content: ''; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
  }.bl-breadcrumb{ display: flex; align-items: center; gap: .5rem; font-size: 1rem; color: rgba(255,255,255,.65); margin-bottom: 1.5rem; flex-wrap: wrap; position: relative; }.bl-breadcrumb a{ color: var(--gold); text-decoration: none; }.bl-breadcrumb a:hover{ text-decoration: underline; }.bl-hero__title{ font-family: 'Montserrat', sans-serif; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; line-height: 1.2; margin-bottom: 1rem; color: #fff; position: relative; }.bl-hero__title-accent{ color: var(--gold); }.bl-hero__subtitle{ font-size: 1.05rem; color: rgba(255,255,255,.8); max-width: 680px; line-height: 1.7; margin-bottom: 2rem; position: relative; }.bl-hero__stats{ display: flex; gap: 1.5rem; flex-wrap: wrap; position: relative; }.bl-stat{ display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: 12px; padding: .75rem 1.25rem; min-width: 90px; }.bl-stat strong{ font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 900; color: var(--gold); line-height: 1; }.bl-stat span{ font-size: 1rem; color: rgba(255,255,255,.7); margin-top: .25rem; text-align: center; }/* ===== TABS ===== */
  .bl-tabs-wrap{ background: var(--white); border-bottom: 2px solid var(--border); position: sticky; top: 0; z-index: 100; transition: box-shadow .2s; }.bl-tabs-wrap--sticky{ box-shadow: 0 4px 20px rgba(38,39,93,.12); }.bl-tabs{ display: flex; gap: 0; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }.bl-tabs::-webkit-scrollbar{ display: none; }.bl-tab{
    display: flex; align-items: center; gap: .45rem; padding: 1rem 1.25rem;
    border: none; background: none; cursor: pointer; white-space: nowrap;
    font-size: 1rem; font-weight: 600; color: var(--sub);
    border-bottom: 3px solid transparent; margin-bottom: -2px;
    transition: color .2s, border-color .2s; flex-shrink: 0;
  }.bl-tab:hover{ color: var(--navy); }.bl-tab--active{ color: var(--navy); border-bottom-color: var(--gold); }.bl-tab__icon{ font-size: 1rem; }/* ===== PANELS ===== */
  .bl-panels{ padding: 3rem 1.5rem 4rem; }.bl-panel{ display: none; }.bl-panel--active{ display: block; }.bl-panel__intro{ margin-bottom: 2.5rem; text-align: center; }.bl-panel__heading{ font-family: 'Montserrat', sans-serif; font-size: 1.75rem; font-weight: 800; color: var(--navy); margin-bottom: .75rem; }.bl-panel__desc{ font-size: 1rem; color: var(--sub); max-width: 640px; margin: 0 auto; line-height: 1.7; }.bl-panel__desc a{ color: var(--navy); font-weight: 600; }/* ===== BAN LÃNH ĐẠO GRID ===== */
  .bl-grid{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }/* ===== CARD ===== */
  .bl-card{
    background: var(--white); border-radius: var(--radius);
    border: 1px solid var(--border); overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease;
    display: flex; flex-direction: column;
    position: relative;
  }.bl-card:hover{ transform: translateY(-6px); box-shadow: 0 16px 40px rgba(38,39,93,.1); }.bl-card::after{
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 3px; background: linear-gradient(90deg, var(--gold), #F5DC85);
    transform: scaleX(0); transition: transform .3s ease;
  }.bl-card:hover::after{ transform: scaleX(1); }/* Top row (chairman, vice-chairman) get extra prominence */
  .bl-card--chairman, .bl-card--vice-chairman{
    border-top: 3px solid var(--gold);
  }/* ===== AVATAR WRAP ===== */
  .bl-card__avatar-wrap{
    position: relative; padding: 0; display: block;
    background: linear-gradient(180deg, var(--bg) 0%, var(--white) 100%);
  }.bl-card__photo{
    width: 100%; height: auto; aspect-ratio: 3 / 4; border-radius: 0;
    object-fit: cover; object-position: top center;
    display: block; border: 0; box-shadow: none;
  }.bl-card__avatar{
    width: 100%; aspect-ratio: 3 / 4; border-radius: 0;
    display: flex; align-items: center; justify-content: center;
    border: 0; box-shadow: none;
  }.bl-card__avatar{ font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 1rem; color: #fff; letter-spacing: .5px; }/* Avatar colors by role */
  .bl-avatar--chairman{ background: linear-gradient(135deg, #C9A329, var(--gold)); }.bl-avatar--vice-chairman{ background: linear-gradient(135deg, #f9dd0e, #F5DC85); }.bl-avatar--principal{ background: linear-gradient(135deg, var(--navy-dk), var(--navy-lt)); }.bl-avatar--vice-principal{ background: linear-gradient(135deg, #1e5fa8, #2a7abf); }.bl-avatar--mam-non{ background: linear-gradient(135deg, #1a8a4a, #27ae60); }.bl-avatar--research{ background: linear-gradient(135deg, #6b21a8, #9333ea); }.bl-card__role-dot{
    position: absolute; bottom: 12px; right: 12px;
    width: 14px; height: 14px; border-radius: 50%;
    background: #16A34A; border: 2px solid var(--white);
  }/* ===== CARD BODY ===== */
  .bl-card__body{ padding: .75rem 1.25rem 1.5rem; flex: 1; display: flex; flex-direction: column; gap: .4rem; text-align: center; }.bl-card__title-badge{
    display: inline-block; align-self: center;
    background: var(--gold-lt); color: var(--navy); border: 1px solid rgba(249, 221, 14,.3);
    font-size: 1.5rem; font-weight: 700; padding: .3rem .85rem; border-radius: 50px;
    letter-spacing: .5px; text-transform: uppercase;
  }.bl-card--chairman .bl-card__title-badge{ background: linear-gradient(135deg, var(--gold), #F5DC85); color: var(--navy-dk); border-color: transparent; }.bl-card__name{ font-family: 'Montserrat', sans-serif; font-size: 1.05rem; font-weight: 800; color: var(--navy); margin: 0; line-height: 1.3; }.bl-card__org{ font-size: 1rem; color: var(--sub); font-weight: 500; line-height: 1.4; margin: 0; }/* RUT GON CHU DAI — the ngan khoi ho mang trang lon.
     Chu van nam DU trong HTML, chi bi CSS che; khong co JS thi hien day du. */
  .bl-card__text{ position: relative; display: flex; flex-direction: column; gap: .4rem; flex: 1; }
