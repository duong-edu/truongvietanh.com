          </div>
        ))}
      </div>
    </div>

  </div><!-- /panels -->

  <!-- CTA -->
  <section class="gvcn-cta">
    <div class="gvcn-cta__inner">
      <h2>Muốn gặp trực tiếp đội ngũ giáo viên?</h2>
      <p>Đặt lịch tham quan trường và gặp gỡ giáo viên chủ nhiệm tương lai của con</p>
      <div class="gvcn-cta__btns">
        <a href="tel:+84916961409" class="gvcn-cta__btn gvcn-cta__btn--primary">📞 Gọi ngay: 0916 961 409</a>
        <a href="https://zalo.me/0916961409" target="_blank" rel="noopener" class="gvcn-cta__btn gvcn-cta__btn--zalo">💬 Chat Zalo</a>
      </div>
    </div>
  </section>

  <FooterBase slot="footer" />
</BaseLayout>

<script>
  // Tab switching
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.gvcn-tab');
  const panels = document.querySelectorAll<HTMLElement>('.gvcn-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabBtns.forEach(b => {
        b.classList.toggle('gvcn-tab--active', b.dataset.tab === target);
        b.setAttribute('aria-selected', b.dataset.tab === target ? 'true' : 'false');
      });
      panels.forEach(p => {
        const active = p.id === `panel-${target}`;
        p.classList.toggle('gvcn-panel--active', active);
        p.hidden = !active;
      });
    });
  });

  // Sticky tabs
  const tabsWrap = document.getElementById('gvcnTabsWrap');
  if (tabsWrap) {
    const sentinel = document.createElement('div');
    tabsWrap.parentElement!.insertBefore(sentinel, tabsWrap);
    new IntersectionObserver(([e]) => {
      tabsWrap.classList.toggle('gvcn-tabs-wrap--sticky', !e.isIntersecting);
    }, { rootMargin: '-1px 0px 0px 0px', threshold: [1] }).observe(sentinel);
  }
</script>

