function getInitials(name: string): string {
  const parts = name.split(' ');
  if (parts.length === 1) return name.slice(0, 2).toUpperCase();
  // For Vietnamese names, take first char of first + last word
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function getAvatarColor(name: string): string {
  const colors = ['#1a3c5e','#2563eb','#7c3aed','#059669','#d97706','#f9dd0e','#0891b2','#be185d'];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return colors[Math.abs(hash) % colors.length];
}

const roleColors: Record<string, { bg: string; color: string; label: string }> = {
  chairman:      { bg: '#fef3c7', color: '#92400e', label: 'Chủ Tịch' },
