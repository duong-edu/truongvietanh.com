      </div>
      <div class="gvcn-coming-soon">
        <div class="gvcn-coming-soon__icon">📚</div>
        <h3>Đang cập nhật</h3>
        <p>Nội dung đang được cập nhật. Vui lòng liên hệ hotline để được tư vấn.</p>
        <a href="tel:+84916961409" class="gvcn-coming-soon__btn">📞 0916 961 409</a>
      </div>
    </div>

    <!-- BẢN NGỮ PANEL -->
    <div id="panel-gv-ban-ngu" role="tabpanel" class="gvcn-panel" hidden>
      <div class="gvcn-section-hd">
        <h2>Giáo Viên Bản Ngữ</h2>
        <p>Đội ngũ giáo viên bản ngữ quốc tế – {banNguTeachers.length} thành viên</p>
      </div>
      <div class="gvcn-teacher-grid gvcn-teacher-grid--native">
        {banNguTeachers.map(name => (
          <div class="gvcn-teacher-card gvcn-teacher-card--native">
            <div class="gvcn-teacher-card__avatar gvcn-teacher-card__avatar--native" style={`background:${getAvatarColor(name)}`}>
              {getInitials(name)}
            </div>
            <span class="gvcn-teacher-card__name">{name}</span>
            <span class="gvcn-teacher-card__badge">Native Speaker</span>
          </div>
        ))}
      </div>
    </div>

    <!-- TƯ VẤN PANEL -->
    <div id="panel-tu-van" role="tabpanel" class="gvcn-panel" hidden>
      <div class="gvcn-section-hd">
        <h2>Đội Ngũ Tư Vấn Tại Các Cơ Sở</h2>
        <p>Đội ngũ tư vấn tuyển sinh hỗ trợ phụ huynh tại 3 cơ sở – {tuVanTeachers.length} thành viên</p>
      </div>
      <div class="gvcn-teacher-grid">
        {tuVanTeachers.map(name => (
          <div class="gvcn-teacher-card">
            <div class="gvcn-teacher-card__avatar" style={`background:${getAvatarColor(name)}`}>
              {getInitials(name)}
            </div>
