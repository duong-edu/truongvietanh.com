---

<BaseLayout
  title="Ban Lãnh Đạo & Đội Ngũ Giáo Viên – Trường Việt Anh"
  description="Ban Lãnh Đạo & đội ngũ giáo viên chủ nhiệm tại các cơ sở Gò Vấp, Bình Tân của Trường Việt Anh. Bằng cấp chính quy, chuyên môn giỏi, giàu kinh nghiệm."
  canonical="https://truongvietanh.com/giao-vien-chu-nhiem"
  noPopup={true}
>
  <HeaderBase slot="header" />

  <!-- HERO -->
  <section class="gvcn-hero">
    <div class="gvcn-hero__inner">
      <nav class="gvcn-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <span>Giáo Viên Chủ Nhiệm</span>
      </nav>
      <h1 class="gvcn-hero__title">Ban Lãnh Đạo & Đội Ngũ Giáo Viên<br>Của Trường Việt Anh</h1>
      <p class="gvcn-hero__sub">Ban Lãnh Đạo & đội ngũ giáo viên của trường Việt Anh có bằng cấp chính quy, chuyên môn giỏi và nhiều năm kinh nghiệm trong việc giảng dạy và quản lý học sinh.</p>
      <div class="gvcn-stats">
        <div class="gvcn-stat"><span class="gvcn-stat__num">{schoolFacts.yearsRunning}</span><span class="gvcn-stat__lbl">Năm kinh nghiệm</span></div>
        <div class="gvcn-stat"><span class="gvcn-stat__num">{schoolFacts.campuses}</span><span class="gvcn-stat__lbl">Cơ sở chính thức</span></div>
        <div class="gvcn-stat"><span class="gvcn-stat__num">{schoolFacts.studentsTotal}</span><span class="gvcn-stat__lbl">Học sinh</span></div>
      </div>
    </div>
  </section>

  <!-- TAB NAV -->
  <div class="gvcn-tabs-wrap" id="gvcnTabsWrap">
    <div class="gvcn-tabs" role="tablist" id="gvcnTabs">
      {tabs.map((tab, i) => (
        <button
          class={`gvcn-tab${i === 0 ? ' gvcn-tab--active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${tab.id}`}
          data-tab={tab.id}
        >
          <span class="gvcn-tab__icon">{tab.icon}</span>
          <span class="gvcn-tab__lbl">{tab.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- PANELS -->
  <div class="gvcn-panels">

    <!-- Ban Lãnh Đạo PANEL -->
    <div id="panel-bgh" role="tabpanel" class="gvcn-panel gvcn-panel--active">
      <div class="gvcn-section-hd">
        <h2>Ban Lãnh Đạo</h2>
        <p>Đội ngũ lãnh đạo cốt lõi điều hành toàn hệ thống Trường Việt Anh</p>
      </div>
      <div class="gvcn-bgh-grid">
        {bghMembers.map(m => {
          const rc = roleColors[m.role] ?? roleColors['vice-principal'];
          return (
            <div class="gvcn-bgh-card">
              {m.photo ? (
                <img src={m.photo} alt={`Ảnh ${m.name}`} class="gvcn-bgh-card__photo" loading="lazy" width="72" height="72" />
              ) : (
                <div class="gvcn-bgh-card__avatar" style={`background:${getAvatarColor(m.name)}`}>
                  {m.initials}
                </div>
              )}
              <span class="gvcn-bgh-card__badge" style={`background:${rc.bg};color:${rc.color}`}>{rc.label}</span>
              <h3 class="gvcn-bgh-card__name">{m.name}</h3>
              <p class="gvcn-bgh-card__org">{m.org}</p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- GÒ VẤP PANEL -->
    <div id="panel-gv-go-vap" role="tabpanel" class="gvcn-panel" hidden>
      <div class="gvcn-section-hd">
        <h2>Giáo Viên Cơ Sở Gò Vấp</h2>
        <p>Đội ngũ giáo viên chủ nhiệm tại cơ sở Gò Vấp – {goVapTeachers.length} thành viên</p>
      </div>
      <div class="gvcn-teacher-grid">
        {goVapTeachers.map(name => (
          <div class="gvcn-teacher-card">
            <div class="gvcn-teacher-card__avatar" style={`background:${getAvatarColor(name)}`}>
              {getInitials(name)}
            </div>
            <span class="gvcn-teacher-card__name">{name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- BÌNH TÂN PANEL -->
    <div id="panel-gv-binh-tan" role="tabpanel" class="gvcn-panel" hidden>
      <div class="gvcn-section-hd">
        <h2>Giáo Viên Cơ Sở Bình Tân</h2>
        <p>Đội ngũ giáo viên chủ nhiệm tại cơ sở Bình Tân – {binhTanTeachers.length} thành viên</p>
      </div>
      <div class="gvcn-teacher-grid">
        {binhTanTeachers.map(name => (
          <div class="gvcn-teacher-card">
            <div class="gvcn-teacher-card__avatar" style={`background:${getAvatarColor(name)}`}>
              {getInitials(name)}
            </div>
            <span class="gvcn-teacher-card__name">{name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- MẦM NON PANEL -->
