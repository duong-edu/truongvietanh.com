---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import { getTestimonials } from '../../lib/directus';

const cmsTestimonials = await getTestimonials('index');

const productLinks = [
  { label: 'Mầm non', href: '/mam-non' },
  { label: 'Tiểu học', href: '/tieu-hoc' },
  { label: 'THCS', href: '/trung-hoc-co-so' },
  { label: 'THPT', href: '/trung-hoc-pho-thong' },
  { label: 'Trại hè', href: '/tuyen-sinh/trai-he/' },
  { label: 'Tiếng Anh Trẻ Em', href: '/tuyen-sinh/tieng-anh-tre-em/' },
  { label: 'Toán Tư Duy', href: '/tuyen-sinh/toan-tu-duy/' },
  { label: 'Giải Mã Tiềm Năng', href: '/tuyen-sinh/giai-ma-tiem-nang/' },
];

const campusLinks = [
  { label: 'Trường Mầm non Việt Anh Gò Vấp - HCM', href: '/co-so/mam-non-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Gò Vấp - HCM', href: '/co-so/lien-cap-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Bình Tân - HCM', href: '/co-so/lien-cap-binh-tan' },
  { label: 'Trường Mầm non Nhân Lễ - Tây Ninh', href: '/co-so/mam-non-nhan-le' },
  { label: 'Trường Mầm non và Tiểu học Thái Sơn - Tây Ninh', href: '/co-so/thai-son' },
  { label: 'Trường Mầm non và Tiểu học Mekong Xanh - TP Rạch Giá - An Giang', href: '/co-so/mekong-xanh' },
];

const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({ name: t.name, role: t.role, quote: t.quote, img: t.image || '', videoUrl: t.video_url || '' }))
  : [
    { name: 'Chị Linh', role: 'Phụ huynh mầm non – bé 2 tuổi', quote: 'Từ em bé bướng bỉnh, con đã biết tự ăn và vào nề nếp. Con thay đổi rõ rệt chỉ sau vài tháng đầu.', img: 'https://img.youtube.com/vi/Bt1yyMil3Tg/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=Bt1yyMil3Tg' },
    { name: 'Anh Công', role: 'Phụ huynh lớp 1 – chuyển từ mầm non', quote: 'Con luôn háo hức và mong chờ được đến trường mỗi ngày. Đi học vui vẻ, không áp lực.', img: 'https://img.youtube.com/vi/b9eNSFUDd98/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=b9eNSFUDd98' },
    { name: 'Chị Quỳnh', role: 'Phụ huynh lớp 7 – chuyển trường mới', quote: 'Chỉ sau hơn 1 tháng, con đã hòa nhập rất tốt với bạn bè và học tập vui vẻ mỗi ngày.', img: 'https://img.youtube.com/vi/cZ6S_3MG1Vo/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=cZ6S_3MG1Vo' },
    { name: 'Anh Lê Trung Thành', role: 'Phụ huynh THPT – lựa chọn môi trường', quote: 'Gia đình chọn trường vì môi trường giúp con phát triển toàn diện — từ kiến thức đến thái độ.', img: 'https://img.youtube.com/vi/5T8j_k5VCW4/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=5T8j_k5VCW4' },
    { name: 'Bạn Chu Anh Tài', role: 'Học sinh lớp 12 – Chủ tịch Hội học sinh', quote: 'Từ một người khép kín, em đã khám phá khả năng lãnh đạo và đảm nhận Chủ tịch Hội học sinh.', img: 'https://img.youtube.com/vi/NAYd7sM0d-8/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=NAYd7sM0d-8' },
  ];

// Region groupings — AHS-style "campus discover" pattern
const regions = [
  {
    name: 'TP. Hồ Chí Minh',
    desc: 'Hệ thống cơ sở liên cấp Mầm non đến THPT tại Gò Vấp, Bình Tân.',
    img: 'https://media.truongvietanh.com/images/trang-chu-3.webp',
    href: '/co-so',
    campuses: campusLinks.slice(0, 3),
  },
  {
    name: 'Tây Ninh',
    desc: 'Trường Mầm non và Tiểu học tại Cần Giuộc và Nhân Lễ, không gian xanh thoáng đãng.',
    img: 'https://media.truongvietanh.com/images/trang-chu-5.webp',
    href: '/co-so',
    campuses: campusLinks.slice(3, 5),
  },
  {
    name: 'An Giang',
    desc: 'Trường MN và Tiểu học Mekong Xanh tại TP. Rạch Giá — môi trường gắn liền thiên nhiên.',
    img: 'https://media.truongvietanh.com/images/trang-chu-7.webp',
    href: '/co-so',
    campuses: campusLinks.slice(5, 6),
  },
];

const pillars = [
  { num: '01', title: 'Tiếp thu tinh hoa thế giới, nhưng triển khai phù hợp với Việt Nam', lead: 'Trường Việt Anh học hỏi từ thế giới, không phải "bắt chước".', body: 'Chúng ta chọn cái tiến bộ nhất của thế giới, rồi biến nó thành trải nghiệm học tập thực sự vận hành được với học sinh Việt Nam và gia đình Việt Nam.' },
  { num: '02', title: 'Chất lượng cao nhưng không xây trên logic xa xỉ', lead: 'Giáo dục tốt không nên là đặc quyền của nhà giàu.', body: 'Chúng ta xây dựng nền giáo dục chất lượng, nhưng chỉ có giá trị nếu vẫn trong tầm với của những gia đình trung lưu có trách nhiệm.' },
  { num: '03', title: 'Không hy sinh tuổi thơ để đổi lấy thành tích', lead: 'Trẻ em xứng đáng có được niềm vui học tập, sự an toàn cảm xúc, và động lực phát triển bền vững.', body: 'Chúng ta không để đứa trẻ nào phải trả giá bằng sự mệt mỏi để có kết quả.' },
  { num: '04', title: 'Học là để dùng được, sống được, phát triển được', lead: 'Thực dụng là chỉ học cái có giá trị thật, rèn cái dùng được thật, phát triển cái giúp trẻ sống tốt thật.', body: 'Năng lực học tập không chỉ thể hiện trên bài thi, mà phải có thể chuyển hóa thành kết quả dài hạn.' },
  { num: '05', title: 'Tạo ra những lãnh đạo tự thân, không phải đi theo một con đường duy nhất', lead: 'Chúng ta không tạo ra những sản phẩm đồng bộ.', body: 'Chúng ta phát triển những nhà lãnh đạo tự thân đủ tự tin, đủ phẩm chất, đủ năng lực để quyết định những ngã rẽ riêng — kiến tạo cuộc đời và sống hạnh phúc, vinh quang theo cách của riêng mình.' },
];

// AHS-style "Highlights" cards
const highlights = [
  { eyebrow: 'Tuyển sinh 2026–2027', title: 'Quy trình tuyển sinh Trường Việt Anh: Từ đăng ký đến nhập học', body: 'Hướng dẫn đầy đủ các bước đăng ký tuyển sinh, hồ sơ cần chuẩn bị, lịch thi đầu vào và thời hạn nộp hồ sơ năm học 2026–2027.', href: '/tuyen-sinh', img: 'https://media.truongvietanh.com/images/trang-chu-3.webp' },
  { eyebrow: 'Học phí & học bổng', title: 'Học phí Trường Việt Anh 2026–2027 và các chính sách học bổng', body: 'Chi tiết học phí theo từng cấp học, chính sách học bổng dành cho học sinh xuất sắc và ưu đãi Early Bird cho phụ huynh đăng ký sớm.', href: '/hoc-phi', img: 'https://media.truongvietanh.com/images/trang-chu-5.webp' },
  { eyebrow: 'Đời sống học đường', title: 'Một ngày ở Trường Việt Anh: Học sinh làm gì từ 7 giờ sáng đến 5 giờ chiều?', body: 'Lịch học, giờ nghỉ ngơi, hoạt động ngoại khóa, bữa ăn và không gian tự học — tất cả để phụ huynh hình dung rõ cuộc sống của con tại trường.', href: '/tin-tuc', img: 'https://media.truongvietanh.com/images/trang-chu-7.webp' },
];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — hệ thống giáo dục liên cấp song ngữ tại TP.HCM. Tiếng Anh IELTS 6.0-8.0, kỹ năng thế kỷ 21, 99% đỗ ĐH. Học phí lớp 1–12 tại TP.HCM 9,2–13,7 triệu/tháng."
  canonical="https://truongvietanh.com/v3/"
  noPopup={true}
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
>
  <div class="ahs">
    <SiteHeader currentPath="/" />

    <main class="ahs-main">

      <!-- ================= HERO ================= -->
      <section class="ahs-hero">
        <div class="ahs-hero__media" aria-hidden="true">
          <div class="ahs-hero__overlay"></div>
        </div>
        <div class="ahs-hero__inner">
          <span class="ahs-hero__eyebrow">Tuyển sinh 2026–2027 đang mở</span>
          <h1 class="ahs-hero__title">
            <span class="ahs-hero__title-line">Trường Việt Anh</span>
          </h1>
          <p class="ahs-hero__sub">Hệ thống trường học Mầm non, Tiểu học, THCS và THPT</p>
          <p class="ahs-hero__tag"><em>Từ bình thường trở nên phi thường.</em></p>
          <div class="ahs-hero__cta-row">
            <a href="/tuyen-sinh/tham-quan-truong" class="ahs-btn ahs-btn--primary">
              Đặt lịch tham quan
            </a>
            <a href="/hoc-phi" class="ahs-btn ahs-btn--secondary">
              Xem học phí
            </a>
          </div>
          <a href="#thanh-tich" class="ahs-hero__scroll">
            <span>Khám phá</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
        </div>
      </section>

      <!-- ================= STATS RIBBON ================= -->
      <section class="ahs-ribbon" id="thanh-tich">
        <div class="ahs-container">
          <div class="ahs-ribbon__grid">
            <div class="ahs-ribbon__stat">
              <strong>2011</strong>
              <span>Năm hình thành</span>
            </div>
            <div class="ahs-ribbon__stat">
              <strong>6.0+</strong>
              <span>IELTS đầu ra tối thiểu</span>
            </div>
            <div class="ahs-ribbon__stat">
              <strong>99%</strong>
              <span>Học sinh vào đại học</span>
            </div>
            <div class="ahs-ribbon__stat">
              <strong>95%</strong>
              <span>Tiến bộ trên 4 lĩnh vực phát triển</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= POSITIONING / INTRO ================= -->
      <section class="ahs-section ahs-section--intro">
        <div class="ahs-container ahs-narrow">
          <p class="ahs-eyebrow ahs-eyebrow--center">Giới thiệu</p>
          <h2 class="ahs-h2 ahs-h2--center">Một nơi để con thực sự lớn lên</h2>
          <p class="ahs-intro__text">
            <strong>Trường Việt Anh</strong> thành lập năm 2011 tại TP HCM, là lựa chọn yêu thích của các gia đình trí thức trung lưu, khao khát với giáo dục hiện đại, kỳ vọng cao ở kỹ năng và phẩm chất của học sinh. Học sinh Việt Anh trải nghiệm quãng thời gian học tập vui vẻ, hạnh phúc, ra trường với các kỹ năng, phẩm chất lãnh đạo của thế kỷ 21, giành được quyền chọn của riêng mình với các trường đại học danh giá trong và ngoài nước.
          </p>

          <div class="ahs-recognition">
            <span class="ahs-recognition__label">— Được công nhận bởi —</span>
            <div class="ahs-recognition__row">
              <div class="ahs-recognition__item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                <span>Franklin Covey<br/><em>Leader in Me</em></span>
              </div>
              <div class="ahs-recognition__item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span>Oxford<br/><em>University Press</em></span>
              </div>
              <div class="ahs-recognition__item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                <span>British Council<br/><em>IELTS Test Center</em></span>
              </div>
              <div class="ahs-recognition__item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span>Birmingham<br/><em>City University</em></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= DISCOVER OUR CAMPUSES (3 regions) ================= -->
      <section class="ahs-section ahs-section--ivory">
        <div class="ahs-container">
          <header class="ahs-heading">
            <p class="ahs-eyebrow">Hệ thống cơ sở</p>
            <h2 class="ahs-h2">Khám phá các cơ sở Việt Anh</h2>
            <p class="ahs-heading__sub">6 cơ sở trải dài 3 tỉnh thành — chọn cơ sở gần bạn để đặt lịch tham quan.</p>
          </header>

          <div class="ahs-regions">
            {regions.map((r) => (
              <article class="ahs-region">
                <a href={r.href} class="ahs-region__media">
                  <img src={r.img} alt={r.name} loading="lazy" />
                  <span class="ahs-region__chip">{r.name}</span>
                </a>
                <div class="ahs-region__body">
                  <p>{r.desc}</p>
                  <ul class="ahs-region__list">
                    {r.campuses.map((c) => (
                      <li><a href={c.href}>{c.label}</a></li>
                    ))}
                  </ul>
                  <a href={r.href} class="ahs-region__link">
                    Xem cơ sở
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= STUDENT VOICES (Top Stories / Acceptances) ================= -->
      <section class="ahs-section" id="danh-gia">
        <div class="ahs-container">
          <header class="ahs-heading">
            <p class="ahs-eyebrow">Câu chuyện học sinh & phụ huynh</p>
            <h2 class="ahs-h2">Phụ huynh và học sinh nói gì về Trường Việt Anh?</h2>
            <p class="ahs-heading__sub">Những thay đổi thật của trẻ — qua lời kể của chính gia đình các em.</p>
          </header>

          <div class="ahs-voices">
            {testimonials.map((t) => (
              <article class="ahs-voice">
                <div class="ahs-voice__photo">
                  {t.videoUrl ? (
                    <a href={t.videoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Xem video – ${t.name}`}>
                      <img src={t.img || 'https://media.truongvietanh.com/images/phu-huynh-04.webp'} alt={t.name} loading="lazy" />
                      <span class="ahs-voice__play" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg>
                      </span>
                    </a>
                  ) : (
                    <img src={t.img || 'https://media.truongvietanh.com/images/phu-huynh-04.webp'} alt={t.name} loading="lazy" />
                  )}
                </div>
                <div class="ahs-voice__body">
                  <p class="ahs-voice__quote">"{t.quote}"</p>
                  <div class="ahs-voice__attrib">
                    <strong>{t.name}</strong>
                    <span>{t.role}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ================= WHY HERITAGE-style (3 khac biet) ================= -->
      <section class="ahs-section ahs-section--ivory">
        <div class="ahs-container">
          <header class="ahs-heading">
            <p class="ahs-eyebrow">Vì sao chọn Việt Anh</p>
            <h2 class="ahs-h2">3 khác biệt của học sinh Việt Anh</h2>
          </header>

          <div class="ahs-why">
            <article class="ahs-why__row">
              <div class="ahs-why__media">
                <img src="https://media.truongvietanh.com/images/du-an-03.webp" alt="Học sinh tiểu học Việt Anh làm dự án thực tế" loading="lazy" />
                <span class="ahs-why__num">01</span>
              </div>
              <div class="ahs-why__text">
                <p class="ahs-eyebrow">Nội dung học</p>
                <h3 class="ahs-why__title">Nội dung học thực dụng</h3>
                <p>Học sinh được phát triển đầy đủ 16 kỹ năng thế kỷ 21 theo chuẩn WEF, nội dung mà các trường K-12 hàng đầu thế giới đang thực hiện.</p>
                <details class="ahs-more">
                  <summary>Đọc thêm</summary>
                  <p>Nghiên cứu của WEF chỉ ra, trong khi các nước tiên tiến đã đầu tư đủ 16 kỹ năng trong giáo dục, mặt bằng chung của Việt Nam còn đang thiếu hụt. Trường Việt Anh dày công xây dựng chương trình phát triển đầy đủ 16 kỹ năng qua các môn học, hoạt động ngoại khoá và văn hoá trường học. Giáo trình cập nhật mỗi năm để đáp ứng sự biến đổi của xã hội do cách mạng AI mang lại.</p>
                </details>
              </div>
            </article>

            <article class="ahs-why__row ahs-why__row--reverse">
              <div class="ahs-why__media">
                <img src="/giao-vien-ban-ngu.jpg" alt="Giáo viên bản ngữ dạy tiếng Anh cho học sinh Việt Anh" loading="lazy" />
                <span class="ahs-why__num">02</span>
              </div>
              <div class="ahs-why__text">
                <p class="ahs-eyebrow">Năng lực tiếng Anh</p>
                <h3 class="ahs-why__title">Tiếng Anh đủ du học</h3>
                <p>Học sinh đạt tối thiểu IELTS 6.0 trước khi tốt nghiệp THPT — đủ điều kiện xét tuyển hầu hết các đại học trên thế giới.</p>
                <details class="ahs-more">
                  <summary>Đọc thêm</summary>
                  <p>Lộ trình tiếng Anh xuyên suốt từ Mầm Non (100% immersion), Tiểu học (chương trình Oxford), THCS (giao tiếp + học thuật), đến THPT (luyện IELTS). Tổ Tiếng Anh do giáo viên bản ngữ phụ trách. Chương trình tiếng Anh được hợp tác triển khai ở hơn 100 trường công tư khác.</p>
                </details>
              </div>
            </article>

            <article class="ahs-why__row">
              <div class="ahs-why__media">
                <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh Việt Anh thuyết trình, dẫn dắt và trưởng thành sớm" loading="lazy" />
                <span class="ahs-why__num">03</span>
              </div>
              <div class="ahs-why__text">
