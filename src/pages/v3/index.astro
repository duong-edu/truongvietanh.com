<!-- Preload serif font for AHS-style prestige headings -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />

<style is:global>
/* =========================================================
   V3 — AHS-INSPIRED REDESIGN
   - Serif headings (Cormorant Garamond) for prestige feel
   - Editorial whitespace, generous padding
   - Ivory soft sections instead of pure white blocks
   - Big numbers, photography-driven, less yellow
   - Gold accent (#b88a3a) used sparingly as small accents
   ========================================================= */

.ahs{
  --c-navy:       #0a1d56;
  --c-navy-deep:  #050f33;
  --c-navy-soft:  #1a2f70;
  --c-gold:       #b88a3a;
  --c-gold-soft:  #d9b86c;
  --c-yellow:     #f9dd0e;       /* keep brand accent rare */
  --c-ink:        #1a1f2e;
  --c-ink-soft:   #2c3340;
  --c-muted:      #5a6478;
  --c-muted-soft: #8a93a4;
  --c-line:       rgba(10, 29, 86, 0.10);
  --c-line-warm:  rgba(184, 138, 58, 0.25);
  --c-ivory:      #f8f5ef;
  --c-cream:      #faf8f3;
  --c-paper:      #ffffff;
  --maxw:         1240px;
  --maxw-narrow:  860px;
  --radius:       2px;          /* almost square — editorial feel */
  --radius-md:    6px;
  font-family: "Inter", system-ui, sans-serif;
  color: var(--c-ink);
  background: var(--c-paper);
}

.ahs-main{ background: var(--c-paper); }
.ahs-container{ max-width: var(--maxw); margin: 0 auto; padding: 0 1.5rem; }
.ahs-narrow{ max-width: var(--maxw-narrow); }

/* =====================================================
   TYPOGRAPHY — Serif headings (prestige K-12 look)
   ===================================================== */
.ahs-h2{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  line-height: 1.08;
  letter-spacing: -0.005em;
  color: var(--c-navy);
  margin: 0;
}
.ahs-h2--center{ text-align: center; }
.ahs-h2--light{ color: #fff; }

.ahs-eyebrow{
  display: inline-block;
  font-family: "Inter", sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--c-gold);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin: 0 0 0.85rem;
}
.ahs-eyebrow--center{ display: block; text-align: center; }
.ahs-eyebrow--light{ color: var(--c-gold-soft); }
.ahs-eyebrow--gold{ color: var(--c-gold-soft); }
.ahs-eyebrow--sm{ font-size: 0.65rem; margin-bottom: 0.5rem; }

.ahs-heading{
  text-align: center;
  max-width: 760px;
  margin: 0 auto 3rem;
}
.ahs-heading--light *{ color: #fff; }
.ahs-heading__sub{
  font-size: 1.05rem;
  color: var(--c-muted);
  line-height: 1.65;
  margin: 1rem auto 0;
  max-width: 620px;
}
.ahs-heading--light .ahs-heading__sub{ color: rgba(255, 255, 255, 0.78); }

/* Section spacing — generous, editorial */
.ahs-section{ padding: 6rem 0; }
.ahs-section--intro{ padding: 5rem 0; }
.ahs-section--ivory{ background: var(--c-ivory); }
.ahs-section--dark{
  background: linear-gradient(180deg, var(--c-navy-deep), var(--c-navy));
  color: #fff;
}

/* =====================================================
   HERO — full-bleed image, centered serif title
   ===================================================== */
.ahs-hero{
  position: relative;
  min-height: 78vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
  isolation: isolate;
  overflow: hidden;
}
.ahs-hero__media{
  position: absolute;
  inset: 0;
  background: url('/hero-bg-home.webp') center/cover no-repeat, var(--c-navy-deep);
  z-index: -1;
}
.ahs-hero__overlay{
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5,15,51,0.55) 0%, rgba(5,15,51,0.7) 70%, rgba(5,15,51,0.85) 100%);
}
.ahs-hero__inner{
  position: relative;
  max-width: 820px;
  padding: 2rem 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.ahs-hero__eyebrow{
  font-family: "Inter", sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--c-gold-soft);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--c-gold);
}
.ahs-hero__title{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 500;
  font-size: clamp(3.2rem, 8vw, 6rem);
  line-height: 1;
  margin: 0.5rem 0 0;
  letter-spacing: -0.01em;
  color: #fff;
}
.ahs-hero__title-line{ display: block; }
.ahs-hero__sub{
  font-size: clamp(1rem, 1.5vw, 1.15rem);
  font-weight: 400;
  color: rgba(255,255,255,0.85);
  margin: 0.75rem 0 0;
  max-width: 560px;
  line-height: 1.55;
}
.ahs-hero__tag{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-style: italic;
  font-size: clamp(1.15rem, 2vw, 1.45rem);
  color: var(--c-gold-soft);
  margin: 0.5rem 0 0;
  font-weight: 500;
}
.ahs-hero__cta-row{
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  justify-content: center;
  margin-top: 2rem;
}
.ahs-hero__scroll{
  margin-top: 2.5rem;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: rgba(255,255,255,0.7);
  font-size: 0.75rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}
.ahs-hero__scroll:hover{ color: var(--c-gold-soft); }
.ahs-hero__scroll svg{ animation: ahsBounce 2s ease-in-out infinite; }
@keyframes ahsBounce {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(4px); }
}

/* =====================================================
   BUTTONS — square, editorial
   ===================================================== */
.ahs-btn{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 2rem;
  border-radius: var(--radius);
  font-weight: 600;
  font-size: 0.92rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1.5px solid transparent;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.ahs-btn--primary{
  background: var(--c-gold);
  color: #fff;
  border-color: var(--c-gold);
}
.ahs-btn--primary:hover{
  background: var(--c-gold-soft);
  border-color: var(--c-gold-soft);
  transform: translateY(-1px);
}
.ahs-btn--secondary{
  background: transparent;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.5);
}
.ahs-btn--secondary:hover{
  background: rgba(255, 255, 255, 0.1);
  border-color: #fff;
}
.ahs-btn--dark{
  background: var(--c-navy);
  color: #fff;
  border-color: var(--c-navy);
}
.ahs-btn--dark:hover{
  background: var(--c-navy-soft);
  border-color: var(--c-navy-soft);
}

/* =====================================================
   STATS RIBBON — dark band, big numbers
   ===================================================== */
.ahs-ribbon{
  background: linear-gradient(180deg, var(--c-navy), var(--c-navy-deep));
  color: #fff;
  padding: 3.25rem 0;
  border-top: 1px solid var(--c-line-warm);
  border-bottom: 1px solid var(--c-line-warm);
}
.ahs-ribbon__grid{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.ahs-ribbon__stat{
  text-align: center;
  padding: 0 1rem;
  border-right: 1px solid rgba(255, 255, 255, 0.12);
}
.ahs-ribbon__stat:last-child{ border-right: none; }
.ahs-ribbon__stat strong{
  display: block;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 500;
  font-size: clamp(2.5rem, 5vw, 4rem);
  line-height: 1;
  color: var(--c-gold-soft);
  letter-spacing: -0.02em;
  margin-bottom: 0.4rem;
}
.ahs-ribbon__stat span{
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  font-weight: 500;
}

/* =====================================================
   INTRO + RECOGNITION
   ===================================================== */
.ahs-intro__text{
  text-align: center;
  font-size: 1.1rem;
  line-height: 1.85;
  color: var(--c-muted);
  margin: 1.5rem 0 3rem;
}
.ahs-intro__text strong{ color: var(--c-ink); font-weight: 600; }

.ahs-recognition{
  border-top: 1px solid var(--c-line-warm);
  padding-top: 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}
.ahs-recognition__label{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-style: italic;
  font-size: 0.92rem;
  color: var(--c-gold);
  letter-spacing: 0.08em;
}
.ahs-recognition__row{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  width: 100%;
  max-width: 760px;
}
.ahs-recognition__item{
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.5rem;
  color: var(--c-navy);
  font-size: 0.82rem;
  line-height: 1.4;
  font-weight: 600;
}
.ahs-recognition__item em{
  font-style: normal;
  font-weight: 400;
  color: var(--c-muted);
}
.ahs-recognition__item svg{ color: var(--c-navy); }

/* =====================================================
   REGIONS — "Discover Our Campuses"-style 3 image cards
   ===================================================== */
.ahs-regions{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.75rem;
}
.ahs-region{
  background: var(--c-paper);
  border: 1px solid var(--c-line);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.ahs-region:hover{
  transform: translateY(-6px);
  box-shadow: 0 24px 50px rgba(10, 29, 86, 0.13);
}
.ahs-region__media{
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  display: block;
  text-decoration: none;
}
.ahs-region__media img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.ahs-region:hover .ahs-region__media img{ transform: scale(1.06); }
.ahs-region__chip{
  position: absolute;
  bottom: 1.25rem;
  left: 1.25rem;
  background: var(--c-navy);
  color: #fff;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-size: 1.4rem;
  font-weight: 600;
  padding: 0.45rem 1.1rem;
  border-radius: var(--radius);
}
.ahs-region__body{
  padding: 1.75rem 1.75rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  flex: 1;
}
.ahs-region__body p{
  color: var(--c-muted);
  line-height: 1.65;
  font-size: 0.95rem;
  margin: 0;
}
.ahs-region__list{
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  border-top: 1px solid var(--c-line);
  padding-top: 1rem;
}
.ahs-region__list a{
  color: var(--c-navy);
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 500;
  line-height: 1.4;
  transition: color 0.15s;
}
.ahs-region__list a:hover{ color: var(--c-gold); }
.ahs-region__link{
  margin-top: auto;
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--c-gold);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  padding-top: 0.5rem;
}
.ahs-region__link svg{ transition: transform 0.2s; }
.ahs-region__link:hover svg{ transform: translateX(4px); }

/* =====================================================
   VOICES (testimonials) — large editorial cards
   ===================================================== */
.ahs-voices{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.75rem;
}
.ahs-voice{
  background: var(--c-paper);
  border: 1px solid var(--c-line);
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.3s, transform 0.3s;
}
.ahs-voice:hover{
  box-shadow: 0 20px 40px rgba(10,29,86,0.1);
  transform: translateY(-4px);
}
.ahs-voice__photo{
  aspect-ratio: 4 / 3;
  background: var(--c-ivory);
  position: relative;
  overflow: hidden;
}
.ahs-voice__photo a, .ahs-voice__photo img{
  display: block;
  width: 100%;
  height: 100%;
}
.ahs-voice__photo img{
  object-fit: cover;
  transition: transform 0.5s ease;
}
.ahs-voice:hover .ahs-voice__photo img{ transform: scale(1.05); }
.ahs-voice__play{
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 29, 86, 0.25);
  color: #fff;
  opacity: 1;
  transition: background 0.2s;
}
.ahs-voice__photo a:hover .ahs-voice__play{ background: rgba(10, 29, 86, 0.45); }
.ahs-voice__play svg{
  background: var(--c-gold);
  border-radius: 50%;
  padding: 14px;
  width: 56px;
  height: 56px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.25);
}
.ahs-voice__body{
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  flex: 1;
}
.ahs-voice__quote{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-style: italic;
  font-size: 1.15rem;
  line-height: 1.5;
  color: var(--c-ink);
  margin: 0;
  flex: 1;
}
.ahs-voice__attrib{
  border-top: 1px solid var(--c-line);
  padding-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.ahs-voice__attrib strong{
  color: var(--c-navy);
  font-size: 0.95rem;
  font-weight: 700;
}
.ahs-voice__attrib span{
  color: var(--c-muted);
  font-size: 0.82rem;
}

/* =====================================================
   WHY (3 differentiators) — alternating editorial rows
   ===================================================== */
.ahs-why{
  display: flex;
  flex-direction: column;
  gap: 5rem;
}
.ahs-why__row{
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: 4rem;
  align-items: center;
}
.ahs-why__row--reverse .ahs-why__media{ order: 2; }
.ahs-why__row--reverse .ahs-why__text{ order: 1; }
.ahs-why__media{
  position: relative;
  aspect-ratio: 5 / 4;
  background: var(--c-ivory);
  overflow: hidden;
}
.ahs-why__media img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ahs-why__num{
  position: absolute;
  bottom: -1.25rem;
  right: -1.25rem;
  width: 80px;
  height: 80px;
  background: var(--c-gold);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 500;
  font-size: 2rem;
  letter-spacing: -0.02em;
}
.ahs-why__text{
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.ahs-why__title{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  line-height: 1.15;
  color: var(--c-navy);
  margin: 0;
}
.ahs-why__text p{
  color: var(--c-muted);
  font-size: 1.05rem;
  line-height: 1.75;
  margin: 0;
}
.ahs-more summary{
  cursor: pointer;
  list-style: none;
  color: var(--c-gold);
  font-weight: 700;
  font-size: 0.78rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  margin-top: 0.5rem;
}
.ahs-more summary::-webkit-details-marker{ display: none; }
.ahs-more summary::after{ content: " +"; font-size: 1rem; line-height: 1; }
.ahs-more[open] summary::after{ content: " –"; }
.ahs-more[open] summary{ color: var(--c-navy); }
.ahs-more p{
  margin-top: 1rem !important;
  padding-top: 1rem;
  border-top: 1px solid var(--c-line);
  font-size: 0.95rem !important;
  color: var(--c-muted) !important;
}

/* =====================================================
   PROGRAMS — minimal text list grid
   ===================================================== */
.ahs-programs{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}
.ahs-program{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 1.5rem;
  border: 1px solid var(--c-line);
  background: var(--c-paper);
  text-decoration: none;
  color: var(--c-navy);
  transition: all 0.2s ease;
}
.ahs-program:hover{
  background: var(--c-navy);
  color: #fff;
  border-color: var(--c-navy);
}
.ahs-program__label{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  font-size: 1.2rem;
  letter-spacing: 0;
}
.ahs-program__arrow{ color: var(--c-gold); display: flex; transition: transform 0.2s, color 0.2s; }
.ahs-program:hover .ahs-program__arrow{ transform: translateX(4px); color: var(--c-gold-soft); }

/* =====================================================
   PILLARS (philosophy accordion) — dark background
   ===================================================== */
.ahs-pillars{
  max-width: 920px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid rgba(255,255,255,0.12);
}
.ahs-pillar{
  border-bottom: 1px solid rgba(255,255,255,0.12);
}
.ahs-pillar summary{
  list-style: none;
  cursor: pointer;
  padding: 1.6rem 0;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  color: rgba(255,255,255,0.92);
  transition: color 0.2s;
}
.ahs-pillar summary:hover{ color: var(--c-gold-soft); }
.ahs-pillar summary::-webkit-details-marker{ display: none; }
.ahs-pillar__num{
  flex-shrink: 0;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-size: 1.5rem;
  color: var(--c-gold-soft);
  font-weight: 500;
  letter-spacing: -0.02em;
  min-width: 3rem;
}
.ahs-pillar__title{
  flex: 1;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 500;
  font-size: clamp(1.15rem, 2vw, 1.55rem);
  line-height: 1.3;
  color: #fff;
}
.ahs-pillar__chev{
  flex-shrink: 0;
  color: rgba(255,255,255,0.5);
  transition: transform 0.3s ease, color 0.2s;
}
.ahs-pillar[open] .ahs-pillar__chev{
  transform: rotate(180deg);
  color: var(--c-gold-soft);
}
.ahs-pillar__body{
  padding: 0 0 1.75rem 4.5rem;
  color: rgba(255,255,255,0.78);
  line-height: 1.8;
  max-width: 720px;
}
.ahs-pillar__body p{ margin: 0 0 0.6rem; font-size: 1rem; }
.ahs-pillar__lead{
  color: var(--c-gold-soft) !important;
  font-style: italic;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-size: 1.2rem !important;
  margin-bottom: 1rem !important;
}

/* =====================================================
   HIGHLIGHTS — editorial 3-card row with photo top
   ===================================================== */
.ahs-highlights{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.75rem;
}
.ahs-highlight{
  background: var(--c-paper);
  border: 1px solid var(--c-line);
  text-decoration: none;
  color: var(--c-ink);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s, box-shadow 0.3s;
}
.ahs-highlight:hover{
  transform: translateY(-4px);
  box-shadow: 0 18px 40px rgba(10,29,86,0.1);
}
.ahs-highlight__media{
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--c-ivory);
}
.ahs-highlight__media img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.ahs-highlight:hover .ahs-highlight__media img{ transform: scale(1.05); }
.ahs-highlight__body{
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
}
.ahs-highlight__title{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  font-size: 1.4rem;
  line-height: 1.25;
  color: var(--c-navy);
  margin: 0;
}
.ahs-highlight__body p{
  color: var(--c-muted);
  font-size: 0.95rem;
  line-height: 1.65;
  margin: 0;
  flex: 1;
}
.ahs-highlight__cta{
  margin-top: 0.5rem;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--c-gold);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.ahs-highlight:hover .ahs-highlight__cta svg{ transform: translateX(3px); }
.ahs-highlight__cta svg{ transition: transform 0.2s; }

/* =====================================================
   CTA SECTION (dark with form)
   ===================================================== */
.ahs-section--cta{
  background:
    linear-gradient(135deg, var(--c-navy-deep), var(--c-navy));
  color: #fff;
  position: relative;
  overflow: hidden;
}
.ahs-section--cta::before{
  content: "";
  position: absolute;
  top: -200px; right: -200px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(184, 138, 58, 0.18), transparent 70%);
}
.ahs-cta{
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: 4rem;
  align-items: center;
  position: relative;
  z-index: 1;
}
.ahs-cta__desc{
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.82);
  margin: 1rem 0 1.5rem;
}
.ahs-cta__list{
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.ahs-cta__list li{
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  color: rgba(255,255,255,0.9);
  font-size: 0.98rem;
}
.ahs-cta__list svg{ flex-shrink: 0; margin-top: 0.2rem; color: var(--c-gold-soft); }
.ahs-cta__list--ink li{ color: var(--c-ink); }
.ahs-cta__list--ink svg{ color: var(--c-gold); }

.ahs-cta__form{
  background: #fff;
  padding: 2rem;
  border-radius: var(--radius-md);
  box-shadow: 0 30px 60px rgba(0,0,0,0.3);
}

.ahs-section--final{
  background: var(--c-cream);
}
.ahs-section--final .ahs-cta__form{
  box-shadow: 0 20px 40px rgba(10, 29, 86, 0.08);
  border: 1px solid var(--c-line);
}

/* =====================================================
   FAQ
   ===================================================== */
.ahs-faq{
  max-width: 820px;
  margin: 0 auto;
  border-top: 1px solid var(--c-line);
}
.ahs-faq__item{ border-bottom: 1px solid var(--c-line); }
.ahs-faq__item summary{
  list-style: none;
  cursor: pointer;
  padding: 1.5rem 2.5rem 1.5rem 0;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  font-size: 1.25rem;
  color: var(--c-navy);
  position: relative;
  transition: color 0.2s;
}
.ahs-faq__item summary::-webkit-details-marker{ display: none; }
.ahs-faq__item summary:hover{ color: var(--c-gold); }
.ahs-faq__item summary::after{
  content: "+";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  color: var(--c-gold);
  font-size: 1.5rem;
  font-weight: 300;
  transition: transform 0.2s;
}
.ahs-faq__item[open] summary::after{ content: "–"; }
.ahs-faq__item p{
  padding: 0 0 1.75rem;
  color: var(--c-muted);
  line-height: 1.75;
  font-size: 0.98rem;
  margin: 0;
  max-width: 720px;
}
.ahs-faq__item a{ color: var(--c-gold); font-weight: 600; }

/* =====================================================
   PAA cards
   ===================================================== */
.ahs-paa{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
.ahs-paa__card{
  background: var(--c-paper);
  border: 1px solid var(--c-line);
  padding: 1.75rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  text-decoration: none;
  color: var(--c-ink);
  transition: all 0.25s ease;
  position: relative;
}
.ahs-paa__card::before{
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 3px;
  background: var(--c-gold);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}
.ahs-paa__card:hover{
  border-color: var(--c-gold);
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(10,29,86,0.08);
}
.ahs-paa__card:hover::before{ transform: scaleX(1); }
.ahs-paa__icon{ font-size: 1.6rem; line-height: 1; }
.ahs-paa__card strong{
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-weight: 600;
  color: var(--c-navy);
  font-size: 1.15rem;
  line-height: 1.3;
}
.ahs-paa__card span:not(.ahs-paa__icon){
  color: var(--c-muted);
  font-size: 0.9rem;
  line-height: 1.55;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

/* Tablet */
@media (max-width: 1024px) {
  .ahs-section{ padding: 4.5rem 0; }
  .ahs-regions{ grid-template-columns: repeat(2, 1fr); }
  .ahs-voices{ grid-template-columns: repeat(2, 1fr); }
  .ahs-highlights{ grid-template-columns: 1fr; max-width: 720px; margin: 0 auto; }
  .ahs-paa{ grid-template-columns: repeat(2, 1fr); }
  .ahs-cta{ grid-template-columns: 1fr; gap: 2.5rem; }
  .ahs-programs{ grid-template-columns: repeat(3, 1fr); }
  .ahs-recognition__row{ grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .ahs-why__row{ gap: 2.5rem; }
}

/* Mobile */
@media (max-width: 720px) {
  .ahs-section{ padding: 3.5rem 0; }
  .ahs-section--intro{ padding: 3rem 0; }
  .ahs-container{ padding: 0 1.25rem; }
  .ahs-heading{ margin-bottom: 2rem; }
  .ahs-heading__sub{ font-size: 0.95rem; }

  /* Hero */
  .ahs-hero{ min-height: 70vh; }
  .ahs-hero__title{ font-size: 3rem; }
  .ahs-hero__sub{ font-size: 0.95rem; }
  .ahs-hero__tag{ font-size: 1.1rem; }
  .ahs-hero__eyebrow{ font-size: 0.7rem; letter-spacing: 0.2em; }
  .ahs-hero__cta-row{ flex-direction: column; width: 100%; margin-top: 1.5rem; }
  .ahs-btn{ width: 100%; padding: 1rem 1.5rem; font-size: 0.85rem; }

  /* Ribbon — 2x2 */
  .ahs-ribbon{ padding: 2.25rem 0; }
  .ahs-ribbon__grid{ grid-template-columns: repeat(2, 1fr); gap: 1.5rem 0; }
  .ahs-ribbon__stat{ padding: 0 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 1.5rem; }
  .ahs-ribbon__stat:nth-child(2n){ border-right: none; }
  .ahs-ribbon__stat:nth-child(n+3){ border-bottom: none; padding-bottom: 0; padding-top: 1.5rem; }
  .ahs-ribbon__stat strong{ font-size: 2.4rem; }
  .ahs-ribbon__stat span{ font-size: 0.72rem; }

  /* Intro */
  .ahs-intro__text{ font-size: 0.98rem; line-height: 1.75; }
  .ahs-recognition__row{ grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .ahs-recognition__item{ font-size: 0.78rem; }

  /* Regions / Voices / Highlights / PAA / Programs */
  .ahs-regions,
  .ahs-voices,
  .ahs-highlights,
  .ahs-paa{ grid-template-columns: 1fr; gap: 1.25rem; }
  .ahs-programs{ grid-template-columns: repeat(2, 1fr); }

  /* Why */
  .ahs-why{ gap: 3rem; }
  .ahs-why__row{
    grid-template-columns: 1fr;
