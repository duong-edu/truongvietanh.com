---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('ngoai-khoa');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Tây Ninh, An Giang. 20+ CLB ngoại khóa phát triển toàn diện.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh có bao nhiêu CLB ngoại khóa?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh có hơn 20 CLB ngoại khóa thuộc 4 nhóm: Thể thao & Vận động, Nghệ thuật & Sáng tạo, STEM & Công nghệ, Kỹ năng sống & Lãnh đạo." }
      },
      {
        "@type": "Question",
        "name": "Học phí ngoại khóa có tính riêng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Các CLB cơ bản đã bao gồm trong học phí. Một số CLB chuyên sâu (Robotics, Piano, Võ thuật) có phụ thu từ 300.000-800.000đ/tháng tùy bộ môn." }
      },
      {
        "@type": "Question",
        "name": "Học sinh mấy tuổi có thể tham gia CLB ngoại khóa?",
        "acceptedAnswer": { "@type": "Answer", "text": "Từ 4 tuổi (Mầm non lớn) có thể tham gia các CLB vận động nhẹ. Từ lớp 1 trở lên được đăng ký tất cả CLB phù hợp lứa tuổi." }
      },
      {
        "@type": "Question",
        "name": "Ngoại khóa diễn ra vào thời gian nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Các buổi ngoại khóa diễn ra sau giờ học chính khóa (15h30-17h00) từ thứ Hai đến thứ Sáu, và sáng thứ Bảy cho một số CLB đặc biệt." }
      },
      {
        "@type": "Question",
        "name": "Con tôi có thể đăng ký mấy CLB cùng lúc?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học sinh có thể đăng ký tối đa 3 CLB/học kỳ để đảm bảo cân bằng giữa học tập và hoạt động ngoại khóa. Trường khuyến khích chọn 1-2 CLB để tập trung phát triển." }
      },
      {
        "@type": "Question",
        "name": "Ngoại khóa có ảnh hưởng đến kết quả học tập không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học sinh tham gia ngoại khóa thường có kết quả tốt hơn nhờ rèn kỷ luật và quản lý thời gian. Trường theo dõi sát và tư vấn điều chỉnh nếu cần." }
      },
      {
        "@type": "Question",
        "name": "Danh sách CLB ngoại khóa cụ thể gồm những gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Thể thao: bóng đá, bóng rổ, bơi lội, cầu lông, võ thuật, dance. Nghệ thuật: guitar, piano, mỹ thuật, kịch. STEM: robotics, coding, Arduino, 3D printing. Kỹ năng sống: Debate, MUN, Leader in Me. Tổng 20+ CLB." }
      },
      {
        "@type": "Question",
        "name": "Hoạt động ngoại khóa có mất thêm phí không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ngoại khóa cơ bản đã bao gồm trong học phí. Một số CLB chuyên sâu có phí bổ sung 200-500k/tháng. Phụ huynh được thông báo rõ trước khi đăng ký." }
      },
      {
        "@type": "Question",
        "name": "Làm sao đăng ký cho con tham gia CLB?",
        "acceptedAnswer": { "@type": "Answer", "text": "Phụ huynh đăng ký qua app trường, form trực tuyến, hoặc qua giáo viên chủ nhiệm đầu mỗi học kỳ. Mỗi CLB cho trải nghiệm 1-2 buổi miễn phí trước khi đăng ký chính thức." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Ngoại khóa", "item": "https://truongvietanh.com/ngoai-khoa" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Ngoại Khóa Việt Anh – 20+ CLB Thể Thao, STEM, Nghệ Thuật"}
  description={cmsPage?.description || "Khám phá 20+ CLB ngoại khóa tại Trường Việt Anh: Thể thao, Nghệ thuật, STEM, Kỹ năng sống. Phát triển toàn diện từ Mầm Non đến THPT."}
  canonical="https://truongvietanh.com/ngoai-khoa"
  ogImage="https://media.truongvietanh.com/images/extra-gal4.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero nk-hero-bg">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Ngoại khóa</span>
          </nav>

          <h1 class="gi-h1">Chương Trình Ngoại Khóa Trường Việt Anh: 20+ CLB Phát Triển Toàn Diện</h1>
          <p class="gi-subtitle">Thể thao, Nghệ thuật, STEM, Kỹ năng sống — Mỗi học sinh đều tìm được đam mê</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>


          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>20+</strong> CLB</div>
            <div class="gi-badge"><strong>4</strong> nhóm</div>
            <div class="gi-badge"><strong>95%</strong> HS tham gia</div>
            <div class="gi-badge"><strong>50+</strong> giải thưởng/năm</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký trải nghiệm CLB miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="ngoai-khoa-form"
              funnelCode="ngoai-khoa-pillar"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tong-quan">Tổng quan ngoại khóa</a></li>
          <li><a href="#the-thao">Thể thao & Vận động</a></li>
          <li><a href="#nghe-thuat">Nghệ thuật & Sáng tạo</a></li>
          <li><a href="#stem">STEM & Công nghệ</a></li>
          <li><a href="#ky-nang-song">Kỹ năng sống & Lãnh đạo</a></li>
          <li><a href="#lich-dang-ky">Lịch hoạt động & Đăng ký</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#ngoai-khoa-form-ngoai-khoa-pillar" class="gi-toc-cta">Đăng ký trải nghiệm</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tổng quan -->
        <section id="tong-quan" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Tổng quan chương trình ngoại khóa tại Trường Việt Anh</h2>
          <p>Trường Việt Anh tổ chức hơn 20 CLB ngoại khóa thuộc 4 nhóm chính: Thể thao & Vận động, Nghệ thuật & Sáng tạo, STEM & Công nghệ, Kỹ năng sống & Lãnh đạo. Chương trình ngoại khóa được thiết kế để mỗi học sinh — từ Mầm Non đến THPT — đều tìm được hoạt động phù hợp với sở thích và năng lực cá nhân.</p>
          <p>Khác với nhiều trường chỉ tổ chức ngoại khóa mang tính phong trào, Trường Việt Anh xây dựng chương trình ngoại khóa có lộ trình rõ ràng theo từng năm. Học sinh được đánh giá tiến bộ định kỳ, tham gia thi đấu giải cấp quận/thành phố, và có cơ hội đại diện trường tại <a href="/thanh-tich-hoc-tap">các cuộc thi quốc gia</a>. Chương trình ngoại khóa được tích hợp chặt chẽ với <a href="/cap-hoc">chương trình đào tạo chính khóa các cấp</a>, giúp học sinh phát triển toàn diện cả trí tuệ lẫn thể chất.</p>

          <div class="gi-values-grid">
            <h3>4 nhóm ngoại khóa chính</h3>
            <div class="nk-group-items">
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9917;</span>
                <strong>Thể thao & Vận động</strong>
                <p>Bóng đá, bơi lội, võ thuật, bóng rổ, cầu lông</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9836;</span>
                <strong>Nghệ thuật & Sáng tạo</strong>
                <p>Piano, guitar, vẽ, múa, nhạc kịch, photography</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9881;</span>
                <strong>STEM & Công nghệ</strong>
                <p>Robotics, Coding, AI Lab, thí nghiệm khoa học</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9733;</span>
                <strong>Kỹ năng sống & Lãnh đạo</strong>
                <p>Debate, MUN, thuyết trình, tình nguyện, scout</p>
              </div>
            </div>
          </div>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>20+</strong>
              <span>CLB hoạt động</span>
            </div>
            <div class="gi-evidence-item">
              <strong>95%</strong>
              <span>HS tham gia ngoại khóa</span>
            </div>
            <div class="gi-evidence-item">
              <strong>50+</strong>
              <span>Giải thưởng/năm</span>
            </div>
            <div class="gi-evidence-item">
              <strong>30+</strong>
              <span>HLV chuyên nghiệp</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Thể thao -->
        <section id="the-thao" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span>Thể thao & Vận động — Rèn sức khỏe, kỷ luật và tinh thần đồng đội</h2>
          <p>Chương trình thể thao tại Trường Việt Anh bao gồm 6 bộ môn chính: bóng đá, bơi lội, võ thuật (Taekwondo/Karate), bóng rổ, cầu lông và thể dục nhịp điệu. Mỗi bộ môn có huấn luyện viên chuyên nghiệp, lịch tập cố định 2-3 buổi/tuần, và lộ trình thi đấu rõ ràng.</p>
          <p>Học sinh không chỉ rèn luyện thể chất mà còn học được tính kỷ luật, tinh thần đồng đội và khả năng chịu áp lực — những kỹ năng quan trọng cho cuộc sống sau này.</p>

          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Bộ môn</th>
                  <th>Độ tuổi</th>
                  <th>Lịch tập</th>
                  <th>Thành tích nổi bật</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Bóng đá</strong></td>
                  <td>Từ lớp 1</td>
                  <td>3 buổi/tuần</td>
                  <td>HCV giải Futsal HS cấp Quận 2024</td>
                </tr>
                <tr>
                  <td><strong>Bơi lội</strong></td>
                  <td>Từ 4 tuổi</td>
                  <td>2 buổi/tuần</td>
                  <td>100% HS biết bơi trước lớp 3</td>
                </tr>
                <tr>
                  <td><strong>Võ thuật</strong></td>
                  <td>Từ lớp 1</td>
                  <td>2 buổi/tuần</td>
                  <td>12 HCV giải Taekwondo TP 2024</td>
                </tr>
                <tr>
                  <td><strong>Bóng rổ</strong></td>
                  <td>Từ lớp 3</td>
                  <td>3 buổi/tuần</td>
                  <td>Top 4 giải HS cấp Thành phố</td>
                </tr>
                <tr>
                  <td><strong>Cầu lông</strong></td>
                  <td>Từ lớp 2</td>
                  <td>2 buổi/tuần</td>
                  <td>Giải Nhất đơn nam U12 cấp Quận</td>
                </tr>
              </tbody>
            </table>
          </div>

          <img src="https://media.truongvietanh.com/images/the-thao-01.webp" alt="Học sinh chơi thể thao tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Trường Việt Anh đầu tư cơ sở vật chất thể thao bài bản: sân bóng đá mini cỏ nhân tạo, hồ bơi tiêu chuẩn có mái che, phòng tập võ chuyên dụng. Tất cả hoạt động thể thao đều có nhân viên y tế túc trực đảm bảo an toàn cho học sinh. Xem thêm <a href="/thanh-tich-hoc-tap">thành tích thể thao nổi bật</a> của học sinh Trường Việt Anh.</p>
        </section>

        <!-- Section 3: Nghệ thuật -->
        <section id="nghe-thuat" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Nghệ thuật & Sáng tạo — Nuôi dưỡng tâm hồn và tư duy sáng tạo</h2>
          <p>Chương trình nghệ thuật tại Trường Việt Anh gồm 6 bộ môn: Piano, Guitar, Vẽ mỹ thuật, Múa (Ballet/Hiện đại), Nhạc kịch (Musical Theatre) và Photography. Giáo viên đều tốt nghiệp chuyên ngành từ Nhạc viện TP.HCM, Đại học Mỹ thuật hoặc có chứng chỉ quốc tế ABRSM/Trinity.</p>
          <p>Mục tiêu không phải đào tạo nghệ sĩ chuyên nghiệp, mà giúp học sinh phát triển tư duy sáng tạo, khả năng biểu đạt cảm xúc và sự tự tin khi biểu diễn trước đám đông — kỹ năng thiết yếu trong thế kỷ 21.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>Âm nhạc</h4>
              <ul>
                <li><strong>Piano:</strong> Từ cơ bản đến Grade 5 ABRSM. Phòng tập riêng với đàn Yamaha.</li>
                <li><strong>Guitar:</strong> Classic & Acoustic. Biểu diễn hàng tháng tại sân trường.</li>
                <li><strong>Nhạc kịch:</strong> Kết hợp hát, diễn xuất, vũ đạo. Show diễn cuối năm.</li>
                <li><strong>Hợp xướng:</strong> Đội hợp xướng trường tham gia các sự kiện cộng đồng.</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Mỹ thuật & Biểu diễn</h4>
              <ul>
                <li><strong>Vẽ mỹ thuật:</strong> Phác thảo, màu nước, acrylic. Triển lãm tranh học sinh hàng năm.</li>
                <li><strong>Múa:</strong> Ballet cơ bản (Mầm non-TH), múa hiện đại&nbsp;(THCS-THPT).</li>
                <li><strong>Photography:</strong> Từ smartphone đến DSLR. Học bố cục, ánh sáng, hậu kỳ.</li>
                <li><strong>Thủ công sáng tạo:</strong> Origami, gốm, DIY projects theo chủ đề.</li>
              </ul>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/vui-ve-01.webp" alt="Hoạt động ngoại khóa vui nhộn tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Mỗi học kỳ, trường tổ chức <strong>"Đêm Nghệ Thuật Việt Anh"</strong> — sự kiện biểu diễn quy mô toàn trường để học sinh trình diễn thành quả trước phụ huynh và bạn bè. Đây là cơ hội quý giá để các em rèn luyện sự tự tin và tinh thần sáng tạo.</p>
        </section>

        <!-- Section 4: STEM -->
        <section id="stem" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0018 8 6 6 0 006 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 018.91 14"/></svg></span>STEM & Công nghệ — Trang bị kỹ năng số cho tương lai</h2>
          <p>CLB STEM tại Trường Việt Anh bao gồm Robotics, Coding (lập trình), AI Lab và thí nghiệm khoa học. Chương trình được xây dựng theo chuẩn quốc tế NGSS (Next Generation Science Standards), giúp học sinh làm quen với tư duy giải quyết vấn đề từ sớm.</p>
          <p>Đặc biệt, Trường Việt Anh là một trong số ít trường phổ thông tại TP.HCM có phòng AI Lab riêng biệt — nơi học sinh THCS và THPT được thực hành với ChatGPT, xây dựng chatbot đơn giản, và hiểu nguyên lý hoạt động của trí tuệ nhân tạo.</p>

          <div class="gi-roadmap">
            <h3>Lộ trình STEM theo cấp học</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">MN</div>
                <strong>Mầm non (4-5 tuổi)</strong>
                <p>STEM Play — Xây dựng, lắp ráp đơn giản với LEGO Duplo. Thí nghiệm khoa học vui (núi lửa, pha màu).</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TH</div>
