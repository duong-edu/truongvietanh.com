---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('tuyen-sinh');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Tây Ninh, An Giang. Tuyển sinh 2026-2027.",
    "telephone": "0916961409",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Trường Việt Anh tuyển sinh những cấp học nào?", "acceptedAnswer": { "@type": "Answer", "text": "4 cấp: Mầm non (từ 1 tuổi), Tiểu học (lớp 1–5), THCS (lớp 6–9) và THPT (lớp 10–12). Tiểu học, THCS và THPT học tại 2 cơ sở chính thức ở TP.HCM (Gò Vấp, Bình Tân); mầm non học tại các trường cùng chủ đầu tư và trường do Việt Anh phụ trách vận hành." } },
      { "@type": "Question", "name": "Quy trình đăng ký tuyển sinh như thế nào?", "acceptedAnswer": { "@type": "Answer", "text": "4 bước: Đăng ký online → Tham quan trường → Kiểm tra đầu vào (tuỳ cấp) → Hoàn tất hồ sơ nhập học. Trung bình 5-7 ngày." } },
      { "@type": "Question", "name": "Học phí bao nhiêu?", "acceptedAnswer": { "@type": "Answer", "text": "Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Cùng năm học, trường quốc tế tại TP.HCM ở mức 227,8–999,3 triệu đồng/năm." } },
      { "@type": "Question", "name": "Có chính sách học bổng không?", "acceptedAnswer": { "@type": "Answer", "text": "Có, gồm 9 chính sách chia làm hai nhóm. Ưu đãi học phí do cha mẹ quyết định: đóng trọn năm giảm 6%, đóng trọn học kỳ giảm 2%, anh chị em ruột giảm 50% cho con thứ hai và 25% cho con thứ ba, Early Bird đóng trước nhiều năm giảm từ 6–46% kèm khoá giá học phí năm đầu. Năm học bổng do học sinh tự giành: GRIT, CHAMPIONS, LEADERS, TALENTS, cùng quỹ LOVE cho gia đình gặp biến cố. Mọi mức tính trên học phí. Chi tiết từng mức và điều kiện tại truongvietanh.com/hoc-bong." } },
      { "@type": "Question", "name": "Có chính sách hoàn phí không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Hoàn phí trong 30 ngày đầu nếu con không phù hợp, trừ phí giữ chỗ và chi phí phát sinh." } }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Tuyển Sinh 2026 — Đăng Ký Tư Vấn | Trường Việt Anh"}
  description={cmsPage?.description || "Tuyển sinh Việt Anh 2026-2027: Mầm non — THPT, học phí lớp 1–12 tại TP.HCM 9,2–13,7 triệu/tháng. Early Bird đóng trước nhiều năm giảm từ 6–46%, anh chị em ruột giảm 50%."}
  keywords="tuyển sinh 2026 trường việt anh, tuyển sinh song ngữ tphcm, đăng ký tuyển sinh, tuyển sinh mầm non tiểu học thcs thpt, học bổng tuyển sinh"
  canonical="https://truongvietanh.com/tuyen-sinh"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="gi-page ts-page">
    <HeaderBase />

    <!-- ====== HERO + FORM ====== -->
    <section class="ts-hero">
      <div class="ts-container ts-hero-inner">
        <div class="ts-hero-left">
          <span class="ts-eyebrow">Tuyển sinh 2026–2027</span>
          <h1 class="ts-h1">Đăng ký tư vấn tuyển sinh — Trường Việt Anh</h1>
          <p class="ts-lede">Mầm non đến THPT · 2 cơ sở chính thức tại TP.HCM · Early Bird đóng trước nhiều năm giảm tới <strong>46% học phí</strong>.</p>

          <ul class="ts-trust">
            <li><strong>15+</strong> năm kinh nghiệm</li>
            <li><strong>3.000+</strong> học sinh</li>
            
            <li><strong>IELTS 6.0+</strong> đầu ra có bảo hành</li>
          </ul>
        </div>

        <div class="ts-hero-right">
          <div class="ts-form-card">
            <p class="ts-form-heading">Tư vấn lộ trình học tập</p>
            <LeadFormTwoStepEmailFirst
              formId="tuyen-sinh-form"
              funnelCode="tuyen-sinh-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== 4 BƯỚC ĐĂNG KÝ ====== -->
    <section class="ts-section">
      <div class="ts-container">
        <h2 class="ts-h2">Quy trình đăng ký — 4 bước, 5 ngày</h2>
        <div class="ts-steps">
          <div class="ts-step">
            <span class="ts-step-num">1</span>
            <strong>Đăng ký online</strong>
            <p>Điền form hoặc gọi <a href="tel:0916961409">0916 961 409</a>. Tư vấn viên gọi lại trong 24h.</p>
          </div>
          <div class="ts-step">
            <span class="ts-step-num">2</span>
            <strong>Tham quan trường</strong>
            <p>Miễn phí. Gặp ban giám hiệu, dự giờ lớp mẫu, xem cơ sở vật chất.</p>
          </div>
          <div class="ts-step">
            <span class="ts-step-num">3</span>
            <strong>Kiểm tra đầu vào</strong>
            <p>Mầm non: không kiểm tra. Tiểu học: phỏng vấn. THCS/THPT: kiểm tra Toán + Anh + Văn.</p>
          </div>
          <div class="ts-step">
            <span class="ts-step-num">4</span>
            <strong>Nhập học</strong>
            <p>Nộp hồ sơ, đóng phí giữ chỗ, nhận lịch học và đồng phục.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== CẤP HỌC ====== -->
    <section class="ts-section ts-section--alt">
      <div class="ts-container">
        <h2 class="ts-h2">Các cấp tuyển sinh</h2>
        <div class="ts-levels">
          <a href="/mam-non" class="ts-level">
            <span class="ts-level-icon">🌱</span>
            <strong>Mầm non</strong>
            <span>1–5 tuổi · 100% immersion</span>
          </a>
          <a href="/tieu-hoc" class="ts-level">
            <span class="ts-level-icon">📚</span>
            <strong>Tiểu học</strong>
            <span>Lớp 1–5 · UK Curriculum + STEAM</span>
          </a>
          <a href="/thcs" class="ts-level">
            <span class="ts-level-icon">🎓</span>
            <strong>THCS</strong>
            <span>Lớp 6–9 · IELTS 4.5–5.5 đầu ra</span>
          </a>
          <a href="/thpt" class="ts-level">
            <span class="ts-level-icon">🏆</span>
            <strong>THPT</strong>
            <span>Lớp 10–12 · IELTS 6.0+ có bảo hành, hướng nghiệp</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ====== HỌC BỔNG ====== -->
    <section class="ts-section">
      <div class="ts-container">
        <h2 class="ts-h2">Học bổng & ưu đãi</h2>
        <div class="ts-scholarships">
          <div class="ts-scholar"><strong>15–50%</strong><span>Học bổng HSG</span></div>
          <div class="ts-scholar ts-scholar--hot"><strong>10%</strong><span>Early Bird (T1–T3/2026) + tặng đồng phục</span></div>
          <div class="ts-scholar"><strong>10%</strong><span>Anh chị em ruột</span></div>
          <div class="ts-scholar"><strong>Riêng</strong><span>Hỗ trợ tài chính đặc biệt</span></div>
        </div>
        <p class="ts-note">Các ưu đãi có thể cộng dồn — tối đa 20% học phí cho mỗi bé.</p>
        <p class="ts-note">Chương trình AI 30 tiết/lớp/năm cho lớp 3–12 nằm trong học phí đã công bố, nhà trường không thu thêm. Ranh giới sử dụng AI với học sinh được công bố thành văn bản — xem <a href="/chinh-sach-ai">Trường Việt Anh dùng AI như thế nào</a>.</p>
      </div>
    </section>

    <!-- ====== FAQ ====== -->
    <section class="ts-section ts-section--alt" id="faq">
      <div class="ts-container">
        <h2 class="ts-h2">Câu hỏi thường gặp</h2>
        <div class="ts-faq">
          {cmsFaqs ? (
            cmsFaqs.slice(0, 6).map((faq, i) => (
              <details class="ts-faq-item" open={i === 0}>
                <summary>{faq.question}</summary>
                <p set:html={faq.answer} />
              </details>
            ))
          ) : (
            <>
              <details class="ts-faq-item" open>
                <summary>Trường Việt Anh tuyển sinh những cấp học nào?</summary>
                <p>4 cấp: Mầm non (từ 1 tuổi), Tiểu học (lớp 1–5), THCS (lớp 6–9) và THPT (lớp 10–12). Tiểu học, THCS và THPT học tại 2 cơ sở chính thức ở TP.HCM (Gò Vấp, Bình Tân); mầm non học tại các trường cùng chủ đầu tư và trường do Việt Anh phụ trách vận hành.</p>
              </details>
              <details class="ts-faq-item">
                <summary>Có cần thi đầu vào không?</summary>
                <p>Mầm non không kiểm tra. Tiểu học lớp 1 phỏng vấn nhẹ. THCS/THPT kiểm tra Toán + Văn + Anh để xếp lớp (không phải thi loại).</p>
              </details>
              <details class="ts-faq-item">
                <summary>Học phí 1 tháng bao nhiêu?</summary>
                <p>Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Cùng năm học, trường quốc tế tại TP.HCM ở mức 227,8–999,3 triệu đồng/năm. <a href="/hoc-phi">Xem bảng học phí chi tiết</a>.</p>
              </details>
              <details class="ts-faq-item">
                <summary>Con đang học trường khác có chuyển sang được không?</summary>
                <p>Được. Nhận chuyển trường tất cả cấp, bất kỳ thời điểm nào nếu còn chỗ. Con sẽ làm bài xếp lớp và tham gia 1 tuần hội nhập.</p>
              </details>
              <details class="ts-faq-item">
                <summary>Có xe đưa rước không?</summary>
                <p>Có, tại tất cả cơ sở TP.HCM. Có camera + GPS + phụ xe. Phí 800K–1,5tr/tháng tuỳ khoảng cách.</p>
              </details>
              <details class="ts-faq-item">
                <summary>Có hoàn phí nếu con không phù hợp?</summary>
                <p>Có. Hoàn phí trong 30 ngày đầu, trừ phí giữ chỗ và chi phí phát sinh.</p>
              </details>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- ====== BOTTOM CTA ====== -->
    <section class="ts-cta-bottom">
      <div class="ts-container ts-cta-bottom-inner">
        <div>
          <h2 class="ts-h2 ts-h2--white">Giữ chỗ cho con năm học 2026–2027</h2>
          <p class="ts-cta-desc">Để lại thông tin để nhận bảng tính riêng cho lớp của con — Early Bird đóng trước nhiều năm giảm từ 6–46%, anh chị em ruột giảm 50%.</p>
          <p class="ts-cta-hotline">Hotline: <a href="tel:0916961409">0916 961 409</a> · <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">Zalo</a></p>
        </div>
        <div class="ts-cta-form">
          <LeadFormTwoStepEmailFirst
            formId="tuyen-sinh-bottom-form"
            funnelCode="tuyen-sinh-bottom"
            schoolLevel="lien-cap"
          />
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style is:global>.ts-page{ background: #f7f9fc; }.ts-container{ max-width: 1180px; margin: 0 auto; padding: 0 1.25rem; }.ts-h1{ font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; line-height: 1.15; color: #0f172a; margin: 0 0 0.75rem; letter-spacing: -0.01em; }.ts-h2{ font-size: clamp(1.4rem, 2.5vw, 1.85rem); font-weight: 800; color: #26275D; margin: 0 0 1.5rem; text-align: center; letter-spacing: -0.01em; }.ts-h2--white{ color: #fff; text-align: left; }/* HERO */
  .ts-hero{ padding: 2.5rem 0 2rem; }.ts-hero-inner{ display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; }.ts-eyebrow{ display: inline-block; background: #fef3c7; color: #b45309; font-size: 1rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px; letter-spacing: 0.04em; margin-bottom: 0.75rem; text-transform: uppercase; }.ts-lede{ font-size: 1.05rem; color: #475569; line-height: 1.6; margin: 0 0 1.25rem; }.ts-trust{ list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }.ts-trust li{ background: #fff; padding: 0.55rem 0.9rem; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 1rem; color: #475569; }.ts-trust strong{ color: #26275D; font-weight: 800; }.ts-form-card{ background: linear-gradient(135deg, #26275D, #0d2f55); border-radius: 20px; padding: 1.5rem; box-shadow: 0 20px 60px rgba(13,47,85,0.2); }.ts-form-heading{ color: #fff; font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; text-align: center; }/* SECTIONS */
  .ts-section{ padding: 2.5rem 0; }.ts-section--alt{ background: #fff; border-block: 1px solid #e2e8f0; }/* 4 STEPS */
  .ts-steps{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }.ts-step{ background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.25rem; position: relative; }.ts-step-num{ display: inline-flex; width: 32px; height: 32px; border-radius: 50%; background: #26275D; color: #fff; font-weight: 800; align-items: center; justify-content: center; font-size: 1rem; margin-bottom: 0.65rem; }.ts-step strong{ display: block; font-size: 1rem; color: #0f172a; margin-bottom: 0.35rem; }.ts-step p{ margin: 0; font-size: 1rem; color: #475569; line-height: 1.55; }.ts-step p a{ color: #26275D; font-weight: 700; }/* LEVELS */
  .ts-levels{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }.ts-level{ background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.25rem; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; display: flex; flex-direction: column; gap: 0.35rem; }.ts-level:hover{ transform: translateY(-3px); box-shadow: 0 10px 30px rgba(38,39,93,0.08); border-color: #f9dd0e; }.ts-level-icon{ font-size: 2rem; line-height: 1; margin-bottom: 0.25rem; }.ts-level strong{ font-size: 1.05rem; color: #26275D; }.ts-level span{ font-size: 1rem; color: #64748b; }/* SCHOLARSHIPS */
  .ts-scholarships{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; }.ts-scholar{ background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.25rem; text-align: center; }.ts-scholar strong{ display: block; font-size: 1.8rem; font-weight: 800; color: #f9dd0e; margin-bottom: 0.35rem; line-height: 1; }.ts-scholar span{ font-size: 1rem; color: #475569; line-height: 1.4; }.ts-scholar--hot{ background: linear-gradient(135deg, #FFFBEB, #FEF3C7); border-color: #f9dd0e; position: relative; }.ts-scholar--hot::after{ content: 'HOT'; position: absolute; top: 8px; right: 8px; background: #f9dd0e; color: #fff; font-size: 1rem; font-weight: 800; padding: 0.15rem 0.5rem; border-radius: 50px; letter-spacing: 1px; }.ts-note{ text-align: center; color: #64748b; font-size: 1rem; margin: 1.25rem 0 0; }/* FAQ */
  .ts-faq{ max-width: 780px; margin: 0 auto; display: grid; gap: 0.65rem; }.ts-faq-item{ background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }.ts-faq-item summary{ padding: 1rem 1.25rem; font-weight: 700; color: #26275D; cursor: pointer; list-style: none; font-size: 1rem; position: relative; padding-right: 2.5rem; }.ts-faq-item summary::after{ content: '+'; position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); font-size: 1.3rem; color:#64748b; transition: transform 0.2s; }.ts-faq-item[open] summary::after{ content: '−'; }.ts-faq-item summary::-webkit-details-marker{ display: none; }.ts-faq-item p{ padding: 0 1.25rem 1rem; margin: 0; color: #475569; line-height: 1.65; font-size: 1rem; }.ts-faq-item p a{ color: #26275D; font-weight: 700; }/* BOTTOM CTA */
  .ts-cta-bottom{ background: linear-gradient(135deg, #26275D 0%, #26275D 100%); color: #fff; padding: 2.5rem 0; }.ts-cta-bottom-inner{ display: grid; grid-template-columns: 1fr 420px; gap: 2rem; align-items: center; }.ts-cta-desc{ color: rgba(255,255,255,0.85); font-size: 1rem; line-height: 1.65; margin: 0 0 0.75rem; }.ts-cta-hotline{ margin: 0; font-size: 1.05rem; color: rgba(255,255,255,0.9); }.ts-cta-hotline a{ color: #f9dd0e; font-weight: 800; text-decoration: none; }.ts-cta-form{ background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; padding: 1.25rem; }

  /* RESPONSIVE */
  @media (max-width: 900px) {.ts-hero-inner{ grid-template-columns: 1fr; gap: 1.5rem; }.ts-steps{ grid-template-columns: repeat(2, 1fr); }.ts-levels{ grid-template-columns: repeat(2, 1fr); }.ts-scholarships{ grid-template-columns: repeat(2, 1fr); }.ts-cta-bottom-inner{ grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {.ts-steps, .ts-levels, .ts-scholarships{ grid-template-columns: 1fr; }
  }
</style>
