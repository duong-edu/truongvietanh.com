const faqs = [
  {
    id: 'faq-chatgpt-lam-bai-tap',
    q: 'Con tôi có được dùng ChatGPT để làm bài tập không?',
    a: 'Được, nếu giáo viên ghi rõ mức A2 trở lên trên đề bài. Ở mức A0 — bài kiểm tra, bài thi và các bài giáo viên muốn học sinh tự làm — con không được dùng AI. Mỗi đề bài của Trường Việt Anh đều ghi rõ mức AI được phép, nên con luôn biết ranh giới ở đâu.',
  },
  {
    id: 'faq-nhap-ten-diem-vao-chatgpt',
    q: 'Trường có nhập tên và điểm của con tôi vào ChatGPT không?',
    a: 'Không. Trường Việt Anh nghiêm cấm nhập dữ liệu định danh học sinh — họ tên kèm lớp, điểm số, sức khỏe, hình ảnh, hoàn cảnh gia đình — vào công cụ AI công cộng ngoài danh mục đã duyệt. Dữ liệu học sinh chỉ được xử lý trên các công cụ trong Phụ lục A, qua tài khoản của trường.',
  },
  {
