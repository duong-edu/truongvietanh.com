const IMG_DIR = '/images/tam-ly-hoc-duong';
const IMG_OG = `${SITE}${IMG_DIR}/og-tam-ly-hoc-duong.jpg`;
const IMG_CLB_WORKSHOP = `${IMG_DIR}/clb-tam-ly-workshop-me-and-we.webp`;
const IMG_CLB_NHOM = `${IMG_DIR}/clb-tam-ly-anh-nhom.webp`;
const IMG_SINH_HOAT = `${IMG_DIR}/phong-tam-ly-sinh-hoat-vong-tron.webp`;

const description =
  'Phòng Tâm lý học đường Trường Việt Anh — P.407 cơ sở An Hội Tây và A.504B cơ sở Bình Tân: tham vấn cá nhân, tham vấn nhóm, check-in cảm xúc, nhắn tin qua fanpage và chia sẻ ẩn danh cho học sinh.';

// ── HAI PHÒNG TÂM LÝ ───────────────────────────────────────────────────────
// Lời giới thiệu CHUNG cho cả hai phòng — chỉ khác số phòng/cơ sở (chị Ngọc chốt 06/10/2026).
const LOI_PHONG =
  'Ở phòng có trò chơi để giải trí, có kẹo bánh để nhâm nhi, có nhạc và cây xanh, có những hoạt động để thư giãn và có một căn phòng bí mật để bạn chia sẻ những điều khó nói đang giữ trong lòng.';
const phongTamLy = [
  {
    ma: 'P.407',
    coSo: 'Cơ sở An Hội Tây (Gò Vấp)',
    diaChi: '160/72 Phan Huy Ích, Phường An Hội Tây, TP.HCM',
    loi: LOI_PHONG,
    linkCoSo: '/co-so/lien-cap-go-vap',
  },
  {
    ma: 'A.504B',
    coSo: 'Cơ sở Bình Tân',
    diaChi: 'Số 7 Đường 38A, Phường Tân Tạo, TP.HCM',
    loi: LOI_PHONG,
    linkCoSo: '/co-so/lien-cap-binh-tan',
  },
];

// ── NĂM HOẠT ĐỘNG ──────────────────────────────────────────────────────────
const hoatDong = [
  {
    icon: '💬',
    ten: 'Tham vấn cá nhân',
    mo: 'Có những chuyện khiến bạn rối nhưng chưa biết phải bắt đầu từ đâu. Chuyên viên tâm lý ngồi lại, lắng nghe và cùng bạn tìm một hướng đi phù hợp với điều bạn đang gặp phải.',
  },
  {
    icon: '👥',
    ten: 'Tham vấn nhóm / chuyên đề nhóm',
    mo: 'Các buổi tham vấn nhóm để cùng chia sẻ, lắng nghe và cùng tìm giải pháp cho những vấn đề chung: học tập, các mối quan hệ, áp lực thi cử, định hướng cá nhân.',
  },
  {
    icon: '🏫',
    ten: 'Chương trình tâm lý toàn trường',
    mo: 'Workshop, minigame và hoạt động trải nghiệm tổ chức cho tất cả học sinh về cảm xúc, các mối quan hệ, sức khỏe tinh thần và chính mình — để việc hiểu bản thân không chỉ nằm trong sách vở.',
  },
  {
    icon: '📻',
    ten: 'Phát thanh tâm lý',
    mo: 'Một góc nhỏ trên sóng phát thanh toàn trường, nơi Phòng Tâm lý gửi tới học sinh những nhắn nhủ từ biểu mẫu chia sẻ ẩn danh, câu chuyện, thông điệp và góc nhìn tâm lý mỗi tuần.',
  },
  {
    icon: '😊',
    ten: 'Check-in cảm xúc',
    mo: '“How do you ‘phiêu’ today?” — dừng lại một chút và thử lắng nghe xem hôm nay mình đang cảm thấy thế nào. Ghé phòng tâm lý hoặc sảnh trường, chọn một chiếc sticker và để lại mood của bạn trong “chiếc hộp cảm xúc”.',
  },
];

// ── KÊNH KẾT NỐI ───────────────────────────────────────────────────────────
const kenh = [
  {
    icon: '✉️',
    ten: 'Nhắn tin cho Phòng Tâm lý',
    mo: 'Nhắn tin trực tiếp qua fanpage chính thức của Phòng Tâm lý học đường.',
    nhan: 'Mở Facebook của Phòng Tâm lý',
    href: FB_TL,
    ngoai: true,
  },
  {
    icon: '🤫',
    ten: 'Chia sẻ ẩn danh (confession)',
    mo: 'Nơi học sinh gửi tâm tư mà không cần để lại tên. Những chia sẻ được chọn sẽ lên sóng phát thanh tâm lý.',
    nhan: 'Mở biểu mẫu ẩn danh',
    href: FORM_AN_DANH,
    ngoai: true,
  },
  {
    icon: '📅',
    ten: 'Đặt lịch hẹn tham vấn',
    mo: 'Học sinh đến trực tiếp Phòng Tâm lý hoặc liên hệ giáo viên chủ nhiệm để đặt lịch với chuyên viên tâm lý.',
    nhan: '',
    href: '',
    ngoai: false,
  },
];

// ── FAQ — dùng chung cho phần hiển thị và schema FAQPage ────────────────────
const faqs = [
  {
    id: 'faq-o-dau',
    q: 'Phòng Tâm lý học đường Trường Việt Anh nằm ở đâu?',
    a: 'Trường Việt Anh có hai phòng tâm lý học đường: phòng P.407 tại cơ sở An Hội Tây (160/72 Phan Huy Ích, Phường An Hội Tây, TP.HCM) và phòng A.504B tại cơ sở Bình Tân (Số 7 Đường 38A, Phường Tân Tạo, TP.HCM). Học sinh của cả hai cơ sở đều có thể ghé phòng tâm lý của cơ sở mình.',
  },
  {
    id: 'faq-ai-phu-trach',
    q: 'Ai phụ trách Phòng Tâm lý học đường?',
    a: 'Phòng Tâm lý học đường Trường Việt Anh do chuyên viên tâm lý Nguyễn Thị Ngọc phụ trách. Học sinh có thể đến trực tiếp phòng hoặc nhắn tin qua fanpage của Phòng Tâm lý; phụ huynh trao đổi thông qua giáo viên chủ nhiệm.',
  },
  {
    id: 'faq-hoc-sinh-gap-cach-nao',
    q: 'Học sinh muốn gặp chuyên viên tâm lý thì làm thế nào?',
    a: 'Có ba cách: đến trực tiếp phòng tâm lý của cơ sở mình, đặt lịch hẹn thông qua giáo viên chủ nhiệm, hoặc để lại thông tin và vấn đề mình đang gặp phải qua biểu mẫu chia sẻ ẩn danh (confession).',
  },
  {
    id: 'faq-ngai-den-phong',
    q: 'Con tôi ngại bước vào phòng tâm lý thì sao?',
    a: 'Phòng Tâm lý nói thẳng với học sinh rằng không cần bước vào phòng ngay. Con có thể bắt đầu bằng một cú click theo dõi kênh mạng xã hội của Phòng Tâm lý để làm quen dần, hoặc gửi điều mình đang giữ trong lòng qua biểu mẫu chia sẻ ẩn danh mà không phải để lại tên. Ngoài ra, con có thể tham gia các hoạt động nhóm/toàn trường mà Phòng Tâm lý và CLB Tâm lý sẽ tổ chức trong năm học.',
  },
  {
    id: 'faq-hoat-dong',
    q: 'Phòng Tâm lý học đường có những hoạt động nào?',
    a: 'Năm hoạt động: tham vấn cá nhân, tham vấn nhóm và chuyên đề nhóm, chương trình tâm lý toàn trường (workshop, minigame, hoạt động trải nghiệm), phát thanh tâm lý hằng tuần, và check-in cảm xúc bằng sticker tại phòng tâm lý hoặc ở sảnh trường. Ngoài ra còn có CLB Tâm lý dành cho học sinh muốn tham gia tổ chức hoạt động.',
  },
  {
    id: 'faq-giao-vien',
    q: 'Giáo viên có được hỗ trợ tâm lý không?',
    a: 'Có. Ngoài học sinh, Phòng Tâm lý học đường sẵn sàng hỗ trợ tâm lý cho giáo viên Trường Việt Anh. Thầy cô đặt lịch hẹn trước qua trang lịch hẹn trực tuyến hoặc đến trực tiếp Phòng Tâm lý trong giờ làm việc.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    name: 'Phòng Tâm lý học đường Trường Việt Anh',
    description,
    url: canonical,
    inLanguage: 'vi',
    primaryImageOfPage: { '@type': 'ImageObject', url: IMG_OG, width: 1200, height: 630 },
    isPartOf: { '@id': 'https://truongvietanh.com/#organization' },
    about: {
      '@type': 'EducationalOrganization',
      '@id': 'https://truongvietanh.com/#organization',
      name: 'Trường Việt Anh',
      url: 'https://truongvietanh.com',
      foundingDate: String(schoolFacts.foundedYear),
    },
    mainEntity: { '@id': `${canonical}#faq` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Giới thiệu', item: 'https://truongvietanh.com/gioi-thieu' },
      { '@type': 'ListItem', position: 3, name: 'Tâm lý học đường', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Tâm lý học đường Trường Việt Anh — Phòng tham vấn & chia sẻ ẩn danh"
  description={description}
  keywords="tâm lý học đường, phòng tâm lý trường học, tham vấn tâm lý học sinh, sức khỏe tinh thần học sinh, CLB tâm lý, Trường Việt Anh"
  canonical={canonical}
  ogImage={IMG_OG}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogType="article"
  structuredData={structuredData}
>
  <div class="gi-page tl-page">
    <HeaderBase currentPath="/tamlyhocduong" />

    <!-- ══════════ HERO ══════════ -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left" style="flex:1">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">›</span>
            <a href="/gioi-thieu">Giới thiệu</a>
            <span aria-hidden="true">›</span>
            <span>Tâm lý học đường</span>
          </nav>

          <h1 class="gi-h1">Phòng Tâm lý học đường Trường Việt Anh</h1>
          <p class="gi-subtitle tl-slogan">Lắng nghe — Thấu hiểu — Đồng hành</p>
          <p class="tl-hero-body">
            Một nơi trong trường để học sinh được kể ra điều khó nói. Hai phòng tâm lý ở hai cơ sở,
            một chuyên viên tâm lý trực, năm hoạt động thường xuyên và những kênh nhắn tin, chia sẻ
            ẩn danh cho các bạn chưa sẵn sàng bước vào phòng.
          </p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>2 phòng tâm lý</strong> An Hội Tây &amp; Bình Tân</div>
            <div class="gi-badge"><strong>5 hoạt động</strong> Cá nhân · nhóm · toàn trường</div>
            <div class="gi-badge"><strong>Chia sẻ ẩn danh</strong> Không cần để lại tên</div>
          </div>

          <div class="tl-hero-actions">
            <a href={FORM_AN_DANH} target="_blank" rel="noopener" class="tl-btn tl-btn-primary">
              Gửi chia sẻ ẩn danh
            </a>
            <a href={FB_TL} target="_blank" rel="noopener" class="tl-btn tl-btn-ghost">Nhắn tin cho Phòng Tâm lý</a>
          </div>
        </div>
      </div>
    </section>

    <div class="gi-container gi-body">
      <!-- ══════════ MỤC LỤC ══════════ -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Nội dung</p>
        <ol class="gi-toc-list">
          <li><a href="#phong-tam-ly-la-gi">Phòng Tâm lý là nơi thế nào</a></li>
          <li><a href="#hai-phong">Hai phòng, hai cơ sở</a></li>
          <li><a href="#hoat-dong">Năm hoạt động</a></li>
          <li><a href="#clb-tam-ly">CLB Tâm lý</a></li>
          <li><a href="#ket-noi">Cách kết nối</a></li>
          <li><a href="#cha-me">Dành cho ba mẹ</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href={`tel:${HOTLINE.replace(/\s/g, '')}`} class="gi-toc-cta">Gọi {HOTLINE}</a>
      </nav>

      <article class="gi-main" id="main-content" data-no-collapse>
        <p class="tl-lead">
          Phòng Tâm lý học đường là nơi học sinh Trường Việt Anh được lắng nghe — lúc vui, lúc buồn,
          lúc giận hờn hay khi thất vọng. Trường có hai phòng tâm lý: <strong>P.407</strong> tại cơ sở
          An Hội Tây và <strong>A.504B</strong> tại cơ sở Bình Tân, do chuyên viên tâm lý
          <strong> Nguyễn Thị Ngọc</strong> phụ trách.
        </p>

        {/* Mục lục cho mobile — sidebar .gi-toc bị ẩn dưới 1024px. */}
        <details class="tl-toc-mobile">
          <summary>Nhảy nhanh tới mục cần xem</summary>
          <ol>
            <li><a href="#phong-tam-ly-la-gi">Phòng Tâm lý là nơi thế nào</a></li>
            <li><a href="#hai-phong">Hai phòng, hai cơ sở</a></li>
            <li><a href="#hoat-dong">Năm hoạt động</a></li>
            <li><a href="#clb-tam-ly">CLB Tâm lý</a></li>
            <li><a href="#ket-noi">Cách kết nối</a></li>
            <li><a href="#cha-me">Dành cho ba mẹ</a></li>
            <li><a href="#faq">Câu hỏi thường gặp</a></li>
          </ol>
        </details>

        <!-- ══════════ 1. LỜI CỦA PHÒNG TÂM LÝ ══════════ -->
        <section id="phong-tam-ly-la-gi" class="gi-section">
          <h2>Ở đây, mọi cảm xúc đều được lắng nghe</h2>

          <blockquote class="tl-quote">
            <p>
              Bạn có thể ghé thăm mình lúc vui, lúc buồn, lúc giận hờn hay khi thất vọng… Bất cứ lúc
              nào bạn cần một nơi để được chia sẻ, được lắng nghe, được bày tỏ nỗi lòng — những điều
              khó nói, hãy nhớ luôn có mình: Phòng Tâm lý ở đây!
            </p>
            <footer>Phòng Tâm lý học đường Trường Việt Anh</footer>
          </blockquote>

          <p>
            Phòng Tâm lý học đường không phải nơi chỉ dành cho học sinh “có vấn đề” mà là nơi bất kỳ
            bạn nào cũng có thể ghé thăm để chia sẻ một câu chuyện, để lại một chiếc sticker cảm xúc,
            tham gia một trò chơi nhóm, hoặc đơn giản là ngồi thư giãn một lát rồi đi ra.
          </p>
          <p>
            Với những bạn chưa muốn nói chuyện trực tiếp, Phòng Tâm lý mở sẵn hai cánh cửa khác:
            <strong>nhắn tin qua trang Facebook chính thức</strong> hoặc
            <strong>biểu mẫu chia sẻ ẩn danh (Confession)</strong>.
          </p>

          <figure class="tl-figure">
            <img
              src={IMG_SINH_HOAT}
              alt="Học sinh Trường Việt Anh ngồi thành vòng tròn trong buổi sinh hoạt của Phòng Tâm lý học đường"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Buổi sinh hoạt do Phòng Tâm lý học đường tổ chức — học sinh Trường Việt Anh ngồi quây tròn chia sẻ.
            </figcaption>
          </figure>
        </section>

        <!-- ══════════ 2. HAI PHÒNG ══════════ -->
        <section id="hai-phong" class="gi-section">
          <h2>Hai phòng tâm lý, hai cơ sở</h2>
          <p>
            Mỗi cơ sở liên cấp của Trường Việt Anh tại TP.HCM có một phòng tâm lý riêng, nằm ngay
            trong khuôn viên học sinh học hằng ngày.
          </p>

          <div class="tl-rooms">
            {phongTamLy.map((p) => (
              <div class="tl-room">
                <p class="tl-room-ma">{p.ma}</p>
                <p class="tl-room-coso">{p.coSo}</p>
                <p class="tl-room-loi">{p.loi}</p>
                <p class="tl-room-diachi">
                  <span aria-hidden="true">📍</span> {p.diaChi}
