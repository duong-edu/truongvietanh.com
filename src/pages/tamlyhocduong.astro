            {kenh.map((k) => {
              const Tag = k.href ? 'a' : 'div';
              return (
              <Tag
                class="tl-channel"
                href={k.href || undefined}
                target={k.ngoai ? '_blank' : undefined}
                rel={k.ngoai ? 'noopener' : undefined}
              >
                <span class="tl-channel-icon" aria-hidden="true">{k.icon}</span>
                <span class="tl-channel-body">
                  <span class="tl-channel-ten">{k.ten}</span>
                  <span class="tl-channel-mo">{k.mo}</span>
                  {k.nhan && <span class="tl-channel-nhan">{k.nhan}</span>}
                </span>
              </Tag>
              );
