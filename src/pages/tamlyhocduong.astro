---
// Trang /tamlyhocduong — Phòng Tâm lý học đường Trường Việt Anh.
//
// NGUỒN NỘI DUNG: trang riêng của Phòng Tâm lý dựng bằng Canva
// (https://xn--phng-tm-l-407-neb9uwg.my.canva.site/ — 6 trang: Trang chủ, Phòng Tâm lý cs AHT,
// Phòng Tâm lý cs BT, Hoạt động, CLB Tâm lý, Liên hệ). Đọc và chép ngày 15/09/2026.
// Ảnh trong trang lấy từ chính trang Canva đó (ảnh chụp thật buổi sinh hoạt CLB Tâm lý),
// đã nén sang webp để ở public/images/tam-ly-hoc-duong/.
//
// ĐÃ SỬA 3 LỖI CHỮ của bản Canva khi chép sang đây (bản gốc vẫn còn lỗi):
//   · "cùng giải pháp"  → "cùng tìm giải pháp"
//   · "vần đề"          → "vấn đề"
//   · "bạn lực thi cử"  → "áp lực thi cử"
//
// KHÔNG CÓ FORM LEAD trên trang này → không cần bộ thu UTM (xem CLAUDE.md).
// FAQ dùng component dùng chung FaqAccordion + schema FAQPage sinh từ CÙNG mảng `faqs`.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { schoolFacts } from '../data/school-facts';

const SITE = 'https://truongvietanh.com';
const canonical = `${SITE}/tamlyhocduong`;

const HOTLINE = '0916 961 409';
const ZALO_OA = 'https://zalo.me/1678310120468101523';

// Kênh của Phòng Tâm lý. KHÔNG public email/SĐT của chuyên viên (chị Ngọc chốt 06/10/2026):
// học sinh nhắn qua fanpage, phụ huynh trao đổi qua GVCN.
// Biểu mẫu chia sẻ ẩn danh ("confessionnnn") — trang Canva chỉ để mã QR, đây là đích thật của mã đó.
const FORM_AN_DANH = 'https://docs.google.com/forms/d/e/1FAIpQLSc4oNa-V2Pd0528YdCCWC9pY8m0PsSBh7slblhWupQdq7bk7A/viewform';
