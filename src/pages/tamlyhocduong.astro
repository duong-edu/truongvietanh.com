            mang các hoạt động tâm lý tới lớp học, sân trường và cả sóng phát thanh.
          </p>

          <div class="tl-acts">
            {hoatDong.map((h) => (
              <div class="tl-act">
                <span class="tl-act-icon" aria-hidden="true">{h.icon}</span>
                <h3>{h.ten}</h3>
                <p>{h.mo}</p>
              </div>
            ))}
          </div>
        </section>

