---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const structuredData = [
  { "@context": "https://schema.org", "@type": "WebPage", "name": "So Sánh Trường Việt Anh với Trường Công và Trường Quốc Tế", "url": "https://truongvietanh.com/so-sanh" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
    { "@type": "ListItem", "position": 2, "name": "So sánh", "item": "https://truongvietanh.com/so-sanh" }
  ]}
];
---

<BaseLayout
  title="So Sánh Trường Việt Anh với Trường Công và Quốc Tế — Bảng So Sánh Chi Tiết"
  description="Bảng so sánh chi tiết Trường Việt Anh với trường công lập và trường quốc tế: học phí, tiếng Anh, chương trình, cơ sở vật chất, kết quả đầu ra."
  canonical="https://truongvietanh.com/so-sanh"
  structuredData={structuredData}
>
  <div class="cf-layout page-wrapper">
    <HeaderBase />

    <section class="page-hero">
      <div class="cf-container text-center">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a> <span>/</span> <span>So sánh</span>
        </nav>
        <h1 class="page-title">So Sánh Trường Việt Anh với Trường Công và Quốc Tế</h1>
        <p class="page-desc">Bảng so sánh khách quan giúp phụ huynh chọn trường phù hợp cho con</p>
      </div>
    </section>

    <section class="compare-section">
      <div class="cf-container">
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Tiêu chí</th>
                <th class="highlight">Trường Việt Anh</th>
                <th>Trường Công Lập</th>
                <th>Trường Quốc Tế</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Học phí/tháng</td><td class="highlight"><strong>5–15 triệu</strong></td><td>Miễn phí – 500K</td><td>15–50 triệu</td></tr>
              <tr><td>Tiếng Anh đầu ra</td><td class="highlight"><strong>IELTS 6.0+ có bảo hành</strong></td><td>A1–A2</td><td>IELTS 6.0–8.5</td></tr>
              <tr><td>Giáo viên bản ngữ</td><td class="highlight"><strong>Full-time</strong></td><td>Không</td><td>Full-time</td></tr>
              <tr><td>Sĩ số lớp</td><td class="highlight"><strong>20–35 em</strong></td><td>40–50 em</td><td>15–25 em</td></tr>
              <tr><td>Chương trình</td><td class="highlight"><strong>Bộ GD + UK Oxford</strong></td><td>Bộ GD&ĐT</td><td>100% quốc tế</td></tr>
              <tr><td>Bằng tốt nghiệp</td><td class="highlight"><strong>Bộ GD + IELTS</strong></td><td>Bộ GD&ĐT</td><td>IB/AP/A-Level</td></tr>
              <tr><td>Kỹ năng thế kỷ 21</td><td class="highlight"><strong>16/16 WEF</strong></td><td>Hạn chế</td><td>Có</td></tr>
              <tr><td>Leader in Me</td><td class="highlight"><strong>Bản quyền FC</strong></td><td>Không</td><td>Một số trường</td></tr>
              <tr><td>STEM/Robotics</td><td class="highlight"><strong>Từ lớp 3</strong></td><td>Hạn chế</td><td>Có</td></tr>
              <tr><td>Ngoại khóa</td><td class="highlight"><strong>20+ CLB</strong></td><td>3–5 CLB</td><td>15–30 CLB</td></tr>
                            <tr><td>Du học</td><td class="highlight"><strong>30% học bổng</strong></td><td>Tự chuẩn bị</td><td>50%+</td></tr>
              <tr><td>Xe đưa đón</td><td class="highlight"><strong>Có (GPS)</strong></td><td>Không</td><td>Có</td></tr>
              <tr><td>Ăn bán trú</td><td class="highlight"><strong>3 bữa/ngày</strong></td><td>1 bữa</td><td>3 bữa/ngày</td></tr>
              <tr><td>Cơ sở</td><td class="highlight"><strong>2 cơ sở chính thức</strong></td><td>1 campus</td><td>1–2 campus</td></tr>
            </tbody>
          </table>
        </div>

        <div class="compare-verdict">
          <h2>Kết luận</h2>
          <p><strong>Trường Việt Anh</strong> mang đến chất lượng giáo dục tương đương trường quốc tế (giáo viên bản ngữ, IELTS, STEM, Leader in Me) nhưng với học phí thấp hơn — xem <a href="/hoc-phi">bảng so sánh có nguồn</a>. So với trường công, Việt Anh tốt hơn về tiếng Anh, kỹ năng mềm, ngoại khóa và tỷ lệ đỗ đại học.</p>
          <p>Đây là lựa chọn <strong>"chất lượng quốc tế — học phí Việt Nam"</strong> dành cho gia đình muốn con phát triển toàn diện mà không phải trả mức phí quốc tế.</p>
        </div>
      </div>
    </section>

    <section style="max-width:600px;margin:0 auto 3rem;padding:0 1.5rem;text-align:center">
      <h2 style="font-size:1.65rem;font-weight:700;color:#26275D;margin-bottom:0.5rem;font-family:'Montserrat','Be Vietnam Pro',sans-serif">Nhận tư vấn so sánh chi tiết</h2>
      <p style="color:#374151;margin-bottom:1.5rem;font-size:0.95rem">Đội ngũ tư vấn sẽ so sánh chi tiết theo nhu cầu gia đình bạn</p>
      <LeadFormTwoStepEmailFirst formId="so-sanh-form" funnelCode="comparison" schoolLevel="lien-cap" submitText="Nhận tư vấn" />
      <div style="margin-top:1rem">
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:0.4rem;background:#0b84ff;color:#fff;padding:0.65rem 1.4rem;border-radius:6px;font-weight:600;font-size:1rem;text-decoration:none">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          Nhắn Zalo OA
        </a>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style>.cf-container{ max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }.text-center{ text-align: center; }.page-hero{ background: linear-gradient(135deg, #26275D, #26275D); color: #fff; padding: 3rem 0 2.5rem; }.page-title{ font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; margin: 0 0 0.5rem; font-family: 'Montserrat', 'Be Vietnam Pro', sans-serif; }.page-desc{ font-size: 1.05rem; color: rgba(255,255,255,0.75); margin: 0; }.breadcrumb{ font-size: 1rem; margin-bottom: 1rem; color: rgba(255,255,255,0.6); }.breadcrumb a{ color: rgba(255,255,255,0.75); text-decoration: none; }.compare-section{ padding: 3rem 0; }.compare-table-wrap{ overflow-x: auto; margin-bottom: 2rem; }.compare-table{ width: 100%; border-collapse: collapse; font-size: 1rem; }.compare-table th, .compare-table td{ padding: 0.85rem 1rem; text-align: left; border-bottom: 1px solid #e2e8f0; }.compare-table th{ background: #f8fafc; font-weight: 700; color: #26275D; position: sticky; top: 0; }.compare-table th.highlight{ background: #26275D; color: #fff; }.compare-table td.highlight{ background: #f0f4ff; font-weight: 600; color: #26275D; }.compare-table tr:hover td{ background: #fafbff; }.compare-table tr:hover td.highlight{ background: #e8edff; }.compare-verdict{ background: #f8fafc; border-radius: 12px; padding: 2rem; max-width: 700px; }.compare-verdict h2{ font-size: 1.5rem; color: #26275D; margin: 0 0 0.75rem; }.compare-verdict p{ color: #475569; line-height: 1.7; margin: 0 0 0.75rem; font-size: 1rem; }
</style>
