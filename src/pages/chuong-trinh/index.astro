/* ── MID CTA ── */
.ct-mid-cta {
  background: linear-gradient(120deg, #26275D 0%, #18193a 100%);
  padding: 3.5rem 0;
}
.ct-mid-cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.ct-mid-cta__text { flex: 1; min-width: 280px; }
.ct-mid-cta__text h2 {
  font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
  font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  font-weight: 800;
  color: #fff;
  margin: 0.5rem 0 0.75rem;
  line-height: 1.25;
}
.ct-mid-cta__text p { color: rgba(255,255,255,0.8); font-size: 1rem; margin: 0; line-height: 1.6; }
.ct-mid-cta__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  flex-shrink: 0;
}

/* ── BUTTONS ── */
.ct-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.8rem 1.5rem;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  transition: transform 0.15s, box-shadow 0.15s, background 0.2s;
  white-space: nowrap;
}
.ct-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(0,0,0,0.3); }
.ct-btn--primary { background: #f9dd0e; color: #26275D; }
.ct-btn--primary:hover { background: #eeee00; }
.ct-btn--outline { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.35); }
.ct-btn--outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.6); }
.ct-btn--outline-light { background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.25); }
.ct-btn--outline-light:hover { background: rgba(255,255,255,0.18); }

/* ── TRUST LOGOS ── */
.ct-trust { background: #fff; padding: 2.5rem 0; }
.ct-trust__label {
  text-align: center;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color:#475569;
  margin-bottom: 1.5rem;
}
.ct-trust__row {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem 2.5rem;
  justify-content: center;
  align-items: center;
}
.ct-trust__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #4a6377;
  font-size: 0.95rem;
  font-weight: 600;
  opacity: 0.75;
  transition: opacity 0.2s;
}
.ct-trust__item:hover { opacity: 1; }

/* ── FAQ ── */
.ct-faq { background: #f4f6fa; }
.ct-faq__list {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.ct-faq__item {
  background: #fff;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  overflow: hidden;
  transition: box-shadow 0.2s;
}
.ct-faq__item[open] { box-shadow: 0 4px 16px rgba(38,39,93,0.08); border-color: #26275D; }
.ct-faq__item summary {
  padding: 1.1rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  color: #26275D;
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  user-select: none;
}
.ct-faq__item summary::-webkit-details-marker { display: none; }
.ct-faq__item summary::after {
  content: '+';
  font-size: 1.4rem;
  font-weight: 400;
  color: #26275D;
  flex-shrink: 0;
  transition: transform 0.2s;
}
.ct-faq__item[open] summary::after { content: '−'; }
.ct-faq__answer {
  padding: 0 1.5rem 1.25rem;
  border-top: 1px solid #f1f5f9;
}
.ct-faq__answer p {
  font-size: 1rem;
  color: #475569;
  line-height: 1.75;
  margin: 0;
}
.ct-faq__answer a { color: #26275D; font-weight: 600; }

/* ── BOTTOM CTA ── */
.ct-bottom-cta {
  background: linear-gradient(135deg, #26275D 0%, #18193a 100%);
  padding: 4.5rem 0;
  position: relative;
  overflow: hidden;
}
.ct-bottom-cta::before {
  content: '';
  position: absolute;
  top: -50%; right: -10%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(249,221,14,0.1), transparent 70%);
  pointer-events: none;
}
.ct-bottom-cta__inner {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 3rem;
  align-items: center;
  position: relative;
}
.ct-bottom-cta__text h2 {
  font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 800;
  color: #fff;
  margin: 0.5rem 0 1rem;
  line-height: 1.25;
}
.ct-bottom-cta__text p { color: rgba(255,255,255,0.85); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; }
.ct-bottom-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.ct-bottom-cta__form {
  background: #fff;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}

/* ── RELATED ── */
.ct-related { background: #eef2f7; }
.ct-related__title {
  font-family: "Montserrat", "Be Vietnam Pro", sans-serif;
  font-size: 1.5rem;
  font-weight: 800;
  color: #26275D;
  text-align: center;
  margin-bottom: 2rem;
}
.ct-related__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}
/* Lưới trên cố định 4 cột — chương trình ngoài giờ (STEAM-E) để thành một dòng
   dẫn bên dưới, thêm thẻ thứ 5 sẽ trơ trọi một mình ở hàng sau. */
.ct-related__more {
  margin: 1.5rem auto 0;
  max-width: 720px;
  text-align: center;
  font-size: 1rem;
  line-height: 1.7;
  color: #3b4963;
}
.ct-related__more a { color: #26275D; font-weight: 700; }
.ct-related__card {
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: #0f172a;
  border: 1px solid #e2e8f0;
  transition: transform 0.2s, box-shadow 0.2s;
}
.ct-related__card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
.ct-related__card-top { height: 5px; background: #26275D; }
.ct-related__card:hover .ct-related__card-top { background: #f9dd0e; transition: background 0.25s; }
.ct-related__card h3 { font-size: 1rem; font-weight: 700; color: #26275D; padding: 1rem 1.25rem 0.35rem; margin: 0; line-height: 1.35; }
.ct-related__card p { font-size: 0.88rem; color: #64748b; padding: 0 1.25rem 1.25rem; margin: 0; line-height: 1.5; }

/* ── STICKY MOBILE BAR ── */
.ct-sticky-bar {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top: 1px solid rgba(18,57,103,0.1);
  box-shadow: 0 -4px 20px rgba(18,57,103,0.12);
  z-index: 900;
  padding: 0.6rem 1rem;
  gap: 0.5rem;
}
.ct-sticky-bar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.7rem 0.5rem;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: transform 0.1s;
}
.ct-sticky-bar__btn:active { transform: scale(0.97); }
.ct-sticky-bar__btn--call { background: #26275D; color: #fff; }
.ct-sticky-bar__btn--zalo { background: #0068FF; color: #fff; }
.ct-sticky-bar__btn--book { background: #f9dd0e; color: #26275D; }

/* ── RESPONSIVE ── */
@media (max-width: 1100px) {
  .ct-prog-grid { grid-template-columns: repeat(2, 1fr); }
  .ct-related__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 1024px) {
  .ct-hero__inner { grid-template-columns: 1fr; gap: 2rem; }
  .ct-hero__form-wrap { max-width: 520px; }
  .ct-road { grid-template-columns: repeat(2, 1fr); }
  .ct-road__arrow { display: none; }
  .ct-road__item { border-right: none; border-bottom: 1px solid #e2e8f0; }
  .ct-road__item--last { border-bottom: none; }
  .ct-benefit__inner { grid-template-columns: 1fr; gap: 2rem; }
  .ct-bottom-cta__inner { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .ct-hero { padding: 3.5rem 0 3rem; }
  .ct-stats__grid { grid-template-columns: repeat(2, 1fr); }
  .ct-stat { border-right: none; border-bottom: 1px solid #e2e8f0; }
  .ct-stat:nth-child(odd) { border-right: 1px solid #e2e8f0; }
  .ct-compare { grid-template-columns: 1fr; }
  .ct-mid-cta__inner { flex-direction: column; align-items: flex-start; }
  .ct-mid-cta__actions { flex-direction: column; width: 100%; }
  .ct-btn { width: 100%; justify-content: center; }
  .ct-sticky-bar { display: flex; }
  .ct-page > main, .ct-page { padding-bottom: 72px; }
}
@media (max-width: 640px) {
  .ct-container { padding: 0 1rem; }
  .ct-prog-grid { grid-template-columns: 1fr; }
  .ct-related__grid { grid-template-columns: 1fr; }
  .ct-hero__badges { display: none; }
  .ct-section { padding: 3rem 0; }
}
</style>

<script>
  // Smooth scroll for quick-jump buttons
  document.querySelectorAll('.ct-qbtn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const href = (btn as HTMLAnchorElement).getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
