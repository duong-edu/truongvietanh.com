---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../../lib/directus';

const cmsPage = await getPillarPage('cap-hoc');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ 4 cấp từ Mầm non đến THPT tại TP.HCM. Lộ trình 1–18 tuổi, IELTS 6.0+.",
    "address": { "@type": "PostalAddress", "addressLocality": "Hồ Chí Minh", "addressCountry": "VN" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Trường Việt Anh có những chương trình nào?", "acceptedAnswer": { "@type": "Answer", "text": "4 cấp học liên tục: Mầm non (1–6 tuổi), Tiểu học (lớp 1–5), THCS (lớp 6–9) và THPT (lớp 10–12). Học sinh theo học xuyên suốt từ 1 đến 18 tuổi." } },
      { "@type": "Question", "name": "Chương trình tiếng Anh liên tục giữa các cấp như thế nào?", "acceptedAnswer": { "@type": "Answer", "text": "Immersion 100% (Mầm non) → UK Oxford (Tiểu học) → Academic English (THCS) → IELTS 6.0+ có bảo hành (THPT). Lộ trình thiết kế xuyên suốt, không bị gián đoạn." } },
      { "@type": "Question", "name": "Học sinh có thể chuyển cấp nội bộ không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Học sinh chuyển cấp nội bộ được ưu tiên xét tuyển, không thi đầu vào lại. Hồ sơ và kế hoạch phát triển cá nhân được chuyển giao liên tục." } },
      { "@type": "Question", "name": "Học phí các cấp học tại Trường Việt Anh?", "acceptedAnswer": { "@type": "Answer", "text": "Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Chương trình", "item": "https://truongvietanh.com/chuong-trinh" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Chương Trình Học Trường Việt Anh — 4 Cấp Liên Cấp Mầm Non đến THPT"}
  description={cmsPage?.description || "4 cấp học liên cấp Trường Việt Anh: Mầm non, Tiểu học, THCS, THPT. Lộ trình song ngữ 1–18 tuổi, IELTS 6.0+. Đăng ký tham quan miễn phí."}
  canonical="https://truongvietanh.com/chuong-trinh"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="ct-page">
    <SiteHeader currentPath="/chuong-trinh" />

    <!-- ====== HERO ====== -->
    <section class="ct-hero">
      <div class="ct-hero__overlay"></div>
      <div class="ct-container ct-hero__inner">

        <!-- Left: Text -->
        <div class="ct-hero__text">
          <nav class="ct-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span>/</span>
            <span>Chương trình</span>
          </nav>

          <h1 class="ct-hero__h1">
            Hệ Thống Liên Cấp<br>
            <span class="ct-hero__h1-accent">Trường Việt Anh</span>
          </h1>
          <p class="ct-hero__subtitle">4 cấp học liên tục — Lộ trình phát triển toàn diện từ 1 đến 18 tuổi</p>

          <div class="ct-hero__badges">
            <span class="ct-hero__badge">🎓 4 cấp học</span>
            <span class="ct-hero__badge">🏆 IELTS 6.0+ có bảo hành</span>
            <span class="ct-hero__badge">📚 15+ năm</span>
          </div>

          <!-- Quick jump to programs -->
          <div class="ct-hero__quick">
            <a href="#mam-non" class="ct-qbtn">Mầm non</a>
            <a href="#tieu-hoc" class="ct-qbtn">Tiểu học</a>
            <a href="#thcs" class="ct-qbtn">THCS</a>
            <a href="#thpt" class="ct-qbtn">THPT</a>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="ct-hero__form-wrap">
          <div class="ct-form-card">
            <p class="ct-form-card__heading">Đăng ký tham quan trường miễn phí</p>
            <p class="ct-form-card__sub">Đội tư vấn liên hệ trong 24 giờ</p>
            <LeadFormTwoStepEmailFirst
              formId="ct-hero-form"
              funnelCode="chuong-trinh-hero"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== STATS ====== -->
    <section class="ct-stats">
      <div class="ct-container">
        <div class="ct-stats__grid">
          <div class="ct-stat">
            <strong>2011</strong>
            <span>Năm thành lập</span>
          </div>
          <div class="ct-stat">
            <strong>3.000+</strong>
            <span>Học sinh hiện tại</span>
          </div>
          <div class="ct-stat">
            <strong>4 cấp</strong>
            <span>Mầm non → THPT liên cấp</span>
          </div>
          <div class="ct-stat">
            <strong>6.0+</strong>
            <span>IELTS có bảo hành</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== PROGRAM CARDS OVERVIEW ====== -->
    <section class="ct-section ct-programs-overview">
      <div class="ct-container">
        <div class="ct-section__heading">
          <p class="ct-eyebrow">4 cấp học liên cấp</p>
          <h2>Chọn cấp học phù hợp với con</h2>
          <p class="ct-section__desc">Mỗi cấp học được thiết kế nối tiếp nhau — con không bị gián đoạn khi chuyển cấp, tiếng Anh tiến bộ liên tục suốt 16 năm.</p>
        </div>

        <div class="ct-prog-grid">
          <!-- Mầm non -->
          <a href="/mam-non" class="ct-prog-card" id="mam-non">
            <div class="ct-prog-card__top ct-prog-card__top--mn">
              <span class="ct-prog-badge">MN</span>
              <span class="ct-prog-age">2 – 6 tuổi</span>
            </div>
            <h3 class="ct-prog-card__title">Mầm non</h3>
            <ul class="ct-prog-card__list">
              <li>Tiếng Anh Immersion 100% với giáo viên bản ngữ</li>
              <li>Phương pháp PDR: Plan – Do – Review</li>
              <li>Học qua vui chơi, không bài tập về nhà</li>
              <li>Sĩ số 15–20 bé/lớp, 2 GV + trợ giảng</li>
            </ul>
            <span class="ct-prog-card__cta">Tìm hiểu chương trình →</span>
          </a>

          <!-- Tiểu học -->
          <a href="/tieu-hoc" class="ct-prog-card" id="tieu-hoc">
            <div class="ct-prog-card__top ct-prog-card__top--th">
              <span class="ct-prog-badge">TH</span>
              <span class="ct-prog-age">Lớp 1 – 5</span>
            </div>
            <h3 class="ct-prog-card__title">Tiểu học</h3>
            <ul class="ct-prog-card__list">
              <li>Chương trình UK Oxford kết hợp Bộ GD&ĐT</li>
              <li>50% thời lượng bằng tiếng Anh</li>
              <li>16 kỹ năng thế kỷ 21 theo chuẩn WEF</li>
              <li>STEAM: Coding, Robotics, dự án sáng tạo</li>
            </ul>
            <span class="ct-prog-card__cta">Tìm hiểu chương trình →</span>
          </a>

          <!-- THCS -->
          <a href="/trung-hoc-co-so" class="ct-prog-card" id="thcs">
            <div class="ct-prog-card__top ct-prog-card__top--thcs">
              <span class="ct-prog-badge">THCS</span>
              <span class="ct-prog-age">Lớp 6 – 9</span>
            </div>
            <h3 class="ct-prog-card__title">Trung học Cơ sở</h3>
            <ul class="ct-prog-card__list">
              <li>Leader in Me — 7 thói quen Franklin Covey</li>
              <li>Mục tiêu IELTS B1–B2 đầu ra lớp 9</li>
              <li>Thuyết trình, phản biện song ngữ</li>
              <li>Hướng nghiệp sớm từ lớp 8</li>
            </ul>
            <span class="ct-prog-card__cta">Tìm hiểu chương trình →</span>
          </a>

          <!-- THPT -->
          <a href="/trung-hoc-pho-thong" class="ct-prog-card" id="thpt">
            <div class="ct-prog-card__top ct-prog-card__top--thpt">
              <span class="ct-prog-badge">THPT</span>
              <span class="ct-prog-age">Lớp 10 – 12</span>
            </div>
            <h3 class="ct-prog-card__title">Trung học Phổ thông</h3>
            <ul class="ct-prog-card__list">
              <li>Bảo hành đầu ra IELTS 6.0+ ghi trong hợp đồng — không đạt trường kèm miễn phí cho đến khi đạt (theo điều kiện trong hợp đồng)</li>
              <li>Định hướng đại học và du học từ lớp 10</li>
              <li>Hướng nghiệp 1-1, hỗ trợ hồ sơ du học</li>
              <li>Kỹ năng khởi nghiệp, Digital Literacy</li>
            </ul>
            <span class="ct-prog-card__cta">Tìm hiểu chương trình →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ====== ENGLISH ROADMAP ====== -->
    <section class="ct-section ct-english">
      <div class="ct-container">
        <div class="ct-section__heading">
          <p class="ct-eyebrow">Lộ trình tiếng Anh</p>
          <h2>Tiếng Anh xuyên suốt 16 năm — không bị đứt gãy</h2>
        </div>
        <div class="ct-road">
          <div class="ct-road__item">
            <div class="ct-road__badge">MN</div>
            <div class="ct-road__content">
              <strong>Mầm non</strong>
              <p>100% English Immersion — giáo viên bản ngữ toàn thời gian</p>
            </div>
            <div class="ct-road__arrow">→</div>
          </div>
          <div class="ct-road__item">
            <div class="ct-road__badge">TH</div>
            <div class="ct-road__content">
              <strong>Tiểu học</strong>
              <p>UK Oxford Curriculum — Academic Reading & Writing từ lớp 1</p>
            </div>
            <div class="ct-road__arrow">→</div>
          </div>
          <div class="ct-road__item">
            <div class="ct-road__badge">THCS</div>
            <div class="ct-road__content">
              <strong>THCS</strong>
              <p>Academic English — Mục tiêu IELTS&nbsp;B1–B2</p>
            </div>
            <div class="ct-road__arrow">→</div>
          </div>
          <div class="ct-road__item ct-road__item--last">
            <div class="ct-road__badge ct-road__badge--gold">THPT</div>
            <div class="ct-road__content">
              <strong>THPT</strong>
              <p>IELTS Prep chuyên sâu — Bảo hành đầu ra&nbsp;6.0+</p>
            </div>
            <div class="ct-road__result">🏆 IELTS 6.0+</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== LỢI ÍCH LIÊN CẤP ====== -->
    <section class="ct-section ct-benefit">
      <div class="ct-container">
        <div class="ct-benefit__inner">
          <div class="ct-benefit__text">
            <p class="ct-eyebrow">Tại sao chọn hệ thống liên cấp?</p>
            <h2>Học 1 trường — Phát triển trọn 16 năm</h2>
            <p>Nhiều phụ huynh phải lo tìm trường mới mỗi 3–4 năm: con thích nghi lại từ đầu, tiếng Anh bị đứt gãy, hồ sơ học tập bị mất dữ liệu.</p>
            <p>Tại Trường Việt Anh, con theo học xuyên suốt từ 1 đến 18 tuổi — <strong>giáo viên nắm rõ từng em, chương trình tiếng Anh tiến bộ liên tục</strong>, phụ huynh yên tâm hoàn toàn.</p>
            <div class="ct-benefit__proof">
              <span class="ct-proof-stat"><strong>70%</strong> phụ huynh cho con học liên cấp từ Mầm non đến THPT</span>
            </div>
          </div>

          <div class="ct-compare">
            <div class="ct-compare__col ct-compare__col--other">
              <p class="ct-compare__label">Học nhiều trường</p>
              <ul>
                <li>❌ Thi đầu vào lại mỗi lần lên cấp</li>
                <li>❌ Tiếng Anh dạy khác nhau, bị đứt gãy</li>
                <li>❌ Giáo viên mới không biết gì về con</li>
                <li>❌ Tìm trường mới mỗi 3–4 năm</li>
                <li>❌ Bạn bè thay đổi liên tục, stress</li>
              </ul>
            </div>
            <div class="ct-compare__col ct-compare__col--va">
              <p class="ct-compare__label">Liên cấp Việt Anh</p>
              <ul>
                <li>✅ Chuyển cấp nội bộ, ưu tiên xét tuyển</li>
                <li>✅ Tiếng Anh liên tục Immersion → IELTS</li>
                <li>✅ Theo dõi học sinh xuyên suốt 16 năm</li>
                <li>✅ Yên tâm toàn bộ K12 trong 1 hệ thống</li>
                <li>✅ Môi trường quen, bạn bè ổn định</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== IMAGE + CTA MID ====== -->
    <section class="ct-mid-cta">
      <div class="ct-container">
        <div class="ct-mid-cta__inner">
          <div class="ct-mid-cta__text">
            <p class="ct-eyebrow" style="color:#f9dd0e;">Đặt lịch ngay hôm nay</p>
            <h2>Tham quan trường miễn phí — Gặp giáo viên, dự giờ học</h2>
            <p>Buổi tham quan 60–90 phút: cơ sở vật chất, gặp trực tiếp giáo viên, dự thử 1 tiết học. Hoàn toàn miễn phí và không ràng buộc.</p>
          </div>
          <div class="ct-mid-cta__actions">
            <a href="#ct-bottom-form" class="ct-btn ct-btn--primary">Đăng ký tham quan</a>
            <a href="tel:0916961409" class="ct-btn ct-btn--outline">📞 0916 961 409</a>
            <a href="https://zalo.me/1678310120468101523" class="ct-btn ct-btn--outline" target="_blank" rel="noopener">💬 Zalo ngay</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TRUST LOGOS ====== -->
    <section class="ct-section ct-trust">
      <div class="ct-container">
        <p class="ct-trust__label">Chương trình triển khai cùng</p>
        <div class="ct-trust__row">
          <div class="ct-trust__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
            <span>Franklin Covey — Leader in Me</span>
          </div>
          <div class="ct-trust__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <span>Oxford University Press</span>
          </div>
          <div class="ct-trust__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span>British Council — IELTS Test Center</span>
          </div>
          <div class="ct-trust__item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span>Birmingham City University</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== FAQ ====== -->
    <section class="ct-section ct-faq" id="faq">
      <div class="ct-container">
        <div class="ct-section__heading">
          <p class="ct-eyebrow">Câu hỏi thường gặp</p>
          <h2>Phụ huynh hỏi nhiều nhất về chương trình</h2>
        </div>
        <div class="ct-faq__list">
          {cmsFaqs ? (
            cmsFaqs.map((faq: any, i: number) => (
              <details class="ct-faq__item" open={i === 0}>
                <summary>{faq.question}</summary>
                <div class="ct-faq__answer"><p set:html={faq.answer} /></div>
              </details>
            ))
          ) : (
            <>
          <details class="ct-faq__item" open>
            <summary>Trường Việt Anh có những chương trình học nào?</summary>
            <div class="ct-faq__answer"><p>4 cấp học liên tục: Mầm non (1–6 tuổi), Tiểu học (lớp 1–5), THCS (lớp 6–9) và THPT (lớp 10–12). Học sinh theo học xuyên suốt trong cùng hệ thống từ 1 đến 18 tuổi, không bị gián đoạn khi chuyển cấp.</p></div>
          </details>
          <details class="ct-faq__item">
            <summary>Chương trình tiếng Anh có liên tục giữa các cấp không?</summary>
            <div class="ct-faq__answer"><p>Có. Lộ trình xuyên suốt: Immersion 100% (Mầm non) → UK Oxford (Tiểu học) → Academic English, mục tiêu IELTS B1–B2 (THCS) → IELTS Prep chuyên sâu, bảo hành đầu ra IELTS 6.0+ ghi trong hợp đồng (THPT). Không bị đứt gãy hay lặp lại giữa các cấp.</p></div>
          </details>
          <details class="ct-faq__item">
            <summary>Học sinh có thể chuyển cấp trong nội bộ không?</summary>
            <div class="ct-faq__answer"><p>Có. Học sinh chuyển cấp nội bộ được ưu tiên xét tuyển, không cần thi đầu vào lại. Toàn bộ hồ sơ học tập, kế hoạch phát triển cá nhân và đánh giá tiếng Anh đều được chuyển giao liên tục giữa các cấp.</p></div>
          </details>
          <details class="ct-faq__item">
            <summary>Học phí các cấp học tại Trường Việt Anh là bao nhiêu?</summary>
            <div class="ct-faq__answer"><p>Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng — là học phí chương trình chính khoá, tiền ăn và phí dịch vụ tính riêng. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Gia đình có anh chị em ruột được giảm 50% cho con thứ hai và 25% cho con thứ ba. <a href="/hoc-phi">Xem bảng học phí chi tiết</a>.</p></div>
          </details>
          <details class="ct-faq__item">
            <summary>Trường Việt Anh nhận học sinh chuyển trường giữa chừng không?</summary>
