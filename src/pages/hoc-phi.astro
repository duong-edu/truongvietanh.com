---
// Trang trụ CÔNG KHAI — Học phí & tổng chi phí năm học Trường Việt Anh 2026–2027.
// Nguồn nội dung: docs/hoc-phi-truong-viet-anh.md (bản 2, 31/08/2026) — đã áp toàn bộ
// quyết định của anh Dương trên file đối chiếu doi-chieu-hoc-bong-vs-hoc-phi.docx.
//
// ⚠️ TRANG NÀY THAY THẾ SQUEEZE PAGE CŨ (funnel `squeeze-hoc-phi`, lead magnet
// /downloads/bang-gia-uu-dai-2026.pdf). Bản cũ nằm trong git history nếu cần khôi phục.
// Trang có FORM LEAD (thêm 01/09/2026) — component LeadFormTwoStepEmailFirst, funnel_code
// riêng "pillar-hoc-phi-2026". Component TỰ nạp /js/va-utm.js và tự gắn UTM vào cả lệnh
// partial-capture lẫn submit chính, nên quy tắc UTM của CLAUDE.md đã thoả.
// LƯU Ý khi tự kiểm: grep "va-utm.js" trong FILE NÀY ra 0 vì script nằm trong component —
// phải kiểm trên HTML đã dựng, không kiểm trên mã nguồn trang.
//
// Quy tắc viết (giống /hoc-bong và /chinh-sach-ai):
//   - Mỗi H2 có anchor id tiếng Việt không dấu.
//   - Bảng là <table> thật, bọc .gi-table-responsive để cuộn ngang trên mobile.
//   - FAQ dùng <details>/<summary> để gập lại — KHÁC /hoc-bong và /chinh-sach-ai (h3 + p).
//     Đổi theo yêu cầu 01/09/2026: 7 câu trả lời dài, hiện hết một lúc thì rối mắt.
//     An toàn cho AEO vì <details> là HTML tĩnh dựng sẵn ở server: toàn bộ câu trả lời
//     NẰM TRONG HTML, chỉ ẩn bằng CSS, không nạp bằng JS. Bot đọc raw HTML vẫn thấy đủ.
//     Thêm nữa schema FAQPage bên dưới chứa nguyên văn 7 câu hỏi–đáp, và đó mới là thứ
//     Google/AI trích. TUYỆT ĐỐI không chuyển sang render câu trả lời bằng JS.
//   - <article> gắn data-no-collapse — trang văn bản dài, không cho JS gập nội dung.
//
// MỌI CON SỐ TIỀN TÍNH TỪ HẰNG SỐ BÊN DƯỚI — đổi 1 số là các bảng tổng tự tính lại.
// Đừng hard-code lại tiền trong phần thân trang.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { openingHours } from '../data/school-facts';

const canonical = 'https://truongvietanh.com/hoc-phi';

const vnd = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const trieu = (n: number) => (n / 1_000_000).toFixed(1).replace('.', ',');

// ── HỌC PHÍ, cơ sở Gò Vấp (Phan Huy Ích) & Bình Tân ─────────────────────────
// tien   = năm học 2026–2027 (nguồn Chính sách SP & DV 2026–2027, CV Major251008)
// tien2728 = năm học 2027–2028 (nguồn Thông báo số 10/2026/TB-VA ngày 12/10/2026)
// MỌI SỐ DẪN XUẤT (tổng, ví dụ, FAQ) tính trên tien = 2026–2027; bảng hiển thị cả hai năm.
const HOC_PHI = [
  { lop: 'Lớp 1', tien: 109_857_000, tien2728: 118_998_000 },
  { lop: 'Lớp 2', tien: 112_957_000, tien2728: 121_998_000 },
  { lop: 'Lớp 3', tien: 116_457_000, tien2728: 125_998_000 },
  { lop: 'Lớp 4', tien: 119_757_000, tien2728: 129_998_000 },
  { lop: 'Lớp 5', tien: 122_557_000, tien2728: 132_998_000 },
  { lop: 'Lớp 6', tien: 125_757_000, tien2728: 135_998_000 },
  { lop: 'Lớp 7', tien: 128_757_000, tien2728: 139_998_000 },
  { lop: 'Lớp 8', tien: 132_757_000, tien2728: 143_998_000 },
  { lop: 'Lớp 9', tien: 136_257_000, tien2728: 147_998_000 },
  { lop: 'Lớp 10', tien: 137_257_000, tien2728: 148_998_000 },
  { lop: 'Lớp 11', tien: 142_557_000, tien2728: 153_998_000 },
  { lop: 'Lớp 12', tien: 164_757_000, tien2728: 177_998_000 },
];
const hpMin = Math.min(...HOC_PHI.map((h) => h.tien));
const hpMax = Math.max(...HOC_PHI.map((h) => h.tien));
const hpTong12Nam = HOC_PHI.reduce((s, h) => s + h.tien, 0);

// ── CÁC KHOẢN NGOÀI HỌC PHÍ ─────────────────────────────────────────────────
const OIC_PHU_THU = 20_000_000;
// Nội trú thu khác nhau theo cơ sở — Bình Tân cao hơn Gò Vấp.
const NOI_TRU_GO_VAP = 2_500_000;
const NOI_TRU_BINH_TAN = 3_200_000;

const CSVC_TIEU_HOC = 5_000_000;
const CSVC_TRUNG_HOC = 6_000_000;
const TAI_LIEU = 2_000_000;
const DA_NGOAI = 4_000_000;
const BHYT = 572_000;
const DONG_PHUC = 1_600_000;
const KIT_MIN = 800_000;
const KIT_MAX = 2_800_000;

const AN_TIEU_HOC = 19_836_000;
const AN_TRUNG_HOC = 27_144_000;
const AN_TRUNG_HOC_TOI = 36_540_000;
const AN_LOP_12 = 30_264_000;
const AN_NOI_TRU_12 = 40_740_000;
const CHENH_AN_TOI = AN_TRUNG_HOC_TOI - AN_TRUNG_HOC;

// ── BA VÍ DỤ TỔNG CHI PHÍ NĂM ĐẦU ───────────────────────────────────────────
const viDu = [
  { ten: 'Lớp 1', hocPhi: 109_857_000, csvc: CSVC_TIEU_HOC, an: AN_TIEU_HOC },
  { ten: 'Lớp 6', hocPhi: 125_757_000, csvc: CSVC_TRUNG_HOC, an: AN_TRUNG_HOC },
  { ten: 'Lớp 12', hocPhi: 164_757_000, csvc: CSVC_TRUNG_HOC, an: AN_LOP_12 },
].map((v) => {
  const ngoaiHocPhi = v.csvc + TAI_LIEU + DA_NGOAI + v.an + DONG_PHUC + KIT_MIN + BHYT;
  return { ...v, ngoaiHocPhi, tong: v.hocPhi + ngoaiHocPhi };
});
const tongMin = Math.min(...viDu.map((v) => v.tong));
const tongMax = Math.max(...viDu.map((v) => v.tong));
const ngoaiMin = Math.min(...viDu.map((v) => v.ngoaiHocPhi));
// Trần trên: khối 6–11 đăng ký thêm bữa tối. Lớp 12 có gói ăn riêng nên không cộng bữa tối.
const ngoaiMax = Math.max(...viDu.map((v) => v.ngoaiHocPhi), viDu[1].ngoaiHocPhi + CHENH_AN_TOI);
const lop6CoAnToi = viDu[1].tong + CHENH_AN_TOI;

// Tổng 12 năm gồm ăn + dịch vụ (5 năm tiểu học, 6 năm khối 6–11, 1 năm lớp 12)
const anCa12Nam = 5 * AN_TIEU_HOC + 6 * AN_TRUNG_HOC + AN_LOP_12;
const tong12NamDuKien =
  hpTong12Nam + anCa12Nam +
  (CSVC_TIEU_HOC + CSVC_TRUNG_HOC * 2) +   // 3 cấp học
  TAI_LIEU * 12 + DA_NGOAI * 12 + BHYT * 12 + DONG_PHUC * 4;

// Ưu đãi đóng trọn năm — ví dụ trên lớp 6
const GIAM_TRON_NAM = 0.06;
const viDuGiam6 = Math.round(viDu[1].hocPhi * GIAM_TRON_NAM);

// ── QUY RA THÁNG ────────────────────────────────────────────────────────────
// Phụ huynh hay so với trường thu theo tháng, nên phải nói rõ chia theo cách nào.
// Chia 12 làm con số nhỏ đi vì năm học thực tế chỉ khoảng 10 tháng — nêu cả hai
// để không bị hiểu là học phí thấp hơn thực tế.
const THANG_NAM_HOC = 10;
const thang = (n: number, chia: number) => trieu(n / chia);

// ── FAQ — dùng chung cho phần hiển thị và schema, không chép tay hai lần ─────
const faqs = [
  {
    id: 'faq-mot-thang',
    q: 'Học phí Trường Việt Anh một tháng khoảng bao nhiêu?',
    a: `Học phí công bố theo năm, từ ${trieu(hpMin)} đến ${trieu(hpMax)} triệu đồng tùy khối lớp 1–12 tại cơ sở Gò Vấp và Bình Tân (năm học 2026–2027) — đây là phần học phí, chưa gồm tiền ăn và phí dịch vụ. Chia đều 12 tháng thì tương đương ${thang(hpMin, 12)}–${thang(hpMax, 12)} triệu đồng/tháng; tính trọn gói cả tiền ăn, cơ sở vật chất, tài liệu, dã ngoại, bảo hiểm và đồng phục thì khoảng ${thang(tongMin, 12)}–${thang(tongMax, 12)} triệu đồng/tháng. Lưu ý năm học chỉ kéo dài khoảng ${THANG_NAM_HOC} tháng, nên chia theo tháng đi học thật thì cao hơn: ${thang(hpMin, THANG_NAM_HOC)}–${thang(hpMax, THANG_NAM_HOC)} triệu tiền học phí, hoặc ${thang(tongMin, THANG_NAM_HOC)}–${thang(tongMax, THANG_NAM_HOC)} triệu trọn gói. Trường nhận đóng theo 1, 2 hoặc 4–12 đợt, không tính thêm phí trả góp.`,
  },
  {
    id: 'faq-oic',
    q: 'Lớp Tăng cường tiếng Anh khác lớp thường thế nào, đóng thêm bao nhiêu?',
    a: `Lớp Tăng cường tiếng Anh dùng thêm học liệu quốc tế có bản quyền (Oxford, Cambridge) để luyện kỹ năng tiếng Anh, đóng thêm ${vnd(OIC_PHU_THU)}đ/năm (Oxford license) ngoài học phí chuẩn; mở ở lớp 1–12 tại cơ sở Phan Huy Ích. Cả lớp thường lẫn lớp tăng cường đều học 100% chương trình GDPT 2018 của Bộ GD&ĐT — học liệu quốc tế chỉ là phần bổ trợ, không phải chương trình tích hợp hay chương trình nước ngoài.`,
  },
  {
    id: 'faq-cong-don',
    q: 'Các ưu đãi và học bổng có cộng dồn được với nhau không?',
    a: 'Có. Ưu đãi đóng phí theo thời gian — theo năm 6%, theo học kỳ 2%, Early Bird — cộng thêm lên trên mọi mức khác. Bốn học bổng con giành được cộng dồn với nhau và cộng dồn với ưu đãi anh chị em ruột. Ưu đãi anh chị em ruột không giới hạn số suất và không có hạn chót. Riêng quỹ LOVE nằm ngoài mọi luật cộng dồn.',
  },
  {
    id: 'faq-noi-tru',
    q: 'Nội trú nhận ở cơ sở nào và chi phí bao nhiêu?',
    a: `Nội trú nhận tại cơ sở Gò Vấp và Bình Tân. Phí ở là ${vnd(NOI_TRU_GO_VAP)}đ/tháng tại Gò Vấp và ${vnd(NOI_TRU_BINH_TAN)}đ/tháng tại Bình Tân, chưa gồm tiền ăn. Học sinh nội trú đăng ký gói ăn riêng theo bảng phí ăn công bố — gói nội trú toàn phần lớp 12 là ${vnd(AN_NOI_TRU_12)}đ/năm. Bộ kit nội trú tính riêng, từ ${vnd(KIT_MIN)} đến ${vnd(KIT_MAX)}đ tùy nhu cầu.`,
  },
  {
    id: 'faq-ai',
    q: 'Chương trình AI 30 tiết có thu thêm tiền không?',
    a: 'Không. Chương trình AI 30 tiết/lớp/năm áp dụng lớp 3–12 từ năm học 2026–2027 đã nằm trong học phí công bố. Mức này cao hơn mức sàn 12 tiết/năm mà Bộ GD&ĐT quy định tại Quyết định 2422/QĐ-BGDĐT, và trường không mở lớp AI thu phí riêng.',
  },
  {
    id: 'faq-giua-nam',
    q: 'Giữa năm trường có thu thêm khoản nào không?',
    a: 'Không có khoản thu bắt buộc nào phát sinh trong năm học — đây là cam kết in trong chính sách phí. Các khoản chỉ phát sinh khi anh chị chủ động đăng ký dịch vụ tùy chọn: nội trú, tutor sau giờ, luyện tiếng Anh 1-1, xe đưa rước. Học phí năm sau có trần tăng tối đa 10%, là mức trần chứ không phải cam kết tăng, và luôn công bố trước.',
  },
  {
    id: 'faq-hoan-phi',
    q: 'Đóng học phí rồi, nếu con chuyển trường có được hoàn lại không?',
    a: 'Tiền ăn và phí dịch vụ tính theo thực tế sử dụng, phần chưa dùng được hoàn lại. Với gia đình đã đóng Early Bird nhiều năm, anh chị lấy lại toàn bộ phần tiền chưa dùng, chỉ cần báo trước 30 ngày, không cần lý do và không mất phí phạt. Phần thời gian con đã học giữ nguyên mức ưu đãi Early Bird, trường không truy thu phần đã giảm.',
  },
];

const description = `Học phí Trường Việt Anh 2026–2027 và 2027–2028, lớp 1–12 tại Gò Vấp & Bình Tân. Năm 2026–2027 ${trieu(hpMin)}–${trieu(hpMax)} triệu đồng/năm; tổng chi phí thực tế ${Math.round(tongMin / 1e6)}–${Math.round(tongMax / 1e6)} triệu/năm, cam kết không phát sinh giữa năm.`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Tuyển sinh', item: 'https://truongvietanh.com/tuyen-sinh' },
      { '@type': 'ListItem', position: 3, name: 'Học phí', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: 'Học phí Trường Việt Anh 2026–2027 và tổng chi phí năm học',
    description,
    inLanguage: 'vi-VN',
    datePublished: '2026-08-31T09:00:00+07:00',
    dateModified: '2026-08-31T09:00:00+07:00',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    author: {
      '@type': 'Person',
      '@id': 'https://nguyenmanhduong.com/#person',
      name: 'Nguyễn Mạnh Dương',
      jobTitle: 'Nhà sáng lập & Chủ tịch hệ thống giáo dục K-12 Việt Anh',
      url: 'https://nguyenmanhduong.com',
    },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://truongvietanh.com/#organization',
      name: 'Hệ thống giáo dục Việt Anh',
      logo: { '@type': 'ImageObject', url: 'https://truongvietanh.com/images/logo.png' },
    },
    about: [
      { '@type': 'Thing', name: 'Học phí trường song ngữ TP.HCM' },
      { '@type': 'Thing', name: 'Chi phí năm học K-12' },
    ],
    audience: { '@type': 'Audience', audienceType: 'Phụ huynh học sinh K-12 tại Việt Nam' },
    keywords:
      'học phí Trường Việt Anh, học phí trường song ngữ TP.HCM, tổng chi phí năm học, học phí 2026-2027, trường tư thục TP.HCM',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Học Phí Trường Việt Anh 2026–2027 & 2027–2028 | Chi Phí Năm Học"
  description={description}
  keywords="học phí Trường Việt Anh, học phí trường song ngữ TPHCM, bảng học phí lớp 1-12, tổng chi phí năm học, học phí 2026-2027, trường tư thục TPHCM"
  canonical={canonical}
  ogType="article"
  structuredData={structuredData}
>
  <div class="gi-page hp-page">
    <HeaderBase currentPath="/hoc-phi" />

    <!-- ══════════ HERO ══════════ -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left" style="flex:1">
          <div class="hp-hero-topline">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">›</span>
            <a href="/tuyen-sinh">Tuyển sinh</a>
            <span aria-hidden="true">›</span>
            <span>Học phí</span>
          </nav>
          <h1 class="gi-h1">Học phí Việt Anh 2026–2027 &amp; 2027–2028: đủ mọi khoản của một năm học</h1>
          <p class="hp-hero-sub">
            Học phí <strong>{trieu(hpMin)}–{trieu(hpMax)} triệu đồng/năm</strong> tùy khối, lớp 1–12.
            Cộng ăn uống, tài liệu, dã ngoại và cơ sở vật chất, tổng năm đầu khoảng
            <strong> {Math.round(tongMin / 1e6)}–{Math.round(tongMax / 1e6)} triệu đồng</strong>.
          </p>
          </div>

          <div class="hp-hero-rest">
          <p class="hp-hero-body">
            Trang này liệt kê mọi khoản anh chị sẽ chi trong 12 tháng: khoản nào bắt buộc, khoản nào
            tùy chọn, khoản nào hoàn lại được. Không có dòng nào ghi &ldquo;liên hệ để biết thêm&rdquo;.
          </p>

          {/* Link "xuống bảng" đặt TRƯỚC nút CTA — nếu để cuối hero nó rơi đúng góc trái
              dưới màn hình, chỗ widget Chat Zalo OA (fixed, z999) đè lên. */}
          <a href="#bang-hoc-phi" class="hp-hero-link">Xuống thẳng bảng học phí từng khối ↓</a>

          <div class="hp-hero-actions">
            <a href="/hoc-bong" class="hp-cta" data-cta-position="hero">
              Xem 9 chính sách học bổng &amp; ưu đãi →
            </a>
            <p class="hp-cta-hint">
              Con số bên dưới là <strong>giá niêm yết</strong>. Hầu hết gia đình đóng thấp hơn — xem
              mình được giảm bao nhiêu trước khi lên kế hoạch tài chính cho con.
            </p>
          </div>
          </div>
        </div>

          <div class="gi-hero-right">
            <div class="hp-hero-form" data-form-bg="light">
              <LeadFormTwoStepEmailFirst
                formId="hp"
                funnelCode="pillar-hoc-phi-2026"
                schoolLevel=""
                title="Để lại thông tin, nhân viên tư vấn trực tiếp"
                description="Nhân viên tuyển sinh sẽ liên hệ lại, tư vấn học phí đúng khối của con và mức ưu đãi gia đình mình được hưởng."
                socialProof=""
                nextText="Nhận tư vấn"
                submitText="Gửi thông tin"
                successMessage="Đã nhận thông tin của anh chị. Nhân viên tư vấn sẽ liên hệ trong 24 giờ làm việc."
              />
            </div>
          </div>

      </div>
    </section>

    <div class="gi-container gi-body">
      <!-- ══════════ MỤC LỤC ══════════ -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Nội dung</p>
        <ol class="gi-toc-list">
          <li><a href="#bang-hoc-phi">Học phí từng khối</a></li>
