---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultSiteUrl } from '../lib/site-content';
import { getTestimonials } from '../lib/directus';

import HeroSection from '../components/homepage/HeroSection.astro';
import WorriesSection from '../components/homepage/WorriesSection.astro';
import StatsAndTrust from '../components/homepage/StatsAndTrust.astro';
import PhilosophySection from '../components/homepage/PhilosophySection.astro';
import OutcomesSection from '../components/homepage/OutcomesSection.astro';
import TestimonialsSection from '../components/homepage/TestimonialsSection.astro';
import ProgramsSection from '../components/homepage/ProgramsSection.astro';
import BrochureFormSection from '../components/homepage/BrochureFormSection.astro';
import FAQSectionHome from '../components/homepage/FAQSectionHome.astro';
import CommitmentSection from '../components/homepage/CommitmentSection.astro';
import ClosingCTASection from '../components/homepage/ClosingCTASection.astro';
import StickyMobileBar from '../components/homepage/StickyMobileBar.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || defaultSiteUrl;

const cmsTestimonials = await getTestimonials('index');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'Trường Liên Cấp Việt Anh',
    alternateName: 'Truong Viet Anh',
    url: 'https://truongvietanh.com',
    logo: 'https://truongvietanh.com/logo-crest-80.webp',
    telephone: '+84-916-961-409',
    description: 'Hệ thống giáo dục liên cấp song ngữ K-12 tại TP.HCM — AI-Powered School: dạy học sinh làm chủ AI với 30 tiết AI/năm cho lớp 3–12, 16 kỹ năng thế kỷ 21, bảo hành đầu ra IELTS 6.0+ ghi trong hợp đồng và Cam kết Giá trị 4 Tuần hoàn 100% học phí.',
    foundingDate: '2011',
    founder: {
      '@type': 'Person',
      '@id': 'https://nguyenmanhduong.com/#person',
      name: 'Nguyễn Mạnh Dương',
      jobTitle: 'Nhà sáng lập & Chủ tịch',
      url: 'https://nguyenmanhduong.com',
      image: 'https://truongvietanh.com/nguyen-manh-duong.jpg',
      sameAs: [
        'https://nguyenmanhduong.com',
        'https://www.facebook.com/nguyenmanhduong1101/',
        'https://www.youtube.com/@nguyenmanhduong1101',
        'https://www.linkedin.com/in/nguyenmanhduong',
      ],
    },
    address: [
      { '@type': 'PostalAddress', streetAddress: '160/72 Phan Huy Ích, Phường An Hội Tây', addressLocality: 'Quận Gò Vấp', addressRegion: 'TP.HCM', addressCountry: 'VN' },
      { '@type': 'PostalAddress', streetAddress: 'Số 7, Đường 38A', addressLocality: 'Phường Tân Tạo', addressRegion: 'TP.HCM', addressCountry: 'VN' },
    ],
    sameAs: ['https://www.facebook.com/truongvietanhhcm', 'https://www.youtube.com/@truongvietanh', 'https://www.instagram.com/truongvietanh', 'https://zalo.me/0916961409'],
    numberOfEmployees: { '@type': 'QuantitativeValue', value: 500 },
    contactPoint: { '@type': 'ContactPoint', telephone: '+84916961409', contactType: 'customer service', areaServed: 'VN', availableLanguage: ['vi', 'en'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Trường Việt Anh',
    alternateName: 'Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
    inLanguage: 'vi',
    description: 'Hệ thống giáo dục liên cấp song ngữ Anh-Việt từ Mầm Non đến THPT tại TP.HCM, Tây Ninh, An Giang.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://truongvietanh.com/tin-tuc?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Trường Việt Anh dạy từ cấp nào đến cấp nào?', acceptedAnswer: { '@type': 'Answer', text: 'Trường Việt Anh là hệ thống giáo dục liên cấp, đào tạo từ Mầm Non (từ 12 tháng) đến THPT (lớp 12), tại 2 cơ sở chính thức ở TP.HCM (Gò Vấp, Bình Tân), cùng các trường cùng chủ đầu tư và trường do Việt Anh phụ trách vận hành tại TP.HCM, Tây Ninh và An Giang.' } },
      { '@type': 'Question', name: 'Học phí Trường Việt Anh bao nhiêu?', acceptedAnswer: { '@type': 'Answer', text: 'Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Học phí đã gồm học liệu Oxford, giáo viên bản ngữ và 16 kỹ năng thế kỷ 21.' } },
      { '@type': 'Question', name: 'Học sinh tốt nghiệp Trường Việt Anh đạt IELTS bao nhiêu?', acceptedAnswer: { '@type': 'Answer', text: 'Trường Việt Anh có lộ trình đảm bảo giúp học sinh có thể đạt IELTS 6.0+ trước khi tốt nghiệp THPT; bảo hành đầu ra được ghi trong hợp đồng.' } },
      { '@type': 'Question', name: 'Trường Việt Anh có bao nhiêu cơ sở?', acceptedAnswer: { '@type': 'Answer', text: 'Trường Việt Anh có 2 cơ sở chính thức tại TP.HCM: cơ sở Gò Vấp (160/72 Phan Huy Ích) và cơ sở Bình Tân. Cùng chủ đầu tư với Trường Việt Anh có 4 trường: Mầm non Việt Anh (Gò Vấp), Mầm non Nhân Lễ, Mầm non và Tiểu học Thái Sơn (Cần Giuộc, Tây Ninh). Trường Việt Anh còn phụ trách vận hành Mầm non và Tiểu học Mekong Xanh (Rạch Giá, An Giang).' } },
      { '@type': 'Question', name: 'Phương pháp giáo dục PDR của Trường Việt Anh là gì?', acceptedAnswer: { '@type': 'Answer', text: 'PDR (Plan – Do – Review) là hệ thống học tập của Trường Việt Anh, đặt học sinh làm trung tâm qua 3 giai đoạn: tự lập kế hoạch (Plan), thực hiện (Do) và nhìn lại để rút kinh nghiệm (Review).' } },
      { '@type': 'Question', name: 'Làm sao để đăng ký tuyển sinh Trường Việt Anh?', acceptedAnswer: { '@type': 'Answer', text: 'Phụ huynh có thể đăng ký tư vấn tuyển sinh trực tiếp trên website truongvietanh.com, gọi hotline 0916 961 409, hoặc đặt lịch tham quan trường để được tư vấn chi tiết.' } },
      { '@type': 'Question', name: 'Trình độ tiếng Anh đầu ra của học sinh Trường Việt Anh?', acceptedAnswer: { '@type': 'Answer', text: 'Lộ trình đảm bảo giúp học sinh có thể đạt IELTS 6.0+ trước khi tốt nghiệp THPT, bảo hành ghi trong hợp đồng. Đây là mức đủ để xét tuyển vào hầu hết đại học thế giới và nhận học bổng du học.' } },
    ],
  },
];

const campusLinks = [
  { label: 'Trường Mầm non Việt Anh Gò Vấp - HCM', href: '/co-so/mam-non-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Gò Vấp - HCM', href: '/co-so/lien-cap-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Bình Tân - HCM', href: '/co-so/lien-cap-binh-tan' },
  { label: 'Trường Mầm non Nhân Lễ - Tây Ninh', href: '/co-so/mam-non-nhan-le' },
  { label: 'Trường Mầm non và Tiểu học Thái Sơn - Tây Ninh', href: '/co-so/thai-son' },
  { label: 'Trường Mầm non và Tiểu học Mekong Xanh - TP Rạch Giá - An Giang', href: '/co-so/mekong-xanh' },
];

// Section này thiết kế cho VIDEO clip phụ huynh — chỉ dùng dữ liệu CMS khi
// bản ghi có video_url; CMS toàn text thì giữ 6 clip mặc định bên dưới.
const cmsVideoTestimonials = cmsTestimonials.filter((t: any) => (t.video_url || '').trim());
const testimonials = cmsVideoTestimonials.length > 0
  ? cmsVideoTestimonials.map((t: any) => ({
      name: t.name,
      role: t.role,
      quote: t.quote,
      img: t.image && /^https?:\/\//.test(t.image) ? t.image : '',
      videoUrl: t.video_url,
    }))
  : [
    { name: 'Chị Nguyễn Thị Linh', role: 'Phụ huynh mầm non – bé 2 tuổi', quote: 'Từ em bé bướng bỉnh, con đã biết tự ăn và vào nề nếp. Con thay đổi rõ rệt chỉ sau vài tháng đầu.', img: 'https://img.youtube.com/vi/Bt1yyMil3Tg/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=Bt1yyMil3Tg' },
    { name: 'Anh Trần Minh Công', role: 'Phụ huynh lớp 1 – chuyển từ mầm non Việt Anh', quote: 'Con luôn háo hức và mong chờ được đến trường mỗi ngày. Đi học vui vẻ, không áp lực.', img: 'https://img.youtube.com/vi/b9eNSFUDd98/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=b9eNSFUDd98' },
    { name: 'Chị Mai', role: 'Mẹ học sinh lớp 3 – cơ sở Gò Vấp', quote: 'Sau 2 năm, con thay đổi rõ rệt cả về học tập và kỹ năng.', img: 'https://img.youtube.com/vi/3jwB87z-Keg/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=3jwB87z-Keg' },
    { name: 'Chị Phạm Ngọc Quỳnh', role: 'Phụ huynh lớp 7 – chuyển trường mới', quote: 'Chỉ sau hơn 1 tháng, con đã hòa nhập rất tốt với bạn bè và học tập vui vẻ mỗi ngày.', img: 'https://img.youtube.com/vi/cZ6S_3MG1Vo/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=cZ6S_3MG1Vo' },
    { name: 'Anh Lê Trung Thành', role: 'Phụ huynh THPT – lựa chọn môi trường', quote: 'Gia đình chọn trường vì môi trường giúp con phát triển toàn diện — từ kiến thức đến thái độ.', img: 'https://img.youtube.com/vi/5T8j_k5VCW4/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=5T8j_k5VCW4' },
    { name: 'Bạn Chu Anh Tài', role: 'Học sinh lớp 12 – Chủ tịch Hội học sinh', quote: 'Từ một người khép kín, em đã khám phá khả năng lãnh đạo và đảm nhận Chủ tịch Hội học sinh.', img: 'https://img.youtube.com/vi/NAYd7sM0d-8/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=NAYd7sM0d-8' },
  ];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — AI-Powered School liên cấp K-12 tại TP.HCM: 30 tiết AI/năm cho lớp 3–12, bảo hành IELTS 6.0+ trong hợp đồng, hoàn 100% học phí nếu 4 tuần đầu chưa như kỳ vọng."
  canonical="https://truongvietanh.com"
  noPopup={true}
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="site-shell site-shell--home">
    <SiteHeader currentPath="/" />

    <main>
      <HeroSection />

      <section class="aio-answer">
        <div class="aio-answer__inner">
          <p class="aio-answer__eyebrow">Về Trường Việt Anh</p>
          {/* Bản anh Dương chốt 03/11/2026 — thay đoạn văn 3 đoạn của 01/09. */}
          <p class="aio-answer__lead">
            <strong>Trường Việt Anh:</strong> Nơi những đứa trẻ bình thường trở nên phi thường, bất kể hoàn cảnh hay điểm số
          </p>
          <ul class="aio-answer__list">
            <li>Thành lập từ 2011 và năm 2026 từ trường chuyên Anh trở thành một trong những trường AI Powered School đầu tiên của Việt Nam. Việt Anh không phải nơi dạy học thuần tuý, đó là nơi cung cấp sự lựa chọn, cơ hội lãnh đạo, sự đồng hành và kèm cặp.</li>
            <li><strong>Đặc trưng:</strong> Khác với thói quen tập trung vào kiến thức, học sinh được kèm cặp để phát triển toàn diện 4 lĩnh vực: Kiến thức, Kỹ năng lãnh đạo, Phẩm chất, Sức khoẻ. Khẩu hiệu của học sinh Việt Anh không phải là “Giỏi nhất” mà là “Tiến lên”.</li>
            <li><strong>Thế mạnh:</strong> Lượng hoá rõ ràng sự tiến bộ của từng học sinh, để phụ huynh và chính các con nhìn thấy được, quản trị được, cải thiện được 1% mỗi ngày.</li>
            <li><strong>Lý do bạn nên chọn:</strong> Ở Việt Anh, con không học để trở thành một nhân viên mẫn cán. Con học để trở nên những nhà lãnh đạo tự thân tò mò, có giá trị đạo đức rõ ràng, biết sử dụng AI làm đòn bẩy để nâng cao hiệu suất của bản thân trên mọi ngả đường mình tự chọn.</li>
          </ul>
        </div>
      </section>

      <div class="page-flow">
        <WorriesSection />
        <StatsAndTrust />
        <PhilosophySection />
        <OutcomesSection />
        <TestimonialsSection testimonials={testimonials} />
        <ProgramsSection campusLinks={campusLinks} />
        <BrochureFormSection />
        <FAQSectionHome />
        <CommitmentSection />
        <ClosingCTASection />
      </div>
    </main>

    <SiteFooter />
    <StickyMobileBar />
  </div>
</BaseLayout>

<style>
  /* Đoạn giới thiệu — thẻ trắng nổi đè lên mép hero navy, viền gold trên đỉnh */
  .aio-answer {
    background: transparent;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
    margin-top: -2.25rem;
    margin-bottom: 0.75rem;
  }
  .aio-answer__inner {
    max-width: 860px;
    margin: 0 auto;
    background: #fff;
    border-radius: 20px;
    border-top: 4px solid #f9dd0e;
    box-shadow: 0 18px 50px rgba(18, 27, 76, 0.16);
    padding: 2rem 2.75rem 2.25rem;
  }
  .aio-answer__eyebrow {
    margin: 0 0 0.85rem;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #26275D;
  }
  .aio-answer__eyebrow::after {
    content: '';
    display: block;
    width: 44px;
    height: 3px;
    background: #f9dd0e;
    border-radius: 2px;
    margin: 0.5rem auto 0;
  }
  .aio-answer__text { margin: 0; }
  .aio-answer__lead {
    margin: 0 0 1rem;
    text-align: center;
    font-size: 1.2rem;
    line-height: 1.45;
    color: #26275D;
  }
  .aio-answer__list {
    margin: 0;
    padding-left: 1.25rem;
    text-align: left;
    color: #334155;
    display: grid;
    gap: 0.7rem;
    line-height: 1.65;
  }
  .aio-answer__list li::marker { color: #c9a800; }
  .aio-answer__list strong { color: #26275D; }
  @media (max-width: 760px) {
    .aio-answer__lead { font-size: 1.08rem; }
    .aio-answer { margin-top: -1.5rem; padding: 0 1rem; }
    .aio-answer__inner { padding: 1.5rem 1.25rem 1.75rem; }
  }
</style>
