    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 80% 20%, rgba(249, 221, 14, 0.18), transparent 65%),
      radial-gradient(ellipse 55% 60% at 15% 80%, rgba(99, 102, 241, 0.28), transparent 65%),
      linear-gradient(180deg, #26275D 0%, #1F2050 50%, #18193a 100%);
