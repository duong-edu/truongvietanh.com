---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import { getTestimonials } from '../../lib/directus';

const cmsTestimonials = await getTestimonials('index');

const productLinks = [
  { label: 'Mầm non', href: '/mam-non' },
  { label: 'Tiểu học', href: '/tieu-hoc' },
  { label: 'THCS', href: '/trung-hoc-co-so' },
  { label: 'THPT', href: '/trung-hoc-pho-thong' },
  { label: 'Trại hè', href: '/tuyen-sinh/trai-he/' },
  { label: 'Tiếng Anh Trẻ Em', href: '/tuyen-sinh/tieng-anh-tre-em/' },
  { label: 'Toán Tư Duy', href: '/tuyen-sinh/toan-tu-duy/' },
  { label: 'Giải Mã Tiềm Năng', href: '/tuyen-sinh/giai-ma-tiem-nang/' },
];

const campusLinks = [
  { label: 'Trường Mầm non Việt Anh Gò Vấp - HCM', href: '/co-so/mam-non-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Gò Vấp - HCM', href: '/co-so/lien-cap-go-vap' },
  { label: 'Trường Liên Cấp Việt Anh Bình Tân - HCM', href: '/co-so/lien-cap-binh-tan' },
  { label: 'Trường Mầm non Nhân Lễ - Tây Ninh', href: '/co-so/mam-non-nhan-le' },
  { label: 'Trường Mầm non và Tiểu học Thái Sơn - Tây Ninh', href: '/co-so/thai-son' },
  { label: 'Trường Mầm non và Tiểu học Mekong Xanh - TP Rạch Giá - An Giang', href: '/co-so/mekong-xanh' },
];

const testimonials = cmsTestimonials.length > 0
  ? cmsTestimonials.map((t: any) => ({ name: t.name, role: t.role, quote: t.quote, img: t.image || '', videoUrl: t.video_url || '' }))
  : [
    { name: 'Chị Linh', role: 'Phụ huynh mầm non – bé 2 tuổi', quote: 'Từ em bé bướng bỉnh, con đã biết tự ăn và vào nề nếp. Con thay đổi rõ rệt chỉ sau vài tháng đầu.', img: 'https://img.youtube.com/vi/Bt1yyMil3Tg/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=Bt1yyMil3Tg' },
    { name: 'Anh Công', role: 'Phụ huynh lớp 1 – chuyển từ mầm non', quote: 'Con luôn háo hức và mong chờ được đến trường mỗi ngày. Đi học vui vẻ, không áp lực.', img: 'https://img.youtube.com/vi/b9eNSFUDd98/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=b9eNSFUDd98' },
    { name: 'Chị Quỳnh', role: 'Phụ huynh lớp 7 – chuyển trường mới', quote: 'Chỉ sau hơn 1 tháng, con đã hòa nhập rất tốt với bạn bè và học tập vui vẻ mỗi ngày.', img: 'https://img.youtube.com/vi/cZ6S_3MG1Vo/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=cZ6S_3MG1Vo' },
    { name: 'Anh Lê Trung Thành', role: 'Phụ huynh THPT – lựa chọn môi trường', quote: 'Gia đình chọn trường vì môi trường giúp con phát triển toàn diện — từ kiến thức đến thái độ.', img: 'https://img.youtube.com/vi/5T8j_k5VCW4/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=5T8j_k5VCW4' },
    { name: 'Bạn Chu Anh Tài', role: 'Học sinh lớp 12 – Chủ tịch Hội học sinh', quote: 'Từ một người khép kín, em đã khám phá khả năng lãnh đạo và đảm nhận Chủ tịch Hội học sinh.', img: 'https://img.youtube.com/vi/NAYd7sM0d-8/hqdefault.jpg', videoUrl: 'https://www.youtube.com/watch?v=NAYd7sM0d-8' },
  ];

const pillars = [
  { num: '01', title: 'Tiếp thu tinh hoa thế giới, nhưng triển khai phù hợp với Việt Nam', lead: 'Trường Việt Anh học hỏi từ thế giới, không phải "bắt chước".', body: 'Chúng ta chọn cái tiến bộ nhất của thế giới, rồi biến nó thành trải nghiệm học tập thực sự vận hành được với học sinh Việt Nam và gia đình Việt Nam.' },
  { num: '02', title: 'Chất lượng cao nhưng không xây trên logic xa xỉ', lead: 'Giáo dục tốt không nên là đặc quyền của nhà giàu.', body: 'Chúng ta xây dựng nền giáo dục chất lượng, nhưng chỉ có giá trị nếu vẫn trong tầm với của những gia đình trung lưu có trách nhiệm.' },
  { num: '03', title: 'Không hy sinh tuổi thơ để đổi lấy thành tích', lead: 'Trẻ em xứng đáng có được niềm vui học tập, sự an toàn cảm xúc, và động lực phát triển bền vững.', body: 'Chúng ta không để đứa trẻ nào phải trả giá bằng sự mệt mỏi để có kết quả.' },
  { num: '04', title: 'Học là để dùng được, sống được, phát triển được', lead: 'Thực dụng là chỉ học cái có giá trị thật, rèn cái dùng được thật, phát triển cái giúp trẻ sống tốt thật.', body: 'Năng lực học tập không chỉ thể hiện trên bài thi, mà phải có thể chuyển hóa thành kết quả dài hạn.' },
  { num: '05', title: 'Tạo ra những lãnh đạo tự thân, không phải đi theo một con đường duy nhất', lead: 'Chúng ta không tạo ra những sản phẩm đồng bộ.', body: 'Chúng ta phát triển những nhà lãnh đạo tự thân đủ tự tin, đủ phẩm chất, đủ năng lực để quyết định những ngã rẽ riêng — kiến tạo cuộc đời và sống hạnh phúc, vinh quang theo cách của riêng mình.' },
];
---

<BaseLayout
  title="Trường Việt Anh | Hệ thống trường học liên cấp từ Mầm non đến THPT"
  description="Trường Việt Anh — hệ thống giáo dục liên cấp song ngữ tại TP.HCM. Tiếng Anh IELTS 6.0-8.0, kỹ năng thế kỷ 21, 99% đỗ ĐH. Học phí lớp 1–12 tại TP.HCM 9,2–13,7 triệu/tháng."
  canonical="https://truongvietanh.com/v2/"
  noPopup={true}
  ogImage="https://media.truongvietanh.com/images/trang-chu-3.webp"
>
  <div class="v2">
    <SiteHeader currentPath="/" />

    <main class="v2-main">

      <!-- ============ HERO ============ -->
      <section class="v2-hero">
        <div class="v2-hero__bg" aria-hidden="true"></div>
        <div class="v2-hero__container">
          <div class="v2-hero__content">
            <span class="v2-hero__eyebrow">
              <span class="v2-hero__pulse"></span>
              Tuyển sinh 2026–2027 đang mở
            </span>
            <h1 class="v2-hero__title">Trường Việt Anh</h1>
            <p class="v2-hero__subtitle">Hệ thống trường học Mầm non, Tiểu học, THCS và THPT</p>
            <p class="v2-hero__tag">Từ bình thường trở nên phi thường.</p>

            <div class="v2-hero__actions">
              <a class="v2-btn v2-btn--primary" href="/hoc-phi">
                Xem học phí
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a class="v2-btn v2-btn--ghost" href="#danh-gia">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.8 5.8 21 7 14 2 9.3 9 8.5 12 2"/></svg>
                Xem đánh giá
              </a>
              <a class="v2-btn v2-btn--link" href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer">
                Chat ngay
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              </a>
            </div>

            <ul class="v2-hero__badges">
              <li>99% vào đại học</li>
              <li>IELTS 6.0–8.0</li>
              <li>16 kỹ năng TK21</li>
              <li>Ngày càng khoẻ mạnh</li>
            </ul>
          </div>
        </div>

        <!-- KPI strip floating at bottom of hero -->
        <div class="v2-hero__kpi">
          <div class="v2-hero__kpi-inner">
            <div class="v2-kpi"><strong>2011</strong><span>Năm hình thành</span></div>
            <div class="v2-kpi"><strong>6.0+</strong><span>IELTS đầu ra tối thiểu</span></div>
            <div class="v2-kpi"><strong>99%</strong><span>Học sinh vào đại học</span></div>
            <div class="v2-kpi"><strong>95%</strong><span>Tiến bộ trên 4 lĩnh vực</span></div>
          </div>
        </div>
      </section>

      <!-- ============ INTRO + TRUST ============ -->
      <section class="v2-section v2-section--intro">
        <div class="v2-container v2-intro">
          <p class="v2-intro__text">
            <strong>Trường Việt Anh</strong> thành lập năm 2011 tại TP HCM, là lựa chọn yêu thích của các gia đình trí thức trung lưu, khao khát với giáo dục hiện đại, kỳ vọng cao ở kỹ năng và phẩm chất của học sinh. Học sinh Việt Anh trải nghiệm quãng thời gian học tập vui vẻ, hạnh phúc, ra trường với các kỹ năng, phẩm chất lãnh đạo của thế kỷ 21, giành được quyền chọn của riêng mình với các trường đại học danh giá trong và ngoài nước.
          </p>

          <div class="v2-trust">
            <span class="v2-trust__label">Được công nhận bởi</span>
            <div class="v2-trust__row">
              <div class="v2-trust__item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                <span>Franklin Covey — Leader in Me</span>
              </div>
              <div class="v2-trust__item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span>Oxford University Press</span>
              </div>
              <div class="v2-trust__item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                <span>British Council — IELTS Test Center</span>
              </div>
              <div class="v2-trust__item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span>Birmingham City University</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ 3 KHÁC BIỆT (đẩy lên sớm — kết quả trước triết lý) ============ -->
      <section class="v2-section">
        <div class="v2-container">
          <header class="v2-heading">
            <p class="v2-eyebrow">Điểm khác biệt</p>
            <h2>3 khác biệt của học sinh Việt Anh</h2>
          </header>

          <div class="v2-why-grid">
            <article class="v2-why">
              <div class="v2-why__media">
                <img src="https://media.truongvietanh.com/images/du-an-03.webp" alt="Học sinh tiểu học Việt Anh làm dự án thực tế" loading="lazy" width="500" height="340" />
                <span class="v2-why__num">01</span>
              </div>
              <div class="v2-why__body">
                <h3>Nội dung học thực dụng</h3>
                <p>Học sinh được phát triển đầy đủ 16 kỹ năng thế kỷ 21 theo chuẩn WEF, nội dung mà các trường K-12 hàng đầu thế giới đang thực hiện.</p>
                <details class="v2-more">
                  <summary>Đọc thêm</summary>
                  <p>Nghiên cứu của WEF chỉ ra, trong khi các nước tiên tiến đã đầu tư đủ 16 kỹ năng trong giáo dục, mặt bằng chung của Việt Nam còn đang thiếu hụt. Trường Việt Anh dày công xây dựng chương trình phát triển đầy đủ 16 kỹ năng qua các môn học, hoạt động ngoại khoá và văn hoá trường học. Giáo trình cập nhật mỗi năm để đáp ứng sự biến đổi của xã hội do cách mạng AI mang lại.</p>
                </details>
              </div>
            </article>

            <article class="v2-why">
              <div class="v2-why__media">
                <img src="/giao-vien-ban-ngu.jpg" alt="Giáo viên bản ngữ dạy tiếng Anh cho học sinh Việt Anh" loading="lazy" width="500" height="340" />
                <span class="v2-why__num">02</span>
              </div>
              <div class="v2-why__body">
                <h3>Tiếng Anh đủ du học</h3>
                <p>Học sinh đạt tối thiểu IELTS 6.0 trước khi tốt nghiệp THPT — đủ điều kiện xét tuyển hầu hết các đại học trên thế giới.</p>
                <details class="v2-more">
                  <summary>Đọc thêm</summary>
                  <p>Lộ trình tiếng Anh xuyên suốt từ Mầm Non (100% immersion), Tiểu học (chương trình Oxford), THCS (giao tiếp + học thuật), đến THPT (luyện IELTS). Tổ Tiếng Anh do giáo viên bản ngữ phụ trách. Chương trình tiếng Anh được hợp tác triển khai ở hơn 100 trường công tư khác.</p>
                </details>
              </div>
            </article>

            <article class="v2-why">
              <div class="v2-why__media">
                <img src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp" alt="Học sinh Việt Anh thuyết trình, dẫn dắt và trưởng thành sớm" loading="lazy" width="500" height="340" />
                <span class="v2-why__num">03</span>
              </div>
              <div class="v2-why__body">
                <h3>Học sinh sớm trưởng thành</h3>
                <p>Học sinh được rèn năng lực lãnh đạo bản thân từ sớm, dần mở rộng ảnh hưởng ra đội nhóm, lớp học và xã hội.</p>
                <details class="v2-more">
                  <summary>Đọc thêm</summary>
                  <p>Chương trình xây dựng trên 5 giá trị cốt lõi và 7 thói quen lãnh đạo (chương trình "Leader in Me" từ Franklin Covey). Phụ huynh tham quan trường đều ngạc nhiên khi thấy dấu ấn của học sinh ở khắp nơi — từ cơ sở vật chất, ngày lễ đến văn hoá và chính sách nhà trường.</p>
                </details>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ TESTIMONIALS ============ -->
      <section class="v2-section v2-section--soft" id="danh-gia">
        <div class="v2-container">
          <header class="v2-heading">
            <p class="v2-eyebrow">Đánh giá của phụ huynh & học sinh</p>
            <h2>Phụ huynh và học sinh nói gì về Trường Việt Anh?</h2>
          </header>

          <div class="v2-testi-grid">
            {testimonials.map((item) => (
              <article class="v2-testi">
                <svg class="v2-testi__quote-mark" width="32" height="32" viewBox="0 0 24 24" fill="#f9dd0e" aria-hidden="true"><path d="M7 11h3v10H0V11c0-4.4 3.6-8 8-8v3c-2.8 0-5 2.2-5 5h4zm14 0h3v10H14V11c0-4.4 3.6-8 8-8v3c-2.8 0-5 2.2-5 5h4z"/></svg>
                <p class="v2-testi__quote">{item.quote}</p>
                <div class="v2-testi__person">
                  <div class="v2-testi__avatar">
                    {item.videoUrl ? (
                      <a href={item.videoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Xem video – ${item.name}`}>
                        <img src={item.img || 'https://media.truongvietanh.com/images/phu-huynh-04.webp'} alt={item.name} loading="lazy" width="56" height="56" />
                        <span class="v2-testi__play" aria-hidden="true">▶</span>
                      </a>
                    ) : (
                      <img src={item.img || 'https://media.truongvietanh.com/images/phu-huynh-04.webp'} alt={item.name} loading="lazy" width="56" height="56" />
                    )}
                  </div>
                  <div>
                    <strong>{item.name}</strong>
                    <span>{item.role}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ 5 NỀN TẢNG TRIẾT LÝ — accordion-tabs (giảm chiều dài) ============ -->
      <section class="v2-section">
        <div class="v2-container">
          <header class="v2-heading">
            <p class="v2-eyebrow">Triết lý giáo dục</p>
            <h2>Trường Việt Anh xây dựng triết lý giáo dục trên 5 nền tảng</h2>
          </header>

          <div class="v2-pillars">
            {pillars.map((p, i) => (
              <details class="v2-pillar" open={i === 0}>
                <summary>
                  <span class="v2-pillar__num">{p.num}</span>
                  <span class="v2-pillar__title">{p.title}</span>
                  <span class="v2-pillar__chev" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <div class="v2-pillar__body">
                  <p class="v2-pillar__lead">{p.lead}</p>
                  <p>{p.body}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ PROGRAMS ============ -->
      <section class="v2-section v2-section--soft" id="san-pham">
        <div class="v2-container">
          <header class="v2-heading">
            <p class="v2-eyebrow">Sản phẩm giáo dục</p>
            <h2>Khám phá các chương trình của Trường Việt Anh</h2>
          </header>

          <div class="v2-prog-grid">
            {productLinks.map((card) => (
              <a class="v2-prog" href={card.href}>
                <span>{card.label}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            ))}
          </div>

          <header class="v2-heading v2-heading--secondary">
            <p class="v2-eyebrow">Hệ thống cơ sở</p>
            <h2>Các trường trong hệ thống Việt Anh</h2>
          </header>

          <div class="v2-campus-grid">
            {campusLinks.map((card) => (
              <a class="v2-campus" href={card.href}>
                <span class="v2-campus__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span class="v2-campus__label">{card.label}</span>
                <span class="v2-campus__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ BROCHURE CTA (dark, primary form) ============ -->
