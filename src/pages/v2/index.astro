  }
  .v2-btn--link:hover{ color: var(--c-accent); }

  .v2-hero__badges{
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
  }
  .v2-hero__badges li{
    position: relative;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 500;
    font-size: 0.95rem;
    padding-left: 1.1rem;
  }
  .v2-hero__badges li::before{
    content: "";
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 6px; height: 6px;
    background: var(--c-accent);
