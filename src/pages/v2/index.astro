<style is:global>
  /* =========================================================
     V2 REDESIGN — scoped under .v2 wrapper
     Design tokens:
       Primary: #26275D (deep navy)
       Accent:  #f9dd0e (signature yellow)
       Ink:     #0f172a
       Muted:   #5c6e80
       Soft bg: #f6f8fb
     ========================================================= */

  .v2{
    --c-primary: #26275D;
    --c-primary-deep: #18193a;
    --c-accent: #f9dd0e;
    --c-accent-soft: #fff89a;
    --c-ink: #0f172a;
    --c-muted: #5c6e80;
    --c-muted-soft: #64748b;
    --c-soft-bg: #f6f8fb;
    --c-line: rgba(15, 23, 42, 0.08);
    --c-line-strong: rgba(38, 39, 93, 0.12);
    --radius-sm: 10px;
    --radius: 14px;
    --radius-lg: 22px;
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04), 0 2px 8px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 6px 24px rgba(15, 23, 42, 0.08);
    --shadow-lg: 0 20px 50px rgba(38, 39, 93, 0.12);
    --maxw: 1180px;
    font-family: "Inter", system-ui, sans-serif;
    color: var(--c-ink);
    background: #fff;
  }

  .v2-main{ background: #fff; }

  .v2-container{
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .v2-section{ padding: 4.5rem 0; }
  .v2-section--soft{ background: var(--c-soft-bg); }
  .v2-section--intro{ padding-top: 3rem; padding-bottom: 3rem; }

  .v2-heading{
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }
  .v2-heading--secondary{ margin-top: 3rem; }
  .v2-heading h2{
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 800;
    color: var(--c-primary);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .v2-eyebrow{
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--c-primary);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 0.7rem;
    padding: 0.35rem 0.85rem;
    background: rgba(38, 39, 93, 0.06);
    border-radius: 999px;
  }
  .v2-eyebrow--yellow{
    color: var(--c-accent);
    background: rgba(249, 221, 14, 0.12);
  }

  /* =========================================================
     HERO
     ========================================================= */
  .v2-hero{
