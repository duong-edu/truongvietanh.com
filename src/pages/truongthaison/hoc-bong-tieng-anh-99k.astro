  /* ====== VIDEO STANDALONE ====== */
  .ts-video-section { background: var(--ts-bg); padding: 40px 0; }
  @media (min-width: 768px) { .ts-video-section { padding: 56px 0; } }
  .ts-video-section .ts-container { max-width: 760px; }
  .ts-video-wrap {
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 12px 40px rgba(38, 39, 93, .15);
  }
  .ts-video-placeholder {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .5rem; color: rgba(255,255,255,.85);
    background: linear-gradient(135deg, rgba(38,39,93,.85), rgba(29,30,72,.85)),
      url('/giao-vien-ban-ngu.jpg') center / cover no-repeat;
  }
  .ts-video-play {
    width: 76px; height: 76px;
    background: var(--ts-cta);
    color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 30px; padding-left: 6px;
    box-shadow: 0 6px 24px rgba(230, 57, 70, .45);
    transition: transform .2s ease;
  }
  .ts-video-wrap:hover .ts-video-play { transform: scale(1.08); }
  .ts-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: contain; display: block;
    background: #000;
  }
  .ts-video-text { font-size: 14px; opacity: .85; }
  .ts-video-caption { color: var(--ts-sub); font-size: 16px; margin: 1rem 0 0; text-align: center; }

  /* ====== SOCIAL PROOF ====== */
  .ts-proof { background: var(--ts-white); padding: 40px 0; }
  .ts-proof__eyebrow {
    text-align: center; color: var(--ts-sub);
    font-size: 16px; margin: 0 0 1.5rem; line-height: 1.5;
    font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
  }
  .ts-proof__counters {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;
  }
  @media (min-width: 768px) { .ts-proof__counters { grid-template-columns: repeat(4, 1fr); } }
  .ts-proof__counters > div { text-align: center; }
  .ts-proof__counters strong {
    display: block; font-family: 'Montserrat', sans-serif;
    font-size: 40px; font-weight: 800; color: var(--ts-navy); line-height: 1;
  }
  @media (min-width: 768px) { .ts-proof__counters strong { font-size: 48px; } }
  .ts-proof__counters span {
    display: block; font-size: 16px; color: var(--ts-sub);
    margin-top: .35rem; font-weight: 600;
  }

  /* ====== STORY ====== */
  .ts-story { background: var(--ts-bg); padding: 60px 0; }
  @media (min-width: 768px) { .ts-story { padding: 80px 0; } }
  .ts-story__grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start;
  }
  @media (min-width: 1024px) { .ts-story__grid { grid-template-columns: 320px 1fr; gap: 3rem; } }
  .ts-story__photo-img {
    width: 100%; height: auto;
    object-fit: contain;
    border-radius: 12px;
    border: 3px solid var(--ts-yellow-mute);
    display: block;
    background: #f7f9fc;
    box-shadow: 0 8px 24px rgba(38, 39, 93, .15);
  }
  .ts-story__sig {
    font-size: 16px; color: var(--ts-sub); margin-top: 1rem;
    line-height: 1.6;
  }
  .ts-story__sig em { color: var(--ts-navy); font-weight: 700; font-style: normal; font-size: 18px; }
  .ts-story__body h2 {
    font-size: 28px; margin: 0 0 .5rem;
  }
  @media (min-width: 768px) { .ts-story__body h2 { font-size: 36px; } }
  .ts-story__sub { color: var(--ts-sub); font-size: 18px; margin-bottom: 1.5rem; }
  .ts-story__body p { font-size: 16px; line-height: 1.75; }
  @media (min-width: 768px) { .ts-story__body p { font-size: 18px; } }

  /* ====== REASONS ====== */
  .ts-reasons { background: var(--ts-white); padding: 56px 0; }
  @media (min-width: 768px) { .ts-reasons { padding: 80px 0; } }
  .ts-reasons__grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    margin: 2rem 0 2.5rem;
  }
  @media (min-width: 1024px) {
    .ts-reasons__grid--3 { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .ts-card {
    background: #fff; border: 1px solid var(--ts-border);
    padding: 1.75rem 1.5rem; border-radius: 14px;
    transition: box-shadow .2s ease, transform .2s ease, border-color .2s ease;
    display: flex; flex-direction: column;
  }
  .ts-card:hover {
    box-shadow: 0 12px 32px rgba(38, 39, 93, .1);
    transform: translateY(-3px);
    border-color: var(--ts-navy);
  }
  .ts-card__icon { font-size: 38px; margin-bottom: .75rem; line-height: 1; }
  .ts-card h3 { font-size: 22px; margin: 0 0 .5rem; color: var(--ts-navy); font-weight: 700; line-height: 1.3; }
  @media (min-width: 768px) { .ts-card h3 { font-size: 24px; } }
  .ts-card p { font-size: 16px; line-height: 1.7; color: var(--ts-text); margin: 0; }

  /* ====== PROGRAM ====== */
  .ts-program { background: var(--ts-bg); padding: 60px 0; }
  @media (min-width: 768px) { .ts-program { padding: 80px 0; } }
  .ts-program__list {
    display: grid; gap: 1rem; margin: 2rem 0;
  }
  .ts-lesson {
    background: #fff; border-left: 4px solid var(--ts-navy);
    padding: 1.5rem; border-radius: 0 8px 8px 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
  }
  .ts-lesson__day {
    display: inline-block; background: var(--ts-navy); color: #fff;
    font-size: 14px; font-weight: 700; padding: .25rem .75rem;
    border-radius: 50px; margin-bottom: .5rem; text-transform: uppercase; letter-spacing: .05em;
  }
  .ts-lesson__title { font-size: 18px; margin: 0 0 .75rem; line-height: 1.3; }
  @media (min-width: 768px) { .ts-lesson__title { font-size: 20px; } }
  .ts-flag { margin-right: .5rem; }
  .ts-lesson ul { padding-left: 1.25rem; margin: 0; font-size: 16px; line-height: 1.65; color: var(--ts-text); }
  .ts-lesson li { margin-bottom: .25rem; }

  .ts-program__info {
    background: var(--ts-yellow-softer);
    border: 1px solid var(--ts-yellow-mute);
    border-radius: 14px;
    padding: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) { .ts-program__info { padding: 2rem; } }
  .ts-info-row {
    display: flex; align-items: flex-start; gap: 1rem;
    padding: .85rem 0;
    border-bottom: 1px solid rgba(38,39,93,.08);
  }
  .ts-info-row:last-child { border-bottom: none; }
  .ts-info-row > span { font-size: 22px; flex-shrink: 0; line-height: 1.3; }
  .ts-info-row > div { font-size: 16px; line-height: 1.65; }
  .ts-info-row strong { color: var(--ts-red); font-weight: 700; }
  .ts-info-sub { padding-left: 1.25rem; margin: .5rem 0; }
  .ts-info-sub li { font-size: 16px; line-height: 1.65; }

  /* ====== PRICING 3-TIER ====== */
  .ts-pricing { background: var(--ts-white); padding: 56px 0; }
  @media (min-width: 768px) { .ts-pricing { padding: 80px 0; } }
  .ts-pricing__grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    margin: 1.5rem 0 1rem;
  }
  @media (min-width: 768px) {
    .ts-pricing__grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  }
  .ts-price-card {
    background: #fff;
    border: 1px solid var(--ts-border);
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    text-align: center;
    display: flex; flex-direction: column;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .ts-price-card--regular { opacity: .85; }
  .ts-price-card--standard { border-color: var(--ts-navy); }
  .ts-price-card--featured {
    background: linear-gradient(180deg, #FFFCEB 0%, #FFF7CC 100%);
    border: 2px solid var(--ts-cta);
    box-shadow: 0 12px 32px rgba(230, 57, 70, .18);
    position: relative;
    transform: scale(1.02);
  }
  @media (min-width: 768px) {
    .ts-price-card--featured { transform: scale(1.04); }
  }
  .ts-price-card:hover { transform: translateY(-2px); }
  .ts-price-card--featured:hover { transform: translateY(-4px) scale(1.04); }
  .ts-price-card__badge {
    display: inline-block; align-self: center;
    background: var(--ts-cta); color: #fff;
    font-size: 13px; font-weight: 700;
    padding: .35rem .85rem; border-radius: 999px;
    text-transform: uppercase; letter-spacing: .04em;
    margin-bottom: 1rem;
  }
  .ts-price-card__label {
    font-size: 14px; color: var(--ts-sub);
    text-transform: uppercase; letter-spacing: .06em;
    margin: 0 0 .65rem;
    font-weight: 600;
  }
  .ts-price-card--featured .ts-price-card__label { color: var(--ts-red); }
  .ts-price-card__amount {
    font-family: 'Montserrat', sans-serif;
    font-size: 32px; font-weight: 700;
    color: var(--ts-navy); line-height: 1;
    margin: 0 0 .85rem;
  }
  @media (min-width: 768px) { .ts-price-card__amount { font-size: 36px; } }
  .ts-price-card__amount--featured { color: var(--ts-red); font-size: 38px; }
  @media (min-width: 768px) { .ts-price-card__amount--featured { font-size: 44px; } }
  .ts-price-card__amount s { color: var(--ts-sub); }
  .ts-price-card__unit {
    display: block; font-size: 14px; font-weight: 500;
    color: var(--ts-sub); margin-top: .25rem; letter-spacing: 0;
  }
  .ts-price-card__note {
    font-size: 14px; color: var(--ts-sub); line-height: 1.6;
    margin: 0 0 1rem;
  }
  .ts-price-card .ts-cta-btn { margin-top: auto; }
  .ts-pricing__note { font-size: 13px; color: var(--ts-sub); text-align: center; margin: 1rem 0 0; }

  /* ====== GUARANTEE ====== */
  .ts-guarantee { background: var(--ts-yellow-softer); padding: 56px 0; }
  @media (min-width: 768px) { .ts-guarantee { padding: 72px 0; } }
  .ts-guarantee__grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;
    max-width: 980px; margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .ts-guarantee__grid { grid-template-columns: 280px 1fr; gap: 3rem; }
  }
  .ts-guarantee__portrait { text-align: center; }
  .ts-guarantee__portrait img {
    width: 100%; max-width: 260px; aspect-ratio: 1/1;
    object-fit: cover; object-position: center 18%;
    border-radius: 50%;
    border: 5px solid #fff;
    box-shadow: 0 12px 32px rgba(38, 39, 93, .15);
    display: block; margin: 0 auto;
  }
  .ts-guarantee__portrait-fallback {
    display: none; /* hidden until image fails */
    width: 220px; height: 220px;
    margin: 0 auto;
    background: linear-gradient(135deg, var(--ts-navy), #2a2a8a);
    color: rgba(255,255,255,.92);
    border-radius: 50%; align-items: center; justify-content: center;
    text-align: center; padding: 1rem; font-size: 16px;
    border: 5px solid #fff;
    box-shadow: 0 12px 32px rgba(38, 39, 93, .15);
  }
  .ts-guarantee__sig {
    font-size: 15px; color: var(--ts-sub); line-height: 1.6;
    margin: 1rem 0 0;
  }
  .ts-guarantee__sig em { color: var(--ts-navy); font-weight: 700; font-style: normal; font-size: 17px; }
  .ts-guarantee__shield { font-size: 48px; line-height: 1; margin: 0 0 .5rem; }
  .ts-guarantee__body h2 {
    font-size: 26px; color: var(--ts-red); margin: 0 0 1.25rem;
    font-weight: 700;
  }
  @media (min-width: 768px) { .ts-guarantee__body h2 { font-size: 32px; } }
  .ts-guarantee__body p { font-size: 17px; line-height: 1.7; margin: 0 0 .85rem; color: var(--ts-text); }
  .ts-guarantee__body p em {
    font-style: normal;
    background: #fff;
    color: var(--ts-red);
    padding: 0 .25em;
    border-radius: 4px;
    font-weight: 700;
  }
  .ts-guarantee__lead {
    font-size: 20px !important;
    color: var(--ts-red) !important;
    font-weight: 700;
    margin-top: 1rem !important;
  }

  /* ====== FAQ ====== */
  .ts-faq { background: var(--ts-white); padding: 56px 0; }
  @media (min-width: 768px) { .ts-faq { padding: 72px 0; } }
  .ts-faq__list {
    max-width: 820px; margin: 1.5rem auto 0;
    display: flex; flex-direction: column; gap: .75rem;
  }
  .ts-faq__item {
    background: #fff;
    border: 1px solid var(--ts-border);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color .2s, box-shadow .2s;
  }
  .ts-faq__item[open] { border-color: var(--ts-navy); box-shadow: 0 4px 16px rgba(38, 39, 93, .08); }
  .ts-faq__item summary {
    list-style: none; cursor: pointer;
    padding: 1rem 1.25rem;
    font-weight: 600; font-size: 17px; color: var(--ts-navy);
    display: flex; justify-content: space-between; align-items: center;
    user-select: none;
    line-height: 1.4;
  }
  .ts-faq__item summary::-webkit-details-marker { display: none; }
  .ts-faq__item summary::after {
    content: '+'; font-size: 22px; flex-shrink: 0;
    color: var(--ts-cta); margin-left: 1rem; transition: transform .2s;
    font-weight: 400;
  }
  .ts-faq__item[open] summary::after { content: '−'; }
  .ts-faq__item p {
    padding: 0 1.25rem 1.25rem; margin: 0;
    font-size: 16px; line-height: 1.7; color: var(--ts-text);
  }

  /* ====== SCARCITY ====== */
  .ts-scarcity {
    background: linear-gradient(135deg, var(--ts-navy-dk) 0%, var(--ts-navy) 100%);
    color: #fff; padding: 56px 0;
  }
  .ts-scarcity__eyebrow {
    color: var(--ts-yellow-mute);
    font-size: 16px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .1em;
    margin: 0 0 1.5rem;
  }
  @media (min-width: 768px) { .ts-scarcity__eyebrow { font-size: 18px; } }
  .ts-scarcity__counters {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: .85rem;
    max-width: 720px; margin: 0 auto 1.5rem;
  }
  @media (min-width: 768px) { .ts-scarcity__counters { gap: 1rem; } }
  .ts-scarcity__counters > div {
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16);
    border-radius: 12px; padding: 1.25rem .5rem;
  }
  .ts-scarcity__counters strong {
    display: block; font-family: 'Montserrat', sans-serif;
    font-size: 32px; font-weight: 700; color: var(--ts-yellow-mute); line-height: 1;
  }
  @media (min-width: 768px) { .ts-scarcity__counters strong { font-size: 52px; } }
  .ts-scarcity__counters span {
    display: block; margin-top: .35rem;
    font-size: 12px; color: rgba(255,255,255,.85);
    text-transform: uppercase; letter-spacing: .04em;
    line-height: 1.4;
  }
  @media (min-width: 768px) { .ts-scarcity__counters span { font-size: 14px; } }
  .ts-scarcity__sub {
    max-width: 680px; margin: 0 auto 1.75rem;
    font-size: 16px; color: rgba(255,255,255,.88); line-height: 1.6;
  }
  .ts-scarcity__sub strong { color: var(--ts-yellow-mute); }

  /* ====== FORM SECTION ====== */
  .ts-form-section { background: var(--ts-white); padding: 60px 0; scroll-margin-top: 60px; }
  @media (min-width: 768px) { .ts-form-section { padding: 80px 0; } }
  .ts-form-section__grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 1024px) { .ts-form-section__grid { grid-template-columns: 60% 40%; gap: 3rem; align-items: start; } }
  .ts-form__sub-eyebrow { text-align: center; color: var(--ts-sub); font-size: 16px; margin: 0 0 1.5rem; }

  .ts-form-card {
    background: #fff;
    border: 2px solid var(--ts-border);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,.06);
  }
  @media (min-width: 768px) { .ts-form-card { padding: 2rem; } }
  .ts-progress { margin-bottom: 1.5rem; }
  .ts-progress__bar { height: 8px; background: var(--ts-border); border-radius: 4px; overflow: hidden; margin-bottom: .5rem; }
  .ts-progress__fill {
    height: 100%; width: 50%;
    background: linear-gradient(90deg, var(--ts-navy), var(--ts-blue));
    transition: width .3s ease;
  }
  .ts-progress[data-step="2"] .ts-progress__fill { width: 100%; }
  .ts-progress__label { font-size: 14px; color: var(--ts-sub); text-align: center; margin: 0; }
  .ts-progress[data-step="2"] .ts-step-now { color: var(--ts-sub); }
  .ts-progress[data-step="2"] .ts-step-next { color: var(--ts-navy); font-weight: 700; }
  .ts-progress[data-step="1"] .ts-step-now { color: var(--ts-navy); font-weight: 700; }

  .ts-form-h3 { font-size: 24px; margin: 0 0 .5rem; }
  .ts-form-help { font-size: 16px; color: var(--ts-sub); margin: 0 0 1rem; line-height: 1.6; }
  .ts-label { display: block; font-size: 16px; font-weight: 600; margin: 1rem 0 .35rem; color: var(--ts-text); }
  .ts-req { color: var(--ts-red); }
  .ts-page input[type="email"],
  .ts-page input[type="tel"],
  .ts-page input[type="text"] {
    display: block; width: 100%;
    padding: 14px 16px;
    border: 2px solid var(--ts-border);
    border-radius: 8px;
    font-size: 18px;
    font-family: inherit;
    color: var(--ts-text); background: #fff;
    transition: border-color .15s ease;
  }
  .ts-page input:focus {
    outline: none; border-color: var(--ts-navy);
    box-shadow: 0 0 0 3px rgba(38,39,93,.15);
  }
  .ts-page input.ts-input-error { border-color: var(--ts-red); }

  .ts-checkbox {
    display: flex; align-items: flex-start; gap: .5rem;
    margin: 1rem 0 1.25rem; font-size: 16px; color: var(--ts-text);
    line-height: 1.5; cursor: pointer;
  }
  .ts-checkbox input { margin-top: .25rem; transform: scale(1.2); }

  .ts-form__trust { font-size: 14px; color: var(--ts-sub); text-align: center; margin: 1rem 0 0; line-height: 1.5; }
  .ts-step { animation: tsFadeIn .3s ease; }
  @keyframes tsFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .ts-urgency-banner {
    background: #FFE5E5; color: var(--ts-red);
    padding: 1rem; border-radius: 8px;
    text-align: center; font-size: 16px; font-weight: 600;
    margin-bottom: 1.25rem; line-height: 1.5;
  }

  /* Success block */
  .ts-success {
    background: var(--ts-yellow-softer);
    border: 2px solid var(--ts-cta);
    border-radius: 14px;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  @media (min-width: 768px) { .ts-success { padding: 2.5rem 2rem; } }
  .ts-success__icon { font-size: 56px; line-height: 1; margin-bottom: 1rem; }
  .ts-success__title { font-size: 22px; color: var(--ts-red); margin: 0 0 1rem; line-height: 1.3; font-weight: 700; }
  @media (min-width: 768px) { .ts-success__title { font-size: 26px; } }
  .ts-success__body { font-size: 16px; line-height: 1.75; color: var(--ts-text); margin: 0 0 1.5rem; }
  .ts-success__ctas { display: flex; flex-direction: column; gap: .75rem; }
  .ts-success__counter {
    margin-top: 1.25rem; font-size: 15px; color: var(--ts-red); font-weight: 600;
    animation: tsBlink 1.6s infinite;
  }
  @keyframes tsBlink { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }

  /* Benefits */
  .ts-benefits__box {
    background: var(--ts-yellow-softer);
    border: 1px solid var(--ts-yellow-mute);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(255, 224, 102, .15);
  }
  @media (min-width: 768px) { .ts-benefits__box { padding: 2rem; } }
  .ts-benefits__box h3 {
    font-size: 18px; color: var(--ts-red);
    margin: 0 0 1rem; font-weight: 700;
    line-height: 1.35;
  }
  .ts-benefits__box ul { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: .85rem; }
  .ts-benefits__box li {
    font-size: 15px; line-height: 1.6;
    padding-left: 1.65rem; position: relative;
    color: var(--ts-text);
  }
  .ts-benefits__box li::before {
    content: '✓'; position: absolute; left: 0; top: 0;
    color: var(--ts-cta); font-weight: 700;
  }
  .ts-benefits__box li strong { color: var(--ts-navy); font-weight: 600; }
  .ts-benefits__total {
    background: #fff; border-radius: 10px;
    padding: 1rem; text-align: center; margin-bottom: 1rem;
    border: 1px solid var(--ts-border);
  }
  .ts-benefits__total p { margin: 0; font-size: 14px; color: var(--ts-sub); font-weight: 500; }
  .ts-benefits__total p s { color: var(--ts-sub); }
  .ts-benefits__price { font-size: 16px !important; color: var(--ts-text) !important; margin-top: .35rem !important; }
  .ts-benefits__price strong { color: var(--ts-cta); font-size: 24px; font-weight: 700; }
  .ts-benefits__trust { text-align: center; font-size: 13px; color: var(--ts-sub); margin: 0; line-height: 1.6; }

  /* ====== TESTIMONIAL ====== */
  .ts-testimonial { background: var(--ts-bg); padding: 60px 0; }
  .ts-testimonial__placeholder {
    max-width: 540px; margin: 1.5rem auto 0;
    font-size: 16px; color: var(--ts-sub); line-height: 1.7;
    background: #fff; padding: 2rem;
    border: 2px dashed var(--ts-border);
    border-radius: 12px;
  }

  /* ====== CONTACT ====== */
  .ts-contact { background: var(--ts-white); padding: 56px 0; }
  @media (min-width: 768px) { .ts-contact { padding: 72px 0; } }
  .ts-contact__cards {
    display: grid; grid-template-columns: 1fr; gap: 1rem;
    margin: 1rem 0 2rem;
  }
  @media (min-width: 768px) { .ts-contact__cards { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .ts-contact-card {
    background: #fff;
    border: 1px solid var(--ts-border);
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    text-decoration: none;
    text-align: center;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    display: flex; flex-direction: column; align-items: center;
    color: var(--ts-text);
  }
  .ts-contact-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(38, 39, 93, .12);
    border-color: var(--ts-navy);
  }
  .ts-contact-card__icon { font-size: 32px; line-height: 1; margin-bottom: .5rem; }
  .ts-contact-card__label { font-size: 13px; color: var(--ts-sub); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .35rem; }
  .ts-contact-card__value { font-size: 18px; color: var(--ts-navy); font-weight: 700; margin-bottom: .35rem; }
  .ts-contact-card__sub { font-size: 13px; color: var(--ts-sub); }
  .ts-contact__address {
    text-align: center; max-width: 720px; margin: 0 auto;
    padding: 1.5rem; background: var(--ts-bg); border-radius: 12px;
  }
  .ts-contact__address p { font-size: 16px; color: var(--ts-text); line-height: 1.65; margin: 0 0 1rem; }
  .ts-contact__address p span { color: var(--ts-cta); }

  /* ====== STICKY MOBILE CTA ====== */
  .ts-sticky {
    position: fixed; bottom: 0; left: 0; right: 0;
    z-index: 9999;
    background: linear-gradient(135deg, var(--ts-cta-hl) 0%, var(--ts-cta) 100%);
    padding: 10px 12px;
    box-shadow: 0 -4px 16px rgba(0,0,0,.18);
    display: flex; align-items: center; gap: .5rem;
  }
  @media (min-width: 1024px) { .ts-sticky { display: none !important; } }
  .ts-sticky__close {
    background: rgba(255,255,255,.2); border: none; cursor: pointer;
    font-size: 20px; line-height: 1; color: #fff;
    padding: 4px 10px; border-radius: 6px;
    flex-shrink: 0;
  }
  .ts-sticky__inner {
    flex: 1; display: flex; align-items: center; gap: .5rem;
    justify-content: space-between;
  }
  .ts-sticky__count { font-size: 13px; color: #fff; font-weight: 600; }
  .ts-sticky__count strong { color: var(--ts-yellow-mute); font-size: 16px; font-weight: 700; }
  .ts-sticky__cta {
    background: #fff; color: var(--ts-cta);
    font-weight: 700; font-size: 14px;
    padding: 10px 14px; border-radius: 8px;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* ====== FOOTER ====== */
  .ts-footer {
    background: linear-gradient(180deg, var(--ts-navy-dk) 0%, var(--ts-navy) 100%);
    color: #fff; padding: 56px 0 1rem;
  }
  .ts-footer p, .ts-footer li { color: #fff; }
  .ts-footer a { color: var(--ts-yellow-mute); text-decoration: none; }
  .ts-footer a:hover { color: #fff; text-decoration: underline; }
  .ts-footer__grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 640px) { .ts-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ts-footer__grid { grid-template-columns: repeat(4, 1fr); } }
  .ts-footer__heading {
    color: var(--ts-yellow-mute); font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    font-size: 14px; margin: 0 0 .75rem;
  }
  .ts-footer__brand { color: #fff; font-size: 17px; margin: 0 0 .5rem; font-weight: 700; }
  .ts-footer p { font-size: 15px; line-height: 1.65; margin: 0 0 .5rem; }
  .ts-footer ul { list-style: none; padding: 0; margin: 0; }
  .ts-footer li { font-size: 15px; margin-bottom: .35rem; line-height: 1.5; }
  .ts-footer__bottom {
    border-top: 1px solid rgba(255,255,255,.15);
    margin-top: 2.5rem; padding: 1rem 0 0;
    text-align: center; font-size: 13px; color: rgba(255,255,255,.85);
  }
  .ts-footer__bottom p { margin: 0; color: rgba(255,255,255,.85); font-size: 13px; }

  /* ====== ANIMATIONS — fade in on scroll ====== */
  .ts-anim-init { opacity: 0; transform: translateY(20px); transition: opacity .35s ease, transform .35s ease; }
  .ts-anim-show { opacity: 1; transform: translateY(0); }
</style>

<script src="/js/va-utm.js" is:inline></script>
<script is:inline>
(function () {
  const HOTLINE = '0902095956';
  const ZALO_OA = 'https://zalo.me/1678310120468101523';
  const FB_PAGE = 'https://m.me/truongvietanhhcm';
  const LEAD_API_URL = '/api/lead';
  const SEATS_API_URL = '/api/seats-remaining';

  // ====== Scarcity counter — fetch from API, fallback static ======
  async function loadSeats() {
    try {
      const res = await fetch(SEATS_API_URL);
      if (!res.ok) throw new Error('seat api failed');
      const data = await res.json();
      const seats = data.seats || data.remaining || 23;
      document.querySelectorAll('[data-seats]').forEach(el => { el.textContent = seats; });
      const reg = (data.registered || (100 - seats));
      document.querySelectorAll('[data-registered]').forEach(el => { el.textContent = reg; });
    } catch {
      // fallback already in DOM
    }
  }
  // 01/11/2026: gỡ bộ đếm suất (API /api/seats-remaining không tồn tại, số là số tĩnh) — bảng quyết định A1.

  // ====== Scroll fade-in ======
  const animEls = document.querySelectorAll('.ts-page section, .ts-card, .ts-lesson');
  animEls.forEach(el => el.classList.add('ts-anim-init'));
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('ts-anim-show');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });
  animEls.forEach(el => io.observe(el));

  // ====== Sticky mobile CTA: show after scroll past hero ======
  const sticky = document.getElementById('tsSticky');
  const stickyClose = document.getElementById('tsStickyClose');
  let stickyDismissed = sessionStorage.getItem('ts_sticky_closed') === '1';
  function checkSticky() {
    if (stickyDismissed) return;
    const past = window.scrollY > window.innerHeight * 0.9;
    sticky.hidden = !past;
  }
  window.addEventListener('scroll', checkSticky, { passive: true });
  checkSticky();
  stickyClose && stickyClose.addEventListener('click', () => {
    sticky.hidden = true; stickyDismissed = true;
    sessionStorage.setItem('ts_sticky_closed', '1');
  });

  // ====== CTA click tracking ======
  document.querySelectorAll('.ts-cta-track').forEach(btn => {
    btn.addEventListener('click', () => {
      const loc = btn.dataset.cta || 'unknown';
      if (typeof window.fbq === 'function') {
        window.fbq('trackCustom', 'CTAClick', { cta_location: loc });
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'cta_click', { cta_location: loc });
      }
    });
  });

  // ====== Scroll halfway tracking ======
  let scrollHalfFired = false;
  window.addEventListener('scroll', () => {
    if (scrollHalfFired) return;
    const pct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
    if (pct >= 0.5) {
      scrollHalfFired = true;
      if (typeof window.fbq === 'function') window.fbq('trackCustom', 'ScrollHalf');
      if (typeof window.gtag === 'function') window.gtag('event', 'scroll_50_percent');
    }
  }, { passive: true });

  // ====== FORM 2-step ======
  const form = document.getElementById('tsForm');
  if (!form) return;
  const progress = form.parentElement.querySelector('.ts-progress');
  const step1 = form.querySelector('[data-step-pane="1"]');
  const step2 = form.querySelector('[data-step-pane="2"]');
  const success = form.querySelector('[data-step-pane="success"]');
  const emailInput = form.querySelector('#tsEmail');
  const nameInput = form.querySelector('#tsName');
  const phoneInput = form.querySelector('#tsPhone');

  const params = new URLSearchParams(window.location.search);
  const utm = (window.__vaUTM ? window.__vaUTM() : {});

  let leadData = { ...utm };

  function showStep(n) {
    step1.hidden = n !== 1;
    step2.hidden = n !== 2;
    success.hidden = n !== 'success';
    if (progress) progress.dataset.step = n === 'success' ? 2 : n;
    if (n === 2 && nameInput) setTimeout(() => nameInput.focus(), 100);
  }

  function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); }
  function validPhone(v) { return /^(0|\+84)[3-9][0-9]{8}$/.test(v.replace(/[\s.\-]/g, '')); }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPane = step1.hidden ? (step2.hidden ? 'success' : 2) : 1;

    if (currentPane === 1) {
      const email = emailInput.value.trim();
      if (!validEmail(email)) {
        emailInput.classList.add('ts-input-error');
        emailInput.focus();
        return;
      }
      emailInput.classList.remove('ts-input-error');
      leadData.email = email;
      if (typeof window.fbq === 'function') {
        window.fbq('trackCustom', 'StepOneCompleted', { value: 99000, currency: 'VND' });
      }
      submitLead({ ...leadData, partial: true, funnel_code: 'ts_99k' }).catch(() => {});
      showStep(2);
      return;
    }

    if (currentPane === 2) {
      const name = nameInput.value.trim();
      const phone = phoneInput.value.trim().replace(/[\s.\-]/g, '');
      let bad = false;
      if (!name || name.length < 2) { nameInput.classList.add('ts-input-error'); bad = true; } else nameInput.classList.remove('ts-input-error');
      if (!validPhone(phone)) { phoneInput.classList.add('ts-input-error'); bad = true; } else phoneInput.classList.remove('ts-input-error');
      if (bad) return;

      leadData.fullName = name;
      leadData.phone = phone;
      leadData.source = 'ts-hoc-bong-99k';
      leadData.funnel_code = 'ts_99k';
      leadData.school_level = 'tieu-hoc';
      leadData.tags = ['ts-hoc-bong-99k', 'Need_immediate_chat', 'lead_nong'];

      const submitBtn = step2.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'ĐANG XỬ LÝ...';

      try { await submitLead(leadData); }
      catch (err) { console.warn('Lead submit error', err); }

      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', { value: 99000, currency: 'VND', content_name: '100_cong_dan_toan_cau_99k' });
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', { currency: 'VND', value: 99000 });
      }
      if (typeof window.ttq !== 'undefined' && window.ttq.track) {
        window.ttq.track('SubmitForm');
      }

      window.location.href = '/cam-on?name=' + encodeURIComponent(name);
    }
  });

  async function submitLead(payload) {
    return fetch(LEAD_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }
})();
</script>
