---
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = "Tuyển Sinh THCS 2026–2027 | Trường Việt Anh";
const pageDescription = "Đăng ký sớm nhận học bổng Early Bird đến 30% học phí. Hỗ trợ trọn gói thủ tục và test đầu vào miễn phí.";
const pageCanonical = "https://truongvietanh.com/tuyen-sinh-thcs";

const uspItems = [
    {
      "icon": "🎓",
      "text": "Chương trình THCS song ngữ — chuẩn quốc tế, sĩ số 22 em/lớp"
    },
    {
      "icon": "🇬🇧",
      "text": "Giáo viên bản ngữ + Việt cùng dạy — Tiếng Anh từ 8–12 tiết/tuần"
    },
    {
      "icon": "📋",
      "text": "Test đầu vào miễn phí — đánh giá toàn diện học lực"
    },
    {
      "icon": "💸",
      "text": "Early Bird trước 30/4 — giảm 30% học phí + tặng đồng phục"
    },
    {
      "icon": "🚌",
      "text": "Xe đưa đón đa tuyến TP.HCM, Tây Ninh, An Giang"
    },
    {
      "icon": "📞",
      "text": "Nhắn Zalo OA bất cứ lúc nào — Hiệu trưởng phản hồi trong 12h"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '8', label: 'Cơ sở tại TP.HCM, Tây Ninh, An Giang' },
];

const faqItems = [
    {
      "question": "Hồ sơ nhập học cần gì?",
      "answer": "Học bạ 2 năm gần nhất, giấy khai sinh, sổ tiêm chủng (Mầm Non/Tiểu Học), 4 ảnh 3x4, đơn nhập học. Trường hướng dẫn từng bước."
    },
    {
      "question": "Có test đầu vào không?",
      "answer": "Có test Toán + Tiếng Việt + Tiếng Anh 90 phút, làm tại trường hoặc online. Kết quả dùng để xếp lớp và xét học bổng."
    },
    {
      "question": "Lớp sĩ số bao nhiêu?",
      "answer": "THCS sĩ số tối đa 22 em/lớp, có 1 giáo viên chính + 1 trợ giảng + 1 giáo viên bản ngữ. Đảm bảo từng con được quan tâm."
    },
    {
      "question": "Có học phí trả góp không?",
      "answer": "Có. Trả góp 0% lãi suất qua thẻ TPBank, MB, VPBank, chia 6/9/12 kỳ. Không cần chứng minh thu nhập."
    },
    {
      "question": "Khi nào bắt đầu nhập học?",
      "answer": "Năm học 2026–2027 khai giảng 5/9/2026. Có lớp tiền nhập học (orientation) tháng 7 cho HS mới làm quen môi trường, miễn phí cho HS đăng ký Early Bird."
    }
  ];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="thcs"
  funnelCode="tuyen-sinh-thcs"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Tuyển Sinh THCS 2026–2027</h1>
    <p class="squeeze-hero__subheading">Đăng ký sớm nhận học bổng Early Bird đến 30% học phí. Hỗ trợ trọn gói thủ tục và test đầu vào miễn phí.</p>
  </section>

  <section slot="usp"><USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} /></section>

  <section slot="content">
    <div class="page-content">
      <h2>Tuyển sinh THCS — Lộ trình rõ ràng cho con</h2>
      <p>Trường Việt Anh tuyển sinh năm học 2026–2027 với <strong>chương trình THCS song ngữ chuẩn quốc tế</strong>, đầu ra đảm bảo và lộ trình rõ ràng.</p>
        <p>Cơ sở: <strong>Hệ thống Trường Việt Anh — TP.HCM, Tây Ninh, An Giang</strong>. Sĩ số mỗi lớp tối đa 22 em với 3 giáo viên/lớp (1 chính + 1 trợ giảng + 1 bản ngữ). Đăng ký sớm trước 30/4/2026 để nhận học bổng Early Bird 30% học phí.</p>
        <p>Để nhận thông tin chi tiết về học phí, lộ trình học và lịch tham quan trường, vui lòng để lại thông tin. Đội tuyển sinh sẽ liên hệ trong 24h.</p>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký tuyển sinh THCS</h2>
    <p class="squeeze-form-section__description">Đội tuyển sinh phản hồi trong 24h, hướng dẫn hồ sơ và lịch tham quan.</p>
    <LeadFormTwoStepEmailFirst
      formId="tuyen-sinh-thcs-form"
      funnelCode="tuyen-sinh-thcs"
      schoolLevel="thcs"
      submitText="Đăng ký tuyển sinh"
      successMessage="Cảm ơn! Đội tuyển sinh sẽ liên hệ trong 24h."
    />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>
  .page-content { max-width: 800px; margin: 0 auto; padding: 1rem 0; }
  .page-content h2 { color: #26275D; font-size: 1.6rem; margin-bottom: 1rem; text-align: center; }
  .page-content p { font-size: 1rem; line-height: 1.75; color: #333; margin-bottom: 1rem; }
  .page-content ul { margin: 1rem 0 1rem 1.5rem; }
  .page-content li { margin-bottom: .5rem; line-height: 1.7; }
  .page-content strong { color: #26275D; font-weight: 700; }
</style>
