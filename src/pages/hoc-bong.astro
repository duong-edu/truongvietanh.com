---
// Trang trụ VĨNH VIỄN — Học bổng & ưu đãi học phí Trường Việt Anh 2026–2027.
// Nguồn nội dung: Google Doc "hocbongtruongvietanhlandingpage.md" của anh Dương
// (fileId 1-eGidkbBrh4U9y_TGhWXgLndulS6n8p_H0to9YurxdU, cập nhật 31/8/2026).
//
// TRANG NÀY CÓ FORM LEAD (thêm 01/09/2026) — dùng component LeadFormTwoStepEmailFirst,
// funnel_code riêng "pillar-hoc-bong-2026". Component TỰ nạp /js/va-utm.js và tự gắn UTM
// vào cả lệnh partial-capture lẫn submit chính, nên quy tắc UTM của CLAUDE.md đã thoả.
// LƯU Ý khi tự kiểm: grep "va-utm.js" trong FILE NÀY sẽ ra 0 vì script nằm trong component
// — phải kiểm trên HTML đã dựng, không kiểm trên mã nguồn trang.
//
// Quy tắc viết (giống /chinh-sach-ai):
//   - Mỗi H2 có anchor id tiếng Việt không dấu.
//   - Bảng là <table> thật, bọc .gi-table-responsive để cuộn ngang trên mobile.
//   - FAQ dùng component FaqAccordion (gập lại). Quy ước cũ "không dùng <details>"
//     đã bỏ ngày 01/09/2026 — xem CLAUDE.md mục "FAQ" để biết lý do và ràng buộc.
//
// MỌI CON SỐ TIỀN ĐỀU TÍNH TỪ HẰNG SỐ `HOC_PHI_VI_DU` BÊN DƯỚI — đổi 1 số là cả
// 4 bảng Early Bird tự tính lại. Đừng hard-code lại tiền trong phần thân trang.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { schoolFacts } from '../data/school-facts';

const canonical = 'https://truongvietanh.com/hoc-bong';

// Zalo OA Trường Việt Anh — cùng ID mà BaseLayout/FooterBase đang dùng.
const ZALO_OA = 'https://zalo.me/1678310120468101523';
const HOTLINE = '0916 961 409';

// Ảnh CHỤP THẬT của trường (không phải ảnh AI). Nguồn: album Lễ Tổng kết 2025–2026
// và Ngày hội Lãnh đạo Lion Camp 2026 trên photos.truongvietanh.com, đã đẩy lên R2.
const IMG_CHAMPIONS = 'https://media.truongvietanh.com/images/hoc-bong/champions-le-tong-ket.webp';
const IMG_LEADERS = 'https://media.truongvietanh.com/images/hoc-bong/leaders-ngay-hoi-lanh-dao.webp';
// Infographic bản đồ 5 học bổng — ĐỒ HOẠ tạo bằng AI, có nhân vật học sinh dạng ảnh chụp,
// nên figcaption phải gắn nhãn AI theo Điều 11.4 Luật TTNT 134/2025/QH15.
const IMG_BAN_DO = 'https://media.truongvietanh.com/images/hoc-bong/ban-do-5-hoc-bong.webp';

// ── SỐ HỌC ─────────────────────────────────────────────────────────────────
// Mốc học phí dùng cho toàn bộ ví dụ trên trang = học phí lớp 10 niêm yết ở /hoc-phi.
// 01/11/2026: đổi từ 124.900.000đ (Doc gốc) sang 137.257.000đ theo bảng quyết định B11
// (anh Dương duyệt: một nguồn số liệu). Đổi 1 dòng này là mọi bảng tự tính lại.
const HOC_PHI_VI_DU = 137_257_000;
const TRAN_TANG = 0.10;                              // trần tăng học phí mỗi năm
const GIAM_TRON_NAM = 0.06;
const GIAM_TRON_KY = 0.02;
const EB_GIAM = [0.06, 0.16, 0.26, 0.36, 0.46];      // mức giảm Early Bird năm 1→5

const vnd = (n: number) => Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

// Bảng 1 — đóng trọn năm / trọn học kỳ
const traTronNam = Math.round(HOC_PHI_VI_DU * (1 - GIAM_TRON_NAM));
const traTronKy = Math.round(HOC_PHI_VI_DU * (1 - GIAM_TRON_KY));

// Bảng 2 — Early Bird 5 năm so với đóng từng năm (đã trừ 6%)
const ebRows = EB_GIAM.map((giam, i) => {
  const niemYet = Math.round(HOC_PHI_VI_DU * Math.pow(1 + TRAN_TANG, i));
  const tungNam = Math.round(niemYet * (1 - GIAM_TRON_NAM));
  const earlyBird = Math.round(HOC_PHI_VI_DU * (1 - giam));
  return { nam: i + 1, niemYet, tungNam, earlyBird, chenh: tungNam - earlyBird };
});
const tongNiemYet = ebRows.reduce((s, r) => s + r.niemYet, 0);
const tongTungNam = ebRows.reduce((s, r) => s + r.tungNam, 0);
const tongEarlyBird = ebRows.reduce((s, r) => s + r.earlyBird, 0);
const tongChenh = tongTungNam - tongEarlyBird;
const tyLeTungNam = Math.round((tongTungNam / tongNiemYet) * 100);
const tyLeEarlyBird = Math.round((tongEarlyBird / tongNiemYet) * 100);

// Bảng 3 — so với gửi tiết kiệm.
// Tiền năm 1 KHÔNG bị khoá (phương án nào cũng phải đóng ngay trong năm nay),
// nên chỉ tính lãi mất trên phần tiền của năm 2→5, mỗi phần khoá (n−1) năm.
const laiMat = (r: number) =>
  Math.round(ebRows.slice(1).reduce((s, row, i) => s + row.earlyBird * (Math.pow(1 + r, i + 1) - 1), 0));
const bankRows = [0.045, 0.05, 0.055, 0.06].map((r) => {
  const mat = laiMat(r);
  return { r, mat, loiRong: tongChenh - mat };
});

// Bảng 4 — rút giữa chừng: phần đã học giữ nguyên mức ưu đãi Early Bird của năm đó
const refundRows = [1, 2, 3, 4].map((n) => {
  const giuLai = ebRows.slice(0, n).reduce((s, r) => s + r.earlyBird, 0);
  return { nam: n, giuLai, hoanLai: tongEarlyBird - giuLai };
});

// CTA cuối — gia đình 2 con cùng học, đóng trọn năm, chưa tính học bổng của các con
const tietKiemHaiCon =
  Math.round(HOC_PHI_VI_DU * GIAM_TRON_NAM) +
  Math.round(HOC_PHI_VI_DU * 0.5) +
  Math.round(HOC_PHI_VI_DU * 0.5 * GIAM_TRON_NAM);

// ── 9 CHÍNH SÁCH ───────────────────────────────────────────────────────────
const chinhSach = [
  { stt: 1, ten: 'Đóng phí theo năm', ai: 'Mọi học sinh', muc: '<strong>6%</strong> học phí', quyet: 'Cha mẹ', loai: 'uu-dai' },
  { stt: 2, ten: 'Đóng phí theo học kỳ', ai: 'Mọi học sinh', muc: '<strong>2%</strong> học phí', quyet: 'Cha mẹ', loai: 'uu-dai' },
  { stt: 3, ten: 'Anh chị em ruột', ai: 'Gia đình có từ 2 con học trong hệ thống', muc: 'Con thứ hai <strong>50%</strong> · con thứ ba <strong>25%</strong>', quyet: 'Cha mẹ', loai: 'uu-dai' },
  { stt: 4, ten: 'Early Bird (đóng trước nhiều năm)', ai: 'Gia đình xác định gắn bó dài hạn', muc: '<strong>6% → 16% → 26% → 36% → 46%</strong> theo từng năm, kèm <strong>khoá giá học phí năm đầu</strong>', quyet: 'Cha mẹ', loai: 'uu-dai' },
  { stt: 5, ten: 'GRIT', ai: 'Mọi học sinh đang học', muc: 'Mỗi ngày rèn giũa tối thiểu 1 giờ = <strong>10.000đ</strong>. Giữ đủ 6/7 ngày thì tuần đó tính tròn <strong>100.000đ</strong>, cộng dồn theo chuỗi tuần', quyet: 'Con', loai: 'hoc-bong' },
  { stt: 6, ten: 'CHAMPIONS', ai: 'Học sinh đạt giải thi đấu', muc: '4 mức theo độ khó kỳ thi, từ <strong>2 – 20 triệu</strong>', quyet: 'Con', loai: 'hoc-bong' },
  { stt: 7, ten: 'LEADERS', ai: 'Học sinh cho đi &amp; dẫn dắt', muc: '2 bảng, <strong>10 suất × 10 triệu</strong> mỗi bảng', quyet: 'Con', loai: 'hoc-bong' },
  { stt: 8, ten: 'TALENTS', ai: 'Học sinh ngoài trường, từ lớp 6, khu vực Đà Nẵng → Cà Mau', muc: '4 hạng, <strong>25 – 100 triệu</strong>, mỗi tỉnh đúng 1 suất', quyet: 'Con', loai: 'hoc-bong' },
  { stt: 9, ten: 'LOVE', ai: 'Gia đình gặp biến cố', muc: 'Miễn <strong>50 – 100%</strong> học phí', quyet: 'Không ai xin — trường tự kích hoạt', loai: 'love' },
];

// ── FAQ ────────────────────────────────────────────────────────────────────
// Dùng chung cho phần hiển thị và schema FAQPage — không chép tay hai lần.
const faqs = [
  {
    id: 'faq-hoc-sinh-moi',
    q: 'Con tôi chưa học Việt Anh, tôi được ưu đãi gì ngay?',
    a: 'Ba ưu đãi học phí — đóng theo năm (6%), đóng theo học kỳ (2%), anh chị em ruột (50% cho con thứ hai) — áp dụng ngay khi ghi danh vào Trường Việt Anh, không cần chờ. Riêng TALENTS là học bổng tuyển sinh dành cho học sinh ngoài trường từ lớp 6, khu vực Đà Nẵng đến Cà Mau. Bốn học bổng còn lại con bắt đầu giành được từ khi vào học.',
  },
  {
    id: 'faq-hoc-sinh-cu-co-thiet',
    q: 'Con tôi đang học Việt Anh có bị thiệt so với học sinh mới không?',
    a: 'Không. Luật nền của Trường Việt Anh là: học bổng cho học sinh ngoài luôn mở cửa cho học sinh trong, chỉ tách chỉ tiêu. Bốn trong năm học bổng — GRIT, CHAMPIONS, LEADERS, LOVE — dành cho học sinh đang học.',
  },
  {
    id: 'faq-cong-don',
    q: 'Các ưu đãi có cộng dồn với nhau không?',
    a: 'Có, toàn bộ. Ưu đãi đóng phí theo thời gian (theo năm, theo học kỳ, Early Bird) cộng dồn với tất cả. Bốn học bổng con giành được — GRIT, CHAMPIONS, LEADERS, TALENTS — cộng dồn với nhau, con giành được bao nhiêu thì nhận bấy nhiêu, không có mức trần. Ưu đãi anh chị em ruột cộng dồn với nhóm học bổng: con thứ hai vừa được giảm 50% vì có anh chị, vừa nhận đủ phần học bổng nó tự giành được — không phải chọn một trong hai. Quỹ LOVE nằm ngoài mọi luật cộng dồn.',
  },
  {
    id: 'faq-ba-con-cung-hoc',
    q: 'Gia đình tôi có 3 con, cả 3 cùng học. Tính thế nào?',
    a: 'Con thứ nhất đóng học phí niêm yết, con thứ hai được giảm 50%, con thứ ba được giảm 25%. Học bổng các con tự giành được sẽ được cộng thêm trên mức ưu đãi 50%/25%, qua đó thành tích và nỗ lực của từng con vẫn được ghi nhận đầy đủ.',
  },
  {
    id: 'faq-tinh-tren-gi',
    q: 'Các khoản ưu đãi tính trên những gì?',
    a: 'Chỉ tính trên học phí. Phí dịch vụ, tiền ăn, xe đưa đón, nội trú, đồng phục và các khoản thu hộ — chi hộ không nằm trong phạm vi ưu đãi, và thu theo giá của từng năm học. Điều này đúng với cả chín chính sách của Trường Việt Anh, không có ngoại lệ.',
  },
  {
    id: 'faq-grit-tien-mat',
    q: 'Học bổng GRIT có nhận bằng tiền mặt không?',
    a: 'Không. GRIT được trừ vào học phí năm học kế tiếp. Riêng học sinh lớp 12 — vì không còn năm sau — nhận bằng tiền mặt tại Lễ Tri ân và Trưởng thành. Học sinh chuyển trường giữa chừng không quy đổi quỹ tích luỹ thành tiền.',
  },
  {
    id: 'faq-grit-dut-chuoi',
    q: 'Nếu con tôi ốm và đứt chuỗi GRIT thì sao?',
    a: 'Luật GRIT cho phép hụt 1 ngày trong tuần — tuần đạt tính là 6 trên 7 ngày. Nếu nghỉ dài dẫn đến đứt chuỗi, con phải xây lại đủ 4 tuần liên tục mới mở lại cổng, và các tuần trong lúc xây lại không được tính. Tuy nhiên toàn bộ phần đã nhận trước đó không bị thu hồi.',
  },
  {
    id: 'faq-talents-boc-tham',
    q: 'Học bổng TALENTS bốc thăm thì có công bằng không?',
    a: 'Phần chọn người hoàn toàn dựa trên năng lực: hồ sơ, thư đề cử từ trường cũ và phỏng vấn cả gia đình. Chỉ có mức học bổng là do bốc thăm. Cả 16 em đều chắc chắn nhận học bổng của Trường Việt Anh — không em nào ra về tay trắng.',
  },
  {
    id: 'faq-early-bird-chuyen-truong',
    q: 'Đóng Early Bird 5 năm rồi con chuyển trường thì sao?',
    a: 'Anh chị được lấy lại toàn bộ phần tiền chưa dùng, chỉ cần báo trước 30 ngày. Không cần lý do, không mất phí phạt. Phần thời gian con đã học vẫn giữ nguyên mức ưu đãi Early Bird của những năm đó — Trường Việt Anh không tính lùi về giá gốc và không truy thu phần đã giảm.',
  },
  {
    id: 'faq-early-bird-du-5-nam',
    q: 'Early Bird có bắt buộc đóng đủ 5 năm không?',
    a: 'Không. 5 năm là mức tối đa. Anh chị chọn số năm phù hợp với gia đình mình — càng nhiều năm thì mức giảm của những năm sau càng sâu.',
  },
  {
    id: 'faq-quy-love-thu-tuc',
    q: 'Gia đình tôi gặp biến cố, phải làm thủ tục gì để xin quỹ LOVE?',
    a: 'Anh chị không cần làm hồ sơ xin. Chỉ cần báo với giáo viên chủ nhiệm của con. Trường Việt Anh kích hoạt hỗ trợ trong vòng 7 ngày, không chờ cửa sổ xét quý. Trường cam kết không truyền thông bất kỳ trường hợp nào.',
  },
  {
    id: 'faq-khong-phu-hop',
    q: 'Nếu tôi thấy trường không phù hợp sau khi con đã học?',
    a: 'Học 4 tuần đầu, nếu không hài lòng, Trường Việt Anh hoàn 100% học phí, không hỏi lý do. Quy định học phí đóng rồi không hoàn lại chỉ áp dụng sau 4 tuần đó.',
  },
];

const description =
  'Toàn bộ ưu đãi học phí và 5 học bổng của Trường Việt Anh 2026–2027: đóng phí theo năm 6%, anh chị em ruột 50%, Early Bird khoá giá 5 năm, GRIT, CHAMPIONS, LEADERS, TALENTS, LOVE. Đủ số, đủ điều kiện, đủ hạn chót.';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    '@id': 'https://truongvietanh.com/#organization',
    name: 'Trường Việt Anh',
    url: 'https://truongvietanh.com',
    foundingDate: String(schoolFacts.foundedYear),
    numberOfEmployees: undefined,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Admissions',
      telephone: '+84916961409',
      areaServed: 'VN',
      availableLanguage: ['vi'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    name: 'Học bổng & ưu đãi học phí Trường Việt Anh 2026–2027',
    description,
    url: canonical,
    inLanguage: 'vi',
    primaryImageOfPage: { '@type': 'ImageObject', url: IMG_BAN_DO, width: 1600, height: 900 },
    image: [IMG_BAN_DO, IMG_CHAMPIONS, IMG_LEADERS],
    isPartOf: { '@id': 'https://truongvietanh.com/#organization' },
    mainEntity: { '@id': `${canonical}#faq` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Tuyển sinh', item: 'https://truongvietanh.com/tuyen-sinh' },
      { '@type': 'ListItem', position: 3, name: 'Học bổng & ưu đãi học phí', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Học Bổng & Ưu Đãi Học Phí Trường Việt Anh 2026–2027 | 9 Chính Sách"
  description={description}
  keywords="học bổng trường Việt Anh, ưu đãi học phí trường tư, giảm học phí anh chị em ruột, học bổng trường tư TPHCM, Early Bird học phí, học bổng GRIT, học bổng TALENTS"
  canonical={canonical}
  ogImage={IMG_BAN_DO}
  ogType="article"
  structuredData={structuredData}
>
  <div class="gi-page hb-page">
    <HeaderBase currentPath="/hoc-bong" />

    <!-- ══════════ HERO ══════════ -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left" style="flex:1">
          <div class="hb-hero-topline">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true"></span>
            <a href="/tuyen-sinh">Tuyển sinh</a>
            <span aria-hidden="true"></span>
            <span>Học bổng &amp; ưu đãi học phí</span>
          </nav>
          <h1 class="gi-h1">Ở Việt Anh có hai loại ưu đãi khác nhau. Bạn nên biết cả hai.</h1>
          <p class="hb-hero-sub">
            Loại thứ nhất là <strong>ưu đãi học phí</strong> — bạn quyết định, ký là có ngay.
            Loại thứ hai là <strong>học bổng</strong> — con phải tự giành, không ai tặng.
          </p>
          </div>

          <div class="hb-hero-rest">
          <p class="hb-hero-body">
            Trang này nói thẳng cả hai: giảm bao nhiêu, điều kiện gì, hạn chót ngày nào.
            Không có dòng nào ghi &ldquo;liên hệ để biết thêm&rdquo;.
          </p>
          <p class="hb-hero-note">
            Toàn bộ ưu đãi và học bổng trong trang này tính trên <strong>học phí</strong>.
            Không áp dụng cho phí dịch vụ và các khoản thu hộ — chi hộ.
          </p>

          <div class="hb-hero-actions">
            <a href={ZALO_OA} target="_blank" rel="noopener" class="hb-cta" data-cta-position="hero">
              Nhắn Zalo hỏi mức của con tôi
            </a>
            <p class="hb-cta-hint">
              Bấm <strong>Quan tâm</strong> trang Zalo OA để nhắn được — mất 3 giây.
            </p>
          </div>

