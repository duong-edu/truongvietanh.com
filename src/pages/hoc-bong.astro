  <script is:inline>
    /* Chèn dòng "vuốt ngang để xem tiếp" NGAY DƯỚI những bảng thật sự rộng hơn khung.
       Làm bằng JS vì CSS không biết bảng nào tràn; bóng mờ hai mép thì đã có sẵn bằng
       CSS nên kể cả JS chặn vẫn còn tín hiệu. Chạy lại khi xoay máy / đổi cỡ. */
    (function () {
      var main = document.querySelector('.gi-main');
      if (!main) return;
      var khungs = [].slice.call(main.querySelectorAll('.gi-table-responsive'));

      function danhDau(khung) {
        /* .gi-section dùng content-visibility:auto — section chưa vào màn hình thì báo
           kích thước 0, đo lúc tải trang sẽ bỏ sót toàn bộ bảng dưới fold. Vì vậy chỉ đo
           khi bảng thật sự được dựng (IntersectionObserver gọi tới). */
        if (!khung.clientWidth) return;
        var tran = khung.scrollWidth > khung.clientWidth + 4;
        var nhac = khung.nextElementSibling;
        if (!nhac || !nhac.classList.contains('hb-cuon-ngang')) {
          if (!tran) return;
          nhac = document.createElement('p');
          nhac.className = 'hb-cuon-ngang';
          nhac.textContent = '↔ Vuốt ngang trên bảng để xem hết các cột';
          khung.parentNode.insertBefore(nhac, khung.nextSibling);
        }
        nhac.classList.toggle('hien', tran);
      }

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (muc) {
          muc.forEach(function (m) { if (m.isIntersecting) danhDau(m.target); });
        }, { rootMargin: '300px 0px' });
        khungs.forEach(function (k) { io.observe(k); });
      } else {
        khungs.forEach(danhDau);
      }

      var hen;
      addEventListener('resize', function () {
        clearTimeout(hen);
        hen = setTimeout(function () { khungs.forEach(danhDau); }, 200);
      });
    })();
  </script>
