---
/**
 * Trại Hè Squeeze Page — CMS-driven template (Conversion-Optimized v2)
 *
 * One dynamic route backs all 8 summer-camp squeeze landing pages.
 * Content comes from Directus (`trai_he_squeeze_pages` collection) with a
 * build-time fallback to directus/seed/trai-he-squeeze-pages.json.
 *
 * Conversion features:
 * - Hero CTA button scrolling to form
 * - Evergreen countdown timer for urgency
 * - Enhanced testimonial with star rating & avatar
 * - Highlighted Early Bird card (golden)
 * - Floating Zalo button
 * - Exit-intent popup
 * - Scroll reveal animations
 * - Mobile-optimized sticky CTA
 * - Quiz-funnel form UX
 */
import SqueezePageLayout from '../layouts/SqueezePageLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import QuizFunnel from '../components/QuizFunnel.astro';
import FAQSection from '../components/FAQSection.astro';
import { getAllTraiHeSlugs, getTraiHePageBySlug } from '../lib/trai-he-pages';

export async function getStaticPaths() {
  const slugs = await getAllTraiHeSlugs();
  return slugs
    .filter((s) => s && s.startsWith('trai-he-'))
    .map((slug) => ({ params: { trai_he_slug: slug } }));
}

const { trai_he_slug } = Astro.params;
const page = await getTraiHePageBySlug(trai_he_slug!);

if (!page) {
  return Astro.redirect('/404');
}

const canonicalUrl = `https://truongvietanh.com/${page.slug}`;
const camOnUrl = `/${page.slug}/cam-on`;
const formIdWithFunnel = `squeeze-form-${page.funnel_code}`;
const zaloUrl = 'https://zalo.me/1678310120468101523';

// Label mapping for school level
const levelLabels: Record<string, string> = {
  'tieu-hoc': 'Tiểu Học',
  'thcs': 'THCS',
  'thpt': 'THPT',
};
const levelLabel = levelLabels[page.school_level] || 'Tiểu Học';

/** Ensures "Lion Camp" is always preceded by "Trại hè" in CMS-sourced text. */
function addTraiHe(text: string | undefined | null): string {
  if (!text) return text ?? '';
  return text.replace(/trại\s*hè\s*lion\s*camp|lion\s*camp/gi, (match) =>
    /^trại/i.test(match) ? match : 'Trại hè ' + match
  );
}
---

<SqueezePageLayout
  title={page.page_title}
  description={page.page_description}
  canonicalUrl={canonicalUrl}
  schoolLevel={page.school_level}
  funnelCode={page.funnel_code}
>
  <!-- ===== HERO — compact, CTA above fold ===== -->
  <section slot="hero">
    {page.hero_badge && (
      <span class="squeeze-hero__badge">
        {/^trại\s*hè/i.test(page.hero_badge) ? addTraiHe(page.hero_badge) : `Trại hè ${page.hero_badge}`}
      </span>
    )}
    <!-- Dynamic headline for warm traffic — overridden by JS from UTM -->
    <h1 class="squeeze-hero__heading" id="heroHeadline">{addTraiHe(page.hero_headline)}</h1>
    <p class="squeeze-hero__sub" id="heroSub">{addTraiHe(page.hero_subheading)}</p>

    <!-- CTA group — must be above fold -->
    <div class="hero-cta-group">
      <a href="#form-section" class="hero-cta hero-cta--primary">
        🎯 Đánh giá miễn phí 3 phút
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
      <a href={zaloUrl} target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta--zalo">
        💬 Chat Zalo
      </a>
    </div>
    <div class="hero-countdown" id="heroCountdown">
      <span class="hero-countdown__pulse"></span>
      <span>Học bổng kết thúc trong </span>
      <span class="hero-countdown__time" id="heroTimer">--:--:--</span>
    </div>
  </section>

  <!-- ===== USP GRID with scroll animation ===== -->
  <section slot="usp"><USPGrid
    title={addTraiHe(page.usp_title)}
    items={page.usp_items}
  /></section>

  <!-- ===== TRUST METRICS ===== -->
  <section slot="trust"><TrustMetrics title={page.metrics_title} metrics={page.metrics} /></section>

  <!-- ===== CONTENT: Full conversion-optimized sections ===== -->
  <section slot="content">
    <div class="camp-content">

      <!-- ① BEFORE/AFTER TRANSFORMATION -->
      <div class="camp-transform reveal-on-scroll">
        <h2 class="camp-section-title">Con bạn sẽ thay đổi như thế nào sau 6 tuần?</h2>
        <div class="camp-transform__grid">
          <div class="camp-transform__col camp-transform__col--before">
            <div class="camp-transform__label">❌ Trước Trại Hè Lion Camp</div>
            <ul>
              <li>Nghiện điện thoại, lười vận động</li>
              <li>Ngại giao tiếp, thiếu tự tin</li>
              <li>Không nói được tiếng Anh</li>
              <li>Ỷ lại ba mẹ, thiếu kỷ luật</li>
              <li>Mùa hè lãng phí, không phát triển</li>
            </ul>
          </div>
          <div class="camp-transform__arrow">→</div>
          <div class="camp-transform__col camp-transform__col--after">
            <div class="camp-transform__label">✅ Sau 6 tuần Trại Hè Lion Camp</div>
            <ul>
              <li>Chủ động tham gia, năng động</li>
              <li>Tự tin giao tiếp, dạn dĩ trước đám đông</li>
              <li>Nói tiếng Anh tự nhiên với giáo viên bản ngữ</li>
              <li>Tự lập, kỷ luật, biết quản lý thời gian</li>
              <li>Phát triển toàn diện kỹ năng lãnh đạo</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ② COMPARISON TABLE: Trại Hè Lion Camp vs Ở nhà -->
      <div class="camp-compare reveal-on-scroll">
        <h2 class="camp-section-title">Trại Hè Lion Camp vs. Ở nhà mùa hè — Ba/Mẹ chọn gì cho con?</h2>
        <div class="camp-compare__table">
          <div class="camp-compare__header">
            <div class="camp-compare__col-label"></div>
            <div class="camp-compare__col-label camp-compare__col-label--bad">😔 Ở nhà</div>
            <div class="camp-compare__col-label camp-compare__col-label--good">🦁 Trại Hè Lion Camp</div>
          </div>
          <div class="camp-compare__row">
            <div class="camp-compare__criteria">Tiếng Anh</div>
            <div class="camp-compare__cell camp-compare__cell--bad">Quên dần sau 3 tháng nghỉ</div>
            <div class="camp-compare__cell camp-compare__cell--good">Tiến bộ rõ rệt với giáo viên bản ngữ hàng ngày</div>
          </div>
          <div class="camp-compare__row">
            <div class="camp-compare__criteria">Thời gian màn hình</div>
            <div class="camp-compare__cell camp-compare__cell--bad">3-5 giờ/ngày điện thoại/game</div>
            <div class="camp-compare__cell camp-compare__cell--good">Hoạt động thể chất + sáng tạo cả ngày</div>
          </div>
          <div class="camp-compare__row">
            <div class="camp-compare__criteria">Kỹ năng xã hội</div>
            <div class="camp-compare__cell camp-compare__cell--bad">Ngại giao tiếp, thu mình</div>
            <div class="camp-compare__cell camp-compare__cell--good">Tự tin, dẫn dắt, làm việc nhóm</div>
          </div>
          <div class="camp-compare__row">
            <div class="camp-compare__criteria">Kỷ luật bản thân</div>
            <div class="camp-compare__cell camp-compare__cell--bad">Thức khuya, ngủ nướng, lười biếng</div>
            <div class="camp-compare__cell camp-compare__cell--good">Nề nếp, tự giác, quản lý thời gian</div>
          </div>
          <div class="camp-compare__row">
            <div class="camp-compare__criteria">Trải nghiệm</div>
            <div class="camp-compare__cell camp-compare__cell--bad">Buồn chán, lặp lại mỗi ngày</div>
            <div class="camp-compare__cell camp-compare__cell--good">Du lịch trải nghiệm mỗi tuần + dự án thực tế</div>
          </div>
        </div>
      </div>

      <!-- ③ MID-PAGE CTA RIBBON -->
      <div class="camp-mid-cta reveal-on-scroll">
        <div class="camp-mid-cta__inner">
          <div class="camp-mid-cta__text">
            <strong>Ba/Mẹ muốn biết con phù hợp với lộ trình nào?</strong>
            <span>Chỉ 3 phút đánh giá — nhận báo cáo miễn phí</span>
          </div>
          <a href="#form-section" class="camp-mid-cta__btn">🎯 Làm bài đánh giá ngay</a>
        </div>
      </div>

      <!-- ④ TESTIMONIAL -->
      {page.content_title && <h2 class="camp-section-title reveal-on-scroll">{addTraiHe(page.content_title)}</h2>}
      <div class="camp-testimonial reveal-on-scroll">
        <div class="camp-testimonial__header">
          <div class="camp-testimonial__avatar"><span class="camp-testimonial__avatar-icon">👤</span></div>
          <div class="camp-testimonial__meta">
            <div class="camp-testimonial__stars">★★★★★</div>
            <div class="camp-testimonial__author">{page.testimonial_author}</div>
          </div>
        </div>
        <div class="camp-testimonial__quote">"{page.testimonial_text}"</div>
        <div class="camp-testimonial__verified">✓ Phụ huynh đã xác minh</div>
      </div>

      <!-- ⑥ INFO CARDS -->
      <div class="camp-grid">
        {page.info_cards.map((card) => (
          <div class={`camp-card reveal-on-scroll ${card.title.includes('Early Bird') || card.title.includes('Ưu đãi') ? 'camp-card--highlight' : ''}`}>
            <div class="camp-card__icon-wrap"><span class="camp-card__icon">{card.icon}</span></div>
            {(card.title.includes('Early Bird') || card.title.includes('Ưu đãi')) && <span class="camp-card__badge">HOT</span>}
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>

      <!-- ⑦ LOCATION PERSONALIZATION -->
      <div class="camp-location reveal-on-scroll">
        <div class="camp-location__icon">📍</div>
        <div class="camp-location__content">
          <h3>Tại sao chọn cơ sở {page.location}?</h3>
          <ul>
            <li>Cơ sở vật chất hiện đại, an toàn cho con</li>
            <li>Đội ngũ giáo viên bản ngữ thường trực</li>
            <li>Thuận tiện đưa đón cho Ba/Mẹ khu vực {page.location}</li>
            <li>Lớp nhỏ 15-18 học sinh, giáo viên theo sát từng em</li>
          </ul>
        </div>
      </div>

      <!-- ⑧ URGENCY -->
      {page.urgency_text && (
        <div class="camp-urgency reveal-on-scroll">
          <div class="camp-urgency__icon">⚠️</div>
          <div class="camp-urgency__text">
            <p>{addTraiHe(page.urgency_text)}</p>
            <div class="camp-urgency__countdown">Ưu đãi kết thúc trong: <strong id="urgencyTimer">--:--:--</strong></div>
          </div>
        </div>
      )}

      <!-- ⑨ SOCIAL PROOF -->
      <div class="camp-social-proof reveal-on-scroll">
        <div class="camp-social-proof__avatars">
          <span>👩</span><span>👨</span><span>👩</span><span>👨</span><span>👩</span>
        </div>
        <span class="camp-social-proof__text">
          <strong id="recentSignups">12</strong> phụ huynh đã đăng ký hôm nay tại {page.location}
        </span>
      </div>
    </div>
  </section>

  <!-- ===== INTERACTIVE QUIZ FUNNEL ===== -->
  <section slot="form">
    {page.quiz_questions && page.quiz_questions.length > 0 ? (
      <QuizFunnel
        quizTitle={page.quiz_title}
        quizSubtitle={page.quiz_subtitle}
        questions={page.quiz_questions}
        results={page.quiz_results}
        quizIntroItems={page.quiz_intro_items}
        formHeading={page.form_heading}
        formDescription={page.form_description}
        formSubmitText={page.form_submit_text}
        funnelCode={page.funnel_code}
        schoolLevel={page.school_level}
        location={page.location}
        camOnUrl={camOnUrl}
      />
    ) : (
      <Fragment>
        <div class="quiz-intro">
          <h2 class="squeeze-form-section__heading">{page.form_heading}</h2>
          <p class="squeeze-form-section__description">{page.form_description}</p>
        </div>
        <LeadFormTwoStepEmailFirst
          formId="squeeze-form"
          funnelCode={page.funnel_code}
          schoolLevel={page.school_level}
          submitText={page.form_submit_text}
          successMessage={page.form_success_message}
        />
      </Fragment>
    )}
    <!-- Seats remaining progress bar -->
    <div class="seats-bar" id="seatsBar">
      <div class="seats-bar__header">
        <span>🎫 Suất ưu đãi Early Bird còn lại</span>
        <span><strong id="seatsLeft">8</strong>/15 suất</span>
      </div>
      <div class="seats-bar__track" role="progressbar" aria-valuenow="53" aria-valuemin="0" aria-valuemax="100">
        <div class="seats-bar__fill" id="seatsBarFill"></div>
      </div>
      <p class="seats-bar__hint">Lớp chỉ 15 học sinh — giáo viên theo sát từng em · Hết là đóng đăng ký</p>
    </div>

    <!-- Live signup counter -->
    <div class="form-live-counter">
      <span class="form-live-counter__dot"></span>
      <span><strong id="liveCounter">3</strong> phụ huynh đang xem trang này</span>
    </div>
  </section>

  <section slot="faq"><FAQSection title={addTraiHe(page.faq_title)} items={page.faq_items} /></section>
</SqueezePageLayout>

<!-- ===== FLOATING ZALO BUTTON ===== -->
<a href={zaloUrl} target="_blank" rel="noopener noreferrer" class="floating-zalo" id="floatingZalo" aria-label="Chat Zalo">
  <span class="floating-zalo__icon">💬</span>
  <span class="floating-zalo__label">Zalo</span>
  <span class="floating-zalo__badge" id="zaloBadge">1</span>
</a>

<!-- Exit-intent popup removed per request: trai-he pages do not show popup -->

<!-- Social proof toast removed per A1 (bỏ popup giả "vừa đăng ký") -->

<!-- ===== SCRIPTS ===== -->
<script is:inline define:vars={{ formIdSel: `#${formIdWithFunnel}`, camOnUrl }}>
  (function () {
    // === 1. Form → Thank-you redirect ===
    var formEl = document.querySelector(formIdSel);
    if (formEl) {
      var obs = new MutationObserver(function () {
        var success = formEl.querySelector('.form-step[data-step="success"]');
        if (success && !success.hidden) {
          var nameInput = formEl.querySelector('input[name="parent_name"]');
          var n = nameInput ? nameInput.value : '';
          setTimeout(function () {
            window.location.href = camOnUrl + '?name=' + encodeURIComponent(n);
          }, 1800);
          obs.disconnect();
        }
      });
      obs.observe(formEl, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
    }

    // === 2. Evergreen countdown timer (resets per session, 4h window) ===
    var COUNTDOWN_KEY = 'camp_countdown_end';
    var stored = sessionStorage.getItem(COUNTDOWN_KEY);
    var endTime = stored ? parseInt(stored, 10) : 0;
    if (!endTime || endTime < Date.now()) {
      endTime = Date.now() + 4 * 3600 * 1000; // 4 hours
      sessionStorage.setItem(COUNTDOWN_KEY, endTime.toString());
    }
    function updateCountdown() {
      var diff = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
      var h = Math.floor(diff / 3600);
      var m = Math.floor((diff % 3600) / 60);
      var s = diff % 60;
      var str = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
      var els = document.querySelectorAll('#heroTimer, #urgencyTimer, #urgencyLayoutTimer');
      els.forEach(function (el) { el.textContent = str; });
      if (diff <= 0) {
        els.forEach(function (el) { el.textContent = 'Đã kết thúc!'; });
      }
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // === 3. Scroll reveal animations ===
    var revealEls = document.querySelectorAll('.reveal-on-scroll');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });
      revealEls.forEach(function (el) { io.observe(el); });
    } else {
      revealEls.forEach(function (el) { el.classList.add('revealed'); });
    }

    // === 5. Live counter (simulated social proof) ===
    function randomBetween(a, b) { return Math.floor(Math.random() * (b - a + 1)) + a; }
    var liveEl = document.getElementById('liveCounter');
    var signupEl = document.getElementById('recentSignups');
    if (liveEl) liveEl.textContent = randomBetween(2, 7).toString();
    if (signupEl) signupEl.textContent = randomBetween(8, 23).toString();
    setInterval(function () {
      if (liveEl) liveEl.textContent = randomBetween(2, 7).toString();
    }, 15000);

    // === 6. Floating Zalo badge pulse ===
    var badge = document.getElementById('zaloBadge');
    setTimeout(function () {
      if (badge) badge.classList.add('show');
    }, 3000);

    // === 7. Warm traffic dynamic headline (from UTM) ===
    var params = new URLSearchParams(window.location.search);
    var src = params.get('utm_source') || params.get('source') || '';
    var childName = params.get('ten_be') || params.get('child') || '';
    var hlEl = document.getElementById('heroHeadline');
    var subEl = document.getElementById('heroSub');
    if (hlEl && src) {
      if (src === 'quiz' && childName) {
        hlEl.textContent = 'Dựa trên kết quả đánh giá của bé ' + childName + ' — đây là lộ trình Trại Hè Lion Camp phù hợp nhất';
      } else if (src === 'vsl') {
        hlEl.textContent = 'Ba/Mẹ đã xem video — đăng ký tư vấn cá nhân hóa 1:1 ngay';
        if (subEl) subEl.textContent = 'Tư vấn viên sẽ gọi/Zalo trong 24h để trao đổi chi tiết chương trình phù hợp cho con.';
      } else if (src === 'remarketing' || src === 'google') {
        if (subEl) subEl.textContent = 'Ba/Mẹ đã quan tâm Trại Hè Lion Camp — đăng ký ngay để nhận học bổng Early Bird trước khi hết suất.';
      }
    }

    // === 8a. Video facade → embed iframe on click (lazy, saves ~500KB LCP) ===
    var vFacade = document.getElementById('campVideoFacade');
    if (vFacade) {
      function loadVideo() {
        var vid = vFacade.getAttribute('data-video-id') || 'jN4aXkBrjwY';
        var wrapper = vFacade.parentElement;
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = 'Video Trại Hè Lion Camp';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.style.cssText = 'width:100%;aspect-ratio:16/9;border:0;display:block;border-radius:16px;';
        wrapper.innerHTML = '';
        wrapper.appendChild(iframe);
        if (window.dataLayer) window.dataLayer.push({ event: 'video_play', video_id: vid });
      }
      vFacade.addEventListener('click', loadVideo);
      vFacade.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); loadVideo(); }
      });
    }

    // === 8. GTM scroll-to-form tracking ===
    var formSection = document.getElementById('form-section');
    if (formSection && 'IntersectionObserver' in window) {
      var fio = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          if (window.dataLayer) window.dataLayer.push({ event: 'form_section_visible' });
          fio.disconnect();
        }
      }, { threshold: 0.3 });
      fio.observe(formSection);
    }

    // === 9. Seats remaining progress bar ===
    (function () {
      var SEATS_KEY = 'camp_seats_' + window.location.pathname;
      var total = 15;
      // Seats count decreases by 1 every 8 min of real time (simulated scarcity)
      var baseSeats = parseInt(localStorage.getItem(SEATS_KEY) || '0', 10);
      if (!baseSeats) {
        baseSeats = 6 + Math.floor(Math.random() * 4); // 6–9 seats left on first visit
        localStorage.setItem(SEATS_KEY, baseSeats.toString());
      }
      var seatsEl = document.getElementById('seatsLeft');
      var fillEl = document.getElementById('seatsBarFill');
      if (seatsEl) seatsEl.textContent = baseSeats.toString();
      if (fillEl) {
        var pct = Math.round(((total - baseSeats) / total) * 100);
        fillEl.style.width = pct + '%';
      }
    })();

    // Social proof notification removed per A1
  })();
</script>

<style is:inline>/* ===== HERO CTA BUTTONS ===== */
  .hero-cta-group{ display: flex; gap: .75rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap; }.hero-cta{
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .85rem 1.75rem; border-radius: 12px; font-weight: 700;
    font-size: 1rem; text-decoration: none; transition: all .3s ease;
    font-family: Montserrat, sans-serif; border: none; cursor: pointer;
  }.hero-cta--primary{
    background: linear-gradient(135deg, #f9dd0e, #f9dd0e); color: #18193a;
    box-shadow: 0 4px 20px rgba(249, 221, 14,.4);
    animation: heroPulse 2.5s ease-in-out infinite;
  }.hero-cta--primary:hover{ transform: translateY(-2px); box-shadow: 0 6px 28px rgba(249, 221, 14,.55); }.hero-cta--zalo{
    background: #fff; color: #26275D;
    border: 2px solid #26275D;
  }.hero-cta--zalo:hover{ background: #26275D; color: #fff; }.hero-cta__icon{ font-size: 1.2rem; }
  @keyframes heroPulse {0%,100%{ box-shadow: 0 4px 20px rgba(249, 221, 14,.4); }50%{ box-shadow: 0 4px 32px rgba(249, 221, 14,.65), 0 0 48px rgba(249, 221, 14,.2); }
  }/* ===== HERO COUNTDOWN — white hero, navy text ===== */
  .hero-countdown{
    display: inline-flex; align-items: center; gap: .6rem;
    margin-top: 1.5rem; padding: .6rem 1.25rem;
    background: rgba(38,39,93,.06); border: 1px solid rgba(38,39,93,.15);
    border-radius: 50px; font-size: 1rem; color: #26275D;
  }.hero-countdown__pulse{
