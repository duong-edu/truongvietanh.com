    link:'https://drive.google.com/file/d/19sdEkc69pZVuE4OddBGfwSeOsnlUV2GY/view',
    linkChu:'Mở cẩm nang', hien:true },

  { id:'LM27', icon:'✈️', loai:'Lộ trình', ten:'Chuẩn bị du học từ lớp 10',
    loi:'Đợi lớp 12 mới làm hồ sơ là chạy đua trong sáu tháng. Bắt đầu từ lớp 10 thì có trọn ba năm.',
    trong:['Timeline ba năm chia theo từng quý: lúc nào thi IELTS, lúc nào thi SAT, lúc nào viết luận',
           'Checklist hồ sơ riêng cho Mỹ, Úc, Anh, Canada — mỗi nước một yêu cầu khác nhau',
           'Cách chọn ngoại khoá: hai ba việc gắn bó lâu, không phải mười việc mỗi thứ một tháng'],
