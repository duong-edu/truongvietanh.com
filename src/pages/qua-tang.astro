/* ==========================================================================
   3. TIỆN ÍCH
   ========================================================================== */
var U   = new URLSearchParams(location.search);
var $   = function(s){ return document.querySelector(s); };
var el  = function(t,c){ var n = document.createElement(t); if (c) n.className = c; return n; };
var KHO = QUA.filter(function(q){ return q.hien !== false && q.link; });
var CS  = COSO[U.get('cs')] || COSO.vietanh;
var KHOA = 'va_qua_tang_v1';

var nhomChon = null, quaChinh = null, emailDaCo = '';

function trongNhom(ma){ return KHO.filter(function(q){ return q.nhom.indexOf(ma) !== -1; }); }
function tenNhom(ma){
  for (var i=0;i<NHOM.length;i++) if (NHOM[i].ma === ma) return NHOM[i];
  return { ten:'Bé nhà mình', phu:'', level:'' };
}
function docNho(){ try { return JSON.parse(localStorage.getItem(KHOA) || 'null'); } catch(e){ return null; } }
function ghiNho(o){ try { localStorage.setItem(KHOA, JSON.stringify(o)); } catch(e){} }
function noop(){}

/* UTM — cùng cách bắt như các squeeze page khác trên site */
function utm(){
  var k = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter'], o = {};
  try {
    k.forEach(function(x){
      var g = U.get(x);
      if (g){ try { sessionStorage.setItem('va_'+x, g); } catch(e){} }
      var v = g || (function(){ try { return sessionStorage.getItem('va_'+x); } catch(e){ return ''; } })() || '';
      if (v) o[x] = v;
    });
  } catch(e){}
  if (!o.utm_source){ o.utm_source = U.get('nguon') || 'direct'; o.utm_medium = U.get('nguon') ? 'social' : 'none'; }
  if (U.get('nguon')) o.utm_content = U.get('nguon');
  o.page_url = location.href;
  return o;
}
function gtm(ev, extra){
  try {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: ev }, extra || {}));
  } catch(e){}
}

/* ==========================================================================
   4. ÁP CẤU HÌNH CƠ SỞ
   ========================================================================== */
(function apCoSo(){
  $('#foot').innerHTML = CS.chan + '<br>Hotline ' + CS.hotline;
  var tel = $('#tel'); tel.href = 'tel:' + CS.tel; tel.textContent = CS.hotline;
  var z = $('#cta-zalo');
  if (CS.zalo) z.href = CS.zalo; else z.style.display = 'none';
})();

/* ==========================================================================
   5. MÀN 1
   ========================================================================== */
(function veNhom(){
  var box = $('#nhoms');
  NHOM.forEach(function(n){
    if (!trongNhom(n.ma).length) return;          // giai đoạn chưa có quà thì ẩn
    var b = el('button','nhom'); b.type = 'button';
    var ic = el('span','ic'); ic.textContent = n.icon; ic.setAttribute('aria-hidden','true');
    var t = el('span','t');
    var bb = el('b'); bb.textContent = n.ten;
    var sp = el('span'); sp.textContent = n.phu + ' · ' + trongNhom(n.ma).length + ' món quà';
    t.appendChild(bb); t.appendChild(sp);
    var m = el('span','mui'); m.textContent = '→'; m.setAttribute('aria-hidden','true');
    b.appendChild(ic); b.appendChild(t); b.appendChild(m);
    b.addEventListener('click', function(){ chonNhom(n.ma); });
    box.appendChild(b);
  });
})();

function chonNhom(ma){
  nhomChon = ma;
  var n = tenNhom(ma), ds = trongNhom(ma);
  $('#f-tieude').textContent = 'Quà cho bé ' + n.ten.toLowerCase() + ' — ' + n.phu.toLowerCase();
  $('#f-nhan').textContent = quaChinh ? 'Ba mẹ sẽ nhận' : 'Hộp quà giai đoạn này có ' + ds.length + ' món';
  var ul = $('#f-ds'); ul.innerHTML = '';
  (quaChinh ? [quaChinh] : ds).forEach(function(q){
    var li = el('li'); li.textContent = q.ten; ul.appendChild(li);
  });
  hienMan('man2');
  gtm('qua_tang_chon_nhom', { giai_doan: ma });
  setTimeout(function(){ $('#email').focus({ preventScroll:true }); }, 300);
}

function hienMan(id){
  var ms = document.querySelectorAll('.man');
  for (var i=0;i<ms.length;i++) ms[i].classList.toggle('on', ms[i].id === id);
  window.scrollTo({ top:0, behavior:'smooth' });
}

$('#lui').addEventListener('click', function(){ quaChinh = null; hienMan('man1'); });

/* ==========================================================================
   6. BỐC QUÀ
   ========================================================================== */
function bocQua(ma, daCo){
  var ds = trongNhom(ma);
  var moi = ds.filter(function(q){ return daCo.indexOf(q.id) === -1; });  // ưu tiên món chưa nhận
  if (moi.length) ds = moi;
  if (!ds.length) return null;
  var tong = ds.reduce(function(s,q){ return s + (q.uu || 1); }, 0);
  var r = Math.random() * tong;
  for (var i=0;i<ds.length;i++){ r -= (ds[i].uu || 1); if (r <= 0) return ds[i]; }
  return ds[ds.length - 1];
}

/* ==========================================================================
   7. MÀN 3
   ========================================================================== */
function moQua(chinh, ma){
  var box = $('#the'); box.innerHTML = '';
  var nhan = el('span','nhan'); nhan.textContent = chinh.loai;
  var h3 = el('h3'); h3.textContent = chinh.ten;
  var loi = el('p','loi'); loi.textContent = chinh.loi;
  var ul = el('ul');
  chinh.trong.forEach(function(t){ var li = el('li'); li.textContent = t; ul.appendChild(li); });
  var meta = el('p','meta'); meta.textContent = chinh.meta;
  box.appendChild(nhan); box.appendChild(h3); box.appendChild(loi);
  box.appendChild(ul); box.appendChild(meta);
  box.appendChild(nutMo(chinh, 'nut'));
  if (chinh.linkPhu) box.appendChild(nutMo({ link:chinh.linkPhu.url, linkChu:chinh.linkPhu.chu }, 'nut phu'));

  var conLai = trongNhom(ma).filter(function(q){ return q.id !== chinh.id; });
  var ds = $('#ds'); ds.innerHTML = '';
  conLai.forEach(function(q){
    var a = el('a'); a.href = q.link; a.target = '_blank'; a.rel = 'noopener';
    var ic = el('span','ic'); ic.textContent = q.icon; ic.setAttribute('aria-hidden','true');
    var t = el('span','t');
    var b = el('b'); b.textContent = q.ten;
    var s = el('span'); s.textContent = q.meta;
    t.appendChild(b); t.appendChild(s);
    var m = el('span','mui'); m.textContent = '→'; m.setAttribute('aria-hidden','true');
    a.appendChild(ic); a.appendChild(t); a.appendChild(m);
    ds.appendChild(a);
  });
  $('#con-lai').style.display = conLai.length ? 'block' : 'none';
  $('#mo-phu').textContent = conLai.length ? 'Trường gửi ba mẹ món này trước' : 'Trường gửi ba mẹ món này';
  hienMan('man3');
}

function nutMo(q, cls){
  var a = el('a', cls);
  a.href = q.link; a.target = '_blank'; a.rel = 'noopener';
  a.textContent = q.linkChu || 'Mở quà';
  a.addEventListener('click', function(){ gtm('qua_tang_mo_file', { qua_id: q.id || '' }); });
  return a;
}

/* ==========================================================================
   8. LINK TẮT
      ?nhom=tieu-hoc  ?qua=LM17  ?cs=thaison  ?nguon=fb-thaison-1208
   ========================================================================== */
(function batDau(){
  var nho = docNho();
  var idQua = (U.get('qua') || '').trim().toLowerCase();
  if (idQua){
    for (var i=0;i<KHO.length;i++) if (KHO[i].id.toLowerCase() === idQua){ quaChinh = KHO[i]; break; }
  }
  var maNhom = (U.get('nhom') || '').trim() || (quaChinh ? quaChinh.nhom[0] : '');

  // Ba mẹ đã nhận quà trước đó: mở thẳng, không bắt điền lại
  if (nho && nho.phone && nho.nhom){
    var cu = null;
    for (var j=0;j<KHO.length;j++) if (KHO[j].id === nho.qua){ cu = KHO[j]; break; }
    var chinh = quaChinh || cu || bocQua(nho.nhom, []);
    if (chinh){ nhomChon = nho.nhom; moQua(chinh, nho.nhom); return; }
  }

  for (var k=0;k<NHOM.length;k++) if (NHOM[k].ma === maNhom){ chonNhom(maNhom); return; }

  var thieu = QUA.filter(function(x){ return x.hien !== false && !x.link; });
  if (thieu.length) console.warn('[qua-tang] Chưa có link, đang bị loại khỏi kho:',
    thieu.map(function(x){ return x.id; }).join(', '));
})();

/* ==========================================================================
   9. FORM HAI BƯỚC — email trước, rồi tên + số điện thoại
   ========================================================================== */
(function form(){
  var btnTiep = $('#tiep'), btnGo = $('#go');
  var email = $('#email'), ten = $('#ten'), sdt = $('#sdt');

  function okEmail(v){ return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(v).trim()); }
  function chuanHoa(v){ return String(v).replace(/[\s.\-()]/g,'').replace(/^\+?84/,'0'); }
  function okPhone(v){ return /^0(3|5|7|8|9)\d{8}$/.test(chuanHoa(v)); }
  function loi(node, id, co){
    node.classList.toggle('err', co);
    $('#'+id).classList.toggle('on', co);
  }
  function goiApi(body, keepalive){
    try {
      return fetch(C.api, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify(body), keepalive: !!keepalive
      }).catch(noop);
    } catch(e){ return Promise.resolve(); }
  }

  email.addEventListener('input', function(){ if (email.classList.contains('err')) loi(email,'msg-email', !okEmail(email.value)); });
  sdt.addEventListener('input', function(){ if (sdt.classList.contains('err')) loi(sdt,'msg-sdt', !okPhone(sdt.value)); });

  /* --- Bước 1: email. Gửi lead tạm ngay, phòng khi ba mẹ bỏ dở bước 2 --- */
  btnTiep.addEventListener('click', function(){
    if (!okEmail(email.value)){ loi(email,'msg-email', true); email.focus(); return; }
    loi(email,'msg-email', false);
    emailDaCo = email.value.trim();

    /* funnel_code RIÊNG theo giai đoạn — đây là thứ hiện ở cột "Diễn giải nguồn
       MKT" trong Pancake, nên để chung một mã 'qua-tang' là mất luôn thông tin
       con đang ở tuổi nào, tức là mất tín hiệu phân loại quan trọng nhất. */
    goiApi(Object.assign({
      email: emailDaCo,
      form_id: 'qt-' + nhomChon,
      funnel_code: C.funnel + '-' + nhomChon,
      source: C.funnel + '-' + nhomChon,
      school_level: tenNhom(nhomChon).level,
      co_so: U.get('cs') || 'vietanh',
      tags: ['qua-tang', 'giai-doan-' + nhomChon],
      step: 1,
      partial: true
    }, utm()), true);

    gtm('qua_tang_buoc1', { giai_doan: nhomChon });
    $('#b1').classList.remove('on'); $('#b2').classList.add('on');
    $('#c1').classList.remove('on'); $('#c2').classList.add('on');
    $('#n2').classList.add('on'); $('#v').classList.add('on');
    setTimeout(function(){ ten.focus({ preventScroll:true }); }, 80);
  });

  /* --- Bước 2: tên + số điện thoại → bốc quà và mở ngay --- */
  $('#lead').addEventListener('submit', function(e){
    e.preventDefault();

    var xauTen = !ten.value.trim();
    var xauSdt = !okPhone(sdt.value);
    loi(ten,'msg-ten', xauTen);
    loi(sdt,'msg-sdt', xauSdt);
    if (xauTen){ ten.focus(); return; }
    if (xauSdt){ sdt.focus(); return; }
    if ($('#website').value) return;              // bot điền vào ô bẫy

    btnGo.disabled = true;
    btnGo.textContent = 'Đang mở quà…';

    var nho = docNho();
    var daCo = (nho && nho.daCo) || [];
    var chinh = quaChinh || bocQua(nhomChon, daCo);
    if (!chinh){ btnGo.disabled = false; btnGo.textContent = 'Mở quà cho ba mẹ 🎁'; return; }

    /* Món quà đi sang Pancake qua `tags` (worker gộp mảng này vào tag khách hàng)
       và qua `noi_dung` để người trực đọc được ngay. Đừng thêm trường tự đặt tên
       kiểu qua_id/giai_doan — worker không đọc, dữ liệu rơi mất im lặng. */
    goiApi(Object.assign({
      email: emailDaCo,
      parent_name: ten.value.trim(),
      phone: chuanHoa(sdt.value),
      form_id: 'qt-' + nhomChon,
      funnel_code: C.funnel + '-' + nhomChon,
      source: C.funnel + '-' + nhomChon,
      school_level: tenNhom(nhomChon).level,
      co_so: U.get('cs') || 'vietanh',
      tags: ['qua-tang', 'giai-doan-' + nhomChon, 'qua-' + chinh.id.toLowerCase()],
      noi_dung: 'Giai đoạn: ' + tenNhom(nhomChon).ten + ' (' + tenNhom(nhomChon).phu + ')'
              + ' · Quà đã nhận: ' + chinh.ten,
      step: 2
    }, utm()));

    gtm('qua_tang_nhan_qua', { giai_doan: nhomChon, qua_id: chinh.id });

    ghiNho({
      phone: chuanHoa(sdt.value), email: emailDaCo, ten: ten.value.trim(),
      nhom: nhomChon, qua: chinh.id,
      daCo: daCo.concat(daCo.indexOf(chinh.id) === -1 ? [chinh.id] : []),
      luc: new Date().toISOString()
    });

    // Mở quà ngay, không chờ mạng — mất một lead còn hơn để ba mẹ điền xong tay trắng
    moQua(chinh, nhomChon);
  });
})();
</script>
</body>
