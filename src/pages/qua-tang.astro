    link:'https://drive.google.com/file/d/1iOuMqRiarCqCW6HtIrMTvFxHygAv_CXB/view',
    linkChu:'Mở lộ trình', hien:true },

  { id:'LM29', icon:'🎓', loai:'Danh sách', ten:'50 trường đại học xét tuyển bằng IELTS',
    loi:'Có IELTS rồi thì nộp được vào đâu — 50 trường, kèm điểm tối thiểu và cách quy đổi.',
    trong:['Chia ba khu vực: TP.HCM 17 trường, Hà Nội 16, Đà Nẵng và các tỉnh 17',
           'Mỗi trường ghi rõ ngành nào xét, IELTS tối thiểu, cộng mấy điểm hay xét thẳng',
           'Bảng tóm tắt: đạt 5.0 mở được bao nhiêu trường, 6.0 và 6.5 thì bao nhiêu'],
