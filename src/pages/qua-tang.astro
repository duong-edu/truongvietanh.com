---
/* /qua-tang — TRANG QUÀ TẶNG TỔNG HỢP
   Một link duy nhất dán được ở mọi kênh MXH. Luồng 3 màn:
     1. Bé nhà mình đang ở giai đoạn nào?  (6 nút)
     2. Two-step form: email → tên + số điện thoại
     3. Bốc ngẫu nhiên 1 món hợp tuổi, mở ngay + các món còn lại trong nhóm

   Lead đi về /api/lead giống mọi squeeze page khác, cùng bộ tên trường:
     email · parent_name · phone · form_id · funnel_code · school_level · utm_*
   Thêm 3 trường riêng của trang này: qua_id · qua_ten · giai_doan · co_so

   Tham số link cho đội content — xem docs/qua-tang.md:
     ?nhom=  ?qua=  ?cs=  ?nguon=  (+ utm_* như thường lệ)

   ⚠️ THÊM QUÀ MỚI: thêm một khối vào mảng QUA bên dưới. Món không có `link`
   hoặc `hien:false` tự bị loại khỏi kho, không bao giờ bốc trúng.
*/
/* Tiêu đề và mô tả để literal trong thẻ <title>/<meta> bên dưới, không dùng
   biến — scripts/audit-pages.mjs đọc chúng bằng regex để dựng báo cáo trang. */
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Quà tặng cho ba mẹ — Trường Việt Anh</title>
<meta name="description" content="Chọn giai đoạn của con, để lại thông tin, nhận ngay một món quà từ trường: checklist chọn trường, lộ trình tiếng Anh, bộ trò chơi, bảng kiểm mốc phát triển. Miễn phí." />
<link rel="canonical" href="https://truongvietanh.com/qua-tang" />
<meta property="og:type" content="website" />
<meta property="og:title" content="Bé nhà mình đang ở giai đoạn nào? — Nhận quà từ Trường Việt Anh" />
<meta property="og:description" content="Chọn giai đoạn của con → để lại thông tin → mở quà ngay trên màn hình. Miễn phí, không cần là phụ huynh của trường." />
<!-- ĐIỀN: ảnh 1200x630 đặt tại public/og-qua-tang.jpg — thumbnail khi dán link vào comment -->
<meta property="og:image" content="https://truongvietanh.com/og-qua-tang.jpg" />
<meta property="og:url" content="https://truongvietanh.com/qua-tang" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- is:global BẮT BUỘC: thẻ quà, nút nhóm và danh sách món còn lại đều do JS tạo
     lúc chạy, không có thuộc tính scope của Astro nên style scoped sẽ không ăn. -->
<style is:global>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#26275D; --navy2:#1F2050; --card:#2E2F6B;
  --border:rgba(255,255,255,.10); --border2:rgba(255,255,255,.18);
  --text:#eef2ff; --muted:rgba(238,242,255,.62); --muted2:rgba(238,242,255,.82);
  --yellow:#f9dd0e; --red:#dc2626; --green:#22c55e;
  --r:12px;
}
html{-webkit-text-size-adjust:100%}
body{
  min-height:100vh;font-family:'Inter',system-ui,sans-serif;background:var(--navy);
  background-image:
    radial-gradient(ellipse 90% 60% at 72% 105%,rgba(31,32,80,.55) 0%,transparent 55%),
    radial-gradient(ellipse 55% 40% at 4% -4%,rgba(24,25,58,.6) 0%,transparent 50%);
  color:var(--text);line-height:1.55;
}
a{color:inherit}
:focus-visible{outline:3px solid var(--yellow);outline-offset:2px;border-radius:8px}

.lbar{background:#fff;padding:9px 16px;display:flex;align-items:center;justify-content:center}
/* width:auto để chiều rộng luôn suy từ tỷ lệ gốc — không bị kéo méo dù thuộc
   tính width trên thẻ img là kích thước gốc 440px. */
.lbar img{height:44px;width:auto;display:block}
.wrap{max-width:600px;margin:0 auto;padding:22px 18px 56px}
.man{display:none}
.man.on{display:block;animation:len .35s ease both}
@keyframes len{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.man.on{animation:none}}

.eyebrow{display:inline-block;background:rgba(249,221,14,.13);border:1px solid rgba(249,221,14,.35);
  border-radius:30px;padding:4px 13px;font-size:11.5px;font-weight:700;color:var(--yellow);
  letter-spacing:.04em;margin-bottom:12px}
h1{font-family:'Montserrat',sans-serif;font-size:clamp(1.42rem,5.4vw,1.85rem);
   font-weight:900;line-height:1.22;letter-spacing:-.3px;margin-bottom:9px}
h1 u{text-decoration:none;border-bottom:3px solid rgba(249,221,14,.55)}
.sub{font-size:14.5px;color:var(--muted);margin-bottom:16px}
.sub b{color:var(--text);font-weight:600}
.tem{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:22px}
.tem span{background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:30px;
  padding:5px 12px;font-size:12.5px;font-weight:600;color:var(--muted2)}
.tem b{color:var(--green)}

/* --- Màn 1 --- */
.nhoms{display:grid;gap:10px}
.nhom{background:var(--card);border:1.5px solid var(--border);border-radius:var(--r);
  padding:14px 15px;text-align:left;font-family:inherit;color:var(--text);cursor:pointer;
  width:100%;display:flex;align-items:center;gap:13px;min-height:66px;transition:border-color .15s,transform .1s}
.nhom:hover,.nhom:focus-visible{border-color:var(--yellow);transform:translateY(-1px)}
.nhom .ic{font-size:25px;line-height:1;flex:0 0 auto}
.nhom .t{flex:1;min-width:0}
.nhom .t b{display:block;font-family:'Montserrat',sans-serif;font-size:15.5px;font-weight:800;line-height:1.3}
.nhom .t span{font-size:12.5px;color:var(--muted)}
.nhom .mui{color:var(--yellow);font-weight:900;font-size:19px;flex:0 0 auto}

/* --- Màn 2 --- */
.lui{background:none;border:none;font-family:inherit;font-size:13.5px;font-weight:600;
  color:var(--muted);cursor:pointer;padding:6px 0;margin-bottom:10px}
.hop{background:var(--card);border:1.5px solid var(--border2);border-radius:16px;padding:19px 17px 17px}
.hop h2{font-family:'Montserrat',sans-serif;font-size:19px;font-weight:900;line-height:1.28;margin-bottom:7px}
.hop .why{font-size:13.5px;color:var(--muted);margin-bottom:15px}
.hop .why b{color:var(--text);font-weight:600}

.buoc{display:flex;align-items:center;gap:8px;margin-bottom:15px}
.buoc .cham{width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.09);
  color:var(--muted);font-size:12px;font-weight:800;display:flex;align-items:center;
  justify-content:center;flex:0 0 auto}
.buoc .cham.on{background:var(--yellow);color:var(--navy)}
.buoc .nhan{font-size:12px;font-weight:600;color:var(--muted)}
.buoc .nhan.on{color:var(--text)}
.buoc .vach{flex:1;height:2px;background:rgba(255,255,255,.1);border-radius:2px}
.buoc .vach.on{background:var(--yellow)}

.trongho{background:rgba(0,0,0,.16);border-radius:11px;padding:12px 13px;margin-bottom:16px}
.trongho p{font-size:11px;font-weight:800;letter-spacing:.07em;color:var(--muted);
  text-transform:uppercase;margin-bottom:8px}
.trongho ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.trongho li{font-size:13px;color:var(--muted2);display:flex;gap:8px;line-height:1.45}
.trongho li::before{content:"·";color:var(--yellow);font-weight:900;font-size:17px;line-height:1.05}

.buoc-o{display:none}
.buoc-o.on{display:block}
.field{margin-bottom:12px}
.field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--muted2)}
input[type=text],input[type=tel],input[type=email]{
  width:100%;padding:14px 13px;border:1.5px solid var(--border2);border-radius:11px;
  background:rgba(0,0,0,.22);font-family:inherit;font-size:16px;color:var(--text)}
input::placeholder{color:rgba(238,242,255,.34)}
input:focus{outline:none;border-color:var(--yellow);background:rgba(0,0,0,.3)}
input.err{border-color:var(--red);background:rgba(220,38,38,.1)}
.msg{font-size:12.5px;color:#fca5a5;margin-top:6px;display:none}
.msg.on{display:block}
.mat{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.rieng{font-size:11.5px;color:var(--muted);margin-top:11px;line-height:1.5}
.go{width:100%;padding:16px;border:none;border-radius:12px;background:var(--yellow);
  color:var(--navy);font-family:'Montserrat',sans-serif;font-weight:900;font-size:16px;
  cursor:pointer;margin-top:6px;min-height:52px}
.go:disabled{opacity:.5;cursor:default}

/* --- Màn 3 --- */
.mo-dau{text-align:center;margin-bottom:17px}
.mo-dau .qua-ic{font-size:46px;line-height:1;display:inline-block;animation:rung .55s ease-out}
@keyframes rung{0%{transform:scale(.4) rotate(-12deg);opacity:0}
  60%{transform:scale(1.13) rotate(7deg);opacity:1}100%{transform:scale(1) rotate(0)}}
@media(prefers-reduced-motion:reduce){.mo-dau .qua-ic{animation:none}}
.mo-dau h2{font-family:'Montserrat',sans-serif;font-size:20px;font-weight:900;margin:11px 0 5px}
.mo-dau p{font-size:13.5px;color:var(--muted)}

.the{background:var(--card);border:2px solid var(--yellow);border-radius:16px;
  padding:18px 17px 16px;margin-bottom:24px;box-shadow:0 6px 26px rgba(249,221,14,.13)}
.the .nhan{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;background:rgba(249,221,14,.15);color:var(--yellow);
  border-radius:5px;padding:4px 9px;margin-bottom:10px}
.the h3{font-family:'Montserrat',sans-serif;font-size:18px;font-weight:900;line-height:1.3;margin-bottom:9px}
.the .loi{font-size:14px;color:var(--muted2);margin-bottom:12px}
.the ul{list-style:none;margin-bottom:13px}
.the li{font-size:13px;color:var(--muted2);padding-left:18px;position:relative;margin-bottom:6px;line-height:1.45}
.the li::before{content:"·";position:absolute;left:5px;top:-2px;color:var(--yellow);font-weight:900;font-size:18px}
.the .meta{font-size:11.5px;color:var(--muted);margin-bottom:13px}

.nut{display:block;width:100%;padding:15px;border:none;border-radius:12px;background:var(--green);
  color:#fff;font-family:'Montserrat',sans-serif;font-weight:800;font-size:15.5px;
  text-align:center;text-decoration:none;min-height:50px}
.nut.phu{background:transparent;color:var(--text);border:1.5px solid var(--border2);
  font-size:14px;padding:12px;margin-top:8px;font-weight:700}

.con-lai h3{font-family:'Montserrat',sans-serif;font-size:14.5px;font-weight:800;margin-bottom:4px}
.con-lai .ghi{font-size:12.5px;color:var(--muted);margin-bottom:12px}
.ds{display:flex;flex-direction:column;gap:9px}
.ds a{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.05);
  border:1px solid var(--border);border-radius:11px;padding:12px 13px;text-decoration:none}
.ds a:hover{border-color:var(--border2)}
.ds a .ic{font-size:21px;flex:0 0 auto}
.ds a .t{flex:1;min-width:0}
.ds a .t b{display:block;font-size:14px;font-weight:700;line-height:1.32}
.ds a .t span{font-size:11.5px;color:var(--muted)}
.ds a .mui{color:var(--yellow);font-weight:900;font-size:16px;flex:0 0 auto}

.cta{display:block;text-align:center;background:rgba(249,221,14,.13);
  border:1px solid rgba(249,221,14,.4);color:var(--yellow);font-family:'Montserrat',sans-serif;
  font-weight:800;font-size:15px;border-radius:12px;padding:14px;margin-top:20px;text-decoration:none}
.note{background:rgba(0,0,0,.22);border:1px solid var(--border);border-radius:13px;
  padding:15px;font-size:13px;color:var(--muted2);margin-top:22px}
.note b{color:var(--yellow)}
.tel{color:var(--yellow);font-weight:800;text-decoration:none}
.disc{font-size:11.5px;color:var(--muted);margin-top:20px;line-height:1.6}
.foot{text-align:center;font-size:11.5px;color:var(--muted);margin-top:18px;line-height:1.75}

/* ==========================================================================
   BỐ CỤC HAI CỘT TRÊN DESKTOP
   Mặc định (mobile) hai cột xếp chồng. Từ 900px trở lên tách đôi theo đúng
   khuôn các landing page khác của site: cột nội dung + cột hành động.
   ========================================================================== */
.doi{display:grid;gap:18px}

@media(min-width:900px){
  .wrap{max-width:1080px;padding:34px 28px 72px}
  .lbar{padding:12px 16px}
  .lbar img{height:58px}

  .doi{grid-template-columns:minmax(0,1fr) 420px;gap:48px;align-items:start}
  #man3 .doi{grid-template-columns:minmax(0,1fr) 380px}

  h1{font-size:2.45rem;line-height:1.16;margin-bottom:14px}
  .eyebrow{font-size:12.5px;padding:5px 15px;margin-bottom:16px}
  .sub{font-size:16px;line-height:1.6;max-width:44ch}
  .tem{margin-bottom:0}
  .tem span{font-size:13px;padding:6px 14px}

  .nhom{padding:16px 18px;min-height:76px}
  .nhom .ic{font-size:28px}
  .nhom .t b{font-size:16.5px}
  .nhom .t span{font-size:13px}

  .lui{font-size:14px;margin-bottom:14px}
  .hop{padding:24px 22px 22px}
  .hop h2,.doi-trai h2{font-size:26px;line-height:1.24;margin-bottom:10px}
  .why{font-size:15px;margin-bottom:20px}
  .trongho{padding:16px 18px}
  .trongho p{font-size:11.5px;margin-bottom:10px}
  .trongho li{font-size:14px}

  .the{padding:26px 24px 22px}
  .the h3{font-size:22px}
  .the .loi{font-size:15px}
  .the li{font-size:14px}
  .mo-dau{margin-bottom:24px}
  .mo-dau .qua-ic{font-size:54px}
  .mo-dau h2{font-size:24px}
  .cta{margin-top:14px}

  .note{margin-top:30px;padding:18px;font-size:14px}
  .disc,.foot{max-width:72ch;margin-left:auto;margin-right:auto}
}

@media(min-width:1240px){
  .wrap{max-width:1140px}
  h1{font-size:2.7rem}
}
</style>
</head>
<body>

<!-- Dùng logo-vietanh.webp (440x215) — cùng file layout chung của site dùng.
     ĐỪNG đổi sang logo-vietanh-header.webp: file đó chỉ 81x40, phóng lên 56px
     là nhoè hết chữ trong logo. width/height để đúng kích thước gốc cho trình
     duyệt giữ chỗ theo tỷ lệ, kích thước hiển thị thật do CSS quyết định. -->
<div class="lbar"><img src="/logo-vietanh.webp" alt="Trường Việt Anh" width="440" height="215" /></div>

<div class="wrap">

  <!-- ================= MÀN 1 ================= -->
  <section class="man on" id="man1">
    <div class="doi">
      <div class="doi-trai">
        <span class="eyebrow" id="eyebrow">QUÀ TẶNG MIỄN PHÍ CHO BA MẸ</span>
        <h1>Bé nhà mình đang ở <u>giai đoạn nào</u> ạ?</h1>
        <p class="sub">Trường có sẵn một kho tài liệu làm cho ba mẹ. Ba mẹ bấm vào giai đoạn của con, trường gửi món hợp tuổi — <b>miễn phí, không cần là phụ huynh của trường.</b></p>

        <div class="tem">
          <span><b>✓</b> Miễn phí</span>
          <span><b>✓</b> Mở ngay, không chờ email</span>
          <span><b>✓</b> Không spam</span>
        </div>
      </div>

      <div class="doi-phai">
        <div class="nhoms" id="nhoms"></div>
      </div>
    </div>
  </section>

  <!-- ================= MÀN 2 ================= -->
  <section class="man" id="man2">
    <button type="button" class="lui" id="lui">← Chọn lại giai đoạn</button>
    <div class="doi">
      <div class="doi-trai">
        <h2 id="f-tieude">Quà cho bé nhà mình</h2>
        <p class="why">Trường gửi bản lưu vào email, và cô gọi lại nếu ba mẹ cần hỏi thêm. <b>Không gọi bán hàng, không nhắn hàng loạt.</b></p>

        <div class="trongho">
          <p id="f-nhan">Trong hộp quà giai đoạn này có</p>
          <ul id="f-ds"></ul>
        </div>
      </div>

      <div class="doi-phai">
    <div class="hop">
      <div class="buoc">
        <span class="cham on" id="c1">1</span><span class="nhan on" id="n1">Email</span>
        <span class="vach" id="v"></span>
        <span class="cham" id="c2">2</span><span class="nhan" id="n2">Nhận quà</span>
      </div>

      <form id="lead" novalidate>
        <!-- Bước 1 -->
        <div class="buoc-o on" id="b1">
          <div class="field">
            <label for="email">Email của ba mẹ</label>
            <input type="email" id="email" autocomplete="email" inputmode="email" placeholder="dexemlai@email.com" />
            <div class="msg" id="msg-email">Email chưa đúng, ba mẹ xem lại giúp ạ</div>
          </div>
          <button type="button" class="go" id="tiep">Tiếp tục →</button>
          <p class="rieng">Trường dùng email này để gửi bản lưu món quà, không chia sẻ cho bên thứ ba.</p>
        </div>

        <!-- Bước 2 -->
        <div class="buoc-o" id="b2">
          <div class="field">
            <label for="ten">Tên ba / mẹ</label>
            <input type="text" id="ten" autocomplete="name" placeholder="Ví dụ: chị Lan" />
            <div class="msg" id="msg-ten">Ba mẹ điền tên giúp em ạ</div>
          </div>
          <div class="field">
            <label for="sdt">Số điện thoại</label>
            <input type="tel" id="sdt" inputmode="numeric" autocomplete="tel" placeholder="09xx xxx xxx" />
            <div class="msg" id="msg-sdt">Số điện thoại chưa đúng, ba mẹ xem lại giúp ạ</div>
          </div>
          <!-- Bẫy bot: người thật không nhìn thấy ô này -->
          <div class="mat" aria-hidden="true">
            <label for="website">Đừng điền ô này</label>
            <input type="text" id="website" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="go" id="go">Mở quà cho ba mẹ 🎁</button>
          <p class="rieng">Bấm nút này là ba mẹ đồng ý để trường liên hệ tư vấn về việc học của con.</p>
        </div>
      </form>
    </div>
      </div>
    </div>
  </section>

  <!-- ================= MÀN 3 ================= -->
  <section class="man" id="man3">
    <div class="mo-dau">
      <div class="qua-ic" aria-hidden="true">🎁</div>
      <h2>Quà của ba mẹ đây ạ</h2>
      <p id="mo-phu">Trường gửi ba mẹ món này</p>
    </div>

    <div class="doi">
      <div class="doi-trai">
        <article class="the" id="the"></article>
      </div>

      <div class="doi-phai">
        <div class="con-lai" id="con-lai">
          <h3>Mấy món còn lại trong nhóm của con</h3>
          <p class="ghi">Mở sẵn hết rồi — ba mẹ lấy thêm không phải điền lại ạ.</p>
          <div class="ds" id="ds"></div>
        </div>

        <a class="cta" id="cta-zalo" href="#" target="_blank" rel="noopener">Có gì chưa rõ, nhắn Zalo cho cô</a>
      </div>
    </div>

    <div class="note">
