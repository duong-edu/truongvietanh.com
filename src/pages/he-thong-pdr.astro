---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { schoolFacts } from '../data/school-facts';

// Viết lại toàn bộ 28/08/2026 — PDR = Plan – Do – Review. Bản cũ dịch sai thành
// "Play – Discover – Reflect". Nội dung theo bản duyệt của anh Dương.
// Sửa 26/10/2026 (Văn chốt): MỘT tên gọi cho cả bốn cấp. Bỏ hẳn "mầm non = Plan – Do – Recall"
// và bỏ mục H2 giải thích vì sao mầm non gọi khác. Đây là đổi TÊN BƯỚC — phần tả trẻ mầm non
// KỂ LẠI việc vừa chơi thì giữ, vì trẻ 3–5 tuổi thật sự làm việc đó chứ không tự chấm điểm.
// KHÔNG lấy title/description/FAQ từ Directus nữa: bản ghi CMS còn giữ định nghĩa sai,
// nếu fallback về CMS thì trang live sẽ hiển thị lại nội dung cũ.
// KHÔNG thêm aggregateRating/review (self-serving review — rủi ro manual action).

const PAGE_TITLE = 'PDR là gì? Plan – Do – Review tại Trường Việt Anh';
const PAGE_DESC =
  'PDR tại Việt Anh là Plan – Do – Review: con tự lên kế hoạch, tự làm, tự nhìn lại — từ mầm non đến lớp 12. Xem cách làm ở từng cấp học.';
const PAGE_URL = 'https://truongvietanh.com/he-thong-pdr/';
const PAGE_IMAGE = 'https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp';

const faqs = [
  {
    q: 'PDR là viết tắt của gì?',
    a: 'PDR là Plan – Do – Review: Lên kế hoạch – Thực hiện – Nhìn lại. Học sinh tự đặt kế hoạch, tự thực hiện, rồi tự nhìn lại việc mình vừa làm. Cùng một nhịp ba bước này chạy suốt từ mầm non đến lớp 12, chỉ khác độ sâu theo tuổi.',
  },
  {
    q: 'Bước Nhìn lại ở mầm non và ở THPT khác nhau thế nào?',
    a: 'Khác ở độ sâu, không khác ở tên. Trẻ mầm non kể lại điều vừa trải qua: hôm nay chơi gì, với ai, bằng thứ gì — nhớ lại, sắp xếp, diễn đạt. Học sinh THPT thì đối chiếu kế hoạch với kết quả, gọi tên chỗ chênh và cam kết một điều làm khác đi, gắn với lộ trình IELTS, Capstone hay hồ sơ du học.',
  },
  {
    q: 'PDR có phải phương pháp riêng của Trường Việt Anh không?',
    a: 'Không. Nhịp plan-do-review là cấu trúc lõi của mô hình HighScope (Hoa Kỳ), nơi ba phân đoạn được gọi là planning time - work time - recall time. Việt Anh là trường HighScope inspired: chúng tôi vận dụng nhịp này trong khung GDPT 2018 và mở rộng lên tới lớp 12. Trường không được HighScope cấp phép hay chứng nhận.',
  },
  {
    q: 'PDR có làm con học nhẹ đi và điểm thấp đi không?',
    a: 'Không, vì PDR không thay thế nội dung môn học — nó là cách con quản lý việc học nội dung đó. Tổng hợp 355 nghiên cứu của Education Endowment Foundation cho thấy nhóm can thiệp siêu nhận thức và tự điều chỉnh mang lại khoảng 8 tháng tiến bộ học tập trong một năm học, với chi phí rất thấp.',
  },
  {
    q: 'Con tôi nhút nhát, có làm được PDR không?',
    a: 'Làm được. Bước Review chấp nhận nhiều hình thức: viết nhật ký, vẽ, hoặc nói riêng với một bạn trong buổi "đôi bạn cùng tiến" thay vì phát biểu trước lớp. Điều bắt buộc là con tự rút ra kết luận, không bắt buộc con phải nói to trước đám đông.',
  },
  {
    q: 'Làm sao để xem một tiết PDR thật?',
    a: 'Đặt lịch tham quan qua hotline 0916 961 409 hoặc email hoc@truongvietanh.com. Trường nhận khách Thứ 2 – Thứ 7, 07:00 – 19:00 (Chủ Nhật ngoài giờ nhưng vẫn sắp xếp được nếu hẹn trước), và ưu tiên ngày trong tuần, vì chỉ ngày thường anh chị mới dự được đúng giờ Plan đầu buổi và giờ Review cuối buổi.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${PAGE_URL}#article`,
    headline: 'PDR là gì? Hệ thống Plan – Do – Review tại Trường Việt Anh',
    description: PAGE_DESC,
    inLanguage: 'vi-VN',
    datePublished: '2026-08-27T09:00:00+07:00',
    dateModified: '2026-08-28T09:00:00+07:00',
    mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
    image: [PAGE_IMAGE],
    author: {
      '@type': 'Person',
      '@id': 'https://nguyenmanhduong.com/#person',
      name: 'Nguyễn Mạnh Dương',
      jobTitle: 'Nhà sáng lập & Chủ tịch hệ thống giáo dục K-12 Việt Anh',
      url: 'https://truongvietanh.com/gioi-thieu',
      sameAs: [
        'https://nguyenmanhduong.com',
        'https://www.facebook.com/nguyenmanhduong1101/',
        'https://www.youtube.com/@nguyenmanhduong1101',
        'https://www.linkedin.com/in/nguyenmanhduong',
      ],
    },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://truongvietanh.com/#organization',
      name: 'Hệ thống giáo dục Việt Anh',
      logo: { '@type': 'ImageObject', url: 'https://truongvietanh.com/logo-crest-80.webp' },
    },
    about: [
      { '@type': 'Thing', name: 'Plan Do Review' },
      { '@type': 'Thing', name: 'Phương pháp giáo dục chủ động' },
      { '@type': 'Thing', name: 'Siêu nhận thức và tự điều chỉnh' },
    ],
    citation: [
      'https://highscope.org/wp-content/uploads/2024/07/perry-preschool-summary-40.pdf',
      'https://educationendowmentfoundation.org.uk/education-evidence/teaching-learning-toolkit/metacognition-and-self-regulation',
    ],
    audience: { '@type': 'Audience', audienceType: 'Phụ huynh học sinh K-12 tại Việt Nam' },
    keywords:
      'PDR, Plan Do Review, Plan Do Recall, phương pháp giáo dục Việt Anh, tự học, siêu nhận thức',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${PAGE_URL}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${PAGE_URL}#howto`,
    name: '5 bước làm PDR cùng con tại nhà',
    description: 'Cách cha mẹ chạy nhịp Plan - Do - Review với con mỗi tối, mất khoảng 5 phút.',
    totalTime: 'P30D',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Hỏi trước khi con bắt đầu',
        text: 'Hỏi tối nay con định làm gì trước. Một câu, ba mươi giây. Đây là bước Plan và là bước hầu hết gia đình bỏ qua.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Để con tự làm',
        text: 'Bước Do là của con. Cha mẹ ngồi cùng phòng được, làm hộ thì không, kể cả khi thấy con làm chậm.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Cuối ngày hỏi bốn câu đúng thứ tự',
        text: 'Con định làm gì? Thực tế đã xảy ra gì? Vì sao có khoảng cách? Ngày mai con giữ gì, đổi gì?',
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Với con mẫu giáo, đổi thành lời kể',
        text: 'Hỏi con kể mẹ nghe hôm nay con chơi gì, và nghe hết, không sửa lưng. Đó là bước Nhìn lại ở tuổi mẫu giáo.',
      },
      {
        '@type': 'HowToStep',
        position: 5,
        name: 'Không biến buổi nhìn lại thành buổi phê bình',
        text: 'Nếu dùng câu trả lời của con để mắng, con sẽ học được rằng nói thật thì bị phạt, và PDR ở nhà kết thúc từ đó.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
      { '@type': 'ListItem', position: 2, name: 'Hệ thống PDR', item: 'https://truongvietanh.com/he-thong-pdr' },
    ],
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical="https://truongvietanh.com/he-thong-pdr"
  ogImage={PAGE_IMAGE}
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Hệ thống PDR</span>
          </nav>

          <h1 class="gi-h1">PDR là gì? Hệ thống Plan – Do – Review tại Trường Việt Anh</h1>
          <p class="gi-subtitle">Lên kế hoạch — Thực hiện — Nhìn lại. Ba bước học sinh Việt Anh lặp lại từ mầm non đến lớp 12.</p>
          <p class="gi-last-updated">Cập nhật lần cuối: 28/08/2026</p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>Từ {schoolFacts.foundedYear}</strong> hệ thống K-12</div>
            <div class="gi-badge"><strong>{schoolFacts.campuses}</strong> cơ sở</div>
            <div class="gi-badge"><strong>{schoolFacts.currentEnrollment}</strong> học sinh đang học</div>
            <div class="gi-badge"><strong>Mầm non &rarr; Lớp 12</strong> cùng ba bước</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đặt lịch dự một buổi PDR thật</p>
            <LeadFormTwoStepEmailFirst
              formId="pdr-form"
              funnelCode="pdr-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#pdr-la-gi">PDR là viết tắt của gì?</a></li>
          <li><a href="#vi-sao-recall">Nhìn lại ở mầm non trông thế nào?</a></li>
          <li><a href="#cap-hoc">Mỗi cấp làm bao lâu một lần?</a></li>
          <li><a href="#co-so-khoa-hoc">Cơ sở khoa học</a></li>
          <li><a href="#so-sanh">Khác gì Montessori &amp; Reggio Emilia?</a></li>
          <li><a href="#vong-that">Một vòng PDR thật</a></li>
          <li><a href="#tai-nha">Làm PDR ở nhà</a></li>
          <li><a href="#sai-lam">Sai lầm thường gặp</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#pdr-form-pdr-pillar" class="gi-toc-cta">Đặt lịch tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Direct answer block -->
        <p class="pdr-answer">
          PDR là ba bước học sinh Việt Anh lặp lại mỗi ngày: <strong>Plan</strong> (tự lên kế hoạch) —
          <strong>Do</strong> (tự thực hiện) — <strong>Review</strong> (tự nhìn lại). Cùng ba bước đó chạy từ
          mầm non đến lớp 12; ở mầm non, bước thứ ba là trẻ kể lại việc mình vừa làm. Mục đích không phải dạy
          thêm kiến thức, mà dạy đứa trẻ cách tự điều khiển việc học của chính nó.
        </p>

        <section class="gi-section">
          <p>Có một câu hỏi tôi hay nhận được từ phụ huynh, thường vào lúc con đã lên lớp 8, lớp 9: "Sao con tôi học thì vẫn học, mà không tự giác được?"</p>
          <p>Câu trả lời thường không nằm ở đứa trẻ. Nằm ở chỗ suốt tám, chín năm đi học, chưa ai từng để con <strong>tự quyết định hôm nay mình sẽ làm gì</strong>, rồi <strong>tự nhìn lại xem mình đã làm được đến đâu</strong>. Con luôn được giao việc và được chấm điểm. Hai việc đó không tạo ra tính tự giác — chúng tạo ra sự chờ đợi được giao việc tiếp.</p>
          <p>PDR là cách chúng tôi trả lại hai quyền đó cho học sinh, mỗi ngày, từ năm ba tuổi.</p>
          <p>Trang này mô tả đúng cách PDR đang được vận hành tại Việt Anh — kể cả những chỗ chúng tôi làm chưa tốt.</p>
        </section>

        <!-- Section 1 -->
        <section id="pdr-la-gi" class="gi-section">
          <h2>PDR là viết tắt của gì?</h2>
          <p><strong>PDR là Plan – Do – Review: Lên kế hoạch – Thực hiện – Nhìn lại.</strong> Đúng ba bước, không hơn.</p>

          <div class="gi-pdr-cycle">
            <div class="gi-pdr-steps">
              <div class="gi-pdr-step gi-pdr-play">
                <span class="gi-pdr-number">1</span>
                <strong>Plan (Lên kế hoạch)</strong>
                <p>Trước khi làm, học sinh nói ra hoặc viết ra mình định làm gì, làm thế nào, mong đợi kết quả ra sao. Bước này ngắn, nhưng nếu bỏ thì bước thứ ba mất điểm neo để so sánh.</p>
              </div>
              <div class="gi-pdr-arrow" aria-hidden="true">&#10140;</div>
              <div class="gi-pdr-step gi-pdr-discover">
                <span class="gi-pdr-number">2</span>
                <strong>Do (Thực hiện)</strong>
                <p>Học sinh làm thật, tự xoay xở với vật liệu, thời gian và bạn cùng nhóm. Giáo viên quan sát và đặt câu hỏi, không làm thay.</p>
              </div>
              <div class="gi-pdr-arrow" aria-hidden="true">&#10140;</div>
              <div class="gi-pdr-step gi-pdr-reflect">
                <span class="gi-pdr-number">3</span>
                <strong>Review (Nhìn lại)</strong>
                <p>Học sinh đối chiếu việc đã làm với kế hoạch đã đặt, gọi tên chỗ chênh lệch, giải thích vì sao, rồi chọn <strong>một</strong> điều sẽ làm khác đi.</p>
              </div>
            </div>
          </div>

          <p>Ba bước này giữ nguyên tên ở cả bốn cấp học. Thứ thay đổi theo tuổi là <strong>độ sâu của bước thứ ba</strong> — tôi nói rõ ngay sau đây.</p>

          <p>Một điều cần nói thẳng: <strong>PDR không phải phát minh của Trường Việt Anh.</strong> Nhịp plan–do–review là cấu trúc lõi trong mô hình giáo dục sớm của <a href="https://highscope.org/" target="_blank" rel="noopener">HighScope Educational Research Foundation</a> (Ypsilanti, Michigan, Hoa Kỳ), nơi ba phân đoạn của một ngày học được gọi đúng là <em>planning time – work time – recall time</em>. Việt Anh là trường <strong>HighScope inspired</strong> — chúng tôi lấy cảm hứng từ nhịp này, đưa vào chương trình quốc gia GDPT 2018 và mở rộng nó lên tiểu học, THCS và THPT. Trường không được HighScope cấp phép, chứng nhận hay nhượng quyền.</p>
        </section>

        <!-- Section 2 -->
        <section id="vi-sao-recall" class="gi-section">
          <h2>Bước Nhìn lại ở mầm non trông thế nào?</h2>
          <p><strong>Nó là một lời kể, không phải một bản tự đánh giá.</strong> Trẻ ba đến năm tuổi đã thừa sức kể lại điều mình vừa làm, nhưng chưa đủ năng lực tự chấm mình theo một chuẩn.</p>
          <p>Vì vậy ở lớp mầm non, bước thứ ba là trẻ <strong>tái hiện lại trải nghiệm</strong>: kể bằng lời, vẽ lại, hoặc đơn giản là dắt cô ra góc xây dựng chỉ vào công trình của mình. Việc đó vẫn rèn đúng cơ bắp cần rèn — nhớ lại, sắp xếp, diễn đạt — nhưng ở đúng mức tuổi. Ép một đứa trẻ mẫu giáo tự đánh giá thì chỉ nhận được câu trả lời làm vừa lòng cô.</p>
          <p>Đến tiểu học, khi con đã đọc được kế hoạch mình viết sáng nay, bước Nhìn lại mới thành việc <strong>so sánh</strong>: kế hoạch với kết quả, mong đợi với thực tế. Đó là thao tác siêu nhận thức, cần ngôn ngữ và cần khả năng giữ hai hình ảnh trong đầu cùng lúc. Lên THCS và THPT, con làm việc đó với mục tiêu theo môn, theo kỳ và theo lộ trình cá nhân.</p>

          <img src="https://media.truongvietanh.com/images/vui-ve-03.webp" alt="Trẻ mầm non Việt Anh kể lại việc mình vừa chơi trong giờ Nhìn lại cuối buổi" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />
        </section>

        <!-- Section 3 -->
        <section id="cap-hoc" class="gi-section">
          <h2>PDR ở mỗi cấp học làm bao lâu một lần?</h2>

          <div class="gi-table-responsive">
            <table class="gi-table gi-table-programs">
              <thead>
                <tr>
                  <th>Cấp học</th>
                  <th>Tên ba bước</th>
                  <th>Bước thứ ba con làm gì</th>
                  <th>Nhịp</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Mầm non</strong></td>
                  <td>Plan – Do – <strong>Review</strong></td>
                  <td>Trẻ <strong>kể lại</strong> vừa chơi gì, với ai, bằng vật liệu nào — bằng lời, bằng tranh, hoặc dẫn cô ra tận nơi</td>
                  <td><strong>Hằng ngày</strong></td>
                </tr>
                <tr>
                  <td><strong>Tiểu học</strong></td>
                  <td>Plan – Do – <strong>Review</strong></td>
                  <td>Con <strong>đối chiếu</strong> việc đã làm với kế hoạch buổi sáng, ghi lại, chọn một điều làm khác đi</td>
                  <td><strong>Hằng ngày</strong></td>
                </tr>
                <tr>
                  <td><strong>THCS</strong></td>
                  <td>Plan – Do – <strong>Review</strong></td>
                  <td>Gắn với mục tiêu 4 lĩnh vực phát triển của trường: Kiến thức, Kỹ năng lãnh đạo, Phẩm chất, Sức khoẻ; làm trong buổi <strong>"đôi bạn cùng tiến"</strong>, hai bạn nghe nhau và cùng cam kết</td>
                  <td><strong>Hằng tuần</strong></td>
                </tr>
                <tr>
                  <td><strong>THPT</strong></td>
                  <td>Plan – Do – <strong>Review</strong></td>
                  <td>Gắn với mục tiêu 4 lĩnh vực phát triển của trường: Kiến thức, Kỹ năng lãnh đạo, Phẩm chất, Sức khoẻ; làm trong buổi <strong>"đôi bạn cùng tiến"</strong>, hai bạn nghe nhau và cùng cam kết</td>
                  <td><strong>Hằng tuần</strong></td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>Ba điều cần lưu ý về bảng này. Thứ nhất, PDR <strong>luôn là ba bước</strong> — không có bước thứ tư nào tên "Fix" hay "Reflect". Thứ hai, nhịp thưa dần khi con lớn lên là có chủ đích: trẻ nhỏ cần vòng lặp ngắn để thấy hệ quả ngay, học sinh lớn cần khoảng cách đủ dài để có gì đó thực sự đáng nhìn lại. Thứ ba, ở Việt Anh, PDR nằm <strong>trong</strong> giờ học chính khóa, không phải hoạt động thêm giờ.</p>

          <div class="gi-level-cards">
            <a href="/mam-non" class="gi-level-link">PDR tại Mầm non &rarr;</a>
            <a href="/tieu-hoc" class="gi-level-link">PDR tại Tiểu học &rarr;</a>
            <a href="/trung-hoc-co-so" class="gi-level-link">PDR tại THCS &rarr;</a>
            <a href="/trung-hoc-pho-thong" class="gi-level-link">PDR tại THPT &rarr;</a>
          </div>
        </section>

        <!-- Section 4 -->
        <section id="co-so-khoa-hoc" class="gi-section">
          <h2>PDR có cơ sở khoa học nào không?</h2>
          <p><strong>Có, và bằng chứng mạnh nhất không đến từ điểm số mà đến từ những gì xảy ra hàng chục năm sau.</strong></p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>Nghiên cứu Perry Preschool (Schweinhart và cộng sự, 2005)</h4>
              <p>Đây là nghiên cứu theo dõi dài nhất về chương trình mầm non vận hành theo nhịp plan–do–review của HighScope: 123 trẻ có hoàn cảnh khó khăn tại Michigan, chia ngẫu nhiên thành nhóm học chương trình (58 trẻ) và nhóm không học (65 trẻ), theo dõi đến năm 40 tuổi.</p>
              <ul>
                <li><strong>65%</strong> nhóm có học tốt nghiệp trung học phổ thông, so với <strong>45%</strong> nhóm không học</li>
                <li>Thu nhập trung vị năm 40 tuổi: <strong>20.800 USD</strong> so với <strong>15.300 USD</strong></li>
                <li>Mỗi 1 USD đầu tư mang lại <strong>16,14 USD</strong> giá trị hoàn trả trong cả cuộc đời</li>
              </ul>
            </div>
            <div class="gi-leader-card">
              <h4>Tổng hợp của Education Endowment Foundation (Anh)</h4>
              <p>EEF xếp nhóm can thiệp "siêu nhận thức và tự điều chỉnh" — đúng thứ mà bước Review rèn — vào loại hiệu quả cao nhất trên mỗi đồng chi phí: <strong>+8 tháng tiến bộ học tập trong một năm học</strong>, dựa trên <strong>355 nghiên cứu</strong>, với chi phí triển khai được đánh giá là rất thấp.</p>
              <p>EEF cũng cảnh báo đúng điều tôi lo: hiệu quả này <strong>rất khó đạt được nếu giáo viên chưa được huấn luyện tử tế</strong>. Đó là lý do phần đầu tư lớn nhất của chúng tôi cho PDR nằm ở đào tạo giáo viên, không nằm ở giáo cụ.</p>
            </div>
          </div>

          <p><strong>Nền tảng lý thuyết.</strong> Nhịp này nối thẳng vào truyền thống <em>learning by doing</em> của <strong>John Dewey</strong> và vòng học tập trải nghiệm của <strong>David Kolb</strong>: trải nghiệm mà không có bước nhìn lại thì chỉ là hoạt động, chưa thành việc học.</p>

          <blockquote class="pdr-quote">
            <p>"Điều thay đổi rõ nhất khi một lớp chạy PDR đủ lâu không phải là điểm số, mà là cách học sinh trả lời câu hỏi 'vì sao'. Các con chuyển từ 'con không biết' sang 'con nghĩ là tại vì...'."</p>
            <cite><strong>Nguyễn Thùy Anh</strong> — phụ trách Nghiên cứu &amp; Phát triển học thuật, Hệ thống giáo dục Việt Anh</cite>
          </blockquote>
        </section>

        <!-- Section 5 -->
        <section id="so-sanh" class="gi-section">
          <h2>PDR khác gì Montessori, Reggio Emilia và lớp học truyền thống?</h2>
          <p><strong>Khác ở chỗ ai là người ra quyết định, và ai là người đánh giá.</strong> Bảng dưới đây so theo <strong>mô hình</strong>, không so theo trường cụ thể — và tôi ghi nhận điểm mạnh thật của từng mô hình.</p>

          <div class="gi-comparison-box">
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Lớp học truyền thống</th>
                    <th>Montessori</th>
                    <th>Reggio Emilia</th>
                    <th>PDR tại Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Ai quyết định hôm nay học gì</td>
                    <td>Giáo viên</td>
                    <td>Trẻ chọn trong bộ giáo cụ đã thiết kế sẵn</td>
                    <td>Nảy sinh từ dự án chung của nhóm</td>
                    <td>Học sinh tự đặt kế hoạch, trong khung mục tiêu môn học</td>
                  </tr>
                  <tr>
                    <td>Ai đánh giá kết quả</td>
                    <td>Giáo viên chấm điểm</td>
                    <td>Giáo cụ tự sửa lỗi cho trẻ</td>
                    <td>Ghi chép và trưng bày quá trình</td>
