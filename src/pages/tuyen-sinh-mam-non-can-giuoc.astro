---
import DarkLPLayout from '../layouts/DarkLPLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import FAQSection from '../components/FAQSection.astro';

const uspItems = [
    {
      "icon": "🎓",
      "text": "Chương trình Mầm Non song ngữ — chuẩn quốc tế, sĩ số 22 em/lớp"
    },
    {
      "icon": "🇬🇧",
      "text": "Giáo viên bản ngữ + Việt cùng dạy — Tiếng Anh từ 8–12 tiết/tuần"
    },
    {
      "icon": "📋",
      "text": "Test đầu vào miễn phí — đánh giá toàn diện học lực"
    },
    {
      "icon": "💸",
      "text": "Early Bird trước 30/4 — giảm 30% học phí + tặng đồng phục"
    },
    {
      "icon": "🚌",
      "text": "Xe đưa đón bán kính 10km từ Cần Giuộc"
    },
    {
      "icon": "📞",
      "text": "Hỗ trợ 24/7 qua Zalo OA — Hiệu trưởng phản hồi trong 12h"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '8', label: 'Cơ sở tại TP.HCM, Tây Ninh, An Giang' },
];

const faqItems = [
    {
      "question": "Hồ sơ nhập học cần gì?",
      "answer": "Học bạ 2 năm gần nhất, giấy khai sinh, sổ tiêm chủng (Mầm Non/Tiểu Học), 4 ảnh 3x4, đơn nhập học. Trường hướng dẫn từng bước."
    },
    {
      "question": "Có test đầu vào không?",
      "answer": "Mầm Non chỉ có buổi gặp gỡ làm quen 30 phút, không test áp lực. Kết quả dùng để xếp lớp và xét học bổng."
    },
    {
      "question": "Lớp sĩ số bao nhiêu?",
      "answer": "Mầm Non sĩ số tối đa 22 em/lớp, có 1 giáo viên chính + 1 trợ giảng + 1 giáo viên bản ngữ. Đảm bảo từng con được quan tâm."
    },
    {
      "question": "Có học phí trả góp không?",
      "answer": "Có. Trả góp 0% lãi suất qua thẻ TPBank, MB, VPBank, chia 6/9/12 kỳ. Không cần chứng minh thu nhập."
    },
    {
      "question": "Khi nào bắt đầu nhập học?",
      "answer": "Năm học 2026–2027 khai giảng 5/9/2026. Có lớp tiền nhập học (orientation) tháng 7 cho HS mới làm quen môi trường, miễn phí cho HS đăng ký Early Bird."
    }
  ];
---
<DarkLPLayout
  title="Tuyển Sinh Mầm Non tại Cần Giuộc 2026–2027 | Trường Việt Anh"
  description="Đăng ký sớm nhận học bổng Early Bird đến 30% học phí. Hỗ trợ trọn gói thủ tục và test đầu vào miễn phí."
  canonicalUrl="https://truongvietanh.com/tuyen-sinh-mam-non-can-giuoc"
  fomoText="🔥 3,000+ học sinh đang theo học — Đăng ký nhận ưu đãi Early Bird"
  headline="Tuyển Sinh Mầm Non tại Cần Giuộc 2026–2027"
  headlineEm="Học bổng Early Bird đến 30% — Đăng ký trước 30/4"
  subheadline="Đăng ký sớm nhận học bổng Early Bird đến 30% học phí. Hỗ trợ trọn gói thủ tục và test đầu vào miễn phí."
  bullets={[
    "🎓 Chương trình Mầm Non song ngữ — <strong>chuẩn quốc tế, sĩ số 22 em/lớp</strong>",
    "🇬🇧 Giáo viên bản ngữ + Việt cùng dạy — <strong>Tiếng Anh từ 8–12&nbsp;tiết/tuần</strong>",
    "📋 Test đầu vào miễn phí — <strong>đánh giá toàn diện học lực</strong>",
    "💸 Early Bird trước 30/4 — <strong>giảm 30% học phí + tặng đồng phục</strong>",
  ]}
  testimonial="Quy trình tuyển sinh rõ ràng, đội tuyển sinh hỗ trợ từng bước. Con vào học 2 tuần là quen ngay môi trường!"
  testimonialAuthor="— Chị Thanh Hà, Q.Gò Vấp · Phụ huynh học sinh Tiểu Học"
  cardUrgency="⏰ Học bổng Early Bird · Đăng ký trước 30/4/2026"
  cardTitle="Đăng ký tuyển sinh Mầm Non tại Cần Giuộc"
  ctaStep2="📋 GỬI ĐĂNG KÝ TUYỂN SINH →"
  source="tuyen-sinh-mam-non-can-giuoc"
  funnelCode="tuyen-sinh-mam-non-can-giuoc"
  schoolLevel="mam-non"
  formMode="tuoi"
  extended>
  <USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} />
  <TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} />
  <FAQSection title="Câu hỏi thường gặp" items={faqItems} />
</DarkLPLayout>
