---
/**
 * BÁO CÁO ĐÁNH GIÁ KỸ NĂNG HÈ 2026
 * Wide layout, CTA above-the-fold, benefits on hero.
 */
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Báo Cáo Đánh Giá Kỹ Năng Hè 2026 | Lion Camp — Trường Việt Anh</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese');</style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>

  <style is:inline>:root{--p:#26275D;--p2:#363876;--acc:#f9dd0e;--gold:#F59E0B;--grn:#16A34A;--red:#EF4444;--f:'Open Sans',sans-serif;--fh:'Montserrat',sans-serif}*{margin:0;padding:0;box-sizing:border-box}body{font-family:var(--f);-webkit-font-smoothing:antialiased;color:#1C2A3A;background:#EAEFF5;min-height:100vh}.wrap{max-width:1120px;margin:0 auto;padding:8px 12px 16px}/* === HEADER: logo sát trên, title to === */
    .hdr{text-align:center;padding:10px 24px 14px;background:#fff;border-radius:16px 16px 0 0;border-bottom:3px solid var(--p)}.hdr img{max-width:240px;height:auto;margin-bottom:6px;display:block;margin-left:auto;margin-right:auto}.hdr h1{font-family:var(--fh);font-size:2rem;font-weight:900;color:var(--p);letter-spacing:.02em;line-height:1.1}.hdr .sub{font-size:1rem;color:#555;margin-top:6px;font-weight:500}/* === CARD === */
    .card{background:#fff;box-shadow:0 4px 24px rgba(0,0,0,.06);overflow:hidden}/* === HERO SCORE + CTA — above the fold === */
    .hero{display:grid;grid-template-columns:300px 1fr;border-bottom:1px solid #F0F0F0}.score-left{padding:28px 28px;text-align:center;background:linear-gradient(180deg,#F8FAFC,#EEF2F7);border-right:1px solid #F0F0F0;display:flex;flex-direction:column;justify-content:center}.score-num{font-family:var(--fh);font-size:4rem;font-weight:900;line-height:1}.score-max{font-size:1rem;color:#777;margin-top:2px;font-weight:600}.score-bar{height:10px;background:#E5E7EB;border-radius:5px;margin:14px 0 10px;overflow:hidden}.score-fill{height:100%;border-radius:5px;transition:width 1.5s ease;width:0}.score-badge{display:inline-block;padding:6px 18px;border-radius:50px;font-family:var(--fh);font-weight:700;font-size:1rem;color:#fff}.hero-right{padding:22px 28px;display:flex;flex-direction:column;justify-content:center;gap:14px}.hero-right h2{font-family:var(--fh);font-size:1.5rem;font-weight:800;color:var(--p);line-height:1.25}.hero-right .hero-desc{font-size:1rem;color:#444;line-height:1.55}/* Benefits list — rõ ràng, chữ to */
    .benefits{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin:4px 0}.benefit{display:flex;align-items:center;gap:8px;font-size:1rem;font-weight:600;color:#1C2A3A}.benefit .bi{font-size:1.1rem;flex-shrink:0}/* Hero CTA — màu hấp dẫn, above the fold */
    .hero-cta-wrap{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:4px}.hero-cta{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:12px;font-family:var(--fh);font-weight:800;font-size:1.02rem;text-decoration:none;color:#fff;background:linear-gradient(135deg,#f9dd0e,#F59E0B);box-shadow:0 4px 18px rgba(249, 221, 14,.45);transition:all .2s;animation:pulse 2.5s infinite}.hero-cta:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(249, 221, 14,.65)}.hero-call{display:inline-flex;align-items:center;gap:6px;padding:13px 22px;border-radius:12px;font-family:var(--fh);font-weight:700;font-size:1rem;text-decoration:none;color:var(--p);background:#fff;border:2px solid var(--p);transition:all .2s}.hero-call:hover{background:var(--p);color:#fff}/* === SKILLS — 3-col grid === */
    .sec-hdr{padding:16px 28px 10px;font-family:var(--fh);font-size:1rem;font-weight:800;color:var(--p);border-bottom:1px solid #F0F0F0;display:flex;align-items:center;gap:8px}.skills{display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid #F0F0F0}.skill{padding:14px 18px;display:flex;align-items:center;gap:10px;border-bottom:1px solid #F8F8F8;border-right:1px solid #F8F8F8}.skill:nth-child(3n){border-right:none}.skill-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}.skill-info{flex:1;min-width:0}.skill-name{font-size:1rem;font-weight:600;color:#374151;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.skill-bar{height:6px;background:#E5E7EB;border-radius:3px;overflow:hidden}.skill-bar-fill{height:100%;border-radius:3px;transition:width 1s ease}.skill-val{font-family:var(--fh);font-weight:800;font-size:1rem;min-width:32px;text-align:right}/* === INSIGHTS === */
    .insights{padding:18px 28px 22px;background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border-bottom:1px solid #F0F0F0}.insights h3{font-family:var(--fh);font-size:1.5rem;font-weight:800;color:var(--acc);margin-bottom:12px}.ins-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}.ins-card{background:#fff;border-radius:10px;padding:14px;border-left:3px solid var(--red)}.ins-card h4{font-family:var(--fh);font-size:1.5rem;font-weight:700;color:#991B1B;margin-bottom:4px}.ins-card p{font-size:1rem;color:#555;line-height:1.5}.ins-card--good{border-left-color:var(--grn)}.ins-card--good h4{color:#166534}/* === FINAL CTA === */
    .cta{padding:26px 28px;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;text-align:center;border-radius:0 0 16px 16px}.cta h3{font-family:var(--fh);font-size:1.5rem;font-weight:800;margin-bottom:6px}.cta .cta-sub{font-size:1rem;opacity:.9;margin-bottom:18px;max-width:640px;margin-left:auto;margin-right:auto}.cta-main{display:inline-flex;align-items:center;gap:8px;padding:18px 44px;border-radius:14px;font-family:var(--fh);font-weight:800;font-size:1.15rem;text-decoration:none;color:#fff;background:linear-gradient(135deg,var(--acc),var(--gold));box-shadow:0 4px 20px rgba(249, 221, 14,.4);transition:all .2s;animation:pulse 2.5s infinite}.cta-main:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(249, 221, 14,.6)}
    @keyframes pulse{0%,100%{box-shadow:0 4px 20px rgba(249, 221, 14,.4)}50%{box-shadow:0 4px 32px rgba(249, 221, 14,.7),0 0 48px rgba(245,158,11,.2)}}.cta-note{margin-top:14px;font-size:1rem;opacity:.9}.cta-note a{color:#fff;font-weight:700;text-decoration:underline}.footer{text-align:center;padding:12px;font-size:1rem;color:#999}

    @media(max-width:760px){.wrap{padding:6px}.hdr{padding:10px 16px 12px}.hdr h1{font-size:1.4rem}.hdr img{max-width:180px}.hero{grid-template-columns:1fr}.score-left{border-right:none;border-bottom:1px solid #F0F0F0;padding:20px}.hero-right{padding:18px 20px}.hero-right h2{font-size:1.15rem}.benefits{grid-template-columns:1fr}.hero-cta-wrap{flex-direction:column;align-items:stretch}.hero-cta,.hero-call{width:100%;justify-content:center}.sec-hdr{padding:12px 16px 8px}.skills{grid-template-columns:1fr 1fr}.skill:nth-child(2n){border-right:none}.skill:nth-child(3n){border-right:1px solid #F8F8F8}.insights{padding:14px 16px}.ins-grid{grid-template-columns:1fr}.cta{padding:22px 16px}.cta-main{width:100%;justify-content:center;padding:16px 24px}
    }
    @media print{.cta,.hero-cta,.hero-call,.footer{display:none}.card{box-shadow:none;border:1px solid #ddd}.wrap{max-width:100%;padding:0}}
  </style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="wrap">
  <!-- HEADER — logo sát trên, title to -->
  <div class="hdr">
    <img src="/logo-vietanh.png" alt="Trường TH - THCS - THPT Việt Anh" />
    <h1>BÁO CÁO ĐÁNH GIÁ KỸ NĂNG HÈ 2026</h1>
    <div class="sub" id="hdrSub">Lion Camp — Trường Việt Anh</div>
  </div>

  <div class="card">
    <!-- HERO — SCORE + BENEFITS + CTA (above the fold) -->
    <div class="hero">
      <div class="score-left">
        <div class="score-num" id="scoreNum">--</div>
        <div class="score-max">/ 100 điểm</div>
        <div class="score-bar"><div class="score-fill" id="scoreFill"></div></div>
        <span class="score-badge" id="scoreBadge">--</span>
      </div>
      <div class="hero-right">
        <h2 id="resultTitle">Đang phân tích...</h2>
        <p class="hero-desc" id="resultDesc"></p>

        <div class="benefits">
          <div class="benefit"><span class="bi">🎯</span> Phân tích chuyên sâu 6 kỹ năng</div>
          <div class="benefit"><span class="bi">🗺️</span> Lộ trình cá nhân hóa cho con</div>
          <div class="benefit"><span class="bi">🎁</span> Học bổng Early Bird đến 30%</div>
          <div class="benefit"><span class="bi">⚡</span> Ưu tiên giữ chỗ Lion Camp 2026</div>
        </div>

        <div class="hero-cta-wrap">
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="hero-cta" id="heroZalo">
            💬 Nhận tư vấn cá nhân hóa lộ trình học tập qua Zalo
          </a>
          <a href="tel:+84916961409" class="hero-call">
            📞 Gọi 0916 961 409
          </a>
        </div>
      </div>
    </div>

    <!-- SKILLS — 3-col -->
    <div class="sec-hdr">📊 Chi tiết từng kỹ năng</div>
    <div class="skills" id="skillsGrid"></div>

    <!-- INSIGHTS -->
    <div class="insights">
      <h3>🔍 Phân tích & Khuyến nghị</h3>
      <div class="ins-grid" id="insightCards"></div>
    </div>
  </div>

  <!-- FINAL CTA -->
  <div class="cta">
    <h3>Sẵn sàng đồng hành cùng con phát triển toàn diện?</h3>
    <p class="cta-sub">Tư vấn viên Lion Camp sẽ phân tích chi tiết kết quả, đề xuất lộ trình và hỗ trợ đăng ký học bổng Early Bird đến 30% cho con.</p>
    <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="cta-main" id="ctaZalo">
      💬 Nhận tư vấn cá nhân hóa lộ trình học tập qua Zalo
    </a>
    <div class="cta-note">Hoặc gọi hotline <a href="tel:+84916961409">0916 961 409</a> — phản hồi trong 24 giờ làm việc</div>
  </div>

  <div class="footer">
    Báo cáo được tạo tự động bởi hệ thống Lion Camp — Trường Việt Anh.<br>
    Thông tin được bảo mật và chỉ dùng cho mục đích tư vấn giáo dục.
  </div>
</div>

<script is:inline>
(function(){
  var p = new URLSearchParams(window.location.search);
  var name = p.get('name') || '';
  var score = parseInt(p.get('score'),10) || 0;
  var school = p.get('school') || 'tieu-hoc';
  var loc = p.get('loc') || '';
  var q = [1,2,3,4,5,6].map(function(i){ return parseInt(p.get('q'+i),10) || 0; });

  var levelMap = {'tieu-hoc':'Tiểu học','thcs':'THCS','thpt':'THPT'};
  var schoolLabel = levelMap[school] || 'Tiểu học';

  var QUESTIONS = {
    'tieu-hoc': [
      {name:'Tự giác & kỷ luật', icon:'🎯', act:'Chương trình Lãnh đạo Bản thân'},
      {name:'Tự tin giao tiếp', icon:'💬', act:'Vòng tròn tự tin — nói trước nhóm mỗi ngày'},
      {name:'Tiếng Anh', icon:'🇬🇧', act:'Lớp Oxford với giáo viên bản ngữ'},
      {name:'Quản lý màn hình', icon:'📱', act:'Hoạt động thể chất thay thế điện thoại'},
      {name:'Giải quyết vấn đề', icon:'🧩', act:'Problem Solving Lab'},
      {name:'Hoạt động nhóm', icon:'🤝', act:'Team Building + trải nghiệm mỗi tuần'}
    ],
    'thcs': [
      {name:'Kiểm soát cảm xúc', icon:'❤️', act:'Workshop EQ tuổi dậy thì'},
      {name:'Giao tiếp gia đình', icon:'👨‍👩‍👧', act:'Dự án Gia đình — mở lòng chia sẻ'},
      {name:'Tiếng Anh thực chiến', icon:'🇬🇧', act:'English Debate Club'},
      {name:'Quản lý game/MXH', icon:'🎮', act:'Digital Detox + dự án AI cơ bản'},
      {name:'Làm việc nhóm', icon:'🤝', act:'Dự án nhóm — dẫn dắt & hợp tác'},
      {name:'Quản lý thời gian', icon:'⏰', act:'Planner cá nhân mỗi ngày'}
    ],
    'thpt': [
      {name:'Thuyết trình TA', icon:'🎤', act:'IELTS Speaking + Public Speaking'},
      {name:'Hướng nghiệp', icon:'🎯', act:'Workshop Hướng nghiệp + mentor 1:1'},
      {name:'Công nghệ & AI', icon:'🤖', act:'Dự án AI nâng cao'},
      {name:'Quản lý áp lực', icon:'🧠', act:'Mindfulness & quản lý stress'},
      {name:'Ngoại khóa', icon:'⚡', act:'CLB Lãnh đạo Trẻ'},
      {name:'Tự học', icon:'📚', act:'Study Planner & nhóm học tập'}
    ]
  };
  var questions = QUESTIONS[school] || QUESTIONS['tieu-hoc'];

  document.getElementById('hdrSub').textContent = 'Lion Camp ' + schoolLabel + ' ' + loc + (name ? ' — Dành cho ' + name : '');

  // score param is already on /100 scale
  var color = score >= 75 ? '#16A34A' : score >= 50 ? '#F59E0B' : '#EF4444';
  var levelText = score >= 75 ? 'Nền tảng tốt' : score >= 50 ? 'Cần hỗ trợ' : 'Cần can thiệp';
  document.getElementById('scoreNum').textContent = score;
  document.getElementById('scoreNum').style.color = color;
  var badge = document.getElementById('scoreBadge');
  badge.textContent = levelText; badge.style.background = color;
  setTimeout(function(){ var f=document.getElementById('scoreFill'); f.style.width=score+'%'; f.style.background=color; }, 300);

  var tier = score >= 75 ? 'high' : score >= 50 ? 'mid' : 'low';
  var titles = {high:'Con đã có nền tảng tốt!', mid:'Con cần được hỗ trợ đúng lúc', low:'Thời điểm vàng để can thiệp!'};
  var descs = {high:'Lion Camp sẽ giúp con tỏa sáng — phát triển kỹ năng lãnh đạo vượt trội trong 6 tuần hè.', mid:'6 tuần đúng phương pháp, con sẽ tiến bộ rõ rệt. Hành động ngay để không bỏ lỡ cơ hội.', low:'Nếu không can thiệp ngay, con có thể tụt hậu xa hơn bạn bè. Hãy hành động sớm.'};
  document.getElementById('resultTitle').textContent = titles[tier];
  document.getElementById('resultTitle').style.color = color;
  document.getElementById('resultDesc').textContent = descs[tier];

  var grid = document.getElementById('skillsGrid');
  questions.forEach(function(qn,i){
    var s = q[i]||0;
    var sc = s>=4?'#16A34A':s>=3?'#F59E0B':'#EF4444';
    var w = Math.round((s/4)*100);
    var bg = s>=4?'rgba(22,163,106,.1)':s>=3?'rgba(245,158,11,.1)':'rgba(239,68,68,.1)';
    grid.innerHTML += '<div class="skill"><div class="skill-icon" style="background:'+bg+'">'+qn.icon+'</div><div class="skill-info"><div class="skill-name">'+qn.name+'</div><div class="skill-bar"><div class="skill-bar-fill" style="width:'+w+'%;background:'+sc+'"></div></div></div><div class="skill-val" style="color:'+sc+'">'+s+'/4</div></div>';
  });

  var sorted = q.map(function(s,i){return{score:s,idx:i}}).sort(function(a,b){return a.score-b.score});
  var cards = document.getElementById('insightCards');
  sorted.slice(0,2).forEach(function(w){
    var qn = questions[w.idx];
    cards.innerHTML += '<div class="ins-card"><h4>⚠️ '+qn.name+' ('+w.score+'/4)</h4><p>'+qn.act+'</p></div>';
  });
  var best = sorted[sorted.length-1];
  if(best){
    var bq = questions[best.idx];
    cards.innerHTML += '<div class="ins-card ins-card--good"><h4>💪 '+bq.name+' ('+best.score+'/4)</h4><p>'+bq.act+'</p></div>';
  }

  var msg = 'Chào thầy/cô, tôi vừa nhận kết quả đánh giá Lion Camp'+(loc?' '+loc:'')+(name?' cho con ('+name+')':'')+' ('+score+'/100 điểm). Tôi muốn được tư vấn ạ.';
  var zaloUrl = 'https://zalo.me/1678310120468101523?text='+encodeURIComponent(msg);
  document.getElementById('heroZalo').href = zaloUrl;
  document.getElementById('ctaZalo').href = zaloUrl;

  if(window.dataLayer) window.dataLayer.push({event:'report_viewed',quiz_score:score,school_level:school,location:loc});
})();
</script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
