---
import BaseLayout from '../layouts/BaseLayout.astro';
import { schoolFacts } from '../data/school-facts';
import { giaoVienChuNhiem, giaoVienBoMon, giaoVienBanNgu, hienThi } from '../data/doi-ngu-giao-vien';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import { banLanhDao, banLanhDaoSchema, phongBan } from '../data/ban-lanh-dao-phong-ban';

const tabs = [
  { id: 'ban-lanh-dao', label: 'Ban Lãnh Đạo', icon: '🏛️' },
  { id: 'chu-nhiem', label: 'Giáo viên Chủ Nhiệm', icon: '👩‍🏫' },
  { id: 'bo-mon', label: 'Giáo viên Bộ Môn', icon: '📚' },
  { id: 'ban-ngu', label: 'Giáo viên Bản Ngữ', icon: '🌍' },
  { id: 'tu-van', label: 'Đội Ngũ Tư Vấn (SO)', icon: '💬' },
  ...phongBan.map((p) => ({ id: p.id, label: p.tab, icon: p.icon })),
];

const tuVan = [
  {
    name: 'Dương Thuý Loan',
    role: 'Tư vấn tuyển sinh',
    photo: '/duong-thuy-loan.jpg',
    mission: 'Sứ mệnh của tôi là sống trọn vẹn, có trách nhiệm và tạo ra những ký ức hạnh phúc cho gia đình và mọi người xung quanh.',
  },
  {
    name: 'Lê Thị Hoàng Yến',
    role: 'Tư vấn tuyển sinh',
    photo: '/le-thi-hoang-yen.jpg',
    mission: 'Mỗi cuộc gặp gỡ là một cơ hội để lắng nghe, kết nối và tạo ra giá trị. Tôi chọn trở thành cầu nối tin cậy để mỗi hành trình học tập được bắt đầu bằng sự an tâm, đồng hành và niềm tin.',
  },
  {
    name: 'Nguyễn Thuỵ Ngọc Thanh',
    role: 'Tư vấn tuyển sinh',
    photo: '/nguyen-thuy-ngoc-thanh.jpg',
    mission: 'Sứ mệnh của tôi là đồng hành cùng mỗi gia đình bằng sự chân thành, thấu hiểu và tận tâm, giúp phụ huynh tìm được môi trường giáo dục phù hợp để mỗi học sinh được phát triển đúng tiềm năng của mình.',
  },
  {
    name: 'Nguyễn Thị Bé Linh',
    role: 'Tư vấn tuyển sinh',
    photo: '/nguyen-thi-be-linh.jpg',
    mission: 'Sứ mệnh của tôi là trở thành người biết rõ chính mình, luôn mang năng lượng tích cực và chia sẻ niềm vui đến tất cả mọi người.',
  },
  {
    name: 'Nguyễn Thị Kim Chi',
    role: 'Tư vấn tuyển sinh',
    photo: '/nguyen-thi-kim-chi.jpg',
    mission: 'Với gia đình, tôi lấy chữ hiếu làm đầu. Với công việc, tôi giữ đạo đức và cố gắng hết mình, không chấp nhận gian dối làm tổn hại quyền lợi khách hàng. Với bản thân, tôi lấy chữ Nhẫn và chữ Thấu hiểu làm kim chỉ nam.',
  },
  {
    name: 'Nguyễn Thị Ly',
    role: 'Tư vấn tuyển sinh',
    photo: '/nguyen-thi-ly.jpg',
    mission: 'Tôi chọn yêu thương để dẫn đường, trung thực để hành động và dũng cảm để đối diện với mọi khó khăn, để lan tỏa những giá trị tốt đẹp và góp phần xây dựng một cộng đồng chân thành, nhân ái hơn.',
  },
  {
    name: 'Nguyễn Thị Minh Thu',
    role: 'Tư vấn tuyển sinh',
    photo: '/nguyen-thi-minh-thu.jpg',
    mission: 'Tôi đặt sự chân thành vào công việc, giữ tôn trọng và tự trọng trong ứng xử, để bất kỳ ai khi kết nối với tôi đều cảm thấy được lắng nghe, thấu hiểu và nhận đúng giá trị.',
  },
  {
    name: 'Trà Thị Lộc',
    role: 'Tư vấn tuyển sinh',
    photo: '/tra-thi-loc.jpg',
    mission: 'Lắng nghe để thấu hiểu – Phục vụ bằng tận tâm – Đồng hành vì sự phát triển của học sinh.',
  },
  {
    name: 'Võ Thị Xuân Yến',
    role: 'Tư vấn tuyển sinh',
    photo: '/vo-thi-xuan-yen.jpg',
    mission: 'Sứ mệnh của tôi là không ngừng học hỏi và lan tỏa những giá trị tử tế cùng tư duy tích cực đến mọi người xung quanh.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com' },
    { '@type': 'ListItem', position: 2, name: 'Giới thiệu', item: 'https://truongvietanh.com/gioi-thieu' },
    { '@type': 'ListItem', position: 3, name: 'Ban lãnh đạo & đội ngũ', item: 'https://truongvietanh.com/giao-vien' },
  ],
};

const structuredData = [
  breadcrumbLd,
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Ban Lãnh Đạo & đội ngũ – Trường Việt Anh',
    url: 'https://truongvietanh.com/giao-vien',
    mainEntity: {
      '@type': 'EducationalOrganization',
      name: 'Trường Việt Anh',
      employee: banLanhDaoSchema.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.jobTitle })),
    },
  },
];

function initials(name: string): string {
  const parts = name.replace(/^(Cô|Thầy|Mr\.|Ms\.|Mrs\.)\s*/i, '').split(/\s+/);
  return parts.slice(-2).map(p => p[0]).join('').toUpperCase();
}
---

<BaseLayout
  title="Ban Lãnh Đạo & Đội Ngũ – Trường Việt Anh"
  description="Ban lãnh đạo, giáo viên (chủ nhiệm, bộ môn, bản ngữ), đội ngũ tư vấn và các phòng ban của Trường Việt Anh."
  canonical="https://truongvietanh.com/giao-vien"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  structuredData={structuredData}
>
  <div class="gv-page">
    <HeaderBase />

    <!-- HERO -->
    <section class="gv-hero">
      <div class="gv-container">
        <nav class="gv-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <span aria-hidden="true">/</span>
          <a href="/gioi-thieu">Giới thiệu</a>
          <span aria-hidden="true">/</span>
          <span>Ban lãnh đạo & đội ngũ</span>
        </nav>
        <h1 class="gv-h1">Ban lãnh đạo & đội ngũ</h1>
        <p class="gv-sub">Ban lãnh đạo, đội ngũ giáo viên, đội ngũ tư vấn và các phòng ban — đồng hành cùng con suốt hành trình học tập.</p>
        <div class="gv-stats">
          <div class="gv-stat"><strong>{schoolFacts.yearsRunning}</strong><span>Năm kinh nghiệm</span></div>
          <div class="gv-stat"><strong>{schoolFacts.campuses}</strong><span>Cơ sở chính thức</span></div>
        </div>
      </div>
    </section>

    <!-- TABS -->
    <section class="gv-tabs-section">
      <div class="gv-tabs-bar">
        <div class="gv-container">
          <div class="gv-tabs" role="tablist" aria-label="Danh mục giáo viên">
            {tabs.map((tab, idx) => (
              <button
                class={`gv-tab ${idx === 0 ? 'is-active' : ''}`}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`panel-${tab.id}`}
                id={`tab-${tab.id}`}
                data-tab={tab.id}
                type="button"
              >
                <span class="gv-tab__icon">{tab.icon}</span>
                <span class="gv-tab__label">{tab.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="gv-container gv-panels-wrap">

        <!-- Panel 0: Ban Lãnh Đạo (gộp từ trang /ban-lanh-dao cũ, 09/11/2026) -->
        <div class="gv-panel is-active" id="panel-ban-lanh-dao" role="tabpanel" aria-labelledby="tab-ban-lanh-dao">
          <p class="gv-panel__intro">Đội ngũ lãnh đạo giàu kinh nghiệm, tâm huyết với sứ mệnh xây dựng nền giáo dục vừa nhân văn vừa hiệu quả cho thế hệ trẻ Việt Nam.</p>
          <div class="gv-grid gv-grid--tv">
            {banLanhDao.map(m => (
              <article class="gv-tvcard">
                <div class="gv-tvcard__photo">
                  {m.photo
                    ? <img src={m.photo} alt={`Ảnh ${m.name}`} loading="lazy" width="600" height="800" />
                    : <span class="gv-card__initials">{initials(m.name)}</span>
                  }
                </div>
                <div class="gv-tvcard__body">
                  <h3 class="gv-tvcard__name notranslate" translate="no">{m.name}</h3>
                  <p class="gv-tvcard__role">{m.title} · {m.org}</p>
                  <div class="gv-tvcard__text">
                    {m.description && <p class={m.quote ? 'gv-tvcard__quote' : 'gv-tvcard__desc'}>{m.description}</p>}
                    {m.mission && <p class="gv-tvcard__quote">“{m.mission}”</p>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 1: Chủ nhiệm -->
        <div class="gv-panel" id="panel-chu-nhiem" role="tabpanel" aria-labelledby="tab-chu-nhiem" hidden>
          <p class="gv-panel__intro">Giáo viên chủ nhiệm trực tiếp đồng hành cùng lớp — chịu trách nhiệm về kỷ luật, liên lạc phụ huynh và kế hoạch học tập từng học sinh. <strong>Bấm vào thẻ để đọc tuyên ngôn sứ mệnh</strong> của thầy cô.</p>
          <div class="gv-grid gv-grid--tv">
            {hienThi(giaoVienChuNhiem).map(t => (
              <article class={`gv-card gv-card--to ${t.mission ? '' : 'gv-card--bn'}`}>
                <div class="gv-card__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="600" height="800" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name notranslate" translate="no">{t.name}</h3>
                  <p class="gv-card__role">{t.role}{t.coSo ? ` · ${t.coSo}` : ''}</p>
                  {t.trinhDo && <p class="gv-card__trinhdo">{t.trinhDo}</p>}
                </div>
                {t.mission && (
                  <>
                    <button type="button" class="gv-card__nut" aria-haspopup="dialog">
                      <span class="gv-sr">Xem tuyên ngôn sứ mệnh của {t.name}</span>
                    </button>
                    {/* Chữ nằm sẵn trong HTML để bot đọc được; chỉ bị CSS che, popup lấy lại từ đây */}
                    <p class="gv-card__mission">{t.mission}</p>
                  </>
                )}
              </article>
            ))}
          </div>
        </div>

        <!-- Panel 2: Bộ môn -->
        <div class="gv-panel" id="panel-bo-mon" role="tabpanel" aria-labelledby="tab-bo-mon" hidden>
          <p class="gv-panel__intro">Giáo viên bộ môn và các vị trí chuyên môn khác — tổ trưởng chuyên môn, quản nhiệm, giáo vụ, tâm lý học đường. <strong>Bấm vào thẻ để đọc tuyên ngôn sứ mệnh</strong> của thầy cô.</p>
          <div class="gv-grid gv-grid--tv">
            {hienThi(giaoVienBoMon).map(t => (
              <article class={`gv-card gv-card--to ${t.mission ? '' : 'gv-card--bn'}`}>
                <div class="gv-card__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="600" height="800" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name notranslate" translate="no">{t.name}</h3>
                  <p class="gv-card__role">{t.role}{t.coSo ? ` · ${t.coSo}` : ''}</p>
                  {t.trinhDo && <p class="gv-card__trinhdo">{t.trinhDo}</p>}
                </div>
                {t.mission && (
                  <>
                    <button type="button" class="gv-card__nut" aria-haspopup="dialog">
                      <span class="gv-sr">Xem tuyên ngôn sứ mệnh của {t.name}</span>
                    </button>
                    {/* Chữ nằm sẵn trong HTML để bot đọc được; chỉ bị CSS che, popup lấy lại từ đây */}
                    <p class="gv-card__mission">{t.mission}</p>
                  </>
                )}
              </article>
            ))}
          </div>
        </div>


        <!-- Panel 3: Bản ngữ -->
        <div class="gv-panel" id="panel-ban-ngu" role="tabpanel" aria-labelledby="tab-ban-ngu" hidden>
          <p class="gv-panel__intro">Giáo viên bản ngữ đang giảng dạy trực tiếp tại các cơ sở Trường Việt Anh.</p>
          <div class="gv-grid gv-grid--tv">
            {giaoVienBanNgu.filter(t => t.photo).map(t => (
              <article class="gv-card gv-card--to gv-card--bn">
                <div class="gv-card__photo">
                  <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="600" height="800" />
                </div>
                <div class="gv-card__body">
                  <h3 class="gv-card__name notranslate" translate="no">{t.name}</h3>
                  <p class="gv-card__role">{t.role}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="gv-panel" id="panel-tu-van" role="tabpanel" aria-labelledby="tab-tu-van" hidden>
          <p class="gv-panel__intro">Đội ngũ tư vấn tuyển sinh và giáo viên tư vấn học tập — hỗ trợ phụ huynh tìm hiểu về chương trình, lộ trình học và đăng ký nhập học tại tất cả cơ sở.</p>
          <div class="gv-grid gv-grid--tv">
            {tuVan.map(t => (
              <article class="gv-tvcard">
                <div class="gv-tvcard__photo">
                  {t.photo
                    ? <img src={t.photo} alt={`Ảnh ${t.name}`} loading="lazy" width="600" height="800" />
                    : <span class="gv-card__initials">{initials(t.name)}</span>
                  }
                </div>
                <div class="gv-tvcard__body">
                  <h3 class="gv-tvcard__name notranslate" translate="no">{t.name}</h3>
                  <p class="gv-tvcard__role">{t.role}</p>
                  {t.mission && (
                    <div class="gv-tvcard__text">
                      <p class="gv-tvcard__quote">“{t.mission}”</p>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <!-- Panels các phòng ban (09/11/2026): khung để sẵn, bổ sung ảnh và thông tin sau — dữ liệu ở src/data/ban-lanh-dao-phong-ban.ts -->
        {phongBan.map((pb) => (
          <div class="gv-panel" id={`panel-${pb.id}`} role="tabpanel" aria-labelledby={`tab-${pb.id}`} hidden>
            <p class="gv-panel__intro">{pb.moTa}</p>
            <div class="gv-grid gv-grid--tv">
              {pb.thanhVien.map((m) => (
                <article class="gv-tvcard">
                  <div class="gv-tvcard__photo">
                    {m.photo
                      ? <img src={m.photo} alt={`Ảnh ${m.name}`} loading="lazy" width="600" height="800" />
                      : <span class="gv-card__initials">{initials(m.name)}</span>
                    }
                  </div>
                  <div class="gv-tvcard__body">
                    <h3 class="gv-tvcard__name notranslate" translate="no">{m.name}</h3>
                    <p class="gv-tvcard__role">{m.title}</p>
                  </div>
                </article>
              ))}
              {Array.from({ length: pb.choTrong }).map(() => (
                <article class="gv-tvcard gv-tvcard--trong" aria-label="Đang cập nhật">
                  <div class="gv-tvcard__photo"><span class="gv-card__initials">+</span></div>
                  <div class="gv-tvcard__body">
                    <h3 class="gv-tvcard__name">Đang cập nhật</h3>
                    <p class="gv-tvcard__role">Sẽ bổ sung thông tin</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

      </div>
    </section>

    <!-- CTA -->
    <section class="gv-cta">
      <div class="gv-container gv-cta__inner">
        <h2 class="gv-cta__h2">Muốn gặp trực tiếp giáo viên phụ trách con?</h2>
        <p class="gv-cta__desc">Đăng ký tham quan trường để gặp ban giám hiệu, GVCN dự kiến và đội ngũ tư vấn. Buổi tham quan miễn phí, kéo dài 60–90 phút.</p>
        <div class="gv-cta__actions">
          <a href="/lien-he" class="gv-btn gv-btn--primary">Đặt lịch tham quan</a>
          <a href="tel:0916961409" class="gv-btn gv-btn--ghost">Gọi 0916 961 409</a>
        </div>
      </div>
    </section>

    <!-- Popup tuyên ngôn sứ mệnh — nội dung lấy từ chính thẻ giáo viên,
         không sinh chữ mới, nên bot vẫn đọc được bản trong HTML -->
    <div class="gv-pop" id="gvPop" role="dialog" aria-modal="true" aria-labelledby="gvPopTen" hidden>
      <div class="gv-pop__nen" data-dong></div>
      <div class="gv-pop__hop" role="document">
        <button type="button" class="gv-pop__dong" data-dong aria-label="Đóng">&times;</button>
        <div class="gv-pop__anh" id="gvPopAnh" aria-hidden="true"></div>
        <h3 class="gv-pop__ten notranslate" translate="no" id="gvPopTen"></h3>
        <p class="gv-pop__role" id="gvPopRole"></p>
        <p class="gv-pop__td" id="gvPopTD"></p>
        <p class="gv-pop__tn" id="gvPopTN"></p>
      </div>
    </div>

    <FooterBase />
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll('.gv-tab');
    const panels = document.querySelectorAll('.gv-panel');

    function ids() {
      return Array.prototype.map.call(tabs, function (t) { return t.getAttribute('data-tab'); });
    }

    // Bat mot tab theo id (vd "tu-van"). tuCuon = true khi mo bang link co hash.
    function activate(target, tuCuon) {
      let found = null;
      tabs.forEach(function (t) {
        const on = t.getAttribute('data-tab') === target;
        if (on) found = t;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (!found) return false;
      panels.forEach(function (p) {
        const match = p.id === 'panel-' + target;
        p.classList.toggle('is-active', match);
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
      if (tuCuon) {
        const wrap = document.querySelector('.gv-tabs-section') || found;
        wrap.scrollIntoView({ block: 'start' });
        // Thanh tab truot ngang tren dien thoai: keo tab dang chon vao tam nhin,
        // block:'nearest' de khong pha vi tri cuon doc vua dat o tren
        found.scrollIntoView({ block: 'nearest', inline: 'center' });
      } else {
        found.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
      return true;
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        const target = tab.getAttribute('data-tab');
        activate(target, false);
        // Ghi vao URL de copy link duoc; replaceState nen nut Back khong bi ket trong cac tab
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', '#' + target);
        }
      });
    });

    // Mo dung tab khi vao bang /giao-vien#tu-van
    function tuHash(tuCuon) {
      const h = (window.location.hash || '').replace('#', '');
      if (h && ids().indexOf(h) !== -1) return activate(h, tuCuon);
      return false;
    }
    tuHash(true);
    window.addEventListener('hashchange', function () { tuHash(true); });

    // ---- Popup tuyên ngôn sứ mệnh của giáo viên ----
    var pop = document.getElementById('gvPop');
    if (pop) {
      var popAnh = document.getElementById('gvPopAnh');
      var popTen = document.getElementById('gvPopTen');
      var popRole = document.getElementById('gvPopRole');
      var popTD = document.getElementById('gvPopTD');
      var popTN = document.getElementById('gvPopTN');
      var nutMo = null;

      function moPop(the, nut) {
        nutMo = nut;
        var anh = the.querySelector('.gv-card__photo img');
        var tat = the.querySelector('.gv-card__initials');
        popAnh.innerHTML = '';
        if (anh) {
          var i = document.createElement('img');
          i.src = anh.getAttribute('src');
          i.alt = '';
          popAnh.appendChild(i);
        } else if (tat) { popAnh.textContent = tat.textContent; }
        popTen.textContent = (the.querySelector('.gv-card__name') || {}).textContent || '';
        popRole.textContent = (the.querySelector('.gv-card__role') || {}).textContent || '';
        if (popTD) popTD.textContent = (the.querySelector('.gv-card__trinhdo') || {}).textContent || '';
        popTN.textContent = (the.querySelector('.gv-card__mission') || {}).textContent || '';
        pop.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        pop.querySelector('.gv-pop__dong').focus();
      }

      function dongPop() {
        pop.setAttribute('hidden', '');
        document.body.style.overflow = '';
        if (nutMo) { nutMo.focus(); nutMo = null; }
      }

      document.querySelectorAll('.gv-card__nut').forEach(function (nut) {
        nut.addEventListener('click', function () { moPop(nut.closest('.gv-card'), nut); });
      });
      pop.querySelectorAll('[data-dong]').forEach(function (x) { x.addEventListener('click', dongPop); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !pop.hasAttribute('hidden')) dongPop();
      });
    }

    // Rut gon tuyen ngon dai o the Tu van
    var khoi = document.querySelectorAll('.gv-tvcard__text');
    if (!khoi.length) return;

    function danhGia(el) {
      // Nguoi dung da tu bam mo thi de yen, dung tu cat lai
      if (el.dataset.daMo === '1') return;
      var nut = el.parentNode.querySelector('.gv-tvcard__more');
      el.classList.add('is-clamped');
      // Chi cat khi tiet kiem duoc tren ~1,5 dong; it hon thi hien du, khoi gan nut vo nghia
      if (el.scrollHeight - el.clientHeight < 34) {
        el.classList.remove('is-clamped');
        if (nut) nut.parentNode.removeChild(nut);
        return;
      }
      if (!nut) {
        nut = document.createElement('button');
        nut.type = 'button';
        nut.className = 'gv-tvcard__more';
        nut.addEventListener('click', function () {
          var dangCat = el.classList.toggle('is-clamped');
          el.dataset.daMo = dangCat ? '0' : '1';
          nut.textContent = dangCat ? 'Xem thêm' : 'Thu gọn';
          nut.setAttribute('aria-expanded', dangCat ? 'false' : 'true');
        });
        el.parentNode.appendChild(nut);
      }
      nut.textContent = 'Xem thêm';
      nut.setAttribute('aria-expanded', 'false');
    }

    function chay() { khoi.forEach(danhGia); }

    // PHAI do SAU khi font web tai xong: do bang font du phong se ra sai so dong,
    // dan toi tuong la khong tran va khong gan nut.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(chay);
    chay();
    window.addEventListener('load', chay);
    // Doi be ngang thi so dong doi theo -> do lai
    var hen;
    window.addEventListener('resize', function () { clearTimeout(hen); hen = setTimeout(chay, 200); });
  })();
</script>

