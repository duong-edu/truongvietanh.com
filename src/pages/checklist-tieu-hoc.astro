<!-- 1. URGENCY BAR -->
<div class="ubar">
  <span class="ubar-dot"></span>
  Nhà trường phản hồi trong 24 giờ làm việc
</div>

<!-- 2. LOGO BAR -->
<div class="lbar">
  <img src="/logo-th-thcs-thpt.png" alt="Trường Việt Anh" />
</div>

<!-- 3. HERO -->
<section class="hero">
  <div class="left">
    <div class="eyebrow">
      <b>Cảnh báo</b>
      Dành cho ba mẹ sắp cho con vào Lớp 1
    </div>

    <h1 class="h1">
      Bạn sắp chọn trường tiểu học — <u><span class="stat">9 trong 10</span> ba mẹ mắc sai lầm</u> này khi đi tham quan trường
    </h1>

    <p class="sub">
      <strong>Checklist 26 tiêu chí + 5 phần đánh giá</strong> giúp bạn so sánh bất kỳ trường nào trong <strong>2 phút</strong> — và không hối hận sau 5 năm tiểu học.
    </p>

    <ul class="blist">
      <li><span class="ck">✓</span><span><b>Câu hỏi buộc phải hỏi</b> ban giám hiệu khi tham quan — mà 90% ba mẹ không biết cần hỏi</span></li>
      <li><span class="ck">✓</span><span><b>Cách tính chi phí THỰC TẾ</b> — trường công "miễn phí" thực ra tốn 1.5–3 triệu/tháng</span></li>
      <li><span class="ck">✓</span><span><b>Bảng so sánh 3 trường</b> — xếp hạng khách quan trên 1 trang, quyết định trong 2 phút</span></li>
      <li><span class="ck">✓</span><span><b>PDF in sẵn 8 trang</b> — mang đi tham quan, đánh dấu tại chỗ, quyết định tại chỗ</span></li>
    </ul>

    <div class="proof">
      <span class="stars">★★★★★</span>
      <strong>2.547 ba mẹ</strong> đã dùng checklist này
      <span class="proof-sep"></span>
      <strong>96%</strong> tự tin hơn khi chọn trường
    </div>

    <div class="directive">
      👇 Nhấn vào nút vàng bên dưới để nhận checklist miễn phí — chỉ mất 10 giây
    </div>

    <div class="cta-block">
      <div class="seats-inline">
        <span class="seats-dot"></span>
        Nhà trường phản hồi trong 24 giờ làm việc
      </div>
      <button class="btn" onclick="openModal()">🎁 Nhận Checklist Miễn Phí — Ngay Bây Giờ</button>
      <div class="micro">🔒 Không spam · Miễn phí hoàn toàn · Hủy bất cứ lúc nào · 2026</div>
    </div>
  </div>

  <div class="right">
    <div class="mscene">
      <div class="m-glow-bg"></div>
      <div class="m-shadow-el"></div>
      <div class="m-ghost-2"></div>
      <div class="m-ghost-1"></div>
      <div class="m-card" onclick="openModal()">
        <div class="m-badge-yr">PDF 2026</div>
        <div class="m-shine"></div>
        <img src="/mockup-checklist-tieu-hoc.png" alt="Checklist Chọn Trường Tiểu Học - Trường Việt Anh" />
      </div>
    </div>

    <div class="m-arrow">
      ↓ Nhấn nút vàng để tải ngay miễn phí
    </div>

  </div>
</section>

<!-- STICKY MOBILE -->
<div class="sticky">
  <button class="btn" onclick="openModal()">🎁 Nhận Checklist Miễn Phí Ngay</button>
</div>

<!-- MODAL POPUP -->
<div class="ov" id="ov">
  <div class="popup">
    <button class="pcl" onclick="closeModal()">✕</button>

    <div class="pprog">
      <div class="pprog-meta">
        <span id="stepLbl">Bước 1 / 2</span>
        <span id="progLbl">50%</span>
      </div>
      <div class="pprog-track"><div class="pprog-fill" id="progFill"></div></div>
    </div>

    <!-- STEP 1 -->
    <div class="ps on" id="step1">
      <div class="p-ico">📧</div>
      <h2 class="p-title">Nhập email — nhận checklist trong 60 giây</h2>
      <p class="p-sub">Chỉ cần email. Không cần điền gì thêm ở bước này.</p>

      <div class="fg">
        <label class="fl" for="em">Địa chỉ Email của bạn</label>
        <input type="email" class="fi" id="em" placeholder="bame@email.com" />
        <div class="fe" id="emErr">Vui lòng nhập email hợp lệ</div>
      </div>

      <button class="pbtn" onclick="nextStep()">Gửi Checklist Vào Email Tôi →</button>
      <div class="psec">🔒 Email an toàn · Không spam · Không chia sẻ bên thứ ba</div>
    </div>

    <!-- STEP 2 -->
    <div class="ps" id="step2">
      <div class="p-ico">🎁</div>
      <h2 class="p-title">Bước cuối — nhận checklist + 3 quà tặng miễn phí</h2>
      <div class="s2-urg"><span class="s2-urg-dot"></span>Điền trong 10 giây · Nhà trường phản hồi trong 24 giờ làm việc</div>

      <div class="vstack">
        <div class="vs-hd">🎁 Bạn sẽ nhận miễn phí hôm nay:</div>
        <div class="vs-row">✅ <span>PDF Checklist 26 tiêu chí</span></div>
        <div class="vs-row">🎯 <span>Tư vấn chọn trường 1:1 với chuyên gia</span></div>
        <div class="vs-row">🎟️ <span>Voucher học thử 1 buổi tại trường</span></div>
        <div class="vs-total">
          <span>Tất cả:</span>
          <span class="vs-total-val">Miễn phí hoàn toàn</span>
        </div>
      </div>

      <div class="fg">
        <label class="fl" for="nm">Họ và tên ba/mẹ</label>
        <input type="text" class="fi" id="nm" placeholder="VD: Nguyễn Thị Lan" />
        <div class="fe" id="nmErr">Vui lòng nhập họ tên của bạn</div>
      </div>
      <div class="fg">
        <label class="fl" for="ph">Số điện thoại / Zalo</label>
        <input type="tel" class="fi" id="ph" placeholder="VD: 091 xxx xxxx" />
        <div class="fe" id="phErr">Vui lòng nhập số điện thoại hợp lệ</div>
      </div>

      <button class="pbtn" onclick="finishStep()">Nhận Tất Cả Ngay — Trong 30 Giây →</button>
      <button class="p-back" onclick="backStep()">← Quay lại bước trước</button>
      <div class="psec">🔒 Bảo mật 100% · Thông tin chỉ dùng để gửi checklist và hỗ trợ tư vấn</div>
    </div>

    <!-- SUCCESS -->
    <div class="psuc" id="success">
      <div class="suc-ico">🎉</div>
      <div class="suc-h">Đăng ký thành công!</div>
      <div class="suc-p">Checklist đang được gửi vào email của bạn.<br />Nhớ kiểm tra <strong>Spam / Promotions</strong> nếu chưa thấy.<br /><br />Chuyên viên sẽ liên hệ bạn trong 1–2 ngày tới qua Zalo.</div>
    </div>
  </div>
</div>

<script src="/js/va-utm.js" is:inline></script>
<script is:inline>
(function(){
  'use strict';

  var C = {
    formId  : 'sq-th',
    funnel  : 'squeeze-checklist-tieu-hoc',
    level   : 'tieu-hoc',
    api     : '/api/lead',
    redirect: '/cam-on/',
  };

  var ov = document.getElementById('ov');
  var capturedEmail = '';

  function noop(){}
  function gtm(ev){
    try{ window.dataLayer = window.dataLayer || []; window.dataLayer.push({event:ev, funnel:C.funnel}); }catch(e){}
  }

  window.openModal = function(){
    ov.classList.add('open');
    document.body.style.overflow = 'hidden';
    gtm('popup_open');
    setTimeout(function(){ var el=document.getElementById('em'); if(el) el.focus(); }, 300);
  };
  window.closeModal = function(){
    ov.classList.remove('open');
    document.body.style.overflow = '';
  };
  ov.addEventListener('click', function(e){ if(e.target===ov) window.closeModal(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') window.closeModal(); });

  function setErr(inpId, errId, show){
    var i=document.getElementById(inpId), e=document.getElementById(errId);
    if(i) i.classList.toggle('err', show);
    if(e) e.classList.toggle('on', show);
  }

  window.nextStep = function(){
    var em = document.getElementById('em');
    var v  = (em.value||'').trim();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)){
      setErr('em','emErr',true); em.focus(); return;
    }
    setErr('em','emErr',false);
    capturedEmail = v;

    /* Partial capture (best-effort) */
    try{
      localStorage.setItem('va_partial_email', capturedEmail);
      fetch(C.api, {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(Object.assign({email:capturedEmail, source:C.funnel, form_id:C.formId, funnel_code:C.funnel, school_level:C.level, partial:true},(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))())),
        keepalive:true
      }).catch(noop);
    }catch(e){}
    gtm('lead_step1');

    document.getElementById('step1').classList.remove('on');
    document.getElementById('step2').classList.add('on');
    document.getElementById('stepLbl').textContent = 'Bước 2 / 2';
    document.getElementById('progLbl').textContent = '100%';
    document.getElementById('progFill').style.width = '100%';
    setTimeout(function(){ var n=document.getElementById('nm'); if(n) n.focus(); }, 80);
  };

  window.backStep = function(){
    document.getElementById('step2').classList.remove('on');
    document.getElementById('step1').classList.add('on');
    document.getElementById('stepLbl').textContent = 'Bước 1 / 2';
    document.getElementById('progLbl').textContent = '50%';
    document.getElementById('progFill').style.width = '50%';
  };

  window.finishStep = function(){
    var nm = document.getElementById('nm');
    var ph = document.getElementById('ph');
    var name  = (nm.value||'').trim();
    var phone = (ph.value||'').trim();
    var ok = true;
    if(name.length < 2){ setErr('nm','nmErr',true); ok=false; } else setErr('nm','nmErr',false);
    if(!/^[0-9+\s\-\.]{9,15}$/.test(phone)){ setErr('ph','phErr',true); ok=false; } else setErr('ph','phErr',false);
    if(!ok) return;

    var btn = document.querySelector('#step2 .pbtn');
    if(btn){ btn.disabled = true; btn.textContent = 'Đang gửi...'; }

    fetch(C.api, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(Object.assign({
        email: capturedEmail,
        parent_name: name,
        phone: phone,
        source: C.funnel,
        form_id: C.formId,
        funnel_code: C.funnel,
        school_level: C.level,
        tags: ['chon-truong-tieu-hoc', 'checklist-tieu-hoc-2026', 'squeeze-tieu-hoc']
      },(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))()))
    })
    .then(function(r){ return r.json().catch(noop); })
    .catch(noop)
    .finally(function(){
      gtm('lead_submitted');
      try{ localStorage.setItem('va_form_submitted','1'); }catch(e){}
      document.getElementById('step2').classList.remove('on');
      document.getElementById('success').classList.add('on');
      document.querySelector('.pprog').style.display = 'none';
      setTimeout(function(){ window.location.href = C.redirect; }, 1800);
    });
  };

  /* Enter-key UX */
  var emEl = document.getElementById('em');
  var phEl = document.getElementById('ph');
  if(emEl) emEl.addEventListener('keydown', function(e){ if(e.key==='Enter') window.nextStep(); });
  if(phEl) phEl.addEventListener('keydown', function(e){ if(e.key==='Enter') window.finishStep(); });
})();
</script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>