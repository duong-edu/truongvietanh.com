    "datePublished": "2026-05-25",
    "dateModified": "2026-05-25",
    "inLanguage": "vi-VN",
    "publisher": {
      "@type": "EducationalOrganization",
      "name": "Hệ Thống Trường Việt Anh",
      "url": "https://truongvietanh.com"
    }
  },
  {
