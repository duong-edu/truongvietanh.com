    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Điều khoản Sử dụng", "item": "https://truongvietanh.com/dieu-khoan-su-dung" }
    ]
  }
];
---

<BaseLayout
  title="Điều khoản Sử dụng Website — Trường Việt Anh"
  description="Điều khoản sử dụng website truongvietanh.com: quyền và nghĩa vụ người dùng, sở hữu trí tuệ, miễn trừ trách nhiệm, luật Việt Nam."
  keywords="điều khoản sử dụng trường việt anh, terms of service, quyền sở hữu trí tuệ website giáo dục"
  canonical="https://truongvietanh.com/dieu-khoan-su-dung"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left" style="flex:1">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true"></span>
            <span>Điều khoản Sử dụng</span>
          </nav>
          <h1 class="gi-h1">Điều khoản Sử dụng Website</h1>
          <p class="gi-subtitle">truongvietanh.com — Hệ thống Trường Việt Anh</p>
          <p class="gi-last-updated">Ngày ban hành: 25/05/2026 &nbsp;·&nbsp; Phiên bản: 1.0</p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>Luật VN</strong> Áp dụng</div>
            <div class="gi-badge"><strong>12 điều</strong> Khoản</div>
            <div class="gi-badge"><strong>60 ngày</strong> Thương lượng trước toà</div>
            <div class="gi-badge"><strong>7 ngày</strong> Gỡ hình ảnh HS</div>
          </div>
        </div>
      </div>
    </section>

    <div class="gi-container gi-body">
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#dinh-nghia">1. Định nghĩa</a></li>
          <li><a href="#mo-ta">2. Mô tả dịch vụ</a></li>
          <li><a href="#quyen-nghia-vu">3. Quyền và nghĩa vụ người dùng</a></li>
          <li><a href="#shtt">4. Sở hữu trí tuệ</a></li>
          <li><a href="#ugc">5. Nội dung do người dùng tạo</a></li>
          <li><a href="#hinh-anh-hs">6. Hình ảnh học sinh</a></li>
          <li><a href="#mien-tru">7. Miễn trừ trách nhiệm</a></li>
          <li><a href="#gioi-han">8. Giới hạn trách nhiệm</a></li>
          <li><a href="#dinh-chi">9. Đình chỉ và chấm dứt</a></li>
          <li><a href="#luat">10. Luật áp dụng và tranh chấp</a></li>
          <li><a href="#sua-doi">11. Sửa đổi điều khoản</a></li>
          <li><a href="#chung">12. Điều khoản chung</a></li>
        </ol>
        <a href="/khieu-nai" class="gi-toc-cta">Khiếu nại</a>
      </nav>

      <article class="gi-main">
        <p class="gi-lead">Khi truy cập và sử dụng website <strong>truongvietanh.com</strong> (sau đây gọi là "Website"), quý vị đồng ý ràng buộc bởi các Điều khoản dưới đây. Nếu không đồng ý với bất kỳ nội dung nào, vui lòng ngừng sử dụng Website.</p>

        <section id="dinh-nghia" class="gi-section">
          <h2>1. Định nghĩa</h2>
          <ul>
            <li><strong>"Trường"</strong> hoặc <strong>"chúng tôi"</strong>: Hệ thống Trường Việt Anh, pháp nhân sở hữu Website là <a href="https://truongvietanh.com">https://truongvietanh.com</a>.</li>
            <li><strong>"Người dùng"</strong> hoặc <strong>"quý vị"</strong>: cá nhân hoặc tổ chức truy cập và sử dụng Website.</li>
            <li><strong>"Nội dung"</strong>: tất cả bài viết, hình ảnh, video, logo, slogan, tài liệu và các thông tin khác đăng trên Website.</li>
          </ul>
        </section>

        <section id="mo-ta" class="gi-section">
          <h2>2. Mô tả dịch vụ</h2>
          <p>Website là kênh thông tin và truyền thông của Hệ thống Trường Việt Anh, cung cấp giới thiệu về trường, chương trình giáo dục, bài viết tư vấn cho phụ huynh, và các form đăng ký tư vấn tuyển sinh.</p>
          <p><strong>Website không phải là hợp đồng nhập học.</strong> Mọi cam kết tuyển sinh, học phí và quyền lợi học sinh chỉ có hiệu lực thông qua hợp đồng nhập học bằng văn bản ký giữa phụ huynh và Trường.</p>
        </section>

        <section id="quyen-nghia-vu" class="gi-section">
          <h2>3. Quyền và nghĩa vụ của người dùng</h2>
          <h3>Quý vị được phép:</h3>
          <ul>
            <li>Đọc, nghiên cứu và chia sẻ đường dẫn (link) bài viết với mục đích phi thương mại.</li>
            <li>Để lại thông tin liên hệ qua các form chính thức để nhận tư vấn.</li>
            <li>Bình luận và trao đổi văn minh trên các bài viết (nếu chức năng bình luận được kích hoạt).</li>
          </ul>
          <h3>Quý vị có nghĩa vụ:</h3>
          <ul>
            <li>Cung cấp thông tin trung thực, chính xác khi điền form.</li>
            <li>Không mạo danh người khác, không sử dụng thông tin của người khác khi chưa được uỷ quyền.</li>
            <li>Tự bảo mật tài khoản và mật khẩu (nếu Website có chức năng đăng nhập).</li>
          </ul>
          <h3>Quý vị không được phép:</h3>
          <ul>
            <li>Sao chép, sao chụp, phát tán Nội dung dưới mọi hình thức cho mục đích thương mại khi chưa có văn bản đồng ý của Trường.</li>
            <li>Tấn công, can thiệp, khai thác lỗ hổng hoặc gây quá tải hệ thống dưới mọi hình thức.</li>
            <li>Đăng tải nội dung vi phạm pháp luật, xúc phạm danh dự, nhân phẩm, đặc biệt là nội dung liên quan trẻ em.</li>
            <li>Sử dụng Website để spam, phát tán mã độc, lừa đảo hoặc thực hiện hành vi vi phạm pháp luật khác.</li>
          </ul>
        </section>

        <section id="shtt" class="gi-section">
          <h2>4. Quyền sở hữu trí tuệ</h2>
          <p>Toàn bộ Nội dung trên Website, bao gồm nhưng không giới hạn: bài viết, hình ảnh, video, logo "Việt Anh", logo các cơ sở thành viên (MGIS, Nhân Lễ, Thái Sơn…), bộ nhận diện thương hiệu, mã nguồn website — đều thuộc quyền sở hữu của Trường Việt Anh hoặc bên cấp phép hợp pháp, được bảo hộ theo Luật Sở hữu trí tuệ Việt Nam.</p>
          <p>Quý vị được phép trích dẫn ngắn (<strong>không quá 200 từ</strong>) cho mục đích phi thương mại với điều kiện dẫn nguồn rõ ràng và đặt link về bài gốc. Việc trích dẫn không được làm thay đổi bản chất nội dung và không được sử dụng để tạo ra một sản phẩm/dịch vụ có tính chất cạnh tranh trực tiếp, bất kể độ dài trích dẫn. Mọi sử dụng khác phải có văn bản đồng ý của Trường.</p>
        </section>

        <section id="ugc" class="gi-section">
          <h2>5. Nội dung do người dùng tạo (bình luận, đánh giá)</h2>
          <p>Khi quý vị đăng bình luận, đánh giá hoặc bất kỳ nội dung nào lên Website, quý vị cấp cho Trường quyền sử dụng <strong>không độc quyền, miễn phí bản quyền, không giới hạn thời gian và phạm vi lãnh thổ</strong> để lưu trữ, hiển thị, chỉnh sửa, phân phối nội dung đó nhằm phục vụ vận hành Website và truyền thông Trường.</p>
          <p>Quý vị cam kết nội dung mình đăng không vi phạm pháp luật và không xâm phạm quyền của bên thứ ba. Trường có quyền gỡ bỏ nội dung không phù hợp mà không cần báo trước.</p>
        </section>

        <section id="hinh-anh-hs" class="gi-section">
          <h2>6. Hình ảnh học sinh</h2>
          <p>Mọi hình ảnh học sinh xuất hiện trên Website đều được Trường thu thập với sự đồng ý của cha, mẹ hoặc người giám hộ hợp pháp được xác thực trong Thoả ước đào tạo. Cha, mẹ có quyền yêu cầu gỡ bỏ hình ảnh con bất cứ lúc nào bằng cách gửi email về địa chỉ DPO. Trường phản hồi yêu cầu về dữ liệu cá nhân trong thời hạn luật định, và không quá 05 ngày làm việc kể từ khi nhận được yêu cầu hợp lệ. Danh sách đầy đủ quyền của chủ thể dữ liệu xem tại <a href="/chinh-sach-bao-mat#quyen-cua-quy-vi">Chính sách Bảo mật</a>.</p>
        </section>

        <section id="mien-tru" class="gi-section">
          <h2>7. Miễn trừ trách nhiệm</h2>
          <p>Nội dung trên Website (bao gồm thông tin tuyển sinh, học phí, lịch khai giảng, chương trình học) có thể thay đổi theo từng năm học và được cập nhật trên Website. Các bài blog mang tính tham khảo, không thay thế lời khuyên chuyên môn từ chuyên gia tâm lý, giáo dục hoặc y tế trong từng tình huống cụ thể của con quý vị. Trường không chịu trách nhiệm về nội dung của các website bên thứ ba được liên kết từ Website.</p>
          <p>Trường không chịu trách nhiệm đối với bất kỳ khiếu nại nào phát sinh từ việc người dùng cung cấp thông tin của bên thứ ba mà không có sự đồng ý của họ khi sử dụng các form liên hệ.</p>
        </section>

        <section id="gioi-han" class="gi-section">
          <h2>8. Giới hạn trách nhiệm</h2>
          <p>Trong phạm vi pháp luật cho phép, Trường không chịu trách nhiệm với các thiệt hại gián tiếp, ngẫu nhiên hoặc do hậu quả phát sinh từ việc sử dụng Website, trừ trường hợp thiệt hại do lỗi cố ý hoặc vi phạm nghiêm trọng từ phía Trường.</p>
        </section>

        <section id="dinh-chi" class="gi-section">
          <h2>9. Đình chỉ và chấm dứt</h2>
          <p>Trường có quyền tạm khóa tài khoản, chặn IP hoặc từ chối phục vụ với người dùng vi phạm Điều khoản này mà không cần báo trước. Người dùng có thể ngừng sử dụng Website bất cứ lúc nào.</p>
          <p>Trường có quyền tạm dừng hoặc đóng các chức năng tương tác (bình luận, đánh giá) trên Website mà không cần thông báo trước trong trường hợp phát hiện các dấu hiệu tấn công mạng hoặc chiến dịch truyền thông tiêu cực.</p>
        </section>

        <section id="luat" class="gi-section">
          <h2>10. Luật áp dụng và giải quyết tranh chấp</h2>
          <p>Điều khoản này được điều chỉnh bởi pháp luật Việt Nam. Khi phát sinh tranh chấp, các bên ưu tiên giải quyết bằng thương lượng theo <a href="/khieu-nai">Quy trình Giải quyết Khiếu nại</a> của Trường (đăng tải công khai trên Website). Nếu không đạt được thoả thuận trong vòng <strong>60 (sáu mươi) ngày làm việc</strong>, các bên có quyền đưa vụ việc ra Tòa án nhân dân có thẩm quyền tại nơi đặt trụ sở chính của Trường để giải quyết.</p>
        </section>

        <section id="sua-doi" class="gi-section">
          <h2>11. Sửa đổi điều khoản</h2>
          <p>Trường có quyền sửa đổi Điều khoản này. Phiên bản mới có hiệu lực kể từ ngày đăng tải trên Website. Quý vị có trách nhiệm xem lại Điều khoản định kỳ. Việc tiếp tục sử dụng Website sau khi phiên bản mới được đăng tải đồng nghĩa với việc quý vị chấp nhận phiên bản mới.</p>
        </section>

        <section id="chung" class="gi-section">
          <h2>12. Điều khoản chung</h2>
          <p>Trường hợp một điều khoản bất kỳ trong văn bản này bị tuyên vô hiệu hoặc không thi hành được, các điều khoản còn lại vẫn giữ nguyên hiệu lực. Điều khoản này, cùng với <a href="/chinh-sach-bao-mat">Chính sách Bảo mật</a> và <a href="/khieu-nai">Quy trình Giải quyết Khiếu nại</a>, là toàn bộ thoả thuận giữa Trường và Người dùng liên quan đến việc sử dụng Website.</p>
          <p class="gi-policy-end"><em>— Hết Điều khoản Sử dụng v1.0 —</em></p>
        </section>
      </article>
    </div>

    <section class="gi-related">
      <div class="gi-container">
        <h2 class="gi-related-title">Văn bản pháp lý liên quan</h2>
        <div class="gi-related-grid">
          <a href="/chinh-sach-bao-mat" class="gi-related-card">
            <div class="gi-related-img" style="background: linear-gradient(135deg, #26275D 0%, #363876 100%);"></div>
            <h3>Chính sách Bảo mật</h3>
            <p>Theo Luật Bảo vệ dữ liệu cá nhân 91/2025/QH15 và Nghị định 356/2025/NĐ-CP. Quyền của chủ thể dữ liệu, phản hồi không quá 05 ngày làm việc.</p>
          </a>
          <a href="/khieu-nai" class="gi-related-card">
            <div class="gi-related-img" style="background: linear-gradient(135deg, #f9dd0e 0%, #cbb30a 100%);"></div>
            <h3>Quy trình Giải quyết Khiếu nại</h3>
            <p>5 bước, SLA 30 ngày, hồ sơ khiếu nại lưu 05 năm. Có mẫu đơn online.</p>
          </a>
          <a href="/lien-he" class="gi-related-card">
            <div class="gi-related-img" style="background: linear-gradient(135deg, #0f172a 0%, #334155 100%);"></div>
            <h3>Liên hệ Trường Việt Anh</h3>
            <p>Hotline, Zalo, địa chỉ các cơ sở. Tư vấn tuyển sinh phản hồi trong 24h.</p>
          </a>
        </div>
      </div>
    </section>

    <FooterBase />
  </div>
</BaseLayout>

