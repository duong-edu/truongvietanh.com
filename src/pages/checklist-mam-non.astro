<script src="/js/va-utm.js" is:inline></script>
<script>
// @ts-nocheck

(function(){
'use strict';

/* ── CONFIG ── */
var C={
  formId:'sq-mn',
  funnel:'squeeze-checklist-mam-non',
  level:'mam-non',
  api:'/api/lead',
  redirect:'/cam-on/',
};

/* ── REFS ── */
var ov        = document.getElementById('overlay');
var pClose    = document.getElementById('pClose');
var s1        = document.getElementById('s1');
var s2        = document.getElementById('s2');
var sSuc      = document.getElementById('sSuc');
var pFill     = document.getElementById('pFill');
var pLabel    = document.getElementById('pLabel');
var pPct      = document.getElementById('pPct');
var btnNext   = document.getElementById('btnNext');
var btnSubmit = document.getElementById('btnSubmit');
var btnBack   = document.getElementById('btnBack');
var ctaBtn    = document.getElementById('ctaBtn');
var ctaMob    = document.getElementById('ctaMob');
var uSeats    = document.getElementById('uSeats');
var cSeats    = document.getElementById('cSeats');
var s2Seats   = document.getElementById('s2Seats');
var email     = '';

/* ── OPEN / CLOSE ── */
function open(){
  ov.classList.add('open');
  document.body.style.overflow='hidden';
  gtm('popup_open');
  setTimeout(function(){var el=document.getElementById('fEmail');if(el)el.focus();},320);
}
function close(){
  ov.classList.remove('open');
  document.body.style.overflow='';
}
if(ctaBtn) ctaBtn.addEventListener('click',open);
if(ctaMob) ctaMob.addEventListener('click',open);
pClose.addEventListener('click',close);
ov.addEventListener('click',function(e){if(e.target===ov)close();});
document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});

/* ── PROGRESS ── */
function setProgress(n){
  if(n===1){pFill.style.width='50%';pLabel.textContent='Bước 1 / 2';pPct.textContent='50%';}
  else     {pFill.style.width='100%';pLabel.textContent='Bước 2 / 2';pPct.textContent='100%';}
}

/* ── VALIDATION ── */
function okEmail(v){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)}
function okPhone(v){v=String(v).replace(/[\s\-\.\(\)]/g,'').replace(/^\+?84/,'0');return /^0[35789][0-9]{8}$/.test(v)}
function fieldErr(inpId,errId,show){
  var i=document.getElementById(inpId),e=document.getElementById(errId);
  if(i)i.classList.toggle('err',show);
  if(e)e.classList.toggle('on',show);
}

/* ── STEP 1 → 2 ── */
btnNext.addEventListener('click',function(){
  var v=(document.getElementById('fEmail')||{}).value||'';
  if(!okEmail(v.trim())){fieldErr('fEmail','eEmail',true);document.getElementById('fEmail').focus();return;}
  fieldErr('fEmail','eEmail',false);
  email=v.trim();
  /* Partial capture */
  try{
    localStorage.setItem('va_partial_email',email);
    fetch(C.api,{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify(Object.assign({email:email,form_id:C.formId,funnel_code:C.funnel,school_level:C.level,partial:true},(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))())),
      keepalive:true}).catch(noop);
  }catch(e){}
  gtm('lead_step1');
  s1.classList.remove('on');
  s2.classList.add('on');
  setProgress(2);
  setTimeout(function(){var n=document.getElementById('fName');if(n)n.focus();},80);
});

/* ── BACK ── */
btnBack.addEventListener('click',function(){
  s2.classList.remove('on');s1.classList.add('on');setProgress(1);
});

/* ── SUBMIT ── */
btnSubmit.addEventListener('click',function(){
  var name =(document.getElementById('fName') ||{}).value||'';
  var phone=(document.getElementById('fPhone')||{}).value||'';
  var ok=true;
  if(!name.trim())     {fieldErr('fName', 'eName', true); ok=false;} else fieldErr('fName', 'eName', false);
  if(!okPhone(phone.trim())){fieldErr('fPhone','ePhone',true);ok=false;} else fieldErr('fPhone','ePhone',false);
  if(!ok)return;

  btnSubmit.classList.add('loading');
  btnSubmit.disabled=true;

  fetch(C.api,{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify(Object.assign({email:email,parent_name:name.trim(),phone:phone.trim(),form_id:C.formId,funnel_code:C.funnel,school_level:C.level},(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))())),
  })
  .then(function(r){return r.json().catch(noop);})
  .catch(noop)
  .finally(function(){
    gtm('lead_submitted');
    try{localStorage.setItem('va_form_submitted','1');}catch(e){}
    btnSubmit.classList.remove('loading');btnSubmit.disabled=false;
    s2.classList.remove('on');sSuc.classList.add('on');
    setTimeout(function(){window.location.href=C.redirect;},2400);
  });
});

/* Enter-key UX */
document.getElementById('fEmail').addEventListener('keydown',function(e){if(e.key==='Enter')btnNext.click();});
document.getElementById('fPhone').addEventListener('keydown',function(e){if(e.key==='Enter')btnSubmit.click();});

/* ── CTA SHAKE after 3 s ── */
setTimeout(function(){
  [ctaBtn,ctaMob].forEach(function(b){
    if(!b)return;
    b.classList.add('shake');
    setTimeout(function(){b.classList.remove('shake');},560);
  });
},3000);

/* ── SEATS COUNTDOWN — believable, day-level urgency ── */
/* Init to 7-12 (random so repeat visitors see different numbers) */
var seats=7+Math.floor(Math.random()*6);
function setSeats(n){
  if(uSeats) uSeats.textContent=n;
  if(cSeats) cSeats.textContent=n;
  if(s2Seats)s2Seats.textContent=n;
}
setSeats(seats);
/* Decrement every 3-8 min to simulate live registrations */
var st=setInterval(function(){
  if(seats<=1){clearInterval(st);return;}
  seats--;
  setSeats(seats);
},(180+Math.random()*300)*1000);

/* ── GTM ── */
function gtm(evt){
  try{(window.dataLayer=window.dataLayer||[]).push(Object.assign({event:evt,form_id:C.formId,funnel_code:C.funnel,school_level:C.level},(window.__vaUTM||(window.__vaUTM=function(){var k=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_pke_mkter','pke_mkter'],o={};try{var p=new URLSearchParams(location.search);k.forEach(function(x){var g=p.get(x);if(g){try{sessionStorage.setItem('va_'+x,g)}catch(e){}}var v=g||(function(){try{return sessionStorage.getItem('va_'+x)}catch(e){return ''}})()||'';if(v)o[x]=v})}catch(e){}if(!o.utm_source){o.utm_source='direct';o.utm_medium='none'}o.page_url=location.href;return o}))()));}
  catch(e){}
}
function noop(){}

})();
</script>

    <script src="/js/phone-vn.js" defer></script>
