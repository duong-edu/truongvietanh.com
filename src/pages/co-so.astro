---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';
import { openingHoursSpecification, schoolFacts } from '../data/school-facts';

const cmsPage = await getPillarPage('co-so');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Hệ Thống Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com/co-so",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "description": "Hệ thống 6 cơ sở Trường Việt Anh tại TP.HCM, Tây Ninh, An Giang. Từ Mầm non đến THPT — cùng triết lý, cùng chất lượng, cùng hệ thống PDR.",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"],
    "address": [
      {
        "@type": "PostalAddress",
        "name": "Cơ sở Gò Vấp",
        "streetAddress": "160/72 Phan Huy Ích",
        "addressLocality": "Gò Vấp, TP. Hồ Chí Minh",
        "addressCountry": "VN"
      },
      {
        "@type": "PostalAddress",
        "name": "Mầm non Việt Anh Gò Vấp",
        "streetAddress": "573 Lê Đức Thọ",
        "addressLocality": "Gò Vấp, TP. Hồ Chí Minh",
        "addressCountry": "VN"
      },
      {
        "@type": "PostalAddress",
        "name": "Cơ sở Bình Tân",
        "streetAddress": "Số 7, Đường 38A",
        "addressLocality": "Bình Tân, TP. Hồ Chí Minh",
        "addressCountry": "VN"
      }
    ],
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gi-h1", ".gi-subtitle"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "School",
    "name": "Trường Việt Anh Gò Vấp",
    "telephone": "+84916961409",
    "address": { "@type": "PostalAddress", "streetAddress": "160/72 Phan Huy Ích", "addressLocality": "Gò Vấp", "addressRegion": "TP. Hồ Chí Minh", "addressCountry": "VN" },
    "geo": { "@type": "GeoCoordinates", "latitude": "10.8321", "longitude": "106.6442" },
    "openingHoursSpecification": [
      openingHoursSpecification
    ],
    "priceRange": "5.000.000 - 15.000.000 VND/tháng"
  },
  {
    "@context": "https://schema.org",
    "@type": "School",
    "name": "Trường Việt Anh Bình Tân",
    "telephone": "+84916961409",
    "address": { "@type": "PostalAddress", "streetAddress": "Số 7, Đường 38A, Tân Tạo", "addressLocality": "Bình Tân", "addressRegion": "TP. Hồ Chí Minh", "addressCountry": "VN" },
    "openingHoursSpecification": [
      openingHoursSpecification
    ],
    "priceRange": "5.000.000 - 15.000.000 VND/tháng"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh có bãi đỗ xe cho phụ huynh không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Các cơ sở tại TP.HCM đều có khu vực đậu xe máy và ô tô cho phụ huynh khi đưa đón con. Cơ sở Gò Vấp (160/72 Phan Huy Ích) và Bình Tân có bãi đỗ xe rộng rãi nhất." }
      },
      {
        "@type": "Question",
        "name": "Sân chơi tại các cơ sở Trường Việt Anh có rộng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tất cả cơ sở đều có sân chơi ngoài trời với thiết bị vận động phù hợp từng lứa tuổi. Cơ sở Gò Vấp và Bình Tân có khuôn viên rộng nhất với sân bóng, sân đa năng và khu vui chơi phân theo lứa tuổi." }
      },
      {
        "@type": "Question",
        "name": "An ninh tại Trường Việt Anh được đảm bảo như thế nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Mỗi cơ sở đều có hệ thống camera giám sát 24/7, bảo vệ trực cổng, thẻ đón trẻ cho phụ huynh, và quy trình đón-trả nghiêm ngặt. Người lạ không thể vào khuôn viên trường nếu không có giấy phép." }
      },
      {
        "@type": "Question",
        "name": "Phụ huynh có thể tham quan cơ sở trước khi quyết định không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tất nhiên. Trường Việt Anh khuyến khích phụ huynh đến tham quan trực tiếp để cảm nhận môi trường học tập. Đặt lịch qua Hotline 0916 961 409 hoặc Zalo để được sắp xếp buổi tham quan phù hợp — hoàn toàn miễn phí." }
      },
      {
        "@type": "Question",
        "name": "Mỗi lớp tại Trường Việt Anh có bao nhiêu học sinh?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sĩ số tối đa: Mầm non 20-25 trẻ/lớp (2 giáo viên + 1 trợ giảng), Tiểu học 24 học sinh/lớp, THCS-THPT 24 học sinh/lớp. Tỷ lệ giáo viên/học sinh đảm bảo mỗi em được quan tâm đầy đủ." }
      },
      { "@type": "Question", "name": "Trường có kế hoạch mở rộng thêm cơ sở mới không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Trường Việt Anh liên tục mở rộng. Mỗi cơ sở mới áp dụng cùng triết lý, chương trình và tiêu chuẩn cơ sở vật chất như các cơ sở hiện tại." } },
      { "@type": "Question", "name": "Cơ sở vật chất có đảm bảo an toàn cho trẻ nhỏ không?", "acceptedAnswer": { "@type": "Answer", "text": "An toàn là ưu tiên hàng đầu: camera 24/7, bảo vệ chuyên nghiệp, cổng kiểm soát thẻ, sàn chống trượt, góc bo tròn cho mầm non, PCCC đạt chuẩn, y tế trường trực full-time." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Cơ sở", "item": "https://truongvietanh.com/co-so" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Trường Việt Anh",
    "image": "https://truongvietanh.com/logo-crest-80.webp",
    "telephone": "+84916961409",
    "email": "tuyensinh@truongvietanh.com",
    "url": "https://truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "168/2 Phan Huy Ích",
      "addressLocality": "Gò Vấp",
      "addressRegion": "TP. Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 10.8431,
      "longitude": 106.6422
    },
    "openingHoursSpecification": openingHoursSpecification,
    "priceRange": "$$"
  }
];
---

<BaseLayout
  title={cmsPage?.title || `${schoolFacts.campuses} Cơ Sở Trường Việt Anh – TP.HCM, Tây Ninh, An Giang`}
  description={cmsPage?.description || "Hệ thống 6 cơ sở Trường Việt Anh trên toàn quốc. Từ Mầm non đến THPT — Mỗi cơ sở đều theo cùng triết lý và cam kết chất lượng. Tham quan miễn phí."}
  keywords="6 cơ sở trường việt anh, cơ sở gò vấp bình tân, trường việt anh long an kiên giang, địa chỉ trường vsc"
  canonical="https://truongvietanh.com/co-so"
  ogImage="https://media.truongvietanh.com/images/extra-big-img3-scaled.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Cơ sở</span>
          </nav>

          <h1 class="gi-h1">Hệ Thống {schoolFacts.campuses} Cơ Sở Trường Việt Anh Trên Toàn Quốc</h1>
          <p class="gi-subtitle">Từ Mầm non đến THPT — Mỗi cơ sở đều theo cùng triết lý và cam kết chất lượng</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>

          <div class="gi-hero-rating">
            <span class="gi-stars" aria-label="4.9 trên 5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gi-rating-text">4.9/5 (300+ đánh giá)</span>
          </div>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>{schoolFacts.campuses}</strong> Cơ sở</div>
            <div class="gi-badge"><strong>3</strong> Tỉnh thành</div>
            <div class="gi-badge"><strong>MN-THPT</strong> Liên cấp</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đặt lịch tham quan cơ sở gần nhất</p>
            <LeadFormTwoStepEmailFirst
              formId="co-so-form"
              funnelCode="co-so-pillar"
              schoolLevel="tieu-hoc"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tong-quan">Tổng quan hệ thống</a></li>
          <li><a href="#hcm">Cơ sở TP.HCM</a></li>
          <li><a href="#long-an">Cơ sở Tây Ninh</a></li>
          <li><a href="#kien-giang">Cơ sở An Giang</a></li>
          <li><a href="#khac-biet">Khác nhau điều gì?</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#co-so-form-co-so-pillar" class="gi-toc-cta">Đặt lịch tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tổng quan -->
        <section id="tong-quan" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>Trường Việt Anh có bao nhiêu cơ sở?</h2>
          <p>Hệ thống Trường Liên Cấp Việt Anh hiện có <strong>6 cơ sở</strong> hoạt động tại <strong>3 tỉnh thành</strong>: TP. Hồ Chí Minh (3 cơ sở), Tây Ninh (2 cơ sở) và An Giang (1 cơ sở). Tổng cộng 8 trường: Mầm Non và Tiểu Học Thái Sơn dùng chung một khuôn viên, Mầm Non và Tiểu Học Mekong Xanh cũng vậy. Đây là kết quả của 15 năm xây dựng và phát triển kể từ ngày thành lập năm 2011.</p>
          <p>Mỗi cơ sở trong hệ thống đều vận hành theo cùng một <a href="/gioi-thieu">triết lý giáo dục</a>, cùng hệ thống quản lý chất lượng PDR (Plan-Do-Review), cùng chương trình 100% tiếng Anh với giáo viên bản ngữ. Dù học ở cơ sở nào, con vẫn nhận được chất lượng giáo dục đồng nhất — chỉ khác nhau về vị trí địa lý và quy mô khuôn viên.</p>

          <img src="https://media.truongvietanh.com/images/the-thao-05.webp" alt="Sân thể thao Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <p>Hệ thống liên cấp từ <a href="/cap-hoc">Mầm non đến THPT</a> giúp phụ huynh yên tâm về lộ trình học tập dài hạn. Con có thể bắt đầu từ lớp Mầm (12 tháng tuổi) và tiếp tục học đến lớp 12 trong cùng hệ thống, với chương trình kết nối liền mạch giữa các cấp. Đây là ưu thế lớn so với các trường chỉ có một cấp duy nhất — phụ huynh không phải lo tìm trường mới mỗi khi con chuyển cấp. Phụ huynh có thể tìm hiểu thêm về <a href="/hoc-phi">học phí các cấp học</a> hoặc <a href="/tuyen-sinh">quy trình tuyển sinh</a> tại đây.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>{schoolFacts.campuses}</strong>
              <span>Cơ sở trên toàn quốc</span>
            </div>
            <div class="gi-evidence-item">
              <strong>3</strong>
              <span>Tỉnh thành (HCM, LA, KG)</span>
            </div>
            <div class="gi-evidence-item">
              <strong>14+</strong>
              <span>Năm hoạt động</span>
            </div>
            <div class="gi-evidence-item">
              <strong>MN-THPT</strong>
              <span>Liên cấp đầy đủ</span>
            </div>
          </div>
        </section>

        <!-- Section 2: TP.HCM -->
        <section id="hcm" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>Các cơ sở tại TP. Hồ Chí Minh</h2>
          <p>TP. Hồ Chí Minh là nơi Trường Việt Anh khởi nguồn và phát triển mạnh nhất với <strong>3 cơ sở</strong> phân bố tại các quận Gò Vấp và Bình Tân. Mỗi cơ sở phục vụ khu vực dân cư khác nhau, giúp phụ huynh chọn trường gần nhà nhất.</p>

          <div class="cs-campus-detail-list">
            <!-- Gò Vấp -->
            <div id="go-vap" class="cs-campus-detail">
              <div class="cs-campus-header">
                <h3>Cơ sở Gò Vấp</h3>
                <span class="cs-campus-tag">Liên cấp TH - THCS - THPT</span>
              </div>
              <div class="cs-campus-body">
                <div class="cs-campus-info">
                  <p><strong>Địa chỉ:</strong> <a href="https://maps.google.com/?q=160/72+Phan+Huy+Ích,+Gò+Vấp,+TP.HCM" target="_blank" rel="noopener">160/72 Phan Huy Ích, P.12, Q. Gò Vấp, TP.HCM</a></p>
                  <p><strong>Hotline:</strong> <a href="tel:0916961409">0916 961 409</a></p>
                  <p><strong>Cấp học:</strong> Tiểu học, THCS, THPT</p>
                  <p><strong>Giờ làm việc:</strong> T2-T7: 7:00-19:00 | CN: ngoài giờ, tham quan được nếu hẹn trước</p>
                </div>
                <div class="cs-campus-desc">
                  <p>Cơ sở Gò Vấp (Phan Huy Ích) là cơ sở liên cấp lớn nhất trong hệ thống, phù hợp cho gia đình có nhiều con ở các cấp học khác nhau. Khuôn viên rộng rãi với sân bóng, sân đa năng, khu vui chơi phân theo lứa tuổi.</p>
                  <p>Khu tiểu học và trung học được bố trí khoa học theo từng khu vực riêng. Phòng học rộng, thoáng, đầy đủ thiết bị hiện đại, phòng nghệ thuật, phòng âm nhạc và sân chơi ngoài trời.</p>
                  <p><strong>Phù hợp cho:</strong> Gia đình tại Gò Vấp, Quận 12, Tân Bình, Bình Thạnh và lân cận.</p>
                </div>
              </div>
            </div>

            <!-- Mầm non Việt Anh Gò Vấp -->
            <div id="mn-go-vap" class="cs-campus-detail">
              <div class="cs-campus-header">
                <h3>Mầm non Việt Anh Gò Vấp</h3>
                <span class="cs-campus-tag cs-tag-mn">Chuyên Mầm non</span>
              </div>
              <div class="cs-campus-body">
                <div class="cs-campus-info">
                  <p><strong>Địa chỉ:</strong> <a href="https://maps.google.com/?q=573+Lê+Đức+Thọ,+Gò+Vấp,+TP.HCM" target="_blank" rel="noopener">573 Lê Đức Thọ, P.16, Q. Gò Vấp, TP.HCM</a></p>
                  <p><strong>Hotline:</strong> <a href="tel:0774588988">0774 588 988</a></p>
                  <p><strong>Cấp học:</strong> Mầm non (12 tháng - 6 tuổi)</p>
                  <p><strong>Giờ làm việc:</strong> T2-T7: 7:00-19:00 | CN: ngoài giờ, tham quan được nếu hẹn trước</p>
                </div>
                <div class="cs-campus-desc">
                  <p>Cơ sở chuyên mầm non tại đường Lê Đức Thọ được thiết kế riêng cho trẻ 12 tháng đến 6 tuổi. Toàn bộ không gian — từ phòng học, sân chơi đến khu vực ăn uống — đều tối ưu cho trẻ nhỏ: góc tròn an toàn, nội thất vừa tầm với, màu sắc tươi sáng kích thích sáng tạo.</p>
                  <p>Cơ sở có <strong>bể bơi riêng</strong> cho trẻ mầm non (mực nước nông, có giáo viên bơi chuyên trách), phòng nghệ thuật với đầy đủ dụng cụ vẽ-nặn-cắt dán, và sân chơi ngoài trời rộng rãi với cầu trượt, xích đu, nhà banh. Dinh dưỡng do chuyên gia thiết kế, thực đơn thay đổi hàng ngày.</p>
                  <p><strong>Phù hợp cho:</strong> Gia đình tại Gò Vấp, Bình Thạnh, Quận 12, Tân Phú muốn cho con học chuyên mầm non.</p>
                </div>
              </div>
            </div>

            <!-- Bình Tân -->
            <div id="binh-tan" class="cs-campus-detail">
              <div class="cs-campus-header">
                <h3>Cơ sở Bình Tân</h3>
                <span class="cs-campus-tag">Liên cấp TH - THCS - THPT</span>
              </div>
              <div class="cs-campus-body">
                <div class="cs-campus-info">
                  <p><strong>Địa chỉ:</strong> <a href="https://maps.google.com/?q=Số+7+đường+38A,+Bình+Tân,+TP.HCM" target="_blank" rel="noopener">Số 7, Đường 38A, Q. Bình Tân, TP.HCM</a></p>
                  <p><strong>Hotline:</strong> <a href="tel:0916961409">0916 961 409</a></p>
                  <p><strong>Cấp học:</strong> Tiểu học, THCS, THPT</p>
                  <p><strong>Giờ làm việc:</strong> T2-T7: 7:00-19:00 | CN: ngoài giờ, tham quan được nếu hẹn trước</p>
                </div>
                <div class="cs-campus-desc">
                  <p>Cơ sở Bình Tân phục vụ phụ huynh khu vực phía Tây TP.HCM — Bình Tân, Bình Chánh, Tân Phú. Khuôn viên rộng rãi, nhiều không gian xanh cho trẻ vận động ngoài trời. Đây là cơ sở mới được nâng cấp với trang thiết bị hiện đại, phòng học máy lạnh, sân chơi đa năng.</p>
                  <p>Bãi đỗ xe tại cơ sở Bình Tân là rộng nhất trong hệ thống, thuận tiện cho phụ huynh đưa đón bằng ô tô.</p>
                  <p><strong>Phù hợp cho:</strong> Gia đình tại Bình Tân, Bình Chánh, Tân Phú, Quận 6 và lân cận.</p>
                </div>
              </div>
            </div>
