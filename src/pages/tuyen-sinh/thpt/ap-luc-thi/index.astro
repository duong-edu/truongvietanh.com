---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Giảm Áp Lực Thi Cử THPT — Học Chắc Mà Không Cần Ôn 20 Tiếng/Ngày | Việt Anh';
const pageDescription = 'Phương pháp học hiệu quả tại THPT Việt Anh giúp con giảm áp lực thi cử: đánh giá toàn diện, IELTS thay thế, luyện THPTQG chiến lược từ lớp 10, tâm lý học đường, IELTS 6.0+. Hotline: 0916 961 409.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/thpt/ap-luc-thi';

const uspItems = [
  { icon: '🧘', text: 'Đánh giá toàn diện — Điểm số không chỉ đến từ 1 bài thi duy nhất mà từ cả quá trình: dự án nhóm, thuyết trình, bài thực hành, và kiểm tra thường xuyên. Con tự tin vì nỗ lực hàng ngày đều được ghi nhận.' },
  { icon: '🎯', text: 'Luyện THPTQG chiến lược từ lớp 10 — Mỗi tuần làm 1 đề full, giáo viên phân tích lỗi sai, dạy suy luận nhanh. Đến lớp 12, con đã thuộc mọi dạng đề nên thi như "chơi game quen tay", không hoảng sợ.' },
  { icon: '🌍', text: 'IELTS là phương án B cực mạnh — Với IELTS 6.0+, con xét tuyển vào ĐH top bằng phương thức kết hợp, không phụ thuộc 100% vào THPTQG. Giảm áp lực "cược tất cả vào 1 kỳ thi".' },
  { icon: '👩‍🏫', text: 'Tư vấn ĐH 1-1 từ lớp 11 — Khi con đã chọn đúng ngành yêu thích, việc học trở nên có mục đích và động lực. Áp lực giảm vì con biết rõ "mình học để đi đâu" thay vì mơ hồ lo lắng.' },
  { icon: '💚', text: 'Chuyên viên tâm lý học đường — Theo dõi tinh thần học sinh thường xuyên, phát hiện sớm dấu hiệu căng thẳng, mất ngủ, giảm sút học tập và hỗ trợ kịp thời trước khi vấn đề trở nên nghiêm trọng.' },
  { icon: '📊', text: 'Lớp nhỏ tối đa 30 em — Giáo viên biết rõ từng em, nhận ra ngay khi con có vấn đề. Không để em nào "chìm" trong đám đông mà không ai hay biết, khác hẳn lớp 50 em ở trường công.' }
];

const metrics = [
  { number: '2', label: 'Hướng song song: thi tốt nghiệp và xét tuyển bằng IELTS' },
  { number: '6.0+', label: 'IELTS bảo hành theo hợp đồng' },
  { number: '30', label: 'Học sinh tối đa mỗi lớp — cô nhìn thấy từng em' },
  { number: '100+', label: 'Đề THPTQG đã làm quen trước khi vào lớp 12' }
];

const faqItems = [
  {
    question: 'Con tôi rất sợ thi — Việt Anh giúp con vượt qua nỗi sợ như thế nào?',
    answer: 'Nỗi sợ thi thường đến từ việc "không biết đề ra gì" và "cược tất cả vào 150 phút". Tại Việt Anh, cả hai yếu tố này được xóa bỏ. Con làm quen đề THPTQG từ lớp 10 (mỗi tuần 1 đề) nên đến lớp 12 đã thuộc mọi dạng bài, không còn bất ngờ. Điểm số được đánh giá toàn diện qua cả quá trình chứ không chỉ 1 bài thi cuối kỳ. Với IELTS 6.0+ sẵn trong tay từ lớp 11, con có thêm phương thức xét tuyển ĐH nên không "sống chết" với THPTQG.'
  },
  {
    question: 'IELTS thay thế nghĩa là gì? Con không cần thi THPTQG nữa sao?',
    answer: 'Con vẫn thi THPTQG nhưng không cần đặt toàn bộ kỳ vọng vào đó. Với IELTS 6.0-6.5+, con xét tuyển vào hầu hết ĐH top Việt Nam (Ngoại Thương, Bách Khoa, HUFLIT, RMIT...) bằng phương thức kết hợp, giảm phụ thuộc vào điểm THPTQG. Đây là "bảo hiểm tương lai" cực mạnh mà ít trường THPT nào cung cấp. Tại Việt Anh, IELTS được dạy tích hợp trong chương trình chính khóa nên con không cần học thêm trung tâm hay tốn thêm chi phí.'
  },
  {
    question: 'Luyện thi từ lớp 10 thì con có bị áp lực sớm hơn không?',
    answer: 'Ngược lại hoàn toàn. "Luyện thi từ lớp 10" tại Việt Anh là luyện chiến lược — mỗi tuần con làm 1 đề, giáo viên phân tích lỗi sai và dạy cách suy luận nhanh, quản lý thời gian. Không phải học thêm 4-5 buổi/tuần kiểu nhồi nhét. Đến lớp 12, con đã quen thuộc mọi dạng đề THPTQG nên chỉ cần tăng tốc chứ không phải bắt đầu từ số 0. Kết quả: con ngủ đủ giấc, tâm lý ổn định, tự tin bước vào phòng thi thay vì hoảng sợ.'
  },
  {
    question: 'Nếu con vẫn không đỗ ĐH nguyện vọng 1 thì sao?',
    answer: 'Giả sử con chưa đạt kết quả mong muốn ở THPTQG, Việt Anh luôn có "lưới an toàn": con đã có IELTS 6.0+ để xét tuyển bổ sung vào 50+ trường ĐH đối tác (trong nước lẫn quốc tế), hoặc du học với hồ sơ đã được chuẩn bị sẵn 3 năm. Không bao giờ là "ngõ cụt" tại Việt Anh — luôn có ít nhất 2-3 con đường để con đi tiếp.'
  },
  {
    question: 'Chuyên viên tâm lý học đường hỗ trợ con như thế nào?',
    answer: 'Chuyên viên tâm lý theo dõi tinh thần của từng học sinh thông qua quan sát hàng ngày, phản hồi từ giáo viên chủ nhiệm, và các bài đánh giá tâm lý định kỳ. Khi phát hiện em nào có dấu hiệu căng thẳng, mất ngủ, ít giao tiếp hoặc giảm sút học tập, chuyên viên sẽ trao đổi riêng với em và phối hợp với ba/mẹ để hỗ trợ. Lớp nhỏ 30 em giúp giáo viên "nhìn thấy" từng em rõ ràng, không để bất kỳ em nào âm thầm chịu đựng áp lực mà không ai biết.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="giảm áp lực thi cử, THPT, thi THPTQG, phương pháp học hiệu quả, trường Việt Anh, IELTS thay thế, tâm lý học đường"
  schoolLevel="thpt"
  funnelCode="ap-luc-thi-thpt"
  canonicalUrl={canonicalUrl}
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-16.webp"
>
  <div slot="hero">
    <h1 class="hero-h1">
      Giảm Áp Lực Thi Cử THPT — Học Chắc Mà Không Cần "Ngủ 4 Tiếng, Ôn 20 Tiếng"
    </h1>
    <p class="hero-subtitle">
      Con học đúng cách + có người hướng dẫn đúng = thi tốt mà vẫn khỏe mạnh, vui vẻ
    </p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-image-section">
      <img src="https://media.truongvietanh.com/images/thuyet-trinh-16.webp" alt="Học sinh THPT Việt Anh thuyết trình tự tin trước lớp — phương pháp đánh giá toàn diện, không chỉ dựa vào bài thi" class="content-hero-image" width="1200" height="675" loading="lazy" />
      <p class="image-caption">Học sinh THPT Việt Anh thuyết trình tự tin — được đánh giá toàn diện qua cả quá trình, không chỉ 1 bài thi</p>
    </div>

    <div class="content-section">
      <h2>Tại sao học sinh Việt Anh thi tốt mà không áp lực?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Đánh giá toàn diện — Không "cược" vào 1 bài thi duy nhất</h3>
          <p>Tại Việt Anh, điểm số không chỉ đến từ bài thi cuối kỳ mà từ cả quá trình: dự án nhóm, thuyết trình, bài tập thực hành, và kiểm tra thường xuyên. Con tự tin hơn vì biết rằng nỗ lực hàng ngày đều được ghi nhận, không phải "sống chết" trong 150 phút thi. Phương pháp này giúp con phát triển kỹ năng tư duy phản biện, làm việc nhóm và trình bày — những kỹ năng mà ĐH và nhà tuyển dụng đánh giá cao. Ba/mẹ cũng bớt lo vì con không rơi vào trạng thái "được ăn cả, ngã về không".</p>
        </div>
        <div class="content-card">
          <h3>IELTS — Phương án B mở 50+ cánh cửa Đại Học</h3>
          <p>IELTS 6.0-6.5 giúp con xét tuyển vào hầu hết ĐH top Việt Nam bằng phương thức kết hợp, không phụ thuộc hoàn toàn vào điểm THPTQG. Tại Việt Anh, IELTS được dạy tích hợp trong chương trình chính khóa từ lớp 10 nên con không cần học thêm trung tâm bên ngoài hay tốn thêm chi phí. Đến lớp 11, hầu hết em đã thi IELTS lần 1 và có điểm chính thức trong tay. Đây là "bảo hiểm tương lai" mà ít trường THPT nào cung cấp, giúp con và ba/mẹ yên tâm dù kết quả THPTQG thế nào.</p>
        </div>
        <div class="content-card">
          <h3>Tư vấn hướng nghiệp 1-1 — Chọn đúng ngành, hết lo lắng</h3>
          <p>Lớp 11, mỗi em được buổi tư vấn riêng cùng chuyên viên hướng nghiệp và ba/mẹ để khám phá ngành nghề phù hợp với năng lực và sở thích. Không còn cảnh "ba muốn con làm bác sĩ, con lại thích thiết kế" dẫn đến mâu thuẫn gia đình và áp lực tâm lý. Khi con đã chọn đúng con đường, việc học trở nên có mục đích và động lực — tự nhiên áp lực giảm đáng kể. Chuyên viên cũng lập kế hoạch xét tuyển cụ thể để con biết rõ "cần bao nhiêu điểm, cần IELTS bao nhiêu" thay vì mơ hồ lo lắng.</p>
        </div>
        <div class="content-card">
          <h3>Tâm lý học đường — Phát hiện sớm, hỗ trợ kịp thời</h3>
          <p>Việt Anh có chuyên viên tâm lý học đường theo dõi tinh thần học sinh thường xuyên qua quan sát hàng ngày và đánh giá định kỳ. Khi giáo viên nhận thấy em nào có dấu hiệu căng thẳng, mất ngủ, hoặc giảm sút học tập, chuyên viên sẽ trao đổi riêng và phối hợp với ba/mẹ để hỗ trợ. Lớp nhỏ 30 em giúp giáo viên "nhìn thấy" từng em rõ ràng — không để em nào âm thầm chịu đựng mà không ai hay. Đây là điều mà lớp 50 em ở trường công rất khó làm được.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #26275D;">Bonus: Lộ trình 3 năm "Thi không sợ" tại THPT Việt Anh</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 1.5rem;">
        <strong>Lớp 10:</strong> Làm quen đề THPTQG (1 đề/tuần), xây nền IELTS, khám phá ngành nghề qua các CLB và dự án thực tế. <strong>Lớp 11:</strong> Thi IELTS chính thức, tư vấn ĐH 1-1, chọn khối thi phù hợp, portfolio ngoại khóa hoàn thiện. <strong>Lớp 12:</strong> Tăng tốc THPTQG (đã quen đề nên chỉ cần hoàn thiện), nộp hồ sơ ĐH/du học, phỏng vấn tự tin.
      </p>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto 0;">
        Con không "ôn chóng vánh cuối cùng" mà đi từng bước vững chắc suốt 3 năm — ba/mẹ yên tâm, con tự tin và khỏe mạnh.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Đừng để áp lực thi cử ảnh hưởng sức khỏe và tương lai con</h2>
    <p class="form-subheading">Đăng ký tư vấn cá nhân hóa lộ trình học tập để biết cách Việt Anh giúp con đỗ ĐH mà không stress. Chuyên viên sẽ liên hệ trong 24h.</p>
    <LeadFormTwoStepEmailFirst
      formId="ap-luc-thi-form"
      funnelCode="ap-luc-thi-thpt"
      schoolLevel="thpt"
      submitText="Nhận tư vấn giảm áp lực thi"
      successMessage="Cảm ơn Ba/Mẹ! Chuyên viên tư vấn sẽ liên hệ trong 24h để chia sẻ phương pháp giảm áp lực thi cử tại Việt Anh."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi thường gặp về áp lực thi cử THPT" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #26275D; }.content-image-section{ text-align: center; margin-bottom: 3rem; }.content-hero-image{ width: 100%; max-width: 900px; height: auto; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #5c6e80; margin-top: 0.75rem; font-style: italic; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.15); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.bonus-section h2{ color: #f9dd0e; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: rgba(255,255,255,0.85); margin-bottom: 2rem; font-weight: 500; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; }.content-hero-image{ border-radius: 10px; } }
</style>
