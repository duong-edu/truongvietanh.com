---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="THPT Việt Anh — Làm Rõ Bản Thân, Chọn Đúng Con Đường Tương Lai"
  description="THPT không chỉ là 3 năm chạy theo kỳ thi. THPT Việt Anh: IELTS 6.0+, hướng nghiệp từ sớm, PDR, hỗ trợ hồ sơ đại học & du học. Nhận Brochure miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/thpt"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-04.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thpt-banner-chinh-1.jpg"
  programCode="thpt"
  schoolLevel="thpt"
  heroVariant="white-form"
>

  <!-- HERO — nền trắng + two-step form -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🎓 THPT Việt Anh · 15–18 tuổi</span>
      <h1>
        THPT không phải là 3 năm để <span class="mn-hl">chạy theo kỳ thi</span>
        <span class="mn-sub">mà là 3 năm để học sinh làm rõ bản thân và chọn đúng con đường tương lai</span>
      </h1>
      <p class="mn-hero__lead">
        Rất nhiều học sinh <em>học rất nhiều… nhưng không biết mình muốn gì</em>. Có điểm số nhưng không có định hướng. Chọn ngành theo số đông hoặc cảm tính.
      </p>
      <p class="mn-hero__lead">
        👉 Đến cuối lớp 12, câu hỏi lớn nhất không phải <em>"Thi được bao nhiêu điểm?"</em> — mà là <strong>"Mình nên đi đâu tiếp theo?"</strong>
      </p>
      <div class="mn-hero__badges">
        <span>🪞 Hiểu mình</span>
        <span>💪 Năng lực thật</span>
        <span>🧭 Định hướng tương lai</span>
      </div>
      <div class="mn-hero__trust">
        <div>🏫 <b>2 cơ sở chính thức</b> · Gò Vấp, Bình Tân</div>
        <div>👨‍👩‍👧 <b>3.000+ gia đình</b> tin tưởng</div>
        <div>🎓 <b>15 năm</b> đồng hành K12 từ 2011</div>
      </div>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Xem lộ trình IELTS &amp; hướng nghiệp THPT</h2>
      <p class="mn-hero__form-sub">Để lại email — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình IELTS 6.0+, hướng nghiệp và hỗ trợ hồ sơ đại học cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        formId="dinh-huong-thpt-hero"
        funnelCode="sales-thpt-dinh-huong-hero"
        schoolLevel="thpt"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- VIDEO + FORM (ngay dưới Hero) -->
  <Fragment slot="video">
    <div class="sp-video__head">
      <h2 class="sp-video__title">90% sinh viên ra trường sẽ bị AI đào thải: Bạn đã chuẩn bị "đôi cánh" gì cho con?</h2>
    </div>

    <div class="sp-video__frame">
      <iframe
        src="https://www.youtube.com/embed/ZawrgluGkk4?rel=0"
        title="THPT Việt Anh — Làm rõ bản thân, chọn đúng con đường tương lai"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

  </Fragment>

  <!-- PAIN -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">🧠 VẤN ĐỀ THẬT SỰ</p>
    <h2>Vấn Đề Không Phải Là Thi Khó — Mà Là Chọn Sai</h2>
    <p>Không ít học sinh vào đại học… rồi mới nhận ra mình chọn sai ngành. Lý do không phải vì các em thiếu cố gắng — mà vì không hiểu rõ bản thân, không được định hướng sớm, không có trải nghiệm đủ để lựa chọn.</p>
    <p>Trong khi đó, hệ thống giáo dục lại đang đẩy học sinh chạy theo điểm số, tập trung vào thi cử, và bỏ qua câu hỏi quan trọng nhất:</p>
    <p style="padding:.75rem 1rem;border-left:3px solid #f9dd0e;margin:1rem 0;font-size:1.05rem;font-weight:600;color:#26275D">
      👉 "Học để làm gì?"
    </p>
    <p>THPT đúng không phải là học nhiều hơn. Mà là <strong>học đúng thứ cần học, hiểu rõ mình là ai</strong> và chuẩn bị cho tương lai thật.</p>
  </Fragment>

  <!-- FEATURES -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">MÔI TRƯỜNG THPT VIỆT ANH</p>
    <h2>Không Chỉ Giúp Đỗ Đại Học — Mà Giúp Chọn Đúng Đại Học</h2>
    <p class="sp-features__sub">7 yếu tố giúp học sinh THPT có năng lực thật, tiếng Anh thật và hướng đi rõ</p>
    <div class="sp-features__grid">

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Lộ trình IELTS 6.0+ trước khi tốt nghiệp</h3>
        <p>Không học tiếng Anh để thi — mà để xét tuyển đại học, mở rộng cơ hội quốc tế và sử dụng thật trong học tập &amp; cuộc sống.</p>
        <span class="sp-feat-card__tag">IELTS</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">💯</div>
        <h3>Quy đổi 10 điểm tiếng Anh THPT Quốc gia</h3>
        <p>Giảm áp lực thi cử — tập trung vào năng lực thật thay vì học đối phó với một môn thi duy nhất.</p>
        <span class="sp-feat-card__tag">Xét tuyển</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📘</div>
        <h3>Nền tảng học thuật vững để xét tuyển</h3>
        <p>Không học lan man — tập trung kiến thức cốt lõi, tổ hợp phù hợp và chiến lược xét tuyển theo mục tiêu của từng học sinh.</p>
        <span class="sp-feat-card__tag">Học thuật</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>PDR — hiểu mình &amp; tự dẫn dắt</h3>
        <p>Học sinh đặt mục tiêu, theo dõi tiến trình và tự đánh giá — bắt đầu chịu trách nhiệm với tương lai của chính mình.</p>
        <span class="sp-feat-card__tag">Tự chủ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎓</div>
        <h3>Tư vấn tổ hợp &amp; hướng nghiệp từ sớm</h3>
        <p>Không đợi đến lớp 12 — học sinh hiểu ngành, hiểu bản thân và chọn hướng có cơ sở từ năm lớp 10.</p>
        <span class="sp-feat-card__tag">Hướng nghiệp</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>Hỗ trợ hồ sơ đại học &amp; du học</h3>
        <p>Không chỉ nói "có thể" — mà có lộ trình cụ thể, hỗ trợ hồ sơ và định hướng rõ ràng theo từng mục tiêu.</p>
        <span class="sp-feat-card__tag">Du học</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌐</div>
        <h3>Tiếng Anh thật — cơ hội thật</h3>
        <p>Không phải điểm số — mà là công cụ học tập, công cụ kết nối và công cụ mở cánh cửa tương lai.</p>
        <span class="sp-feat-card__tag">Tiếng Anh</span>
      </div>

    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">🌈 MỘT NGÀY TẠI THPT VIỆT ANH</p>
      <h2>Không Chỉ Học — Mà Chuẩn Bị Cho Cuộc Đời</h2>
      <p>Buổi sáng, học sinh không chỉ học bài — mà học theo mục tiêu cá nhân và định hướng đã chọn. Trong lớp, học sinh hiểu "tại sao học". Giáo viên không chỉ dạy — mà định hướng.</p>
      <p>Ngoài lớp: tư vấn hướng nghiệp, hoạt động trải nghiệm, buổi định hướng ngành nghề, kế hoạch học IELTS, làm hồ sơ đại học.</p>
      <p><strong>👉 Đây là lúc học sinh hiểu mình, chọn đường và bắt đầu đi thật.</strong></p>
      <a href="#mn-hero-form" style="display:inline-block;margin-top:1rem;background:#26275D;color:#fff;font-weight:700;padding:.75rem 1.5rem;border-radius:8px;text-decoration:none;font-size:.92rem">
        Xem lộ trình chi tiết →
      </a>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
        alt="Học sinh THPT Việt Anh thuyết trình"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">📊 3 NĂM QUYẾT ĐỊNH</p>
    <h2>THPT Không Dài — Nhưng Quyết Định Rất Nhiều</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">6.0+</span>
        <span class="sp-stat__label">IELTS mục tiêu trước khi tốt nghiệp — mở rộng cơ hội xét tuyển trong nước và quốc tế</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">10đ</span>
        <span class="sp-stat__label">Điểm tiếng Anh THPT Quốc gia quy đổi — giảm áp lực, tập trung vào năng lực thật</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3</span>
        <span class="sp-stat__label">Năm — đủ để xây năng lực, định hướng và chuẩn bị hồ sơ tương lai nếu bắt đầu đúng</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3,000+</span>
        <span class="sp-stat__label">Gia đình đã tin tưởng hệ thống Trường Việt Anh trong 15+ năm</span>
      </div>
    </div>
    <p style="margin-top:2rem;font-size:1rem;color:rgba(226,232,240,.75);line-height:1.8;max-width:680px;margin-left:auto;margin-right:auto">
      Học sinh có định hướng rõ sẽ <strong style="color:#f9dd0e">đi nhanh hơn, ít sai hơn và tự tin hơn</strong> — thay vì mất thêm 1–2 năm đại học mới nhận ra mình chọn sai.
    </p>
  </Fragment>

  <!-- QUOTE → Anh Lê Trung Thành – THPT -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">HỌC SINH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Việt Anh không chỉ giúp mình thi tốt — mà giúp mình biết mình muốn gì. Lộ trình IELTS rõ ràng, thầy cô luôn hỏi 'em muốn gì sau này?' thay vì chỉ dạy để thi. Mình tự tin bước vào đại học vì biết mình chọn đúng hướng."
      </p>
      <div class="sp-quote__author">
        <a href="https://www.youtube.com/watch?v=5T8j_k5VCW4" target="_blank" rel="noopener" style="position:relative;display:block;width:52px;height:52px;flex-shrink:0">
          <img
            src="https://img.youtube.com/vi/5T8j_k5VCW4/hqdefault.jpg"
            alt="Anh Lê Trung Thành — Học sinh THPT"
            class="sp-quote__avatar"
            width="52"
            height="52"
            loading="lazy"
            style="object-fit:cover"
          />
          <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:50%">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 19,12 5,21"/></svg>
          </span>
        </a>
        <div>
          <div class="sp-quote__name">Anh Lê Trung Thành</div>
          <div class="sp-quote__meta">Học sinh THPT · <a href="https://www.youtube.com/watch?v=5T8j_k5VCW4" target="_blank" rel="noopener" style="color:#26275D;font-weight:600;text-decoration:none">Xem video ▶</a></div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">💡 CHỌN ĐIỂM XUẤT PHÁT</p>
    <h2>Đây Không Phải Là Chọn Trường THPT</h2>
    <p class="sp-pricing__sub">Mà là chọn điểm xuất phát cho tương lai của con</p>

    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Chọn vì điểm số cao</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem;text-decoration:none;color:#64748b">Ngắn hạn</div>
        <div class="sp-pricing-col__unit">đỗ đại học — nhưng chưa chắc đúng hướng</div>
        <ul class="sp-pricing-col__features">
          <li>Điểm thi THPT cao</li>
          <li>Đỗ đại học theo chỉ tiêu</li>
          <li style="color:#26275D">Không biết mình muốn gì</li>
          <li style="color:#26275D">Tiếng Anh không dùng được</li>
          <li style="color:#26275D">Dễ chọn sai ngành, học lại</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Chọn đúng điểm xuất phát</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem">Dài hạn</div>
        <div class="sp-pricing-col__unit">năng lực thật — hướng đi rõ</div>
        <ul class="sp-pricing-col__features">
          <li>IELTS 6.0+ thật, dùng được</li>
          <li>Hiểu bản thân &amp; chọn đúng ngành</li>
          <li>Hồ sơ đại học / du học chuẩn bị sớm</li>
          <li>Tự học &amp; tự định hướng</li>
          <li>Tự tin bước vào giai đoạn tiếp theo</li>
        </ul>
      </div>
    </div>

    <div style="background:#fffbf0;border:1.5px solid #f9dd0e;border-radius:12px;padding:1.5rem;margin-top:1.5rem;text-align:left">
      <p style="font-size:1rem;color:#475569;line-height:1.8;margin:0">
        Sự khác biệt sẽ quyết định <strong style="color:#26275D">con học đại học như thế nào — và sống cuộc đời ra sao</strong> trong 10–20 năm tiếp theo.
      </p>
    </div>
    <p class="sp-pricing__note">* Liên hệ để nhận thông tin học phí và lộ trình chi tiết theo mục tiêu của con.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Bắt Đầu Từ Việc Hiểu Đúng Con Đường</h2>
    <p>Bạn không cần quyết định ngay. Nhưng bạn nên hiểu rõ lộ trình mà con sẽ đi trong 3 năm quan trọng nhất — để không mất thêm thời gian sau này.</p>
    <a href="#mn-hero-form" class="sp-cta-btn">📘 Nhận ngay Brochure chương trình →</a>
    <p class="sp-cta-block__note">Không spam · Tư vấn cá nhân hoá theo mục tiêu của con</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <div class="mn-hero__form" id="sp-form1-card" style="max-width:560px;margin:0 auto;text-align:left">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Xem lộ trình IELTS &amp; hướng nghiệp THPT</h2>
      <p class="mn-hero__form-sub">Để lại email — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình IELTS 6.0+, hướng nghiệp và hỗ trợ hồ sơ đại học cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        formId="dinh-huong-thpt-form1"
        funnelCode="sales-thpt-dinh-huong"
        schoolLevel="thpt"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Những Điều Phụ Huynh Hay Hỏi</h2>
    <p class="sp-faq__sub">Câu trả lời thẳng thắn, không vòng vo</p>

    <details class="sp-faq-item">
      <summary>Có cần IELTS từ THPT không?</summary>
      <div class="sp-faq-answer">
        Có, nếu muốn mở rộng cơ hội. IELTS không chỉ để thi — mà còn để <strong>xét tuyển đại học, du học và phát triển nghề nghiệp</strong>. Học sinh có IELTS 6.0+ trước khi tốt nghiệp THPT có lợi thế lớn khi vào đại học và đi làm.<br><br>
        Tại Việt Anh, lộ trình IELTS được xây dựng từ lớp 10 — đủ thời gian để đạt mục tiêu mà không bị áp lực gấp rút.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Nếu chưa biết con hợp ngành gì thì sao?</summary>
      <div class="sp-faq-answer">
        Càng cần định hướng sớm. Trải nghiệm và tư vấn sẽ giúp làm rõ dần — <strong>không nên đợi đến lớp 12 mới bắt đầu nghĩ</strong>. Lúc đó thường quá muộn để chuẩn bị hồ sơ hoặc thay đổi hướng.<br><br>
        Tại Việt Anh, hướng nghiệp bắt đầu từ lớp 10 — đủ thời gian để con hiểu mình và chọn có cơ sở.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Trường có đảm bảo đỗ đại học không?</summary>
      <div class="sp-faq-answer">
        Mục tiêu không chỉ là đỗ — mà là <strong>đỗ đúng ngành, đúng hướng</strong>. Học sinh có năng lực thật và định hướng rõ không chỉ đỗ đại học — mà còn học tốt, không mất thêm thời gian vì chọn sai.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con đang đi đúng hướng?</summary>
      <div class="sp-faq-answer">
