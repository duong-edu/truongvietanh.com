  <style is:inline>:root{--b:#26275D;--o:#f9dd0e;--w:#fff;--g6:#666;--f:'Open Sans',system-ui,-apple-system,sans-serif}*{margin:0;padding:0;box-sizing:border-box}body{font-family:var(--f);-webkit-font-smoothing:antialiased;font-size:16px;color:#1C2A3A;background:linear-gradient(165deg,#F0FDF4 0%,#DCFCE7 40%,#BBF7D0 100%);min-height:100vh;display:flex;flex-direction:column}.logo-bar{text-align:center;padding:24px 16px 0}.logo-bar span{font-family:'Montserrat',sans-serif;font-weight:700;font-size:1.2rem;color:var(--b)}.main{flex:1;display:flex;align-items:center;justify-content:center;padding:24px 16px 40px}.card{background:var(--w);border-radius:24px;box-shadow:0 12px 40px rgba(0,0,0,.08);max-width:480px;width:100%;padding:40px 28px;text-align:center}.icon{width:72px;height:72px;border-radius:50%;background:#16A34A15;display:flex;align-items:center;justify-content:center;font-size:36px;margin:0 auto 20px}h1{font-family:'Montserrat',sans-serif;font-size:1.75rem;font-weight:800;color:var(--b);margin-bottom:8px;line-height:1.25}h1 .name{color:var(--o)}.msg{font-size:1.05rem;color:var(--g6);line-height:1.7;margin-bottom:24px}.msg strong{color:#1C2A3A}.countdown-box{display:inline-flex;align-items:center;gap:8px;background:#FFF7ED;color:#B45309;padding:10px 20px;border-radius:16px;font-size:1rem;font-weight:500;margin-bottom:28px}.countdown-box .time{font-weight:700;font-family:'Montserrat',sans-serif}.cta-stack{display:flex;flex-direction:column;gap:12px;margin-bottom:20px}.cta-btn{display:block;padding:14px 24px;border-radius:14px;text-decoration:none;font-weight:600;font-size:1rem;text-align:center;transition:all .2s}.cta-primary{background:var(--o);color:var(--w)}.cta-primary:hover{background:#D96A1F;transform:translateY(-2px)}.cta-secondary{background:transparent;color:var(--b);border:2px solid var(--b)}.cta-secondary:hover{background:var(--b);color:var(--w)}.contact-info{display:flex;gap:12px;justify-content:center;margin-bottom:20px}.contact-btn{padding:10px 16px;border-radius:10px;text-decoration:none;font-size:1rem;font-weight:600}.phone-btn{background:#26275D;color:var(--w)}.zalo-btn{background:#0068FF;color:var(--w)}.footer-note{font-size:1rem;color:#999;margin-top:16px}
    @media(max-width:480px){.card{padding:28px 20px}h1{font-size:1.5rem}.msg{font-size:1rem}}
  </style>

