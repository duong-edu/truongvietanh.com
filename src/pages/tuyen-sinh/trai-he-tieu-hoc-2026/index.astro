---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Lion Camp 2026 Tiểu Học — 6 Tuần Tự Lập, Tự Tin, Biết Cách Sống"
  description="Lion Camp 2026: chương trình 6 tuần giúp học sinh Tiểu học tự giác, tự tin, biết dùng công nghệ đúng cách. 15/6–25/7. Học bổng 10tr. Chỉ 100 suất."
  canonical="https://truongvietanh.com/tuyen-sinh/trai-he-tieu-hoc-2026"
  ogImage="https://media.truongvietanh.com/images/vui-ve-06.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/tieu-hoc-banner-chinh-1.jpg"
  programCode="trai-he-tieu-hoc"
  schoolLevel="tieu-hoc"
  heroVariant="white-form"
>

  <!-- BLOCK 1: HERO — 2 cột: nội dung trái · form nhận Brochure phải (điền ngay, không phải cuộn) -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🦁 Lion Camp 2026 – Trại hè phát triển toàn diện</span>
      <h1>
        <span style="color:#e53e3e">Mùa hè này, con không cần học nhiều hơn</span>
        <span class="mn-sub">mà cần học cách tự lập, tự tin và biết cách sống</span>
      </h1>
      <p class="mn-hero__lead">
        Lion Camp là chương trình <strong>6 tuần</strong> giúp học sinh Tiểu học hình thành thói quen tốt, phát triển kỹ năng sống và sự tự tin — thông qua trải nghiệm thực tế mỗi ngày.
      </p>
      <div class="mn-hero__trust">
        <div>🎁 <b>Ưu đãi tháng 4:</b> học bổng 10.000.000 VND · Giới hạn 100 suất</div>
      </div>
      <p style="margin-top:.9rem">
        <a href="https://zalo.me/1678310120468101523" style="display:inline-block;background:transparent;color:#fff;font-weight:600;padding:.65rem 1.4rem;border-radius:8px;text-decoration:none;font-size:.95rem;border:2px solid rgba(255,255,255,.6)">
          Trò chuyện 1-1 →
        </a>
      </p>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Hiểu Rõ Chương Trình Trước Khi Quyết Định</h2>
      <p class="mn-hero__form-sub">Điền email để nhận Brochure chi tiết — lịch trình 6 tuần, nội dung từng tuần và cách chương trình giúp con thay đổi.</p>
      <LeadFormTwoStepEmailFirst
        formId="lion-camp-tieu-hoc-hero"
        funnelCode="lion-camp-2026-tieu-hoc-hero"
        schoolLevel="tieu-hoc"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- BLOCK 2: PAIN -->
  <div slot="pain">
    <p class="sp-pain__eyebrow">🚨 VẤN ĐỀ THỰC TẾ</p>
    <h2>Con học nhiều… nhưng chưa biết cách sống</h2>
    <p>Ở độ tuổi Tiểu học, vấn đề không phải là con thiếu kiến thức. Mà là: con chưa tự giác học, phụ thuộc vào ba mẹ, dễ bị cuốn vào điện thoại, ngại giao tiếp và thiếu tự tin.</p>
    <p>Những điều này không tự biến mất khi con lớn lên. Nếu không được rèn từ sớm: con khó tự học, khó thích nghi, khó phát triển lâu dài.</p>
    <div style="border-left:4px solid #f9dd0e;background:#fffbf0;padding:1rem 1.25rem;border-radius:0 8px 8px 0;margin-top:1.25rem">
      <p style="margin:0;font-size:1rem;line-height:1.7;color:#26275D">
        "Tư duy phản biện · Tự lập · Kỹ năng giao tiếp · Quản lý bản thân → Đây là những thứ quyết định tương lai của con — nhưng không có trong chương trình học chính quy"
      </p>
    </div>
  </div>

  <!-- BLOCK 3: FEATURES (Solution intro + 5 benefit cards) -->
  <div slot="features">
    <p class="sp-features__eyebrow">🌱 GIẢI PHÁP</p>
    <h2>Lion Camp – 6 tuần lấp đúng khoảng trống giáo dục</h2>
    <p class="sp-features__sub">Lion Camp không phải là trại hè chỉ để vui chơi hay lớp học thêm kiến thức — mà là một môi trường phát triển toàn diện, nơi mỗi hoạt động đều giúp con tự lập hơn, tự tin hơn, trưởng thành hơn.</p>

    <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0 1.25rem">
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Tư duy phản biện</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Sáng tạo</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Lãnh đạo bản thân</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">AI</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">DQ</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Tiếng Anh</span>
      <span style="background:#f9dd0e;color:#26275D;font-weight:700;font-size:1rem;padding:.3rem .8rem;border-radius:20px">Thể chất</span>
    </div>

    <p style="font-size:1rem;color:#555;margin-bottom:1.5rem">
      📅 15/6 – 25/7/2026 (6 tuần) · 👦 Độ tuổi: 6–11 · 📍 TP.HCM · Tây Ninh · An Giang
    </p>

    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Tự giác hơn</h3>
        <p>Con biết tự hoàn thành việc của mình mà không cần nhắc.</p>
        <span class="sp-feat-card__tag">Tự lập</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🗣️</div>
        <h3>Tự tin hơn</h3>
        <p>Con dám nói, dám thể hiện và giao tiếp tốt hơn.</p>
        <span class="sp-feat-card__tag">Tự tin</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📱</div>
        <h3>Biết dùng công nghệ đúng cách</h3>
        <p>Không còn phụ thuộc vào điện thoại, biết kiểm soát bản thân.</p>
        <span class="sp-feat-card__tag">Digital</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">💪</div>
        <h3>Có thói quen tốt</h3>
        <p>Sinh hoạt điều độ, vận động và chăm sóc bản thân tốt hơn.</p>
        <span class="sp-feat-card__tag">Thói quen</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Có trách nhiệm hơn</h3>
        <p>Biết tự giải quyết vấn đề thay vì chờ người lớn.</p>
        <span class="sp-feat-card__tag">Trách nhiệm</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 5: TEXTIMG (Before/After — no image, 2 styled divs) -->
  <div slot="textimg">
    <div style="background:#fff3f3;padding:1.5rem;border-radius:10px">
      <h3 style="margin:0 0 1rem;font-size:1.15rem;color:#c0392b">⚠️ Trước Lion Camp</h3>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.6rem">
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#c0392b;font-weight:700">✗</span> Phải nhắc mới học</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#c0392b;font-weight:700">✗</span> Ngại giao tiếp</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#c0392b;font-weight:700">✗</span> Dễ nghiện màn hình</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#c0392b;font-weight:700">✗</span> Phụ thuộc vào ba mẹ</li>
      </ul>
    </div>
    <div style="background:#f0faf0;padding:1.5rem;border-radius:10px">
      <h3 style="margin:0 0 1rem;font-size:1.15rem;color:#276749">✅ Sau 6 tuần</h3>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.6rem">
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#276749;font-weight:700">✓</span> Tự giác làm việc của mình</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#276749;font-weight:700">✓</span> Tự tin nói chuyện</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#276749;font-weight:700">✓</span> Biết quản lý thời gian</li>
        <li style="display:flex;align-items:flex-start;gap:.5rem;color:#555"><span style="color:#276749;font-weight:700">✓</span> Chủ động giải quyết vấn đề</li>
      </ul>
      <p style="margin:1.25rem 0 0;font-style:italic;font-size:1rem;color:#555;grid-column:1/-1">
        Đây không phải thay đổi lý thuyết — mà là thay đổi trong hành vi thực tế mỗi ngày
      </p>
    </div>
  </div>

  <!-- STATS -->
  <div slot="stats">
    <p class="sp-stats__eyebrow">📊 THÔNG TIN CHƯƠNG TRÌNH</p>
    <h2>Lion Camp 2026 — Con Số Quan Trọng</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">6</span>
        <span class="sp-stat__label">Tuần chương trình liên tục — 15/6 đến 25/7/2026</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">100</span>
        <span class="sp-stat__label">Suất ưu đãi học bổng 10 triệu VND trong tháng 4</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">19.990.000đ</span>
        <span class="sp-stat__label">Học phí ưu đãi (giá niêm yết 29.990.000đ)</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3</span>
        <span class="sp-stat__label">Cơ sở: TP.HCM · Tây Ninh · An Giang</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 6: QUOTE (3 testimonials stacked) -->
  <div slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div style="padding-bottom:1.25rem;margin-bottom:1.25rem;border-bottom:1px solid #e8e8e8">
        <p class="sp-quote__text">"Con tôi tự giác hơn hẳn. Không cần nhắc mà vẫn ngồi vào bàn học."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Phụ huynh học sinh lớp 3</div>
          </div>
        </div>
      </div>
      <div style="padding-bottom:1.25rem;margin-bottom:1.25rem;border-bottom:1px solid #e8e8e8">
        <p class="sp-quote__text">"Con trước đây rất ngại nói tiếng Anh, giờ đã chủ động giao tiếp."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Phụ huynh học sinh lớp 4</div>
          </div>
        </div>
      </div>
      <div>
        <p class="sp-quote__text">"Tôi thấy con bắt đầu suy nghĩ và tự giải quyết vấn đề."</p>
        <div class="sp-quote__author">
          <div>
            <div class="sp-quote__stars">★★★★★</div>
            <div class="sp-quote__name">Phụ huynh học sinh lớp 5</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BLOCK 7: PRICING + BLOCK 8: GUARANTEE -->
  <div slot="pricing">
    <p class="sp-pricing__eyebrow">💡 HỌC PHÍ &amp; GIÁ TRỊ</p>
    <h2>Đây Không Phải Chi Phí — Đây Là Đầu Tư Cho 6 Tuần Thay Đổi Con</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <p class="sp-pricing-col__label">Giá niêm yết</p>
        <div class="sp-pricing-col__price" style="text-decoration:line-through;opacity:.6">29.990.000đ</div>
        <div class="sp-pricing-col__unit">/khóa 6 tuần</div>
        <ul class="sp-pricing-col__features">
          <li>Chương trình 6 tuần</li>
          <li>Ăn uống &amp; sinh hoạt</li>
          <li>Giáo viên hướng dẫn</li>
          <li>Tiếng Anh bản ngữ</li>
          <li>Phân nhóm độ tuổi</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <p class="sp-pricing-col__label">Ưu đãi tháng 4</p>
        <div class="sp-pricing-col__price">19.990.000đ</div>
        <div class="sp-pricing-col__unit">/khóa (tiết kiệm 10tr)</div>
        <ul class="sp-pricing-col__features">
          <li>Toàn bộ chương trình 6 tuần</li>
          <li>Ăn uống &amp; sinh hoạt</li>
          <li>Coaching 1-1 hàng tuần</li>
          <li>Chương trình dành cho phụ huynh</li>
          <li>Phân nhóm phù hợp độ tuổi</li>
        </ul>
      </div>
    </div>

    <div style="border:2px solid #f9dd0e;background:#fffbf0;border-radius:10px;padding:1.5rem;margin-top:2rem">
      <h3 style="margin:0 0 .75rem;color:#26275D;font-size:1.15rem">🛡️ Cam kết hoàn 100% học phí</h3>
      <p style="margin:0;color:#555;line-height:1.7">
        Nếu sau 4 tuần phụ huynh không thấy sự thay đổi rõ ràng — bạn có thể dừng chương trình và nhận lại toàn bộ học phí. Không cần giải thích · Không ràng buộc.
      </p>
    </div>
  </div>

  <!-- BLOCK 9: CTA -->
  <div slot="cta">
    <h2>6 Tuần Hè — Thay Đổi Cả Một Năm Học</h2>
    <p>Bạn có thể cho con một mùa hè vui. Hoặc một mùa hè giúp con trưởng thành — biết tự lập, tự tin và có trách nhiệm.</p>
    <a href="#sp-form1" class="sp-cta-btn">Nhận Brochure chi tiết ngay →</a>
    <p style="margin-top:.75rem;font-size:1rem;opacity:.75">
      ⚡ Nhà trường phản hồi trong 24 giờ làm việc · Không spam · Không ràng buộc
    </p>
  </div>

  <!-- FORM 1 -->
  <div slot="form1">
    <p class="sp-form-block__eyebrow">ĐĂNG KÝ NHẬN BROCHURE</p>
    <h2>Hiểu Rõ Chương Trình Trước Khi Quyết Định</h2>
    <p>Điền email để nhận Brochure chi tiết — lịch trình 6 tuần, nội dung từng tuần và cách chương trình giúp con thay đổi.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-tieu-hoc-form1"
      funnelCode="lion-camp-2026-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận Brochure ngay"
    />
  </div>

  <!-- BLOCK 10: FAQ -->
  <div slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Câu Hỏi Phụ Huynh Hỏi Nhiều Nhất</h2>

    <details class="sp-faq-item">
      <summary>Con tôi nhút nhát có phù hợp không?</summary>
      <div class="sp-faq-answer">Rất phù hợp. Lion Camp được thiết kế để giúp những bạn nhút nhát phát triển từng bước — trong môi trường an toàn, không áp lực, có đồng hành.</div>
    </details>

    <details class="sp-faq-item">
      <summary>6 tuần có quá dài không?</summary>
      <div class="sp-faq-answer">Đây là thời gian tối thiểu để hình thành thói quen mới. Nghiên cứu tâm lý cho thấy cần ít nhất 21–66 ngày để thay đổi hành vi bền vững.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Có phải học nhiều không?</summary>
      <div class="sp-faq-answer">Không. Trọng tâm là trải nghiệm và thay đổi hành vi — không phải kiến thức sách vở. Con sẽ học qua làm, qua chơi và qua dự án thực tế.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con thay đổi?</summary>
      <div class="sp-faq-answer">Quan sát qua hành vi, thái độ và sự chủ động hằng ngày. Phụ huynh nhận báo cáo hàng tuần về tiến bộ của con.</div>
    </details>
  </div>

  <!-- FORM 2 -->
  <div slot="form2">
    <h2>Còn 100 Suất Ưu Đãi — Đăng Ký Giữ Chỗ Ngay</h2>
    <p>Để lại thông tin — đội ngũ Việt Anh sẽ liên hệ xác nhận suất và tư vấn cơ sở phù hợp gần nhà bạn nhất.</p>
    <LeadFormTwoStepEmailFirst
      formId="lion-camp-tieu-hoc-form2"
      funnelCode="lion-camp-2026-tieu-hoc-2"
      schoolLevel="tieu-hoc"
      submitText="Ghi danh ngay"
    />
  </div>

</SalesPageLayout>
