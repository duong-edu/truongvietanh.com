---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Tiếng Anh Trẻ Em Việt Anh — Cambridge · Bản Ngữ · Từ 4 Tuổi"
  description="Chương trình Tiếng Anh Trẻ Em Việt Anh: Cambridge methodology, GV bản ngữ, lớp nhỏ. Dành cho trẻ 4-12 tuổi. Đăng ký tư vấn cá nhân hóa lộ trình học tập."
  canonical="https://truongvietanh.com/tuyen-sinh/tieng-anh-tre-em"
  ogImage="https://media.truongvietanh.com/images/vui-ve-07.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/banner-chinh.jpg"
  programCode="tieng-anh-tre-em"
  schoolLevel="tieu-hoc"
  heroVariant="white-form"
>

  <!-- BLOCK 1: HERO — nền trắng + two-step form -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🌍 Tiếng Anh Trẻ Em · 4–12 tuổi</span>
      <h1>
        Tiếng Anh Từ Nhỏ — <span class="mn-hl">Lợi Thế</span> Không Thể Mua Được Sau Này
        <span class="mn-sub">Cambridge Young Learners · GV bản ngữ · Lớp 8–12 bé · Phương pháp TPR vui nhộn</span>
      </h1>
      <p class="mn-hero__lead">
        Hàng nghìn phụ huynh chi tiền cho con học tiếng Anh nhiều năm — nhưng đến lớp 5–6, con vẫn không dám nói. Vấn đề không ở con, mà ở <strong>phương pháp và môi trường</strong>.
      </p>
      <p class="mn-hero__lead">
        Tại Việt Anh, con học tiếng Anh như học tiếng mẹ đẻ — <strong>tự nhiên, vui vẻ và hiệu quả thực sự</strong>.
      </p>
      <div class="mn-hero__badges">
        <span>🌍 GV bản ngữ 100%</span>
        <span>🏅 Cambridge YLE</span>
        <span>👦 Lớp tối đa 8–12 bé</span>
      </div>
      <div class="mn-hero__trust">
        <div>🏫 <b>2 cơ sở chính thức</b> · Gò Vấp, Bình Tân</div>
        <div>👨‍👩‍👧 <b>3.000+ gia đình</b> tin tưởng</div>
        <div>🎓 <b>15 năm</b> đồng hành K12 từ 2011</div>
      </div>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">🎁 Học thử miễn phí</span>
      <h2>Đăng Ký 1 Buổi Học Thử Miễn Phí</h2>
      <p class="mn-hero__form-sub">Để con trải nghiệm trực tiếp với GV bản ngữ trước khi quyết định — không cam kết, không áp lực.</p>
      <LeadFormTwoStepEmailFirst
        formId="tienganh-sales-hero"
        funnelCode="sales-tieng-anh-tre-em-hero"
        schoolLevel="tieu-hoc"
        submitText="Đăng ký học thử miễn phí"
      />
    </div>
  </Fragment>

  <!-- BLOCK 2: PAIN -->
  <div slot="pain">
    <p class="sp-pain__eyebrow">SỰ THẬT VỀ TIẾNG ANH TRẺ EM</p>
    <h2>Bao Nhiêu Năm Học Tiếng Anh — Tại Sao Con Vẫn Không Nói Được?</h2>
    <p>Hàng nghìn phụ huynh tại TP.HCM đã chi tiền cho con học tiếng Anh từ nhỏ, nhưng đến lớp 5-6, con vẫn không dám mở miệng nói một câu trước người nước ngoài. Vấn đề không phải ở con — mà ở phương pháp và môi trường.</p>
    <ul class="sp-pain__list">
      <li>Học trung tâm lớn: lớp 20-30 bé, cô không đủ thời gian chú ý, con học vẹt</li>
      <li>Không có GV bản ngữ — con học phát âm sai, về sau khó sửa</li>
      <li>Phương pháp ngữ pháp → dịch: con hiểu lý thuyết nhưng không nói tự nhiên được</li>
      <li>Con học vì bị ép, không vì thích — motivation thấp, học rồi quên</li>
    </ul>
  </div>

  <!-- BLOCK 3: FEATURES -->
  <div slot="features">
    <p class="sp-features__eyebrow">PHƯƠNG PHÁP VIỆT ANH</p>
    <h2>5 Điều Khiến Tiếng Anh Trẻ Em Việt Anh Khác Biệt</h2>
    <p class="sp-features__sub">Con học tiếng Anh như học tiếng mẹ đẻ — tự nhiên, vui vẻ và hiệu quả thực sự</p>
    <div class="sp-features__grid">
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>GV bản ngữ dạy 100% tiếng Anh</h3>
        <p>Môi trường immersion đúng nghĩa — con quen với âm thanh thật từ đầu</p>
        <span class="sp-feat-card__tag">Bản ngữ</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎮</div>
        <h3>TPR + Games + Storytelling</h3>
        <p>Học qua hành động, trò chơi, kể chuyện — não bộ ghi nhớ tự nhiên, không cần học thuộc</p>
        <span class="sp-feat-card__tag">Phương pháp</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">👦</div>
        <h3>Lớp tối đa 8-12 bé</h3>
        <p>Cô đủ thời gian nghe từng bé nói — phát hiện lỗi phát âm và sửa ngay</p>
        <span class="sp-feat-card__tag">Lớp nhỏ</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🏅</div>
        <h3>Cambridge Young Learners Starters → Flyers</h3>
        <p>Lộ trình Cambridge rõ ràng — có bằng quốc tế từng mốc, phụ huynh theo dõi được</p>
        <span class="sp-feat-card__tag">Cambridge</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">❤️</div>
        <h3>Con thích học — không bị ép</h3>
        <p>Giáo viên tạo môi trường an toàn, vui vẻ — con tự nguyện muốn đến học</p>
        <span class="sp-feat-card__tag">Motivation</span>
      </div>
      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📱</div>
        <h3>Báo cáo tiến độ hàng tháng</h3>
        <p>Phụ huynh biết chính xác con đang ở đâu, tiến bộ thế nào sau mỗi tháng</p>
        <span class="sp-feat-card__tag">Minh bạch</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 4: TEXT WITH IMAGE -->
  <div slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">LỚP HỌC THỰC TẾ</p>
      <h2>Giờ Học Tiếng Anh Không Còn Là Nỗi Sợ — Mà Là Điều Con Mong Đợi</h2>
      <p>Phòng học được thiết kế colorful với đồ dùng học tập phong phú: flashcards, puppets, board games, story books và góc đọc sách tiếng Anh. Mỗi buổi học là một cuộc phiêu lưu mới — con không biết mình đang "học", con chỉ biết mình đang vui.</p>
      <p>GV bản ngữ được đào tạo chuyên biệt về dạy tiếng Anh cho trẻ em (TEFL/TESOL with Young Learners specialization). Họ biết cách tạo môi trường vui nhộn, an toàn và khuyến khích — để mỗi bé đều dám mở miệng, dù mới học lần đầu.</p>
    </div>
    <div class="sp-textimg__img">
      <img src="https://media.truongvietanh.com/images/vui-ve-07.webp" alt="Trẻ em học tiếng Anh vui vẻ" width="600" height="340" loading="lazy" />
    </div>
  </div>

  <!-- BLOCK 5: STATS -->
  <div slot="stats">
    <h2>15 Năm — 1,500+ Học Sinh Nói Tiếng Anh Tự Tin</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">1,500+</span>
        <span class="sp-stat__label">Học sinh hiện tại tại các cơ sở Việt Anh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">Cambridge</span>
        <span class="sp-stat__label">Young Learners chứng chỉ quốc tế có giá trị</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">8-12</span>
        <span class="sp-stat__label">Học sinh/lớp — đủ nhỏ để cô chú ý từng bé</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">97%</span>
        <span class="sp-stat__label">Phụ huynh thấy tiến bộ rõ sau 3 tháng</span>
      </div>
    </div>
  </div>

  <!-- BLOCK 6: QUOTE -->
  <div slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <p class="sp-quote__text">
        "Con tôi học tiếng Anh ở nhiều trung tâm 3 năm nhưng không nói được. Sau 6 tháng tại Việt Anh với cô giáo người nước ngoài, con bắt đầu tự chủ động nói tiếng Anh ở nhà, xem phim không cần phụ đề tiếng Việt! Sự thay đổi thực sự rõ rệt."
      </p>
      <div class="sp-quote__author">
        <div>
          <div class="sp-quote__stars">★★★★★</div>
          <div class="sp-quote__name">Chị Phương Linh</div>
          <div class="sp-quote__meta">Phụ huynh bé Gia Bảo, 8 tuổi — Tiếng Anh Trẻ Em Việt Anh</div>
        </div>
      </div>
    </div>
  </div>

  <!-- BLOCK 7: PRICING -->
  <div slot="pricing">
    <p class="sp-pricing__eyebrow">SO SÁNH GIÁ TRỊ</p>
    <h2>Tiếng Anh Việt Anh So Với Trung Tâm Thông Thường</h2>
    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <p class="sp-pricing-col__label">Trung tâm tiếng Anh thông thường</p>
        <ul class="sp-pricing-col__features">
          <li>Lớp 20-30 bé</li>
          <li>Không có GV bản ngữ</li>
          <li>Không Cambridge</li>
          <li>Cô không đủ thời gian chú ý</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <p class="sp-pricing-col__label">Tiếng Anh Trẻ Em Việt Anh</p>
        <ul class="sp-pricing-col__features">
          <li>GV bản ngữ 100%</li>
          <li>Tối đa 8-12 bé/lớp</li>
          <li>Cambridge Young Learners</li>
          <li>TPR + Games hiệu quả</li>
          <li>Báo cáo hàng tháng</li>
          <li>Học thử miễn phí</li>
        </ul>
      </div>
    </div>
    <p class="sp-pricing__note">* Đăng ký học thử 1 buổi hoàn toàn miễn phí — liên hệ để được tư vấn lớp phù hợp.</p>
  </div>

  <!-- BLOCK 8: CTA -->
  <div slot="cta">
    <h2>Đăng Ký 1 Buổi Học Thử Miễn Phí — Không Cam Kết</h2>
    <p>Con thích thì tiếp tục, không thích thì thôi — không áp lực, không mất tiền.</p>
    <a href="#mn-hero-form" class="sp-cta-btn">Đăng ký học thử ngay →</a>
  </div>

  <!-- BLOCK 9: FORM 1 -->
  <Fragment slot="form1">
    <div class="mn-hero__form" id="sp-form1-card" style="max-width:560px;margin:0 auto;text-align:left">
      <span class="mn-hero__form-eyebrow">🎁 Học thử miễn phí</span>
      <h2>Đăng Ký 1 Buổi Học Thử Miễn Phí</h2>
      <p class="mn-hero__form-sub">Để con trải nghiệm trực tiếp với GV bản ngữ trước khi quyết định — không cam kết, không áp lực.</p>
      <LeadFormTwoStepEmailFirst
        formId="tienganh-sales-form1"
        funnelCode="sales-tieng-anh-tre-em"
        schoolLevel="tieu-hoc"
        submitText="Đăng ký học thử miễn phí"
      />
    </div>
  </Fragment>

  <!-- BLOCK 10: FAQ -->
  <div slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Câu Hỏi Phụ Huynh Hỏi Nhiều Nhất</h2>
    <p class="sp-faq__sub">Những điều bạn cần biết trước khi cho con học thử</p>

    <details class="sp-faq-item">
      <summary>Bao nhiêu tuổi có thể bắt đầu?</summary>
      <div class="sp-faq-answer">Từ 4 tuổi. Nhóm 4-5 tuổi học qua songs, games và TPR — không áp lực ngữ pháp. Nhóm 6-8 tuổi bắt đầu Cambridge Starters. Nhóm 9-12 tuổi thi Movers/Flyers. Bắt đầu sớm = lợi thế phát âm tự nhiên.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Con đã học tiếng Anh trước rồi — xếp lớp thế nào?</summary>
      <div class="sp-faq-answer">Chúng tôi có bài test đơn giản (qua games, không phải thi cử) để xếp đúng cấp độ. Con không bị chán vì quá dễ, cũng không bị overwhelmed vì quá khó.</div>
    </details>

    <details class="sp-faq-item">
      <summary>GV bản ngữ — người Anh hay người Việt?</summary>
      <div class="sp-faq-answer">GV người bản ngữ (Mỹ, Anh, Úc, Philippines) được kiểm tra chứng chỉ TEFL/TESOL và kỹ năng dạy trẻ em. Có GV Việt hỗ trợ bên cạnh cho trẻ nhỏ khi cần.</div>
    </details>

    <details class="sp-faq-item">
      <summary>Học bao lâu thì thi Cambridge được?</summary>
      <div class="sp-faq-answer">Cambridge Starters: 6-12 tháng từ beginner. Movers: thêm 12-18 tháng. Flyers: thêm 12-18 tháng nữa. Tùy tần suất học (2-3 buổi/tuần) và mức độ hỗ trợ ở nhà.</div>
    </details>
  </div>

</SalesPageLayout>
