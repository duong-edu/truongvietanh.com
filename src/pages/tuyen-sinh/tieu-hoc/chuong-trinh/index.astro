---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Chương Trình Tiểu Học Song Ngữ — Xây Dựng Nền Tảng Vững Chắc Cho Tương Lai';
const pageDescription = 'Chương trình Tiểu Học song ngữ Trường Việt Anh: Oxford + Bộ GD&ĐT, STEM từ lớp 1, giáo viên bản ngữ, 20+ câu lạc bộ ngoại khóa. Nền tảng vững chắc cho tương lai con.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/chuong-trinh';

const uspItems = [
  { icon: '📚', text: 'Oxford pathway từ lớp 1 — Hướng tới chứng chỉ quốc tế A2-B1' },
  { icon: '🔬', text: 'STEM tích hợp từ sớm — Phòng lab hiện đại, dự án thực tế từ lớp 1' },
  { icon: '🗣️', text: 'Giáo viên bản ngữ Anh, Mỹ, Úc — 50% thời lượng học bằng tiếng Anh' },
  { icon: '👥', text: 'Lớp nhỏ 25 học sinh — Giáo viên biết tên và hiểu từng bé' },
  { icon: '🎨', text: '20+ câu lạc bộ miễn phí — Robotics, bơi lội, piano, coding, mỹ thuật' },
  { icon: '🏅', text: 'Tiêu chuẩn kép: Oxford + Bộ GD&ĐT — Cân bằng hoàn hảo' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '500+', label: 'Học sinh Tiểu Học đang theo học' },
  { number: '2011', label: 'Năm thành lập' },
  { number: '20+', label: 'Câu lạc bộ ngoại khóa' }
];

const faqItems = [
  {
    question: 'Chương trình có được Bộ GD&ĐT công nhận không?',
    answer: 'Hoàn toàn công nhận. Trường Việt Anh được Sở GD&ĐT TP.HCM cấp phép chính thức và chương trình Tiểu Học đáp ứng đầy đủ yêu cầu của Bộ GD&ĐT Việt Nam. Điều này đảm bảo rằng con ba/mẹ sẽ không gặp khó khăn nếu muốn chuyển sang trường công lập hay các trường khác trong tương lai. Học bạ và kết quả học tập được công nhận đầy đủ bởi hệ thống giáo dục Việt Nam, đồng thời con còn có thêm chứng chỉ Oxford quốc tế — đó là lợi thế kép mà ít trường nào mang lại.'
  },
  {
    question: 'Tỷ lệ tiếng Anh trong chương trình là bao nhiêu?',
    answer: 'Khoảng 50% thời lượng học bằng tiếng Anh, bao gồm Toán bằng tiếng Anh, Khoa học, Tiếng Anh chuyên sâu, và các hoạt động liên quan. Tuy nhiên, chúng tôi không áp dụng 50-50 một cách cứng nhắc mà điều chỉnh theo từng giai đoạn phát triển của bé. Lớp 1-2, tiếng Anh được đưa vào tự nhiên qua trò chơi, bài hát, và hoạt động nhóm — bé tiếp xúc ngôn ngữ mà không bị áp lực. Lớp 3-5, tỷ lệ tiếng Anh tăng dần và bé bắt đầu chuẩn bị cho kỳ thi Oxford chính thức. Mục tiêu cuối Tiểu Học: bé đạt chuẩn A2-B1, tự tin giao tiếp và đọc hiểu bằng tiếng Anh.'
  },
  {
    question: 'STEM từ lớp 1 có phù hợp với bé nhỏ không?',
    answer: 'Hoàn toàn phù hợp — vì STEM ở lớp 1 không phải "học lập trình" hay "làm thí nghiệm phức tạp" mà là phát triển tư duy qua hoạt động thực hành thú vị. Bé được xây cầu bằng que kem (Engineering), đếm và phân loại lá cây (Math + Science), vẽ thiết kế robot mơ ước (Technology + Art). Phòng lab STEM được trang bị thiết bị phù hợp với từng độ tuổi — lớp 1-2 dùng LEGO Education, lớp 3-5 nâng cấp lên Arduino và coding cơ bản. Nghiên cứu giáo dục cho thấy trẻ tiếp xúc STEM sớm phát triển khả năng giải quyết vấn đề, tư duy logic, và sáng tạo tốt hơn 30% so với trẻ bắt đầu muộn.'
  },
  {
    question: 'Học sinh có thể chuyển sang trường công lập được không?',
    answer: 'Hoàn toàn có thể, và các em sẽ không gặp bất kỳ vấn đề nào. Chương trình Tiểu Học Việt Anh đạt tiêu chuẩn Bộ GD&ĐT nên học sinh được công nhận đầy đủ các kết quả học tập — học bạ, giấy chứng nhận hoàn thành chương trình đều có giá trị pháp lý. Nhiều phụ huynh chọn Việt Anh vì chương trình toàn diện này tạo nền tảng vững chắc cho con, dù con sau đó theo học bất kỳ trường nào. Thực tế, học sinh Việt Anh khi chuyển trường thường nổi bật nhờ khả năng tiếng Anh đạt chuẩn, tư duy STEM, và kỹ năng mềm — các em "tỏa sáng" ở môi trường mới.'
  },
  {
    question: '20+ câu lạc bộ ngoại khóa bao gồm những gì?',
    answer: 'Hệ thống ngoại khóa bao gồm 4 nhóm chính: (1) Thể thao: bóng đá, bơi lội, bóng rổ, cầu lông, võ thuật — giúp bé phát triển thể chất và tinh thần đồng đội, (2) Nghệ thuật: piano, guitar, nhảy hiện đại, mỹ thuật, hội họa — khơi gợi sáng tạo và cảm xúc, (3) Công nghệ: robotics, coding cơ bản, nhiếp ảnh — phát triển tư duy logic và kỹ năng thế kỷ 21, (4) Kỹ năng sống: debate (tranh biện), thuyết trình, nấu ăn, làm vườn — xây dựng sự tự tin và trách nhiệm. Tất cả câu lạc bộ đều miễn phí cho học sinh — ba/mẹ không phải đóng thêm bất kỳ khoản nào. Mỗi bé có thể tham gia 2-3 CLB mỗi tuần để khám phá đam mê thực sự.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="chương trình tiểu học, song ngữ, Oxford, STEM, trường Việt Anh, ngoại khóa, giáo viên bản ngữ"
  schoolLevel="tieu-hoc"
  funnelCode="chuong-trinh-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Chương Trình Tiểu Học Song Ngữ<br/>Xây Dựng Nền Tảng Vững Chắc Cho Tương Lai</h1>
    <p class="hero-subtitle">Oxford + Bộ GD&ĐT | STEM từ lớp 1 | Giáo viên bản ngữ | 20+ CLB miễn phí</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section hero-image-section">
      <img src="https://media.truongvietanh.com/images/thuyet-trinh-02.webp" alt="Học sinh tiểu học Trường Việt Anh thuyết trình dự án STEM bằng tiếng Anh" class="hero-content-image" width="800" height="450" loading="lazy" />
      <p class="image-caption">Học sinh Tiểu Học Trường Việt Anh tự tin thuyết trình dự án trước lớp bằng tiếng Anh</p>
    </div>

    <div class="content-section">
      <h2>4 Trụ Cột Của Chương Trình Tiểu Học Việt Anh</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Tiêu Chuẩn Kép: Oxford + Bộ GD&ĐT</h3>
          <p>Chương trình kết hợp tiêu chuẩn quốc tế Oxford Primary với chương trình chuẩn Bộ GD&ĐT Việt Nam — đây là sự cân bằng hoàn hảo giữa truyền thống và hiện đại mà ít trường tiểu học tại TPHCM đạt được. Con ba/mẹ sẽ nắm vững kiến thức nền tảng Việt Nam (Toán, Tiếng Việt, Lịch sử, Địa lý), đồng thời phát triển tư duy toàn cầu và khả năng tiếng Anh đạt chuẩn quốc tế. Học bạ được Sở GD&ĐT TP.HCM công nhận đầy đủ, con có thể chuyển trường bất kỳ lúc nào mà không gặp khó khăn về thủ tục hay kiến thức.</p>
        </div>
        <div class="content-card">
          <h3>STEM Từ Lớp 1: Tư Duy Sáng Tạo Từ Sớm</h3>
          <p>Không chờ đến lớp 4 hay 5 — bé được tiếp xúc STEM ngay từ lớp 1 thông qua phòng lab hiện đại được trang bị đầy đủ thiết bị, dự án thực tế liên môn, và các thí nghiệm thú vị phù hợp lứa tuổi. Lớp 1-2 dùng LEGO Education để xây dựng mô hình và phát triển tư duy không gian, lớp 3-5 nâng cấp lên Arduino và coding cơ bản với Scratch. Nghiên cứu cho thấy trẻ tiếp xúc STEM sớm phát triển khả năng giải quyết vấn đề, tư duy logic, và sáng tạo tốt hơn 30% — những kỹ năng thiết yếu cho thế kỷ 21 mà sách vở truyền thống không dạy được.</p>
        </div>
        <div class="content-card">
          <h3>Tiếng Anh Chuyên Sâu Với Giáo Viên Bản Ngữ</h3>
          <p>50% thời lượng học bằng tiếng Anh, với giáo viên bản ngữ từ Anh, Mỹ, Úc có chứng chỉ giảng dạy quốc tế TESOL/CELTA và kinh nghiệm dạy trẻ em. Bé không chỉ "học tiếng Anh" mà "sống trong tiếng Anh" — học Toán bằng tiếng Anh, làm thí nghiệm Khoa học bằng tiếng Anh, và tham gia ngoại khóa với bạn quốc tế. Mục tiêu cuối Tiểu Học: con đạt chuẩn A2-B1, tự tin giao tiếp, đọc hiểu, và viết bằng tiếng Anh, sẵn sàng cho kỳ thi chứng chỉ Oxford chính thức.</p>
        </div>
        <div class="content-card">
          <h3>20+ CLB Ngoại Khóa Miễn Phí: Phát Triển Toàn Diện</h3>
          <p>Hệ thống ngoại khóa 4 nhóm: Thể thao (bóng đá, bơi lội, cầu lông, võ thuật), Nghệ thuật (piano, guitar, mỹ thuật, nhảy hiện đại), Công nghệ (robotics, coding, nhiếp ảnh), và Kỹ năng sống (debate, thuyết trình, làm vườn). Tất cả CLB đều miễn phí, bé tham gia 2-3 CLB mỗi tuần để khám phá đam mê thực sự. Giáo dục toàn diện không chỉ là điểm số — mà là giúp bé phát triển sự tự tin, teamwork, và khám phá ra "mình giỏi cái gì, thích cái gì". Mỗi bé là duy nhất, và chúng tôi tạo không gian để mỗi bé tỏa sáng theo cách riêng.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #26275D;">Bonus: Lộ Trình Phát Triển 5 Năm — Từ Lớp 1 Đến Lớp 5</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto;">
        <strong>Lớp 1-2 (Nền tảng):</strong> Xây dựng kỹ năng đọc viết song ngữ, làm quen STEM qua trò chơi và LEGO Education, phát triển kỹ năng xã hội và tự chăm sóc bản thân. <strong>Lớp 3 (Chuyển tiếp):</strong> Tăng cường tiếng Anh học thuật, bắt đầu dự án STEM phức tạp hơn với Arduino, rèn kỹ năng thuyết trình bằng cả hai ngôn ngữ. <strong>Lớp 4-5 (Nâng cao):</strong> Chuẩn bị kỳ thi Oxford chính thức, coding cơ bản với Scratch và Python, debate bằng tiếng Anh, và hoàn thiện kỹ năng lãnh đạo qua các dự án cộng đồng. Khi kết thúc lớp 5, con sẵn sàng bước vào THCS với nền tảng vững chắc. Gọi <strong>0916 961 409</strong> để nhận brochure chi tiết.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Khám Phá Chương Trình Chi Tiết Hôm Nay</h2>
    <p class="form-subheading">Nhận brochure chương trình + bảng học phí + tư vấn cá nhân hóa lộ trình học tập từ chuyên gia giáo dục</p>
    <LeadFormTwoStepEmailFirst
      formId="chuong-trinh-tieu-hoc-form"
      funnelCode="chuong-trinh-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Nhận thông tin chương trình"
      successMessage="Brochure chương trình đã gửi qua email! Bộ phận Tuyển sinh sẽ liên hệ tư vấn thêm trong 24h."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Chương trình Tiểu Học Song Ngữ" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #26275D; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.12); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: rgba(255,255,255,0.85); margin-bottom: 2rem; font-weight: 500; }.hero-image-section{ text-align: center; margin-bottom: 2rem; }.hero-content-image{ width: 100%; max-width: 800px; height: auto; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #5c6e80; margin-top: 0.75rem; font-style: italic; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; } }
</style>
