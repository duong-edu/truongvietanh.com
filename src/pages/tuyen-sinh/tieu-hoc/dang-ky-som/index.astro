---
import SqueezePageLayout from '../../../../layouts/SqueezePageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../../components/LeadFormTwoStepEmailFirst.astro';
import USPGrid from '../../../../components/USPGrid.astro';
import TrustMetrics from '../../../../components/TrustMetrics.astro';
import FAQSection from '../../../../components/FAQSection.astro';

const pageTitle = 'Đăng Ký Sớm Tiểu Học 2026 — Ưu Đãi Học Phí & Suất Ưu Tiên';
const pageDescription = 'Early Bird Tiểu Học 2026–2027 tại Trường Việt Anh: đóng trước tối đa 5 năm, mức giảm tăng dần 6% → 46%, khoá giá học phí theo năm đầu. Đổi ý vẫn rút được, báo trước 30 ngày, không mất phí phạt.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/tieu-hoc/dang-ky-som';

const uspItems = [
  { icon: '💰', text: 'Đóng trước càng nhiều năm giảm càng sâu — 6% → 16% → 26% → 36% → 46%' },
  { icon: '🔒', text: 'Khoá giá theo học phí năm đầu — trần tăng 10%/năm không còn ảnh hưởng' },
  { icon: '🔄', text: 'Đổi ý vẫn rút được tiền — báo trước 30 ngày, không phí phạt, không truy thu' },
  { icon: '➕', text: 'Cộng dồn với mọi ưu đãi và học bổng khác, kể cả anh chị em ruột giảm 50%' },
  { icon: '👥', text: 'Ưu tiên lớp song ngữ 25 HS — Đảm bảo con được chú ý cá nhân' },
  { icon: '📋', text: 'Đánh giá năng lực miễn phí + Lộ trình học tập riêng cho con' }
];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '46%', label: 'Mức giảm tối đa khi đóng trước 5 năm' },
  { number: '2011', label: 'Năm thành lập' },
  { number: '5 năm', label: 'Khoá giá theo học phí năm đầu' }
];

const faqItems = [
  {
    question: 'Early Bird cụ thể là gì? Giảm bao nhiêu?',
    answer: 'Early Bird là đóng trước học phí cho nhiều năm, tối đa 5 năm — đúng bằng trọn cấp Tiểu Học. Đóng trước đến năm thứ mấy thì năm đó được giảm bấy nhiêu: năm 1 giảm 6%, năm 2 giảm 16%, năm 3 giảm 26%, năm 4 giảm 36%, năm 5 giảm 46%. Quan trọng hơn mức giảm: toàn bộ 5 năm được tính trên học phí niêm yết của năm thứ nhất, nên trần tăng 10% mỗi năm không còn ảnh hưởng tới phần ba/mẹ đã đóng. Ưu đãi này cộng dồn với mọi ưu đãi và học bổng khác. Mọi con số tính trên học phí, không áp dụng cho phí dịch vụ, tiền ăn, xe đưa đón và các khoản thu hộ — chi hộ.'
  },
  {
    question: 'Early Bird có hạn chót hay giới hạn suất không?',
    answer: 'Không. Early Bird là một cách đóng học phí, không phải chương trình khuyến mãi có thời hạn — ba/mẹ chọn lúc nào cũng được, và không có chuyện hết suất. Mức giảm phụ thuộc vào số năm ba/mẹ đóng trước, không phụ thuộc vào việc đăng ký sớm hay muộn. Đổi lại, đây là quyết định cần cân nhắc kỹ: Trường Việt Anh khuyên gia đình chỉ chọn Early Bird khi đã có quỹ dự phòng riêng, đã đi thăm trường, và xác định con sẽ học hết cấp tại đây. Bộ phận Tuyển sinh sẽ liên hệ trong vòng 24 giờ để gửi bảng tính cụ thể cho lớp của con.'
  },
  {
    question: 'Khoá giá học phí nghĩa là gì? Có cam kết bằng văn bản không?',
    answer: 'Khoá giá nghĩa là phần học phí ba/mẹ đã đóng trước được tính theo mức niêm yết của năm thứ nhất, không bị tính lại theo giá của những năm sau. Học phí Trường Việt Anh có quy định tăng tối đa 10% mỗi năm — nghe thì nhỏ, nhưng cộng dồn qua 4 năm thì học phí năm thứ 5 đã cao hơn năm đầu 46%. Đó chính là phần giá trị lớn nhất của Early Bird, và nó được ghi rõ trong hợp đồng nhập học. Lưu ý trần 10% là mức tối đa, không phải cam kết tăng: nếu trường tăng ít hơn thì phần lợi của ba/mẹ nhỏ hơn.'
  },
  {
    question: 'Con chưa đủ tuổi vào lớp 1 năm 2026, có đăng ký giữ chỗ được không?',
    answer: 'Chương trình Tiểu Học dành cho bé đủ 6 tuổi tính đến tháng 9/2026. Nếu con ba/mẹ sinh sau mốc này, ba/mẹ vẫn có thể liên hệ bộ phận Tuyển sinh để đăng ký giữ chỗ cho năm học 2027-2028 và nhận ưu đãi riêng. Ngoài ra, Trường Việt Anh có chương trình Mầm non song ngữ giúp con chuẩn bị sẵn sàng cho lớp 1 — bé sẽ quen với môi trường, giáo viên, và bạn bè trước khi bước vào Tiểu Học. Nhiều phụ huynh chọn con đường này và rất hài lòng vì con chuyển tiếp tự nhiên, không bỡ ngỡ.'
  },
  {
    question: 'Nếu đăng ký rồi mà đổi ý, có được hoàn tiền không?',
    answer: 'Ở giai đoạn để lại thông tin, ba/mẹ chưa phải đóng bất kỳ khoản nào — Tuyển sinh sẽ liên hệ tư vấn và mời tham quan trường trước. Còn nếu đã đóng Early Bird rồi mà giữa chừng đổi ý, ba/mẹ vẫn lấy lại được toàn bộ phần tiền chưa dùng, chỉ cần báo trước 30 ngày: không phải xin, không cần lý do, không mất phí phạt. Phần thời gian con đã học vẫn giữ nguyên mức ưu đãi Early Bird của những năm đó — trường không tính lùi về giá gốc và không truy thu phần đã giảm. Con chuyển trường, gia đình chuyển nơi ở, con đi du học sớm — chuyện xảy ra thật, và ba/mẹ không bị phạt vì nó.'
  }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  keywords="đăng ký sớm tiểu học, early bird tiểu học, trường Việt Anh, ưu đãi học phí 2026, giữ chỗ tiểu học"
  schoolLevel="tieu-hoc"
  funnelCode="early-bird-tieu-hoc"
  canonicalUrl={canonicalUrl}
>
  <div slot="hero">
    <h1 class="hero-h1">Đăng Ký Sớm Tiểu Học 2026<br/>Ưu Đãi Học Phí & Suất Ưu Tiên</h1>
    <p class="hero-subtitle">Đóng trước tối đa 5 năm — giảm dần 6% → 46% và khoá giá theo học phí năm đầu. Đổi ý vẫn rút được sau 30 ngày báo trước.</p>
  </div>

  <div slot="usp">
    <USPGrid items={uspItems} />
  </div>

  <div slot="trust">
    <TrustMetrics metrics={metrics} />
  </div>

  <div slot="content">
    <div class="content-section hero-image-section">
      <img src="https://media.truongvietanh.com/images/phu-huynh-07.webp" alt="Phụ huynh đăng ký sớm nhập học tiểu học cho con tại Trường Việt Anh" class="hero-content-image" width="800" height="450" loading="lazy" />
      <p class="image-caption">Phụ huynh trao đổi với chuyên gia Tuyển sinh Trường Việt Anh về chương trình Early Bird Tiểu Học 2026</p>
    </div>

    <div class="content-section">
      <h2>Tại Sao Đăng Ký Sớm Là Quyết Định Thông Minh Nhất?</h2>
      <div class="content-grid">
        <div class="content-card">
          <h3>Đóng Trước 5 Năm — Giảm Tới 46% Và Khoá Giá Theo Năm Đầu</h3>
          <p>Early Bird cho ba/mẹ hai thứ, và phần lớn phụ huynh chỉ nhìn thấy thứ nhất. Thứ nhất là mức giảm tăng dần theo từng năm đóng trước: năm 1 giảm 6%, năm 2 giảm 16%, năm 3 giảm 26%, năm 4 giảm 36%, năm 5 giảm 46%. Thứ hai — và đây mới là phần lớn giá trị — toàn bộ 5 năm được tính trên học phí niêm yết của năm thứ nhất. Học phí Trường Việt Anh có quy định tăng tối đa 10% mỗi năm; cộng dồn qua 4 năm thì học phí năm thứ 5 đã cao hơn năm đầu 46%. Với ví dụ học phí năm đầu 137.257.000đ (lớp 10, theo bảng học phí niêm yết), đóng trọn gói 5 năm là 507.850.900đ so với 787.689.648đ nếu đóng từng năm đã trừ 6% — chênh lệch 279.838.748đ. Xem bảng tính đầy đủ tại <a href="/hoc-bong">trang Học bổng &amp; ưu đãi học phí</a>.</p>
        </div>
        <div class="content-card">
          <h3>Ưu Tiên Lớp Song Ngữ Chất Lượng Cao</h3>
          <p>Lớp song ngữ tại Việt Anh giới hạn chỉ 25 học sinh/lớp — đây là tiêu chuẩn vàng được nghiên cứu giáo dục quốc tế khuyến nghị để đảm bảo mỗi bé nhận được sự chú ý cá nhân từ giáo viên. Phụ huynh đăng ký Early Bird được ưu tiên chọn lớp trước, không phải lo con bị xếp vào lớp đã đầy chỗ hoặc phải chờ danh sách dự bị. Con ba/mẹ sẽ học cùng giáo viên bản ngữ từ Anh, Mỹ, Úc có chứng chỉ TESOL/CELTA trong môi trường tiếng Anh tự nhiên, phát triển khả năng ngôn ngữ tự nhiên ngay từ ngày đầu lớp 1.</p>
        </div>
        <div class="content-card">
          <h3>Trọn Bộ Đồ Dùng & Sách Giáo Khoa Trị Giá 3 Triệu</h3>
          <p>Ba/mẹ không cần chạy đi mua sắm đồ dùng học tập — con sẽ nhận trọn bộ đồng phục (2 bộ mùa hè + 1 bộ thể dục), sách giáo khoa song ngữ, vở viết, và toàn bộ dụng cụ học tập cần thiết cho năm học đầu tiên. Điều này giúp con bắt đầu năm học mới với đầy đủ trang bị đồng nhất cùng các bạn, tự tin và sẵn sàng. Ba/mẹ cũng tiết kiệm thời gian chuẩn bị và yên tâm rằng mọi thứ đều đạt tiêu chuẩn nhà trường.</p>
        </div>
        <div class="content-card">
          <h3>Đánh Giá Năng Lực & Lộ Trình Học Tập Cá Nhân</h3>
          <p>Mỗi bé là duy nhất — chúng tôi không dạy theo khuôn mẫu chung cho tất cả. Con ba/mẹ sẽ được đánh giá năng lực đầu vào miễn phí bởi đội ngũ chuyên gia giáo dục để hiểu rõ điểm mạnh, sở thích, phong cách học tập, và những lĩnh vực cần hỗ trợ thêm. Từ đó, đội ngũ giáo viên xây dựng lộ trình học tập riêng biệt cho từng bé — bé khỏe tiếng Anh thì được thử thách nâng cao, bé cần hỗ trợ Toán thì có chương trình bổ trợ phù hợp, đảm bảo không bé nào bị bỏ lại phía sau.</p>
        </div>
      </div>
    </div>

    <div class="content-section bonus-section">
      <h2 style="color: #26275D;">Bonus: Lộ Trình Nhập Học 2026 — Từng Bước Cụ Thể</h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #333; text-align: center; max-width: 800px; margin: 0 auto;">
        <strong>Tháng 4-6/2026:</strong> Đăng ký, nhận bảng tính Early Bird riêng cho lớp của con và chốt số năm đóng trước (tối đa 5 năm, giảm từ 6–46%, khoá giá theo năm đầu). <strong>Tháng 7:</strong> Tham quan trường, gặp giáo viên bản ngữ, bé trải nghiệm lớp học thử song ngữ thật sự. <strong>Tháng 8:</strong> Đánh giá năng lực đầu vào, nhận lộ trình học tập cá nhân và hướng dẫn chuẩn bị tâm lý cho con. <strong>Tháng 9:</strong> Con bước vào lớp 1 tự tin, với đầy đủ trang bị và sự hỗ trợ tận tâm từ đội ngũ giáo viên Việt Nam và bản ngữ. Ba/mẹ đăng ký càng sớm, con càng có nhiều thời gian chuẩn bị — gọi <strong>0916 961 409</strong> ngay hôm nay.
      </p>
    </div>
  </div>

  <div slot="form">
    <h2 class="form-heading">Giữ Chỗ Early Bird Ngay — Chỉ 120 Suất Cho Năm Học 2026</h2>
    <p class="form-subheading">Chỉ cần 2 phút đăng ký — Bộ phận Tuyển sinh sẽ liên hệ xác nhận và gửi thông tin ưu đãi trong 24h</p>
    <LeadFormTwoStepEmailFirst
      formId="early-bird-tieu-hoc-form"
      funnelCode="early-bird-tieu-hoc"
      schoolLevel="tieu-hoc"
      submitText="Giữ chỗ Early Bird"
      successMessage="Cảm ơn Ba/Mẹ! Bộ phận Tuyển sinh sẽ gửi thông tin ưu đãi chi tiết qua email trong 24h và liên hệ xác nhận."
    />
  </div>

  <div slot="faq">
    <FAQSection items={faqItems} title="Câu hỏi về Đăng ký sớm Tiểu Học 2026" />
  </div>
</SqueezePageLayout>

<style>.hero-h1{ font-family: "Montserrat", sans-serif; font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: #26275D; }.hero-subtitle{ font-size: clamp(1rem, 3vw, 1.25rem); font-weight: 500; opacity: 0.95; color: #26275D; }.content-section{ margin-bottom: 3rem; }.content-section h2{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; margin-bottom: 2rem; color: #26275D; text-align: center; }.content-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; max-width: 1200px; margin: 0 auto; }.content-card{ padding: 2rem; background: white; border: 2px solid #e0e0e0; border-radius: 12px; transition: all 0.3s ease; }.content-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.12); transform: translateY(-4px); }.content-card h3{ font-family: "Montserrat", sans-serif; font-size: 1.5rem; font-weight: 700; color: #26275D; margin-bottom: 1rem; }.content-card p{ font-size: 1rem; line-height: 1.7; color: #555; }.bonus-section{ background: linear-gradient(135deg, #FFF8F0 0%, #FFFBF7 100%); padding: 2rem; border-left: 5px solid #f9dd0e; border-radius: 8px; }.form-heading{ font-family: "Montserrat", sans-serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #f9dd0e; margin-bottom: 0.5rem; }.form-subheading{ font-size: 1rem; color: rgba(255,255,255,0.85); margin-bottom: 2rem; font-weight: 500; }.hero-image-section{ text-align: center; margin-bottom: 2rem; }.hero-content-image{ width: 100%; max-width: 800px; height: auto; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.12); }.image-caption{ font-size: 1rem; color: #5c6e80; margin-top: 0.75rem; font-style: italic; }
  @media (max-width: 768px) {.content-grid{ grid-template-columns: 1fr; }.content-card{ padding: 1.5rem; }.bonus-section{ padding: 1.5rem; } }
</style>
