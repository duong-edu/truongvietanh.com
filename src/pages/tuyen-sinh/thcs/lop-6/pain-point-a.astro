    });
  </script>

  <style>*{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }body{
      font-family: 'Open Sans', sans-serif;
      color: #26275D;
      background: linear-gradient(135deg, #FEF2F2 0%, #FFFFFF 100%);
      min-height: 100vh;
      line-height: 1.6;
    }.container{
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }.hero-section{
      text-align: center;
      padding: 40px 20px;
    }h1{
      font-family: 'Montserrat', sans-serif;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 20px;
      color: #26275D;
    }.subtitle{
      font-size: 16px;
      color: #64748B;
      margin-bottom: 30px;
      font-weight: 500;
    }.offer-items{
      background: rgba(255, 255, 255, 0.8);
      border-left: 4px solid #f9dd0e;
      padding: 20px;
      margin: 30px 0;
      border-radius: 4px;
    }.offer-items ul{
      list-style: none;
    }.offer-items li{
      padding: 12px 0;
      border-bottom: 1px solid #E0E7FF;
      font-size: 16px;
    }.offer-items li:last-child{
      border-bottom: none;
    }.offer-items li strong{
      color: #26275D;
      font-weight: 600;
    }/* Form Styles */
    .form-section{
      background: rgba(255, 255, 255, 0.95);
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(31, 78, 121, 0.08);
      margin: 30px 0;
    }.form-step{
      display: none;
    }.form-step.active{
      display: block;
    }.form-group{
      margin-bottom: 20px;
    }label{
      display: block;
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 8px;
      color: #26275D;
    }input[type="email"],
    input[type="text"],
    input[type="tel"],
    select{
      width: 100%;
      padding: 12px;
      border: 2px solid #E0E7FF;
      border-radius: 4px;
      font-size: 16px;
      font-family: 'Open Sans', sans-serif;
      color: #26275D;
      transition: border-color 0.3s;
    }input[type="email"]:focus,
    input[type="text"]:focus,
    input[type="tel"]:focus,
    select:focus{
      outline: none;
      border-color: #f9dd0e;
      box-shadow: 0 0 0 3px rgba(192,149,48, 0.1);
    }button{
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #f9dd0e 0%, #991B1B 100%);
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Montserrat', sans-serif;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }button:hover{
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(192,149,48, 0.3);
    }button:active{
      transform: translateY(0);
    }.step-indicator{
      font-size: 16px;
      color:#64748b;
      margin-bottom: 15px;
      text-align: center;
    }/* Thank You */
    .thank-you-section{
      display: none;
      text-align: center;
      padding: 40px 20px;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 8px;
      margin: 30px 0;
    }.thank-you-section.active{
      display: block;
    }.thank-you-icon{
      font-size: 48px;
      margin-bottom: 20px;
    }.thank-you-section h2{
      font-family: 'Montserrat', sans-serif;
      font-size: 24px;
      font-weight: 700;
      color: #26275D;
      margin-bottom: 15px;
    }.thank-you-section p{
      font-size: 16px;
      color: #64748B;
      line-height: 1.6;
    }.urgency-banner{
      background: rgba(192,149,48, 0.1);
      border: 2px solid #f9dd0e;
      color: #991B1B;
      padding: 12px;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
    }.success-checkmark{
      display: inline-block;
      color: #16A34A;
      margin-right: 5px;
    }

    @media (max-width: 600px) {h1{
        font-size: 24px;
      }.form-section{
        padding: 20px;
      }.hero-section{
        padding: 30px 15px;
      }
    }
  </style>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
