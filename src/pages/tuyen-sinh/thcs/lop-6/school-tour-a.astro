---
// Version A - School Tour THCS Lớp 6 Squeeze Page
const pageTitle = "Đặt lịch School Tour THCS 2026 – Con bạn sẽ được học 1 buổi thực tế";
const pageDescription = "Đặt lịch school tour THCS 2026 miễn phí. Con bạn sẽ tham gia 1 buổi học mẫu, cha mẹ được tư vấn lộ trình cá nhân hóa từ lớp 6 đến lớp 9.";
const canonicalUrl = "https://truongvietanh.com/tuyen-sinh/thcs/lop-6/school-tour-a";
const pageVariant = "school_tour_lop6_a";
const funnel = "squeeze_page_lop6";
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={pageDescription}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={pageDescription}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:site_name" content="Trường Việt Anh">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600;700&subset=vietnamese&display=swap" rel="stylesheet">

    <title>{pageTitle}</title>

    <!-- Google Tag Manager -->
    <script>
// @ts-nocheck

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        'event': 'page_view',
        'page_variant': '{pageVariant}',
        'funnel': '{funnel}',
        'school_level': 'thcs',
