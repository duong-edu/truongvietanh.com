---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="THCS Việt Anh — Đồng Hành Tuổi Dậy Thì, Bứt Phá Không Lệch Hướng"
  description="Tuổi dậy thì không phải vấn đề cần 'xử lý' — mà là nguồn năng lượng cần được dẫn dắt đúng. THCS Việt Anh: EQ, PDR, Leader in Me, AI Education. Nhận Brochure miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/thcs"
  ogImage="https://media.truongvietanh.com/images/thuyet-trinh-09.webp"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/thcs-banner-chinh-1.jpg"
  programCode="thcs"
  schoolLevel="thcs"
  heroVariant="white-form"
>

  <!-- HERO — nền trắng + two-step form -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">💪 THCS Việt Anh · 11–15 tuổi</span>
      <h1>
        Tuổi dậy thì không phải là giai đoạn <span class="mn-hl">"khó bảo"</span>
        <span class="mn-sub">mà là giai đoạn quyết định con bạn sẽ bứt phá… hay lệch hướng</span>
      </h1>
      <p class="mn-hero__lead">
        Đây là lúc cảm xúc của con thay đổi mạnh, ảnh hưởng từ bạn bè lớn hơn gia đình, thế giới online bắt đầu chi phối suy nghĩ — nhiều phụ huynh cảm thấy <em>không còn hiểu con, khó kiểm soát, không biết nên "siết" hay "thả"</em>.
      </p>
      <p class="mn-hero__lead">
        👉 Tuổi dậy thì không phải vấn đề cần "xử lý" — mà là <strong>nguồn năng lượng mạnh mẽ cần được dẫn dắt đúng cách</strong>.
      </p>
      <div class="mn-hero__badges">
        <span>💪 Bản lĩnh</span>
        <span>🧭 Tự chủ</span>
        <span>🎯 Định hướng tương lai</span>
      </div>
      <div class="mn-hero__trust">
        <div>🏫 <b>2 cơ sở chính thức</b> · Gò Vấp, Bình Tân</div>
        <div>👨‍👩‍👧 <b>3.000+ gia đình</b> tin tưởng</div>
        <div>🎓 <b>15 năm</b> đồng hành K12 từ 2011</div>
      </div>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Hiểu cách Việt Anh đồng hành tuổi dậy thì</h2>
      <p class="mn-hero__form-sub">Để lại email — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình EQ, PDR, Leader in Me cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        formId="ban-linh-thcs-hero"
        funnelCode="sales-thcs-ban-linh-hero"
        schoolLevel="thcs"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- VSL BLOCK (video + form ngay dưới Hero) -->
  <Fragment slot="video">
    <div class="sp-video__head">
      <span class="sp-video__eyebrow">▶ Xem trước 2 phút</span>
      <h2 class="sp-video__title">90% phụ huynh đang vô tình huỷ hoại kho báu của con ở tuổi dậy thì</h2>
      <p class="sp-video__sub">Cách giúp con chẳng những vượt qua khó khăn mà còn bứt phá ở tuổi dậy thì.</p>
    </div>

    <div class="sp-video__frame">
      <iframe
        src="https://www.youtube.com/embed/0vU8p-w4dho?rel=0"
        title="90% phụ huynh đang vô tình huỷ hoại kho báu của con ở tuổi dậy thì"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

  </Fragment>

  <!-- PAIN -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">🧠 GỐC RỄ VẤN ĐỀ</p>
    <h2>Vấn Đề Không Phải Là Tuổi Dậy Thì — Mà Là Không Có Người Dẫn Dắt Đúng</h2>
    <p>Rất nhiều học sinh bắt đầu thay đổi ở THCS: dễ nóng nảy hơn, bị ảnh hưởng bởi bạn bè, dành nhiều thời gian cho điện thoại, mất tập trung vào việc học.</p>
    <p>Phản ứng phổ biến của phụ huynh là kiểm soát chặt hơn, ép học nhiều hơn — hoặc buông xuôi. Nhưng cả 3 cách này đều không giải quyết gốc rễ.</p>
    <p style="padding:.75rem 1rem;border-left:3px solid #f9dd0e;margin:1rem 0;font-size:1rem">
      Bởi vì trẻ đang có <strong>nhu cầu khẳng định bản thân, năng lượng mạnh mẽ và sự tò mò với thế giới</strong>. Nếu không được dẫn dắt, năng lượng đó sẽ đi vào mạng xã hội và những lựa chọn thiếu kiểm soát.<br><br>
      👉 Nếu được dẫn dắt đúng, chính năng lượng đó sẽ trở thành <strong>động lực học tập, bản lĩnh cá nhân và định hướng tương lai</strong>.
    </p>
  </Fragment>

  <!-- FEATURES -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">MÔI TRƯỜNG THCS VIỆT ANH</p>
    <h2>Không "Kiểm Soát" Tuổi Dậy Thì — Mà Giúp Học Sinh Làm Chủ Nó</h2>
    <p class="sp-features__sub">8 yếu tố giúp học sinh THCS bứt phá đúng hướng, trưởng thành từ bên trong</p>
    <div class="sp-features__grid">

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">📘</div>
        <h3>Học thuật tích hợp tiếp nối quốc tế</h3>
        <p>Không gián đoạn từ tiểu học. Học sinh tiếp tục phát triển tư duy, khả năng tự học và nền tảng học thuật vững chắc.</p>
        <span class="sp-feat-card__tag">Học thuật</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">❤️</div>
        <h3>Phát triển cảm xúc &amp; xã hội (EQ)</h3>
        <p>Không né tránh tuổi dậy thì — mà giúp học sinh hiểu cảm xúc của mình, quản lý hành vi và xây dựng mối quan hệ lành mạnh.</p>
        <span class="sp-feat-card__tag">EQ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>PDR phát triển mạnh mẽ</h3>
        <p>Học sinh đặt mục tiêu, theo dõi tiến trình và tự đánh giá — bắt đầu tự chịu trách nhiệm với cuộc đời mình.</p>
        <span class="sp-feat-card__tag">Tự chủ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🤝</div>
        <h3>Đồng hành 2 lớp: GVCN + Buddy</h3>
        <p>Không để học sinh "tự bơi". Luôn có giáo viên chủ nhiệm và người đồng hành (Buddy) — hiểu, theo sát và hỗ trợ kịp thời.</p>
        <span class="sp-feat-card__tag">Đồng hành</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧭</div>
        <h3>Leader in Me &amp; 5 giá trị cốt lõi</h3>
        <p>Không chỉ nói về đạo đức — mà rèn thói quen, xây nền nhân cách và phát triển tư duy lãnh đạo bản thân.</p>
        <span class="sp-feat-card__tag">Nhân cách</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌐</div>
        <h3>Công dân số &amp; Digital Quotient</h3>
        <p>Không cấm công nghệ — dạy học sinh sử dụng mạng xã hội đúng cách, hiểu rủi ro và kiểm soát hành vi online.</p>
        <span class="sp-feat-card__tag">Digital</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🤖</div>
        <h3>AI Education</h3>
        <p>Học sinh hiểu AI, biết sử dụng AI đúng cách — dùng công nghệ để học, không bị công nghệ kiểm soát.</p>
        <span class="sp-feat-card__tag">AI</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🌍</div>
        <h3>Trải nghiệm &amp; định hướng tương lai</h3>
        <p>Không đợi đến cấp 3 mới định hướng — học sinh trải nghiệm, hiểu bản thân và bắt đầu nghĩ về tương lai từ THCS.</p>
        <span class="sp-feat-card__tag">Định hướng</span>
      </div>

    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">🌈 MỘT NGÀY TẠI THCS VIỆT ANH</p>
      <h2>Không Chỉ Học Kiến Thức — Mà Học Cách Trưởng Thành</h2>
      <p>Buổi sáng, học sinh không chỉ đến lớp — mà mang theo một mục tiêu cá nhân và một kế hoạch học tập.</p>
      <p>Trong lớp, học sinh tranh luận, phản biện. Giáo viên không áp đặt — mà dẫn dắt. Ngoài lớp là các buổi chia sẻ về mạng xã hội, dự án sử dụng AI, bài trình bày về định hướng cá nhân.</p>
      <p><strong>👉 Đây là lúc học sinh bắt đầu hiểu mình, kiểm soát mình và định hình tương lai.</strong></p>
      <a href="#mn-hero-form" style="display:inline-block;margin-top:1rem;background:#26275D;color:#fff;font-weight:700;padding:.75rem 1.5rem;border-radius:8px;text-decoration:none;font-size:.92rem">
        Tìm hiểu thêm về chương trình →
      </a>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://media.truongvietanh.com/images/du-an-03.webp"
        alt="Học sinh THCS Việt Anh học qua dự án"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">📊 SỰ THẬT VỀ TUỔI DẬY THÌ</p>
    <h2>Không Nguy Hiểm — Nhưng Rất Dễ Lệch Hướng</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">11–15</span>
        <span class="sp-stat__label">Tuổi — giai đoạn cảm xúc mạnh nhất, ảnh hưởng xã hội lớn nhất, quyết định hành vi nhiều nhất</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">9</span>
        <span class="sp-stat__label">Lĩnh vực phát triển toàn diện được theo dõi qua PDR cá nhân mỗi học kỳ</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">2</span>
        <span class="sp-stat__label">Lớp đồng hành — GVCN + Buddy — không học sinh nào bị bỏ lại phía sau</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">15+</span>
        <span class="sp-stat__label">Năm Việt Anh đồng hành cùng học sinh qua giai đoạn chuyển tiếp quan trọng nhất</span>
      </div>
    </div>
    <p style="margin-top:2rem;font-size:1rem;color:rgba(226,232,240,.75);line-height:1.8;max-width:680px;margin-left:auto;margin-right:auto">
      Được dẫn dắt đúng cách, học sinh THCS <strong style="color:#f9dd0e">trưởng thành nhanh hơn, tự chủ hơn và có định hướng rõ hơn</strong> — thay vì lệch hướng vì thiếu môi trường phù hợp.
    </p>
  </Fragment>

  <!-- QUOTE → Chị Quỳnh – THCS -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Con tôi vào THCS là giai đoạn tôi lo nhất — tuổi dậy thì, bạn bè, điện thoại. Nhưng Việt Anh không 'cấm' hay 'ép' — mà dạy con tự quản lý. Bây giờ con tự sắp xếp thời gian, tự đặt mục tiêu và tự chịu trách nhiệm. Đó là điều tôi mừng nhất."
      </p>
      <div class="sp-quote__author">
        <a href="https://www.youtube.com/watch?v=cZ6S_3MG1Vo" target="_blank" rel="noopener" style="position:relative;display:block;width:52px;height:52px;flex-shrink:0">
          <img
            src="https://img.youtube.com/vi/cZ6S_3MG1Vo/hqdefault.jpg"
            alt="Chị Quỳnh — Phụ huynh THCS"
            class="sp-quote__avatar"
            width="52"
            height="52"
            loading="lazy"
            style="object-fit:cover"
          />
          <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:50%">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 19,12 5,21"/></svg>
          </span>
        </a>
        <div>
          <div class="sp-quote__name">Chị Quỳnh</div>
          <div class="sp-quote__meta">Phụ huynh học sinh THCS · <a href="https://www.youtube.com/watch?v=cZ6S_3MG1Vo" target="_blank" rel="noopener" style="color:#26275D;font-weight:600;text-decoration:none">Xem video ▶</a></div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">💡 CHỌN MÔI TRƯỜNG ĐÚNG</p>
    <h2>Đây Không Phải Là Chọn Trường THCS</h2>
    <p class="sp-pricing__sub">Mà là chọn môi trường cho giai đoạn nhạy cảm nhất của con</p>

    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Chỉ dạy kiến thức</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem;text-decoration:none;color:#64748b">Ngắn hạn</div>
        <div class="sp-pricing-col__unit">điểm số cao — nhưng thiếu nền tảng</div>
        <ul class="sp-pricing-col__features">
          <li>Kiến thức theo chương trình</li>
          <li>Kiểm soát bằng quy định</li>
          <li style="color:#26275D">Không xử lý được cảm xúc</li>
          <li style="color:#26275D">Không có định hướng rõ</li>
          <li style="color:#26275D">Dễ lệch hướng khi áp lực lớn</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Đồng hành đúng cách</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem">Dài hạn</div>
        <div class="sp-pricing-col__unit">con người vững vàng — nền tảng bền vững</div>
        <ul class="sp-pricing-col__features">
          <li>Học thuật + EQ + PDR</li>
          <li>Tự quản lý cảm xúc &amp; hành vi</li>
          <li>Bản lĩnh &amp; định hướng rõ ràng</li>
          <li>Biết dùng công nghệ đúng cách</li>
          <li>Trưởng thành từ bên trong</li>
        </ul>
      </div>
    </div>

    <div style="background:#fffbf0;border:1.5px solid #f9dd0e;border-radius:12px;padding:1.5rem;margin-top:1.5rem;text-align:left">
      <p style="font-size:1rem;color:#475569;line-height:1.8;margin:0">
        Sự khác biệt không nằm ở điểm số — mà nằm ở <strong style="color:#26275D">con người mà con bạn trở thành</strong> sau 4 năm THCS.
      </p>
    </div>
    <p class="sp-pricing__note">* Liên hệ để nhận thông tin học phí và chương trình chi tiết.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Đừng Đợi Đến Khi Con Lệch Hướng Mới Tìm Giải Pháp</h2>
    <p>Bạn không cần quyết định ngay. Nhưng bạn nên hiểu rõ môi trường mà con sẽ trải qua trong giai đoạn nhạy cảm và quan trọng nhất.</p>
    <a href="#mn-hero-form" class="sp-cta-btn">📘 Nhận ngay Brochure chương trình →</a>
    <p class="sp-cta-block__note">Không spam · Tư vấn riêng theo tình trạng của con</p>
  </Fragment>

  <!-- FORM 1 -->
  <Fragment slot="form1">
    <div class="mn-hero__form" id="sp-form1-card" style="max-width:560px;margin:0 auto;text-align:left">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Hiểu cách Việt Anh đồng hành tuổi dậy thì</h2>
      <p class="mn-hero__form-sub">Để lại email — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình EQ, PDR, Leader in Me cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        formId="ban-linh-thcs-form1"
        funnelCode="sales-thcs-ban-linh"
        schoolLevel="thcs"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Những Điều Phụ Huynh Hay Hỏi</h2>
    <p class="sp-faq__sub">Câu trả lời thẳng thắn, không vòng vo</p>

    <details class="sp-faq-item">
      <summary>Tuổi dậy thì có nên "quản chặt" không?</summary>
      <div class="sp-faq-answer">
        Không. Quản lý mà không dẫn dắt sẽ khiến trẻ phản kháng hoặc giấu kín. Điều trẻ cần ở giai đoạn này là <strong>được hiểu, được đồng hành và được trao quyền tự chủ có hướng dẫn</strong> — chứ không phải bị kiểm soát chặt hơn.<br><br>
        Cha mẹ nên gần gũi, kiên nhẫn và học cách lắng nghe trước khi phản ứng.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Nếu con đang bị ảnh hưởng bởi điện thoại thì sao?</summary>
      <div class="sp-faq-answer">
        Cần dạy cách sử dụng, không chỉ cấm. Trẻ cần <strong>năng lực kiểm soát bản thân</strong>, không phải sự phụ thuộc vào kiểm soát bên ngoài. Khi bị cấm mà không được dạy lý do và cách dùng đúng, trẻ sẽ tìm cách né.<br><br>
        Tại Việt Anh, Digital Quotient được tích hợp vào chương trình giúp học sinh hiểu rủi ro và tự quyết định.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Trường có đảm bảo học lực không?</summary>
      <div class="sp-faq-answer">
        Có. Nhưng học lực tại Việt Anh đi cùng với <strong>tự học, tư duy và định hướng</strong> — không chỉ là điểm số tốt trong kỳ thi. Học sinh có nền tảng vững sẽ không chỉ học tốt ở THCS mà còn duy trì lợi thế lên THPT và đại học.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao biết con đang đi đúng hướng?</summary>
      <div class="sp-faq-answer">
        Khi con <strong>có mục tiêu, biết mình muốn gì và có trách nhiệm với lựa chọn của mình</strong> — đó là dấu hiệu đang đi đúng hướng.<br><br>
        Thông qua PDR định kỳ, phụ huynh sẽ thấy rõ con đang phát triển ở đâu và cần hỗ trợ thêm điều gì.
      </div>
    </details>
