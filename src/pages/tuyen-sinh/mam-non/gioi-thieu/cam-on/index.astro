---
/* Thank You — Referral */
const pageTitle = 'Giới Thiệu Thành Công — Mầm Non Việt Anh';
const pageDescription = 'Cảm ơn anh/chị đã giới thiệu bạn bè. Tư vấn viên sẽ liên hệ bạn được giới thiệu trong 24 giờ làm việc.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/mam-non/gioi-thieu/cam-on';
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />

  <style is:inline>:root{
      --n: #0C1E38;
      --b: #1A4D7C;
      --o: #f9dd0e;
      --od: #CF6A22;
      --w: #fff;
      --g1: #F5F7FA;
      --g6: #5F6B7A;
      --g8: #1C2A3A;
      --gn: #1AAB6E;
      --f: 'Open Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --primary: #4F46E5;
      --primary-dark: #4338CA;
    }*{ margin: 0; padding: 0; box-sizing: border-box; }body{
      font-family: var(--f);
      -webkit-font-smoothing: antialiased;
      font-size: 16px;
      color: var(--g8);
      background: linear-gradient(165deg, #EEF2FF 0%, #E0E7FF 40%, #C7D2FE 100%);
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }.logo-bar{
      text-align: center;
      padding: 24px 16px 0;
    }.logo-bar img{ height: 56px; opacity: .85; }.main{
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px 40px;
    }.card{
      background: var(--w);
      border-radius: 24px;
      padding: 48px 36px;
      max-width: 560px;
      width: 100%;
      box-shadow: 0 16px 60px rgba(0,0,0,.08);
      text-align: center;
    }.icon{ font-size: 56px; margin-bottom: 16px; }h1{
      font-family: 'Montserrat', var(--f);
      font-size: 28px;
      font-weight: 800;
      color: var(--n);
      line-height: 1.25;
      margin-bottom: 12px;
    }h1 .name{ color: var(--primary); }.msg{
      font-size: 18px;
      color: var(--g6);
      line-height: 1.6;
      margin-bottom: 24px;
    }.msg strong{ color: var(--n); }/* Countdown */
    .countdown-wrap{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(79,70,229,.1);
      border: 1px solid rgba(79,70,229,.2);
      color: var(--primary);
      padding: 10px 24px;
      border-radius: 20px;
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 28px;
    }/* Contact box */
    .contact-box{
      background: var(--g1);
      border-radius: 16px;
      padding: 20px 24px;
      margin-bottom: 32px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }.contact-box .label{
      font-size: 16px;
      color: var(--g6);
      font-weight: 600;
    }.contact-box .phones{
      display: flex;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
    }.contact-box a{
      font-size: 20px;
      font-weight: 800;
      color: var(--n);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }.contact-box a:hover{ color: var(--primary); }.zalo-badge{
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #0068FF;
      color: var(--w);
      padding: 4px 12px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 700;
    }/* Divider */
    .divider{
      height: 1px;
      background: #E8ECF0;
      margin: 0 0 28px;
    }/* CTAs */
    .cta-label{
      font-size: 16px;
      color: var(--g6);
      margin-bottom: 14px;
      font-weight: 600;
    }.ctas{ display: flex; flex-direction: column; gap: 12px; }.cta{
      display: block;
      width: 100%;
      padding: 16px 20px;
      border-radius: 14px;
      font-size: 17px;
      font-weight: 800;
      text-decoration: none;
      text-align: center;
      transition: all .2s;
      font-family: var(--f);
    }.cta-primary{
      background: var(--primary);
      color: var(--w);
      box-shadow: 0 4px 16px rgba(79,70,229,.3);
    }.cta-primary:hover{
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(79,70,229,.35);
    }.cta-secondary{
      background: var(--w);
      color: var(--primary);
      border: 2px solid var(--primary);
    }.cta-secondary:hover{
      background: #EEF2FF;
      transform: translateY(-1px);
    }/* Footer */
    .foot-note{
      font-size: 16px;
      color: var(--g6);
      margin-top: 24px;
      line-height: 1.5;
    }

    @media (max-width: 600px) {.card{ padding: 36px 20px; }h1{ font-size: 24px; }.msg{ font-size: 16px; }.contact-box a{ font-size: 18px; }
    }

    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600;700&display=swap&subset=vietnamese');
  </style>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'event': 'generate_lead',
      'page_title': 'Thank You - Giới Thiệu Mầm Non',
      'page_url': window.location.href,
      'school_level': 'mam-non',
      'funnel_code': 'referral-mn',
      'conversion_type': 'thank_you_page'
    });
  </script>
<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>
<!-- End Google Tag Manager -->
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <div class="logo-bar">
    <img src="/logo-vietanh.webp" alt="Trường Việt Anh" style="height:56px;width:auto" />
  </div>

  <div class="main">
    <div class="card">
      <div class="icon">🎁</div>
      <h1>Giới thiệu thành công!</h1>
      <p class="msg" id="msg">
        Cảm ơn anh/chị đã giới thiệu bạn bè.<br/>
        <strong>Tư vấn viên sẽ liên hệ bạn được giới thiệu trong 24 giờ làm việc.</strong>
      </p>

      <div class="countdown-wrap">
        Nhà trường sẽ liên hệ trong 24 giờ làm việc.
      </div>

      <div class="contact-box">
        <span class="label">Liên hệ ngay nếu cần hỗ trợ</span>
        <div class="phones">
          <a href="tel:0916961409">📞 0916 961 409</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">
            <span class="zalo-badge">Zalo</span> 0916 961 409
          </a>
        </div>
      </div>

      <div class="divider"></div>

      <div class="cta-label">Tiếp tục giới thiệu cho bạn bè khác:</div>
      <div class="ctas">
        <a href="/tuyen-sinh/mam-non/gioi-thieu" class="cta cta-primary">
          Giới thiệu thêm bạn bè
        </a>
        <a href="/tuyen-sinh/mam-non/chuong-trinh" class="cta cta-secondary">
          Xem chương trình học
        </a>
      </div>

      <p class="foot-note">
        Thông tin của anh/chị được bảo mật tuyệt đối.<br/>
        Chúng em luôn sẵn sàng đồng hành cùng con yêu.
      </p>
    </div>
  </div>

  <script is:inline>
    // Personalize with name from URL
    const params = new URLSearchParams(window.location.search);
    const name = params.get('name');
    if (name) {
      document.getElementById('msg').innerHTML =
        'Cảm ơn anh/chị <strong style="color:#4F46E5">' + name + '</strong> đã giới thiệu bạn bè.<br/>' +
        '<strong>Tư vấn viên sẽ liên hệ bạn được giới thiệu trong 24 giờ làm việc.</strong>';
    }

    // Countdown timer
    // countdown removed per A1
  </script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
