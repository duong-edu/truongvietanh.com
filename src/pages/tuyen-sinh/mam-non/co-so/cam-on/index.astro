  <div class="logo-bar">
    <img src="/logo-vietanh.webp" alt="Trường Việt Anh" style="height:56px;width:auto" />
  </div>

  <div class="main">
    <div class="card">
      <div class="icon">📍</div>
      <h1>Đăng ký thành công!</h1>
      <p class="msg" id="msg">
        Cảm ơn anh/chị đã chọn cơ sở.<br/>
        <strong>Tư vấn viên cơ sở gần nhất sẽ liên hệ trong 24 giờ làm việc</strong> qua Zalo hoặc điện thoại.
      </p>

      <div class="countdown-wrap">
        Nhà trường sẽ liên hệ trong 24 giờ làm việc.
      </div>

      <div class="contact-box">
        <span class="label">Liên hệ ngay nếu cần hỗ trợ</span>
        <div class="phones">
          <a href="tel:0916961409">📞 0916 961 409</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">
            <span class="zalo-badge">Zalo</span> 0916 961 409
          </a>
        </div>
      </div>

      <div class="divider"></div>

      <div class="cta-label">Bước tiếp theo:</div>
      <div class="ctas">
        <a href="/tuyen-sinh/mam-non/tham-quan-truong" class="cta cta-primary">
          Đặt lịch School Tour tại cơ sở
        </a>
        <a href="/tuyen-sinh/mam-non/chuong-trinh" class="cta cta-secondary">
          Xem chương trình học & hoạt động
        </a>
      </div>

      <p class="foot-note">
        Thông tin của anh/chị được bảo mật tuyệt đối.<br/>
        Chúng em luôn sẵn sàng đồng hành cùng con yêu.
      </p>
    </div>
  </div>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const name = params.get('name');
    if (name) {
      document.getElementById('msg').innerHTML =
        'Cảm ơn anh/chị <strong style="color:#f9dd0e">' + name + '</strong> đã chọn cơ sở.<br/>' +
        '<strong>Tư vấn viên cơ sở gần nhất sẽ liên hệ trong 24 giờ làm việc</strong> qua Zalo hoặc điện thoại.';
    }

    // countdown removed per A1
  </script>
    <script src="/js/phone-vn.js" defer></script>
