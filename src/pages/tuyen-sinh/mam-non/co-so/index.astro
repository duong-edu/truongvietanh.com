  <div class="logo-bar">
    <img src="/logo-vietanh-yellow.png" alt="Trường Việt Anh" loading="lazy" />
  </div>

  <div class="wrap">
    <div class="L">
      <div class="badge">
        <span class="dot"></span>
        📍 2 cơ sở tại Gò Vấp, TP.HCM
      </div>
      <h1>
        Mầm Non Việt Anh<br/>
        — Chỉ <em>7 phút</em> từ nhà<br/>
        2 cơ sở tại Gò Vấp, TP.HCM
      </h1>
      <p style="font-size: 16px; color: rgba(255,255,255,.7); margin-bottom: 16px;">
        <em style="color: #f9dd0e; font-style: normal; font-weight: 700;">300+ phụ huynh</em> đã gửi con em đến Việt Anh
      </p>
      <ul class="perks">
        <li><div class="ic">✓</div> 2 cơ sở tại Gò Vấp: Phan Huy Ích &amp; Lê Đức Thọ</li>
        <li><div class="ic">✓</div> Lớp học hiện đại thoáng mát, đạt tiêu chuẩn quốc tế</li>
        <li><div class="ic">✓</div> Shuttle bus đưa đón an toàn tận nơi</li>
        <li><div class="ic">✓</div> Bếp ăn riêng, dinh dưỡng theo chuẩn</li>
        <li><div class="ic">✓</div> Camera livestream 24/7, cha mẹ có thể theo dõi con em bất cứ lúc nào</li>
      </ul>
      <img src="https://media.truongvietanh.com/images/vui-ve-10.webp" alt="Cơ sở vật chất mầm non Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />
      <div class="proof">
        <b>312</b>
        <span>phụ huynh trong khu vực tin tưởng</span>
      </div>
      <div class="foot">
        📞 <a href="tel:0916961409">0916 961 409</a> · truongvietanh.com
      </div>
    </div>

    <div class="R">
      <div class="F">
        <!-- Step 1: Email -->
        <div class="s1" id="s1">
          <div class="sd"><i class="on"></i><i></i></div>
          <h2>Chọn cơ sở gần nhất</h2>
          <div class="fd">Tìm cơ sở phù hợp và nhận <b>ưu đãi riêng cho cơ sở của bạn</b></div>
          <div class="tq">Con bạn đang bao nhiêu tuổi? <span aria-hidden="true">*</span></div>
          <div class="tg" role="group">
            <button type="button" class="tb" data-t="12 – 23 tháng">12 – 23 tháng</button>
            <button type="button" class="tb" data-t="2 tuổi">2 tuổi</button>
            <button type="button" class="tb" data-t="3 tuổi">3 tuổi</button>
            <button type="button" class="tb" data-t="4 tuổi">4 tuổi</button>
            <button type="button" class="tb" data-t="5 tuổi">5 tuổi</button>
          </div>
          <div class="fm">🔒 Bảo mật · Tư vấn trong 5 phút</div>
          <div class="fb">
            <span>✓ Miễn phí</span>
            <span>✓ Không ràng buộc</span>
          </div>
        </div>

        <!-- Step 2: Name + Phone + Campus -->
        <div class="s2" id="s2">
          <div class="sd"><i class="ok"></i><i class="on"></i></div>
          <h2>Thêm 1 bước → nhận ưu đãi!</h2>
          <div class="fd">Tư vấn viên sẽ gọi trong <b>5 phút</b> để cá nhân hóa ưu đãi</div>
          <form id="f2">
            <div class="fg">
              <label>Họ tên ba/mẹ</label>
              <input type="text" id="nm" placeholder="Nguyễn Văn A" required />
            </div>
            <div class="fg">
              <label>Số điện thoại (Zalo)</label>
              <input type="tel" id="ph" placeholder="0912 345 678" required />
            </div>
            <div class="fg">
              <label>Email</label>
              <input type="email" id="email" placeholder="email@example.com" autocomplete="email" required />
            </div>
            <button type="submit" class="btn bo" id="b2">Nhận ưu đãi ngay 🎁</button>
          </form>
        </div>

        <!-- Success -->
        <div class="sok" id="sok">
          <div class="ck">🎉</div>
          <h3>Đăng ký thành công!</h3>
          <p>Tư vấn viên gọi trong 5 phút<br/>📞 <a href="tel:0916961409">0916 961 409</a></p>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    const WEBHOOK = '/api/lead';
    const $ = s => document.getElementById(s);

    let TUOI = '';
    document.querySelectorAll('.tb').forEach(btn => {
      btn.onclick = () => {
        TUOI = btn.dataset.t;
        $('s1').style.display = 'none';
        $('s2').style.display = 'block';
        window.dataLayer?.push({ event: 'lead_s1', tuoi: TUOI });
        $('nm').focus();
      };
    });

    $('f2').onsubmit = async e => {
      e.preventDefault();
      $('b2').disabled = 1;
      try {
        await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'full_submit',
            email: $('email').value.trim(),
            fullName: $('nm').value.trim(),
            phone: $('ph').value.trim(),
            tuoi_con: TUOI,
            note: 'Tuổi của con: ' + TUOI,
            school_level: 'mam-non',
            funnel_code: 'campus_mn',
            ...(window.__vaUTM ? window.__vaUTM() : {}),
            source: 'campus_mn',
            page: window.location.href,
            timestamp: new Date().toISOString()
          })
        });
      } catch (err) {
        console.error('[LeadForm] Step 2 error:', err);
      }
      ok();
      window.dataLayer?.push({ event: 'lead_done', variant: 'campus' });
    };

    function ok() {
      const name = $('nm')?.value?.trim() || '';
      const email = $('email')?.value?.trim() || '';
      window.location.href = '/cam-on?name=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email);
    }
  </script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
