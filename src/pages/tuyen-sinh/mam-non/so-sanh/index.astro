      </div>
      <div class="foot">
        📞 <a href="tel:0916961409">0916 961 409</a> · truongvietanh.com
      </div>
    </div>

    <div class="R">
      <div class="F">
        <!-- Step 1: Email -->
        <div class="s1" id="s1">
          <div class="sd"><i class="on"></i><i></i></div>
          <h2>Tải bảng so sánh miễn phí</h2>
          <div class="fd">PDF 15+ tiêu chí so sánh sẽ gửi <b>ngay vào email bạn</b></div>
          <div class="tq">Con bạn đang bao nhiêu tuổi? <span aria-hidden="true">*</span></div>
          <div class="tg" role="group">
            <button type="button" class="tb" data-t="12 – 23 tháng">12 – 23 tháng</button>
            <button type="button" class="tb" data-t="2 tuổi">2 tuổi</button>
            <button type="button" class="tb" data-t="3 tuổi">3 tuổi</button>
            <button type="button" class="tb" data-t="4 tuổi">4 tuổi</button>
            <button type="button" class="tb" data-t="5 tuổi">5 tuổi</button>
          </div>
          <div class="fm">🔒 Bảo mật · PDF gửi ngay</div>
          <div class="fb">
            <span>✓ Miễn phí</span>
            <span>✓ Không ràng buộc</span>
          </div>
        </div>

        <!-- Step 2: Name + Phone -->
        <div class="s2" id="s2">
          <div class="sd"><i class="ok"></i><i class="on"></i></div>
          <h2>Thêm 1 bước → nhận PDF chi tiết!</h2>
          <div class="fd"><b>567 phụ huynh</b> đã tải xuống — Hãy cùng họ so sánh</div>
          <form id="f2">
            <div class="fg">
              <label>Họ tên ba/mẹ</label>
              <input type="text" id="nm" placeholder="Nguyễn Văn A" required />
            </div>
            <div class="fg">
              <label>Số điện thoại (Zalo)</label>
              <input type="tel" id="ph" placeholder="0912 345 678" required />
            </div>
            <div class="fg">
              <label>Email</label>
              <input type="email" id="email" placeholder="email@example.com" autocomplete="email" required />
            </div>
            <button type="submit" class="btn bc" id="b2">Hoàn tất &amp; nhận PDF 📊</button>
          </form>
        </div>

        <!-- Success -->
        <div class="sok" id="sok">
          <div class="ck">🎉</div>
          <h3>Tải thành công!</h3>
          <p>Kiểm tra email để nhận bảng so sánh<br/>📞 <a href="tel:0916961409">0916 961 409</a></p>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    const WEBHOOK = '/api/lead';
    const $ = s => document.getElementById(s);

    let TUOI = '';
    document.querySelectorAll('.tb').forEach(btn => {
      btn.onclick = () => {
        TUOI = btn.dataset.t;
        $('s1').style.display = 'none';
        $('s2').style.display = 'block';
        window.dataLayer?.push({ event: 'lead_s1', tuoi: TUOI });
        $('nm').focus();
      };
    });

    $('f2').onsubmit = async e => {
      e.preventDefault();
      $('b2').disabled = 1;
      try {
        await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'full_submit',
            email: $('email').value.trim(),
            fullName: $('nm').value.trim(),
            phone: $('ph').value.trim(),
            tuoi_con: TUOI,
            note: 'Tuổi của con: ' + TUOI,
            school_level: 'mam-non',
            funnel_code: 'comparison_mn',
            ...(window.__vaUTM ? window.__vaUTM() : {}),
            source: 'comparison_mn',
            page: window.location.href,
            timestamp: new Date().toISOString()
          })
        });
      } catch (err) {
        console.error('[LeadForm] Step 2 error:', err);
      }
      ok();
      window.dataLayer?.push({ event: 'lead_done', variant: 'comparison' });
    };

    function ok() {
      const name = $('nm')?.value?.trim() || '';
      const email = $('email')?.value?.trim() || '';
      window.location.href = '/cam-on?name=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email);
    }
  </script>
    <script src="/js/phone-vn.js" defer></script>
