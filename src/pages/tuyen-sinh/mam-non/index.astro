---
import SalesPageLayout from '../../../layouts/SalesPageLayout.astro';
import LeadFormTwoStepEmailFirst from '../../../components/LeadFormTwoStepEmailFirst.astro';
---

<SalesPageLayout
  title="Mầm Non Việt Anh — Kích Hoạt Bản Năng Siêu Học Tập Của Con"
  description="Mỗi đứa trẻ đều sinh ra với bản năng siêu học tập — cần được kích hoạt trong môi trường đúng. Trường Mầm non Việt Anh: 6 cơ sở TP.HCM, Tây Ninh, An Giang. Nhận Brochure miễn phí."
  canonical="https://truongvietanh.com/tuyen-sinh/mam-non"
  ogImage="https://lh3.googleusercontent.com/d/1KFTzfN4Fe40bhmiJEmY_k9p3uClLUgiT"
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/mam-non-banner-chinh-1.jpg"
  programCode="mam-non"
  schoolLevel="mau-non"
  heroVariant="white-form"
  logoSrc="/logo-mam-non-trans.png"
  logoAlt="Trường Mầm Non Việt Anh"
>

  <!-- HERO — nền trắng + two-step form -->
  <Fragment slot="hero">
    <div class="mn-hero">
      <span class="mn-hero__eyebrow">🌱 Mầm Non Việt Anh · 0–6 tuổi</span>
      <h1>
        Mỗi đứa trẻ đều sinh ra với <span class="mn-hl">bản năng siêu học tập</span>
        <span class="mn-sub">cần được kích hoạt trong môi trường học tập an toàn suốt giai đoạn vàng 0–6 tuổi</span>
      </h1>
      <p class="mn-hero__lead">
        Không có đứa trẻ nào sinh ra mà <em>"không thích học"</em> — chỉ có những môi trường khiến trẻ dần mất đi sự tò mò, niềm vui khám phá và bắt đầu học cách ngồi yên.
      </p>
      <p class="mn-hero__lead">
        6 năm đầu đời không phải lúc để <em>"dạy con học trước"</em>, mà là giai đoạn quyết định <strong>cách con sẽ học, phát triển và sống</strong> suốt phần đời còn lại.
      </p>
      <div class="mn-hero__badges">
        <span>✨ Sự Tò Mò</span>
        <span>🎨 Tính Sáng Tạo</span>
        <span>💡 Yêu Việc Học</span>
      </div>
      <div class="mn-hero__trust">
        <div>🏫 <b>6 cơ sở</b> · TP.HCM, Tây Ninh, An Giang</div>
        <div>👨‍👩‍👧 <b>3.000+ gia đình</b> tin tưởng</div>
        <div>🎓 <b>15 năm</b> đồng hành K12 từ 2011</div>
      </div>
    </div>

    <div class="mn-hero__form" id="mn-hero-form">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Hiểu rõ phương pháp giáo dục của Việt Anh</h2>
      <p class="mn-hero__form-sub">Chọn tuổi của con và để lại thông tin — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình cá nhân hoá cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        mode="tuoi"
        formId="ban-nang-mam-non-hero"
        funnelCode="sales-mam-non-ban-nang-hero"
        schoolLevel="mau-non"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- VIDEO + FORM (ngay dưới Hero) -->
  <Fragment slot="video">
    <div class="sp-video__head">
      <h2 class="sp-video__title">Khám Phá Cách Việt Anh Kích Hoạt Bản Năng Siêu Học Tập Của Trẻ</h2>
    </div>

    <div class="sp-video__frame">
      <iframe
        src="https://www.youtube.com/embed/UoSR846JCRM?rel=0"
        title="Mầm non Việt Anh — Kích hoạt bản năng siêu học tập"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

  </Fragment>

  <!-- PAIN → Feature intro -->
  <Fragment slot="pain">
    <p class="sp-pain__eyebrow">🌱 TRIẾT LÝ GIÁO DỤC</p>
    <h2>Một Môi Trường Không "Dạy Trẻ Học"…<br>Mà Kích Hoạt Cách Trẻ Tự Học</h2>
    <p>Phần lớn các trường mầm non tập trung vào việc <em>trẻ học được gì</em>. Nhưng tại Việt Anh, chúng tôi tập trung vào một điều quan trọng hơn:</p>
    <p style="font-size:1.1rem;color:#26275D;font-weight:600;padding:.75rem 1rem;border-left:3px solid #f9dd0e;margin:1rem 0">
      👉 Trẻ học như thế nào… và có còn muốn học hay không.
    </p>
    <p>Khi một đứa trẻ được đặt trong đúng môi trường, việc học không còn là áp lực — mà trở thành một hành trình đầy hứng thú, mỗi ngày.</p>
  </Fragment>

  <!-- FEATURES → 6 feature cards -->
  <Fragment slot="features">
    <p class="sp-features__eyebrow">6 YẾU TỐ CỐT LÕI</p>
    <h2>Môi Trường Kích Hoạt Bản Năng Siêu Học Tập</h2>
    <p class="sp-features__sub">Không phải may mắn — đây là hệ thống được thiết kế để nuôi dưỡng đúng giai đoạn phát triển của con</p>
    <div class="sp-features__grid">

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🛡️</div>
        <h3>Môi trường an toàn về thể chất &amp; cảm xúc</h3>
        <p>Trẻ chỉ thực sự học khi cảm thấy an toàn — không sợ bị la mắng, không sợ làm sai, không sợ bị so sánh. Khi đó trẻ dám thử, dám hỏi, dám khám phá.</p>
        <span class="sp-feat-card__tag">An toàn</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🎯</div>
        <h3>Học qua chơi và trải nghiệm có chủ đích</h3>
        <p>Chơi không phải để "giữ trẻ bận rộn". Mỗi hoạt động tại Việt Anh đều kích thích tư duy, mở rộng trải nghiệm và gợi ra câu hỏi — trẻ đang học một cách tự nhiên nhất.</p>
        <span class="sp-feat-card__tag">Học qua chơi</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🧠</div>
        <h3>Kích hoạt bản năng siêu học tập</h3>
        <p>Trẻ không cần bị dạy quá nhiều. Thứ trẻ cần là môi trường đúng, cơ hội đúng, sự dẫn dắt đúng. Khi đó bản năng vốn có sẽ tự kích hoạt — trẻ tự tìm hiểu, tự thử nghiệm, tự rút ra bài học.</p>
        <span class="sp-feat-card__tag">Tự học</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">👀</div>
        <h3>Quan sát và hỗ trợ theo tiến trình cá nhân</h3>
        <p>Mỗi đứa trẻ là một nhịp phát triển khác nhau. Việt Anh khảo sát 9 lĩnh vực phát triển của mầm non — trẻ được quan sát liên tục, hiểu đúng nhu cầu, hỗ trợ đúng thời điểm.</p>
        <span class="sp-feat-card__tag">Cá nhân hóa</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">💬</div>
        <h3>Môi trường giàu ngôn ngữ và tương tác</h3>
        <p>Ngôn ngữ đến từ giao tiếp mỗi ngày, đặt câu hỏi, thể hiện suy nghĩ. Trẻ được khuyến khích nói lên suy nghĩ, lắng nghe người khác — từ đó phát triển giao tiếp tự nhiên và sâu sắc.</p>
        <span class="sp-feat-card__tag">Ngôn ngữ</span>
      </div>

      <div class="sp-feat-card">
        <div class="sp-feat-card__icon">🤝</div>
        <h3>Đồng hành chặt chẽ cùng phụ huynh</h3>
        <p>Giáo dục không dừng lại ở trường. Tại Việt Anh, phụ huynh hiểu rõ con đang phát triển như thế nào, biết cách hỗ trợ đúng tại nhà — không còn cảm giác cô đơn trong hành trình làm cha mẹ.</p>
        <span class="sp-feat-card__tag">Đồng hành</span>
      </div>

    </div>
  </Fragment>

  <!-- TEXT WITH IMAGE → Một ngày của trẻ -->
  <Fragment slot="textimg">
    <div class="sp-textimg__text">
      <p class="sp-textimg__eyebrow">🌈 MỘT NGÀY TẠI VIỆT ANH</p>
      <h2>Không Bắt Đầu Bằng "Hôm Nay Con Học Gì" — Mà Bằng "Con Muốn Khám Phá Điều Gì?"</h2>
      <p>Buổi sáng, trẻ đến trường không phải để ngồi ngay ngắn vào bàn học. Mà để chọn một góc chơi yêu thích, chạm vào những vật liệu mới, bắt đầu một cuộc khám phá nhỏ của riêng mình.</p>
      <p>Giáo viên không đứng lớp để "giảng dạy" — mà quan sát, lắng nghe và đặt câu hỏi: <em>"Con nghĩ điều gì sẽ xảy ra tiếp theo?"</em> Chính những câu hỏi đó mới là thứ mở ra tư duy.</p>
      <p>Buổi chiều, trẻ ra về không phải với một danh sách "hôm nay con học được bao nhiêu chữ" — mà với <strong>những câu chuyện muốn kể, những điều muốn thử lại</strong>, và một sự háo hức cho ngày mai.</p>
      <a href="#mn-hero-form" style="display:inline-block;margin-top:1rem;background:#26275D;color:#fff;font-weight:700;padding:.75rem 1.5rem;border-radius:8px;text-decoration:none;font-size:.92rem">
        Tìm hiểu thêm về chương trình →
      </a>
    </div>
    <div class="sp-textimg__img">
      <img
        src="https://lh3.googleusercontent.com/d/1YPDc_ytJS5kzmaoszabZ6pJ0UEbwjD3c"
        alt="Học sinh mầm non tại Trường Việt Anh"
        loading="lazy"
        width="600"
        height="400"
      />
    </div>
  </Fragment>

  <!-- STATS → 6 năm đầu đời -->
  <Fragment slot="stats">
    <p class="sp-stats__eyebrow">🧠 KHOA HỌC NÃO BỘ</p>
    <h2>6 Năm Đầu Đời — Giai Đoạn Quyết Định</h2>
    <div class="sp-stats__grid">
      <div class="sp-stat">
        <span class="sp-stat__num">~90%</span>
        <span class="sp-stat__label">Phát triển não bộ diễn ra trước 6 tuổi — giai đoạn không thể bù đắp sau này</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">9</span>
        <span class="sp-stat__label">Lĩnh vực phát triển được khảo sát và theo dõi cho từng trẻ mỗi 3 tháng</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">3,000+</span>
        <span class="sp-stat__label">Gia đình đã tin tưởng gửi gắm con tại Trường Việt Anh</span>
      </div>
      <div class="sp-stat">
        <span class="sp-stat__num">15+</span>
        <span class="sp-stat__label">Năm kinh nghiệm đồng hành cùng trẻ trong giai đoạn 0–6 tuổi</span>
      </div>
    </div>
    <p style="margin-top:2rem;font-size:1rem;color:rgba(226,232,240,.75);line-height:1.8;max-width:680px;margin-left:auto;margin-right:auto">
      Những gì diễn ra trong 6 năm đầu đời không chỉ ảnh hưởng — mà <strong style="color:#f9dd0e">định hình cách một đứa trẻ học và phát triển</strong> suốt phần đời còn lại. Bạn không thể quay lại giai đoạn này. Nhưng bạn có thể quyết định con sẽ trải qua nó như thế nào.
    </p>
  </Fragment>

  <!-- QUOTE → Testimonial Chị Linh -->
  <Fragment slot="quote">
    <p class="sp-quote__eyebrow">PHỤ HUYNH NÓI GÌ</p>
    <div class="sp-quote__card">
      <div class="sp-quote__stars">★★★★★</div>
      <p class="sp-quote__text">
        "Từ em bé bướng bỉnh, con đã biết tự ăn và vào nề nếp. Điều tôi thấy rõ nhất là con không còn sợ thử những điều mới nữa — con tự tin và tò mò một cách tự nhiên. Đó mới là thứ tôi muốn con có."
      </p>
      <div class="sp-quote__author">
        <a href="https://www.youtube.com/watch?v=Bt1yyMil3Tg" target="_blank" rel="noopener" style="position:relative;display:block;width:52px;height:52px;flex-shrink:0">
          <img
            src="https://img.youtube.com/vi/Bt1yyMil3Tg/hqdefault.jpg"
            alt="Chị Linh — Phụ huynh mầm non"
            class="sp-quote__avatar"
            width="52"
            height="52"
            loading="lazy"
            style="object-fit:cover"
          />
          <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.3);border-radius:50%">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><polygon points="5,3 19,12 5,21"/></svg>
          </span>
        </a>
        <div>
          <div class="sp-quote__name">Chị Linh</div>
          <div class="sp-quote__meta">Phụ huynh mầm non — bé 2 tuổi · <a href="https://www.youtube.com/watch?v=Bt1yyMil3Tg" target="_blank" rel="noopener" style="color:#26275D;font-weight:600;text-decoration:none">Xem video ▶</a></div>
        </div>
      </div>
    </div>
  </Fragment>

  <!-- PRICING → Đây không phải là học phí -->
  <Fragment slot="pricing">
    <p class="sp-pricing__eyebrow">💡 ĐẦU TƯ CHO CON</p>
    <h2>Đây Không Phải Là Học Phí</h2>
    <p class="sp-pricing__sub">Mà là cách bạn đầu tư vào 6 năm quan trọng nhất của con</p>

    <div class="sp-pricing__table">
      <div class="sp-pricing-col sp-pricing-col--regular">
        <div class="sp-pricing-col__label">Chọn trường vì "học trước"</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem;text-decoration:none;color:#64748b">Ngắn hạn</div>
        <div class="sp-pricing-col__unit">lợi thế chỉ kéo dài vài năm đầu</div>
        <ul class="sp-pricing-col__features">
          <li>Biết chữ sớm hơn một chút</li>
          <li>Làm toán nhanh hơn một chút</li>
          <li>Đi trước chương trình lớp 1</li>
          <li style="color:#26275D">Dễ mất sự tò mò tự nhiên</li>
          <li style="color:#26275D">Động lực học giảm dần</li>
        </ul>
      </div>
      <div class="sp-pricing-col sp-pricing-col--promo">
        <div class="sp-pricing-col__label">Chọn môi trường đúng cho con</div>
        <div class="sp-pricing-col__price" style="font-size:1.4rem">Dài hạn</div>
        <div class="sp-pricing-col__unit">nền tảng bền vững cho cả cuộc đời</div>
        <ul class="sp-pricing-col__features">
          <li>Giữ được sự tò mò tự nhiên</li>
          <li>Hình thành khả năng tự học</li>
          <li>Biết cách giao tiếp, hợp tác</li>
          <li>Tự tin khám phá thế giới</li>
          <li>Yêu việc học một cách bền vững</li>
        </ul>
      </div>
    </div>

    <div style="background:#fffbf0;border:1.5px solid #f9dd0e;border-radius:12px;padding:1.5rem;margin-top:1.5rem;text-align:left">
      <p style="font-size:1rem;color:#475569;line-height:1.8;margin:0">
        <strong style="color:#26275D">Câu hỏi đáng suy nghĩ:</strong> Không phải <em>"Học phí ở đây có cao không?"</em> — mà là <strong style="color:#26275D">"Nếu bỏ lỡ giai đoạn 0–6 tuổi này, mình có thể bù lại cho con sau này không?"</strong><br><br>
        Bạn có thể cho con học thêm khi lớn. Bạn có thể thay đổi trường khi cần. Nhưng bạn <strong>không thể quay lại giai đoạn 0–6 tuổi để làm lại từ đầu.</strong>
      </p>
    </div>
    <p class="sp-pricing__note">* Liên hệ để nhận thông tin học phí cụ thể theo từng cơ sở và gói đăng ký.</p>
  </Fragment>

  <!-- CTA -->
  <Fragment slot="cta">
    <h2>Đừng Chờ Đến Khi Con Mất Đi Sự Tò Mò</h2>
    <p>Bạn không cần quyết định ngay hôm nay. Nhưng bạn nên bắt đầu bằng việc <strong>hiểu rõ môi trường</strong> mà con mình sẽ trải qua trong những năm đầu đời quan trọng nhất.</p>
    <a href="#mn-hero-form" class="sp-cta-btn">📘 Nhận ngay Brochure chương trình →</a>
    <p class="sp-cta-block__note">Không spam · Không làm phiền · Mọi tư vấn hướng tới điều phù hợp nhất cho trẻ</p>
  </Fragment>

  <!-- FORM 1 — dùng chung card style xanh giống hero -->
  <Fragment slot="form1">
    <div class="mn-hero__form" id="sp-form1-card" style="max-width:560px;margin:0 auto;text-align:left">
      <span class="mn-hero__form-eyebrow">📘 Nhận Brochure miễn phí</span>
      <h2>Hiểu rõ phương pháp giáo dục của Việt Anh</h2>
      <p class="mn-hero__form-sub">Chọn tuổi của con và để lại thông tin — đội ngũ Việt Anh sẽ gửi Brochure &amp; tư vấn lộ trình cá nhân hoá cho con trong 24h.</p>
      <LeadFormTwoStepEmailFirst
        mode="tuoi"
        formId="ban-nang-mam-non-form1"
        funnelCode="sales-mam-non-ban-nang"
        schoolLevel="mau-non"
        submitText="Nhận Brochure ngay"
      />
    </div>
  </Fragment>

  <!-- FAQ -->
  <Fragment slot="faq">
    <p class="sp-faq__eyebrow">CÂU HỎI THƯỜNG GẶP</p>
    <h2>Những Câu Hỏi Phụ Huynh Thường Quan Tâm</h2>
    <p class="sp-faq__sub">Mọi câu hỏi đều được trả lời thẳng thắn</p>

    <details class="sp-faq-item">
      <summary>Trường có dạy trước chương trình lớp 1 không?</summary>
      <div class="sp-faq-answer">
        Không. Tại Việt Anh, chúng tôi không đặt mục tiêu "đi trước chương trình". Việc học trước có thể giúp trẻ biết sớm hơn, nhưng lại dễ làm mất đi sự tò mò, niềm vui học tập và khả năng tự khám phá.<br><br>
        Thay vào đó, chúng tôi tập trung giúp trẻ <strong>sẵn sàng để học tốt khi bước vào lớp 1</strong> — thay vì học trước một cách ngắn hạn.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Nếu không học trước, con có bị chậm hơn các bạn không?</summary>
      <div class="sp-faq-answer">
        Đây là nỗi lo rất phổ biến. Nhưng thực tế là: trẻ có thể "nhanh hơn" trong 1–2 năm đầu nếu học trước, nhưng lợi thế này thường không kéo dài. Trong khi đó, trẻ được phát triển đúng cách sẽ học nhanh hơn khi cần, hiểu sâu hơn và giữ được động lực học lâu dài.<br><br>
        👉 Điều quan trọng không phải là "ai bắt đầu sớm hơn" — mà là <strong>ai đi được xa hơn</strong>.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm sao để biết con tôi đang phát triển tốt?</summary>
      <div class="sp-faq-answer">
        Tại Việt Anh, trẻ không được đánh giá bằng điểm số. Thay vào đó, trẻ được quan sát liên tục theo 9 lĩnh vực phát triển. Mỗi 3 tháng phụ huynh nhận <strong>báo cáo tiến độ phát triển chi tiết</strong> — bạn sẽ thấy con giao tiếp tốt hơn, tự tin hơn, chủ động hơn. Đó mới là những dấu hiệu phát triển thật.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Trường khác gì so với Montessori hay các trường quốc tế?</summary>
      <div class="sp-faq-answer">
        Việt Anh không cố gắng "theo một phương pháp cụ thể". Chúng tôi tập trung vào một nguyên lý cốt lõi: <strong>kích hoạt bản năng siêu học tập vốn có trong mỗi đứa trẻ</strong>. Điều này được thực hiện qua môi trường được thiết kế có chủ đích, giáo viên hiểu đúng vai trò quan sát &amp; dẫn dắt, và trải nghiệm học tập phù hợp với từng giai đoạn phát triển.<br><br>
        👉 Không phải phương pháp nào tốt, mà là cách áp dụng có phù hợp với trẻ hay không.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Phụ huynh có được theo sát quá trình của con không?</summary>
      <div class="sp-faq-answer">
        Có — và đây là một phần rất quan trọng. Tại Việt Anh, phụ huynh được cập nhật thường xuyên, hiểu rõ con đang phát triển ở đâu và biết cách đồng hành cùng con tại nhà.<br><br>
        👉 Bạn không còn cảm giác <em>"gửi con đi học rồi không biết con đang như thế nào"</em>.
      </div>
    </details>

    <details class="sp-faq-item">
      <summary>Làm thế nào để phụ huynh kiểm soát chất lượng của trường?</summary>
      <div class="sp-faq-answer">
        Nhà trường có hệ thống <strong>camera tất cả các lớp học và khuôn viên</strong> — phụ huynh có thể quan sát bất cứ lúc nào. Ban Lãnh Đạo kiểm soát bằng checklist hàng ngày tại tất cả các lớp. Toàn hệ thống có <strong>camera tích hợp trí tuệ nhân tạo giám sát 24/7</strong>.<br><br>
        👉 Sự an toàn và chất lượng là điều không bao giờ chúng tôi thỏa hiệp.
      </div>
    </details>
