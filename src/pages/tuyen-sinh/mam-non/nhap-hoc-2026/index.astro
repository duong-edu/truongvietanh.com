  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Mầm Non Việt Anh",
    "url": "https://truongvietanh.com/tuyen-sinh/mam-non/nhap-hoc-2026",
    "description": "Đăng ký nhập học tháng 9/2026: Giảm 20% học phí tháng đầu + Tặng đồng phục 2 triệu. Miễn phí trải nghiệm 1 tuần. Hạn 30/04/2026.",
    "telephone": "+84-916-961-409",
    "address": {"@type": "PostalAddress", "addressLocality": "TP. Hồ Chí Minh", "addressCountry": "VN"},
    "parentOrganization": {"@type": "EducationalOrganization", "name": "Trường Liên Cấp Việt Anh", "url": "https://truongvietanh.com"}
  }
  </script>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

  <div class="logo-bar">
    <img src="/logo-vietanh-yellow.png" alt="Trường Việt Anh" loading="lazy" />
  </div>

  <div class="wrap">
    <div class="L">
      <div class="badge">
        <span class="dot"></span>
        ☀️ Ưu đãi hè 2026 · Hạn cuối 30/04
      </div>
      <h1>
        Chuẩn Bị Con Nhập Học<br/>
        <em>Ưu Đãi Hè Đặc Biệt</em><br/>
        Tháng 9/2026
      </h1>
      <ul class="perks">
        <li><div class="ic">📚</div> Giảm 20% học phí tháng đầu — Tiết kiệm được 3-5 triệu</li>
        <li><div class="ic">👕</div> Tặng bộ đồng phục (không tính tiền)</li>
        <li><div class="ic">🎓</div> Miễn phí 1 tuần trải nghiệm để con quen với trường</li>
        <li><div class="ic">🏫</div> Ưu tiên chọn lớp học đầu tiên & cơ sở yêu thích</li>
        <li><div class="ic">⏰</div> Hạn cuối 30/04/2026</li>
      </ul>
      <img src="https://media.truongvietanh.com/images/vui-ve-09.webp" alt="Bé nhập học mầm non 2026" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />
      <div class="proof">
        <b>203</b>
        <span>phụ huynh đã đăng ký nhập học 2026</span>
      </div>
      <div class="foot">
        📞 <a href="tel:0916961409">0916 961 409</a> · truongvietanh.com
      </div>
    </div>

    <div class="R">
      <div class="F">
        <!-- Step 1: Email -->
        <div class="s1" id="s1">
          <div class="sd"><i class="on"></i><i></i></div>
          <h2>Đăng ký ưu đãi hè ngay</h2>
          <div class="fd">Còn <b>29 ngày</b> để cùng con bắt đầu hành trình mới</div>
          <form id="f1">
            <div class="fg">
              <label>Email của ba/mẹ</label>
              <input type="email" id="email" placeholder="email@example.com" autocomplete="email" required />
            </div>
            <button type="submit" class="btn bs" id="b1">Nhận ưu đãi hè ngay →</button>
          </form>
          <div class="fm">🔒 Bảo mật · Phản hồi trong 24 giờ làm việc</div>
          <div class="fb">
            <span>✓ Miễn phí</span>
            <span>✓ Không ràng buộc</span>
          </div>
        </div>

        <!-- Step 2: Name + Phone -->
        <div class="s2" id="s2">
          <div class="sd"><i class="ok"></i><i class="on"></i></div>
          <h2>Thêm 1 bước → hoàn tất đăng ký!</h2>
          <div class="fd"><b>203 phụ huynh</b> đã chuẩn bị sẵn sàng — Bạn sẽ là người tiếp theo</div>
          <form id="f2">
            <div class="fg">
              <label>Họ tên ba/mẹ</label>
              <input type="text" id="nm" placeholder="Nguyễn Văn A" required />
            </div>
            <div class="fg">
              <label>Số điện thoại (Zalo)</label>
              <input type="tel" id="ph" placeholder="0912 345 678" required />
            </div>
            <button type="submit" class="btn bs" id="b2">Hoàn tất &amp; nhận quà 🎁</button>
          </form>
          <div class="fm"><a href="#" id="sk">Bỏ qua →</a></div>
        </div>

        <!-- Success -->
        <div class="sok" id="sok">
          <div class="ck">🎉</div>
          <h3>Đăng ký thành công!</h3>
          <p>Nhà trường liên hệ trong 24 giờ làm việc<br/>📞 <a href="tel:0916961409">0916 961 409</a></p>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    const WEBHOOK = '/api/lead';
    const $ = s => document.getElementById(s);

    $('f1').onsubmit = async e => {
      e.preventDefault();
      const b = $('b1'), v = $('email').value.trim();
      if (!v) return;
      b.disabled = 1;
      b.textContent = 'Đang gửi...';
      try {
        await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'partial_capture',
            email: v,
            source: 'seasonal_mn',
            page: window.location.href,
            ...(window.__vaUTM ? window.__vaUTM() : {}),
            timestamp: new Date().toISOString()
          })
        });
      } catch (err) {
        console.error('[LeadForm] Step 1 error:', err);
      }
      $('s1').style.display = 'none';
      $('s2').style.display = 'block';
      window.dataLayer?.push({ event: 'lead_s1', variant: 'seasonal', email: v });
    };

    $('f2').onsubmit = async e => {
      e.preventDefault();
      $('b2').disabled = 1;
      try {
        await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'full_submit',
            email: $('email').value.trim(),
            fullName: $('nm').value.trim(),
            phone: $('ph').value.trim(),
            source: 'seasonal_mn',
            page: window.location.href,
            timestamp: new Date().toISOString()
          })
        });
      } catch (err) {
        console.error('[LeadForm] Step 2 error:', err);
      }
      ok();
      window.dataLayer?.push({ event: 'lead_done', variant: 'seasonal' });
    };

    $('sk').onclick = e => { e.preventDefault(); ok(); };

    function ok() {
      const name = $('nm')?.value?.trim() || '';
      const email = $('email')?.value?.trim() || '';
      window.location.href = '/cam-on?name=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email);
    }
  </script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
