  <div class="logo-bar">
    <img src="/logo-vietanh.webp" alt="Trường Việt Anh" style="height:56px;width:auto" />
  </div>

  <div class="main">
    <div class="card">
      <div class="icon">🎉</div>
      <h1>Đặt lịch thành công!</h1>
      <p class="msg" id="msg">
        Cảm ơn anh/chị đã đặt lịch tham quan Mầm Non Việt Anh.<br/>
        <strong>Tư vấn viên sẽ gọi xác nhận trong 24 giờ làm việc</strong> qua Zalo hoặc điện thoại.
      </p>

      <div class="countdown-wrap">
        ⏰ Tư vấn viên gọi trong <span id="cd">5:00</span>
      </div>

      <div class="contact-box">
        <span class="label">Liên hệ ngay nếu cần hỗ trợ</span>
        <div class="phones">
          <a href="tel:0916961409">📞 0916 961 409</a>
          <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener">
            <span class="zalo-badge">Zalo</span> 0916 961 409
          </a>
        </div>
      </div>

      <div class="divider"></div>

      <div class="cta-label">Trong khi chờ tư vấn viên gọi:</div>
      <div class="ctas">
        <a href="/tuyen-sinh/mam-non/chuong-trinh" class="cta cta-primary">
          Xem chương trình học & hoạt động của bé
        </a>
        <a href="/tuyen-sinh/mam-non/dang-ky-som" class="cta cta-secondary">
          Xem ưu đãi học phí — Early Bird giảm từ 6–46%
        </a>
      </div>

      <p class="foot-note">
        Thông tin của anh/chị được bảo mật tuyệt đối.<br/>
        Chúng em rất mong được đón con yêu đến thăm trường.
      </p>
    </div>
  </div>

  <script is:inline>
    const params = new URLSearchParams(window.__vaQS != null ? window.__vaQS : window.location.search);
    const name = params.get('name');
    if (name) {
      document.getElementById('msg').innerHTML =
        'Cảm ơn anh/chị <strong style="color:#16A34A">' + name + '</strong> đã đặt lịch tham quan Mầm Non Việt Anh.<br/>' +
        '<strong>Tư vấn viên sẽ gọi xác nhận trong 24 giờ làm việc</strong> qua Zalo hoặc điện thoại.';
    }

    let seconds = 300;
    const cdEl = document.getElementById('cd');
    const timer = setInterval(() => {
      seconds--;
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      cdEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;
      if (seconds <= 0) {
        clearInterval(timer);
        cdEl.textContent = 'ngay bây giờ...';
      }
    }, 1000);
  </script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>