---
/* Sales Page — Chương Trình Mầm Non Việt Anh */
const pageTitle = 'Chương Trình Mầm Non Việt Anh — Nơi Con Yêu Phát Triển Toàn Diện';
const pageDescription = 'Khám phá chương trình mầm non song ngữ Oxford tại Trường Việt Anh. Môi trường an toàn, yêu thương, phát triển toàn diện cho bé từ 12 tháng.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/mam-non/chuong-trinh';
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <style is:inline>:root{
      --n: #0C1E38;
      --b: #1A4D7C;
      --o: #f9dd0e;
      --od: #CF6A22;
      --w: #fff;
      --g1: #F5F7FA;
      --g2: #DFE3E8;
      --g6: #5F6B7A;
      --g8: #1C2A3A;
      --gn: #1AAB6E;
      --f: 'Open Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }*{ margin: 0; padding: 0; box-sizing: border-box; }body{
      font-family: var(--f);
      -webkit-font-smoothing: antialiased;
      font-size: 16px;
      color: var(--g8);
      background: var(--w);
    }/* Nav */
    .nav{
      background: var(--w);
      border-bottom: 1px solid var(--g2);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }.nav img{ height: 44px; }/* Hero */
    .hero{
      background: linear-gradient(165deg, #0A1628 0%, var(--n) 40%, var(--b) 100%);
      color: var(--w);
      text-align: center;
      padding: 64px 24px 56px;
    }.hero h1{
      font-family: 'Montserrat', var(--f);
      font-size: clamp(28px, 5vw, 42px);
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 16px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }.hero p{
      font-size: 20px;
      color: rgba(255,255,255,.75);
      max-width: 600px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }.hero .cta-btn{
      display: inline-block;
      background: var(--o);
      color: var(--w);
      padding: 16px 40px;
      border-radius: 14px;
      font-size: 18px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 4px 20px rgba(249, 221, 14,.35);
      transition: all .2s;
    }.hero .cta-btn:hover{
      background: var(--od);
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(249, 221, 14,.4);
    }/* Section */
    .section{
      max-width: 900px;
      margin: 0 auto;
      padding: 56px 24px;
    }.section h2{
      font-family: 'Montserrat', var(--f);
      font-size: 28px;
      font-weight: 800;
      color: var(--n);
      text-align: center;
      margin-bottom: 40px;
      line-height: 1.3;
    }/* Feature grid */
    .features{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }.feature-card{
      background: var(--g1);
      border-radius: 20px;
      padding: 32px 24px;
      transition: transform .2s;
      border: 2px solid #f9dd0e;
    }.feature-card:hover{ transform: translateY(-4px); }.feature-card .emoji{ font-size: 36px; margin-bottom: 12px; }.feature-card h3{
      font-size: 24px;
      font-weight: 800;
      color: #f9dd0e;
      margin-bottom: 8px;
    }.feature-card p{
      font-size: 16px;
      color: #555;
      line-height: 1.6;
    }/* Benefits list */
    .benefits{
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }.benefits li{
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }.benefits .emoji{ font-size: 32px; flex-shrink: 0; }.benefits h4{
      font-size: 24px;
      font-weight: 800;
      color: #f9dd0e;
      margin-bottom: 4px;
    }.benefits p{
      font-size: 16px;
      color: #555;
      line-height: 1.5;
    }/* Stats */
    .stats-row{
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }.stat-item{
      background: var(--g1);
      border-radius: 16px;
      padding: 24px 32px;
      text-align: center;
      min-width: 140px;
    }.stat-item .num{
      font-size: 32px;
      font-weight: 800;
      color: var(--b);
      display: block;
    }.stat-item .label{
      font-size: 16px;
      color: var(--g6);
      margin-top: 4px;
    }/* CTA Banner */
    .cta-banner{
      background: linear-gradient(135deg, var(--n) 0%, var(--b) 100%);
      color: var(--w);
      border-radius: 24px;
      padding: 48px 36px;
      text-align: center;
      margin: 0 auto;
      max-width: 900px;
    }.cta-banner h3{
      font-family: 'Montserrat', var(--f);
      font-size: 26px;
      font-weight: 800;
      margin-bottom: 12px;
    }.cta-banner p{
      font-size: 18px;
      color: rgba(255,255,255,.8);
      margin-bottom: 28px;
      line-height: 1.5;
    }.cta-banner .btn-group{
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }.cta-banner a{
      display: inline-block;
      padding: 16px 32px;
      border-radius: 14px;
      font-size: 17px;
      font-weight: 800;
      text-decoration: none;
      transition: all .2s;
      font-family: var(--f);
    }.cta-banner .btn-primary{
      background: var(--o);
      color: var(--w);
      box-shadow: 0 4px 16px rgba(249, 221, 14,.35);
    }.cta-banner .btn-primary:hover{
      background: var(--od);
      transform: translateY(-2px);
    }.cta-banner .btn-secondary{
      background: rgba(255,255,255,.15);
      color: var(--w);
      border: 2px solid rgba(255,255,255,.3);
    }.cta-banner .btn-secondary:hover{
      background: rgba(255,255,255,.25);
    }/* Footer */
    .footer{
      text-align: center;
      padding: 40px 24px;
      color: var(--g6);
      font-size: 16px;
    }.footer a{
      color: var(--o);
      text-decoration: none;
      font-weight: 700;
    }/* Divider */
    .section-divider{
      height: 1px;
      background: var(--g2);
      max-width: 200px;
      margin: 0 auto;
    }

    @media (max-width: 700px) {.features{ grid-template-columns: 1fr; }.hero{ padding: 48px 16px 40px; }.hero p{ font-size: 17px; }.section{ padding: 40px 16px; }.section h2{ font-size: 24px; }.cta-banner{ padding: 36px 20px; margin: 0 16px; }.cta-banner h3{ font-size: 24px; }.cta-banner .btn-group{ flex-direction: column; }.cta-banner a{ width: 100%; text-align: center; }.stat-item{ min-width: 100px; padding: 16px 20px; }.stat-item .num{ font-size: 26px; }
    }

    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600;700&display=swap&subset=vietnamese');
  </style>

