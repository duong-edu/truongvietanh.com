---
/* Parent Testimonial Landing Page */
const pageTitle = 'Sau 8 tháng, con tôi tự tin nói tiếng Anh và yêu trường — Chị Lan, Gò Vấp';
const pageDescription = 'Khám phá 3 câu chuyện cảm động của phụ huynh Mầm Non Việt Anh. Con tôi từ nhút nhát thành tự tin, bé thích đi học mỗi ngày, giáo viên yêu thương như mẹ.';
const canonicalUrl = 'https://truongvietanh.com/tuyen-sinh/mam-non/cau-chuyen-phu-huynh';
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <style is:inline>:root{
      --n: #0C1E38;
      --b: #D97706;
      --o: #FCD34D;
      --od: #B45309;
      --w: #fff;
      --g1: #F5F7FA;
      --g2: #DFE3E8;
      --g6: #5F6B7A;
      --g8: #1C2A3A;
      --gn: #1AAB6E;
      --f: 'Open Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    }*{ margin: 0; padding: 0; box-sizing: border-box; }body{
      font-family: var(--f);
      -webkit-font-smoothing: antialiased;
      font-size: 16px;
      color: var(--w);
      background: linear-gradient(165deg, #1F1410 0%, #2D1810 40%, #3D2415 100%);
      min-height: 100vh;
      min-height: 100dvh;
    }/* Logo */
    .logo-bar{
      text-align: center;
      padding: 20px 12px 0;
    }.logo-bar img{
      height: 64px;
      opacity: .9;
      loading: lazy;
    }/* Layout */
    .wrap{
      display: flex;
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px 16px 32px;
      gap: 44px;
      align-items: center;
      min-height: calc(100vh - 84px);
      min-height: calc(100dvh - 84px);
    }.L{ flex: 1; }.R{ width: 480px; flex-shrink: 0; }/* Badge */
    .badge{
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(252,211,77,.2);
      border: 1px solid rgba(252,211,77,.35);
      color: var(--o);
      padding: 6px 16px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 16px;
    }.badge .dot{
      width: 6px;
      height: 6px;
      background: var(--o);
      border-radius: 50%;
      animation: p 1.5s infinite;
    }
    @keyframes p {0%, 100%{ opacity: 1; }50%{ opacity: .3; }
    }/* Heading */
    h1{
      font-family: 'Montserrat', var(--f);
      font-size: clamp(28px, 4.5vw, 38px);
      font-weight: 800;
      line-height: 1.18;
      margin-bottom: 20px;
    }h1 em{
      color: #f9dd0e;
      font-style: normal;
    }/* Subheadline */
    .sub{
      font-size: 18px;
      color: rgba(255,255,255,.7);
      margin-bottom: 16px;
      font-style: italic;
    }/* Perks list */
    .perks{
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 24px;
    }.perks li{
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
      color: rgba(255,255,255,.85);
    }.perks .ic{
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,.08);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }/* Social proof */
    .proof{
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: rgba(255,255,255,.06);
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,.08);
      margin-bottom: 16px;
    }.proof b{
      font-size: 26px;
      color: var(--o);
      line-height: 1;
    }.proof span{
      font-size: 16px;
      color: rgba(255,255,255,.55);
      line-height: 1.3;
    }/* Footer contact */
    .foot{
      font-size: 16px;
      color: rgba(255,255,255,.5);
      text-align: center;
    }.foot a{
      color: var(--o);
      text-decoration: none;
      font-weight: 600;
    }/* FORM CARD */
    .F{
      background: var(--w);
      border-radius: 20px;
      padding: 32px 28px;
      box-shadow: 0 20px 60px rgba(0,0,0,.4);
      color: var(--g8);
    }.F h2{
      font-family: 'Montserrat', var(--f);
      font-size: 24px;
      font-weight: 800;
      color: #f9dd0e;
      text-align: center;
      line-height: 1.25;
      margin-bottom: 4px;
    }.F .fd{
      font-size: 16px;
      color: #555;
      text-align: center;
      margin-bottom: 18px;
      font-weight: 500;
    }.F .fd b{ color: #f9dd0e; }/* Step dots */
    .sd{
      display: flex;
      justify-content: center;
      gap: 5px;
      margin-bottom: 14px;
    }.sd i{
      display: block;
      height: 4px;
      border-radius: 2px;
      background: var(--g2);
      width: 30px;
      transition: .3s;
    }.sd i.on{ background: var(--b); width: 48px; }.sd i.ok{ background: var(--gn); }.tq{font-weight:700;font-size:15px;color:var(--b,#26275D);margin:4px 0 10px}.tq span{color:#b91c1c}.tg{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-bottom:10px}.tb{padding:13px 8px;border:2px solid #cbd5e1;border-radius:10px;background:#fff;color:var(--b,#26275D);font:inherit;font-weight:800;font-size:15px;cursor:pointer;transition:.15s}.tb:hover,.tb:focus-visible{border-color:var(--b,#26275D);background:#fffbe0;outline:none}.tb:last-child:nth-child(odd){grid-column:1/-1}
    /* Form fields */
    .fg{ margin-bottom: 14px; }.fg label{
      display: block;
      font-size: 16px;
      font-weight: 600;
      color: var(--g8);
      margin-bottom: 4px;
    }.fg input{
      width: 100%;
      padding: 14px 14px;
      border: 2px solid var(--g2);
      border-radius: 10px;
      font-size: 16px;
      font-family: var(--f);
      background: var(--g1);
      transition: .15s;
    }.fg input:focus{
      outline: 0;
      border-color: var(--b);
      background: var(--w);
      box-shadow: 0 0 0 3px rgba(217,119,6,.12);
    }/* Buttons */
    .btn{
      width: 100%;
      padding: 18px 16px;
      border: none;
      border-radius: 11px;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer;
      font-family: var(--f);
      transition: all .2s;
      min-height: 56px;
    }.bo{
      background: var(--b);
      color: var(--w);
      box-shadow: 0 4px 16px rgba(217,119,6,.35);
    }.bo:hover{
      background: var(--od);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(217,119,6,.4);
    }.btn:disabled{
      opacity: .5;
      cursor: default;
      transform: none;
      box-shadow: none;
    }/* Form meta */
    .fm{
      text-align: center;
      font-size: 16px;
      color: var(--g6);
      margin-top: 10px;
    }.fm a{
      color: var(--b);
      font-weight: 600;
    }.fb{
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-top: 8px;
      font-size: 16px;
      color: var(--g6);
    }/* Steps */
    .s2, .sok{ display: none; }.sok{
      text-align: center;
      padding: 16px 0;
    }.sok .ck{
      font-size: 40px;
      margin-bottom: 8px;
    }.sok h3{
      font-size: 24px;
      color: var(--n);
      font-weight: 800;
    }.sok p{
      font-size: 16px;
      color: var(--g6);
      margin-top: 6px;
      line-height: 1.5;
    }.sok a{
      color: var(--b);
      font-weight: 700;
      text-decoration: none;
      font-size: 17px;
    }

    /* Responsive */
    @media (max-width: 800px) {.wrap{
        flex-direction: column;
        padding: 16px 12px 24px;
        gap: 24px;
        min-height: auto;
      }.L{
        text-align: center;
        align-items: center;
        display: flex;
        flex-direction: column;
      }h1{ font-size: 26px; }.perks{
        align-items: flex-start;
        max-width: 340px;
      }.proof{ justify-content: center; }.R{ width: 100%; max-width: 380px; }.F{ padding: 26px 20px; }
    }

    /* Google Fonts */
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600;700&display=swap&subset=vietnamese');
  </style>

