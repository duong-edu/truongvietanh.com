  <div class="logo-bar">
    <img src="/logo-vietanh-yellow.png" alt="Trường Việt Anh" loading="lazy" />
  </div>

  <div class="wrap">
    <div class="L">
      <div class="badge">
        <span class="dot"></span>
        ❤️ Câu chuyện phụ huynh
      </div>
      <h1>
        Sau 8 tháng, con tôi<br/>
        <em>tự tin nói tiếng Anh</em><br/>
        và yéu trường
      </h1>
      <div class="sub">— Chị Lan, phụ huynh Mầm Non Việt Anh, Gò Vấp</div>
      <ul class="perks">
        <li><div class="ic">❤️</div> "Con tôi từ nhút nhát thành cô bé tự tin nói tiếng Anh" — Chị Mai</li>
        <li><div class="ic">❤️</div> "Bé vui vẻ kéo tôi đi học mỗi sáng, không muốn về nhà" — Anh Tuấn</li>
        <li><div class="ic">❤️</div> "Cô giáo yêu thương con như mẹ đẻ" — Chị Hằng</li>
        <li><div class="ic">❤️</div> "Bé phát triển toàn diện về thể chất, trí tuệ và tình cảm" — Chị Hợp</li>
        <li><div class="ic">✓</div> Nhận 3 câu chuyện thực tế đầy đủ + tư vấn cá nhân hóa lộ trình học tập</li>
      </ul>
      <img src="https://media.truongvietanh.com/images/phu-huynh-01.webp" alt="Phụ huynh chia sẻ về mầm non Việt Anh" loading="lazy" width="1200" height="auto" style="border-radius:12px;width:100%;height:auto;margin:1.5rem 0" />
      <div class="proof">
        <b>1.200+</b>
        <span>phụ huynh tin tưởng</span>
      </div>
      <div class="foot">
        📞 <a href="tel:0916961409">0916 961 409</a> · truongvietanh.com
      </div>
    </div>

    <div class="R">
      <div class="F">
        <!-- Step 1: Email -->
        <div class="s1" id="s1">
          <div class="sd"><i class="on"></i><i></i></div>
          <h2>Nhận 3 câu chuyện phụ huynh</h2>
          <div class="fd">Nghe từ những phụ huynh thực tế về sự thay đổi rõ rệt của con em</div>
          <div class="tq">Con bạn đang bao nhiêu tuổi? <span aria-hidden="true">*</span></div>
          <div class="tg" role="group">
            <button type="button" class="tb" data-t="12 – 23 tháng">12 – 23 tháng</button>
            <button type="button" class="tb" data-t="2 tuổi">2 tuổi</button>
            <button type="button" class="tb" data-t="3 tuổi">3 tuổi</button>
            <button type="button" class="tb" data-t="4 tuổi">4 tuổi</button>
            <button type="button" class="tb" data-t="5 tuổi">5 tuổi</button>
          </div>
          <div class="fm">🔒 Bảo mật · Gửi ngay</div>
          <div class="fb">
            <span>✓ Miễn phí</span>
            <span>✓ Không ràng buộc</span>
          </div>
        </div>

        <!-- Step 2: Name + Phone -->
        <div class="s2" id="s2">
          <div class="sd"><i class="ok"></i><i class="on"></i></div>
          <h2>Thêm 1 bước → nhận câu chuyện!</h2>
          <div class="fd">Hơn 1.200 phụ huynh đã tin tưởng Việt Anh — <b>Hãy cùng họ</b></div>
          <form id="f2">
            <div class="fg">
              <label>Họ tên ba/mẹ</label>
              <input type="text" id="nm" placeholder="Nguyễn Văn A" required />
            </div>
            <div class="fg">
              <label>Số điện thoại (Zalo)</label>
              <input type="tel" id="ph" placeholder="0912 345 678" required />
            </div>
            <div class="fg">
              <label>Email</label>
              <input type="email" id="email" placeholder="email@example.com" autocomplete="email" required />
            </div>
            <button type="submit" class="btn bo" id="b2">Nhận ngay 📧</button>
          </form>
        </div>

        <!-- Success -->
        <div class="sok" id="sok">
          <div class="ck">🎉</div>
          <h3>Đã gửi thành công!</h3>
          <p>3 câu chuyện phụ huynh sẽ đến email<br/>📧 Kiểm tra hộp thư ngay</p>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    const WEBHOOK = '/api/lead';
    const $ = s => document.getElementById(s);

    let TUOI = '';
    document.querySelectorAll('.tb').forEach(btn => {
      btn.onclick = () => {
        TUOI = btn.dataset.t;
        $('s1').style.display = 'none';
        $('s2').style.display = 'block';
        window.dataLayer?.push({ event: 'lead_s1', tuoi: TUOI });
        $('nm').focus();
      };
    });

    $('f2').onsubmit = async e => {
      e.preventDefault();
      $('b2').disabled = 1;
      try {
        await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            step: 'full_submit',
            email: $('email').value.trim(),
            fullName: $('nm').value.trim(),
            phone: $('ph').value.trim(),
            tuoi_con: TUOI,
            note: 'Tuổi của con: ' + TUOI,
            school_level: 'mam-non',
            funnel_code: 'testimonial_mn',
            ...(window.__vaUTM ? window.__vaUTM() : {}),
            source: 'testimonial_mn',
            page: window.location.href,
            timestamp: new Date().toISOString()
          })
        });
      } catch (err) {
        console.error('[LeadForm] Step 2 error:', err);
      }
      ok();
      window.dataLayer?.push({ event: 'lead_done', variant: 'testimonial' });
    };

    function ok() {
      const name = $('nm')?.value?.trim() || '';
      const email = $('email')?.value?.trim() || '';
      window.location.href = '/cam-on?name=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email);
    }
  </script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
