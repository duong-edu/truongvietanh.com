  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Mầm Non Việt Anh",
    "url": "https://truongvietanh.com/tuyen-sinh/mam-non/cau-chuyen-phu-huynh",
    "description": "Khám phá 3 câu chuyện cảm động của phụ huynh Mầm Non Việt Anh. Con tôi từ nhút nhát thành tự tin, bé thích đi học mỗi ngày, giáo viên yêu thương như mẹ.",
    "telephone": "+84-916-961-409",
    "address": {"@type": "PostalAddress", "addressLocality": "TP. Hồ Chí Minh", "addressCountry": "VN"},
