---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { schoolFacts } from '../data/school-facts';

// Trang trụ NỘI TRÚ — tạo 31/08/2026. Nội dung theo bản duyệt của anh Dương.
// Câu hỏi chính: "Có nên cho con học trường nội trú ở TP.HCM không?"
// KHÔNG thêm aggregateRating/review (self-serving review — rủi ro manual action).
// CÒN NỢ: mô tả cơ cấu quản sinh, tỷ lệ quản sinh/học sinh, quy trình trực đêm
// và các mốc giờ sinh hoạt cụ thể — chờ quản sinh VAGV/VABT xác nhận rồi bổ sung.

const PAGE_TITLE = 'Trường nội trú TP.HCM: con sống và học thế nào ở Việt Anh?';
const PAGE_DESC =
  'Việt Anh nhận nội trú từ lớp 6 tại Gò Vấp và Bình Tân: kèm homework mỗi tối, nề nếp sống khỏe, tiền ở 2,5–3,2 triệu/tháng tùy cơ sở. Đây là cách con sống, học và lớn lên.';
const PAGE_URL = 'https://truongvietanh.com/noi-tru/';
const PAGE_IMAGE = 'https://media.truongvietanh.com/images/thuyet-trinh-08.webp';

const faqs = [
  {
    q: 'Con tôi đi học nội trú có thực sự trở nên tự lập không?',
    a: 'Chỉ khi môi trường được thiết kế để con tự làm, tự quyết, tự chịu trách nhiệm — thay vì bị quản chặt và làm thay. Tại Việt Anh, học sinh nội trú tự quản việc học bằng nhịp PDR hằng tuần, có giáo viên kèm homework để đỡ đúng lúc chứ không làm thay. Tự lập không phải là ở xa nhà; tự lập là rời tay bố mẹ mà vẫn đứng vững bằng đôi chân mình.',
  },
  {
    q: 'Con nhớ nhà quá thì sao?',
    a: 'Nhớ nhà là phản ứng tự nhiên và thường mạnh nhất trong những tuần đầu — nghiên cứu về hình thành thói quen (Lally, University College London, 2009) cho thấy một nếp sống mới cần khoảng hai tháng để ổn định. Trường đón nhận nỗi nhớ nhà thay vì bắt con "nín đi": có đội Hoa Tiêu đón bạn mới, quản sinh được huấn luyện quan sát, gia đình được thông tin trong tuần và con về nhà cuối tuần.',
  },
  {
    q: 'Nội trú Việt Anh có an toàn 24/7 không?',
    a: 'Khu nội trú nằm trong khuôn viên trường, mỗi khung giờ có người phụ trách được phân công, học sinh sinh hoạt theo thời khóa biểu có giám sát từ giờ học đến giờ ngủ. Khi tham quan, anh chị sẽ được xem trực tiếp khu ở và hỏi thẳng quy trình trực từng khung giờ.',
  },
  {
    q: 'Nội trú có giúp con học tốt hơn không?',
    a: 'Khảo sát School Life in Focus do TABS và CAIS công bố năm 2024 trên hơn 11.000 học sinh và cựu học sinh Bắc Mỹ cho thấy học sinh nội trú có khả năng dành từ 10 giờ mỗi tuần trở lên cho việc học ngoài giờ lên lớp cao hơn gần 80% so với học sinh không nội trú. Tại Việt Anh, mỗi tối con học trong giờ tự học có giáo viên kèm homework — người gỡ chỗ vướng ngay trong tuần, không đợi đến bài kiểm tra.',
  },
  {
    q: 'Điện thoại của con được quản thế nào ở nội trú?',
    a: 'Trong giờ tự học và giờ ngủ, thiết bị cá nhân được quản lý tập trung; internet cho việc học được dùng có giám sát. Quan trọng hơn, học sinh được học chương trình trí tuệ số DQ và chương trình AI của trường để hiểu vì sao cần giữ khoảng cách với màn hình — mục tiêu là con tự chủ, không phải chỉ bị cấm.',
  },
  {
    q: 'Chi phí nội trú có xứng đáng không?',
    a: 'Tiền ở 2.500.000 đồng một tháng tại cơ sở Gò Vấp và 3.200.000 đồng một tháng tại cơ sở Bình Tân, đã gồm giờ tự học có giáo viên kèm homework hằng ngày; ăn tối khoảng 50.000 đồng một bữa. Thước đo xứng đáng không nằm ở con số, mà ở sự thay đổi của con sau từng học kỳ: vững hơn, tự lo hơn, sống có nếp hơn. Trường mời anh chị và con trải nghiệm thực tế trước khi quyết định.',
  },
  {
    q: 'Trường nội trú khác gì bán trú và ký túc xá?',
    a: 'Nội trú là học sinh ăn, ở, học và sinh hoạt ngay trong khuôn viên trường, có đội ngũ quản sinh và giáo viên phụ trách ngoài giờ học, về nhà cuối tuần. Bán trú là con chỉ ở trường ban ngày. Ký túc xá đại học thì sinh viên tự quản là chính. Ở nội trú phổ thông, người lớn vẫn hiện diện trong từng khung giờ — đó là điểm phân biệt quan trọng nhất.',
  },
  {
    q: 'Việt Anh nhận nội trú từ lớp mấy và ở cơ sở nào?',
    a: 'Trường Việt Anh nhận học sinh nội trú từ lớp 6, tại hai cơ sở Gò Vấp và Bình Tân, TP.HCM. Học sinh đầu cấp (lớp 6 và lớp 10) có Học kỳ Foundation bốn tuần đầu để xây nếp sống, phương pháp học và định hướng cá nhân trước khi vào học nặng môn.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${PAGE_URL}#article`,
    headline: 'Trường nội trú tại TP.HCM: con anh chị sẽ sống và học như thế nào ở Việt Anh?',
    description: PAGE_DESC,
    inLanguage: 'vi-VN',
    datePublished: '2026-08-31T09:00:00+07:00',
    dateModified: '2026-08-31T09:00:00+07:00',
    mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
    image: [PAGE_IMAGE],
    author: {
      '@type': 'Person',
      '@id': 'https://nguyenmanhduong.com/#person',
      name: 'Nguyễn Mạnh Dương',
      jobTitle: 'Nhà sáng lập & Chủ tịch hệ thống giáo dục K-12 Việt Anh',
      url: 'https://truongvietanh.com/gioi-thieu',
      sameAs: [
        'https://nguyenmanhduong.com',
        'https://www.facebook.com/nguyenmanhduong1101/',
        'https://www.youtube.com/@nguyenmanhduong1101',
        'https://www.linkedin.com/in/nguyenmanhduong',
      ],
    },
    publisher: {
      '@type': 'EducationalOrganization',
      '@id': 'https://truongvietanh.com/#organization',
      name: 'Hệ thống giáo dục Việt Anh',
      logo: { '@type': 'ImageObject', url: 'https://truongvietanh.com/logo-crest-80.webp' },
    },
    about: [
      { '@type': 'Thing', name: 'Trường nội trú' },
      { '@type': 'Thing', name: 'Nội trú THCS THPT TP.HCM' },
      { '@type': 'Thing', name: 'Tính tự lập của học sinh' },
    ],
    citation: [
      'https://onlinelibrary.wiley.com/doi/10.1002/ejsp.674',
      'https://boardingschools.com/school-life-in-focus/',
      'https://www.sleephealthjournal.org/article/S2352-7218(15)00015-7/fulltext',
    ],
    audience: { '@type': 'Audience', audienceType: 'Phụ huynh học sinh THCS – THPT tại Việt Nam' },
    keywords:
      'trường nội trú, trường nội trú TP.HCM, nội trú lớp 6, nội trú THCS, nội trú THPT, chi phí nội trú, Trường Việt Anh',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${PAGE_URL}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${PAGE_URL}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: 'https://truongvietanh.com/' },
      { '@type': 'ListItem', position: 2, name: 'Tuyển sinh', item: 'https://truongvietanh.com/tuyen-sinh' },
      { '@type': 'ListItem', position: 3, name: 'Nội trú', item: PAGE_URL },
    ],
  },
];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical="https://truongvietanh.com/noi-tru"
  ogImage={PAGE_IMAGE}
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="/tuyen-sinh">Tuyển sinh</a>
            <span aria-hidden="true">/</span>
            <span>Nội trú</span>
          </nav>

          <h1 class="gi-h1">Trường nội trú tại TP.HCM: con anh chị sẽ sống và học như thế nào ở Việt Anh?</h1>
          <p class="gi-subtitle">Nhận nội trú từ lớp 6 tại Gò Vấp và Bình Tân. Mỗi tối có giáo viên kèm homework, mỗi tuần con tự nhìn lại việc học bằng nhịp PDR.</p>
          <p class="gi-last-updated">Cập nhật lần cuối: 31/08/2026</p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>Từ lớp 6</strong> nhận nội trú</div>
            <div class="gi-badge"><strong>2 cơ sở</strong> Gò Vấp &amp; Bình Tân</div>
            <div class="gi-badge"><strong>2,5–3,2 triệu/tháng</strong> tiền ở</div>
            <div class="gi-badge"><strong>Từ {schoolFacts.foundedYear}</strong> hệ thống K-12</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đặt lịch trải nghiệm nội trú</p>
            <LeadFormTwoStepEmailFirst
              formId="noitru-form"
              funnelCode="noi-tru-pillar"
              schoolLevel="thcs"
              submitText="Đặt lịch trải nghiệm nội trú"
              title=""
              description=""
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#noi-tru-la-gi">Nội trú là gì, khác gì bán trú?</a></li>
          <li><a href="#lop-6">Lớp 6 có quá nhỏ không?</a></li>
          <li><a href="#mot-ngay">Một ngày nội trú diễn ra thế nào?</a></li>
          <li><a href="#hoc-tot-hon">Nội trú có giúp con học tốt hơn?</a></li>
          <li><a href="#an-toan">An toàn và tâm lý của con</a></li>
          <li><a href="#dien-thoai">Điện thoại &amp; internet quản thế nào?</a></li>
          <li><a href="#chi-phi">Chi phí nội trú bao nhiêu?</a></li>
          <li><a href="#ket-noi">Bố mẹ giữ kết nối với con ra sao?</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#noitru-form-noi-tru-pillar" class="gi-toc-cta">Đặt lịch trải nghiệm nội trú</a>
      </nav>

      <article class="gi-main">

        <!-- Direct answer block -->
        <p class="nt-answer">
          Trường Việt Anh nhận học sinh nội trú <strong>từ lớp 6</strong> tại hai cơ sở <strong>Gò Vấp</strong> và
          <strong>Bình Tân</strong>, TP.HCM. Con sống theo nề nếp <strong>5 nguyên tắc sống khỏe</strong>, mỗi tối có
          <strong>giáo viên kèm homework</strong>, mỗi tuần tự nhìn lại việc học bằng <strong>nhịp PDR</strong>.
          Tiền ở <strong>2.500.000 đồng/tháng</strong> tại Gò Vấp và <strong>3.200.000 đồng/tháng</strong> tại Bình Tân,
          ăn tối khoảng <strong>50.000 đồng/bữa</strong>.
        </p>

        <section class="gi-section">
          <p>Tôi gặp nhiều anh chị đến hỏi về nội trú với hai cảm xúc trái ngược trong cùng một câu nói: <em>"Tôi muốn con tự lập, nhưng tôi sợ xa con."</em></p>
          <p>Không có gì phải xấu hổ về nỗi sợ đó. Nó là dấu hiệu của một người cha, người mẹ đang cân nhắc nghiêm túc.</p>
          <p>Trang này tôi viết để anh chị không phải quyết định bằng cảm tính — mà bằng việc nhìn rõ con sẽ <strong>sống</strong> thế nào, <strong>học</strong> thế nào, được <strong>bảo vệ</strong> thế nào, và <strong>tốn bao nhiêu tiền</strong>. Đọc xong, anh chị hãy đến ở cùng con một buổi. Nội trú không phải thứ để tin qua lời quảng cáo.</p>
        </section>

        <!-- Section 1 -->
        <section id="noi-tru-la-gi" class="gi-section">
          <h2>Trường nội trú là gì? Khác gì bán trú và ký túc xá?</h2>
          <p><strong>Trường nội trú là trường mà học sinh ăn, ở, học và sinh hoạt ngay trong khuôn viên trường, có đội ngũ quản sinh và giáo viên phụ trách ngoài giờ học.</strong></p>
          <p>Nó khác <strong>bán trú</strong> — con chỉ ở trường ban ngày — và khác <strong>ký túc xá đại học</strong>, nơi sinh viên tự quản là chính. Ở nội trú phổ thông, người lớn vẫn hiện diện trong từng khung giờ; đó là điểm phân biệt quan trọng nhất.</p>

          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Tiêu chí</th>
                  <th>Nội trú</th>
                  <th>Bán trú</th>
                  <th>Ở nhà, đưa đón</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Thời gian ở trường</strong></td>
                  <td>24/7 trong tuần, về nhà cuối tuần</td>
                  <td>Sáng đến chiều</td>
                  <td>Chỉ giờ học</td>
                </tr>
                <tr>
                  <td><strong>Ai kèm việc học buổi tối</strong></td>
                  <td>Giáo viên kèm homework hằng ngày</td>
                  <td>Gia đình</td>
                  <td>Gia đình / gia sư</td>
                </tr>
                <tr>
                  <td><strong>Rèn nếp sống (ngủ, ăn, thể thao)</strong></td>
                  <td>Trường thiết kế và giữ nhịp</td>
                  <td>Một nửa trường, một nửa nhà</td>
                  <td>Tùy gia đình</td>
                </tr>
                <tr>
                  <td><strong>Phù hợp với</strong></td>
                  <td>Gia đình muốn con rèn tự lập, nhà xa, bố mẹ bận công tác</td>
                  <td>Gia đình có người đón và kèm buổi tối</td>
                  <td>Gia đình có thời gian đồng hành sát mỗi ngày</td>
                </tr>
                <tr>
                  <td><strong>Điều phải cân nhắc</strong></td>
                  <td>Con xa vòng tay gia đình, cần môi trường đủ ấm</td>
                  <td>Tối về ai kèm con học</td>
                  <td>Thời gian di chuyển, bố mẹ đủ sức kèm không</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p>Tôi ghi nhận trung thực: <strong>nội trú không phải lựa chọn tốt nhất cho mọi đứa trẻ.</strong> Nếu gia đình anh chị có thời gian đồng hành mỗi tối và con đang ổn, ở nhà là một lựa chọn tốt. Nội trú phát huy giá trị nhất khi gia đình muốn con rèn tự lập có hệ thống, hoặc hoàn cảnh khiến buổi tối của con đang bị bỏ trống.</p>
        </section>

        <!-- Section 2 -->
        <section id="lop-6" class="gi-section">
          <h2>Con lớp 6 có quá nhỏ để ở nội trú không?</h2>
          <p><strong>Lớp 6 không quá nhỏ — nếu môi trường được thiết kế cho đúng lứa tuổi đó, và quá trình chuyển đổi được làm từ từ.</strong></p>
          <p>Nghiên cứu của Phillippa Lally và cộng sự (University College London, <em>European Journal of Social Psychology</em>, 2009, n=96) cho thấy một thói quen mới cần trung bình <strong>66 ngày</strong> lặp lại để thành nếp, dao động 18–254 ngày tùy người. Vì vậy đừng kỳ vọng con "quen ngay trong tuần đầu" — và cũng đừng hoảng khi tuần đầu con gọi điện đòi về.</p>
          <p>Tại Việt Anh, học sinh đầu cấp (lớp 6, lớp 10) có <strong>Học kỳ Foundation</strong> bốn tuần đầu: xây nếp sống, phương pháp học và định hướng cá nhân trước khi vào học nặng môn. Đội <strong>Hoa Tiêu Junior</strong> — học sinh trong hội đồng lãnh đạo học sinh — được phân công đón và kèm bạn mới, để đứa trẻ mới xa nhà có một người bạn <em>biết đường</em> trước khi có một người bạn <em>thân</em>.</p>
          <p>Nhớ nhà là phản ứng tự nhiên, không phải yếu đuối. <strong>Điều đáng lo không phải là con nhớ nhà — mà là con phải nhớ nhà trong lặng im.</strong> Việc của trường là để con không phải im lặng.</p>
        </section>

        <!-- Section 3 -->
        <section id="mot-ngay" class="gi-section">
          <h2>Một ngày của học sinh nội trú Việt Anh diễn ra thế nào?</h2>
          <p>Ban ngày, con học như mọi học sinh Việt Anh: chương trình GDPT 2018, tiếng Anh tăng cường với giáo viên bản ngữ, Morning Meeting đầu ngày. <strong>Khác biệt của nội trú nằm ở buổi tối</strong> — khoảng thời gian mà ở nhiều nơi bị bỏ trống, còn ở đây được thiết kế:</p>

          <ul class="nt-day-list">
            <li><strong>Ăn tối tại trường</strong> — bữa ăn theo <strong>5 nguyên tắc sống khỏe</strong> của trường: ăn tốt, uống tốt, nghỉ ngơi tốt, thể thao, niềm vui mỗi ngày. Trong trường không có snack, nước ngọt và trà sữa.</li>
            <li><strong>Giờ tự học có giáo viên kèm homework hằng ngày</strong> — con làm bài với người có thể gỡ ngay chỗ vướng, thay vì ngồi một mình với chỗ không hiểu.</li>
            <li><strong>Nhịp <a href="/he-thong-pdr">PDR</a> hằng tuần</strong> (Plan – Do – Review: Lên kế hoạch – Thực hiện – Nhìn lại) — con tự đối chiếu việc đã làm với kế hoạch đã đặt, gọi tên chỗ chênh, chọn một điều làm khác đi. Trường không chỉ dạy nội dung; trường dạy con cách tự điều khiển việc học của chính mình.</li>
            <li><strong>Thể thao và sinh hoạt</strong> — mỗi học sinh Việt Anh chơi ít nhất một môn thể thao thường xuyên, suốt năm.</li>
            <li><strong>Ngủ đúng giờ</strong> — National Sleep Foundation (Hirshkowitz và cộng sự, 2015) khuyến nghị tuổi 14–17 cần <strong>8–10 giờ ngủ mỗi đêm</strong>; nội trú là nơi hiếm hoi giữ được kỷ luật giấc ngủ mà không phải cãi nhau với con mỗi tối.</li>
          </ul>

          <h3>Lịch một ngày, theo giờ</h3>
          <p>Dưới đây là lịch sinh hoạt nội trú ngày thường, ban hành kèm <strong>Quyết định số 0909.CEO/2026/QĐ-MAJOR ngày 9/9/2026</strong>. Chúng tôi để nguyên bảng giờ thay vì mô tả, vì đây là thứ phụ huynh cần biết chính xác:</p>

          <div class="gi-table-responsive">
            <table class="gi-table">
              <thead>
                <tr>
                  <th>Giờ</th>
                  <th>Hoạt động</th>
                </tr>
              </thead>
              <tbody>
