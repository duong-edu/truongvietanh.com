---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getFotoowlAlbums } from '../lib/fotoowl';

// Album sự kiện thật từ photos.truongvietanh.com (FotoOwl) — ảnh giữ trên FotoOwl, ở đây chỉ liệt kê + link
const fotoowlAlbums = await getFotoowlAlbums();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hình Ảnh Trường Việt Anh',
    description: 'Thư viện hình ảnh từ Trường Liên Cấp Việt Anh — cơ sở vật chất hiện đại, hoạt động học tập, sự kiện và ngoại khóa.',
    url: 'https://truongvietanh.com/hinh-anh',
    mainEntity: {
      '@type': 'ImageGallery',
      name: 'Thư viện hình ảnh Trường Việt Anh',
      numberOfItems: 32,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang Chủ', item: 'https://truongvietanh.com/' },
      { '@type': 'ListItem', position: 2, name: 'Hình Ảnh', item: 'https://truongvietanh.com/hinh-anh' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Phụ huynh có thể đến tham quan trường Việt Anh trước khi đăng ký không?',
        acceptedAnswer: { '@type': 'Answer', text: 'Có. Trường Việt Anh mở cửa đón phụ huynh tham quan tại cả 2 cơ sở (Gò Vấp, Bình Tân). Quý phụ huynh đăng ký lịch tham quan qua hotline 0916 961 409 hoặc form trên website để được đội ngũ tuyển sinh hướng dẫn chi tiết.' },
      },
      {
        '@type': 'Question',
        name: 'Cơ sở vật chất Trường Việt Anh có gì nổi bật?',
        acceptedAnswer: { '@type': 'Answer', text: 'Trường Việt Anh đầu tư đồng bộ phòng lab STEM, thư viện song ngữ hàng nghìn đầu sách, sân thể thao đa năng, bể bơi, phòng nhạc – mỹ thuật, nhà ăn đạt chuẩn vệ sinh an toàn thực phẩm, và hệ thống camera giám sát 24/7 tại tất cả 2 campus.' },
      },
      {
        '@type': 'Question',
        name: 'Trường Việt Anh có bao nhiêu cơ sở tại TP.HCM?',
        acceptedAnswer: { '@type': 'Answer', text: 'Hiện tại Trường Việt Anh có 2 cơ sở tại TP.HCM: Gò Vấp và Bình Tân. Cơ sở chính tại 160/72 Phan Huy Ích, phường An Hội Tây, TP.HCM.' },
      },
      {
        '@type': 'Question',
        name: 'Trường có tổ chức hoạt động ngoại khóa nào cho học sinh?',
        acceptedAnswer: { '@type': 'Answer', text: 'Trường Việt Anh tổ chức 20+ câu lạc bộ ngoại khóa bao gồm: bóng đá, bóng rổ, bơi lội, cầu lông, dance, nhạc cụ, mỹ thuật, robotics, coding, và nhiều hơn nữa. Mỗi năm học sinh tham gia 4-6 chuyến dã ngoại, tham quan học tập và trải nghiệm thực tế.' },
      },
      { '@type': 'Question', name: 'Phụ huynh có thể đến tham quan trường trước khi đăng ký không?', acceptedAnswer: { '@type': 'Answer', text: 'Có. Trường Việt Anh mở cửa đón phụ huynh tham quan tại các cơ sở. Đăng ký qua hotline 0916 961 409 hoặc form trên website.' } },
      { '@type': 'Question', name: 'Cơ sở vật chất Trường Việt Anh có gì nổi bật?', acceptedAnswer: { '@type': 'Answer', text: 'Phòng lab STEM, thư viện song ngữ, sân thể thao, bể bơi, phòng nhạc-mỹ thuật, nhà ăn đạt chuẩn, camera 24/7 tại tất cả campus.' } },
      { '@type': 'Question', name: 'Trường có cho phụ huynh xem hình ảnh hoạt động hàng ngày không?', acceptedAnswer: { '@type': 'Answer', text: 'Có. Ngoài thư viện trên website, phụ huynh nhận ảnh qua nhóm Zalo lớp, fanpage Facebook và bản tin định kỳ. Giáo viên gửi ảnh hoạt động hàng tuần.' } },
    ],
  },
];

const faqItems = [
  { question: 'Phụ huynh có thể đến tham quan trường Việt Anh trước khi đăng ký không?', answer: 'Có. Trường Việt Anh mở cửa đón phụ huynh tham quan tại cả 2 cơ sở (Gò Vấp, Bình Tân). Quý phụ huynh đăng ký lịch tham quan qua hotline 0916 961 409 hoặc form trên website để được đội ngũ tuyển sinh hướng dẫn chi tiết.' },
  { question: 'Cơ sở vật chất Trường Việt Anh có gì nổi bật?', answer: 'Trường Việt Anh đầu tư đồng bộ phòng lab STEM, thư viện song ngữ hàng nghìn đầu sách, sân thể thao đa năng, bể bơi, phòng nhạc – mỹ thuật, nhà ăn đạt chuẩn vệ sinh an toàn thực phẩm, và hệ thống camera giám sát 24/7 tại tất cả 2 campus.' },
  { question: 'Trường Việt Anh có bao nhiêu cơ sở tại TP.HCM?', answer: 'Hiện tại Trường Việt Anh có 2 cơ sở tại TP.HCM: Cơ sở 1 tại Gò Vấp (160/72 Phan Huy Ích, phường An Hội Tây) và Cơ sở 2 tại Bình Tân, đào tạo liên cấp từ Mầm non đến THPT.' },
  { question: 'Trường có tổ chức hoạt động ngoại khóa nào cho học sinh?', answer: 'Trường Việt Anh tổ chức 20+ câu lạc bộ ngoại khóa bao gồm: bóng đá, bóng rổ, bơi lội, cầu lông, dance, nhạc cụ, mỹ thuật, robotics, coding, và nhiều hơn nữa. Mỗi năm học sinh tham gia 4-6 chuyến dã ngoại, tham quan học tập và trải nghiệm thực tế.' },
  { question: 'Trường Việt Anh có cho phụ huynh xem hình ảnh hoạt động hàng ngày không?', answer: 'Có. Ngoài thư viện hình ảnh trên website, phụ huynh còn nhận cập nhật hình ảnh qua nhóm Zalo lớp, fanpage Facebook và bản tin định kỳ. Giáo viên chủ nhiệm gửi ảnh hoạt động hàng tuần để phụ huynh nắm được con đang học gì.' },
  { question: 'Phụ huynh có thể đặt lịch tham quan trường trước khi quyết định cho con nhập học không?', answer: 'Hoàn toàn có thể. Phụ huynh đăng ký tham quan trường qua hotline 0916 961 409, form trên website hoặc nhắn tin fanpage. Đội ngũ tuyển sinh sẽ đón tiếp, giới thiệu cơ sở vật chất và tư vấn chương trình phù hợp với con.' },
];


---

<BaseLayout
  title="Hình Ảnh Trường Việt Anh — Cơ Sở Vật Chất, Hoạt Động & Sự Kiện"
  description="Thư viện hình ảnh từ Trường Liên Cấp Việt Anh — cơ sở vật chất hiện đại, hoạt động học tập STEM, sự kiện trường và các câu lạc bộ ngoại khóa."
  canonical="https://truongvietanh.com/hinh-anh"
  ogImage="https://media.truongvietanh.com/images/extra-gal1.webp"
  structuredData={structuredData}
>
  <div class="cf-layout page-wrapper">
    <HeaderBase />

    <section class="page-hero">
      <div class="cf-container text-center">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a> <span>/</span> <span>Hình Ảnh</span>
        </nav>
        <h1 class="page-title">Hình Ảnh Trường Việt Anh</h1>
        <p class="page-desc">Khám phá không gian học tập, hoạt động và sự kiện nổi bật tại Trường Liên Cấp Việt Anh qua thư viện hình ảnh.</p>
      </div>
    </section>

    <!-- Album sự kiện thật (FotoOwl) -->
    {fotoowlAlbums.length > 0 && (
      <section class="albums-section" id="album-su-kien">
        <div class="cf-container">
          <h2 class="section-title">Album Sự Kiện Trường Việt Anh</h2>
          <p class="section-desc">Toàn bộ {fotoowlAlbums.length} album ảnh sự kiện từ <a href="https://photos.truongvietanh.com" target="_blank" rel="noopener" style="color:#26275D;font-weight:600;">photos.truongvietanh.com</a> — lễ tổng kết, trưởng thành, dã ngoại, kỷ yếu, ngày hội lãnh đạo và nhiều hoạt động khác. Bấm vào từng album để xem và tải ảnh chất lượng cao.</p>
          <div class="albums-grid">
            {fotoowlAlbums.map((album, i) => (
              <a class="album-card" href={album.link} target="_blank" rel="noopener">
                <div class="album-thumb">
                  {album.cover
                    ? <img src={album.cover} alt={`Album: ${album.name} — Trường Việt Anh`} loading={i < 8 ? 'eager' : 'lazy'} fetchpriority={i < 4 ? 'high' : 'auto'} width="400" height="260" />
                    : <div class="album-thumb-placeholder"><span>📷</span><small>{album.name}</small></div>}
                </div>
                <div class="album-info">
                  <strong class="album-name">{album.name}</strong>
                  {album.date && <span class="album-date">{album.date}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- AIO intro -->
    <section class="gallery-intro">
      <div class="cf-container">
        <p>Trường Việt Anh tự hào sở hữu khuôn viên rộng rãi, trang thiết bị hiện đại và môi trường giáo dục năng động. Dưới đây là hình ảnh tiêu biểu từ cơ sở vật chất, lớp học, sự kiện trường và các hoạt động ngoại khóa — phản ánh cam kết đào tạo toàn diện cho học sinh từ Mầm Non đến THPT.</p>
        <p style="margin-top:0.75rem;">Hệ thống 2 cơ sở tại TP.HCM (Gò Vấp, Bình Tân) được đầu tư đồng bộ với phòng lab STEM, thư viện song ngữ, sân thể thao, bể bơi và nhà ăn đạt chuẩn vệ sinh an toàn thực phẩm. Phụ huynh có thể <a href="/tuyen-sinh" style="color:#26275D;font-weight:600;">đăng ký tham quan trực tiếp</a> để trải nghiệm không gian học tập thực tế.</p>
      </div>
    </section>

    <!-- Quick stats for AIO -->
    <section class="gallery-stats">
      <div class="cf-container">
        <div class="stats-row">
          <div class="stat-item"><span class="stat-num">6</span><span class="stat-label">Cơ sở tại TP.HCM, Tây Ninh, An Giang</span></div>
          <div class="stat-item"><span class="stat-num">20+</span><span class="stat-label">CLB ngoại khóa</span></div>
          <div class="stat-item"><span class="stat-num">1.000+</span><span class="stat-label">Học sinh đang theo học</span></div>
          <div class="stat-item"><span class="stat-num">15+</span><span class="stat-label">Năm hoạt động</span></div>
        </div>
      </div>
    </section>

    <!-- Điểm nhấn cơ sở vật chất -->
    <section class="facilities-highlight">
      <div class="cf-container">
        <h2 class="section-title" style="text-align:center">Điểm Nhấn Cơ Sở Vật Chất</h2>
        <p style="text-align:center;color:#475569;max-width:700px;margin:0 auto 1.5rem;font-size:1rem;line-height:1.7">Trường Việt Anh đầu tư mạnh vào cơ sở vật chất nhằm mang đến môi trường học tập tốt nhất. Mỗi cơ sở đều được trang bị đầy đủ tiện nghi hiện đại phục vụ giảng dạy và sinh hoạt.</p>
        <div class="facilities-grid">
          <div class="facility-card">
            <span class="facility-icon">🔬</span>
            <strong>Phòng Lab STEM</strong>
            <p>Trang bị đầy đủ thiết bị thí nghiệm Vật lý, Hóa học, Sinh học và bộ kit Robotics, Coding cho học sinh thực hành từ Tiểu Học.</p>
          </div>
          <div class="facility-card">
            <span class="facility-icon">📚</span>
            <strong>Thư Viện Song Ngữ</strong>
            <p>Hàng nghìn đầu sách tiếng Việt và tiếng Anh, không gian đọc yên tĩnh, phòng đa phương tiện hỗ trợ tự học và nghiên cứu.</p>
          </div>
          <div class="facility-card">
            <span class="facility-icon">🏊</span>
            <strong>Bể Bơi & Sân Thể Thao</strong>
            <p>Sân bóng đá, bóng rổ, cầu lông đạt chuẩn. Bể bơi an toàn với huấn luyện viên chuyên nghiệp cho mọi cấp học.</p>
          </div>
          <div class="facility-card">
            <span class="facility-icon">🍽️</span>
            <strong>Nhà Ăn Đạt Chuẩn</strong>
            <p>Nhà ăn đạt chuẩn vệ sinh an toàn thực phẩm, thực đơn dinh dưỡng được chuyên gia tư vấn, phục vụ 3 bữa/ngày cho học sinh bán trú.</p>
          </div>
          <div class="facility-card">
            <span class="facility-icon">🎵</span>
            <strong>Phòng Nhạc & Mỹ Thuật</strong>
            <p>Phòng nhạc cách âm, phòng vẽ sáng tạo với đầy đủ dụng cụ cho học sinh phát triển năng khiếu nghệ thuật, biểu diễn và triển lãm.</p>
          </div>
          <div class="facility-card">
            <span class="facility-icon">📷</span>
            <strong>Camera Giám Sát 24/7</strong>
            <p>Camera giám sát tại khu vực sinh hoạt của học sinh.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Internal links -->
    <section class="internal-links">
      <div class="cf-container">
        <h2 class="section-title">Tìm hiểu thêm về Trường Việt Anh</h2>
        <div class="links-grid">
          <a href="/gioi-thieu" class="link-card">
            <strong>Giới thiệu</strong>
            <span>Sứ mệnh, tầm nhìn và giá trị cốt lõi</span>
          </a>
          <a href="/co-so" class="link-card">
            <strong>Cơ sở</strong>
            <span>Hệ thống cơ sở và vị trí các campus</span>
          </a>
          <a href="/ngoai-khoa" class="link-card">
            <strong>Ngoại khóa</strong>
            <span>Câu lạc bộ, thể thao và hoạt động phát triển</span>
          </a>
          <a href="/tuyen-sinh" class="link-card">
            <strong>Tuyển sinh</strong>
            <span>Thông tin tuyển sinh và đăng ký nhập học</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="cf-container">
        <h2 class="section-title">Câu Hỏi Thường Gặp</h2>
        <div class="faq-list">
          {faqItems.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="max-width: 600px; margin: 0 auto 3rem; padding: 0 1.5rem; text-align: center;">
      <h2 style="font-size: 1.4rem; font-weight: 700; color: #26275D; margin-bottom: 0.5rem;">Muốn tham quan trường trực tiếp?</h2>
      <p style="color: #64748b; margin-bottom: 1.5rem; font-size: 1rem;">Đăng ký để đội ngũ tuyển sinh sắp xếp lịch tham quan cơ sở gần nhất</p>
      <LeadFormTwoStepEmailFirst
        formId="hinh-anh-form"
        funnelCode="gallery"
        schoolLevel="lien-cap"
        submitText="Đặt lịch tham quan"
      />
    </section>

    <FooterBase />
  </div>
</BaseLayout>

<style>.cf-container{ max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }.text-center{ text-align: center; }.breadcrumb{
    font-size: 1rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.6);
  }.breadcrumb a{ color: rgba(255, 255, 255, 0.75); text-decoration: none; }.breadcrumb a:hover{ text-decoration: underline; }.breadcrumb span{ margin: 0 0.35rem; }.page-hero{
    background: linear-gradient(135deg, #26275D, #26275D);
    color: #fff;
    padding: 3rem 0 2.5rem;
  }.page-title{
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    color: #fff !important;
    margin: 0 0 0.5rem;
  }.page-desc{
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    max-width: 640px;
    margin-inline: auto;
  }.gallery-intro{
    padding: 2rem 0 0;
  }.gallery-intro p{
    font-size: 1rem;
    color: #475569;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }.gallery-stats{ padding: 1.5rem 0 0; }.stats-row{ display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; }.stat-item{ text-align: center; min-width: 100px; }.stat-num{ display: block; font-size: 1.8rem; font-weight: 800; color: #26275D; }.stat-label{ font-size: 1rem; color: #64748b; }.facilities-highlight{ padding: 2.5rem 0; background: #fff; }.facilities-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }.facility-card{ background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.25rem; text-align: center; }.facility-icon{ font-size: 2rem; display: block; margin-bottom: 0.5rem; }.facility-card strong{ font-size: 1rem; color: #26275D; display: block; margin-bottom: 0.4rem; }.facility-card p{ font-size: 1rem; color: #475569; line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {.facilities-grid{ grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {.facilities-grid{ grid-template-columns: 1fr; } }.gallery-section{
    padding: 2.5rem 0;
  }.gallery-section:nth-child(even){
    background: #f8fafc;
  }.section-title{
    font-size: 1.5rem;
    font-weight: 700;
    color: #26275D;
    margin: 0 0 0.5rem;
  }.section-desc{
    font-size: 1rem;
    color: #64748b;
    line-height: 1.65;
    max-width: 700px;
    margin: 0 0 1.5rem;
  }.real-gallery-grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }.internal-links{
    padding: 2.5rem 0;
    background: #f0f4ff;
  }.internal-links .section-title{
    margin-bottom: 1.25rem;
  }.links-grid{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }.link-card{
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s;
  }.link-card:hover{ box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08); }.link-card strong{ font-size: 1rem; color: #26275D; }.link-card span{ font-size: 1rem; color: #64748b; line-height: 1.5; }

  @media (max-width: 900px) {.links-grid{ grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {.links-grid{ grid-template-columns: 1fr; }
  }.albums-section{ padding: 2.5rem 0; background: #fff; }
  /* Album section quá cao (>8000px) nên hiệu ứng reveal (threshold 8%) không kích hoạt khi ở đầu trang → kẹt opacity:0. Ép luôn hiển thị. */
  .albums-section.reveal{ opacity: 1 !important; transform: none !important; }.albums-grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }.album-card{
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
