                <tr>
                  <th>Loại dữ liệu</th>
                  <th>Thời gian lưu</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Dữ liệu form tư vấn (lead) chưa chuyển đổi</td><td>240 tháng kể từ lần tương tác cuối</td></tr>
                <tr><td>Hồ sơ học sinh đang theo học</td><td>Trong suốt thời gian học + 10 năm sau khi kết thúc (theo Luật Lưu trữ)</td></tr>
