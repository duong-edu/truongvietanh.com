---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';
import { openingHoursSpecification, schoolFacts } from '../data/school-facts';

const cmsPage = await getPillarPage('gioi-thieu');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "founder": {
      "@type": "Person",
      "@id": "https://nguyenmanhduong.com/#person",
      "name": "Nguyễn Mạnh Dương",
      "jobTitle": "Nhà sáng lập & Chủ tịch",
      "url": "https://nguyenmanhduong.com",
      "image": "https://truongvietanh.com/nguyen-manh-duong.jpg",
      "sameAs": [
        "https://nguyenmanhduong.com",
        "https://www.facebook.com/nguyenmanhduong1101/",
        "https://www.youtube.com/@nguyenmanhduong1101",
        "https://www.linkedin.com/in/nguyenmanhduong"
      ]
    },
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT tại TP.HCM, Tây Ninh (Cần Giuộc), An Giang.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"],
    "sameAs": [
      "https://www.facebook.com/truongvietanhhcm",
      "https://www.youtube.com/@truongvietanhhcm",
      "https://www.instagram.com/truongvietanh",
      "https://zalo.me/0916961409"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Trường Việt Anh có bao nhiêu cơ sở?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh có 6 cơ sở tại TP.HCM (3), Tây Ninh – Cần Giuộc (3) và An Giang – Rạch Giá (2)." }
      },
      {
        "@type": "Question",
        "name": "Học phí Trường Việt Anh bao nhiêu 1 tháng?",
        "acceptedAnswer": { "@type": "Answer", "text": "Học phí liên cấp lớp 1–12 tại TP.HCM (cơ sở Gò Vấp và Bình Tân) là 109,9–164,8 triệu đồng/năm, tương đương 9,2–13,7 triệu đồng/tháng khi chia đều 12 tháng, chưa gồm tiền ăn và phí dịch vụ. Mầm non Việt Anh Gò Vấp 8,0–12,0 triệu đồng/tháng, đã gồm ăn. Các cơ sở Tây Ninh và An Giang có biểu phí riêng, thấp hơn đáng kể. Xem chi tiết tại trang học phí." }
      },
      {
        "@type": "Question",
        "name": "Trường có xe đưa rước không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, hệ thống xe đưa rước phủ khắp các quận tại TP.HCM." }
      },
      {
        "@type": "Question",
        "name": "Chương trình tiếng Anh khác gì trường quốc tế?",
        "acceptedAnswer": { "@type": "Answer", "text": "Immersion từ Mầm non, UK curriculum Tiểu học, bảo hành đầu ra IELTS 6.0+ tại THPT (theo điều kiện trong hợp đồng)." }
      },
      {
        "@type": "Question",
        "name": "Trường nhận học sinh từ mấy tuổi?",
        "acceptedAnswer": { "@type": "Answer", "text": "Từ 2 tuổi (Mầm non) đến 18 tuổi (THPT)." }
      },
      {
        "@type": "Question",
        "name": "Có chính sách học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có, gồm 9 chính sách. Bốn ưu đãi học phí do cha mẹ quyết định: đóng trọn năm giảm 6%, trọn học kỳ giảm 2%, anh chị em ruột giảm 50% cho con thứ hai và 25% cho con thứ ba, Early Bird đóng trước nhiều năm giảm từ 6–46%. Năm học bổng do học sinh tự giành: GRIT, CHAMPIONS, LEADERS, TALENTS và quỹ LOVE miễn 50–100% học phí cho gia đình gặp biến cố. Chi tiết từng mức tại truongvietanh.com/hoc-bong." }
      },
      {
        "@type": "Question",
        "name": "Làm sao đăng ký tham quan trường?",
        "acceptedAnswer": { "@type": "Answer", "text": "Đăng ký trực tuyến tại trang web hoặc gọi 0916 961 409." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Giới thiệu", "item": "https://truongvietanh.com/gioi-thieu" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Trường Việt Anh",
    "image": "https://truongvietanh.com/logo-crest-80.webp",
    "telephone": "+84916961409",
    "email": "hoc@truongvietanh.com",
    "url": "https://truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "160/72 Phan Huy Ích, Phường An Hội Tây",
      "addressLocality": "Quận Gò Vấp",
      "addressRegion": "TP. Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 10.8431,
      "longitude": 106.6422
    },
    "openingHoursSpecification": openingHoursSpecification,
    "priceRange": "$$"
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Giới Thiệu Trường Việt Anh – Liên Cấp Song Ngữ"}
  description={cmsPage?.description || "Trường Việt Anh thành lập 2011: hệ thống liên cấp Mầm non – THPT tại TP.HCM. IELTS, 16 kỹ năng thế kỷ 21, 6 cơ sở. Tham quan miễn phí."}
  keywords="giới thiệu trường việt anh, vsc trường song ngữ, cambridge international school tphcm, trường liên cấp gò vấp bình tân, trường tư thục chất lượng cao"
  canonical="https://truongvietanh.com/gioi-thieu"
  ogImage="https://media.truongvietanh.com/images/extra-giao-vien-va-hoc-sinh-2.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero gi-hero--gioi-thieu">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Giới thiệu</span>
          </nav>

          <h1 class="gi-h1">Trường Việt Anh: Hệ Thống Giáo Dục Liên Cấp Song Ngữ Tại TP.HCM</h1>
          <p class="gi-subtitle">Tạo ra môi trường học tập vui vẻ và thực dụng kể từ năm 2011</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 6/2026</p>


          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>15+</strong> năm</div>
            <div class="gi-badge"><strong>{schoolFacts.campuses}</strong> cơ sở</div>
            <div class="gi-badge"><strong>IELTS</strong> 6.0–8.0</div>
            <div class="gi-badge"><strong>IELTS 6.0+</strong> có bảo hành</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== IMAGE: Giáo viên và học sinh ====== -->
    <div class="gi-container" style="padding-top:2.5rem">
      <img src="https://media.truongvietanh.com/images/giao-vien-01.webp" alt="Giáo viên và học sinh Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />
    </div>

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tam-nhin">Tầm nhìn & Sứ mệnh</a></li>
          <li><a href="#noi-dung-hoc">Nội dung học thực dụng</a></li>
          <li><a href="#tieng-anh">Tiếng Anh đủ du học</a></li>
          <li><a href="#truong-thanh">Học sinh sớm trưởng thành</a></li>
          <li><a href="#chuong-trinh">Chương trình đào tạo</a></li>
          <li><a href="#co-so">Hệ thống cơ sở</a></li>
          <li><a href="#danh-gia">Đánh giá phụ huynh</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#gioi-thieu-form-gioi-thieu-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tầm nhìn -->
        <section id="tam-nhin" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>Tầm nhìn và sứ mệnh của Trường Việt Anh là gì?</h2>
          <p>Trường Việt Anh được thành lập năm 2011 với sứ mệnh <strong>"Tạo ra môi trường học tập vui vẻ và thực dụng"</strong>. Tầm nhìn của trường: tất cả học sinh hạnh phúc, ra trường với 16 kỹ năng thế kỷ 21 và nền tảng tiếng Anh đủ du học.</p>
          <p>Sau hơn 15 năm hoạt động, Trường Việt Anh đã xây dựng hệ thống 6 cơ sở tại TP.HCM, Tây Ninh (Cần Giuộc) và An Giang (Rạch Giá), phục vụ hơn 1.000 học sinh mỗi năm — từ Mầm non đến THPT.</p>

          <div class="gi-values-grid">
            <h3>5 giá trị cốt lõi</h3>
            <div class="gi-values-items">
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9878;</span>
                <strong>Tôn trọng & Tự trọng</strong>
                <p>Tôn trọng sự khác biệt và học tập trong khiêm nhường</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9881;</span>
                <strong>Trách nhiệm</strong>
                <p>Nhận trách nhiệm về bản thân, mọi người và mọi thứ</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9733;</span>
                <strong>Tài giỏi</strong>
                <p>Luôn tìm cách tối ưu năng lực bản thân và cố gắng đến cùng trong mọi việc</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9876;</span>
                <strong>Chính trực</strong>
                <p>Chỉ làm điều đúng đắn, trở thành tấm gương sáng cho mọi người</p>
              </div>
              <div class="gi-value-card">
                <span class="gi-value-icon">&#9829;</span>
                <strong>Yêu thương</strong>
                <p>Hành động vì hạnh phúc của người khác</p>
              </div>
            </div>
          </div>

          <img src="https://media.truongvietanh.com/images/thuyet-trinh-01.webp" alt="Học sinh thuyết trình tại Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>2011</strong>
              <span>Năm thành lập</span>
            </div>
            <div class="gi-evidence-item">
              <strong>{schoolFacts.campuses}</strong>
              <span>Cơ sở</span>
            </div>
            <div class="gi-evidence-item">
              <strong>3.000+</strong>
              <span>Học sinh</span>
            </div>
            <div class="gi-evidence-item">
              <strong>3</strong>
              <span>Tỉnh thành</span>
            </div>
          </div>
        </section>

        <!-- Section 2: Nội dung học -->
        <section id="noi-dung-hoc" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Nội dung học tại Trường Việt Anh có gì khác biệt?</h2>
          <p>Chương trình học tại Trường Việt Anh được thiết kế dựa trên 16 kỹ năng thế kỷ 21 do Diễn đàn Kinh tế Thế giới (WEF) công bố. Học sinh không chỉ học lý thuyết mà còn ứng dụng trực tiếp vào dự án thực tế, rèn tư duy phản biện và giải quyết vấn đề.</p>
          <p>Mỗi năm, giáo trình được cập nhật để phù hợp với xu thế mới — bao gồm cách sử dụng AI có trách nhiệm, kỹ năng số (digital literacy), và khởi nghiệp (entrepreneurship). Ranh giới của việc dùng AI trong lớp học được quy định thành văn bản: xem <a href="/chinh-sach-ai">chính sách sử dụng AI của Trường Việt Anh</a>.</p>

          <div class="gi-comparison-box">
            <h3>So sánh: Giáo dục Việt Nam truyền thống vs Trường Việt Anh</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>Truyền thống</th>
                    <th>Trường Việt Anh</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Phương pháp</td>
                    <td>Học thuộc, thi cử</td>
                    <td>Dự án thực tế, tư duy phản biện</td>
                  </tr>
                  <tr>
                    <td>Kỹ năng</td>
                    <td>Tập trung kiến thức sách</td>
                    <td>16 kỹ năng WEF + lãnh đạo</td>
                  </tr>
                  <tr>
                    <td>Tiếng Anh</td>
                    <td>4-8 tiết/tuần</td>
                    <td>30-50% thời lượng bằng Tiếng Anh</td>
                  </tr>
                  <tr>
                    <td>Công nghệ</td>
                    <td>Tin học cơ bản</td>
                    <td>AI, Coding, Digital Literacy</td>
                  </tr>
                  <tr>
                    <td>Đầu ra</td>
                    <td>Điểm thi cao</td>
                    <td>Kỹ năng + IELTS + Tự tin</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p>Học sinh Trường Việt Anh thường xuyên tham gia các cuộc thi quốc tế, dự án cộng đồng và chương trình trao đổi văn hoá — giúp các em có tầm nhìn toàn cầu từ nhỏ.</p>
        </section>

        <!-- Section 3: Tiếng Anh -->
        <section id="tieng-anh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Chương trình tiếng Anh của Trường Việt Anh đạt chuẩn IELTS như thế nào?</h2>
          <p>Trường Việt Anh cam kết đầu ra tối thiểu IELTS 6.0 cho học sinh tốt nghiệp THPT. Lộ trình tiếng Anh được thiết kế liên tục từ Mầm non đến lớp 12, đảm bảo học sinh tiến bộ tự nhiên mà không bị áp lực quá tải.</p>

          <div class="gi-roadmap">
            <h3>Lộ trình Tiếng Anh 4 giai đoạn</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">MN</div>
                <strong>Mầm non (1-5 tuổi)</strong>
                <p>100% Immersion — Trẻ tiếp xúc tiếng Anh tự nhiên qua vui chơi, hát, kể chuyện với giáo viên bản ngữ.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">TH</div>
                <strong>Tiểu học (6-10 tuổi)</strong>
                <p>UK Curriculum — Học Toán, Khoa học bằng tiếng Anh. Rèn kỹ năng đọc-viết học thuật (Academic Reading & Writing).</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THCS</div>
                <strong>THCS (11-14 tuổi)</strong>
                <p>Giao tiếp + Học thuật — Học sinh tự tin thuyết trình, viết luận bằng tiếng Anh. Mục tiêu: IELTS&nbsp;4.5-5.5.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">THPT</div>
                <strong>THPT (15-18 tuổi)</strong>
                <p>Luyện thi IELTS chuyên sâu — Giáo viên bản ngữ. Bảo hành đầu ra IELTS&nbsp;6.0+ (theo điều kiện trong hợp đồng).</p>
              </div>
            </div>
          </div>

          <p>Ngoài ra, Trường Việt Anh còn hợp tác triển khai chương trình tiếng Anh cho hơn <strong>100 trường tại TP.HCM</strong>, chứng minh chất lượng giáo trình đã được kiểm chứng trên quy mô lớn.</p>
        </section>

        <!-- Section 4: Trưởng thành -->
        <section id="truong-thanh" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></span>Trường Việt Anh rèn luyện kỹ năng lãnh đạo cho học sinh như thế nào?</h2>
          <p>Trường Việt Anh áp dụng chương trình <strong>Leader in Me</strong> (bản quyền Franklin Covey) — một framework giáo dục lãnh đạo hàng đầu thế giới, kết hợp với 5 giá trị cốt lõi của trường.</p>

          <div class="gi-leader-grid">
            <div class="gi-leader-card">
              <h4>7 thói quen lãnh đạo</h4>
              <ol>
                <li>Chủ động (Be Proactive)</li>
                <li>Bắt đầu từ mục tiêu (Begin with the End in Mind)</li>
                <li>Ưu tiên việc quan trọng (Put First Things First)</li>
                <li>Tư duy cùng thắng (Think Win-Win)</li>
                <li>Hiểu người trước (Seek First to Understand)</li>
                <li>Hợp tác sáng tạo (Synergize)</li>
                <li>Rèn luyện bản thân (Sharpen the Saw)</li>
              </ol>
            </div>
