const ways = [
  {
    key: 'lop-la',
    title: 'Lớp Lá Việt Anh',
    who: 'Dành cho trẻ đang học lớp Lá tại hệ thống Trường Việt Anh',
    points: [
      'School Ready tích hợp sẵn trong chương trình lớp Lá, không đăng ký riêng',
      'Morning Meeting mỗi sáng, Wellbeing, Phonics, STEAME, vận động',
