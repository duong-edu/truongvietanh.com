const env = [
  { icon: '🗺️', name: 'Plan – Do – Review', text: 'Con tự chọn việc muốn làm, làm đến cùng rồi kể lại. Đây là cách HighScope rèn sự chủ động và tập trung.' },
  { icon: '🌱', name: 'Wellbeing', text: 'Chăm sóc cơ thể, cảm xúc, tình bạn. Mỗi học kỳ có dự án như "Bánh xe cảm xúc" hay cuốn sách "Hành trang lớp 1 của em".' },
  { icon: '🔤', name: 'Phonics và làm quen chữ', text: 'Nghe và phát âm chuẩn qua trò chơi, bài hát, khay cát, đất nặn, cùng giáo viên bản ngữ.' },
  { icon: '🔬', name: 'STEAME', text: 'Thí nghiệm, lắp ghép, làm món ăn đơn giản. Con đặt câu hỏi "tại sao" và tự tìm câu trả lời.' },
  { icon: '🏊', name: 'Vận động mỗi ngày', text: 'Thể dục buổi sáng, vận động ngoài trời, chơi cát. Xây sức bền cho một buổi học tiểu học.' },
  { icon: '🦁', name: 'Vai trò lãnh đạo lớp', text: 'Mỗi tuần con giữ một việc thật: dẫn hàng, tưới cây, phát khăn. Theo tinh thần Leader in Me.' },
