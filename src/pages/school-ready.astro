  <script src="/js/va-utm.js" is:inline></script>
  <script is:inline>
    (function () {
      var FUNNEL = 'school-ready';
      var API = '/api/lead';
      var KHOA_LABEL = {
        'lop-la': 'Lớp Lá Việt Anh',
        'trong-tuan': 'Học trong tuần',
        'thu-bay': 'Khoá rút gọn thứ Bảy',
        'chua-ro': 'Chưa rõ, cần tư vấn'
      };
      var HINH_THUC_LABEL = { 'nguyen-ngay': 'Nguyên ngày', 'nua-ngay': 'Nửa ngày' };
      var HOC_O_LABEL = { 'mam-non-viet-anh': 'Mầm non Việt Anh', 'truong-khac': 'Trường khác' };

      var form = document.getElementById('sr-form');
      if (!form) return;
      var khoa = document.getElementById('sr-khoa');
      var htWrap = document.getElementById('sr-hinhthuc-wrap');
      var ht = document.getElementById('sr-hinhthuc');
      var coso = document.getElementById('sr-coso');
      var errEl = document.getElementById('sr-err');
      var btn = document.getElementById('sr-submit');

      function syncHinhThuc() {
        var on = khoa.value === 'trong-tuan';
        htWrap.hidden = !on;
        ht.required = on;
        if (!on) ht.value = '';
      }
      khoa.addEventListener('change', syncHinhThuc);

      function selectKhoa(v) {
        if (!KHOA_LABEL[v]) return;
        khoa.value = v;
        syncHinhThuc();
      }

      // ?khoa=trong-tuan | thu-bay → chọn sẵn khoá
      try {
        var q = new URLSearchParams(location.search).get('khoa');
        if (q) selectKhoa(q);
      } catch (e) {}

      // Nút ở thẻ "Ba cách": chọn sẵn khoá rồi cuộn xuống form, không tải lại trang
      document.querySelectorAll('a[data-khoa]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          selectKhoa(a.getAttribute('data-khoa'));
          var target = document.getElementById('pp-form');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          try { history.replaceState(null, '', '/school-ready?khoa=' + a.getAttribute('data-khoa') + '#pp-form'); } catch (err) {}
        });
      });

      function showError(msg, el) {
        errEl.textContent = msg;
        errEl.hidden = false;
        if (el && el.focus) el.focus();
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errEl.hidden = true;

        // Bẫy bot: ô ẩn có chữ thì giả vờ thành công, không gửi
        if (form.website.value) { form.hidden = true; document.getElementById('sr-success').hidden = false; return; }

        var name = form.parent_name.value.trim();
        if (!name) return showError('Bạn cho trường biết họ tên phụ huynh nhé.', form.parent_name);
        var phone = (form.phone.value || '').replace(/[\s\-\.\(\)]/g, '').replace(/^\+?84/, '0');
        if (!/^0[35789][0-9]{8}$/.test(phone)) return showError('Số điện thoại chưa đúng. Bạn nhập số di động Việt Nam 10 số (ví dụ 0912 345 678).', form.phone);
        if (!form.nam_sinh.value) return showError('Bạn chọn năm sinh của con nhé.', form.nam_sinh);
        if (!khoa.value) return showError('Bạn chọn khoá quan tâm nhé.', khoa);
        if (khoa.value === 'trong-tuan' && !ht.value) return showError('Bạn chọn hình thức học trong tuần (nguyên ngày hoặc nửa ngày) nhé.', ht);
        if (!coso.value) return showError('Bạn chọn cơ sở muốn học, hoặc chọn "Chưa chọn, cần tư vấn".', coso);
        if (!form.consent.checked) return showError('Bạn đánh dấu đồng ý để trường liên hệ tư vấn nhé.', form.consent);

        var opt = coso.options[coso.selectedIndex];
        var campusLabel = opt.text.split(' — ')[0];
        var loc = opt.getAttribute('data-loc') || '';
        var province = opt.getAttribute('data-province') || '';
        var namSinh = form.nam_sinh.value === 'khac' ? 'Khác' : form.nam_sinh.value;
        var funnelCode = FUNNEL + (loc ? '-' + loc : '');
        var hocO = form.hoc_o.value;

        // Thẻ tag đề xuất của Pancake → ghi vào ghi chú (Pancake không nhận tag qua /api/lead)
        var tags = ['School Ready', KHOA_LABEL[khoa.value], coso.value];
        var note = 'School Ready · Năm sinh con: ' + namSinh
          + ' · Khoá quan tâm: ' + KHOA_LABEL[khoa.value]
          + (ht.value ? ' (' + HINH_THUC_LABEL[ht.value] + ')' : '')
          + ' · Cơ sở: ' + campusLabel
          + (hocO ? ' · Con đang học: ' + HOC_O_LABEL[hocO] : '')
          + ' · Tag: ' + tags.join(', ');

        var utm = (window.__vaUTM ? window.__vaUTM() : {});
        var payload = Object.assign({
          fullName: name,
          phone: phone,
          email: '',
          school_level: 'mam-non',
          grade: '5-tuoi',
          source: funnelCode,
          funnel_code: funnelCode,
          campus: coso.value,
          campus_label: campusLabel,
          province: province,
          khoa_quan_tam: khoa.value,
          hinh_thuc: ht.value,
          nam_sinh_con: namSinh,
          con_dang_hoc_o: hocO,
          note: note,
          consent: true,
          page_url: location.href,
          submitted_at: new Date().toISOString()
        }, utm);

        btn.disabled = true;
        var oldText = btn.textContent;
        btn.textContent = 'Đang gửi…';

        fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'form_submit',
              form_name: 'school_ready',
              funnel_code: funnelCode,
              campus: coso.value,
              khoa: khoa.value
            });
            form.hidden = true;
            var ok = document.getElementById('sr-success');
            ok.hidden = false;
            document.getElementById('sr-formcard').scrollIntoView({ behavior: 'smooth', block: 'center' });
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = oldText;
            showError('Có lỗi khi gửi. Bạn thử lại, hoặc gọi hotline 0916 961 409 để được hỗ trợ.');
          });
      });
    })();
  </script>

  <style is:global>
