const values = [
  { name: 'Tôn trọng', line: '"Tay tốt, lời tốt"' },
  { name: 'Trách nhiệm', line: '"Đồ của mình, mình cất; việc của mình, mình làm"' },
  { name: 'Tài giỏi', line: '"Thử thêm lần nữa"' },
