// được ghép vào `note` (vào trường mo_ta_khach_hang) và nguồn đi qua funnel_code.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const ZALO_OA = 'https://zalo.me/1678310120468101523';

const faqs = [
  {
    id: 'faq-day-doc-viet',
    q: 'School Ready có dạy con đọc, viết, làm toán trước không?',
    a: 'Không. Chúng tôi không dạy trước chương trình lớp 1. Con làm quen mặt chữ, nghe và phát âm, đếm và so sánh bằng đồ vật thật. Đồng thời con rèn đôi tay, sự tập trung, tâm thế và thói quen tự lập. Khi vào lớp 1, con có nền để học đọc, học viết nhẹ nhàng cùng thầy cô tiểu học.',
  },
  {
    id: 'faq-cham-hon',
    q: 'Nếu không học trước, con có bị chậm hơn các bạn không?',
    a: 'Lớp 1 đòi hỏi con ngồi tập trung, nghe chỉ dẫn, cầm bút đúng và tự lo việc của mình. Một đứa trẻ vững những điều này sẽ theo kịp và thường học vui hơn. Đứa trẻ đã "biết bài" nhưng chưa vững những điều đó vẫn gặp khó.',
  },
  {
    id: 'faq-truong-khac',
    q: 'Con tôi đang học trường khác, có tham gia được không?',
    a: 'Được. Khoá rút gọn thứ Bảy dành riêng cho trẻ đang học trường khác trong tuần. Con học nguyên ngày thứ Bảy tại một trong 6 cơ sở của hệ thống Trường Việt Anh.',
  },
  {
    id: 'faq-hoc-phi',
    q: 'Học phí bao nhiêu?',
    a: 'Học phí khác nhau theo cơ sở và hình thức học (nguyên ngày, nửa ngày hay thứ Bảy). Bạn điền form để nhận học phí của cơ sở gần nhà. Trong giờ hành chính, chuyên viên tư vấn gọi lại trong vòng 25 phút. Bạn cũng có thể nhắn Zalo OA Trường Việt Anh.',
  },
  {
    id: 'faq-tien-bo',
    q: 'Làm sao tôi biết con tiến bộ?',
    a: 'Giáo viên ghi quan sát theo công cụ COR Advantage của HighScope. Cứ mỗi 8 tuần, bạn nhận một báo cáo về 16 năng lực của con, kể bằng câu chuyện cụ thể kèm hình ảnh.',
  },
  {
    id: 'faq-hinh-anh',
    q: 'Hình ảnh và thông tin của con được dùng thế nào?',
    a: 'Trường chỉ chụp ảnh, quay video và ghi chép về con khi bạn đã ký phiếu đồng ý, với từng mức sử dụng do bạn chọn. Ghi chép đánh giá chỉ dùng nội bộ để theo dõi sự phát triển của con.',
  },
];

