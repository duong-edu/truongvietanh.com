---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('thanh-tich');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Việt Anh",
    "alternateName": "Trường Liên Cấp Việt Anh",
    "url": "https://truongvietanh.com",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Hệ thống giáo dục liên cấp song ngữ từ Mầm non đến THPT, có 2 cơ sở chính thức tại TP.HCM. Thành tích NH 2025-2026: 120 HS được khen thưởng, 4 giải Cấp Quốc gia, 21 HS đạt IELTS 6.0+ (trong đó 2 HS đạt 8.0).",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Năm học 2025-2026 Trường Việt Anh có bao nhiêu học sinh được khen thưởng?",
        "acceptedAnswer": { "@type": "Answer", "text": "Năm học 2025-2026, Trường Việt Anh đã khen thưởng 120 học sinh đạt giải các cuộc thi học thuật từ cấp Phường đến Quốc gia: 4 giải Cấp Quốc gia, 48 giải Cấp Thành phố, 64 giải Cấp Phường." }
      },
      {
        "@type": "Question",
        "name": "Có bao nhiêu học sinh đạt giải Cấp Quốc gia năm 2025-2026?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có 4 học sinh đạt giải Cấp Quốc gia tại cuộc thi IOE Tiếng Anh: Huỳnh Hiệp Tuấn Khải (K2526/11A2) — Giải Ba, Tạ Khôi Nguyên (K2526/10A2) — Giải Ba, Nguyễn Trí Cường (K2526/11B1) — Khuyến khích, Nguyễn Quincey (K2526/7A3) — Khuyến khích." }
      },
      {
        "@type": "Question",
        "name": "Có bao nhiêu học sinh đạt IELTS 6.0+ năm học 2025-2026?",
        "acceptedAnswer": { "@type": "Answer", "text": "21 học sinh THPT đạt IELTS từ 6.0 trở lên. Trong đó 2 em đạt 8.0 (Nguyễn Trí Dũng K2526/12C1 và Đào Khánh An K2526/11A1), 3 em đạt 7.5, 3 em đạt 7.0, 4 em đạt 6.5, 9 em đạt 6.0." }
      },
      {
        "@type": "Question",
        "name": "Trường Việt Anh có bao nhiêu cơ sở?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường Việt Anh có 2 cơ sở chính thức tại TP.HCM: cơ sở Gò Vấp (160/72 Phan Huy Ích) và cơ sở Bình Tân. Cùng chủ đầu tư với Trường Việt Anh có 4 trường: Mầm non Việt Anh (Gò Vấp), Mầm non Nhân Lễ, Mầm non và Tiểu học Thái Sơn (Cần Giuộc, Tây Ninh). Trường Việt Anh còn phụ trách vận hành Mầm non và Tiểu học Mekong Xanh (Rạch Giá, An Giang)." }
      },
      {
        "@type": "Question",
        "name": "Làm sao để xem hồ sơ thành tích chi tiết?",
        "acceptedAnswer": { "@type": "Answer", "text": "Phụ huynh có thể đăng ký trực tuyến tại form ở đầu trang hoặc gọi 0916 961 409 để được tư vấn và sắp xếp gặp Hội đồng nhà trường xem hồ sơ chi tiết." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Thành tích học tập", "item": "https://truongvietanh.com/thanh-tich-hoc-tap" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Thành Tích Học Tập Trường Việt Anh — Vinh Danh NH 2025-2026"}
  description={cmsPage?.description || "Thành tích NH 2025-2026 Trường Việt Anh: 120 HS được khen thưởng, 4 giải Cấp Quốc gia (IOE Tiếng Anh), 21 HS đạt IELTS 6.0+ (2 em IELTS 8.0). Danh sách có tên, có lớp."}
  keywords="thành tích học sinh trường việt anh, vinh danh học sinh việt anh 2025-2026, IELTS trường việt anh, IOE tiếng anh, hoa tiêu xuất sắc"
  canonical="https://truongvietanh.com/thanh-tich-hoc-tap"
  ogImage="https://media.truongvietanh.com/images/extra-Than-Huong-Giang-11A3.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span>Thành tích</span>
          </nav>

          <h1 class="gi-h1">Thành Tích Học Tập Trường Việt Anh — Vinh Danh NH 2025-2026</h1>
          <p class="gi-subtitle">Từ năm 2011 · 2 cơ sở chính thức tại TP.HCM</p>
          <p class="gi-last-updated">Cập nhật: Tháng 5/2026 — theo Bảng tổng kết khen thưởng chính thức của nhà trường</p>

          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>120 HS</strong> được khen NH 25-26</div>
            <div class="gi-badge"><strong>4 giải QG</strong> · 48 giải TP</div>
            <div class="gi-badge"><strong>21 HS</strong> đạt IELTS 6.0+</div>
            <div class="gi-badge"><strong>2 HS</strong> đạt IELTS 8.0</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Nhận hồ sơ thành tích & Đăng ký tham quan miễn phí</p>
            <LeadFormTwoStepEmailFirst
              formId="thanh-tich-form"
              funnelCode="thanh-tich-pillar"
              schoolLevel="lien-cap"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 5/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#tong-quan">Tổng quan</a></li>
          <li><a href="#nh-2025-2026">Vinh danh NH 2025-2026</a></li>
          <li><a href="#ielts-25-26">IELTS NH 2025-2026</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#thanh-tich-form-thanh-tich-pillar" class="gi-toc-cta">Đăng ký tham quan</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Tổng quan -->
        <section id="tong-quan" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>Tổng quan thành tích học tập Trường Việt Anh</h2>
          <p>Trang này tổng hợp <strong>kết quả khen thưởng chính thức Năm học 2025-2026</strong> của học sinh Trường Việt Anh — bao gồm danh sách học sinh đạt giải các cuộc thi học thuật từ cấp Phường đến Quốc gia, kết quả IELTS, danh hiệu Hoa tiêu xuất sắc, Đôi bạn cùng tiến và Học sinh tiến bộ. Mọi số liệu đều được Hội đồng nhà trường tổng kết và lưu hồ sơ.</p>
          <p><em>Quan điểm của Nguyễn Mạnh Dương:</em> "15 năm làm K12 từ năm 2011, tôi chỉ công bố thành tích thật. Trang này là bảng vinh danh học sinh có tên, có lớp, có giải — không phải con số marketing chung chung. Phụ huynh nào quan tâm đều có thể đối chiếu với hồ sơ tại trường."</p>
          <p>Trang sẽ được cập nhật theo từng năm học. Anh chị muốn xem hồ sơ chi tiết từng học sinh hoặc tìm hiểu lộ trình học của con, xin liên hệ <a href="tel:0916961409">0916 961 409</a> hoặc đăng ký form ở đầu trang.</p>
        </section>

        <!-- Section 2.5: Vinh danh NH 2025-2026 -->
        <section id="nh-2025-2026" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg></span>Vinh danh học sinh xuất sắc Năm học 2025-2026</h2>
          <p>Năm học 2025-2026, Trường Việt Anh đã khen thưởng <strong>120 học sinh</strong> đạt giải các cuộc thi học thuật từ cấp Phường đến cấp Quốc gia, cùng hàng chục em được tuyên dương ở các hạng mục Hoa tiêu xuất sắc, Đôi bạn cùng tiến, Học sinh tiến bộ và Việt Anh Voice. Đây là số liệu được tổng kết chính thức bởi Hội đồng nhà trường.</p>
          <p><em>Quan điểm của Nguyễn Mạnh Dương:</em> "15 năm làm K12 từ 2011, tôi không chạy đua thành tích. Tôi tổ chức thi cử để mỗi đứa trẻ có một sân chơi xứng đáng — đứa giỏi IOE thì đi IOE, đứa hợp Toán thì đi Violympic, đứa rụt rè thì có hạng mục Tiến bộ và Đôi bạn cùng tiến. Khen thưởng đúng người, đúng việc, đúng lúc — đó mới là động lực thật sự."</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item"><strong>120</strong><span>HS được khen thưởng</span></div>
            <div class="gi-evidence-item"><strong>4</strong><span>Giải Quốc gia</span></div>
            <div class="gi-evidence-item"><strong>48</strong><span>Giải Cấp TP</span></div>
            <div class="gi-evidence-item"><strong>64</strong><span>Giải Cấp Phường</span></div>
          </div>

          <p class="vd-legend"><strong>Cách đọc lớp:</strong> <em>K2526/12A3</em> nghĩa là lớp 12A3 của <strong>năm học 2025-2026</strong>. Ghi kèm khoá để phụ huynh biết chính xác thành tích thuộc năm nào — các em nay đã lên lớp hoặc đã tốt nghiệp.</p>

          <!-- Spotlight: 4 giải Quốc gia -->
          <h3 class="vd-section-title">🏆 4 học sinh đạt giải Cấp Quốc gia (IOE Tiếng Anh)</h3>
          <div class="vd-grid vd-grid-4">
            <article class="vd-card vd-card-gold">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/huynh-hiep-tuan-khai.webp" alt="Huỳnh Hiệp Tuấn Khải" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">HK</span></div>
              <div class="vd-medal">🥉 Giải Ba QG</div>
              <h4 class="vd-name">Huỳnh Hiệp Tuấn Khải</h4>
              <p class="vd-meta">K2526/11A2 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card vd-card-gold">
              <div class="vd-photo no-photo"><span class="vd-initials">TN</span></div>
              <div class="vd-medal">🥉 Giải Ba QG</div>
              <h4 class="vd-name">Tạ Khôi Nguyên</h4>
              <p class="vd-meta">K2526/10A2 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card vd-card-gold">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/nguyen-tri-cuong.webp" alt="Nguyễn Trí Cường" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">NC</span></div>
              <div class="vd-medal">🎖 Khuyến khích QG</div>
              <h4 class="vd-name">Nguyễn Trí Cường</h4>
              <p class="vd-meta">K2526/11B1 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card vd-card-gold">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/nguyen-quincey.webp" alt="Nguyễn Quincey" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">NQ</span></div>
              <div class="vd-medal">🎖 Khuyến khích QG</div>
              <h4 class="vd-name">Nguyễn Quincey</h4>
              <p class="vd-meta">K2526/7A3 · IOE Tiếng Anh</p>
            </article>
          </div>

          <!-- Spotlight: 9 TP Nhất/Nhì -->
          <h3 class="vd-section-title">🥇 9 học sinh đạt giải Nhất — Nhì Cấp Thành phố</h3>
          <div class="vd-grid vd-grid-3">
            <article class="vd-card">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/nguyen-tri-cuong.webp" alt="Nguyễn Trí Cường" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">NC</span></div>
              <div class="vd-medal vd-medal-gold">🥇 Giải Nhất TP</div>
              <h4 class="vd-name">Nguyễn Trí Cường</h4>
              <p class="vd-meta">K2526/11B1 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/nguyen-quincey.webp" alt="Nguyễn Quincey" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">NQ</span></div>
              <div class="vd-medal vd-medal-gold">🥇 Giải Nhất TP</div>
              <h4 class="vd-name">Nguyễn Quincey</h4>
              <p class="vd-meta">K2526/7A3 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo no-photo"><span class="vd-initials">PN</span></div>
              <div class="vd-medal vd-medal-gold">🥇 Giải Nhất TP</div>
              <h4 class="vd-name">Phùng Ngọc Thảo Nguyên</h4>
              <p class="vd-meta">K2526/6A2 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo no-photo"><span class="vd-initials">NH</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Nguyễn Mỹ Thiên Hương</h4>
              <p class="vd-meta">K2526/12C1 · Violympic Toán</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/pham-vu-bao-tran.webp" alt="Phạm Vũ Bảo Trân" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">PT</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Phạm Vũ Bảo Trân</h4>
              <p class="vd-meta">K2526/12A2 · HSG TP Sinh học</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo no-photo"><span class="vd-initials">LC</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Lê Hương Chi</h4>
              <p class="vd-meta">K2526/7A2 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo no-photo"><span class="vd-initials">ST</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Stolbov Vũ Tim</h4>
              <p class="vd-meta">K2526/8A1 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/nguyen-tri-dung.webp" alt="Nguyễn Trí Dũng" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">ND</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Nguyễn Trí Dũng</h4>
              <p class="vd-meta">K2526/12C1 · IOE Tiếng Anh</p>
            </article>
            <article class="vd-card">
              <div class="vd-photo"><img src="https://media.truongvietanh.com/images/vinh-danh-2025-2026/std/tran-tu-nhi.webp" alt="Trần Tú Nhi" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-photo')" /><span class="vd-initials">TN</span></div>
              <div class="vd-medal vd-medal-silver">🥈 Giải Nhì TP</div>
              <h4 class="vd-name">Trần Tú Nhi</h4>
              <p class="vd-meta">K2526/12C1 · IOE Tiếng Anh</p>
            </article>
          </div>

          <!-- Phân bổ table -->
          <h3>Phân bổ giải thưởng theo cấp và thứ hạng (THCS-THPT)</h3>
          <div class="gi-comparison-box">
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr><th>Thứ hạng</th><th>Cấp Phường</th><th>Cấp TP</th><th>Cấp Quốc gia</th><th>Tổng</th></tr>
                </thead>
                <tbody>
                  <tr><td>🥇 Giải Nhất</td><td>4</td><td>3</td><td>—</td><td><strong>7</strong></td></tr>
                  <tr><td>🥈 Giải Nhì</td><td>6</td><td>6</td><td>—</td><td><strong>12</strong></td></tr>
                  <tr><td>🥉 Giải Ba</td><td>13</td><td>21</td><td>2</td><td><strong>36</strong></td></tr>
                  <tr><td>🎖 Khuyến khích</td><td>21</td><td>8</td><td>2</td><td><strong>31</strong></td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Hoa tiêu XS -->
          <h3 class="vd-section-title">⭐ 14 Hoa tiêu xuất sắc — gương mặt tiêu biểu toàn diện</h3>
          <p>Danh hiệu Hoa tiêu xuất sắc dành cho học sinh nổi bật cả học tập, rèn luyện và đóng góp cho lớp, trường.</p>
          <div class="vd-honor-list">
            <span class="vd-honor-badge">Trần Thị Như Ý <em>K2526/12C1</em></span>
            <span class="vd-honor-badge">Nguyễn Tuệ Anh <em>K2526/11A1</em></span>
            <span class="vd-honor-badge">Trần Hoàng Giang <em>K2526/11A1</em></span>
            <span class="vd-honor-badge">Nguyễn Thị Lan Quỳnh <em>K2526/12C1</em></span>
            <span class="vd-honor-badge">Nguyễn Định Thiên Chinh <em>K2526/12A3</em></span>
            <span class="vd-honor-badge">Huỳnh Hà Nam Anh <em>K2526/12A3</em></span>
            <span class="vd-honor-badge">Nguyễn Ngọc Thùy Giang <em>K2526/8A3</em></span>
