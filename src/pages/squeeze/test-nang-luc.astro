---
import SqueezePageLayout from '../../layouts/SqueezePageLayout.astro';
import USPGrid from '../../components/USPGrid.astro';
import TrustMetrics from '../../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../../components/FAQSection.astro';

const pageTitle = 'Test Năng Lực Miễn Phí -- Biết Con Đang Ở Đâu, Để Đưa Con Đi Đúng Hướng | Trường Việt Anh';
const pageDescription = 'Đánh giá năng lực học tập của con miễn phí. Nhận báo cáo chi tiết về điểm mạnh, điểm yếu, và lộ trình cải thiện phù hợp. Được 2,000+ phụ huynh TPHCM tin dùng.';
const pageCanonical = 'https://truongvietanh.com/squeeze/test-nang-luc';

const uspItems = [
  { icon: '🧠', text: 'Đánh giá toàn diện 4 lĩnh vực: Toán, Tiếng Việt, Tiếng Anh, Tư duy logic -- bao quát năng lực học tập cốt lõi' },
  { icon: '📊', text: 'Báo cáo chi tiết với biểu đồ điểm mạnh/yếu, so sánh với chuẩn trung bình, và lộ trình cải thiện cá nhân hóa' },
  { icon: '🎯', text: 'So sánh năng lực con với chuẩn đầu vào các trường top TPHCM -- biết con đủ điều kiện vào trường nào' },
  { icon: '📝', text: 'Tư vấn cá nhân hóa 1-1 với chuyên gia giáo dục sau bài test -- phân tích kết quả và đề xuất hướng phát triển' },
  { icon: '📈', text: 'Kế hoạch học tập cá nhân hóa theo kết quả test -- biết cần tập trung vào đâu để tiến bộ nhanh nhất' },
  { icon: '🔄', text: 'Có thể làm test lại sau 3-6 tháng để đo lường tiến bộ -- theo dõi sự phát triển của con theo thời gian' }
];

const metrics = [
  { number: '2,000+', label: 'Học sinh đã hoàn thành test' },
  { number: '95%', label: 'Phụ huynh hài lòng với báo cáo' },
  { number: '15+', label: 'Năm kinh nghiệm đánh giá giáo dục' },
  { number: '48h', label: 'Nhận báo cáo chi tiết qua email' }
];

const faqItems = [
  { question: 'Bài test dành cho độ tuổi nào?', answer: 'Bài test được thiết kế cho học sinh từ lớp 1-9, với các cấp độ phù hợp từng lứa tuổi. Mỗi cấp lớp có bộ đề riêng, được chuẩn hóa theo chương trình giáo dục phổ thông và yêu cầu đầu vào của các trường chất lượng tại TPHCM.' },
  { question: 'Làm bài test mất bao lâu?', answer: 'Khoảng 45-60 phút tùy theo cấp lớp. Bài test được thiết kế không gây áp lực, giúp con thoải mái thể hiện năng lực thực. Có phần trắc nghiệm và phần tự luận ngắn, đánh giá cả kiến thức lẫn tư duy.' },
  { question: 'Kết quả được gửi khi nào và bao gồm gì?', answer: 'Báo cáo chi tiết sẽ được gửi qua email trong vòng 48 giờ. Báo cáo bao gồm: điểm số từng lĩnh vực, biểu đồ so sánh với chuẩn trung bình, phân tích điểm mạnh/yếu, và lộ trình cải thiện cụ thể. Ba/Mẹ còn được mời buổi tư vấn cá nhân hóa 1-1 để hiểu rõ hơn.' },
  { question: 'Có phải trả phí gì không?', answer: 'Hoàn toàn miễn phí, bao gồm cả bài test, báo cáo chi tiết, và buổi tư vấn 1-1. Đây là chương trình hỗ trợ cộng đồng phụ huynh của Trường Việt Anh, không yêu cầu cam kết hay chi phí ẩn.' },
  { question: 'Bài test có đánh giá chính xác không?', answer: 'Bài test được xây dựng bởi đội ngũ chuyên gia giáo dục với 15+ năm kinh nghiệm, dựa trên chuẩn đánh giá quốc tế và chương trình Việt Nam.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="tieu-hoc"
  funnelCode="squeeze-test-nang-luc"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Con Bạn Đang Ở Đâu? -- Làm Test Năng Lực Miễn Phí Để Biết Chính Xác</h1>
    <p class="squeeze-hero__subheading">Bài đánh giá toàn diện 4 lĩnh vực giúp Ba/Mẹ hiểu rõ năng lực của con -- kèm báo cáo chi tiết và lộ trình cải thiện cá nhân hóa</p>
  </section>

  <section slot="usp"><USPGrid title="Bài test bao gồm" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Số liệu thực tế" metrics={metrics} /></section>

  <section slot="content">
    <div class="testnl-content">
      <!-- Hero Image -->
      <div class="testnl-content__image-wrap">
        <img src="https://media.truongvietanh.com/images/thuyet-trinh-07.webp" alt="Học sinh làm bài test năng lực tại Trường Việt Anh TPHCM" class="testnl-content__image" width="900" height="500" loading="lazy" />
      </div>

      <h2 class="testnl-content__title">Tại sao cần đánh giá năng lực?</h2>

      <!-- Content Cards -->
      <div class="testnl-grid">
        <div class="testnl-card">
          <h3>🔍 Nhìn rõ điểm mạnh và điểm yếu</h3>
          <p>Biết chính xác con giỏi gì và yếu gì để đầu tư đúng hướng, không lãng phí thời gian và tiền bạc. Nhiều phụ huynh ngạc nhiên khi phát hiện con có năng lực tiềm ẩn ở lĩnh vực mà họ chưa từng chú ý. Báo cáo giúp Ba/Mẹ có cái nhìn khách quan, không dựa trên cảm tính.</p>
        </div>
        <div class="testnl-card">
          <h3>🎯 Chọn trường phù hợp với năng lực thực</h3>
          <p>So sánh năng lực con với chuẩn đầu vào các trường top tại TPHCM. Biết con đang ở mức nào so với yêu cầu, từ đó chọn trường phù hợp thay vì chọn theo tên tuổi. Tránh tình trạng con vào trường quá khó, bị áp lực và mất tự tin.</p>
        </div>
        <div class="testnl-card">
          <h3>📈 Lộ trình cải thiện cá nhân hóa</h3>
          <p>Nhận kế hoạch học tập được thiết kế riêng cho con dựa trên kết quả test. Biết cần tập trung vào môn nào, phần nào, và phương pháp nào hiệu quả nhất. Lộ trình có mốc thời gian cụ thể, giúp Ba/Mẹ theo dõi tiến bộ của con từng tháng.</p>
        </div>
        <div class="testnl-card">
          <h3>🤝 Tư vấn 1-1 với chuyên gia</h3>
          <p>Sau bài test, Ba/Mẹ được mời tham gia buổi tư vấn cá nhân hóa 1-1 (30 phút) với chuyên gia giáo dục. Chuyên gia sẽ phân tích chi tiết báo cáo, giải đáp thắc mắc, và tư vấn hướng phát triển phù hợp nhất cho con -- bao gồm cả việc chọn trường.</p>
        </div>
      </div>

      <!-- Bonus Section -->
      <div class="testnl-bonus">
        <div class="testnl-bonus__icon">🎁</div>
        <h3 class="testnl-bonus__title">Bonus: Tặng bộ đề luyện tập theo điểm yếu</h3>
        <p class="testnl-bonus__text">Sau khi nhận báo cáo, Ba/Mẹ sẽ được gửi thêm bộ đề luyện tập được chọn lọc theo đúng điểm yếu của con. Bộ đề bao gồm 20-30 bài tập cho mỗi lĩnh vực cần cải thiện, kèm đáp án và hướng dẫn giải chi tiết. Đây là công cụ thực tế giúp con tiến bộ ngay sau bài test.</p>
      </div>

      <!-- Urgency Note -->
      <div class="testnl-urgency">
        <p><strong>🌟 Đặc biệt:</strong> Chương trình test năng lực miễn phí chỉ dành cho 100 học sinh đăng ký mỗi tháng. Sau bài test, Ba/Mẹ sẽ được tư vấn 1-1 với chuyên gia giáo dục của Trường Việt Anh để hiểu rõ báo cáo và lập kế hoạch phát triển cho con.</p>
      </div>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Đăng ký làm test miễn phí</h2>
    <p class="squeeze-form-section__description">Điền thông tin để nhận liên kết làm bài test và lịch tư vấn cá nhân</p>
    <LeadFormTwoStepEmailFirst formId="squeeze-form" funnelCode="squeeze-test-nang-luc" schoolLevel="tieu-hoc" submitText="Nhận link làm test ngay" successMessage="Cảm ơn! Link làm test sẽ được gửi qua email trong vòng 24 giờ." />
  </section>

  <section slot="faq"><FAQSection title="Câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>.testnl-content{ max-width: 900px; margin: 0 auto; }.testnl-content__image-wrap{ margin-bottom: 2rem; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }.testnl-content__image{ width: 100%; height: auto; display: block; object-fit: cover; max-height: 420px; }.testnl-content__title{ font-family: Montserrat, sans-serif; font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #26275D; text-align: center; }.testnl-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin: 2rem 0; }.testnl-card{ background: white; border: 1px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; transition: all 0.3s ease; }.testnl-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.12); transform: translateY(-4px); }.testnl-card h3{ font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: #26275D; }.testnl-card p{ font-size: 1rem; line-height: 1.7; color: #555; margin: 0; }.testnl-bonus{ background: linear-gradient(135deg, #FFF8F0 0%, #FFF3E0 100%); border: 2px solid #f9dd0e; border-radius: 12px; padding: 2rem; margin: 2.5rem 0; text-align: center; }.testnl-bonus__icon{ font-size: 2.5rem; margin-bottom: 0.75rem; }.testnl-bonus__title{ font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 700; color: #f9dd0e; margin-bottom: 1rem; }.testnl-bonus__text{ font-size: 1rem; line-height: 1.7; color: #555; max-width: 700px; margin: 0 auto; }.testnl-urgency{ background-color: #f0f8ff; border-left: 4px solid #f9dd0e; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }.testnl-urgency p{ margin: 0; font-size: 1rem; line-height: 1.7; color: #1a1a1a; }
  @media (max-width: 768px) {.testnl-grid{ grid-template-columns: 1fr; }.testnl-content__image{ max-height: 280px; }
  }
</style>
