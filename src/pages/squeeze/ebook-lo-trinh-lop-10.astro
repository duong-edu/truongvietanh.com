---
import SqueezePageLayout from '../../layouts/SqueezePageLayout.astro';
import USPGrid from '../../components/USPGrid.astro';
import TrustMetrics from '../../components/TrustMetrics.astro';
import LeadFormTwoStepEmailFirst from '../../components/LeadFormTwoStepEmailFirst.astro';
import FAQSection from '../../components/FAQSection.astro';

const pageTitle = 'Lộ trình giúp con vào TOP trường cấp 3 tại TP.HCM (MIỄN PHÍ) | Trường Việt Anh';
const pageDescription = 'Dành riêng cho phụ huynh có con từ lớp 5-9 muốn định hướng đúng ngay từ đầu. Nhận ngay lộ trình học chi tiết, checklist chọn trường 2026, 7 sai lầm phụ huynh hay mắc, bộ đề test năng lực. Đã có 5,000+ phụ huynh tải.';
const pageCanonical = 'https://truongvietanh.com/squeeze/ebook-lo-trinh-lop-10';

const uspItems = [
  { icon: '📚', text: 'Lộ trình học chi tiết từ lớp 5 đến cấp 3 -- kế hoạch từng học kỳ với mục tiêu cụ thể và cách đo lường tiến bộ' },
  { icon: '✅', text: 'Checklist 15 tiêu chí chọn trường 2026 -- công cụ so sánh khách quan giữa các trường top tại TPHCM' },
  { icon: '⚠️', text: '7 sai lầm phụ huynh hay mắc phải -- từ kinh nghiệm tư vấn 5,000+ gia đình, cách nhận biết và tránh từng sai lầm' },
  { icon: '📝', text: 'Bộ đề test năng lực chất lượng -- đánh giá Toán, Tiếng Việt, Tiếng Anh theo chuẩn đầu vào các trường top' },
  { icon: '🗓️', text: 'Timeline tuyển sinh TPHCM 2026 -- tất cả mốc thời gian quan trọng từ các trường công lập, dân lập, quốc tế' },
  { icon: '💡', text: 'Phương pháp học tập hiệu quả -- kỹ thuật ghi nhớ, quản lý thời gian, và cách ôn thi được chứng minh qua thực tế' }
];

const metrics = [
  { number: '5,000+', label: 'Phụ huynh đã tải lộ trình' },
  { number: '6.0+', label: 'IELTS có bảo hành' },
  { number: '15+', label: 'Năm kinh nghiệm giáo dục' },
  { number: '2', label: 'Cơ sở THPT tại TPHCM' }
];

const faqItems = [
  { question: 'Lộ trình này có phù hợp với con tôi không?', answer: 'Lộ trình được thiết kế cho phụ huynh có con từ lớp 5-9, đang muốn định hướng vào trường cấp 3 chất lượng. Nội dung được chia theo từng cấp lớp, nên Ba/Mẹ có thể chọn phần phù hợp nhất. Nếu con đang lớp 5-7, đây là thời điểm vàng. Nếu con đang lớp 8-9, lộ trình có phần tăng tốc riêng.' },
  { question: 'Tài liệu được gửi qua hình thức nào?', answer: 'Sau khi đăng ký, chúng tôi sẽ gửi toàn bộ tài liệu qua email trong vòng 24 giờ, bao gồm: ebook PDF (40+ trang), bộ đề test (file Word), bảng checklist (Google Sheets), và timeline tuyển sinh (PDF). Ba/Mẹ có thể tải về điện thoại, máy tính, hoặc in ra.' },
  { question: 'Có phải tôi sẽ bị gửi quá nhiều email không?', answer: 'Không. Chúng tôi tôn trọng hộp thư của Ba/Mẹ. Sau email gửi tài liệu, chỉ gửi thêm 2-3 email có giá trị trong tháng đầu (tips học tập, thông báo livestream). Nếu không muốn nhận thêm, Ba/Mẹ có thể hủy đăng ký bằng 1 click trong bất kỳ email nào.' },
  { question: 'Có chi phí ẩn hay bất kỳ cam kết nào không?', answer: 'Hoàn toàn miễn phí, không có chi phí ẩn, không cần cam kết mua gì. Đây là tài liệu Trường Việt Anh biên soạn để hỗ trợ cộng đồng phụ huynh. Ba/Mẹ tải về, áp dụng cho con, và chia sẻ cho bạn bè nếu thấy hữu ích.' },
  { question: 'Lộ trình này khác gì so với các tài liệu miễn phí khác trên mạng?', answer: 'Lộ trình được biên soạn bởi đội ngũ giáo dục với 15+ năm kinh nghiệm thực tế tại TPHCM, dựa trên dữ liệu từ 5,000+ học sinh đã theo dõi. Nội dung cụ thể cho từng trường top tại TPHCM (công lập, dân lập, quốc tế), không phải lý thuyết chung chung. Kèm theo bộ đề test và công cụ đánh giá thực tế.' }
];
---

<SqueezePageLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageCanonical}
  schoolLevel="thcs"
  funnelCode="squeeze-ebook-lo-trinh"
>
  <section slot="hero">
    <h1 class="squeeze-hero__heading">Lộ trình giúp con vào TOP trường cấp 3 tại TP.HCM</h1>
    <p class="squeeze-hero__subheading">Dành riêng cho phụ huynh có con từ lớp 5-9 muốn định hướng đúng ngay từ đầu -- Tài liệu 40+ trang kèm bộ đề test năng lực</p>
    <div class="hero-cta"><p style="font-size: 1rem; margin-top: 1.5rem; opacity: 0.9;">📥 Tài liệu giá trị này sẽ được gửi ngay sau khi bạn đăng ký</p></div>
  </section>

  <section slot="usp"><USPGrid title="Bạn sẽ nhận được gì?" items={uspItems} /></section>
  <section slot="trust"><TrustMetrics title="Được tin tưởng bởi hàng ngàn phụ huynh" metrics={metrics} /></section>

  <section slot="content">
    <div class="ebook-content">
      <!-- Hero Image -->
      <div class="ebook-content__image-wrap">
        <img src="https://media.truongvietanh.com/images/thuyet-trinh-15.webp" alt="Học sinh thuyết trình tự tin tại Trường Việt Anh TPHCM" class="ebook-content__image" width="900" height="500" loading="lazy" />
      </div>

      <h2 class="ebook-content__title">Tại sao con bạn cần lộ trình này?</h2>

      <!-- Content Cards -->
      <div class="ebook-grid">
        <div class="ebook-card">
          <h3>🎯 Xác định mục tiêu rõ ràng từ sớm</h3>
          <p>Nhiều phụ huynh chỉ nhận ra cần lên kế hoạch khi con đã lên lớp 9 -- thời điểm đó đã muộn. Nghiên cứu cho thấy học sinh bắt đầu chuẩn bị từ lớp 6-7 có tỷ lệ đỗ nguyện vọng 1 cao hơn 40% so với học sinh bắt đầu muộn. Lộ trình này giúp Ba/Mẹ xác định trường mục tiêu và lập kế hoạch từng bước ngay hôm nay.</p>
        </div>
        <div class="ebook-card">
          <h3>🚀 Tăng cơ hội đỗ nguyện vọng 1</h3>
          <p>Với lộ trình chi tiết theo từng học kỳ, con bạn sẽ có kế hoạch ôn tập có hệ thống thay vì học tràn lan. Mỗi giai đoạn có mục tiêu cụ thể, phương pháp học tập hiệu quả, và cách đo lường tiến bộ.</p>
        </div>
        <div class="ebook-card">
          <h3>💡 Tránh 7 sai lầm phổ biến</h3>
          <p>Từ kinh nghiệm tư vấn 5,000+ gia đình, chúng tôi đã tổng hợp 7 sai lầm mà phụ huynh thường mắc phải khi chuẩn bị cho con thi lớp 10. Mỗi sai lầm được phân tích chi tiết: tại sao xảy ra, hậu quả là gì, và cách tránh. Ba/Mẹ đọc xong sẽ biết ngay mình có đang mắc sai lầm nào không.</p>
        </div>
        <div class="ebook-card">
          <h3>📊 Công cụ đánh giá năng lực thực tế</h3>
          <p>Bộ đề test năng lực giúp Ba/Mẹ biết con đang ở đâu so với chuẩn đầu vào các trường top TPHCM. Đề test bao gồm Toán, Tiếng Việt, Tiếng Anh -- 3 môn chính trong kỳ thi lớp 10. Kèm đáp án chi tiết và bảng đối chiếu chuẩn từng trường.</p>
        </div>
      </div>

      <!-- Bonus Section -->
      <div class="ebook-bonus">
        <div class="ebook-bonus__icon">🎁</div>
        <h3 class="ebook-bonus__title">Bonus: Tặng kèm buổi tư vấn cá nhân hóa 1-1</h3>
        <p class="ebook-bonus__text">Ngoài bộ tài liệu 40+ trang, 50 phụ huynh đăng ký đầu tiên mỗi tháng sẽ được mời tham gia buổi tư vấn cá nhân 1-1 (30 phút) với chuyên gia giáo dục. Trong buổi tư vấn, chuyên gia sẽ phân tích tình hình cụ thể của con, đề xuất trường phù hợp, và tư vấn lộ trình chuẩn bị riêng. Đăng ký ngay để không bỏ lỡ cơ hội này.</p>
      </div>

      <!-- Urgency Note -->
      <div class="ebook-urgency">
        <h3 class="ebook-urgency__title">⏰ Thời gian là vàng</h3>
        <p>Nếu con bạn đang ở lớp 5-7, bây giờ là thời điểm vàng để chuẩn bị. Mỗi tháng trôi qua mà không có kế hoạch là một tháng lãng phí. Đừng để sự chuẩn bị kéo dài đến tháng cuối cùng trước kỳ thi. Tải lộ trình ngay hôm nay và bắt đầu hành trình cùng con.</p>
      </div>

      <div style="text-align: center; margin-top: 2rem;"><p style="font-size: 1rem; color: #1a1a1a;"><strong>Không spam. Chỉ gửi tài liệu giá trị. Hủy đăng ký bất cứ lúc nào.</strong></p></div>
    </div>
  </section>

  <section slot="form">
    <h2 class="squeeze-form-section__heading">Nhận lộ trình miễn phí</h2>
    <p class="squeeze-form-section__description">Điền thông tin dưới đây để nhận lộ trình chi tiết, bộ đề test, và tất cả tài liệu hữu ích khác trong 24 giờ</p>
    <LeadFormTwoStepEmailFirst formId="squeeze-form" funnelCode="squeeze-ebook-lo-trinh" schoolLevel="thcs" submitText="Nhận ngay miễn phí" successMessage="Cảm ơn bạn! Vui lòng kiểm tra email. Tài liệu sẽ được gửi trong vòng 24 giờ." />
  </section>

  <section slot="faq"><FAQSection title="Những câu hỏi thường gặp" items={faqItems} /></section>
</SqueezePageLayout>

<style is:inline>.hero-cta{ margin-top: 2rem; }.ebook-content{ max-width: 900px; margin: 0 auto; }.ebook-content__image-wrap{ margin-bottom: 2rem; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }.ebook-content__image{ width: 100%; height: auto; display: block; object-fit: cover; max-height: 420px; }.ebook-content__title{ font-family: Montserrat, sans-serif; font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #26275D; text-align: center; }.ebook-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin: 2rem 0; }.ebook-card{ background-color: white; border: 1px solid #e0e0e0; border-radius: 12px; padding: 1.5rem; transition: all 0.3s ease; }.ebook-card:hover{ border-color: #f9dd0e; box-shadow: 0 8px 20px rgba(249, 221, 14, 0.12); transform: translateY(-4px); }.ebook-card h3{ font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; color: #26275D; }.ebook-card p{ font-size: 1rem; line-height: 1.7; color: #555; margin: 0; }.ebook-bonus{ background: linear-gradient(135deg, #FFF8F0 0%, #FFF3E0 100%); border: 2px solid #f9dd0e; border-radius: 12px; padding: 2rem; margin: 2.5rem 0; text-align: center; }.ebook-bonus__icon{ font-size: 2.5rem; margin-bottom: 0.75rem; }.ebook-bonus__title{ font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 700; color: #f9dd0e; margin-bottom: 1rem; }.ebook-bonus__text{ font-size: 1rem; line-height: 1.7; color: #555; max-width: 700px; margin: 0 auto; }.ebook-urgency{ background-color: #f0f8ff; border-left: 4px solid #f9dd0e; padding: 1.5rem; border-radius: 8px; margin-top: 2rem; }.ebook-urgency__title{ font-family: Montserrat, sans-serif; color: #26275D; margin-bottom: 0.75rem; }.ebook-urgency p{ margin: 0; font-size: 1rem; line-height: 1.7; color: #1a1a1a; }
  @media (max-width: 768px) {.ebook-grid{ grid-template-columns: 1fr; gap: 1.5rem; }.ebook-content__image{ max-height: 280px; }
  }
</style>
