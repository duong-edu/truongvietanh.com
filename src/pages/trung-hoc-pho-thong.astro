---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from '../components/HeaderBase.astro';
import FooterBase from '../components/FooterBase.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';
import { getPillarPage } from '../lib/directus';

const cmsPage = await getPillarPage('trung-hoc-pho-thong');
const cmsFaqs = cmsPage?.faq_items || null;

const structuredData = [
    // Gỡ aggregateRating/review 27-28/08/2026: Google không chấp nhận self-serving review
    // (tổ chức tự đánh giá mình, thu thập & hiển thị trên chính website của mình) —
    // để lại có nguy cơ bị manual action. Testimonial hiển thị cho người đọc vẫn giữ nguyên.
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường THPT Việt Anh",
    "alternateName": "Trường Trung Học Phổ Thông Việt Anh",
    "url": "https://truongvietanh.com/trung-hoc-pho-thong",
    "logo": "https://truongvietanh.com/logo-crest-80.webp",
    "foundingDate": "2011",
    "description": "Trường THPT Việt Anh tại TP.HCM: bảo hành đầu ra IELTS 6.0+, chương trình du học profile, kỹ năng lãnh đạo. Giải pháp cho học sinh rớt lớp 10 công lập.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 500 },
    "areaServed": ["TP. Hồ Chí Minh", "Tây Ninh", "An Giang"],
    "educationalLevel": "High School",
    "teaches": ["IELTS Preparation", "SAT Prep", "Leadership Skills", "University Placement", "Study Abroad Profile"],
    "offers": { "@type": "Offer", "category": "THPT Song Ngữ", "price": "11000000", "priceCurrency": "VND", "priceValidUntil": "2027-08-31", "description": "Học phí THPT từ 11-15 triệu VND/tháng, bao gồm luyện IELTS" },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gi-h1", ".gi-subtitle"] }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Học sinh THPT Việt Anh tốt nghiệp đạt IELTS mấy điểm?",
        "acceptedAnswer": { "@type": "Answer", "text": "Bảo hành đầu ra IELTS 6.0+ ghi trong hợp đồng — không đạt trường kèm miễn phí cho đến khi đạt (theo điều kiện trong hợp đồng). Lộ trình luyện thi IELTS chuyên sâu bắt đầu từ lớp 10 với giáo viên bản ngữ." }
      },
      {
        "@type": "Question",
        "name": "Trường THPT Việt Anh có thi đầu vào không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có bài kiểm tra đánh giá năng lực đầu vào nhưng không phải kỳ thi tuyển sinh cạnh tranh khắc nghiệt như trường công lập. Trường đánh giá toàn diện qua phỏng vấn, bài kiểm tra Toán-Anh và hồ sơ học tập. Học sinh rớt lớp 10 công lập vẫn được xét tuyển." }
      },
      {
        "@type": "Question",
        "name": "Trường THPT Việt Anh hỗ trợ du học nước nào?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường hỗ trợ du học tại nhiều quốc gia: Mỹ, Anh, Úc, Canada, Nhật Bản, Hàn Quốc, Singapore. Đội ngũ tư vấn du học riêng hỗ trợ xây dựng profile, viết recommendation letters, chuẩn bị SAT/TOEFL và nộp hồ sơ đại học." }
      },
      {
        "@type": "Question",
        "name": "Tỷ lệ học sinh THPT Việt Anh vào đại học là bao nhiêu?",
        "acceptedAnswer": { "@type": "Answer", "text": "Trường đang tổng hợp số học sinh trúng tuyển đại học năm học 2025–2026 và sẽ công bố số liệu cụ thể. Học sinh được chuẩn bị song song hai hướng: thi tốt nghiệp THPT và xét tuyển đại học bằng IELTS, học bạ, kèm định hướng du học." }
      },
      {
        "@type": "Question",
        "name": "Trường THPT Việt Anh có học bổng không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Từ năm học 2026–2027, học sinh THPT Việt Anh tự giành bốn học bổng: GRIT thưởng chuỗi tự học đều đặn mỗi ngày, CHAMPIONS 2–20 triệu đồng cho học sinh đạt giải thi đấu, LEADERS 10 triệu đồng mỗi suất cho học sinh cho đi và dẫn dắt, TALENTS 25–100 triệu đồng cho học sinh ngoài trường ở các tỉnh. Riêng học sinh lớp 12 nhận GRIT bằng tiền mặt tại Lễ Tri ân và Trưởng thành. Gia đình còn được ưu đãi học phí: đóng trọn năm giảm 6%, anh chị em ruột giảm 50% cho con thứ hai, Early Bird giảm từ 6–46%. Chi tiết tại truongvietanh.com/hoc-bong." }
      },
      {
        "@type": "Question",
        "name": "Trường THPT Việt Anh có hoạt động ngoại khoá gì?",
        "acceptedAnswer": { "@type": "Answer", "text": "Hơn 20 câu lạc bộ ngoại khoá: Debate Club, MUN, Robotics, STEM, Âm nhạc, Thể thao (bóng đá, bóng rổ, bơi lội), Tình nguyện cộng đồng, Doanh nhân trẻ, Photography, Drama Club. Các CLB giúp xây dựng du học profile phong phú." }
      },
      {
        "@type": "Question",
        "name": "Học sinh rớt lớp 10 công lập có được nhận vào THPT Việt Anh không?",
        "acceptedAnswer": { "@type": "Answer", "text": "Có. Trường Việt Anh nhận học sinh rớt lớp 10 công lập. Sau bài đánh giá năng lực và phỏng vấn, học sinh được xếp lớp phù hợp và nhận hỗ trợ tâm lý, học thuật để nhanh chóng hoà nhập và phát triển." }
      },
      { "@type": "Question", "name": "THPT Việt Anh hỗ trợ du học như thế nào?", "acceptedAnswer": { "@type": "Answer", "text": "Phòng Tư vấn Du học hỗ trợ: luyện IELTS chuyên sâu, tư vấn chọn trường, viết essay, chuẩn bị hồ sơ ứng tuyển. Kết nối đại học tại Úc, Mỹ, Anh, Canada, Nhật, Singapore. 30% mỗi khóa nhận học bổng du học." } },
      { "@type": "Question", "name": "Chương trình THPT chuẩn bị cho thi tốt nghiệp THPT quốc gia không?", "acceptedAnswer": { "@type": "Answer", "text": "Có. Chuẩn bị 2 hướng: thi tốt nghiệp THPT quốc gia (ôn luyện từ lớp 11) và xét tuyển đại học (SAT/IELTS)." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://truongvietanh.com" },
      { "@type": "ListItem", "position": 2, "name": "Chương trình", "item": "https://truongvietanh.com/gioi-thieu" },
      { "@type": "ListItem", "position": 3, "name": "THPT", "item": "https://truongvietanh.com/trung-hoc-pho-thong" }
    ]
  }
];
---

<BaseLayout
  title={cmsPage?.title || "Trường THPT Việt Anh — Bảo Hành Đầu Ra IELTS 6.0+, Định Hướng Đại Học"}
  description={cmsPage?.description || "Trường THPT Việt Anh TP.HCM: IELTS 6.0+ có bảo hành, du học profile, kỹ năng lãnh đạo. Giải pháp cho học sinh lớp 10. Đăng ký ngay."}
  canonical="https://truongvietanh.com/trung-hoc-pho-thong"
  ogImage="https://media.truongvietanh.com/images/extra-20230311-DSC08612-scaled.webp"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <!-- ====== LAYER 2: HERO WITH FORM ====== -->
    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="/gioi-thieu">Chương trình</a>
            <span aria-hidden="true">/</span>
            <span>THPT</span>
          </nav>

          <h1 class="gi-h1">Trường THPT Việt Anh: Bảo Hành Đầu Ra IELTS 6.0+ Và Định Hướng Đại Học</h1>
          <p class="gi-subtitle">Luyện thi IELTS chuyên sâu — Du học profile — Kỹ năng lãnh đạo</p>
          <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4, 2026</p>


          <div class="gi-trust-badges">
            <div class="gi-badge"><strong>IELTS</strong> 6.0+ có bảo hành</div>
            <div class="gi-badge"><strong>6.0+</strong> IELTS có bảo hành</div>
            <div class="gi-badge"><strong>Du học</strong> Profile</div>
            <div class="gi-badge"><strong>8-12tr</strong> /tháng</div>
          </div>
        </div>

        <div class="gi-hero-right">
          <div class="gi-form-card">
            <p class="gi-form-heading">Đăng ký tư vấn chương trình THPT cá nhân hóa</p>
            <LeadFormTwoStepEmailFirst
              formId="thpt-form"
              funnelCode="thpt-pillar"
              schoolLevel="thpt"
            />
          </div>
        </div>
      </div>
    </section>

    <img src="https://media.truongvietanh.com/images/olympic-03.webp" alt="Học sinh THPT Trường Việt Anh" loading="lazy" width="1200" height="auto" class="section-img" />

    <!-- ====== LAYER 3 + 4: TOC SIDEBAR + CONTENT ====== -->
    <div class="gi-container gi-body">
      <p class="gi-last-updated">Cập nhật lần cuối: Tháng 4/2026</p>
      <!-- Sticky TOC sidebar -->
      <nav class="gi-toc" aria-label="Mục lục">
        <p class="gi-toc-title">Mục lục</p>
        <ol class="gi-toc-list">
          <li><a href="#khac-biet">Chương trình khác biệt</a></li>
          <li><a href="#ielts">Đầu ra IELTS</a></li>
          <li><a href="#rot-lop-10">Rớt lớp 10 công lập</a></li>
          <li><a href="#du-hoc">Hỗ trợ du học</a></li>
          <li><a href="#hoc-phi">Học phí THPT</a></li>
          <li><a href="#danh-gia">Đánh giá & nhận xét</a></li>
          <li><a href="#faq">Câu hỏi thường gặp</a></li>
        </ol>
        <a href="#thpt-form-thpt-pillar" class="gi-toc-cta">Đăng ký tư vấn</a>
      </nav>

      <!-- Main content -->
      <article class="gi-main">

        <!-- Section 1: Chương trình khác biệt -->
        <section id="khac-biet" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></span>Chương trình THPT tại Trường Việt Anh có gì khác biệt?</h2>
          <p>Chương trình THPT tại Trường Việt Anh không chỉ dừng lại ở chương trình Bộ Giáo dục và Đào tạo. Trường tích hợp thêm <strong>luyện thi IELTS chuyên sâu</strong>, xây dựng du học profile toàn diện, hướng nghiệp và phát triển kỹ năng lãnh đạo — giúp học sinh không chỉ tốt nghiệp THPT mà còn sẵn sàng cho đại học trong nước và du học quốc tế.</p>
          <p>Khác với nhiều trường THPT tư thục chỉ dạy theo chương trình chuẩn, tại Việt Anh, học sinh được học song song hai hệ: <strong>chương trình Bộ GD&ĐT đảm bảo bằng tốt nghiệp THPT quốc gia</strong> và chương trình IELTS intensive với giáo viên bản ngữ. Kết quả là học sinh vừa có bằng THPT, vừa có chứng chỉ IELTS khi tốt nghiệp — một lợi thế cạnh tranh rất lớn khi xét tuyển đại học.</p>
          <p>Đặc biệt, chương trình hướng nghiệp tại Trường Việt Anh bắt đầu từ lớp 10. Học sinh được làm bài trắc nghiệm nghề nghiệp chuyên sâu, tham gia các workshop với chuyên gia từ nhiều ngành nghề, thực tập ngắn hạn tại doanh nghiệp đối tác và xây dựng portfolio cá nhân. Đến lớp 12, mỗi học sinh đã có định hướng nghề nghiệp rõ ràng và kế hoạch cụ thể cho con đường sau THPT.</p>
          <p>Mô hình giáo dục THPT tại Việt Anh dựa trên 4 trụ cột: <strong>Học thuật</strong> (chương trình Bộ GD + IELTS), <strong>Phát triển bản thân</strong> (kỹ năng lãnh đạo, quản lý thời gian, tư duy phản biện), <strong>Hoạt động ngoại khoá</strong> (20+ CLB, dự án cộng đồng, MUN) và <strong>Hướng nghiệp</strong> (du học profile, recommendation letters, SAT prep). Bốn trụ cột này tạo nên lợi thế toàn diện cho học sinh khi bước vào đời.</p>

          <div class="gi-evidence-bar">
            <div class="gi-evidence-item">
              <strong>IELTS 6.0+</strong>
              <span>Đầu ra khi tốt nghiệp</span>
            </div>
            <div class="gi-evidence-item">
              <strong>2</strong>
              <span>Hướng song song: thi tốt nghiệp và xét tuyển</span>
            </div>
            <div class="gi-evidence-item">
              <strong>20+</strong>
              <span>Câu lạc bộ ngoại khoá</span>
            </div>
            <div class="gi-evidence-item">
              <strong>30%</strong>
              <span>Du học nước ngoài</span>
            </div>
          </div>

          <p>Ngoài kiến thức học thuật, Trường Việt Anh đặc biệt chú trọng phát triển <strong>kỹ năng mềm</strong> cho học sinh THPT. Chương trình Leader in Me (FranklinCovey) được tích hợp vào hoạt động hàng tuần, giúp học sinh rèn luyện 7 thói quen hiệu quả: chủ động, bắt đầu từ mục tiêu, ưu tiên điều quan trọng, tư duy cùng thắng, lắng nghe thấu hiểu, hợp lực sáng tạo và rèn luyện bản thân. Đây chính là nền tảng giúp học sinh Việt Anh tự tin, bản lĩnh và thành công trong bất kỳ môi trường nào.</p>
          <p>Sĩ số lớp THPT tại Việt Anh chỉ <strong>24 học sinh</strong>, đảm bảo giáo viên có thể quan tâm sát sao đến từng em. Mỗi học sinh có một giáo viên chủ nhiệm kiêm mentor, theo dõi sự phát triển toàn diện — từ kết quả học tập, tiến độ IELTS, đến tâm lý và định hướng tương lai. Phụ huynh nhận báo cáo định kỳ hàng tháng về mọi khía cạnh phát triển của con.</p>
        </section>

        <!-- Section 2: IELTS -->
        <section id="ielts" class="gi-section">
          <h2><span class="si"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></span>Học sinh THPT Việt Anh đạt IELTS bao nhiêu khi tốt nghiệp?</h2>
          <p>Đây là câu hỏi được phụ huynh quan tâm nhất. Câu trả lời: <strong>Bảo hành đầu ra <a href="https://www.ielts.org" target="_blank" rel="noopener">IELTS</a> 6.0+ ghi trong hợp đồng</strong> — không đạt trường kèm miễn phí cho đến khi đạt (theo điều kiện trong hợp đồng). Nền tảng này đến từ lộ trình luyện thi IELTS chuyên sâu 3 năm, với giáo viên bản ngữ có chứng chỉ CELTA/DELTA và kinh nghiệm luyện thi IELTS chuyên&nbsp;nghiệp.</p>


          <div class="gi-roadmap">
            <h3>Lộ trình IELTS 3 năm THPT tại Việt Anh</h3>
            <div class="gi-roadmap-grid">
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L10</div>
                <strong>Lớp 10: Xây nền tảng (IELTS 4.0-5.0)</strong>
                <p>Học kỹ năng tiếng Anh nền tảng với giáo viên bản ngữ. Tập trung vào 4 kỹ năng: Listening, Reading, Writing, Speaking. Bổ trợ ngữ pháp, từ vựng academic. Thi thử IELTS lần đầu cuối học kỳ 2 để đánh giá xuất phát điểm chính xác. Học sinh yếu được bổ trợ thêm ngoài giờ.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L11</div>
                <strong>Lớp 11: Luyện chuyên sâu (IELTS 5.0-6.5)</strong>
                <p>Tăng cường luyện đề IELTS thực tế. Luyện Writing Task 1 & Task 2 chuyên sâu với feedback cá nhân hoá. Speaking practice hàng tuần với giáo viên bản ngữ theo format thi thật. Thi IELTS chính thức lần 1 vào cuối lớp 11 — nhiều học sinh đã đạt 6.0-6.5 ở giai đoạn này.</p>
              </div>
              <div class="gi-roadmap-item">
                <div class="gi-roadmap-badge">L12</div>
                <strong>Lớp 12: Đạt target (IELTS 6.0+)</strong>
                <p>Luyện đề intensive, mock test hàng tuần, coaching 1-1 cho từng kỹ năng yếu. Thi IELTS chính thức lần 2-3 để đạt target cá nhân. Học sinh xuất sắc hướng tới IELTS 7.0-8.0. Kết hợp luyện SAT cho học sinh du học Mỹ. Kết quả IELTS được dùng xét tuyển đại học ngay.</p>
              </div>
            </div>
          </div>

          <div class="gi-comparison-box">
            <h3>Kết quả IELTS đầu ra — Việt Anh so với mặt bằng chung</h3>
            <div class="gi-table-responsive">
              <table class="gi-table">
                <thead>
                  <tr>
                    <th>Tiêu chí</th>
                    <th>THPT Việt Anh</th>
                    <th>THPT công lập (TP.HCM)</th>
                    <th>Trung tâm IELTS ngoài</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Thời lượng IELTS/tuần</td>
                    <td>8-10 tiết (tích hợp)</td>
                    <td>0-2 tiết</td>
                    <td>4-6 tiết (phải đi thêm)</td>
                  </tr>
                  <tr>
                    <td>Giáo viên</td>
                    <td>Bản ngữ + CELTA/DELTA</td>
                    <td>GV Việt Nam</td>
                    <td>Tuỳ trung tâm</td>
                  </tr>
                  <tr>
                    <td>Thi thử IELTS</td>
                    <td>Hàng tháng tại trường</td>
                    <td>Không có</td>
                    <td>Theo khoá (phí riêng)</td>
                  </tr>
                  <tr>
                    <td>IELTS đầu ra trung bình</td>
                    <td>6.5</td>
                    <td>Không có dữ liệu</td>
                    <td>Tuỳ nỗ lực cá nhân</td>
                  </tr>
                  <tr>
                    <td>Chi phí IELTS riêng</td>
                    <td>Đã bao gồm trong học phí</td>
                    <td>30-80 triệu (3 năm)</td>
