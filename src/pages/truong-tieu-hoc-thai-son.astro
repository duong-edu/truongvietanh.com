---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadFormTwoStepEmailFirst from '../components/LeadFormTwoStepEmailFirst.astro';

const pageTitle = "Trường Tiểu Học Thái Sơn — Long Hậu, Cần Giuộc | Hệ thống Việt Anh từ 2011";
const pageDescription = "Trường Tiểu Học Thái Sơn — Một đứa trẻ bình thường có thể trở nên phi thường nếu được lớn lên trong môi trường được thiết kế đúng. Học phí 3.999.000 đ/tháng — 100 suất học bổng 50% còn 1.999.500 đ/tháng. Top 15 toàn cầu Leader In Me 2023.";
const pageCanonical = "https://truongvietanh.com/truong-tieu-hoc-thai-son";
const ogImage = "https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/tieu-hoc-banner-chinh-1.jpg";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Trường Tiểu Học Thái Sơn",
    "url": pageCanonical,
    "description": pageDescription,
    "telephone": "+84902095956",
    "email": "khai.nguyen@truongvietanh.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Xã Long Hậu, huyện Cần Giuộc",
      "addressLocality": "Tỉnh Tây Ninh",
      "addressCountry": "VN"
    },
    "parentOrganization": {
      "@type": "EducationalOrganization",
      "name": "Hệ thống Trường Việt Anh — Major Education",
      "url": "https://truongvietanh.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageCanonical,
    "inLanguage": "vi"
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
  structuredData={structuredData}
>
  <main class="ts-page">

    <!-- ============== SECTION 1: HERO ============== -->
    <section class="ts-hero">
      <div class="ts-hero__inner">
        <span class="ts-eyebrow">Hệ thống giáo dục Việt Anh từ 2011</span>
        <h1 class="ts-h1">MỘT ĐỨA TRẺ BÌNH THƯỜNG CÓ THỂ TRỞ NÊN PHI THƯỜNG NẾU ĐƯỢC LỚN LÊN TRONG MÔI TRƯỜNG ĐƯỢC THIẾT KẾ ĐÚNG</h1>
        <p class="ts-hero__sub">Chương trình giáo dục hiện đại hệ thống với Trường Việt Anh tại TP.HCM.</p>
        <div class="ts-hero__bullets">
          <div class="ts-hero__bullet">🌍 Tiếng Anh thực dụng</div>
          <div class="ts-hero__bullet">💡 Kỹ năng thế kỷ 21</div>
          <div class="ts-hero__bullet">💪 Thể chất toàn diện</div>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 2: FEE BANNER ============== -->
    <section class="ts-fee-banner">
      <div class="ts-fee-banner__inner">
        <h2 class="ts-fee__title">Học phí chỉ từ <strong>1.999.500 VND</strong></h2>
        <p class="ts-fee__sub">(ưu đãi học bổng 50%)</p>
        <p class="ts-fee__sub2">Áp dụng số lượng có hạn cho năm học mới</p>
        <a href="#ts-form" class="ts-btn ts-btn--primary">🚀 Kích hoạt hành trình giáo dục đứa con phi thường</a>
      </div>
    </section>

    <!-- ============== SECTION 3: PAIN POINTS ============== -->
    <section class="ts-pain">
      <div class="ts-section__inner">
        <h2 class="ts-h2">BẠN CÓ ĐANG NGHĨ ĐẾN ĐIỀU NÀY?</h2>
        <div class="ts-pain__list">
          <div class="ts-pain__card">
            <span class="ts-pain__icon">😟</span>
            <p>"Mình đi làm cả ngày… không có thời gian kèm con. Chỉ sợ con bị bỏ lại phía sau…"</p>
          </div>
          <div class="ts-pain__card">
            <span class="ts-pain__icon">💸</span>
            <p>"Trường tốt thì học phí cao quá. Nhưng trường rẻ thì lại sợ không được dạy bài bản.."</p>
          </div>
          <div class="ts-pain__card">
            <span class="ts-pain__icon">🌅</span>
            <p>"Mình làm lụng vất vả rồi… chỉ mong con sau này có cuộc sống ổn định hơn…"</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 4: POSITIONING ============== -->
    <section class="ts-positioning">
      <div class="ts-section__inner">
        <p class="ts-positioning__intro">Chúng tôi hiểu những điều đó. Trường Tiểu học Thái Sơn được xây dựng để trả lời đúng <strong>3 nỗi lo này</strong> — bằng chương trình giáo dục thực chất, hệ thống theo dõi minh bạch và mức học phí mà những gia đình đang làm việc vất vả thực sự có thể chi trả.</p>
        <div class="ts-callout">GIÁO DỤC TỐT KHÔNG PHẢI ĐẶC QUYỀN CỦA NHÀ GIÀU</div>
      </div>
    </section>

    <!-- ============== SECTION 5: SCHOOL BACKGROUND + 5 CAM KẾT ============== -->
    <section class="ts-background">
      <div class="ts-section__inner">
        <p class="ts-lead">Trường Tiểu học Thái Sơn thuộc <strong>hệ thống Việt Anh</strong> — hoạt động từ năm 2011 tại TP.HCM.</p>
        <p class="ts-lead"><strong>Chúng tôi không xây dựng trường để "giữ trẻ".</strong> Mà xây dựng một môi trường nơi mỗi bé được chăm sóc, theo dõi và phát triển đúng cách mỗi ngày.</p>
        <ul class="ts-checklist">
          <li>Chương trình học rõ ràng — không giữ trẻ đơn thuần</li>
          <li>Giáo viên được đào tạo bài bản — không tuyển tạm</li>
          <li>Mỗi bé được theo dõi và đánh giá mỗi ngày</li>
          <li>Tiếng Anh tiếp cận từ sớm — tự nhiên, không áp lực</li>
          <li>Phụ huynh luôn biết con học gì, ăn gì và thay đổi ra sao</li>
        </ul>
      </div>
    </section>

    <!-- ============== SECTION 6: 3 SỐ LIỆU NỔI BẬT ============== -->
    <section class="ts-stats">
      <div class="ts-section__inner">
        <h2 class="ts-h2">❗ NHỮNG ĐIỀU TẠO NÊN SỰ KHÁC BIỆT</h2>
        <p class="ts-h3 ts-h3--center">3 SỐ LIỆU NỔI BẬT</p>
        <div class="ts-stats__grid">
          <div class="ts-stat">
            <div class="ts-stat__num">13+</div>
            <p>năm — Hệ thống Việt Anh hoạt động liên tục</p>
          </div>
          <div class="ts-stat">
            <div class="ts-stat__num">Top 15</div>
            <p>toàn cầu — Cuộc thi Leader In Me 2023 cạnh tranh với trường từ 50+ quốc gia</p>
          </div>
          <div class="ts-stat">
            <div class="ts-stat__num">100%</div>
            <p>học sinh tốt nghiệp đạt điểm 10 Tiếng Anh kỳ thi THPT Quốc gia</p>
          </div>
        </div>
        <div class="ts-stats__cta">
          <a href="#ts-form" class="ts-btn ts-btn--primary">👉 Chat với trường</a>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 7: 4 TRỤ CỘT ============== -->
    <section class="ts-pillars">
      <div class="ts-section__inner">
        <h2 class="ts-h2">4 NỀN TẢNG QUAN TRỌNG GIÚP CON PHÁT TRIỂN TOÀN DIỆN</h2>
        <div class="ts-pillars__grid">
          <div class="ts-pillar">
            <h3>🧠 Trụ cột 1 — Tư duy phát triển</h3>
            <p>Con tự tin học tập, hiểu bài và <strong>không phụ thuộc vào việc học thêm</strong>.</p>
          </div>
          <div class="ts-pillar">
            <h3>🌍 Trụ cột 2 — Tiếng Anh: Không chỉ thi điểm cao, mà là dùng được</h3>
            <p>Con nghe – hiểu – giao tiếp tự nhiên, <strong>không áp lực học thêm</strong>.</p>
          </div>
          <div class="ts-pillar">
            <h3>💪 Trụ cột 3 — Sức khỏe: Được đầu tư như học thuật</h3>
            <p>Con khỏe mạnh, phát triển thể chất tốt và <strong>tập trung hơn</strong>.</p>
          </div>
          <div class="ts-pillar">
            <h3>❤️ Trụ cột 4 — Phẩm chất: Thứ quyết định tương lai</h3>
            <p>Con tự tin, biết chia sẻ và <strong>thích nghi tốt với môi trường xung quanh</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 7B: MỘT NGÀY CỦA CON (TKB) ============== -->
    <section class="ts-schedule">
      <div class="ts-section__inner">
        <h2 class="ts-h2">MỘT NGÀY CỦA CON TẠI THÁI SƠN</h2>
        <p class="ts-h3 ts-h3--center">Lịch học rõ ràng từ 7:25 đến 17:35 — học thật, chơi thật, nghỉ ngơi đủ</p>
        <div class="ts-timeline">
          <div class="ts-timeline__row"><span class="ts-timeline__time">7:25 – 7:40</span><span class="ts-timeline__act">Thể dục buổi sáng</span></div>
          <div class="ts-timeline__row"><span class="ts-timeline__time">7:40 – 8:20</span><span class="ts-timeline__act">Ăn sáng</span></div>
          <div class="ts-timeline__row ts-timeline__row--en"><span class="ts-timeline__time">8:20 – 9:40</span><span class="ts-timeline__act">Tiết 1 – 2: Chào cờ · Họp lớp · English · TLIM · HĐTN · Đạo đức</span></div>
          <div class="ts-timeline__row"><span class="ts-timeline__time">9:40 – 10:05</span><span class="ts-timeline__act">Điểm tâm (vitamin break)</span></div>
          <div class="ts-timeline__row ts-timeline__row--core"><span class="ts-timeline__time">10:25 – 11:45</span><span class="ts-timeline__act">Tiết 3 – 4: Tiếng Việt · Toán · English</span></div>
          <div class="ts-timeline__row"><span class="ts-timeline__time">11:55 – 13:35</span><span class="ts-timeline__act">Ăn trưa &amp; nghỉ trưa</span></div>
          <div class="ts-timeline__row ts-timeline__row--core"><span class="ts-timeline__time">13:45 – 15:05</span><span class="ts-timeline__act">Tiết 5 – 6: TNXH · Khoa học · Lịch sử · Tin học · Công nghệ · Toán · Nghệ thuật</span></div>
          <div class="ts-timeline__row"><span class="ts-timeline__time">15:05 – 15:35</span><span class="ts-timeline__act">Ăn xế (vitamin break)</span></div>
          <div class="ts-timeline__row ts-timeline__row--adv"><span class="ts-timeline__time">15:55 – 16:35</span><span class="ts-timeline__act">Tiết 7: Thể dục · DEAR &amp; Advisory · HĐTN · Chiêm nghiệm / Lập kế hoạch tuần (thứ Sáu)</span></div>
          <div class="ts-timeline__row"><span class="ts-timeline__time">16:35 – 17:35</span><span class="ts-timeline__act">Ra chơi, ra về</span></div>
        </div>
        <p class="ts-schedule__note">Khung giờ áp dụng chung cho <strong>khối lớp 1 – 5</strong>. Môn học mở rộng dần theo khối: lớp 1–3 có TNXH; lớp 4–5 thêm <strong>Khoa học, Lịch sử, Tin học, Công nghệ</strong>. <strong>English do giáo viên bản ngữ</strong> phụ trách — lộ trình Starters → Movers → Flyers. <em>(Thời khóa biểu năm học 2026 – 2027)</em></p>
      </div>
    </section>

    <!-- ============== SECTION 8: 5 NGUYÊN TẮC SỨC KHOẺ ============== -->
    <section class="ts-health">
      <div class="ts-section__inner">
        <h2 class="ts-h2">5 NGUYÊN TẮC GIÚP CON KHỎE MẠNH MỖI NGÀY</h2>
        <p class="ts-h3 ts-h3--center">Sức khỏe của con được chăm sóc như thế nào?</p>
        <p class="ts-philosophy">Tại Thái Sơn, sức khỏe của trẻ không phải là phụ — mà là <strong>nền tảng để con học tốt và phát triển toàn diện</strong>.</p>
        <div class="ts-health__grid">
          <div class="ts-health__item">🍎 ĂN TỐT</div>
          <div class="ts-health__item">💧 UỐNG TỐT</div>
          <div class="ts-health__item">😴 NGHỈ NGƠI TỐT</div>
          <div class="ts-health__item">⚽ THỂ DỤC THỂ THAO</div>
          <div class="ts-health__item">💛 NIỀM VUI MỖI NGÀY</div>
        </div>
        <blockquote class="ts-quote">"Não bộ được nuôi đúng cách — con học tốt hơn. Đây không phải lý thuyết, đây là <strong>sinh lý học</strong>."</blockquote>
      </div>
    </section>

    <!-- ============== SECTION 9: HỆ THỐNG THEO DÕI ============== -->
    <section class="ts-tracking">
      <div class="ts-section__inner">
        <h2 class="ts-h2">MỌI SỰ TIẾN BỘ CỦA CON ĐỀU ĐƯỢC THEO DÕI RÕ RÀNG</h2>
        <p class="ts-lead ts-lead--center">Dù bạn bận rộn cả ngày, bạn vẫn biết con đang học gì, thay đổi ra sao — một cách rõ ràng và liên tục.</p>

        <div class="ts-tracking__grid">
          <div class="ts-tracking__card">
            <h3>✔️ CÁCH CÁC CON ĐƯỢC KÈM CẶP</h3>
            <p>Giáo viên ghi nhận sự tiến bộ của con trên từng lĩnh vực: tiếng Anh, tư duy, kỹ năng sống, thể chất. Bạn mở điện thoại là thấy ngay — không cần chờ họp phụ huynh.</p>
          </div>
          <div class="ts-tracking__card">
            <h3>📱 MỖI TUẦN — CẬP NHẬT CỤ THỂ</h3>
            <p>Báo cáo chi tiết: con học gì, đạt được gì, cần cải thiện gì — gửi qua app.</p>
          </div>
          <div class="ts-tracking__card">
            <h3>🤝 MỖI THÁNG — CON TỰ KỂ CHUYỆN TIẾN BỘ</h3>
            <p>Buổi gặp 1-1 giữa con và giáo viên chủ nhiệm. Chính con là người dẫn dắt: đã làm gì, đạt được gì, cần cải thiện gì. Con học cách tự đánh giá bản thân từ sớm.</p>
          </div>
          <div class="ts-tracking__card">
            <h3>👨‍👩‍👧 5 LẦN MỖI NĂM CON ĐỨNG TRƯỚC CHA MẸ</h3>
            <p>Không phải giáo viên báo cáo thay. Chính con nói. Cha mẹ tận mắt thấy con đã lớn lên như thế nào — không chỉ điểm số, mà là <strong>bản lĩnh</strong>.</p>
          </div>
        </div>

        <p class="ts-tracking__closing">Bạn không cần ở bên con cả ngày để biết con đang phát triển như thế nào. Chúng tôi giúp bạn nhìn thấy điều đó — một cách <strong>minh bạch, liên tục và trực quan</strong>.</p>
        <div class="ts-tracking__cta">
          <a href="#ts-form" class="ts-btn ts-btn--primary">👉 Đến tham quan trường và nhận học bổng</a>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 10: FOUNDER ============== -->
    <section class="ts-founder">
      <div class="ts-section__inner">
        <h2 class="ts-h2 ts-h2--light">MỘT NGƯỜI LÀM GIÁO DỤC KHÔNG CHỈ MỞ TRƯỜNG MÀ XÂY DỰNG MỘT TIÊU CHUẨN</h2>
        <div class="ts-founder__profile">
          <div class="ts-founder__avatar">👤</div>
          <div>
            <div class="ts-founder__name">Nguyễn Mạnh Dương</div>
            <div class="ts-founder__role">Nhà sáng lập hệ thống giáo dục Việt Anh – Thái Sơn</div>
          </div>
        </div>
        <blockquote class="ts-founder__quote">
          <p>"Tôi xây trường không phải vì con tôi học ở đây. Tôi xây trường vì có một khoảng trống rất lớn giữa giáo dục Việt Nam, giáo dục thế giới và học sinh Việt Nam đang chịu thiệt thòi vì điều đó. Tôi muốn tạo ra một môi trường nơi một đứa trẻ bình thường cũng có thể phát triển tốt không bị giới hạn bởi xuất phát điểm, ngôn ngữ hay điều kiện gia đình."</p>
          <p class="ts-founder__creed"><strong>"Tôi tin rằng: quyền được học tốt không phải đặc quyền của nhà giàu. Và một đứa trẻ bình thường, trong môi trường được thiết kế đúng, hoàn toàn có thể trở nên phi thường."</strong></p>
        </blockquote>
      </div>
    </section>

    <!-- ============== SECTION 11: TESTIMONIALS ============== -->
    <section class="ts-testi">
      <div class="ts-section__inner">
        <h2 class="ts-h2">CẢM NHẬN CỦA PHỤ HUYNH</h2>
        <div class="ts-testi__grid">
          <article class="ts-testi__card">
            <blockquote>"Hồi đầu tôi không tin con mình học được tiếng Anh ở trường này. Nhưng mới học được một năm, con đã tự xem phim hoạt hình tiếng Anh không cần phụ đề. Tôi sốc thật sự. Chưa bao giờ nghĩ điều đó lại xảy ra với con mình."</blockquote>
            <cite>
              <strong>Chị Hương</strong>
              <span>Phụ huynh học sinh lớp 3 · Hệ thống Việt Anh</span>
            </cite>
          </article>
          <article class="ts-testi__card">
            <blockquote>"Con tôi trước hay nổi nóng, về nhà hay cãi. Sau một học kỳ, tự nhiên con bình tĩnh hơn, biết nói 'con xin lỗi' khi làm sai. Tôi hỏi con sao ngoan vậy, con nói 'trường dạy con đó mẹ.' Tôi khóc luôn."</blockquote>
            <cite>
              <strong>Anh Tuấn</strong>
              <span>Phụ huynh học sinh lớp 2 · Hệ thống Việt Anh</span>
            </cite>
          </article>
          <article class="ts-testi__card">
            <blockquote>"Tôi và chồng đều đi làm ca, 6 giờ sáng đã đi rồi. Gửi con ở đây tôi không lo lắng gì — buổi tối mở Zalo ra là biết hôm nay con học gì, ăn gì, chơi gì. Như có người báo cáo cho mình vậy. Lần đầu tiên gửi con đi mà thấy yên tâm thật sự."</blockquote>
            <cite>
              <strong>Chị Lan</strong>
              <span>Phụ huynh học sinh lớp 1 · Hệ thống Việt Anh</span>
            </cite>
          </article>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 12: TRUST FACTORS ============== -->
    <section class="ts-trust">
      <div class="ts-section__inner">
        <h2 class="ts-h2">VÌ SAO PHỤ HUYNH TIN TƯỞNG CHỌN TRƯỜNG THÁI SƠN?</h2>
        <div class="ts-trust__grid">
          <div class="ts-trust__card">
            <h3>💖 Tận hưởng niềm vui với sự thay đổi của con</h3>
            <p>Rõ ràng ngay từ đầu — không phát sinh bất ngờ.</p>
          </div>
          <div class="ts-trust__card ts-trust__card--feature">
            <h3>🎓 HỌC BỔNG KHAI TRƯỜNG — GIẢM 50%</h3>
            <p>Áp dụng đến khi con hoàn thành lớp 5 — <strong>không cần gia hạn mỗi năm</strong>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== SECTION 13: HỌC PHÍ CHÍNH THỨC ============== -->
    <section class="ts-pricing">
      <div class="ts-section__inner">
