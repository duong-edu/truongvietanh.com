    <!-- CTA section -->
    <div class="cta-section">
      <div class="countdown">⏰ Nhà trường phản hồi trong 24 giờ làm việc<strong id="timer" hidden></strong></div>

      <h2>Chọn cách liên hệ thuận tiện nhất</h2>
