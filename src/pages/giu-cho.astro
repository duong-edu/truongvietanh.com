    </div>
  </div>

  <div class="footer">
    Lion Camp 2026 — Trường Việt Anh<br>
    Hotline/Zalo: 0916 961 409
  </div>
</div>

<script is:inline>
(function() {
  var p = new URLSearchParams(window.location.search);
  var name = p.get('name') || '';
  var loc = p.get('loc') || '';
  var level = p.get('level') || '';

  // Personalize
  var el = document.getElementById('personalize');
  var levelMap = {'tieu-hoc':'Tiểu học','thcs':'THCS','thpt':'THPT'};
  var parts = [];
  if (name) parts.push(name);
  if (loc) parts.push('Cơ sở ' + loc);
  if (level && levelMap[level]) parts.push(levelMap[level]);
  if (parts.length) el.textContent = parts.join(' — ');

  // Zalo deep-link with pre-filled message
  var zaloMsg = 'Chào thầy/cô, tôi muốn đăng ký tư vấn 1:1 Lion Camp' +
    (loc ? ' ' + loc : '') +
    (level && levelMap[level] ? ' ' + levelMap[level] : '') +
    (name ? ' cho con (' + name + ')' : '') +
    '. Tôi muốn được tư vấn lộ trình và giữ chỗ ạ.';
  document.getElementById('ctaZalo').href = 'https://zalo.me/1678310120468101523?text=' + encodeURIComponent(zaloMsg);

  // Countdown (shared with quiz pages)
  var CK = 'camp_countdown_end';
  var stored = sessionStorage.getItem(CK);
  var endTime = stored ? parseInt(stored,10) : 0;
  if (!endTime || endTime < Date.now()) {
    endTime = Date.now() + 4 * 3600 * 1000;
    sessionStorage.setItem(CK, endTime.toString());
  }
  function tick() {
    var d = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
    var h = Math.floor(d/3600), m = Math.floor((d%3600)/60), s = d%60;
    document.getElementById('timer').textContent = (h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
  }
  tick(); setInterval(tick, 1000);

  // GTM
  if (window.dataLayer) {
    window.dataLayer.push({ event: 'view_giu_cho', location: loc, school_level: level });
  }
})();
</script>
    <script src="/js/phone-vn.js" defer></script>
  </body>
</html>
