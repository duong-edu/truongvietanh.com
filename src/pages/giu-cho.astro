  <style is:inline>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Open+Sans:wght@400;500;600;700&display=swap&subset=vietnamese');</style>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KPL2NSR9');</script>

  <style is:inline>:root{--p:#26275D;--p2:#363876;--acc:#f9dd0e;--gold:#F59E0B;--grn:#16A34A;--w:#fff;--fh:'Montserrat',sans-serif;--fb:'Open Sans',sans-serif}*{margin:0;padding:0;box-sizing:border-box}body{font-family:var(--fb);-webkit-font-smoothing:antialiased;color:#1C2A3A;background:linear-gradient(165deg,#EFF6FF 0%,#DBEAFE 50%,#BFDBFE 100%);min-height:100vh;display:flex;flex-direction:column;align-items:center}.wrap{max-width:680px;width:100%;padding:20px 16px 40px}/* Logo */
    .logo-bar{text-align:center;padding:12px 0 16px}.logo-bar img{max-width:220px;height:auto}/* Main card */
    .card{background:var(--w);border-radius:20px;box-shadow:0 12px 40px rgba(0,0,0,.08);overflow:hidden}/* Header */
    .card-header{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;padding:28px 28px 24px;text-align:center}.card-header h1{font-family:var(--fh);font-size:1.5rem;font-weight:800;margin-bottom:6px;line-height:1.3}.card-header .sub{font-size:1rem;opacity:.85;line-height:1.5}.card-header .name-hl{color:var(--gold);font-weight:700}/* Benefits */
    .benefits{display:grid;grid-template-columns:1fr 1fr;gap:0;border-bottom:1px solid #F0F0F0}.benefit{padding:20px 24px;display:flex;align-items:flex-start;gap:12px;border-bottom:1px solid #F8F8F8}.benefit:nth-child(odd){border-right:1px solid #F0F0F0}.benefit-icon{font-size:1.5rem;flex-shrink:0;margin-top:2px}.benefit-text h3{font-family:var(--fh);font-size:1.5rem;font-weight:700;color:var(--p);margin-bottom:2px}.benefit-text p{font-size:1rem;color:#666;line-height:1.45}/* CTA section */
    .cta-section{padding:28px;text-align:center}.cta-section h2{font-family:var(--fh);font-size:1.5rem;font-weight:800;color:var(--p);margin-bottom:6px}.cta-section .cta-desc{font-size:1rem;color:#666;margin-bottom:20px;line-height:1.5}.cta-btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:16px 28px;border-radius:14px;font-family:var(--fh);font-weight:700;font-size:1.05rem;text-decoration:none;transition:all .2s;margin-bottom:12px;border:none;cursor:pointer;width:100%}.cta-btn--zalo{background:#0068FF;color:#fff;box-shadow:0 4px 16px rgba(0,104,255,.3);animation:pulse 2.5s infinite}.cta-btn--zalo:hover{background:#0056D6;transform:translateY(-2px)}.cta-btn--phone{background:linear-gradient(135deg,var(--acc),var(--gold));color:#fff;box-shadow:0 4px 14px rgba(249, 221, 14,.3)}.cta-btn--phone:hover{transform:translateY(-2px)}
    @keyframes pulse{0%,100%{box-shadow:0 4px 16px rgba(0,104,255,.3)}50%{box-shadow:0 4px 28px rgba(0,104,255,.5),0 0 40px rgba(0,104,255,.15)}}.trust-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid #F0F0F0}.trust-item{display:flex;align-items:center;gap:4px;font-size:1rem;color:#999;font-weight:500}/* Countdown */
    .countdown{display:inline-flex;align-items:center;gap:6px;background:rgba(239,68,68,.08);color:#991B1B;padding:8px 16px;border-radius:50px;font-size:1rem;font-weight:600;margin-bottom:16px}.countdown strong{font-family:var(--fh);letter-spacing:.5px}/* Footer */
    .footer{text-align:center;padding:16px;font-size:1rem;color:#999}

    @media(max-width:600px){.benefits{grid-template-columns:1fr}.benefit:nth-child(odd){border-right:none}.card-header{padding:24px 20px}.cta-section{padding:24px 20px}.card-header h1{font-size:1.2rem}
    }
  </style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KPL2NSR9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="wrap">
  <div class="logo-bar">
    <img src="/logo-vietanh.png" alt="Trường TH - THCS - THPT Việt Anh" />
  </div>

  <div class="card">
    <!-- Header -->
    <div class="card-header">
      <h1>Đăng Ký Nhận Tư Vấn Cá Nhân Hóa Lộ Trình</h1>
      <p class="sub">Chuyên gia giáo dục sẽ gọi cho Ba/Mẹ trong <strong>5 phút</strong> để tư vấn lộ trình Lion Camp phù hợp nhất<br><span class="name-hl" id="personalize"></span></p>
    </div>

    <!-- Benefits — what you get from the consultation -->
    <div class="benefits">
      <div class="benefit">
        <span class="benefit-icon">📊</span>
        <div class="benefit-text">
          <h3>Phân tích kết quả chi tiết</h3>
          <p>Giải thích 6 kỹ năng và so sánh với chuẩn độ tuổi</p>
        </div>
      </div>
      <div class="benefit">
        <span class="benefit-icon">🗺️</span>
        <div class="benefit-text">
          <h3>Lộ trình cá nhân hóa</h3>
          <p>Khuyến nghị chương trình Lion Camp phù hợp nhất cho con</p>
        </div>
      </div>
      <div class="benefit">
        <span class="benefit-icon">🎁</span>
        <div class="benefit-text">
          <h3>Học bổng Early Bird đến 30%</h3>
          <p>Tư vấn viên sẽ kiểm tra mức học bổng cao nhất hiện có</p>
        </div>
      </div>
      <div class="benefit">
        <span class="benefit-icon">🔒</span>
        <div class="benefit-text">
          <h3>Giữ chỗ ưu tiên</h3>
          <p>Tư vấn viên hỗ trợ giữ chỗ trước khi lớp đầy</p>
        </div>
      </div>
