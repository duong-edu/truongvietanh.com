      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="cta-btn cta-btn--zalo" id="ctaZalo">
        💬 Nhắn Zalo để được tư vấn ngay
      </a>
      <a href="tel:+84916961409" class="cta-btn cta-btn--phone">
        📞 Gọi ngay 0916 961 409
      </a>

      <div class="trust-row">
        <span class="trust-item">✅ Miễn phí hoàn toàn</span>
        <span class="trust-item">⏱️ Chỉ 15 phút</span>
        <span class="trust-item">🏫 15+ năm kinh nghiệm</span>
