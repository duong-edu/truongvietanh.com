<BaseLayout
  title="Quy trình Giải quyết Khiếu nại — Trường Việt Anh"
  description="Cách gửi khiếu nại, phản ánh tới Trường Việt Anh: kênh tiếp nhận, thời hạn trả lời, việc an toàn học sinh được xử lý ngay, và quyền khiếu nại tiếp lên cơ quan nhà nước."
  keywords="khiếu nại trường việt anh, quy trình giải quyết khiếu nại, đầu mối hiệu trưởng, mẫu đơn khiếu nại"
  canonical="https://truongvietanh.com/khieu-nai"
  structuredData={structuredData}
>
  <div class="gi-page">
    <HeaderBase />

    <section class="gi-hero">
      <div class="gi-container gi-hero-inner">
        <div class="gi-hero-left" style="flex:1">
          <nav class="gi-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a>
            <span aria-hidden="true"></span>
            <span>Khiếu nại</span>
          </nav>
