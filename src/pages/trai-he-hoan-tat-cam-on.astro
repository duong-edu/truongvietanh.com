(function(){var K='camp_countdown_end';var s=sessionStorage.getItem(K);var e=s?parseInt(s,10):0;if(!e||e<Date.now()){e=Date.now()+4*3600*1000;sessionStorage.setItem(K,e.toString());}var el=document.getElementById('countdown');setInterval(function(){var d=Math.max(0,Math.floor((e-Date.now())/1000));var h=Math.floor(d/3600),m=Math.floor((d%3600)/60),sc=d%60;el.textContent=(h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(sc<10?'0':'')+sc;},1e3);var c=document.getElementById('confetti');if(c){var x=c.getContext('2d');c.width=window.innerWidth;c.height=window.innerHeight;var ps=[];var cs=['#F0D048','#F59E0B','#1a1a5e','#16A34A','#0068FF','#EF4444'];for(var i=0;i<80;i++){ps.push({x:Math.random()*c.width,y:Math.random()*-c.height,w:Math.random()*8+4,h:Math.random()*6+2,r:Math.random()*360,col:cs[Math.floor(Math.random()*cs.length)],vx:(Math.random()-.5)*3,vy:Math.random()*3+2,vr:(Math.random()-.5)*8});}var f=0;function draw(){x.clearRect(0,0,c.width,c.height);ps.forEach(function(p){x.save();x.translate(p.x,p.y);x.rotate(p.r*Math.PI/180);x.fillStyle=p.col;x.globalAlpha=Math.max(0,1-f/120);x.fillRect(-p.w/2,-p.h/2,p.w,p.h);x.restore();p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;p.vy+=0.05;});f++;if(f<150)requestAnimationFrame(draw);else{x.clearRect(0,0,c.width,c.height);c.style.display='none';}}draw();}document.querySelectorAll('.cta-btn').forEach(function(b){b.addEventListener('click',function(){if(window.dataLayer)window.dataLayer.push({event:'cta_click',cta_text:b.textContent.trim().substring(0,50),page:'thank_you',funnel_code:'trai-he-hoan-tat-cam-on'});});});})();
