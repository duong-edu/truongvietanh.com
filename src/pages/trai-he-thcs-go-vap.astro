---
import MamNonHookLayout from '../layouts/MamNonHookLayout.astro';
import USPGrid from '../components/USPGrid.astro';
import TrustMetrics from '../components/TrustMetrics.astro';
import FAQSection from '../components/FAQSection.astro';

const uspItems = [
    {
      "icon": "🦁",
      "text": "6 tuần học hè bao trọn — không phải gửi con đi đâu khác"
    },
    {
      "icon": "🇬🇧",
      "text": "Giáo viên bản ngữ + giáo viên Việt cùng dạy theo CEFR"
    },
    {
      "icon": "🧪",
      "text": "STEM — Robotics — Mỹ thuật — Thể thao đa dạng mỗi ngày"
    },
    {
      "icon": "🏕️",
      "text": "1–2 chuyến field trip / overnight camp tăng tự lập"
    },
    {
      "icon": "🍱",
      "text": "Bữa ăn 4 bữa do bếp trường nấu — chuyên gia dinh dưỡng giám sát"
    },
    {
      "icon": "💸",
      "text": "Early Bird giảm 30% học phí · Brother & Sister giảm thêm 10%"
    }
  ];

const metrics = [
  { number: '15+', label: 'Năm kinh nghiệm giáo dục song ngữ' },
  { number: '3,000+', label: 'Học sinh đã và đang theo học' },
  { number: '95%', label: 'Phụ huynh hài lòng & giới thiệu bạn bè' },
  { number: '8', label: 'Cơ sở tại TP.HCM, Tây Ninh, An Giang' },
];

const faqItems = [
    {
      "question": "Trại hè diễn ra trong bao lâu?",
      "answer": "Lion Camp 2026 kéo dài 6 tuần, từ tuần đầu tháng 6 đến giữa tháng 7, học từ thứ 2 đến thứ 6, 7h30 — 16h30. Có thể đăng ký theo tuần hoặc trọn khóa."
    },
    {
      "question": "Con tôi chưa học tại Việt Anh có tham gia được không?",
      "answer": "Có. Lion Camp mở cho cả học sinh ngoài hệ thống. Đây là cơ hội tốt để con và phụ huynh trải nghiệm thực tế trước khi quyết định nhập học chính khóa."
    },
    {
      "question": "Học phí trại hè là bao nhiêu?",
      "answer": "Học phí phụ thuộc cấp học và cơ sở. Đăng ký Early Bird trước 30/4 giảm 30%. Vui lòng để lại thông tin để được gửi bảng giá chi tiết và chính sách ưu đãi."
    },
    {
      "question": "Có cần đồng phục/dụng cụ riêng không?",
      "answer": "Trường cung cấp đồng phục Lion Camp + balo + bình nước miễn phí khi đăng ký trọn khóa. Phụ huynh chỉ cần chuẩn bị giày thể thao và đồ dùng cá nhân."
    },
    {
      "question": "Có dịch vụ đưa đón không?",
      "answer": "Có. Cơ sở Gò Vấp có xe đưa đón bán kính 10km. Vui lòng cung cấp địa chỉ nhà để được báo phí xe theo tuyến."
    }
  ];
---
<MamNonHookLayout
  title="Trại Hè THCS Gò Vấp 2026 | Trường Việt Anh"
  description="Tiếng Anh Oxford + AI Lab thực hành + IELTS chuyên sâu. Bé THCS rèn kỹ năng lãnh đạo, tư duy phản biện và làm việc nhóm. 6 tuần đột phá trước năm học mới."
  canonicalUrl="https://truongvietanh.com/trai-he-thcs-go-vap"
  location="Gò Vấp"
  address="160/72 Phan Huy Ích, P.15, Q.Gò Vấp, TPHCM"
  hookHeadline={`Trại Hè THCS <span class="mark">Oxford + AI + IELTS</span> Gò Vấp<em>Khai giảng 15/06/2026 · 6 tuần bứt phá</em>`}
  hookSubline="Tiếng Anh Oxford + AI Lab thực hành + IELTS chuyên sâu. Bé THCS rèn kỹ năng lãnh đạo, tư duy phản biện và làm việc nhóm. 6 tuần đột phá trước năm học mới."
  source="trai-he-thcs-go-vap"
  funnelCode="trai-he-thcs-go-vap"
  schoolLevel="thcs"
  levelLabel="Trại Hè THCS"
  bullets={[
    { icon: '🤖', html: '<strong>AI Lab + Robotics</strong> — dự án thật tay, không lý thuyết suông' },
    { icon: '📚', html: '<strong>Oxford + IELTS chuyên sâu</strong> — bứt phá điểm số' },
    { icon: '🎯', html: '<strong>Kỹ năng lãnh đạo</strong> — debate, presentation, teamwork' },
    { icon: '☀️', html: '<strong>Khai giảng 15/06/2026</strong> — 6 tuần đột phá trước năm học mới' },
  ]}
  cardTitle="Đăng ký Trại Hè THCS Gò Vấp"
  cardSub="Tư vấn miễn phí · Phản hồi 24h · Ưu đãi early bird"
  ctaStep2="🏕️ Đăng ký Trại Hè"
  fomoText="🔥 Trại Hè Lion Camp 2026 · Khai giảng 15/06 · Số chỗ có hạn"
  trustMarks={['Có quyết định cho phép hoạt động', '15 năm K12 từ 2011', '2 cơ sở chính thức tại TP.HCM']}
  heroImage="https://media.truongvietanh.com/images/Block%20Hero%20_%20BG%20-%20website/banner-chinh.jpg"
  redirectUrl="/trai-he-thcs-go-vap-cam-on"
  extended>
  <USPGrid title="Vì sao chọn Trường Việt Anh?" items={uspItems} />
  <TrustMetrics title="Trường Việt Anh trong số liệu" metrics={metrics} />
  <FAQSection title="Câu hỏi thường gặp" items={faqItems} />
</MamNonHookLayout>
