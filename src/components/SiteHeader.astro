---
import { contactLinks, mainNavLeft, mainNavRight } from '../lib/site-content';
import { getSiteSettings } from '../lib/directus';

const siteSettings = await getSiteSettings();
const announcementText = siteSettings?.announcement_text || 'Tuyển sinh 2026–2027 đang mở — Ưu đãi Đăng ký sớm giảm đến 46% học phí.';
const announcementLink = siteSettings?.announcement_link || '/tuyen-sinh';
const announcementActive = siteSettings?.announcement_active ?? true;

type NavItem = {
  label: string;
  href: string;
  children?: Array<{
    label: string;
    href: string;
  }>;
};

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;

function isActive(item: NavItem, path: string): boolean {
  if (item.href === '/') return path === '/';
  if (item.href.startsWith('#')) return false;
  return path === item.href || path.startsWith(`${item.href}/`);
}

function isChildActive(item: NavItem, path: string): boolean {
  return item.children?.some(child => path === child.href || path.startsWith(`${child.href}/`)) ?? false;
}
---

<!-- TOP BAR — merged announcement + hotline + zalo into 1 row -->
<div class="wp-top-bar">
  <div class="wp-container wp-top-bar__inner">
    <div class="wp-top-bar__left wp-top-bar__announcement">
      {announcementActive && (
        <span class="wp-top-bar__announce">
          🎓 {announcementText} <a href={announcementLink} class="wp-top-bar__announce-link">Đăng ký ngay →</a>
        </span>
      )}
    </div>
    <div class="wp-top-bar__right">
      <a href={contactLinks.phoneHref} class="wp-top-bar__link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>Hotline: {contactLinks.phoneDisplay}</span>
      </a>
      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer" class="wp-top-bar__link wp-top-bar__link--zalo">
        <img src="https://page.zalo.me/static/img/zalo-logo.svg" alt="Zalo" width="16" height="16" style="vertical-align:middle" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"/>
        <svg style="display:none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <span>Zalo</span>
      </a>
      <button aria-label="Tìm kiếm" class="search-btn" style="background:none;border:none;color:#fff;cursor:pointer;display:flex;align-items:center;padding:0.3rem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <!-- Nút chọn ngôn ngữ. Xem public/js/va-lang.js -->
      <div data-va-lang></div>
    </div>
  </div>
</div>
<script src="/js/va-lang.js" is:inline defer></script>

<!-- MAIN NAVIGATION -->
<header class="wp-header" id="wp-header">
  <nav class="wp-container wp-nav" aria-label="Điều hướng chính">
    <!-- Left nav items -->
    <ul class="wp-nav__list wp-nav__list--left">
      {mainNavLeft.map((item) => (
        <li class={`wp-nav__item ${item.children ? 'wp-nav__item--dropdown' : ''} ${isActive(item, currentPath) || isChildActive(item, currentPath) ? 'is-active' : ''}`}>
          <a href={item.href} class="wp-nav__link">
            {item.label}
            {item.children && (
              <svg class="wp-nav__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            )}
          </a>
          {item.children && (
            <ul class="wp-dropdown">
              {item.children.map(child => (
                <li>
                  <a href={child.href} class={currentPath === child.href ? 'is-active' : ''}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Center logo -->
    <div class="wp-nav__logo">
      <a href="/">
        <img src="https://truongvietanh.com/logo-vietanh.webp" alt="Trường Việt Anh" width="440" height="215" decoding="async" />
      </a>
    </div>

    <!-- Right nav items -->
    <ul class="wp-nav__list wp-nav__list--right">
      {mainNavRight.map((item) => (
        <li class={`wp-nav__item ${item.children ? 'wp-nav__item--dropdown' : ''} ${isActive(item, currentPath) || isChildActive(item, currentPath) ? 'is-active' : ''}`}>
          <a href={item.href} class="wp-nav__link">
            {item.label}
            {item.children && (
              <svg class="wp-nav__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            )}
          </a>
          {item.children && (
            <ul class="wp-dropdown">
              {item.children.map(child => (
                <li>
                  <a href={child.href} class={currentPath === child.href ? 'is-active' : ''}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button class="wp-hamburger" id="wp-hamburger" aria-label="Mở menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <!-- Mobile menu overlay -->
  <div class="wp-mobile-menu" id="wp-mobile-menu">
    <div class="wp-mobile-menu__inner">
      {[...mainNavLeft, ...mainNavRight].map((item) => (
        <div class={`wp-mobile-menu__item ${item.children ? 'wp-mobile-menu__item--has-children' : ''}`}>
          <a href={item.href} class="wp-mobile-menu__link">{item.label}</a>
          {item.children && (
            <div class="wp-mobile-menu__sub">
              {item.children.map(child => (
                <a href={child.href}>{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="wp-mobile-menu__cta">
        <a href={contactLinks.phoneHref} class="wp-mobile-menu__phone">Gọi {contactLinks.phoneDisplay}</a>
        <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noreferrer" class="wp-mobile-menu__btn">Chat Zalo OA</a>
      </div>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('wp-hamburger');
  const mobileMenu = document.getElementById('wp-mobile-menu');
  const header = document.getElementById('wp-header');

  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('is-open');
      mobileMenu.classList.toggle('is-open');
      document.body.classList.toggle('menu-open');
    });

    // Toggle submenus on mobile
    const parentItems = mobileMenu.querySelectorAll('.wp-mobile-menu__item--has-children');
    parentItems.forEach(item => {
      const link = item.querySelector('.wp-mobile-menu__link');
      if (link) {
        link.addEventListener('click', (e) => {
          if (window.innerWidth <= 1024) {
            e.preventDefault();
            item.classList.toggle('is-expanded');
          }
        });
      }
    });
  }

  // Search modal (same as HeaderBase)
  const searchPages = [
    { title: 'Trang Chủ', url: '/', desc: 'Hệ thống giáo dục liên cấp song ngữ từ Mầm Non đến THPT' },
    { title: 'Giới Thiệu', url: '/gioi-thieu', desc: 'Sứ mệnh, tầm nhìn, giá trị cốt lõi' },
    { title: 'Mầm Non', url: '/mam-non', desc: 'Montessori, 100% tiếng Anh từ 12 tháng' },
    { title: 'School Ready', url: '/school-ready', desc: '16 năng lực để con vào lớp 1 tự tin, tự lập' },
    { title: 'Tiểu Học', url: '/tieu-hoc', desc: 'UK Oxford, STEM, kỹ năng thế kỷ 21' },
    { title: 'THCS', url: '/trung-hoc-co-so', desc: 'Song ngữ, IELTS, Debate, Robotics' },
    { title: 'THPT', url: '/trung-hoc-pho-thong', desc: 'IELTS 6.0-8.0, du học, 99% đỗ ĐH' },
    { title: 'Tuyển Sinh', url: '/tuyen-sinh', desc: 'Quy trình, ưu đãi đăng ký sớm, học bổng' },
    { title: 'Học Phí', url: '/hoc-phi', desc: 'Bảng phí Mầm Non đến THPT' },
    { title: 'Cơ Sở', url: '/co-so', desc: '6 cơ sở TP.HCM, Tây Ninh, An Giang' },
    { title: 'So Sánh', url: '/so-sanh', desc: 'Việt Anh vs Công lập vs Quốc tế' },
    { title: 'Sự Kiện', url: '/su-kien', desc: 'Open Day, Workshop, Hội thao' },
    { title: 'Học Bổng', url: '/hoc-bong', desc: 'Giảm đến 50% học phí' },
    { title: 'Thành Tích', url: '/thanh-tich-hoc-tap', desc: 'IELTS, Olympic, du học' },
    { title: 'Tin Tức', url: '/tin-tuc', desc: 'Blog, sự kiện, kiến thức' },
    { title: 'Liên Hệ', url: '/lien-he', desc: 'Hotline, Zalo, địa chỉ' },
  ];
  const overlay = document.getElementById('searchOverlay');
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const list = document.getElementById('searchList');
  const defaultEl = document.querySelector<HTMLElement>('.search-default');
  const closeBtn = document.getElementById('searchClose');
  const openBtns = document.querySelectorAll('.search-btn');
  function openSearch() { if(!overlay) return; overlay.classList.add('is-open'); overlay.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; setTimeout(()=>input?.focus(),100); }
  function closeSearch() { if(!overlay) return; overlay.classList.remove('is-open'); overlay.setAttribute('aria-hidden','true'); document.body.style.overflow=''; if(input)input.value=''; if(list)list.innerHTML=''; if(defaultEl)defaultEl.style.display=''; }
  openBtns.forEach(btn => btn.addEventListener('click', openSearch));
  if(closeBtn) closeBtn.addEventListener('click', closeSearch);
  if(overlay) overlay.addEventListener('click', e => { if(e.target===overlay) closeSearch(); });
  document.addEventListener('keydown', e => { if(e.key==='Escape') closeSearch(); if((e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();openSearch();} });
  if(input) input.addEventListener('input', () => {
    const q=input.value.trim().toLowerCase();
    if(!q){if(list)list.innerHTML='';if(defaultEl)defaultEl.style.display='';return;}
    if(defaultEl)defaultEl.style.display='none';
    const results=searchPages.filter(p=>p.title.toLowerCase().includes(q)||p.desc.toLowerCase().includes(q));
    if(list) list.innerHTML=results.length===0?'<li class="search-empty">Không tìm thấy.</li>':results.map(r=>`<li><a href="${r.url}" class="search-result"><strong>${r.title}</strong><span>${r.desc}</span></a></li>`).join('');
  });
</script>

<!-- Search Modal (shared with HeaderBase) -->
<div class="search-overlay" id="searchOverlay" aria-hidden="true">
  <div class="search-modal">
    <div class="search-modal__header">
      <div class="search-input-wrap">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="searchInput" class="search-modal__input" placeholder="Tìm kiếm trang, chương trình, học phí..." autocomplete="off" />
        <button class="search-modal__close" id="searchClose" aria-label="Đóng">&times;</button>
      </div>
    </div>
    <div class="search-modal__results" id="searchResults">
      <div class="search-default">
        <p class="search-hint">Gợi ý phổ biến</p>
        <div class="search-tags">
          <a href="/tuyen-sinh" class="search-tag">Tuyển sinh</a>
          <a href="/hoc-phi" class="search-tag">Học phí</a>
          <a href="/mam-non" class="search-tag">Mầm non</a>
          <a href="/so-sanh" class="search-tag">So sánh</a>
          <a href="/hoc-bong" class="search-tag">Học bổng</a>
          <a href="/lien-he" class="search-tag">Liên hệ</a>
        </div>
      </div>
      <ul class="search-list" id="searchList"></ul>
    </div>
  </div>
</div>

<style>.search-overlay{display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);opacity:0;transition:opacity 0.25s}.search-overlay.is-open{display:flex;opacity:1;justify-content:center;padding-top:12vh}.search-modal{background:#fff;border-radius:16px;width:560px;max-width:92vw;max-height:70vh;box-shadow:0 20px 60px rgba(0,0,0,0.2);display:flex;flex-direction:column;overflow:hidden;animation:searchSlideIn 0.25s ease-out}
  @keyframes searchSlideIn{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}.search-modal__header{padding:1rem 1.25rem;border-bottom:1px solid #e2e8f0}.search-input-wrap{display:flex;align-items:center;gap:0.6rem;background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:12px;padding:0.6rem 1rem;transition:border-color 0.2s}.search-input-wrap:focus-within{border-color:#f9dd0e}.search-input-icon{color:#64748b;flex-shrink:0}.search-modal__input{flex:1;border:none;outline:none;background:transparent;font-size:1rem;color:#26275D}.search-modal__close{background:none;border:none;font-size:1.5rem;color:#64748b;cursor:pointer}.search-modal__results{overflow-y:auto;padding:1rem 1.25rem;flex:1}.search-hint{font-size:1rem;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 0.75rem}.search-tags{display:flex;flex-wrap:wrap;gap:0.5rem}.search-tag{padding:0.4rem 0.9rem;background:#f1f5f9;border-radius:20px;font-size:1rem;color:#475569;text-decoration:none;transition:all 0.2s}.search-tag:hover{background:#26275D;color:#fff}.search-list{list-style:none;padding:0;margin:0}.search-result{display:block;padding:0.85rem 0.5rem;text-decoration:none;border-radius:8px;transition:background 0.15s}.search-result:hover{background:#f8fafc}.search-result strong{display:block;color:#26275D;font-size:1rem}.search-result span{display:block;color:#64748b;font-size:1rem}.search-empty{text-align:center;padding:2rem 0;color:#64748b}
</style>
