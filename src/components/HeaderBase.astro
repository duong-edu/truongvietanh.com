---
// src/components/HeaderBase.astro — header trang trong: chỉ logo (button về trang chủ) +
// hamburger mobile. Thanh menu đầy đủ 8 mục chỉ hiển thị ở trang chủ (xem SiteHeader.astro).
import { getSiteSettings } from '../lib/directus';

const settings = await getSiteSettings();
const hotline = settings?.hotline || '0916 961 409';
const logoUrl = "/logo-vietanh.webp";
---

<div class="top-bar">
  <div class="cf-container top-bar-inner">
    <div class="top-left">
      <a href={`tel:${hotline.replace(/\s/g, '')}`} class="icon-text text-nowrap" style="text-decoration:none;color:inherit">
         <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
         Hotline: {hotline}
      </a>
      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="icon-text d-none-mo text-nowrap" style="margin-left:1.5rem;text-decoration:none;color:inherit">
         <img src="https://page.zalo.me/static/img/zalo-logo.svg" alt="Zalo OA" width="16" height="16" style="vertical-align:middle" onerror="this.style.display='none'" />
         Zalo OA
      </a>
    </div>
    <div class="top-right">
      <button aria-label="Tìm kiếm trên website" class="search-btn d-none-mo">
         <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <a href="https://m.me/truongvietanhhcm" target="_blank" rel="noopener" class="btn-yellow d-none-mo">Facebook Chat ↗</a>
      <!-- Nút chọn ngôn ngữ — hiện cả trên mobile. Xem public/js/va-lang.js -->
      <div data-va-lang></div>
    </div>
  </div>
</div>

<header class="main-header">
  <nav class="nav-grid">
     <!-- Trang trong không hiện thanh menu — chỉ logo (bấm về trang chủ) + hamburger mobile.
          Hai <ul> rỗng dưới đây giữ nguyên 2 cột 1fr của .nav-grid để logo canh giữa như cũ. -->
     <ul class="nav-links left-nav" aria-hidden="true"></ul>

     <div class="header-logo text-center">
       <a href="/">
          <img src={logoUrl} alt="Trường Liên Cấp Việt Anh" class="official-logo" width="180" height="120" />
       </a>
     </div>

     <ul class="nav-links right-nav" aria-hidden="true"></ul>

     <!-- Mobile hamburger -->
     <button class="mobile-menu-btn" aria-label="Mở menu" aria-expanded="false">
       <span class="hamburger-line"></span>
       <span class="hamburger-line"></span>
       <span class="hamburger-line"></span>
     </button>
  </nav>

  <!-- Mobile nav drawer -->
  <div class="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-nav-inner">
      <div class="mobile-nav-group">
        <button class="mobile-nav-link mobile-nav-toggle" aria-expanded="false" aria-label="Mở menu Giới thiệu">Giới thiệu <span class="toggle-arrow">▾</span></button>
        <div class="mobile-nav-sub">
          <a href="/gioi-thieu" class="mobile-nav-sublink">Giới thiệu nhà trường</a>
          <a href="/ban-lanh-dao" class="mobile-nav-sublink">Ban Lãnh Đạo</a>
          <a href="/giao-vien" class="mobile-nav-sublink">Giáo viên</a>
          <a href="/tamlyhocduong" class="mobile-nav-sublink">Tâm lý học đường</a>
          <a href="/hoc-bong" class="mobile-nav-sublink">Học bổng</a>
          <a href="/hoc-phi" class="mobile-nav-sublink">Học phí</a>
          <a href="/am-nhac" class="mobile-nav-sublink">Âm nhạc Việt Anh</a>
        </div>
      </div>
      <a href="/thanh-tich-hoc-tap" class="mobile-nav-link">Thành tích</a>
      <a href="/danh-gia-cua-phu-huynh" class="mobile-nav-link">Đánh giá</a>
      <div class="mobile-nav-group">
        <button class="mobile-nav-link mobile-nav-toggle" aria-expanded="false" aria-label="Mở menu Chương trình">Chương trình <span class="toggle-arrow">▾</span></button>
        <div class="mobile-nav-sub">
          <a href="/mam-non" class="mobile-nav-sublink">Mầm non</a>
          <a href="/tieu-hoc" class="mobile-nav-sublink">Tiểu học</a>
          <a href="/thcs" class="mobile-nav-sublink">THCS</a>
          <a href="/thpt" class="mobile-nav-sublink">THPT</a>
          <a href="/trai-he-2026" class="mobile-nav-sublink">Trại hè</a>
          <a href="/tieng-anh-tre-em" class="mobile-nav-sublink">Tiếng Anh Trẻ Em</a>
          <a href="/toan-tu-duy" class="mobile-nav-sublink">Toán Tư Duy</a>
          <a href="/giai-ma-tiem-nang" class="mobile-nav-sublink">Giải Mã Tiềm Năng</a>
          <a href="/du-hoc" class="mobile-nav-sublink">Du học</a>
          <a href="/chuong-trinh/ky-luat-tich-cuc" class="mobile-nav-sublink">Kỷ luật tích cực</a>
        </div>
      </div>
      <div class="mobile-nav-group">
        <button class="mobile-nav-link mobile-nav-toggle" aria-expanded="false" aria-label="Mở menu Tuyển sinh">Tuyển sinh <span class="toggle-arrow">▾</span></button>
        <div class="mobile-nav-sub">
          <a href="/tuyen-sinh/mam-non" class="mobile-nav-sublink">Mầm non</a>
          <a href="/tuyen-sinh/tieu-hoc" class="mobile-nav-sublink">Tiểu học</a>
          <a href="/tuyen-sinh/thcs" class="mobile-nav-sublink">THCS</a>
          <a href="/tuyen-sinh/thpt" class="mobile-nav-sublink">THPT</a>
          <a href="/noi-tru" class="mobile-nav-sublink">Nội trú</a>
          <a href="/tuyen-sinh/trai-he" class="mobile-nav-sublink">Trại hè</a>
          <a href="/tuyen-sinh/tieng-anh-tre-em" class="mobile-nav-sublink">Tiếng Anh Trẻ Em</a>
          <a href="/tuyen-sinh/toan-tu-duy" class="mobile-nav-sublink">Toán Tư Duy</a>
          <a href="/giai-ma-tiem-nang" class="mobile-nav-sublink">Giải Mã Tiềm Năng</a>
        </div>
      </div>
      <div class="mobile-nav-group">
      <a href="/blog" class="mobile-nav-link">Blog</a>
      <a href="/hinh-anh" class="mobile-nav-link">Hình ảnh</a>
      <a href="/lien-he" class="mobile-nav-link">Liên hệ</a>
      <a href="https://zalo.me/1678310120468101523" target="_blank" rel="noopener" class="mobile-nav-cta">Chat Zalo OA</a>
    </div>
  </div>
</header>

<!-- Search Modal -->
<div class="search-overlay" id="searchOverlay" aria-hidden="true">
  <div class="search-modal">
    <div class="search-modal__header">
      <div class="search-input-wrap">
        <svg class="search-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="searchInput" class="search-modal__input" placeholder="Tìm kiếm trang, chương trình, học phí..." autocomplete="off" />
        <button class="search-modal__close" id="searchClose" aria-label="Đóng tìm kiếm">&times;</button>
      </div>
    </div>
    <div class="search-modal__results" id="searchResults">
      <div class="search-default">
        <p class="search-hint">Gợi ý tìm kiếm phổ biến</p>
        <div class="search-tags">
          <a href="/tuyen-sinh" class="search-tag">Tuyển sinh 2026</a>
          <a href="/hoc-phi" class="search-tag">Học phí</a>
          <a href="/mam-non" class="search-tag">Mầm non</a>
          <a href="/tieu-hoc" class="search-tag">Tiểu học</a>
          <a href="/co-so" class="search-tag">Cơ sở</a>
          <a href="/triet-ly-giao-duc" class="search-tag">Triết lý giáo dục</a>
          <a href="/thanh-tich-hoc-tap" class="search-tag">Thành tích</a>
          <a href="/lien-he" class="search-tag">Liên hệ</a>
        </div>
      </div>
      <ul class="search-list" id="searchList"></ul>
    </div>
  </div>
</div>

<script src="/js/va-lang.js" is:inline defer></script>

<script>
  // Search data - all main pages
  const searchPages = [
    { title: 'Trang Chủ — Trường Việt Anh', url: '/', desc: 'Hệ thống giáo dục liên cấp song ngữ từ Mầm Non đến THPT tại TP.HCM' },
    { title: 'Giới Thiệu Trường Việt Anh', url: '/gioi-thieu', desc: 'Sứ mệnh, tầm nhìn, lịch sử và giá trị cốt lõi' },
    { title: 'Mầm Non Song Ngữ', url: '/mam-non', desc: 'Chương trình Montessori, 100% tiếng Anh từ 12 tháng đến 6 tuổi' },
    { title: 'Tiểu Học Song Ngữ', url: '/tieu-hoc', desc: 'Chương trình UK Oxford, STEM, kỹ năng thế kỷ 21' },
    { title: 'Trung Học Cơ Sở (THCS)', url: '/trung-hoc-co-so', desc: 'Chương trình THCS song ngữ, chuẩn bị IELTS từ lớp 6' },
    { title: 'Trung Học Phổ Thông (THPT)', url: '/trung-hoc-pho-thong', desc: 'Luyện IELTS chuyên sâu, hỗ trợ du học, 99% đỗ ĐH' },
    { title: 'Tuyển Sinh 2026-2027', url: '/tuyen-sinh', desc: 'Quy trình đăng ký, lịch trình, ưu đãi Early Bird, học bổng' },
    { title: 'Học Phí Các Cấp', url: '/hoc-phi', desc: 'Bảng học phí Mầm Non đến THPT, học bổng, ưu đãi' },
    { title: 'Hệ Thống Cơ Sở', url: '/co-so', desc: '6 cơ sở tại TP.HCM, Tây Ninh, An Giang' },
    { title: 'Thành Tích Học Sinh', url: '/thanh-tich-hoc-tap', desc: 'IELTS 6.0-8.0, 99% đỗ ĐH, 200+ giải thưởng' },
    { title: 'Triết Lý Giáo Dục', url: '/triet-ly-giao-duc', desc: 'PDR, 16 kỹ năng WEF, Leader in Me, giáo dục toàn diện' },
    { title: 'Hệ Thống PDR', url: '/he-thong-pdr', desc: 'Plan – Do – Review, phương pháp giáo dục riêng' },
    { title: 'Chương Trình', url: '/chuong-trinh', desc: 'Tổng quan 4 cấp liên cấp: Mầm Non, Tiểu Học, THCS, THPT' },
    { title: 'Kỷ Luật Tích Cực', url: '/chuong-trinh/ky-luat-tich-cuc', desc: 'Bộ 8 tài liệu: bỏ hình phạt thể chất, quy trình 6 bước, lằn ranh đỏ, Thông tư 19/2025' },
    { title: 'Ngoại Khóa', url: '/ngoai-khoa', desc: '20+ CLB: thể thao, nghệ thuật, STEM, kỹ năng sống' },
    { title: 'Góc Phụ Huynh', url: '/phu-huynh', desc: 'Dịch vụ hỗ trợ phụ huynh, sổ liên lạc, sự kiện' },
    { title: 'Hình Ảnh', url: '/hinh-anh', desc: 'Thư viện ảnh cơ sở vật chất, hoạt động, sự kiện' },
    { title: 'Tin Tức & Blog', url: '/tin-tuc', desc: 'Tin tức, sự kiện, kiến thức giáo dục, kinh nghiệm' },
    { title: 'Liên Hệ', url: '/lien-he', desc: 'Hotline, Zalo, email, địa chỉ, đặt lịch tham quan' },
    { title: 'Squeeze: Học Thử Miễn Phí', url: '/squeeze/hoc-thu-mien-phi', desc: 'Đăng ký cho con trải nghiệm 1 buổi học miễn phí' },
    { title: 'Squeeze: Checklist Chọn Trường', url: '/squeeze/checklist-chon-truong', desc: 'Tải checklist 9 tiêu chí chọn trường phù hợp' },
    { title: 'Squeeze: Livestream Phụ Huynh', url: '/squeeze/livestream-phu-huynh', desc: 'Đăng ký tham dự livestream miễn phí cho phụ huynh' },
  ];

  // Search functionality
  const overlay = document.getElementById('searchOverlay');
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const list = document.getElementById('searchList');
  const defaultEl = document.querySelector<HTMLElement>('.search-default');
  const closeBtn = document.getElementById('searchClose');
  const openBtns = document.querySelectorAll('.search-btn');

  if (overlay && input && list && defaultEl && closeBtn) {
    const openSearch = () => {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 100);
    };
    const closeSearch = () => {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      input.value = '';
      list.innerHTML = '';
      defaultEl.style.display = '';
    };

    openBtns.forEach(btn => btn.addEventListener('click', openSearch));
    closeBtn.addEventListener('click', closeSearch);
    overlay.addEventListener('click', e => { if (e.target === overlay) closeSearch(); });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeSearch();
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    });

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = ''; defaultEl.style.display = ''; return; }
      defaultEl.style.display = 'none';
      const results = searchPages.filter(p =>
        p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q) || p.url.includes(q)
      );
      if (results.length === 0) {
        list.innerHTML = '<li class="search-empty">Không tìm thấy kết quả. Thử từ khóa khác hoặc <a href="/lien-he">liên hệ tư vấn</a>.</li>';
      } else {
        list.innerHTML = results.map(r => `<li><a href="${r.url}" class="search-result"><strong>${r.title}</strong><span>${r.desc}</span></a></li>`).join('');
      }
    });
  }

  // Mobile menu toggle
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const drawer = document.querySelector('.mobile-nav-drawer');
  if (menuBtn && drawer) {
    menuBtn.addEventListener('click', () => {
      const open = drawer.classList.toggle('is-open');
      menuBtn.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      drawer.setAttribute('aria-hidden', String(!open));
      document.body.style.overflow = open ? 'hidden' : '';
    });
    // Sub-menu toggle
    drawer.querySelectorAll('.mobile-nav-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        btn.closest('.mobile-nav-group')?.classList.toggle('is-expanded', !expanded);
      });
    });
    // Close on link click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        menuBtn.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>/* UTILS for header */
  .cf-container{ max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }.text-center{ text-align: center; }.text-nowrap{ white-space: nowrap; }/* TOP BAR */
  .top-bar{ background: var(--cf-blue, #26275D); color: #e2e8f0; font-size: 1rem; padding: 0.4rem 0; font-weight: 400; font-family: 'Inter', sans-serif;}.top-bar-inner{ display: flex; justify-content: space-between; align-items: center; }.top-left{ display: flex; align-items: center; gap: 1.25rem; }.top-left .icon-text{ display: inline-flex; align-items: center; gap: 0.4rem; }.top-right{ display: flex; align-items: center; gap: 1rem; }.search-btn{ background: none; border: none; color: #fff; cursor: pointer; display: flex; align-items: center; }.btn-yellow{ background: var(--pri-yellow, #fde047); color: #000; font-weight: 600; text-decoration: none; padding: 0.4rem 1rem; border-radius:3px; font-size: 1rem; border: none; cursor:pointer;}.btn-yellow:hover{ background: #fef08a; }/* Nút chọn ngôn ngữ: giữ chỗ sẵn để thanh không xô lệch khi va-lang.js dựng nút */
  .top-right [data-va-lang]{ display: inline-flex; min-width: 72px; min-height: 30px; }/* MAIN NAV */
  .main-header{ background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 15px rgba(0,0,0,0.03); font-family: 'Inter', sans-serif; padding-top: 6px !important; padding-bottom: 6px !important; height: auto !important; overflow: visible; }.nav-grid{ max-width: 1200px; margin: 0 auto; padding: 0 1rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 50px; gap: 1rem; overflow: visible; }.nav-links{ list-style: none; padding: 0; margin: 0; display: flex; gap: 1.25rem; align-items: center; }.right-nav{ justify-content: flex-start; }.left-nav{ justify-content: flex-end; }.nav-links li{ position: relative; }.nav-links a{ text-decoration: none; color: var(--pri-blue, #232252); font-weight: 600; font-size: 1rem; white-space: nowrap; transition: color 0.2s; display: flex; align-items: center; padding: 0.5rem 0; }.nav-links a:hover{ color: var(--cf-blue, #26275D); }/* DROPDOWN */
  /* LOGO ENLARGED */
  .header-logo{ display: flex; justify-content: center; align-items: center; width: 100%; height: 50px; min-width: 200px; overflow: visible; position: relative; }.official-logo{ height: 80px; width: auto; object-fit: contain; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 5; }/* SEARCH MODAL */
  .search-overlay{
    display: none; position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
    opacity: 0; transition: opacity 0.25s;
  }.search-overlay.is-open{ display: flex; opacity: 1; justify-content: center; padding-top: 12vh; }.search-modal{
    background: #fff; border-radius: 16px; width: 560px; max-width: 92vw;
    max-height: 70vh; box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    display: flex; flex-direction: column; overflow: hidden;
    animation: searchSlideIn 0.25s ease-out;
  }
  @keyframes searchSlideIn {from{ transform: translateY(-20px); opacity: 0; }to{ transform: translateY(0); opacity: 1; } }.search-modal__header{ padding: 1rem 1.25rem; border-bottom: 1px solid #e2e8f0; }.search-input-wrap{
    display: flex; align-items: center; gap: 0.6rem;
    background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px;
    padding: 0.6rem 1rem; transition: border-color 0.2s;
  }.search-input-wrap:focus-within{ border-color: #f9dd0e; }.search-input-icon{ color:#64748b; flex-shrink: 0; }.search-modal__input{
    flex: 1; border: none; outline: none; background: transparent;
    font-size: 1rem; color: #26275D; font-family: 'Inter', sans-serif;
  }.search-modal__input::placeholder{ color: #94a3b8; }.search-modal__close{
    background: none; border: none; font-size: 1.5rem; color:#64748b;
    cursor: pointer; padding: 0; line-height: 1; transition: color 0.2s;
  }.search-modal__close:hover{ color: #26275D; }.search-modal__results{ overflow-y: auto; padding: 1rem 1.25rem; flex: 1; }.search-hint{ font-size: 1rem; color:#64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 0.75rem; }.search-tags{ display: flex; flex-wrap: wrap; gap: 0.5rem; }.search-tag{
    padding: 0.4rem 0.9rem; background: #f1f5f9; border-radius: 20px;
    font-size: 1rem; color: #475569; text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }.search-tag:hover{ background: #26275D; color: #fff; }.search-list{ list-style: none; padding: 0; margin: 0; }.search-list li{ border-bottom: 1px solid #f1f5f9; }.search-list li:last-child{ border: none; }.search-result{
    display: block; padding: 0.85rem 0; text-decoration: none; transition: background 0.15s;
    border-radius: 8px; padding-left: 0.5rem; padding-right: 0.5rem;
  }.search-result:hover{ background: #f8fafc; }.search-result strong{ display: block; color: #26275D; font-size: 1rem; margin-bottom: 0.2rem; }.search-result span{ display: block; color: #64748b; font-size: 1rem; line-height: 1.5; }.search-empty{ text-align: center; padding: 2rem 0; color: #64748b; font-size: 1rem; }.search-empty a{ color: #2563eb; }/* HAMBURGER BUTTON */
  .mobile-menu-btn{
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 201;
  }.hamburger-line{
    display: block;
    width: 100%;
    height: 2.5px;
    background: #26275D;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }.mobile-menu-btn.is-open .hamburger-line:nth-child(1){
    transform: translateY(7.5px) rotate(45deg);
  }.mobile-menu-btn.is-open .hamburger-line:nth-child(2){
    opacity: 0;
  }.mobile-menu-btn.is-open .hamburger-line:nth-child(3){
    transform: translateY(-7.5px) rotate(-45deg);
  }/* MOBILE NAV DRAWER */
  .mobile-nav-drawer{
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.4);
    z-index: 199;
    opacity: 0;
