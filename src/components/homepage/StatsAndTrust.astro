---
import { schoolFacts } from '../../data/school-facts';
---
<section class="section-block section-block--stats anchor-section">
  <div class="stats-grid">
    <article class="stat-tile">
      <span class="stat-tile__icon">📅</span>
      <strong>{schoolFacts.foundedYear}</strong>
      <span>Năm thành lập</span>
    </article>
    <article class="stat-tile">
      <span class="stat-tile__icon">👨‍🎓</span>
      <strong>{schoolFacts.currentEnrollment}</strong>
      <span>Học sinh đang học mỗi năm</span>
    </article>
    <article class="stat-tile">
      <span class="stat-tile__icon">🏆</span>
      <strong>IELTS {schoolFacts.ielts}</strong>
      {/* "(có điều kiện)" chứ không phải cả cụm "theo điều khoản bảo hành":
          ô thống kê chỉ rộng ~150px ở 375px, cụm dài làm chữ xuống 6 dòng.
          Điều kiện đầy đủ nằm ở CommitmentSection ngay dưới và ở các trang
          lớp 10 — xem schoolFacts.ieltsWarranty. */}
      <span>Cam kết đầu ra THPT (có điều kiện)</span>
    </article>
    <article class="stat-tile">
      <span class="stat-tile__icon">🎓</span>
      <strong>{schoolFacts.collegeRate}</strong>
      <span>Học sinh tốt nghiệp THPT được tiếp nhận vào đại học</span>
    </article>
  </div>

  <div class="trust-logos trust-logos--prominent">
    <span class="trust-logos__label">Được công nhận &amp; hợp tác bởi</span>
    <div class="trust-logos__row">
      <div class="trust-logo-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
        <span>Franklin Covey — Leader in Me</span>
      </div>
      <div class="trust-logo-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26275D" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <span>Oxford University Press</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tile số liệu — nền tint navy nhạt để nổi trên band trắng */
  .stat-tile {
    background: linear-gradient(180deg, #F5F7FE 0%, #EBEFFC 100%);
    border: 1px solid rgba(38, 39, 93, 0.08);
    border-radius: 16px;
  }
  .stat-tile__icon { font-size: 1.75rem; display: block; margin-bottom: 0.35rem; line-height: 1; }
  .stat-tile sup { font-size: 1rem; font-weight: 700; color: #26275D; vertical-align: super; }

  .trust-logos {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(18, 57, 103, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .trust-logos__label { font-size: 1rem; font-weight: 700; color: #475569; letter-spacing: 0.08em; text-transform: uppercase; }
  .trust-logos__row { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: center; align-items: center; }
  .trust-logo-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #4a6377;
    font-size: 1rem;
    font-weight: 600;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .trust-logo-item:hover { opacity: 1; }

  .trust-logos--prominent {
    margin-top: 2.5rem;
    padding: 2rem 1.5rem 0.5rem;
    gap: 1.5rem;
    border-top: 1px solid rgba(18, 57, 103, 0.12);
  }
  .trust-logos--prominent .trust-logos__label { font-size: 1.05rem; color: #26275D; letter-spacing: 0.1em; }
  .trust-logos--prominent .trust-logos__row { gap: 1.25rem; width: 100%; }
  .trust-logos--prominent .trust-logo-item {
    flex: 1 1 200px;
    max-width: 260px;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.1rem 1.25rem;
    background: linear-gradient(180deg, #FFFDF2 0%, #FFF7D1 100%);
    border: 1px solid rgba(249, 221, 14, 0.5);
    border-radius: 14px;
    box-shadow: 0 2px 10px rgba(18, 57, 103, 0.05);
    color: #26275D;
    font-size: 1.02rem;
    opacity: 1;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .trust-logos--prominent .trust-logo-item svg { width: 30px; height: 30px; flex-shrink: 0; }
  .trust-logos--prominent .trust-logo-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(18, 57, 103, 0.12);
    border-color: rgba(249, 221, 14, 0.6);
  }
  @media (max-width: 640px) {
    .trust-logos--prominent .trust-logo-item { flex-basis: 45%; max-width: none; font-size: 0.9rem; padding: 0.9rem; }
  }
</style>
