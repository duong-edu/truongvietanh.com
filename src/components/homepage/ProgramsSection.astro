---
interface CampusLink { label: string; href: string; }
interface Props { campusLinks: CampusLink[]; }
const { campusLinks } = Astro.props;
---
<section class="section-block anchor-section" id="san-pham">
  <div class="section-heading">
    <p class="section-eyebrow">Chương trình đào tạo</p>
    <h2>Liên Cấp Từ 1 Tuổi Đến Lớp 12</h2>
    <p class="section-desc">Lộ trình học xuyên suốt — không đứt đoạn, không phải chuyển trường</p>
  </div>

  <div class="grade-level-grid">
    <a href="/mam-non" class="grade-card grade-card--mn">
      <div class="grade-card__top">
        <span class="grade-card__icon">🌱</span>
        <span class="grade-card__age">12 tháng – 5 tuổi</span>
      </div>
      <h3 class="grade-card__name">Mầm Non</h3>
      <p class="grade-card__tagline">Học qua chơi — tiếng Anh từ sớm</p>
      <ul class="grade-card__points">
        <li>100% Tiếng Anh Immersion</li>
        <li>Montessori + SteamE</li>
        <li>Giáo viên bản ngữ</li>
        <li>Lớp siêu nhỏ ≤ 15 bé</li>
      </ul>
      <span class="grade-card__cta">Tìm hiểu thêm →</span>
    </a>

    <a href="/tieu-hoc" class="grade-card grade-card--th">
      <div class="grade-card__top">
        <span class="grade-card__icon">📚</span>
        <span class="grade-card__age">Lớp 1 – 5</span>
      </div>
      <h3 class="grade-card__name">Tiểu Học</h3>
      <p class="grade-card__tagline">Nền tảng vững — kỹ năng thật</p>
      <ul class="grade-card__points">
        <li>UK Curriculum (Oxford)</li>
        <li>STEM + Coding</li>
        <li>16 kỹ năng thế kỷ 21</li>
        <li>Mục tiêu IELTS 4.0 lên lớp 5</li>
      </ul>
      <span class="grade-card__cta">Tìm hiểu thêm →</span>
    </a>

    <a href="/trung-hoc-co-so" class="grade-card grade-card--thcs">
      <div class="grade-card__top">
        <span class="grade-card__icon">🔬</span>
        <span class="grade-card__age">Lớp 6 – 9</span>
      </div>
      <h3 class="grade-card__name">THCS</h3>
      <p class="grade-card__tagline">Tư duy sắc bén — lãnh đạo sớm</p>
      <ul class="grade-card__points">
        <li>Academic English chuyên sâu</li>
        <li>Leader in Me</li>
        <li>Dự án cộng đồng thực tế</li>
        <li>Mục tiêu IELTS 5.5 lên lớp 9</li>
      </ul>
      <span class="grade-card__cta">Tìm hiểu thêm →</span>
    </a>

    <a href="/trung-hoc-pho-thong" class="grade-card grade-card--thpt">
      <div class="grade-card__top">
        <span class="grade-card__icon">🎯</span>
        <span class="grade-card__age">Lớp 10 – 12</span>
      </div>
      <h3 class="grade-card__name">THPT</h3>
      <p class="grade-card__tagline">IELTS 6.0+ · 100% được tiếp nhận vào ĐH</p>
      <ul class="grade-card__points">
        <li>Luyện IELTS chuyên sâu</li>
        <li>Hướng nghiệp &amp; du học</li>
        <li>Cam kết IELTS 6.0+ đầu ra (theo điều khoản bảo hành)</li>
      </ul>
      <span class="grade-card__cta">Tìm hiểu thêm →</span>
    </a>
  </div>

  <div class="other-programs">
    <p class="other-programs__label">Chương trình bổ trợ:</p>
    <div class="other-programs__links">
      <a href="/tuyen-sinh/trai-he/" class="other-prog-link">🏕️ Trại hè Lion Camp</a>
      <a href="/tuyen-sinh/tieng-anh-tre-em/" class="other-prog-link">🗣️ Tiếng Anh Trẻ Em</a>
      <a href="/tuyen-sinh/toan-tu-duy/" class="other-prog-link">🧮 Toán Tư Duy SAM</a>
      <a href="/tuyen-sinh/giai-ma-tiem-nang/" class="other-prog-link">🧠 Giải Mã Tiềm Năng</a>
    </div>
  </div>

  <div class="section-heading" style="margin-top:2.5rem">
    <h2>Các trường trong hệ thống Việt Anh</h2>
  </div>

  <div class="program-grid program-grid--campuses">
    {campusLinks.map((card) => (
      <a class="program-card" href={card.href}>
        <span class="program-card__label">{card.label}</span>
        <span class="program-card__arrow">&#8594;</span>
      </a>
    ))}
  </div>
</section>

<style>
  /* GRADE LEVEL CARDS */
  .grade-level-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-bottom: 2rem; }
  .grade-card {
    display: flex; flex-direction: column; gap: 0.75rem;
    padding: 1.5rem 1.25rem; border-radius: 20px; border: 2px solid transparent;
    text-decoration: none; background: #ffffff;
    box-shadow: 0 4px 20px rgba(38,39,93,0.06);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    position: relative; overflow: hidden;
  }
  .grade-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; }
  .grade-card--mn::before { background: linear-gradient(90deg, #22c55e, #16a34a); }
  .grade-card--th::before { background: linear-gradient(90deg, #3b82f6, #2563eb); }
  .grade-card--thcs::before { background: linear-gradient(90deg, #8b5cf6, #7c3aed); }
  .grade-card--thpt::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
  /* Nền tint theo màu cấp học — bớt trắng, dễ phân biệt */
  .grade-card--mn { background: linear-gradient(180deg, #F1FBF4 0%, #E4F6EB 100%); }
  .grade-card--th { background: linear-gradient(180deg, #EFF6FF 0%, #E1EEFE 100%); }
  .grade-card--thcs { background: linear-gradient(180deg, #F6F3FF 0%, #ECE6FD 100%); }
  .grade-card--thpt { background: linear-gradient(180deg, #FFFBEA 0%, #FDF1C2 100%); }
  .grade-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(38,39,93,0.12); }
  .grade-card--mn:hover { border-color: #22c55e; }
  .grade-card--th:hover { border-color: #3b82f6; }
  .grade-card--thcs:hover { border-color: #8b5cf6; }
  .grade-card--thpt:hover { border-color: #f59e0b; }
  .grade-card__top { display: flex; align-items: center; justify-content: space-between; }
  .grade-card__icon { font-size: 2rem; line-height: 1; }
  .grade-card__age { font-size: 0.8rem; font-weight: 700; color: #475569; background: rgba(255,255,255,0.75); padding: 0.25rem 0.6rem; border-radius: 999px; }
  .grade-card__name { font-family: "Montserrat", "Be Vietnam Pro", sans-serif; font-size: 1.35rem; font-weight: 800; color: #26275D; margin: 0; }
  .grade-card__tagline { font-size: 0.9rem; color: #475569; margin: 0; font-weight: 500; line-height: 1.4; }
  .grade-card__points { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.3rem; flex: 1; }
  .grade-card__points li { font-size: 0.88rem; color: #475569; padding-left: 1.1rem; position: relative; line-height: 1.4; }
  .grade-card__points li::before { content: '✓'; position: absolute; left: 0; color: #26275D; font-weight: 700; font-size: 0.8rem; }
  .grade-card__cta { font-size: 0.9rem; font-weight: 700; color: #26275D; margin-top: auto; padding-top: 0.5rem; border-top: 1px solid rgba(38,39,93,0.08); }
  .grade-card:hover .grade-card__cta { text-decoration: underline; }

  /* OTHER PROGRAMS */
  .other-programs { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 1rem 1.25rem; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 0.5rem; }
  .other-programs__label { font-size: 0.9rem; font-weight: 700; color: #475569; white-space: nowrap; margin: 0; }
  .other-programs__links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .other-prog-link { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.9rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 999px; font-size: 0.9rem; font-weight: 600; color: #26275D; text-decoration: none; transition: border-color 0.2s, background 0.2s; }
  .other-prog-link:hover { border-color: #26275D; background: #f0f4ff; }

  /* PROGRAM GRID */
  .program-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; }
  .program-grid--campuses { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .program-card { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.25rem; border-radius: 16px; border: 1px solid rgba(18, 57, 103, 0.1); border-left: 4px solid #f9dd0e; background: linear-gradient(180deg, #FDFDFF 0%, #F4F6FC 100%); box-shadow: 0 4px 12px rgba(18, 57, 103, 0.04); text-decoration: none; color: #26275D; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .program-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(18, 57, 103, 0.1); border-color: #f9dd0e; }
  .program-card__label { font-weight: 600; font-size: 1rem; line-height: 1.3; }
  .program-card__arrow { color: #26275D; font-size: 1.1rem; font-weight: 700; }
  .program-grid--campuses .program-card { flex-direction: column; align-items: flex-start; gap: 0.5rem; padding: 1rem; }

  @media (max-width: 1024px) { .grade-level-grid { grid-template-columns: repeat(2, 1fr); } .program-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .program-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .program-grid--campuses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .grade-level-grid { grid-template-columns: 1fr; } .grade-card { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; } .grade-card__points { display: none; } }
</style>
