---
type Props = {
  formId?: string;
  funnelCode?: string;
  schoolLevel?: string;
  submitText?: string;
  nextText?: string;              // nhãn nút BƯỚC 1 (mặc định giữ nguyên như cũ)
  successMessage?: string;
  redirectUrl?: string;          // nếu set, redirect sau khi submit (delay 1.5s để fetch hoàn thành)
  title?: string;                // tiêu đề bước 1 (để '' để ẩn nếu trang đã có heading riêng)
  description?: string;          // mô tả bước 1 (để '' để ẩn)
  socialProof?: string;          // dòng social proof (để '' để ẩn)
  askProvince?: boolean;         // bật ô Tỉnh/Thành ở bước 2 (gửi kèm /api/lead)
  provinceLabel?: string;
  provincePlaceholder?: string;
  mode?: 'email' | 'tuoi';       // 'tuoi' = bước 1 chọn tuổi con, bước 2 họ tên + SĐT + email (giống /school-ready)
};

const {
  formId = 'squeeze-form',
  funnelCode = 'squeeze-landing',
  schoolLevel = 'tieu-hoc',
  submitText = 'Đăng ký ngay',
  nextText = 'Nhận tư vấn ngay',
  successMessage = 'Cảm ơn bạn đã đăng ký! Chúng tôi sẽ liên hệ với bạn trong 24 giờ.',
  redirectUrl = '',
  title = 'Đăng ký ngay để được tư vấn cá nhân hoá 1:1 lộ trình học tập qua Zalo',
  description = 'Đảm bảo tối ưu hóa lợi ích và phù hợp nhất cho con.',
  socialProof = 'Hơn 100 phụ huynh đã đăng ký tuần này',
  askProvince = false,
  provinceLabel = 'Tỉnh/Thành phố',
  provincePlaceholder = 'VD: Cà Mau, Kiên Giang, Đà Nẵng...',
  mode = 'email',
} = Astro.props;
const isTuoi = mode === 'tuoi';
const tuoiOptions = ['12 – 23 tháng', '2 tuổi', '3 tuổi', '4 tuổi', '5 tuổi'];

const formIdWithFunnel = `${formId}-${funnelCode}`;
---

<form
  id={formIdWithFunnel}
  class="lead-form"
  novalidate
>
  <!-- Step 1: Email Only -->
  <div class="form-step" data-step="1">
    <div class="form-step-content">
      <!-- Progress indicator -->
      <div class="form-progress">
        <div class="form-progress__step form-progress__step--active">
          <span class="form-progress__dot">1</span>
          <span class="form-progress__label">{isTuoi ? 'Tuổi của con' : 'Điền email'}</span>
        </div>
        <div class="form-progress__line"></div>
        <div class="form-progress__step">
          <span class="form-progress__dot">2</span>
          <span class="form-progress__label">{isTuoi ? 'Thông tin liên hệ' : 'Nhận thông tin'}</span>
        </div>
      </div>

      {title && <h3 class="form-step-title">{title}</h3>}
      {description && <p class="form-step-description">{description}</p>}

      {isTuoi ? (
        <>
          <p class="form-tuoi-q" id={`q-${formIdWithFunnel}`}>Con bạn đang bao nhiêu tuổi? <span aria-hidden="true">*</span></p>
          <div class="form-tuoi" role="group" aria-labelledby={`q-${formIdWithFunnel}`}>
            {tuoiOptions.map((t) => (
              <button type="button" class="form-tuoi-btn" data-action="pick-tuoi" data-tuoi={t}>{t}</button>
            ))}
          </div>
        </>
      ) : (
        <>
      <div class="form-group">
        <input
          type="email"
          id={`email-${formIdWithFunnel}`}
          name="email"
          class="form-input form-input--large"
          placeholder="Nhập email của bạn"
          required
          aria-label="Email của bạn"
        />
        <span class="form-error" role="alert"></span>
      </div>

      <button type="button" class="form-btn form-btn--next" data-action="next-step">
        {nextText}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>

        </>
      )}

      {socialProof && <p class="form-social-proof">{socialProof}</p>}
    </div>
  </div>

  <!-- Step 2: Full Information -->
  <div class="form-step" data-step="2" hidden>
    <div class="form-step-content">
      <!-- Progress indicator -->
      <div class="form-progress">
        <div class="form-progress__step form-progress__step--done">
          <span class="form-progress__dot">&#10003;</span>
          <span class="form-progress__label">{isTuoi ? 'Tuổi của con' : 'Điền email'}</span>
        </div>
        <div class="form-progress__line form-progress__line--active"></div>
        <div class="form-progress__step form-progress__step--active">
          <span class="form-progress__dot">2</span>
          <span class="form-progress__label">{isTuoi ? 'Thông tin liên hệ' : 'Nhận thông tin'}</span>
        </div>
      </div>

      <h3 class="form-step-title">Thông tin của bạn</h3>
      {isTuoi
        ? <p class="form-step-description">Tuổi của con: <strong data-tuoi-show></strong></p>
        : <p class="form-step-description">Giúp chúng tôi hỗ trợ tốt hơn</p>}

      <div class="form-group">
        <input
          type="text"
          id={`parent-name-${formIdWithFunnel}`}
          name="parent_name"
          class="form-input"
          placeholder="Họ và tên phụ huynh"
          required
          aria-label="Tên phụ huynh"
        />
        <span class="form-error" role="alert"></span>
      </div>

      <div class="form-group">
        <input
          type="tel"
          id={`phone-${formIdWithFunnel}`}
          name="phone"
          class="form-input"
          placeholder="Số điện thoại"
          pattern="[0-9\+\-\s\(\)]+"
          required
          aria-label="Số điện thoại"
        />
        <span class="form-error" role="alert"></span>
      </div>

      {isTuoi && (
        <div class="form-group">
          <input
            type="email"
            id={`email-${formIdWithFunnel}`}
            name="email"
            class="form-input"
            placeholder="Email"
            autocomplete="email"
            required
            aria-label="Email"
          />
          <span class="form-error" role="alert"></span>
        </div>
      )}

      {askProvince && (
        <div class="form-group">
          <input
            type="text"
            id={`province-${formIdWithFunnel}`}
            name="province"
            class="form-input"
            placeholder={provincePlaceholder}
            aria-label={provinceLabel}
          />
          <span class="form-error" role="alert"></span>
        </div>
      )}

      <div class="form-actions">
        <button type="button" class="form-btn form-btn--back" data-action="prev-step">← Quay lại</button>
        <button type="submit" class="form-btn form-btn--submit">{submitText}</button>
      </div>
    </div>
  </div>

  <!-- Success State -->
  <div class="form-step form-success" data-step="success" hidden>
    <div class="form-step-content">
      <div class="success-icon-wrapper">
        <div class="success-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <div class="success-ring"></div>
      </div>
      <h3 class="form-step-title">Đăng ký thành công!</h3>
      <p class="form-step-description">{successMessage}</p>
      <div class="success-next-steps">
        <p class="success-next-step">Bước tiếp theo: Kiểm tra email và Zalo để nhận thông tin chi tiết</p>
      </div>
      <button type="button" class="form-btn form-btn--new" data-action="reset-form">
        Đăng ký khác
      </button>
    </div>
  </div>

  <!-- Hidden fields for backend -->
  <input type="hidden" name="funnel_code" value={funnelCode} />
  <input type="hidden" name="school_level" value={schoolLevel} />
  <input type="hidden" name="source" value="squeeze-landing" />
</form>

<style is:inline>.form-tuoi-q{margin:0;font-weight:600;font-size:1rem;color:#fff}
  [data-form-bg="light"] .form-tuoi-q,.gi-form-card .form-tuoi-q,.sp-form-block .form-tuoi-q,.F .form-tuoi-q,.lead-form-card--light .form-tuoi-q{color:#26275D}
  .form-tuoi{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}
  .form-tuoi-btn{padding:.9rem .6rem;border:2px solid #cbd5e1;border-radius:10px;background:#fff;color:#26275D;font:inherit;font-weight:700;font-size:1rem;cursor:pointer;transition:border-color .15s,background .15s}
  .form-tuoi-btn:hover,.form-tuoi-btn:focus-visible{border-color:#26275D;background:#fffbe0;outline:none}
  .form-tuoi-btn:last-child:nth-child(odd){grid-column:1/-1}
  .lead-form{
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    overflow: hidden;
    box-sizing: border-box;
  }.form-step{
    transition: opacity 0.3s ease, visibility 0.3s ease;
    opacity: 1;
    visibility: visible;
  }.form-step[hidden]{
    display: none;
    opacity: 0;
    visibility: hidden;
  }.form-step-content{
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }/* ===== PROGRESS INDICATOR ===== */
  .form-progress{
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    margin-bottom: .5rem;
  }.form-progress__step{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .35rem;
  }.form-progress__dot{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 700;
    font-family: "Montserrat", sans-serif;
    background: #e8e8e8;
    color: #999;
    transition: all .3s ease;
  }.form-progress__step--active .form-progress__dot{
    background: #26275D;
    color: #fff;
    box-shadow: 0 2px 8px rgba(38,39,93,.3);
  }.form-progress__step--done .form-progress__dot{
    background: #27ae60;
    color: #fff;
    font-size: 1rem;
  }.form-progress__label{
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: .5px;
    /* nhãn 3 chữ hay xuống dòng thành "NHẬN THÔNG" / "TIN" — balance chia đều 2 dòng */
    text-wrap: balance;
  }.form-progress__step--active .form-progress__label,
  .form-progress__step--done .form-progress__label{
    color: #fff;
  }.form-progress__line{
    width: 60px;
    height: 3px;
    background: #e8e8e8;
    border-radius: 2px;
    margin: 0 1rem;
    margin-bottom: 1.2rem;
    transition: background .3s ease;
  }.form-progress__line--active{
    background: linear-gradient(90deg, #27ae60, #26275D);
  }/* ===== FORM TITLES ===== */
  .form-step-title{
    font-family: "Montserrat", sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }.form-step-description{
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }/* Auto-contrast: khi form nằm trong card nền trắng → text dark navy */
  .gi-form-card .form-step-title,
  .sp-form-block .form-step-title,
  .F .form-step-title,
  .lead-form-card--light .form-step-title,
  [data-form-bg="light"] .form-step-title{
    color: #26275D;
  }.gi-form-card .form-step-description,
  .sp-form-block .form-step-description,
  .F .form-step-description,
  .lead-form-card--light .form-step-description,
  [data-form-bg="light"] .form-step-description{
    color: #475569;
  }/* Social proof trên card trắng */
  .gi-form-card .form-social-proof,
  .sp-form-block .form-social-proof,
  .lead-form-card--light .form-social-proof,
  [data-form-bg="light"] .form-social-proof{
    color: #26275D;
  }/* Progress label trên card trắng */
  .gi-form-card .form-progress__label,
  .sp-form-block .form-progress__label,
  .lead-form-card--light .form-progress__label,
  [data-form-bg="light"] .form-progress__label{
    color: rgba(38,39,93,.78);
  }.gi-form-card .form-progress__step--active .form-progress__label,
  .gi-form-card .form-progress__step--done .form-progress__label,
  .sp-form-block .form-progress__step--active .form-progress__label,
  .sp-form-block .form-progress__step--done .form-progress__label,
  .lead-form-card--light .form-progress__step--active .form-progress__label,
  .lead-form-card--light .form-progress__step--done .form-progress__label,
  [data-form-bg="light"] .form-progress__step--active .form-progress__label,
  [data-form-bg="light"] .form-progress__step--done .form-progress__label{
    color: #26275D;
  }/* ===== SOCIAL PROOF ===== */
  .form-social-proof{
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    text-align: left;
    margin: 0;
    opacity: .85;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: .4rem;
    white-space: normal;
    word-wrap: break-word;
    max-width: 100%;
  }.form-social-proof::before{
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #27ae60;
    border-radius: 50%;
    animation: proofPulse 2s ease-in-out infinite;
  }

  @keyframes proofPulse {0%, 100%{ opacity: 1; }50%{ opacity: .4; }
  }/* ===== FORM GROUPS ===== */
  .form-group{
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }.form-row{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }.form-input,
  .form-checkbox{
    font-family: "Open Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.5;
  }.form-input{
    padding: 0.85rem 1rem;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    background-color: #fafbfc;
    color: #1a1a1a;
    transition: all 0.25s ease;
  }.form-input--large{
    padding: 1rem 1.15rem;
    font-size: 1.05rem;
  }.form-input:focus{
    outline: none;
    border-color: #f9dd0e;
    box-shadow: 0 0 0 3px rgba(249, 221, 14, 0.15);
    background-color: #fff;
    transform: translateY(-1px);
  }.form-input.error{
    border-color: #e74c3c;
    box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.1);
    animation: inputShake 0.4s ease;
  }

  @keyframes inputShake {0%, 100%{ transform: translateX(0); }20%{ transform: translateX(-4px); }40%{ transform: translateX(4px); }60%{ transform: translateX(-3px); }80%{ transform: translateX(2px); }
  }.form-error{
    font-size: 1rem;
    color: #e74c3c;
    min-height: 1.2em;
    display: block;
  }.form-checkbox{
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #f9dd0e;
  }.form-consent{
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1rem;
    color: #666666;
    margin: 0;
  }.form-consent label{
    cursor: pointer;
    line-height: 1.4;
  }/* ===== BUTTONS ===== */
  .form-btn{
    padding: 0.7rem 1.2rem;
    border: none;
    border-radius: 8px;
    font-family: "Montserrat", sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    text-align: center;
    white-space: nowrap;
  }.form-btn--next,
  .form-btn--submit{
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: #f9dd0e;
    color: #26275D;
    box-shadow: 0 4px 15px rgba(249, 221, 14, 0.35);
    white-space: normal;
    word-wrap: break-word;
  }.form-btn--next:hover,
  .form-btn--submit:hover{
    background: #fae34a;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(249, 221, 14, 0.45);
  }.form-btn--next:active,
  .form-btn--submit:active{
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(249, 221, 14, 0.3);
  }.form-btn--loading{
    pointer-events: none;
    opacity: 0.8;
  }.form-btn--loading::after{
    content: '';
    display: inline-block;
    width: 16px; height: 16px;
    border: 2px solid rgba(26,26,26,0.3);
    border-top-color: #1a1a1a;
    border-radius: 50%;
    animation: btnSpin 0.6s linear infinite;
    margin-left: 0.5rem;
  }
  @keyframes btnSpin {to{ transform: rotate(360deg); } }.form-btn--new{
    width: 100%;
    background: transparent;
    color: #26275D;
    border: 1.5px solid #26275D;
  }.form-btn--new:hover{
    background: #26275D;
    color: #fff;
  }.form-actions{
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 1rem;
  }.form-btn--back{
    background-color: #f0f0f0;
    color: #1a1a1a;
    white-space: nowrap;
    font-size: 1.05rem;
  }.form-btn--back:hover{
    background-color: #e0e0e0;
  }/* ===== SUCCESS STATE ===== */
  .form-success{
    text-align: center;
  }.success-icon-wrapper{
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 90px;
    height: 90px;
    margin: 0 auto 1rem;
  }.success-icon{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #27ae60, #2ecc71);
    color: white;
    animation: successPop .5s cubic-bezier(.175,.885,.32,1.275);
    z-index: 1;
  }.success-ring{
    position: absolute;
    top: 0;
    left: 0;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 3px solid rgba(39,174,96,.3);
    animation: ringExpand .8s ease-out;
  }

  @keyframes successPop {0%{ transform: scale(0); opacity: 0; }60%{ transform: scale(1.15); }100%{ transform: scale(1); opacity: 1; }
  }

  @keyframes ringExpand {0%{ transform: scale(.5); opacity: 0; }50%{ opacity: 1; }100%{ transform: scale(1); opacity: .5; }
  }.form-success .form-step-title{
    color: #27ae60;
  }.success-next-steps{
    background: #f0faf4;
    border: 1px solid #d4edda;
    border-radius: 8px;
    padding: 1rem;
  }.success-next-step{
    font-size: 1rem;
    color: #1a5e3a;
    margin: 0;
    font-weight: 500;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 480px) {.form-row{
      grid-template-columns: 1fr;
      gap: 1rem;
    }.form-actions{
      grid-template-columns: 1fr 1fr;
    }.form-step-title{
      font-size: 1.5rem;
    }.form-input{
      padding: 0.85rem 0.9rem;
      font-size: 16px; /* Prevents zoom on iOS */
    }.form-input--large{
      padding: 1rem;
      font-size: 16px;
    }.form-btn{
      padding: 0.85rem 1rem;
      font-size: 1rem;
    }.form-progress__line{
      width: 40px;
      margin: 0 .65rem;
    }
  }
</style>

<script src="/js/va-utm.js" is:inline></script>
<script is:inline define:vars={{ formIdWithFunnel, funnelCode, isTuoi }}>
  const form = document.getElementById(formIdWithFunnel);
  if (!form) {
    console.error('Form not found:', formIdWithFunnel);
  }

  // KHÔNG ẩn form với khách đã từng đăng ký. Landing page luôn là form 2 bước đầy đủ.
  //
  // Trước đây có bước "returning user check": ai đã đăng ký thì lần sau vào trang sẽ bị
  // thay toàn bộ form bằng dòng "Bạn đã đăng ký thành công" — không còn ô nhập nào.
  // Nhìn cứ như vừa nhập email là đăng ký xong, trong khi họ chưa hề nhập tên và SĐT.
  // Bản đầu dùng cờ CHUNG toàn site nên còn tệ hơn: điền form checklist là mất form ở
  // MỌI landing page, vĩnh viễn. Thu hẹp lại theo từng funnel vẫn không ổn — phụ huynh
  // quan tâm lại, hoặc đăng ký cho đứa con thứ hai, vẫn bị chặn.
  // Lead thật mất ngay tại chỗ mà không ai biết, vì trang vẫn tính là có traffic.

  // Lead API endpoint (Cloudflare Worker → GHL + Pancake CRM)
  const LEAD_API_URL = '/api/lead';

  // Capture UTM parameters from URL
  const urlParams = new URLSearchParams(window.location.search);
  const utmData = {
    ...(window.__vaUTM ? window.__vaUTM() : {}),
    referrer: document.referrer || '',
    landing_page: window.location.pathname,
  };

  // Form state
  let currentStep = 1;
  let formData = {};

  // Helper function to validate email
  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  // Validate số di động VN: 10 số bắt đầu 03/05/07/08/09, chấp nhận +84/84 gõ vào
  function isValidPhone(phone) {
    const p = String(phone).replace(/[\s\-\.\(\)]/g, '').replace(/^\+?84/, '0');
    return /^0[35789][0-9]{8}$/.test(p);
  }

  // Helper function to show/hide form steps
  // FIX: scope vào form (tránh xung đột nếu có data-step khác trong DOM),
  // và so sánh string để 'success' không bị NaN khi parseInt
  function showStep(stepNumber) {
    if (!form) return;
    const target = String(stepNumber);
    form.querySelectorAll('[data-step]').forEach(step => {
      step.hidden = step.getAttribute('data-step') !== target;
    });
    currentStep = stepNumber;
  }

  // Helper function to get form inputs for current step
  function getStepInputs() {
    if (currentStep === 1) {
      if (isTuoi) return [];
      return form.querySelectorAll('input[name="email"]');
    } else if (currentStep === 2) {
      return form.querySelectorAll(isTuoi
        ? 'input[name="parent_name"], input[name="phone"], input[name="email"]'
        : 'input[name="parent_name"], input[name="phone"]');
    }
    return [];
  }

  // Validate step
  function validateStep() {
    const inputs = getStepInputs();
    let isValid = true;

    inputs.forEach(input => {
      const error = input.parentElement.querySelector('.form-error');
      let errorMsg = '';

      if (input.name === 'email') {
        if (!input.value.trim()) {
          errorMsg = 'Vui lòng nhập email';
          isValid = false;
        } else if (!isValidEmail(input.value)) {
          errorMsg = 'Email không hợp lệ';
          isValid = false;
        }
      } else if (input.name === 'phone') {
        if (!input.value.trim()) {
          errorMsg = 'Vui lòng nhập số điện thoại';
          isValid = false;
        } else if (!isValidPhone(input.value)) {
          errorMsg = 'Số điện thoại không hợp lệ';
          isValid = false;
        }
      } else {
        if (!input.value.trim()) {
          errorMsg = 'Trường này bắt buộc';
          isValid = false;
        }
      }

      if (error) {
        error.textContent = errorMsg;
        input.classList.toggle('error', !!errorMsg);
      }
    });

    return isValid;
  }

  // Save form data
  function saveFormData() {
    const inputs = form.querySelectorAll('input, select');
    inputs.forEach(input => {
      if (input.type === 'checkbox') {
        if (input.checked) {
          formData[input.name] = true;
        }
      } else if (input.name && !input.name.startsWith('_')) {
        formData[input.name] = input.value;
      }
    });
  }

  // Event listeners
  const nextButtons = form.querySelectorAll('[data-action="next-step"]');
  const backButtons = form.querySelectorAll('[data-action="prev-step"]');
  const resetButtons = form.querySelectorAll('[data-action="reset-form"]');

  nextButtons.forEach(btn => {
    btn.addEventListener('click', async function(e) {
      e.preventDefault();
      if (validateStep()) {
        saveFormData();
        showStep(2);

        // Track GTM event
        if (window.dataLayer) {
          window.dataLayer.push({
            'event': 'form_step_complete',
            'form_id': formIdWithFunnel,
            'step': 1,
            'email': formData.email
          });
        }

        // Send partial_capture to Make.com webhook
        try {
          await fetch(LEAD_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              step: 'partial_capture',
              email: formData.email,
              source: funnelCode,
              page: window.location.href,
              timestamp: new Date().toISOString(),
              ...utmData
            })
          });
        } catch (err) {
          console.error('[LeadForm] Partial capture error:', err);
        }
      }
    });
  });

  // Chế độ tuổi: bấm một độ tuổi là sang bước 2 (không cần nút Tiếp tục)
  form.querySelectorAll('[data-action="pick-tuoi"]').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      formData.tuoi_con = btn.getAttribute('data-tuoi');
      const show = form.querySelector('[data-tuoi-show]');
      if (show) show.textContent = formData.tuoi_con;
      showStep(2);
      if (window.dataLayer) {
        window.dataLayer.push({ 'event': 'form_step_complete', 'form_id': formIdWithFunnel, 'step': 1, 'tuoi': formData.tuoi_con });
      }
      const nm = form.querySelector('input[name="parent_name"]');
      if (nm) nm.focus();
    });
  });

  backButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      showStep(1);
    });
  });

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    // ENTER Ở BƯỚC 1 KHÔNG ĐƯỢC GỬI FORM.
    //
    // Ô email ở bước 1 nằm trong <form>, mà bước 2 có <button type="submit"> → gõ email
    // rồi nhấn Enter (hoặc bấm "Đi"/"Go" trên bàn phím điện thoại) kích hoạt implicit
    // submission của trình duyệt. Handler này chạy ngay, validateStep() lúc đó chỉ soi ô
    // email (currentStep === 1) nên PASS, rồi nhảy thẳng showStep('success') + POST
    // full_submit và chuyển sang /cam-on.
    //
    // Hậu quả đã tái hiện trên production 30/08/2026: khách gõ email + Enter thấy
    // "Đăng ký thành công" mà chưa hề nhập tên/SĐT — form 2 bước hoá ra 1 bước. Lead gửi
    // lên có phone rỗng nên worker bỏ qua Pancake (staging-worker.js, reason no_phone),
    // sales không bao giờ thấy lead đó.
    //
    // Nay Enter ở bước 1 = bấm nút "Tiếp tục": vẫn validate email và bắn partial_capture.
    if (currentStep === 1) {
      if (isTuoi) return;   // chế độ tuổi: bước 1 chỉ chọn nút tuổi, Enter không làm gì
      const nextBtn = form.querySelector('[data-action="next-step"]');
      if (nextBtn) nextBtn.click();
      return;
    }
    if (currentStep !== 2) return;   // đang ở màn success — bỏ qua

    if (!validateStep()) {
      return;
    }

    saveFormData();

    // Show loading state
    const submitBtn = form.querySelector('.form-btn--submit');
    if (submitBtn) { submitBtn.classList.add('form-btn--loading'); submitBtn.textContent = 'Đang gửi...'; }

    // Track GTM event
    if (window.dataLayer) {
      window.dataLayer.push({
        'event': 'form_submit',
        'form_id': formIdWithFunnel,
        'funnel_code': funnelCode,
        'email': formData.email,
        'phone': formData.phone,
        'child_name': formData.child_name,
        'school_level': formData.school_level
      });
    }

    // Show success step
    showStep('success');


    // Send full_submit to Make.com webhook -> Pancake CRM + GHL
    try {
      const webhookPayload = {
        step: 'full_submit',
        fullName: formData.parent_name || '',
        email: formData.email || '',
        phone: formData.phone || '',
        childName: formData.child_name || '',
        schoolLevel: formData.school_level || '',
        province: formData.province || '',
        ...(isTuoi ? {
          tuoi_con: formData.tuoi_con || '',
          note: 'Tuổi của con: ' + (formData.tuoi_con || ''),
          school_level: formData.school_level || 'mam-non',
          funnel_code: funnelCode,
        } : {}),
        source: funnelCode,
        page: window.location.href,
        timestamp: new Date().toISOString(),
        ...utmData
      };

      const response = await fetch(LEAD_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(webhookPayload)
      });

      if (!response.ok) {
        console.error('Failed to submit form:', response.status);
      }
    } catch (error) {
      console.error('Error submitting form:', error);
    }

    // Tất cả form đều redirect về 1 trang cảm ơn duy nhất /cam-on (delay 1.5s để fetch hoàn thành)
    setTimeout(() => {
      const nm = encodeURIComponent(formData.parent_name || '');
      window.location.href = '/cam-on?name=' + nm + '&funnel=' + encodeURIComponent(funnelCode);
    }, 1500);
  });

  // Reset form handler
  resetButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      form.reset();
      showStep(1);
      formData = {};
    });
  });

  // Clear error on input
  const inputs = form.querySelectorAll('.form-input');
  inputs.forEach(input => {
    input.addEventListener('focus', function() {
      const error = this.parentElement.querySelector('.form-error');
      if (error) {
        error.textContent = '';
        this.classList.remove('error');
      }
    });
  });
</script>
