---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderBase from './HeaderBase.astro';
import FooterBase from './FooterBase.astro';

export interface Props {
  campusName: string;
  shortName?: string;
  cityRegion: string;
  address: string;
  hotline: string;
  siSo: string;
  level: 'mam-non' | 'lien-cap' | 'mam-non-tieu-hoc';
  heroImage?: string;
  heroAlt?: string;
  vslVideoId?: string;
  canonical: string;
  metaTitle: string;
  metaDescription: string;
}

const {
  campusName,
  shortName,
  cityRegion,
  address,
  hotline,
  siSo,
  level,
  heroImage,
  heroAlt,
  vslVideoId,
  canonical,
  metaTitle,
  metaDescription,
} = Astro.props;

const zaloLink = `https://zalo.me/${hotline.replace(/\s+/g, '')}`;
const telLink = `tel:+84${hotline.replace(/\s+/g, '').replace(/^0/, '')}`;

const levelLabel: Record<string, string> = {
  'mam-non': 'Mầm non',
  'lien-cap': 'Tiểu học · THCS · THPT',
  'mam-non-tieu-hoc': 'Mầm non · Tiểu học',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: campusName,
  url: `https://truongvietanh.com${canonical}`,
  telephone: `+84${hotline.replace(/\s+/g, '').replace(/^0/, '')}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address,
    addressLocality: cityRegion,
    addressCountry: 'VN',
  },
  parentOrganization: {
    '@type': 'EducationalOrganization',
    name: 'Hệ thống Trường Liên Cấp Việt Anh',
    url: 'https://truongvietanh.com',
  },
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={`https://truongvietanh.com${canonical}`}
  structuredData={structuredData}
>
  <HeaderBase />

  <main class="campus-page">

    <!-- ============== HERO ============== -->
    <section class="hero">
      <div class="hero-bg">
        {heroImage ? (
          <img src={heroImage} alt={heroAlt || campusName} loading="eager" />
        ) : (
          <div class="hero-placeholder" aria-label="Hình ảnh cơ sở (cập nhật sau)">
            <span>HÌNH ẢNH CƠ SỞ</span>
            <small>Sẽ cập nhật sau</small>
          </div>
        )}
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <div class="hero-eyebrow">{levelLabel[level]} · {cityRegion}</div>
        <h1 class="hero-title">{campusName}</h1>
        <p class="hero-tagline">Đào tạo học sinh giỏi chuyên Anh — từ năm 2011</p>
        <div class="hero-cta">
          <a href={zaloLink} class="btn btn-primary" target="_blank" rel="noopener">Nhắn Zalo đặt lịch tham quan</a>
          <a href={telLink} class="btn btn-secondary">Gọi {hotline}</a>
        </div>
      </div>
    </section>

    <!-- ============== VSL ============== -->
    <section class="vsl-section">
      <div class="container">
        <h2 class="section-title">Thư mời từ Trường {shortName || campusName}</h2>
        <div class="vsl-wrapper">
          {vslVideoId ? (
            <iframe
              src={`https://www.youtube.com/embed/${vslVideoId}?rel=0`}
              title={`Video giới thiệu ${campusName}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          ) : (
            <div class="vsl-placeholder">
              <div class="play-icon">▶</div>
              <p class="vsl-placeholder-text">VIDEO GIỚI THIỆU CƠ SỞ</p>
              <small>Sẽ cập nhật sau</small>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ============== I. TRIẾT LÝ NỀN TẢNG ============== -->
    <section class="content-section">
      <div class="container narrow">
        <div class="section-eyebrow">I. Triết lý nền tảng</div>
        <h2 class="section-title">"Một đứa trẻ hạnh phúc sẽ học tốt nhất."</h2>
        <p class="lead">
          Có những điều chỉ thời gian mới chứng minh được. Từ 2011, Trường Việt Anh đã đồng hành cùng hàng nghìn gia đình Việt Nam trong một hành trình không dễ dàng — hành trình nuôi dưỡng một đứa trẻ không chỉ học giỏi, mà còn sống tốt, sống có mục đích, và sống tự chủ.
        </p>
        <p>
          Triết lý <strong>Vui vẻ</strong> và <strong>Thực dụng</strong> không phải là khẩu hiệu marketing. Đó là kim chỉ nam cho mọi quyết định giáo dục — từ cách thiết kế chương trình học, cách tổ chức không gian trường lớp, đến cách thầy cô lắng nghe và phản hồi từng học sinh.
        </p>
        <div class="philosophy-grid">
          <div class="philosophy-card">
            <h3>Vui vẻ</h3>
            <p>Học sinh đến trường trong trạng thái được tôn trọng, được lắng nghe, và được phép mắc sai lầm để học hỏi. Không có áp lực thành tích đè nặng. Không có sự so sánh làm mòn đi sự tự tin. Chỉ có môi trường yêu thương vô điều kiện và hỗ trợ toàn diện.</p>
          </div>
          <div class="philosophy-card">
            <h3>Thực dụng</h3>
            <p>Mọi kiến thức, kỹ năng và phẩm chất được rèn luyện tại trường đều phải có giá trị ứng dụng thực tế trong cuộc đời của các em — không phải chỉ trong phòng thi.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== II. PDR ============== -->
    <section class="content-section bg-navy">
      <div class="container narrow">
        <div class="section-eyebrow light">II. Hệ thống PDR</div>
        <h2 class="section-title light">Nền tảng phát triển cá nhân — điều khác biệt của Trường Việt Anh</h2>
        <p class="lead light">
          Được xây dựng dựa trên 4 Nguyên Tắc Thực Thi của Sean Covey — hệ thống quản trị mục tiêu được áp dụng bởi hàng nghìn tổ chức hàng đầu thế giới — Trường Việt Anh đã chuyển hóa phương pháp đó thành một hành trình phát triển cá nhân dành riêng cho từng học sinh, từ lớp 1 đến lớp 12.
        </p>
        <div class="pdr-grid">
          <div class="pdr-card">
            <div class="pdr-icon">🎯</div>
            <h3>PLAN — Kiến tạo mục tiêu</h3>
            <p>Đầu năm học, mỗi học sinh tự xác định mục tiêu phát triển trên 4 lĩnh vực: <strong>Kiến thức · Kỹ năng lãnh đạo · Phẩm chất · Sức khoẻ</strong>.</p>
            <p>Mục tiêu được phân rã có hệ thống — từ năm học → học kỳ → quý → tháng, và cụ thể hóa thành <em>hành động đòn bẩy hàng tuần</em>.</p>
          </div>
          <div class="pdr-card">
            <div class="pdr-icon">⚡</div>
            <h3>DO — Thực thi có đồng hành</h3>
            <p>Mỗi tuần học sinh chiêm nghiệm cùng <strong>Buddy</strong> — người bạn đồng hành được ghép cặp.</p>
            <p>Mỗi tháng có buổi <strong>họp PDR 1-1</strong> với giáo viên chủ nhiệm. Học sinh — không phải giáo viên — chủ động dẫn dắt buổi họp.</p>
          </div>
          <div class="pdr-card">
            <div class="pdr-icon">📋</div>
            <h3>REVIEW — Trách nhiệm giải trình</h3>
            <p><strong>5 lần mỗi năm</strong>, học sinh trực tiếp thuyết trình về hành trình phát triển của mình trước phụ huynh.</p>
            <p>Không có giáo viên báo cáo thay. Phụ huynh nghe trực tiếp từ con — mục tiêu, hành động, kết quả, và điều con cần từ gia đình.</p>
          </div>
        </div>
      </div>
    </section>

    {level === 'mam-non-tieu-hoc' && (
      <!-- ============== III. KẾT QUẢ / CƠ SỞ VẬT CHẤT (MẦM NON · TIỂU HỌC) ==============
           Cơ sở chỉ có Mầm non + Tiểu học: KHÔNG dùng số liệu THPT (ICDL, điểm 10 Tiếng Anh,
           IELTS tốt nghiệp, nhận thẳng ĐH). Anh Dương chốt 15/10/2026.
           Số liệu từng cơ sở lấy từ website riêng của trường (16/10/2026):
           · Mekong Xanh (mgis.edu.vn/thanh-tich): 24 giải/3 năm học. KHÔNG dùng "95% phụ huynh đề xuất" (chưa có nguồn khảo sát).
           · Thái Sơn (truongthaison.com): khai giảng năm đầu 2026 → CHƯA có kết quả, chỉ nêu cơ sở vật chất. -->
      <section class="content-section">
        <div class="container narrow">
          {shortName === 'Mekong Xanh' ? (
            <>
              <div class="section-eyebrow">III. Kết quả đã ghi nhận</div>
              <h2 class="section-title">Học sinh Mekong Xanh trên các sân chơi học thuật</h2>
              <ul class="commitment-list">
                <li><strong>24 giải thưởng</strong> trong 3 năm học (2023–2026), trong đó <strong>12 giải cấp Quốc gia</strong> và <strong>2 Giải Vàng Quốc gia</strong></li>
                <li>2023–2024: <strong>11 giải thưởng</strong>, 6 giải Quốc gia — Toán quốc tế HIPPO 5 giải Quốc gia, gồm 1 Giải Vàng</li>
                <li>2024–2025: <strong>2 Giải Nhất cấp Tỉnh</strong> Tiếng Anh IOE và thành tích Hùng biện Tiếng Anh cấp Thành phố</li>
                <li>2025–2026: <strong>6 giải Quốc gia</strong> Toán tư duy TIMO, nổi bật 1 Giải Vàng của học sinh lớp 2, cùng nhiều giải IOE Tiếng Anh</li>
                <li>Hơn <strong>200 học sinh</strong> Mầm non và Tiểu học đang theo học</li>
              </ul>
              <p><a href="https://mgis.edu.vn/thanh-tich" target="_blank" rel="noopener">Xem bảng vàng thành tích chi tiết →</a></p>
            </>
          ) : shortName === 'Thái Sơn' ? (
            <>
              <div class="section-eyebrow">III. Cơ sở vật chất &amp; chương trình</div>
              <h2 class="section-title">Ngôi trường mới, khai giảng năm học đầu tiên 2026–2027</h2>
              <ul class="commitment-list">
                <li>Nằm trong Khu dân cư Thái Sơn <strong>hơn 46 ha</strong> tại Long Hậu, sức chứa gần <strong>1.000 học sinh</strong> Mầm non và Tiểu học</li>
                <li>Khối phòng học mới cho cả 2 cấp, phòng năng khiếu (Âm nhạc, Mỹ thuật, Dance) và phòng SteamE thực hành</li>
                <li>Sân chơi ngoài trời rộng, bếp ăn và khu bán trú đảm bảo dinh dưỡng</li>
                <li>Học theo phương pháp Trường Việt Anh: tiếng Anh với giáo viên bản ngữ, 5 Giá trị cốt lõi, hệ thống PDR và liên cấp lên THCS, THPT không đứt đoạn</li>
              </ul>
            </>
          ) : (
            <>
              <div class="section-eyebrow">III. Chương trình Mầm non · Tiểu học</div>
              <h2 class="section-title">Nền tảng vững cho cả hành trình liên cấp</h2>
              <ul class="commitment-list">
                <li>Lộ trình Tiếng Anh xuyên suốt với <strong>giáo viên bản ngữ</strong> — mục tiêu <strong>IELTS 4.0</strong> khi lên lớp 5</li>
                <li><strong>16 kỹ năng thiết yếu</strong> được tích hợp vào từng tiết học, phẩm chất lãnh đạo phát triển qua <strong>Leader in Me</strong></li>
                <li>Học sinh Tiểu học tự thuyết trình hành trình phát triển của mình trước phụ huynh <strong>5 lần mỗi năm</strong> (hệ thống PDR)</li>
              </ul>
            </>
          )}
        </div>
      </section>
    )}

    {level === 'lien-cap' && (
      <!-- ============== III. CAM KẾT ĐẦU RA ============== -->
      <section class="content-section">
        <div class="container narrow">
          <div class="section-eyebrow">III. Cam kết đầu ra</div>
          <h2 class="section-title">Kết quả đã được ghi nhận — không phải lời hứa</h2>
          <ul class="commitment-list">
            <li><strong>100%</strong> học sinh tốt nghiệp đạt điểm IELTS được chuyển đổi thành điểm 10 môn Tiếng Anh kỳ thi THPT Quốc gia</li>
            <li><strong>100%</strong> học sinh tốt nghiệp sở hữu chứng chỉ Tin học quốc tế ICDL — chuẩn Châu Âu, được công nhận tại hơn 150 quốc gia</li>
            <li>Lộ trình Tiếng Anh xuyên suốt với <strong>giáo viên bản ngữ từ lớp 1 đến lớp 12</strong> — từ Starters ở bậc Tiểu học đến IELTS 6.0+ khi tốt nghiệp THPT</li>
            <li><strong>Top 15 toàn cầu</strong> — Cuộc thi Leader in Me 2023, cạnh tranh với các trường từ hơn 50 quốc gia</li>
          </ul>
        </div>
      </section>
    )}

    <!-- ============== IV. CHƯƠNG TRÌNH ĐÀO TẠO ============== -->
    <section class="content-section bg-soft">
      <div class="container narrow">
        <div class="section-eyebrow">{level !== 'mam-non' ? 'IV.' : 'III.'} Chương trình đào tạo toàn diện</div>
        <h2 class="section-title">Mô hình 4 lĩnh vực — phát triển con người trọn vẹn</h2>
        <div class="program-tier">
          <div class="tier-num">1</div>
          <div class="tier-body">
            <h3>Kiến thức</h3>
            <p>Bám sát khung chuẩn của Bộ Giáo dục và Đào tạo, đảm bảo học sinh tự tin trong mọi kỳ thi chuyển cấp. Học sinh Việt Anh có đầy đủ hành trang xét tuyển vào các trường Đại học Công lập hàng đầu Việt Nam.</p>
            <p>Học tiếng Anh với giáo viên bản ngữ theo phương pháp tích hợp nội dung và ngôn ngữ, để học sinh có phát âm chuẩn, có thói quen sử dụng tiếng Anh trong học tập và cuộc sống.</p>
          </div>
        </div>
        <div class="program-tier">
          <div class="tier-num">2</div>
          <div class="tier-body">
            <h3>Kỹ năng lãnh đạo</h3>
            <p><strong>16 kỹ năng thiết yếu</strong> được tích hợp có hệ thống vào từng tiết học — không phải môn học riêng lẻ. Phẩm chất lãnh đạo phát triển qua chương trình <strong>Leader in Me</strong> của FranklinCovey (Hoa Kỳ) — được Trường Việt Anh triển khai tại TP.HCM.</p>
            <p>7 Thói quen lãnh đạo hiệu quả được học sinh thực hành hằng ngày.</p>
          </div>
        </div>
        <div class="program-tier">
          <div class="tier-num">3</div>
          <div class="tier-body">
            <h3>Phẩm chất</h3>
            <p>5 Giá trị cốt lõi định hướng cách học sinh ứng xử và trưởng thành: <em>Tôn trọng · Trách nhiệm · Tài giỏi · Chính trực · Yêu thương</em>.</p>
          </div>
        </div>
        <div class="program-tier">
          <div class="tier-num">4</div>
          <div class="tier-body">
            <h3>Sức khoẻ</h3>
            <p>Học sinh thực hành 5 nguyên tắc sống khỏe: <strong>Ăn tốt · Uống tốt · Nghỉ ngơi tốt · Thể thao · Niềm vui mỗi ngày</strong>. 100% học sinh tham gia hoạt động thể thao thường xuyên.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============== INFO CARD CƠ SỞ ============== -->
    <section class="content-section">
      <div class="container narrow">
        <div class="section-eyebrow">Thông tin cơ sở</div>
        <h2 class="section-title">{campusName}</h2>
        <div class="info-card">
          <div class="info-row">
            <span class="info-label">📍 Địa chỉ</span>
            <span class="info-value">{address}, {cityRegion}</span>
          </div>
          <div class="info-row">
            <span class="info-label">🎓 Cấp học</span>
            <span class="info-value">{levelLabel[level]}</span>
          </div>
          <div class="info-row">
            <span class="info-label">👥 Sỹ số mỗi lớp</span>
            <span class="info-value">{siSo}</span>
          </div>
          <div class="info-row">
            <span class="info-label">📞 Hotline 24/7</span>
            <span class="info-value">
              <a href={telLink}>{hotline}</a> · <a href={zaloLink} target="_blank" rel="noopener">Zalo</a>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label">🏛️ Trực thuộc</span>
            <span class="info-value">Hệ thống Trường Liên Cấp Việt Anh — từ năm 2011</span>
          </div>
        </div>
        <p class="unity-note">
          Dù mang những tên gọi khác nhau tại từng địa phương, tất cả các cơ sở đều vận hành theo <strong>một triết lý, một hệ thống PDR, và một cam kết chất lượng thống nhất</strong>.
        </p>
      </div>
    </section>

    <!-- ============== VI. LỜI MỜI / CTA ============== -->
    <section class="content-section bg-navy final-cta">
      <div class="container narrow">
        <div class="section-eyebrow light">Lời mời</div>
        <h2 class="section-title light">Hãy đến và tự mình quan sát.</h2>
        <p class="lead light">
          Chúng tôi hiểu rằng việc lựa chọn môi trường giáo dục cho con là một trong những quyết định quan trọng nhất mà một gia đình phải đưa ra. Vì vậy, chúng tôi không yêu cầu Quý Phụ huynh tin vào bất kỳ điều gì trong bài viết này.
        </p>
        <p class="light">
          Tham quan trường bất kỳ ngày học nào. Gặp gỡ giáo viên. Quan sát một buổi học thực tế. Nếu có thể, hãy yêu cầu được dự một sự kiện cụ thể như <em>Leadership Day, Olympic Day, họp phụ huynh</em> — để tận mắt thấy học sinh dẫn dắt cuộc trò chuyện về chính hành trình phát triển của mình.
        </p>
        <p class="light"><strong>Khi đó, Quý Phụ huynh sẽ không cần thêm bất kỳ lời giới thiệu nào nữa.</strong></p>
        <div class="cta-row">
          <a href={zaloLink} class="btn btn-yellow" target="_blank" rel="noopener">💬 Nhắn "THAM QUAN" qua Zalo</a>
          <a href={telLink} class="btn btn-outline-yellow">📞 Gọi {hotline}</a>
        </div>
        <p class="cta-note light">Miễn phí · Không ràng buộc · Trả lời trong vòng 1 giờ làm việc</p>
      </div>
    </section>

  </main>

  <FooterBase />
</BaseLayout>

<style>
  :root {
    --navy: #26275D;
    --yellow: #f9dd0e;
    --navy-dark: #1d1e48;
    --navy-soft: #f0f0fa;
  }

  .campus-page {
    color: #1a1a2e;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.7;
  }

  /* ==================== HERO ==================== */
  .hero {
    position: relative;
    min-height: 640px;
